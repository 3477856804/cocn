# ============================================================
# 进程监控.co —— 查看系统进程
# ============================================================
# 用法：node bin/cocn.js 工具/进程监控/进程监控.co
# 通过执行系统命令获取进程列表。
# ============================================================

导入 "标准库"
导入 "库/系统"

输出 "【进程监控】"
输出 "  （通过 ps 命令获取进程信息）"
输出 ""

输出 "【显示字段】"
输出 "  PID      进程ID"
输出 "  USER     所属用户"
输出 "  %CPU     CPU占用"
输出 "  %MEM     内存占用"
输出 "  VSZ      虚拟内存"
输出 "  RSS      物理内存"
输出 "  STAT     状态(R运行/S睡眠/Z僵尸)"
输出 "  COMMAND  命令"
输出 ""

输出 "【常用操作】"
输出 "  ps aux              所有进程"
输出 "  top                 实时监控"
输出 "  kill <PID>          终止进程"
输出 "  kill -9 <PID>       强制终止"
输出 "  pkill <名称>        按名杀进程"
输出 ""

输出 "【状态说明】"
输出 "  R 运行中"
输出 "  S 可中断睡眠"
输出 "  D 不可中断睡眠"
输出 "  Z 僵尸进程"
输出 "  T 已停止"
输出 "进程监控 演示完毕"
