# ============================================================
# 代码统计.co —— 统计代码行数/函数数/注释率
# ============================================================
# 用法：node bin/cocn.js 工具/代码统计/代码统计.co
# ============================================================

导入 "标准库"

函数 统计文件(字符串 源代码) -> 字典
    列表 行 = 分割(源代码, "\n")
    整数 总行 = 长度(行)
    整数 空行 = 0
    整数 注释行 = 0
    整数 代码行 = 0
    整数 函数数 = 0
    对于 i 从 0 到 总行 - 1 循环
        # 不能写成 字符串 行 = 行[i]：内层声明会遮蔽外层列表，
        # 第二次迭代起 行[i] 变成对字符串取下标。
        字符串 当前行 = 行[i]
        如果 长度(当前行) == 0 则
            空行 = 空行 + 1
            继续
        结束
        如果 切片(当前行, 0, 1) == "#" 则
            注释行 = 注释行 + 1
            继续
        结束
        代码行 = 代码行 + 1
        如果 包含(当前行, "函数 ") 则
            函数数 = 函数数 + 1
        结束
    结束
    返回 {
        "总行": 总行,
        "空行": 空行,
        "注释行": 注释行,
        "代码行": 代码行,
        "函数数": 函数数
    }
结束

输出 "【代码统计】"
字符串 示例 = "# 这是注释\n\n函数 测试()\n    输出(1)\n结束\n\n# 另一处注释\n函数 另一个()\n    返回 42\n结束"
字典 s = 统计文件(示例)
输出 "  总行数：", s["总行"]
输出 "  代码行：", s["代码行"]
输出 "  注释行：", s["注释行"]
输出 "  空行：", s["空行"]
输出 "  函数数：", s["函数数"]
输出 "  注释率：", 转字符串(s["注释行"] * 100 / s["总行"]) + "%"
输出 ""

输出 "【统计维度】"
输出 "  - 总行数 / 代码行 / 注释行 / 空行"
输出 "  - 函数数 / 类数 / 注释率"
输出 "  - 圈复杂度（分支密度）"
输出 "  - 重复代码检测"
输出 "代码统计 演示完毕"
