# ============================================================
# 网络工具.co —— ping/端口扫描/DNS查询
# ============================================================
# 用法：node bin/cocn.js 工具/网络工具/网络工具.co
# ============================================================

导入 "标准库"

输出 "【网络工具】"
输出 ""

输出 "【1. Ping测试】"
输出 "  测试网络连通性和延迟"
输出 "  命令：ping example.com"
输出 "  输出：64 bytes from ... time=12ms"
输出 "  指标：丢包率、平均延迟、抖动"
输出 ""

输出 "【2. 端口扫描】"
输出 "  扫描目标开放了哪些端口"
输出 "  常见端口："
输出 "    22   SSH"
输出 "    80   HTTP"
输出 "    443  HTTPS"
输出 "    3306 MySQL"
输出 "    8080 代理"
输出 "  类型：TCP connect / SYN半开 / UDP"
输出 ""

输出 "【3. DNS查询】"
输出 "  域名 -> IP"
输出 "  nslookup example.com"
输出 "  dig example.com MX"
输出 "  记录类型：A/AAAA/MX/CNAME/TXT"
输出 ""

输出 "【4. Traceroute】"
输出 "  追踪数据包经过的路由"
输出 "  traceroute example.com"
输出 "  每跳显示RTT和IP"
输出 ""

输出 "【安全提示】"
输出 "  端口扫描需获授权，否则违法"
输出 "  不要扫描不属于你的服务器"
输出 "网络工具 演示完毕"
