# ============================================================
# 文件管理器.co —— 文本模式文件管理器
# ============================================================
# 用法：node bin/cocn.js 工具/文件管理/文件管理器.co
# 功能：浏览目录、查看文件、复制/移动/删除（模拟）。
# ============================================================

导入 "标准库"

# 虚拟文件系统（演示）
字典 VFS = {
    "/": ["home", "etc", "tmp"],
    "/home": ["user"],
    "/home/user": ["文档", "下载", "图片"],
    "/home/user/文档": ["报告.doc", "笔记.txt"],
    "/home/user/下载": ["安装包.deb"],
    "/home/user/图片": ["风景.jpg"]
}

函数 列目录(字符串 路径) -> 列表
    如果 包含(VFS, 路径) 则
        返回 VFS[路径]
    结束
    返回 []
结束

函数 当前路径大小() -> 整数
    返回 1
结束

输出 "【文本文件管理器】"
字符串 路径 = "/home/user"
输出 "  当前路径：", 路径
输出 "  内容："
列表 项 = 列目录(路径)
对于 i 从 0 到 长度(项) - 1 循环
    输出 "    ", 项[i]
结束
输出 ""

输出 "  命令："
输出 "    cd <目录>   进入目录"
输出 "    ls          列目录"
输出 "    cat <文件>  查看文件"
输出 "    cp 源 目标  复制"
输出 "    mv 源 目标  移动"
输出 "    rm 文件     删除"
输出 "    pwd         当前路径"
输出 "    tree        目录树"
输出 ""

输出 "【键位】"
输出 "  ↑↓ 选择，Enter 打开，Backspace 返回上级"
输出 "  q 退出"
输出 "文件管理器 演示完毕"
