# ============================================================
# JSON查看器.co —— 格式化查看JSON
# ============================================================
# 用法：node bin/cocn.js 工具/JSON查看/JSON查看器.co
# ============================================================

导入 "标准库"

函数 美化JSON(字典 v, 整数 缩进) -> 字符串
    字符串 s = ""
    列表 ks = 键(v)
    如果 长度(ks) == 0 则
        返回 "{}"
    结束
    s = "{\n"
    对于 i 从 0 到 长度(ks) - 1 循环
        字符串 k = ks[i]
        对于 sp 从 1 到 (缩进+1)*2 循环
            s = s + " "
        结束
        s = s + "\"" + k + "\": "
        让 val = v[k]
        字符串 t = 类型(val)
        如果 t == "字典" 则
            s = s + 美化JSON(val, 缩进+1)
        否则
            s = s + 转字符串(val)
        结束
        如果 i < 长度(ks) - 1 则
            s = s + ","
        结束
        s = s + "\n"
    结束
    对于 sp 从 1 到 缩进*2 循环
        s = s + " "
    结束
    s = s + "}"
    返回 s
结束

输出 "【JSON查看器】"
字典 数据 = {"name": "张三", "age": 25, "address": {"city": "西安", "zip": "710000"}}
输出 "  原始：", 数据
输出 ""
输出 "  美化后："
输出 美化JSON(数据, 0)
输出 ""

输出 "【功能】"
输出 "  - 折叠/展开节点"
输出 "  - 语法高亮（键/字符串/数字/布尔）"
输出 "  - 路径复制：点中节点复制JSONPath"
输出 "  - 类型统计：多少个对象/数组/字符串"
输出 "  - 搜索：按键名或值过滤"
输出 "JSON查看器 演示完毕"
