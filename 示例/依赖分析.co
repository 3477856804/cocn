# ============================================================
# 依赖分析.co —— 分析.co文件的导入依赖
# ============================================================
# 用法：node bin/cocn.js 工具/依赖分析/依赖分析.co
# 解析 导入 "xxx" 语句，构建依赖图。
# ============================================================

导入 "标准库"

函数 提取导入(字符串 源代码) -> 列表
    列表 行 = 分割(源代码, "\n")
    列表 依赖 = []
    对于 i 从 0 到 长度(行) - 1 循环
        如果 包含(行[i], "导入 ") 则
            # 提取引号内的模块名
            列表 部分 = 分割(行[i], "\"")
            如果 长度(部分) >= 2 则
                追加(依赖, 部分[1])
            结束
        结束
    结束
    返回 依赖
结束

输出 "【依赖分析】"
字符串 示例 = "导入 \"标准库\"\n导入 \"库/数学\"\n导入 \"库/字符串\"\n\n函数 主()\n    输出(1)\n结束"
列表 依赖 = 提取导入(示例)
输出 "  源代码："
输出 "    ", 示例
输出 "  导入的模块：", 依赖
输出 ""

输出 "【依赖图】"
输出 "  标准库"
输出 "  ├── 库/数学（独立）"
输出 "  ├── 库/字符串（独立）"
输出 "  └── 你的程序"
输出 ""

输出 "【分析功能】"
输出 "  - 依赖图：谁依赖谁"
输出 "  - 循环依赖检测"
输出 "  - 未使用的导入"
输出 "  - 依赖深度"
输出 "  - 影响分析：改某模块影响谁"
输出 "依赖分析 演示完毕"
