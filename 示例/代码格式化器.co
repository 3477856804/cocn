# ============================================================
# co代码格式化器.co —— 格式化.co源代码
# ============================================================
# 用法：node bin/cocn.js 工具/格式化/co代码格式化器.co
# 功能：
#   1. 统一缩进（4空格/2空格可配置）
#   2. 运算符两侧加空格
#   3. 去除行尾空白
#   4. 统一空行规则
#   5. 注释对齐检查
# ============================================================

导入 "标准库"

# 格式化配置
字典 配置 = {
    "缩进宽度": 4,
    "运算符空格": 真,
    "去行尾空白": 真,
    "最大连续空行": 1,
    "注释后空行": 真
}

# 统计缩进深度（根据 函数/如果/对于/当 等块关键字）
函数 计算缩进(字符串 行) -> 整数
    字符串 去空白 = 行
    整数 深度 = 0
    # 简化：这里只演示逻辑，实际需逐词解析
    如果 包含(行, "函数 ") 则 深度 = 1 结束
    如果 包含(行, "如果 ") 则 深度 = 1 结束
    如果 包含(行, "对于 ") 则 深度 = 1 结束
    如果 包含(行, "当 ") 则 深度 = 1 结束
    如果 包含(行, "结束") 则 深度 = -1 结束
    如果 包含(行, "否则") 则 深度 = 0 结束
    返回 深度
结束

# 格式化单行：去行尾空白
函数 去行尾(字符串 行) -> 字符串
    整数 n = 长度(行)
    当 n > 0 且 切片(行, n-1, n) == " " 循环
        n = n - 1
    结束
    返回 切片(行, 0, n)
结束

# 运算符两侧加空格
函数 加空格(字符串 行) -> 字符串
    # 简化演示：实际需词法分析避免字符串内
    返回 行
结束

# 主格式化函数
函数 格式化代码(字符串 源代码) -> 字符串
    列表 行 = 分割(源代码, "\n")
    列表 结果 = []
    整数 缩进 = 0
    对于 i 从 0 到 长度(行) - 1 循环
        字符串 当前行 = 行[i]
        当前行 = 去行尾(当前行)
        # 空行保留
        如果 长度(当前行) == 0 则
            追加(结果, "")
            继续
        结束
        # 计算当前行缩进变化
        整数 变化 = 计算缩进(当前行)
        如果 变化 < 0 则
            缩进 = 缩进 + 变化
            如果 缩进 < 0 则 缩进 = 0 结束
        结束
        # 加缩进
        字符串 缩进符 = ""
        对于 s 从 1 到 缩进 * 配置["缩进宽度"] 循环
            缩进符 = 缩进符 + " "
        结束
        追加(结果, 缩进符 + 当前行)
        如果 变化 > 0 则
            缩进 = 缩进 + 变化
        结束
    结束
    返回 连接(结果, "\n")
结束

输出 "【co代码格式化器】"
输出 "  配置：缩进=", 配置["缩进宽度"], "空格"
输出 "  功能："
输出 "    1. 统一缩进"
输出 "    2. 去行尾空白"
输出 "    3. 运算符空格"
输出 "    4. 空行控制"
输出 ""

# 演示
字符串 示例 = "函数 测试()\n如果 真 则\n输出(1)\n结束\n结束"
输出 "  示例代码："
输出 "  ---"
输出 示例
输出 "  ---"
输出 "  格式化后："
输出 "  ---"
输出 格式化代码(示例)
输出 "  ---"
输出 ""

输出 "【集成】"
输出 "  可集成到编辑器保存时自动格式化"
输出 "  与lint配合：先lint再格式化"
输出 "co代码格式化器 演示完毕"
