# ============================================================
# 算法可视化.co —— 文本模式可视化排序过程
# ============================================================
# 用法：node bin/cocn.js 工具/算法可视化/算法可视化.co
# ============================================================

导入 "标准库"

函数 画柱状图(列表 数据)
    对于 i 从 0 到 长度(数据) - 1 循环
        字符串 柱 = ""
        对于 k 从 1 到 数据[i] 循环
            柱 = 柱 + "█"
        结束
        输出 "    ", 柱, " ", 数据[i]
    结束
结束

函数 可视化冒泡(列表 数据)
    列表 表 = 切片(数据, 0, 长度(数据))
    整数 n = 长度(表)
    输出 "  初始："
    画柱状图(表)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - 2 - i 循环
            如果 表[j] > 表[j+1] 则
                整数 t = 表[j]
                表[j] = 表[j+1]
                表[j+1] = t
            结束
        结束
        输出 "  第", i+1, "轮后："
        画柱状图(表)
    结束
结束

输出 "【算法可视化】"
输出 "  冒泡排序过程："
可视化冒泡([5, 3, 8, 1, 2])
输出 ""

输出 "【支持算法】"
输出 "  冒泡排序 / 选择排序 / 插入排序"
输出 "  快速排序 / 归并排序"
输出 "  二叉树遍历"
输出 "  图搜索BFS/DFS"
输出 ""

输出 "【可视化方式】"
输出 "  终端柱状图 / 颜色块"
输出 "  每步暂停，按任意键下一步"
输出 "  可加速/减速"
输出 "算法可视化 演示完毕"
