# ============================================================
# 测试/数学库测试.co —— 数学函数测试
# ============================================================
导入 "标准库"

测试用例("基本算术", 函数()
    断言相等(7 + 3, 10)
    断言相等(7 - 3, 4)
    断言相等(7 * 3, 21)
    断言相等(7 // 3, 2)
    断言相等(7 % 3, 1)
结束)

测试用例("平方根", 函数()
    断言接近(平方根(16.0), 4.0, 0.001)
    断言接近(平方根(2.0), 1.414, 0.01)
结束)

测试用例("绝对值", 函数()
    断言相等(绝对值(-5), 5)
    断言相等(绝对值(5), 5)
结束)

测试用例("取整", 函数()
    断言相等(取整(3.7), 4)
    断言相等(取整(3.2), 3)
结束)

测试用例("最大最小", 函数()
    断言相等(最大值([3, 7, 2, 9]), 9)
    断言相等(最小值([3, 7, 2, 9]), 2)
结束)

测试用例("幂运算", 函数()
    断言接近(幂(2.0, 10), 1024.0, 0.1)
结束)

测试用例("三角函数", 函数()
    断言接近(正弦(0.0), 0.0, 0.001)
    断言接近(余弦(0.0), 1.0, 0.001)
结束)

测试用例("阶乘", 函数()
    断言相等(阶乘(5), 120)
    断言相等(阶乘(0), 1)
结束)

运行所有测试()
