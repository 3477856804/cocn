# ============================================================
# 测试/中文测试.co —— 中文文本模块测试（0.0.2）
# ============================================================
导入 "标准库"
导入 "库/中文"

测试用例("数字转汉字 基本", 函数()
    断言相等(数字转汉字(0), "零")
    断言相等(数字转汉字(7), "七")
    断言相等(数字转汉字(10), "十")
    断言相等(数字转汉字(15), "十五")
    断言相等(数字转汉字(100), "一百")
结束)

测试用例("数字转汉字 零压缩", 函数()
    断言相等(数字转汉字(105), "一百零五")
    断言相等(数字转汉字(1001), "一千零一")
    断言相等(数字转汉字(10005), "一万零五")
    断言相等(数字转汉字(1010), "一千零一十")
结束)

测试用例("数字转汉字 大数", 函数()
    断言相等(数字转汉字(12345), "一万二千三百四十五")
    断言相等(数字转汉字(1000000), "一百万")
    断言相等(数字转汉字(100000000), "一亿")
    断言相等(数字转汉字(123456789), "一亿二千三百四十五万六千七百八十九")
结束)

测试用例("数字转汉字 负数", 函数()
    断言相等(数字转汉字(-42), "负四十二")
结束)

测试用例("汉字转数字", 函数()
    断言相等(汉字转数字("零"), 0)
    断言相等(汉字转数字("十五"), 15)
    断言相等(汉字转数字("一百零五"), 105)
    断言相等(汉字转数字("一万零五"), 10005)
    断言相等(汉字转数字("两"), 2)
    断言相等(汉字转数字("十二亿三千四百五十六万七千八百九十"), 1234567890)
结束)

测试用例("数字与汉字互转往返", 函数()
    列表 s = [0, 9, 10, 21, 105, 999, 1000, 10005, 12345, 640000]
    对于 i 从 0 到 长度(s) - 1 循环
        断言相等(汉字转数字(数字转汉字(s[i])), s[i], "往返一致: " + 转字符串(s[i]))
    结束
结束)

测试用例("金额大写", 函数()
    断言相等(金额大写(0), "零元整")
    断言相等(金额大写(5), "伍元整")
    断言相等(金额大写(10), "壹拾元整")
    断言相等(金额大写(1234), "壹仟贰佰叁拾肆元整")
    断言相等(金额大写(-8), "负捌元整")
结束)

测试用例("金额大写含角分", 函数()
    断言相等(金额大写含角分(100, 5, 6), "壹佰元伍角陆分")
    断言相等(金额大写含角分(0, 0, 0), "零元整")
    断言相等(金额大写含角分(0, 0, 5), "零元零伍分")
    断言相等(金额大写含角分(7, 0, 0), "柒元整")
结束)

测试用例("全角半角互转", 函数()
    断言相等(全角转半角("ＡＢＣ１２３"), "ABC123")
    断言相等(全角转半角("　"), " ")
    断言相等(全角转半角("中文abc"), "中文abc")
    断言相等(半角转全角("abc123"), "ａｂｃ１２３")
    断言相等(半角转全角(" "), "　")
结束)

测试用例("全角半角往返", 函数()
    断言相等(全角转半角(半角转全角("Hello, 123!")), "Hello, 123!")
结束)

测试用例("中文标点转英文", 函数()
    断言相等(中文标点转英文("你好，世界！"), "你好,世界!")
    断言相等(中文标点转英文("（括号）【方括号】"), "(括号)[方括号]")
    断言相等(中文标点转英文("没有标点"), "没有标点")
结束)

测试用例("英文标点转中文", 函数()
    断言相等(英文标点转中文("你好,世界!"), "你好，世界！")
结束)

测试用例("汉字判定与统计", 函数()
    断言为真(是汉字("你"), "「你」是汉字")
    断言为真(是汉字("龘"), "扩展区汉字也算")
    断言为假(是汉字("a"), "字母不是汉字")
    断言为假(是汉字("，"), "中文标点不是汉字")
    断言相等(统计汉字("abc你好世界"), 4)
    断言相等(统计汉字(""), 0)
结束)

测试用例("去首尾空白", 函数()
    断言相等(去首尾空白("  abc  "), "abc")
    断言相等(去首尾空白("\t换行\n"), "换行")
    断言相等(去首尾空白("   "), "")
结束)

测试用例("分句", 函数()
    断言相等(分句("第一句。第二句！第三句？"), ["第一句", "第二句", "第三句"])
    断言相等(分句("只有一句"), ["只有一句"])
    断言相等(分句("  。  "), [])
    断言相等(分句("One. Two! Three?"), ["One", "Two", "Three"])
结束)

运行所有测试()
