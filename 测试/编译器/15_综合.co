# ============================================================
# 15_综合.co
# 综合运用：变量/算术/条件/循环/函数/字符串/列表/内置函数/断言
# （全部使用自举编译器已支持的特性，应编译并通过）
# ============================================================

# 计算 1..n 的平方和
函数 平方和(整数 n)
    让 s = 0
    对于 i 从 1 到 n 循环
        s = s + i * i
    结束
    返回 s
结束
断言相等(平方和(5), 55, "平方和")

# 筛出列表中的偶数并拼接成字符串
让 偶串 = ""
让 数据 = [1, 2, 3, 4, 5, 6]
对于 j 从 0 到 5 循环
    如果 数据[j] % 2 == 0
        偶串 = 偶串 + 转字符串(数据[j])
    结束
结束
断言相等(偶串, "246", "偶数拼接")

# 阶乘 + 条件分支
函数 类别(整数 k)
    如果 k < 0
        返回 "负"
    结束
    如果 k == 0
        返回 "零"
    结束
    返回 "正"
结束
断言相等(类别(-3), "负", "负数类别")
断言相等(类别(0), "零", "零类别")
断言相等(类别(9), "正", "正数类别")

# 阶乘累乘（用对于循环）
让 累乘 = 1
对于 p 从 1 到 4 循环
    累乘 = 累乘 * p
结束
断言相等(累乘, 24, "4 的阶乘")

输出 "15_综合 全部通过"
