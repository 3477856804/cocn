# ============================================================
# 07_列表.co
# 测试：列表字面量 / 索引读取 / 追加 / 长度
# ============================================================
让 lst = [10, 20, 30]
断言相等(长度(lst), 3, "列表长度")
断言相等(lst[0], 10, "首元素")
断言相等(lst[1], 20, "中间元素")
断言相等(lst[2], 30, "尾元素")

追加(lst, 40)
断言相等(长度(lst), 4, "追加后长度")
断言相等(lst[3], 40, "追加元素")

让 空表 = []
断言相等(长度(空表), 0, "空列表长度")
追加(空表, 1)
断言相等(长度(空表), 1, "空表追加")

让 合计 = 0
对于 i 从 0 到 2 循环
    合计 = 合计 + lst[i]
结束
断言相等(合计, 60, "遍历列表求和")
输出 "07_列表 通过"
