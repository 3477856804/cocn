# ============================================================
# 03_条件控制.co
# 测试：如果 / 否则 / 否则若 / 若 单行
# ============================================================
让 s = ""
如果 1 < 2
    s = "是"
否则
    s = "否"
结束
断言相等(s, "是", "如果分支")

让 g = ""
让 分 = 85
如果 分 >= 90
    g = "优"
否则若 分 >= 80
    g = "良"
否则若 分 >= 60
    g = "中"
否则
    g = "差"
结束
断言相等(g, "良", "否则若链")

让 单行 = 0
如果 真
    单行 = 1
结束
断言相等(单行, 1, "如果成立")

让 标志 = "甲"
如果 假
    标志 = "错"
否则
    标志 = "对"
结束
断言相等(标志, "对", "否则分支")
输出 "03_条件控制 通过"
