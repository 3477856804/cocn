# 13_模式匹配.co
# 测试：匹配 / 是 / 默认（自举编译器暂不支持 -> 待支持）
# ============================================================
让 结果 = ""
让 状态 = 2
匹配 状态
    是 1: 结果 = "就绪"
    是 2: 结果 = "运行中"
    是 3: 结果 = "完成"
    默认: 结果 = "未知"
结束
断言相等(结果, "运行中", "模式匹配命中")
输出 "13_模式匹配 通过"
