# ============================================================
# 04_循环.co
# 测试：对于循环 / 当循环 / 步长 / 跳出 / 继续
# ============================================================
让 和 = 0
对于 i 从 1 到 10 循环
    和 = 和 + i
结束
断言相等(和, 55, "计数求和")

让 当n = 1
当 当n < 100 循环
    当n = 当n * 2
结束
断言相等(当n, 128, "当循环终止")

让 跳数 = 0
对于 j 从 1 到 100 循环
    如果 j > 5
        跳出
    结束
    跳数 = 跳数 + 1
结束
断言相等(跳数, 5, "跳出生效")

让 奇和 = 0
对于 k 从 1 到 10 循环
    如果 k % 2 == 0
        继续
    结束
    奇和 = 奇和 + k
结束
断言相等(奇和, 25, "继续生效")
输出 "04_循环 通过"
