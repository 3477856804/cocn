# ============================================================
# 01_变量与算术.co
# 测试：变量声明 / 赋值 / 四则运算 / 取模 / 运算符优先级 / 自增赋值
# ============================================================
让 a = 10
让 b = 3
断言相等(a + b, 13, "加法")
断言相等(a - b, 7, "减法")
断言相等(a * b, 30, "乘法")
断言相等(a % b, 1, "取模")
断言相等(7 / 2, 3.5, "除法产生浮点")
断言相等(2 + 3 * 4, 14, "乘法优先")
断言相等((2 + 3) * 4, 20, "括号优先")
断言相等(-5 + 3, -2, "负数运算")
让 x = 5
x = x + 1
断言相等(x, 6, "自增赋值")
让 总价 = 0
对于 i 从 1 到 4 循环
    总价 = 总价 + i * 2
结束
断言相等(总价, 20, "循环累加表达式")
输出 "01_变量与算术 通过"
