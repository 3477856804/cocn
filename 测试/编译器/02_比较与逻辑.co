# ============================================================
# 02_比较与逻辑.co
# 测试：比较运算符 / 且 / 或 / 非 / 布尔字面量
# ============================================================
断言(1 < 2, "小于")
断言(2 <= 2, "小于等于")
断言(5 > 3, "大于")
断言(5 >= 5, "大于等于")
断言(3 == 3, "相等")
断言(3 != 4, "不等")
断言(1 < 2 且 3 > 1, "逻辑与成立")
断言(1 < 0 或 5 > 2, "逻辑或成立")
断言(非(1 < 0), "逻辑非")
断言相等(真, 1, "真等于1")
断言相等(假, 0, "假等于0")
断言相等(1 == 2 且 1 == 1, 0, "与短路为假")
输出 "02_比较与逻辑 通过"
