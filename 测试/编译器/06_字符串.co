# ============================================================
# 06_字符串.co
# 测试：字符串字面量 / 拼接 / 索引 / 截取 / 长度
# ============================================================
让 s = "abc"
断言相等(长度(s), 3, "字符串长度")
断言相等(s[0], "a", "首字符")
断言相等(s[1], "b", "中间字符")
断言相等(s[2], "c", "尾字符")

让 t = "ab" + "cd"
断言相等(t, "abcd", "字符串拼接")

让 拼 = "共" + "和"
断言相等(拼, "共和", "两串拼接")

断言相等(截取("hello", 1, 3), "ell", "截取子串")
断言相等(替换("aaa", "a", "b"), "bbb", "替换子串")
输出 "06_字符串 通过"
