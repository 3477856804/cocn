# ============================================================
# 14_推导式.co
# 测试：列表推导式（自举编译器暂不支持 -> 待支持）
# ============================================================
让 奇数平方 = [x * x 对于 x 于 [1, 2, 3, 4, 5, 6] 若 x % 2 == 1]
断言相等(长度(奇数平方), 3, "推导式长度")
断言相等(奇数平方[0], 1, "推导式首项")
断言相等(奇数平方[2], 25, "推导式末项")
输出 "14_推导式 通过"
