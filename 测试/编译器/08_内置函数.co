# ============================================================
# 08_内置函数.co
# 测试：长度 / 转字符串 / 截取 / 替换 / 绝对值 / 最大最小
# ============================================================
断言相等(长度("abc"), 3, "字符串长度")
断言相等(长度([1, 2, 3]), 3, "列表长度")
断言相等(转字符串(42), "42", "整数转字符串")
断言相等(转字符串(3.5), "3.5", "浮点转字符串")
断言相等(截取("hello", 0, 2), "he", "截取开头")
断言相等(替换("abc", "b", "z"), "azc", "替换字符")
断言相等(绝对值(-5), 5, "绝对值")
断言相等(最大值(3, 9), 9, "最大值")
断言相等(最小值(3, 9), 3, "最小值")
输出 "08_内置函数 通过"
