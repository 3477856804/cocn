# ============================================================
# 命令行参数测试：读取命令行 内置
# 套件门禁不传参（COCN_ARGV 为空），故只验证「无参数返回默认值」路径；
# 带参路径见手动 `node bin/cocn.js 本文件.co 参数...`。
# ============================================================
导入 "标准库"

测试用例("无参数返回空列表", 函数()
    断言相等(读取命令行([]), [], "无参数返回空列表")
结束)

测试用例("无参数返回默认值", 函数()
    断言相等(读取命令行(["默认"]), ["默认"], "无参数返回默认值")
结束)

测试用例("默认值列表长度", 函数()
    断言相等(长度(读取命令行(["x", "y"])), 2, "默认值列表长度")
结束)

测试用例("返回类型为列表", 函数()
    断言相等(类型(读取命令行(["默认"])), "列表", "返回类型为列表")
结束)

测试用例("默认值可取元素", 函数()
    断言相等(读取命令行(["单"])[0], "单", "默认值列表可取元素")
结束)

运行所有测试()
