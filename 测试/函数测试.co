# ============================================================
# 测试/函数测试.co —— 函数定义与调用测试
# ============================================================
导入 "标准库"

函数 加(整数 a, 整数 b)
    返回 a + b
结束

函数 无返回值()
    输出 "  (无返回值函数被调用)"
结束

测试用例("函数调用", 函数()
    断言相等(加(1, 2), 3)
    断言相等(加(100, 200), 300)
结束)

测试用例("递归函数", 函数()
    函数 阶乘(整数 n)
        如果 n <= 1 则 返回 1 结束
        返回 n * 阶乘(n - 1)
    结束
    断言相等(阶乘(5), 120)
    断言相等(阶乘(0), 1)
结束)

测试用例("多返回值(元组)", 函数()
    函数 除余(整数 a, 整数 b)
        返回 [a // b, a % b]
    结束
    列表 r = 除余(17, 5)
    断言相等(r[0], 3)
    断言相等(r[1], 2)
结束)

测试用例("匿名函数", 函数()
    让 f = 函数(x) 返回 x * x 结束
    断言相等(f(5), 25)
结束)

测试用例("高阶函数映射", 函数()
    列表 结果 = 映射(函数(x) 返回 x * 2 结束, [1, 2, 3])
    断言相等(结果, [2, 4, 6])
结束)

测试用例("默认参数模拟", 函数()
    函数 问候(名字, 礼貌)
        如果 礼貌 == [] 则 礼貌 = "你好" 结束
        返回 礼貌 + "，" + 名字
    结束
    断言相等(问候("小明", []), "你好，小明")
结束)

运行所有测试()
