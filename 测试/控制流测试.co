# ============================================================
# 测试/控制流测试.co —— 控制流测试
# ============================================================
导入 "标准库"

测试用例("如果否则", 函数()
    字符串 r = "其他"
    如果 1 > 2 则
        r = "不可能"
    否则 如果 2 > 1 则
        r = "正确"
    否则
        r = "错误"
    结束
    断言相等(r, "正确")
结束)

测试用例("当循环", 函数()
    整数 i = 0
    整数 s = 0
    当 i < 10 循环
        s = s + i
        i = i + 1
    结束
    断言相等(s, 45)
结束)

测试用例("对于循环", 函数()
    整数 s = 0
    对于 i 从 1 到 5 循环
        s = s + i
    结束
    断言相等(s, 15)
结束)

测试用例("对于循环步长", 函数()
    列表 收集 = []
    对于 i 从 0 到 10 步长 2 循环
        追加(收集, i)
    结束
    断言相等(收集, [0, 2, 4, 6, 8, 10])
结束)

测试用例("跳出循环", 函数()
    整数 s = 0
    对于 i 从 1 到 100 循环
        如果 i > 5 则 跳出 结束
        s = s + i
    结束
    断言相等(s, 15)
结束)

测试用例("foreach遍历", 函数()
    列表 结果 = []
    对于 x 于 [10, 20, 30] 循环
        追加(结果, x * 2)
    结束
    断言相等(结果, [20, 40, 60])
结束)

运行所有测试()
