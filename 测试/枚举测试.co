# ============================================================
# 测试/枚举测试.co —— 枚举测试
# ============================================================
导入 "标准库"

枚举 颜色
    红
    绿
    蓝
结束

测试用例("枚举值", 函数()
    断言相等(颜色.红, 0)
    断言相等(颜色.绿, 1)
    断言相等(颜色.蓝, 2)
结束)

测试用例("枚举比较", 函数()
    断言为真(颜色.红 < 颜色.绿, "红应小于绿")
结束)

测试用例("枚举在匹配中", 函数()
    函数 颜色名(整数 c)
        匹配 c
            是 颜色.红: 返回 "红"
            是 颜色.绿: 返回 "绿"
            默认: 返回 "蓝"
        结束
    结束
    断言相等(颜色名(颜色.红), "红")
    断言相等(颜色名(颜色.蓝), "蓝")
结束)

运行所有测试()
