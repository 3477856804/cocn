# ============================================================
# 测试/回归测试.co —— 已知问题的回归测试
# ============================================================
导入 "标准库"

测试用例("否则如果需空格", 函数()
    字符串 r = "其他"
    如果 1 > 2 则
        r = "错"
    否则 如果 2 > 1 则
        r = "对"
    结束
    断言相等(r, "对")
结束)

测试用例("字典删除用删除键", 函数()
    字典 d = {"a": 1, "b": 2}
    删除键(d, "a")
    断言为假(包含(d, "a"), "删除后不应含a")
结束)

测试用例("HOF函数在前", 函数()
    列表 r = 映射(函数(x) 返回 x + 1 结束, [1, 2, 3])
    断言相等(r, [2, 3, 4])
结束)

测试用例("过滤函数", 函数()
    列表 r = 过滤(函数(x) 返回 x > 2 结束, [1, 2, 3, 4])
    断言相等(r, [3, 4])
结束)

测试用例("归约函数", 函数()
    整数 r = 归约(函数(a, b) 返回 a + b 结束, [1, 2, 3, 4], 0)
    断言相等(r, 10)
结束)

运行所有测试()
