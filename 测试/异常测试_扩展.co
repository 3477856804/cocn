# ============================================================
# 测试/异常测试_扩展.co —— 异常处理测试
# ============================================================
导入 "标准库"

函数 可能出错(整数 x)
    如果 x < 0 则
        抛出 "负数不允许"
    结束
    返回 x * 2
结束

测试用例("尝试捕获抛出", 函数()
    整数 结果 = 0
    尝试
        可能出错(-1)
    捕获 e
        结果 = 1
    结束
    断言相等(结果, 1)
结束)

测试用例("无异常通过", 函数()
    整数 r = 0
    尝试
        r = 可能出错(5)
    捕获 e
        r = -1
    结束
    断言相等(r, 10)
结束)

测试用例("捕获除零", 函数()
    整数 r = 0
    尝试
        r = 1 // 0
    捕获 e
        r = -1
    结束
    断言相等(r, -1)
结束)

测试用例("异常消息", 函数()
    字符串 消息 = ""
    尝试
        可能出错(-5)
    捕获 e
        消息 = e["消息"]
    结束
    断言为真(包含(消息, "负数"), "应含负数")
结束)

运行所有测试()
