# ============================================================
# 测试/文件系统测试.co —— 文件与路径测试
# ============================================================
导入 "标准库"

测试用例("路径拼接", 函数()
    字符串 p = 路径拼接(["home", "user", "file.txt"])
    断言为真(长度(p) > 0, "应返回路径")
结束)

测试用例("文件名提取", 函数()
    字符串 f = 文件名("/home/user/file.txt")
    断言为真(包含(f, "file.txt"), "应提取文件名")
结束)

测试用例("扩展名", 函数()
    字符串 e = 扩展名("photo.jpg")
    断言相等(e, ".jpg")
结束)

测试用例("目录名", 函数()
    字符串 d = 目录名("/home/user/file.txt")
    断言为真(包含(d, "home"), "应含目录")
结束)

测试用例("规范化路径", 函数()
    字符串 p = 规范化路径("a/b/../c")
    断言为真(长度(p) > 0, "应返回路径")
结束)

运行所有测试()
