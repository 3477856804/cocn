# ============================================================
# 测试/列表测试.co —— 列表操作测试
# ============================================================
导入 "标准库"

测试用例("列表创建与索引", 函数()
    列表 l = [10, 20, 30]
    断言相等(l[0], 10)
    断言相等(l[2], 30)
    断言相等(长度(l), 3)
结束)

测试用例("追加元素", 函数()
    列表 l = [1, 2]
    追加(l, 3)
    追加(l, 4)
    断言相等(l, [1, 2, 3, 4])
结束)

测试用例("列表切片", 函数()
    列表 l = [0, 1, 2, 3, 4]
    断言相等(切片(l, 1, 4), [1, 2, 3])
结束)

测试用例("列表推导", 函数()
    列表 l = [x * x 对于 x 于 [1, 2, 3]]
    断言相等(l, [1, 4, 9])
结束)

测试用例("列表包含", 函数()
    列表 l = ["a", "b", "c"]
    断言为真(包含(l, "b"), "应包含b")
    断言为假(包含(l, "z"), "不应包含z")
结束)

测试用例("排序", 函数()
    列表 l = [3, 1, 2]
    断言相等(排序(l), [1, 2, 3])
结束)

测试用例("二维列表", 函数()
    列表 m = [[1, 2], [3, 4]]
    断言相等(m[0][1], 2)
    断言相等(m[1][0], 3)
结束)

运行所有测试()
