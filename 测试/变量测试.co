# ============================================================
# 测试/变量测试.co —— 变量与类型测试
# ============================================================
导入 "标准库"

测试用例("整数变量", 函数()
    整数 a = 42
    断言相等(a, 42)
    a = a + 1
    断言相等(a, 43)
结束)

测试用例("浮点变量", 函数()
    浮点 pi = 3.14
    断言接近(pi, 3.14, 0.001)
    浮点 r = 2.0
    浮点 面积 = pi * r * r
    断言接近(面积, 12.56, 0.1)
结束)

测试用例("布尔变量", 函数()
    布尔 t = 真
    布尔 f = 假
    断言为真(t, "真应为真")
    断言为假(f, "假应为假")
结束)

测试用例("字符串变量", 函数()
    字符串 s = "你好"
    断言相等(s, "你好")
    断言相等(长度(s), 2)
结束)

测试用例("类型推断", 函数()
    断言类型(42, "整数")
    断言类型(3.14, "浮点")
    断言类型("hi", "字符串")
    断言类型([1,2], "列表")
结束)

测试用例("变量重新赋值", 函数()
    整数 x = 1
    x = 2
    x = x * 10
    断言相等(x, 20)
结束)

运行所有测试()
