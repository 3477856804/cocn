# ============================================================
# 测试/匹配测试.co —— 匹配模式测试
# ============================================================
导入 "标准库"

测试用例("匹配数字", 函数()
    函数 评级(整数 n)
        匹配 n
            是 1: 返回 "差"
            是 2: 返回 "中"
            是 3: 返回 "良"
            默认: 返回 "优"
        结束
    结束
    断言相等(评级(1), "差")
    断言相等(评级(5), "优")
结束)

测试用例("匹配字符串", 函数()
    函数 翻译(字符串 c)
        匹配 c
            是 "红": 返回 "red"
            是 "绿": 返回 "green"
            默认: 返回 "?"
        结束
    结束
    断言相等(翻译("红"), "red")
结束)

运行所有测试()
