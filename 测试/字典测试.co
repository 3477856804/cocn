# ============================================================
# 测试/字典测试.co —— 字典操作测试
# ============================================================
导入 "标准库"

测试用例("字典创建与访问", 函数()
    字典 d = {"姓名": "张三", "年龄": 25}
    断言相等(d["姓名"], "张三")
    断言相等(d["年龄"], 25)
结束)

测试用例("字典添加键", 函数()
    字典 d = {}
    d["新键"] = 123
    断言相等(d["新键"], 123)
结束)

测试用例("字典包含", 函数()
    字典 d = {"a": 1, "b": 2}
    断言为真(包含(d, "a"), "应包含a")
    断言为假(包含(d, "z"), "不应包含z")
结束)

测试用例("字典键列表", 函数()
    字典 d = {"x": 1, "y": 2}
    断言为真(包含(键(d), "x"), "键应含x")
结束)

测试用例("字典删除", 函数()
    字典 d = {"a": 1, "b": 2}
    删除键(d, "a")
    断言为假(包含(d, "a"), "删除后不应含a")
结束)

测试用例("嵌套字典", 函数()
    字典 d = {"用户": {"名字": "李四", "年龄": 30}}
    断言相等(d["用户"]["名字"], "李四")
结束)

运行所有测试()
