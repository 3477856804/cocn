# ============================================================
# 测试/并发测试.co —— 并发测试
# ============================================================
导入 "标准库"

测试用例("顺序执行", 函数()
    整数 s = 0
    对于 i 从 1 到 5 循环
        s = s + i
    结束
    断言相等(s, 15)
结束)

测试用例("并发累加模拟", 函数()
    整数 结果 = 0
    # 模拟并发：实际环境用 并发/等待/任务
    函数 任务(整数 x)
        返回 x * x
    结束
    对于 i 从 1 到 4 循环
        结果 = 结果 + 任务(i)
    结束
    断言相等(结果, 30)
结束)

测试用例("任务独立性", 函数()
    函数 加倍(整数 x)
        返回 x * 2
    结束
    列表 结果 = 映射(加倍, [1, 2, 3])
    断言相等(结果, [2, 4, 6])
结束)

运行所有测试()
