# ============================================================
# 测试/数据结构测试.co —— 栈/队列/集合测试
# ============================================================
导入 "标准库"

测试用例("栈操作", 函数()
    字典 s = 新建栈()
    入栈(s, 1)
    入栈(s, 2)
    入栈(s, 3)
    断言相等(栈顶(s), 3)
    断言相等(出栈(s), 3)
    断言相等(栈顶(s), 2)
结束)

测试用例("栈空判断", 函数()
    字典 s = 新建栈()
    断言为真(栈空(s), "空栈应为空")
    入栈(s, 1)
    断言为假(栈空(s), "入栈后不应空")
结束)

测试用例("队列操作", 函数()
    字典 q = 新建队列()
    入队(q, "a")
    入队(q, "b")
    入队(q, "c")
    断言相等(队首(q), "a")
    断言相等(出队(q), "a")
    断言相等(队首(q), "b")
结束)

测试用例("集合操作", 函数()
    字典 s = 新建集合()
    集合添加(s, 1)
    集合添加(s, 2)
    集合添加(s, 1)
    断言为真(集合包含(s, 1), "应包含1")
    断言为真(集合包含(s, 2), "应包含2")
结束)

测试用例("集合并集", 函数()
    字典 a = 新建集合()
    集合添加(a, 1)
    集合添加(a, 2)
    字典 b = 新建集合()
    集合添加(b, 2)
    集合添加(b, 3)
    字典 u = 集合并集(a, b)
    断言为真(集合包含(u, 1), "并集应含1")
    断言为真(集合包含(u, 3), "并集应含3")
结束)

运行所有测试()
