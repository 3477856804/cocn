# ============================================================
# 测试/加密测试.co —— 哈希与编码测试
# ============================================================
导入 "标准库"

测试用例("十六进制转换", 函数()
    字符串 h = 十六进制(255)
    断言为真(长度(h) > 0, "应返回十六进制")
结束)

测试用例("二进制转换", 函数()
    字符串 b = 二进制(5)
    断言为真(包含(b, "101"), "5的二进制含101")
结束)

测试用例("八进制转换", 函数()
    字符串 o = 八进制(8)
    断言为真(长度(o) > 0, "应返回八进制")
结束)

测试用例("转字符串", 函数()
    断言相等(转字符串(42), "42")
结束)

运行所有测试()
