# ============================================================
# 测试/元组测试.co —— 元组/多返回值测试
# ============================================================
导入 "标准库"

测试用例("多返回值", 函数()
    函数 除余(整数 a, 整数 b)
        返回 [a // b, a % b]
    结束
    列表 r = 除余(17, 5)
    断言相等(r[0], 3)
    断言相等(r[1], 2)
结束)

测试用例("坐标运算", 函数()
    函数 距离原点(列表 p)
        返回 平方根(p[0] * p[0] + p[1] * p[1])
    结束
    断言接近(距离原点([3, 4]), 5.0, 0.01)
结束)

测试用例("交换变量", 函数()
    整数 a = 1
    整数 b = 2
    列表 t = [a, b]
    a = t[1]
    b = t[0]
    断言相等(a, 2)
    断言相等(b, 1)
结束)

运行所有测试()
