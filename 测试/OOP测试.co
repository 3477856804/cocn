# ============================================================
# 测试/OOP测试.co —— 面向对象测试
# ============================================================
导入 "标准库"

结构体 点
    整数 x
    整数 y
结束

测试用例("结构体构造", 函数()
    让 p = 点(3, 4)
    断言相等(p.x, 3)
    断言相等(p.y, 4)
结束)

测试用例("结构体距离", 函数()
    让 p = 点(3, 4)
    浮点 d = 平方根(p.x * p.x + p.y * p.y)
    断言接近(d, 5.0, 0.1)
结束)

测试用例("方法式函数", 函数()
    函数 移动(字典 p, 整数 dx, 整数 dy)
        返回 点(p.x + dx, p.y + dy)
    结束
    让 p2 = 移动(点(1, 1), 2, 3)
    断言相等(p2.x, 3)
结束)

运行所有测试()
