# ============================================================
# 测试/字符串测试_扩展.co —— 字符串库测试（扩充已有）
# ============================================================
导入 "标准库"

测试用例("字符串长度", 函数()
    断言相等(长度("你好"), 2)
    断言相等(长度("hello"), 5)
结束)

测试用例("字符串拼接", 函数()
    断言相等("你好" + "世界", "你好世界")
结束)

测试用例("字符串切片", 函数()
    断言相等(截取("你好世界", 0, 2), "你好")
结束)

测试用例("分割字符串", 函数()
    断言相等(分割("a,b,c", ","), ["a", "b", "c"])
结束)

测试用例("连接字符串", 函数()
    断言相等(连接(["a", "b"], "-"), "a-b")
结束)

测试用例("包含子串", 函数()
    断言为真(包含("hello world", "world"), "应包含world")
结束)

测试用例("统计子串", 函数()
    断言相等(计数子串("banana", "a"), 3)
结束)

测试用例("字符串转数字", 函数()
    断言相等(转整数("42"), 42)
    断言接近(转浮点("3.14"), 3.14, 0.001)
结束)

运行所有测试()
