# ============================================================
# 测试/编码测试.co —— Base64/编码测试
# ============================================================
导入 "标准库"

测试用例("字符串长度", 函数()
    断言相等(长度("hello"), 5)
结束)

测试用例("字符串切片", 函数()
    断言相等(截取("hello", 0, 2), "he")
结束)

测试用例("字符码转换", 函数()
    断言相等(转ASCII("A"), 65)
    断言相等(从ASCII(65), "A")
结束)

测试用例("中文字符", 函数()
    断言相等(长度("中文"), 2)
结束)

测试用例("拼接", 函数()
    断言相等("你好" + "世界", "你好世界")
结束)

运行所有测试()
