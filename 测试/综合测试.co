# ============================================================
# 测试/综合测试.co —— 组合多个特性的集成测试
# ============================================================
导入 "标准库"

测试用例("列表+函数+循环", 函数()
    函数 平方和(列表 数)
        浮点 s = 0.0
        对于 x 于 数 循环
            s = s + x * x
        结束
        返回 s
    结束
    断言接近(平方和([1.0, 2.0, 3.0]), 14.0, 0.001)
结束)

测试用例("字典+循环+条件", 函数()
    字典 成绩 = {"语文": 90, "数学": 85, "英语": 95}
    浮点 平均 = 0.0
    对于 k 于 键(成绩) 循环
        平均 = 平均 + 成绩[k]
    结束
    平均 = 平均 / 长度(成绩)
    断言接近(平均, 90.0, 0.1)
结束)

测试用例("异常+函数", 函数()
    函数 安全除(整数 a, 整数 b)
        如果 b == 0 则 抛出 "除数为零" 结束
        返回 a // b
    结束
    整数 r = 0
    尝试
        r = 安全除(10, 2)
    捕获 e
        r = -1
    结束
    断言相等(r, 5)
结束)

测试用例("字符串+列表", 函数()
    列表 词 = 分割("你 好 世 界", " ")
    断言相等(长度(词), 4)
结束)

测试用例("数学+算法", 函数()
    列表 s = 冒泡排序([5, 3, 8, 1, 2])
    断言相等(s, [1, 2, 3, 5, 8])
结束)

运行所有测试()
