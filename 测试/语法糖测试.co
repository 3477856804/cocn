# ============================================================
# 测试/语法糖测试.co —— 0.0.9 语法糖（去重复用字/词）验证
#
# 覆盖五类新增语法糖（全部脱糖为既有 AST 节点，解释器/VM 双后端通用）：
#   1. 复合赋值：+= -= *= /= %= //= **= &= |= ^= <<= >>=
#   2. 自增自减：i++ / i--（语句级后置）
#   3. 单行循环：当 条件 循环 语句 ／ 对于 … 循环 语句（免写 结束）
#   4. 箭头函数：函数 f(...) => 表达式（命名/匿名，免写 结束）
#   5. 分号分隔：一行多语句 a = 1; b = 2（; 与换行同义）
# ============================================================
导入 "标准库"

# ---------- 1. 复合赋值 ----------
测试用例("复合赋值 算术", 函数()
    整数 a = 10
    a += 5
    断言相等(a, 15)
    a -= 3
    断言相等(a, 12)
    a *= 2
    断言相等(a, 24)
    a //= 4
    断言相等(a, 6)
    a %= 4
    断言相等(a, 2)
结束)

测试用例("复合赋值 整除与幂", 函数()
    整数 b = 100
    b //= 7
    断言相等(b, 14)
    浮点 c = 2.0
    c **= 10
    断言接近(c, 1024.0, 0.001)
结束)

测试用例("复合赋值 位运算", 函数()
    整数 c = 12
    c &= 10
    断言相等(c, 8)
    c |= 3
    断言相等(c, 11)
    c ^= 5
    断言相等(c, 14)
    c <<= 2
    断言相等(c, 56)
    c >>= 3
    断言相等(c, 7)
结束)

测试用例("复合赋值 下标目标", 函数()
    列表 表 = [1, 2, 3]
    表[0] += 10
    断言相等(表[0], 11)
    表[1] *= 5
    断言相等(表[1], 10)
    字典 配置 = {"计数": 7}
    配置["计数"] += 3
    断言相等(配置["计数"], 10)
结束)

测试用例("复合赋值 字符串拼接", 函数()
    字符串 s = "你好"
    s += "，coCN"
    断言相等(s, "你好，coCN")
结束)

# ---------- 2. 自增自减 ----------
测试用例("自增自减", 函数()
    整数 i = 5
    i++
    断言相等(i, 6)
    i--
    断言相等(i, 5)
    i--
    断言相等(i, 4)
    列表 计数 = [0]
    计数[0]++
    断言相等(计数[0], 1)
结束)

# ---------- 3. 单行循环 ----------
测试用例("单行当循环", 函数()
    整数 计数器 = 0
    当 计数器 < 3 循环 计数器++
    断言相等(计数器, 3)
    整数 和 = 0
    整数 j = 0
    当 j < 5 循环 和 += j; j++
    断言相等(和, 10)
结束)

测试用例("单行对于循环", 函数()
    整数 阶 = 1
    对于 i 从 1 到 5 循环 阶 *= i
    断言相等(阶, 120)
    整数 和 = 0
    对于 x 于 [1, 2, 3, 4] 循环 和 += x
    断言相等(和, 10)
    对于 y 在 ["甲", "乙"] 循环 和 += 1
    断言相等(和, 12)
结束)

# ---------- 4. 箭头函数 ----------
测试用例("箭头函数", 函数()
    函数 平方(整数 x) -> 整数 => x * x
    断言相等(平方(7), 49)
    函数 加(a, b) => a + b
    断言相等(加(3, 4), 7)
    函数 问候(字符串 名) => "你好，" + 名
    断言相等(问候("coCN"), "你好，coCN")
结束)

函数 递归阶乘(整数 n) -> 整数
    若 n <= 1 则
        返回 1
    结束
    返回 n * 递归阶乘(n - 1)
结束

测试用例("箭头函数与块函数共存", 函数()
    断言相等(递归阶乘(5), 120)
    函数 快速阶乘(整数 n) => 递归阶乘(n)
    断言相等(快速阶乘(5), 120)
结束)

测试用例("箭头匿名函数", 函数()
    让 双倍 = 函数(整数 x) => x * 2
    断言相等(双倍(21), 42)
    列表 数 = [1, 2, 3, 4]
    整数 总 = 0
    对于 n 于 数 循环 总 += 双倍(n)
    断言相等(总, 20)
结束)

# ---------- 5. 分号分隔一行多语句 ----------
测试用例("分号一行多语句", 函数()
    让 a = 1; 让 b = 2; a += b; b++
    断言相等(a, 3)
    断言相等(b, 3)
    整数 x = 0; 整数 y = 0
    当 x < 3 循环 x++; y += 2
    断言相等(x, 3)
    断言相等(y, 6)
结束)

# ---------- 兼容性：旧语法原样保留 ----------
测试用例("旧块语法完全兼容", 函数()
    函数 旧式(整数 v) -> 整数
        整数 结果 = 0
        当 v > 0 循环
            结果 += v
            v--
        结束
        返回 结果
    结束
    断言相等(旧式(4), 10)
    当 假 循环
        断言相等(0, 1)
    结束
    当 假 循环 结束
    对于 i 从 1 到 3 循环
        断言相等(i, i)
    结束
    如果 真 则
        断言为真(真, "块如果")
    否则
        断言为真(假, "不应进入")
    结束
    如果 假 则 输出 "不应输出"
结束)

运行所有测试()
