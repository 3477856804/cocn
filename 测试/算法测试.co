# ============================================================
# 测试/算法测试.co —— 排序与搜索测试
# ============================================================
导入 "标准库"

测试用例("冒泡排序", 函数()
    列表 s = 冒泡排序([3, 1, 4, 1, 5, 9, 2, 6])
    断言相等(s, [1, 1, 2, 3, 4, 5, 6, 9])
结束)

测试用例("选择排序", 函数()
    列表 s = 选择排序([5, 2, 8, 1])
    断言相等(s, [1, 2, 5, 8])
结束)

测试用例("插入排序", 函数()
    列表 s = 插入排序([4, 3, 2, 1])
    断言相等(s, [1, 2, 3, 4])
结束)

测试用例("二分查找", 函数()
    列表 数据 = [1, 3, 5, 7, 9]
    函数 二分(列表 表, 整数 目标)
        整数 左 = 0
        整数 右 = 长度(表) - 1
        当 左 <= 右 循环
            整数 中 = (左 + 右) // 2
            如果 表[中] == 目标 则 返回 中 结束
            如果 表[中] < 目标 则 左 = 中 + 1 否则 右 = 中 - 1 结束
        结束
        返回 -1
    结束
    断言相等(二分(数据, 7), 3)
    断言相等(二分(数据, 4), -1)
结束)

运行所有测试()
