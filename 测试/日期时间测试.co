# ============================================================
# 测试/日期时间测试.co —— 日期时间函数测试
# ============================================================
导入 "标准库"

测试用例("闰年判断", 函数()
    断言为真(是闰年(2000), "2000是闰年")
    断言为假(是闰年(1900), "1900不是闰年")
    断言为真(是闰年(2024), "2024是闰年")
结束)

测试用例("月份天数", 函数()
    断言相等(月份天数(2026, 1), 31)
结束)

测试用例("今天", 函数()
    字符串 t = 今天()
    断言为真(长度(t) > 0, "今天应返回日期字符串")
结束)

测试用例("格式化日期", 函数()
    字符串 s = 格式化日期(20240101)
    断言为真(长度(s) > 0, "应返回日期字符串")
结束)

运行所有测试()
