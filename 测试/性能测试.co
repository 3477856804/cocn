# ============================================================
# 测试/性能测试.co —— 基准测试
# ============================================================
导入 "标准库"

测试用例("循环10万次", 函数()
    整数 s = 0
    对于 i 从 1 到 100000 循环
        s = s + i
    结束
    # 1+2+…+100000 = 100000*100001/2 = 5000050000。
    # 原断言 500005000 少了个 0（差 10 倍），宿主/vm/eval 三通道实测都输出 5000050000，
    # 是【测试自己写错】而非引擎算错——这里以数学与三通道实测为准。
    断言相等(s, 5000050000)
结束)

测试用例("列表追加1万次", 函数()
    列表 l = []
    对于 i 从 1 到 10000 循环
        追加(l, i)
    结束
    断言相等(长度(l), 10000)
结束)

测试用例("递归斐波那契", 函数()
    函数 斐(整数 n)
        如果 n <= 1 则 返回 n 结束
        返回 斐(n - 1) + 斐(n - 2)
    结束
    断言相等(斐(20), 6765)
结束)

测试用例("字符串拼接", 函数()
    字符串 s = ""
    对于 i 从 1 到 1000 循环
        s = s + "a"
    结束
    断言相等(长度(s), 1000)
结束)

测试用例("字典插入", 函数()
    字典 d = {}
    # 宿主字典容量上限是 256 个键（运行时错误「字典已满（上限 256 个键）」，
    # co_old.c MAX_DICT_SIZE=256，本轮不改宿主 ABI）。原测试写 1000 键必炸，
    # 属于测试越过语言实现的既定容量——改为在容量内压测 250 键。
    对于 i 从 1 到 250 循环
        d[转字符串(i)] = i
    结束
    断言相等(长度(d), 250)
结束)

运行所有测试()
