# ============================================================
# 测试/网络测试.co —— 网络模块测试（离线逻辑）
# ============================================================
导入 "标准库"

测试用例("URL构造", 函数()
    函数 拼URL(字符串 基础, 字符串 路径)
        返回 基础 + 路径
    结束
    断言相等(拼URL("https://api.co", "/users"), "https://api.co/users")
结束)

测试用例("状态码分类", 函数()
    函数 类别(整数 码)
        如果 码 < 300 则 返回 "成功" 结束
        如果 码 < 400 则 返回 "重定向" 结束
        返回 "错误"
    结束
    断言相等(类别(200), "成功")
    断言相等(类别(404), "错误")
结束)

测试用例("端口字符串", 函数()
    断言相等(转字符串(8080), "8080")
结束)

运行所有测试()
