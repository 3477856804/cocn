# 向量零(整数 维) -> 列表：零向量
# 参数 维：维数
# 返回值：零向量
函数 向量零(整数 维) -> 列表
    列表 结果 = []
    对于 i 从 0 到 维 - 1 循环
        内置追加(结果, 0.0)
    结束
    返回 结果
结束

# 向量标量乘(列表 向量, 浮点 标量) -> 列表：数乘
# 参数 向量：向量；标量：倍数
# 返回值：新向量
函数 向量标量乘(列表 向量, 浮点 标量) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(向量) - 1 循环
        内置追加(结果, 向量[i] * 标量)
    结束
    返回 结果
结束

# 向量和(列表 向量表) -> 列表：多向量相加
# 参数 向量表：向量列表
# 返回值：和向量
函数 向量和(列表 向量表) -> 列表
    整数 n = 内置长度(向量表[0])
    列表 结果 = 向量零(n)
    对于 i 从 0 到 内置长度(向量表) - 1 循环
        结果 = 向量加(结果, 向量表[i])
    结束
    返回 结果
结束

