# ============================================================
# 库/系统.co —— coCN 标准库·系统模块
#
# 用途：环境变量、进程、平台信息、延时。
# 依赖宿主内置：环境变量/执行命令/睡眠/当前目录/时间戳。
#
# 函数清单：
#   环境：取环境变量 / 全部环境变量
#   进程：执行命令 / 执行并捕获 / 退出 / 睡眠
#   平台：操作系统 / 主机名 / 家目录
#   时间：当前时间戳 / 计时
# ============================================================

让 内置环境变量 = 环境变量
让 内置执行命令 = 执行命令
让 内置睡眠 = 睡眠
让 内置当前目录 = 当前目录
让 内置时间戳 = 时间戳

# ============================================================
# 环境变量
# ============================================================

# 取环境变量(字符串 名) -> 字符串：读环境变量
# 参数 名：变量名
# 返回值：变量值（无则空串）
函数 取环境变量(字符串 名) -> 字符串
    返回 内置环境变量(名)
结束

# 家目录() -> 字符串：用户家目录
# 参数：无
# 返回值：家目录路径
函数 家目录() -> 字符串
    返回 内置环境变量("HOME")
结束

# 路径分隔符() -> 字符串：PATH 分隔符
# 参数：无
# 返回值：":" 或 ";"
函数 路径分隔符() -> 字符串
    返回 ":"
结束

# 当前操作系统() -> 字符串：操作系统名
# 参数：无
# 返回值：系统名（尽力）
函数 当前操作系统() -> 字符串
    返回 内置执行命令("uname")
结束

# ============================================================
# 进程
# ============================================================

# 执行命令(字符串 命令) -> 字符串：执行 shell 命令
# 参数 命令：命令行
# 返回值：命令输出
函数 执行命令(字符串 命令) -> 字符串
    返回 内置执行命令(命令)
结束

# 睡眠(浮点 秒)：暂停
# 参数 秒：秒数
# 返回值：无
函数 睡眠(浮点 秒)
    内置睡眠(秒)
结束

# 当前工作目录() -> 字符串：cwd
# 参数：无
# 返回值：当前目录
函数 当前工作目录() -> 字符串
    返回 内置当前目录()
结束

# 主机名() -> 字符串：主机名
# 参数：无
# 返回值：主机名
函数 主机名() -> 字符串
    返回 内置执行命令("hostname")
结束

# ============================================================
# 时间
# ============================================================

# 现在() -> 浮点：当前 Unix 秒
# 参数：无
# 返回值：时间戳
函数 现在() -> 浮点
    返回 内置时间戳()
结束

# 计时开始() -> 浮点：计时起点
# 参数：无
# 返回值：时间戳
函数 计时开始() -> 浮点
    返回 内置时间戳()
结束

# 计时结束(浮点 起点) -> 浮点：耗时秒
# 参数 起点：计时开始值
# 返回值：秒数
函数 计时结束(浮点 起点) -> 浮点
    返回 内置时间戳() - 起点
结束

# ============================================================
# 扩展：更多环境与平台
# ============================================================

# 用户名() -> 字符串：当前用户名
# 参数：无
# 返回值：用户名
函数 用户名() -> 字符串
    返回 内置环境变量("USER")
结束

# Shell() -> 字符串：当前 shell
# 参数：无
# 返回值：shell 路径
函数 Shell() -> 字符串
    返回 内置环境变量("SHELL")
结束

# 语言() -> 字符串：locale
# 参数：无
# 返回值：LANG 值
函数 语言() -> 字符串
    返回 内置环境变量("LANG")
结束

# 临时目录() -> 字符串：临时目录
# 参数：无
# 返回值：/tmp
函数 临时目录() -> 字符串
    返回 "/tmp"
结束

# 搜索路径() -> 列表：PATH 拆分
# 参数：无
# 返回值：路径列表
函数 搜索路径() -> 列表
    返回 分割(内置环境变量("PATH"), ":")
结束

# 进程ID() -> 字符串：当前进程 PID
# 参数：无
# 返回值：PID 字符串
函数 进程ID() -> 字符串
    返回 内置执行命令("echo $$")
结束

# 毫秒() -> 浮点：当前毫秒时间戳
# 参数：无
# 返回值：毫秒
函数 毫秒() -> 浮点
    返回 内置时间戳() * 1000.0
结束

# 睡眠毫秒(整数 毫秒)：睡眠指定毫秒
# 参数 毫秒：毫秒数
# 返回值：无
函数 睡眠毫秒(整数 毫秒)
    内置睡眠(毫秒 / 1000.0)
结束

# 命令存在(字符串 命令) -> 布尔：命令是否在 PATH 中
# 参数 命令：命令名
# 返回值：存在为真
函数 命令存在(字符串 命令) -> 布尔
    字符串 r = 内置执行命令("which " + 命令)
    如果 r == "" 返回 假
    返回 真
结束

# 执行并捕获(字符串 命令) -> 字符串：执行并返回输出
# 参数 命令：命令行
# 返回值：stdout
函数 执行并捕获(字符串 命令) -> 字符串
    返回 内置执行命令(命令)
结束

# ============================================================
# 扩展：其它工具
# ============================================================

# 环境变量个数() -> 整数：环境变量数量（近似）
# 参数：无
# 返回值：数量
函数 环境变量个数() -> 整数
    列表 路径 = 搜索路径()
    返回 内置长度(路径)
结束

# 家目录存在() -> 布尔：家目录是否存在
# 参数：无
# 返回值：存在为真
函数 家目录存在() -> 布尔
    返回 家目录() != ""
结束

# 秒转时分秒(浮点 秒) -> 列表：把秒转 [时,分,秒]
# 参数 秒：总秒数
# 返回值：[时,分,秒]
函数 秒转时分秒(浮点 秒) -> 列表
    整数 总 = 转整数(秒)
    整数 h = 总 // 3600
    整数 m = (总 % 3600) // 60
    整数 s = 总 % 60
    返回 [h, m, s]
结束

# 格式化耗时(浮点 秒) -> 字符串：人类可读耗时
# 参数 秒：秒数
# 返回值：如 "1时2分3秒"
函数 格式化耗时(浮点 秒) -> 字符串
    列表 部 = 秒转时分秒(秒)
    返回 转字符串(部[0]) + "时" + 转字符串(部[1]) + "分" + 转字符串(部[2]) + "秒"
结束

# 空闲一秒()：暂停一秒
# 参数：无
# 返回值：无
函数 空闲一秒()
    内置睡眠(1.0)
结束

# ============================================================
# 扩展：更多系统信息
# ============================================================

# 临时文件路径(字符串 前缀) -> 字符串：生成临时文件路径
# 参数 前缀：文件名前缀
# 返回值：/tmp 下路径
函数 临时文件路径(字符串 前缀) -> 字符串
    返回 "/tmp/" + 前缀 + "_" + 转字符串(转整数(内置时间戳()))
结束

# 磁盘剩余() -> 字符串：磁盘剩余空间
# 参数：无
# 返回值：df 输出
函数 磁盘剩余() -> 字符串
    返回 内置执行命令("df -h /tmp")
结束

# 当前进程名() -> 字符串：当前进程
# 参数：无
# 返回值：进程信息
函数 当前进程名() -> 字符串
    返回 内置执行命令("echo coCN")
结束

# 环境变量包含(字符串 子串) -> 布尔：HOME 是否含子串
# 参数 子串：待查子串
# 返回值：含为真
函数 环境变量包含(字符串 子串) -> 布尔
    返回 内置查找(家目录(), 子串) != -1
结束

# 启动信息() -> 字典：系统信息摘要
# 参数：无
# 返回值：摘要字典
函数 启动信息() -> 字典
    返回 {"用户": 用户名(), "家": 家目录(), "cwd": 内置当前目录()}
结束

# 等待(浮点 秒)：同 睡眠
# 参数 秒：秒数
# 返回值：无
函数 等待秒(浮点 秒)
    内置睡眠(秒)
结束

# 时间戳秒() -> 整数：整数秒
# 参数：无
# 返回值：秒数
函数 时间戳秒() -> 整数
    返回 转整数(内置时间戳())
结束

# ============================================================
# 扩展：更多系统工具
# ============================================================

# 环境变量默认(字符串 名, 默认值) -> 值：取环境变量或缺省
# 参数 名：变量名；默认值：缺省
# 返回值：值或默认
函数 环境变量默认(字符串 名, 默认值)
    字符串 v = 内置环境变量(名)
    如果 v == "" 返回 默认值
    返回 v
结束

# 进程运行时间(浮点 开始时间) -> 浮点：已运行秒数
# 参数 开始时间：起始时间戳
# 返回值：秒数
函数 进程运行时间(浮点 开始时间) -> 浮点
    返回 内置时间戳() - 开始时间
结束

# 打印分隔线(整数 n)：打印 n 个横线
# 参数 n：横线条数
# 返回值：无
函数 打印分隔线(整数 n)
    字符串 线 = ""
    对于 i 从 0 到 n - 1 循环
        线 = 线 + "-"
    结束
    输出(线)
结束

# 主机信息() -> 字典：平台信息
# 参数：无
# 返回值：信息字典
函数 主机信息() -> 字典
    返回 {"操作系统": 操作系统(), "架构": 架构(), "用户": 用户名(), "家": 家目录()}
结束

# 时间戳毫秒() -> 浮点：毫秒时间戳
# 参数：无
# 返回值：毫秒
函数 时间戳毫秒() -> 浮点
    返回 内置时间戳() * 1000.0
结束

