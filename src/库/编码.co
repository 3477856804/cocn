# ============================================================
# 库/编码.co —— coCN 标准库·编码模块
#
# 用途：Base64 / Hex / URL / CSV / RLE 等编解码。
# 纯 coCN 实现。
#
# 函数清单：
#   Base64编码 / Base64解码
#   Hex编码 / Hex解码
#   URL编码 / URL解码
#   CSV解析 / CSV序列化
#   RLE压缩 / RLE解压
# ============================================================

让 内置长度 = 长度
让 内置追加 = 追加
让 内置连接 = 连接
让 内置查找 = 查找

# ============================================================
# Base64
# ============================================================

让 B64表 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# Base64编码(字符串 原文) -> 字符串：Base64 编码
# 参数 原文：字符串
# 返回值：Base64 串
函数 Base64编码(字符串 原文) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    整数 n = 内置长度(字节)
    整数 i = 0
    当 i + 2 < n 循环
        整数 b0 = 字节[i]
        整数 b1 = 字节[i + 1]
        整数 b2 = 字节[i + 2]
        结果 = 结果 + 截取(B64表, b0 >> 2, 1)
        结果 = 结果 + 截取(B64表, ((b0 & 3) << 4) | (b1 >> 4), 1)
        结果 = 结果 + 截取(B64表, ((b1 & 15) << 2) | (b2 >> 6), 1)
        结果 = 结果 + 截取(B64表, b2 & 63, 1)
        i = i + 3
    结束
    如果 i < n 则
        整数 b0 = 字节[i]
        如果 i + 1 == n 则
            结果 = 结果 + 截取(B64表, b0 >> 2, 1)
            结果 = 结果 + 截取(B64表, (b0 & 3) << 4, 1)
            结果 = 结果 + "=="
        否则
            整数 b1 = 字节[i + 1]
            结果 = 结果 + 截取(B64表, b0 >> 2, 1)
            结果 = 结果 + 截取(B64表, ((b0 & 3) << 4) | (b1 >> 4), 1)
            结果 = 结果 + 截取(B64表, (b1 & 15) << 2, 1)
            结果 = 结果 + "="
        结束
    结束
    返回 结果
结束

# Base64解码(字符串 b64) -> 字符串：Base64 解码
# 参数 b64：Base64 串
# 返回值：原文
函数 Base64解码(字符串 b64) -> 字符串
    列表 字节 = []
    整数 n = 内置长度(b64)
    整数 i = 0
    当 i + 3 < n 循环
        整数 v0 = 转整数(内置查找(B64表, 截取(b64, i, 1)))
        整数 v1 = 转整数(内置查找(B64表, 截取(b64, i + 1, 1)))
        整数 v2c = 截取(b64, i + 2, 1)
        整数 v3c = 截取(b64, i + 3, 1)
        内置追加(字节, (v0 << 2) | (v1 >> 4))
        如果 v2c != "=" 则
            整数 v2 = 转整数(内置查找(B64表, v2c))
            内置追加(字节, ((v1 & 15) << 4) | (v2 >> 2))
            如果 v3c != "=" 则
                整数 v3 = 转整数(内置查找(B64表, v3c))
                内置追加(字节, ((v2 & 3) << 6) | v3)
            结束
        结束
        i = i + 4
    结束
    返回 字节转文本(字节)
结束

# ============================================================
# Hex
# ============================================================

让 HEX表 = "0123456789abcdef"

# Hex编码(字符串 原文) -> 字符串：十六进制编码
# 参数 原文：字符串
# 返回值：hex 串
函数 Hex编码(字符串 原文) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    对于 i 从 0 到 内置长度(字节) - 1 循环
        整数 b = 字节[i]
        结果 = 结果 + 截取(HEX表, b >> 4, 1) + 截取(HEX表, b & 15, 1)
    结束
    返回 结果
结束

# Hex解码(字符串 hex) -> 字符串：十六进制解码
# 参数 hex：hex 串
# 返回值：原文
函数 Hex解码(字符串 hex) -> 字符串
    列表 字节 = []
    对于 i 从 0 到 内置长度(hex) / 2 - 1 循环
        整数 高 = 转整数(内置查找(HEX表, 截取(hex, i * 2, 1)))
        整数 低 = 转整数(内置查找(HEX表, 截取(hex, i * 2 + 1, 1)))
        内置追加(字节, (高 << 4) | 低)
    结束
    返回 字节转文本(字节)
结束

# ============================================================
# URL 编码
# ============================================================

# URL编码(字符串 原文) -> 字符串：百分号编码
# 参数 原文：字符串
# 返回值：编码串
函数 URL编码(字符串 原文) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    对于 i 从 0 到 内置长度(字节) - 1 循环
        整数 b = 字节[i]
        如果 (b >= 65 且 b <= 90) 或 (b >= 97 且 b <= 122) 或 (b >= 48 且 b <= 57) 或 b == 45 或 b == 46 或 b == 95 或 b == 126 则
            结果 = 结果 + 从ASCII(b)
        否则
            结果 = 结果 + "%" + 截取(HEX表, b >> 4, 1) + 截取(HEX表, b & 15, 1)
        结束
    结束
    返回 结果
结束

# ============================================================
# CSV
# ============================================================

# CSV解析(字符串 文本) -> 列表：解析 CSV 为行列表
# 参数 文本：CSV 文本
# 返回值：[[列,...],...]
函数 CSV解析(字符串 文本) -> 列表
    列表 行 = 分割(文本, "\n")
    列表 结果 = []
    对于 r 从 0 到 内置长度(行) - 1 循环
        如果 内置长度(行[r]) > 0 则
            内置追加(结果, 分割(行[r], ","))
        结束
    结束
    返回 结果
结束

# CSV序列化(列表 表格) -> 字符串：行列表转 CSV
# 参数 表格：[[列,...],...]
# 返回值：CSV 文本
函数 CSV序列化(列表 表格) -> 字符串
    列表 行串 = []
    对于 i 从 0 到 内置长度(表格) - 1 循环
        内置追加(行串, 连接(表格[i], ","))
    结束
    返回 连接(行串, "\n")
结束

# ============================================================
# RLE 压缩
# ============================================================

# RLE压缩(字符串 原文) -> 字符串：行程编码
# 参数 原文：字符串
# 返回值：压缩串（如 "aabbbc"->"2a3b1c"）
函数 RLE压缩(字符串 原文) -> 字符串
    如果 内置长度(原文) == 0 返回 ""
    字符串 结果 = ""
    整数 计数 = 1
    当前 = 截取(原文, 0, 1)
    对于 i 从 1 到 内置长度(原文) - 1 循环
        c = 截取(原文, i, 1)
        如果 c == 当前 则
            计数 = 计数 + 1
        否则
            结果 = 结果 + 转字符串(计数) + 当前
            当前 = c
            计数 = 1
        结束
    结束
    结果 = 结果 + 转字符串(计数) + 当前
    返回 结果
结束

# RLE解压(字符串 压缩) -> 字符串：行程解码
# 参数 压缩：RLE 串
# 返回值：原文
函数 RLE解压(字符串 压缩) -> 字符串
    字符串 结果 = ""
    整数 i = 0
    当 i < 内置长度(压缩) 循环
        字符串 数字串 = ""
        当 i < 内置长度(压缩) 且 是数字(截取(压缩, i, 1)) 循环
            数字串 = 数字串 + 截取(压缩, i, 1)
            i = i + 1
        结束
        c = 截取(压缩, i, 1)
        i = i + 1
        整数 计数 = 转整数(数字串)
        对于 k 从 0 到 计数 - 1 循环
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

