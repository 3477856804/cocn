# ============================================================
# 库/中文.co —— coCN 标准库·中文文本模块
#
# 用途：中文数字与人民币大写、全角/半角转换、中英标点互转、
#       汉字判定与统计、分句。全部为纯 coCN 实现，
#       只用宿主内置函数，因此 eval / vm / native 三通道结果天然一致。
#
# 使用：导入 "库/中文"
#
# 函数清单：
#   数字：数字转汉字 / 汉字转数字 / 金额大写 / 金额大写含角分 / 转大写数码
#   标点：全角转半角 / 半角转全角 / 中文标点转英文 / 英文标点转中文
#   文本：是汉字 / 统计汉字 / 分句 / 去首尾空白
# ============================================================

让 汉字数码 = "零一二三四五六七八九"
让 大写数码 = "零壹贰叁肆伍陆柒捌玖"
让 数位名 = ["", "十", "百", "千"]
让 组单位 = ["", "万", "亿", "万亿"]
让 中文标点 = "，。！？：；“”‘’（）【】、"
让 英文标点 = ",.!?:;\"\"''()[],"
让 句读 = "。！？；.!?;\n"

# 在字符集里找字的位置，找不到返回 -1
函数 位序(字符串 集, 字符串 字) -> 整数
    如果 长度(字) != 1 则
        返回 -1
    结束
    对于 i 从 0 到 长度(集) - 1 循环
        如果 集[i] == 字 则
            返回 i
        结束
    结束
    返回 -1
结束

# 左侧补零到 4 位
函数 四位文本(整数 段) -> 字符串
    让 s = 转字符串(段)
    当 长度(s) < 4 循环
        s = "0" + s
    结束
    返回 s
结束

# 把 0~9999 转成「千百十个」写法，内部零压缩（一千零五、一百一十）
函数 段转汉字(整数 段) -> 字符串
    让 s = 四位文本(段)
    让 结果 = ""
    让 待补零 = 假
    对于 i 从 0 到 3 循环
        让 数 = 转整数(s[i])
        如果 数 == 0 则
            如果 结果 != "" 则
                待补零 = 真
            结束
        否则
            如果 待补零 且 结果 != "" 则
                结果 = 结果 + "零"
            结束
            结果 = 结果 + 汉字数码[数] + 数位名[3 - i]
            待补零 = 假
        结束
    结束
    返回 结果
结束

# 整数 → 中文小写数字（支持到 万亿位，负数加「负」）
函数 数字转汉字(整数 n) -> 字符串
    如果 n < 0 则
        返回 "负" + 数字转汉字(0 - n)
    结束
    如果 n == 0 则
        返回 "零"
    结束
    让 s = 转字符串(n)
    当 长度(s) % 4 != 0 循环
        s = "0" + s
    结束
    让 组数 = 长度(s) / 4
    让 结果 = ""
    让 前面有内容 = 假
    对于 组 从 0 到 组数 - 1 循环
        让 段 = 转整数(切片(s, 组 * 4, 组 * 4 + 4))
        让 单位 = 组单位[组数 - 1 - 组]
        让 段文本 = 段转汉字(段)
        如果 段文本 == "" 则
            如果 前面有内容 且 结果 != "" 且 结果[长度(结果) - 1] != "零" 则
                结果 = 结果 + "零"
            结束
        否则
            如果 前面有内容 且 段 < 1000 则
                结果 = 结果 + "零"
            结束
            结果 = 结果 + 段文本 + 单位
            前面有内容 = 真
        结束
    结束
    当 长度(结果) > 0 且 结果[长度(结果) - 1] == "零" 循环
        结果 = 切片(结果, 0, 长度(结果) - 1)
    结束
    # 「一十五」读作「十五」：十位起头的两位数习惯省略「一」
    如果 长度(结果) >= 2 且 结果[0] == "一" 且 结果[1] == "十" 则
        结果 = 切片(结果, 1, 长度(结果))
    结束
    返回 结果
结束

# 中文小写数字 → 整数（认得 十百千万亿、两，以及大写数码）
函数 汉字转数字(字符串 s) -> 整数
    让 总 = 0
    让 段 = 0
    让 数 = 0
    让 有数 = 假
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = s[i]
        让 d = 位序(汉字数码, c)
        如果 d < 0 则
            d = 位序(大写数码, c)
        结束
        如果 c == "两" 则
            d = 2
        结束
        如果 d >= 0 则
            数 = d
            有数 = 真
        否则如果 c == "十" 或 c == "拾" 则
            如果 数 == 0 则
                数 = 1
            结束
            段 = 段 + 数 * 10
            数 = 0
        否则如果 c == "百" 或 c == "佰" 则
            如果 数 == 0 则
                数 = 1
            结束
            段 = 段 + 数 * 100
            数 = 0
        否则如果 c == "千" 或 c == "仟" 则
            如果 数 == 0 则
                数 = 1
            结束
            段 = 段 + 数 * 1000
            数 = 0
        否则如果 c == "万" 则
            段 = 段 + 数
            总 = 总 + 段 * 10000
            段 = 0
            数 = 0
        否则如果 c == "亿" 则
            段 = 段 + 数
            总 = (总 + 段) * 100000000
            段 = 0
            数 = 0
        结束
    结束
    返回 总 + 段 + 数
结束

# 小写写法 → 人民币大写写法（十→拾、百→佰、千→仟、数码换大写）
函数 转大写数码(字符串 s) -> 字符串
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = s[i]
        让 d = 位序(汉字数码, c)
        如果 d >= 0 则
            结果 = 结果 + 大写数码[d]
        否则如果 c == "十" 则
            结果 = 结果 + "拾"
        否则如果 c == "百" 则
            结果 = 结果 + "佰"
        否则如果 c == "千" 则
            结果 = 结果 + "仟"
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 金额用数码：人民币大写规范里「十」要写成「壹拾」，不能省「壹」
函数 金额数码(整数 n) -> 字符串
    让 大 = 转大写数码(数字转汉字(n))
    如果 长度(大) > 0 且 大[0] == "拾" 则
        返回 "壹" + 大
    结束
    返回 大
结束

# 整数元 → 人民币大写（整元，带「整」）
函数 金额大写(整数 元) -> 字符串
    如果 元 < 0 则
        返回 "负" + 金额大写(0 - 元)
    结束
    如果 元 == 0 则
        返回 "零元整"
    结束
    返回 金额数码(元) + "元整"
结束

# 元/角/分 → 人民币大写（含角分）
函数 金额大写含角分(整数 元, 整数 角, 整数 分) -> 字符串
    如果 元 < 0 则
        返回 "负" + 金额大写含角分(0 - 元, 角, 分)
    结束
    让 结果 = ""
    如果 元 > 0 则
        结果 = 金额数码(元) + "元"
    否则
        结果 = "零元"
    结束
    如果 角 > 0 则
        结果 = 结果 + 大写数码[角] + "角"
    否则如果 分 > 0 则
        结果 = 结果 + "零"
    结束
    如果 分 > 0 则
        结果 = 结果 + 大写数码[分] + "分"
    否则如果 角 == 0 则
        结果 = 结果 + "整"
    结束
    返回 结果
结束

# 全角 → 半角（含全角空格 U+3000）
函数 全角转半角(字符串 s) -> 字符串
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 码 = 字符码(s[i])
        如果 码 == 12288 则
            结果 = 结果 + " "
        否则如果 码 >= 65281 且 码 <= 65374 则
            结果 = 结果 + 码转字符(码 - 65248)
        否则
            结果 = 结果 + s[i]
        结束
    结束
    返回 结果
结束

# 半角 → 全角（含半角空格）
函数 半角转全角(字符串 s) -> 字符串
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 码 = 字符码(s[i])
        如果 码 == 32 则
            结果 = 结果 + 码转字符(12288)
        否则如果 码 >= 33 且 码 <= 126 则
            结果 = 结果 + 码转字符(码 + 65248)
        否则
            结果 = 结果 + s[i]
        结束
    结束
    返回 结果
结束

# 中文标点 → 英文标点
函数 中文标点转英文(字符串 s) -> 字符串
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 位置 = 位序(中文标点, s[i])
        如果 位置 >= 0 则
            结果 = 结果 + 英文标点[位置]
        否则
            结果 = 结果 + s[i]
        结束
    结束
    返回 结果
结束

# 英文标点 → 中文标点
函数 英文标点转中文(字符串 s) -> 字符串
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 位置 = 位序(英文标点, s[i])
        如果 位置 >= 0 则
            结果 = 结果 + 中文标点[位置]
        否则
            结果 = 结果 + s[i]
        结束
    结束
    返回 结果
结束

# 单个字符是否汉字（基本区 + 扩展 A）
函数 是汉字(字符串 字) -> 布尔
    如果 长度(字) != 1 则
        返回 假
    结束
    让 码 = 字符码(字)
    如果 码 >= 13312 且 码 <= 40959 则
        返回 真
    结束
    返回 假
结束

# 统计字符串里的汉字个数
函数 统计汉字(字符串 s) -> 整数
    让 计数 = 0
    对于 i 从 0 到 长度(s) - 1 循环
        如果 是汉字(s[i]) 则
            计数 = 计数 + 1
        结束
    结束
    返回 计数
结束

# 去掉首尾空白（空格/制表/换行）
函数 去首尾空白(字符串 s) -> 字符串
    让 起 = 0
    让 止 = 长度(s) - 1
    当 起 <= 止 且 (s[起] == " " 或 s[起] == "\t" 或 s[起] == "\n" 或 s[起] == "\r") 循环
        起 = 起 + 1
    结束
    当 止 >= 起 且 (s[止] == " " 或 s[止] == "\t" 或 s[止] == "\n" 或 s[止] == "\r") 循环
        止 = 止 - 1
    结束
    如果 止 < 起 则
        返回 ""
    结束
    返回 切片(s, 起, 止 + 1)
结束

# 按中文句读切句，空句丢弃
函数 分句(字符串 s) -> 列表
    列表 结果 = []
    让 当前 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = s[i]
        如果 位序(句读, c) >= 0 则
            让 一句 = 去首尾空白(当前)
            如果 一句 != "" 则
                追加(结果, 一句)
            结束
            当前 = ""
        否则
            当前 = 当前 + c
        结束
    结束
    让 尾句 = 去首尾空白(当前)
    如果 尾句 != "" 则
        追加(结果, 尾句)
    结束
    返回 结果
结束
