# ============================================================
# 库/加密.co —— coCN 标准库·加密模块
#
# 用途：对称加密（XOR/凯撒/维吉尼亚）、哈希校验（CRC32/校验和）、
#       编码（ROT13）。教学简化实现。
#
# 函数清单：
#   XOR加密 / XOR解密
#   凯撒加密 / 凯撒解密
#   维吉尼亚加密 / 维吉尼亚解密
#   ROT13
#   校验和(8位) / CRC32
# ============================================================

让 内置长度 = 长度

# ============================================================
# XOR 加密
# ============================================================

# XOR加密(字符串 原文, 整数 密钥) -> 字符串：逐字节异或
# 参数 原文：字符串；密钥：单字节密钥
# 返回值：密文
函数 XOR加密(字符串 原文, 整数 密钥) -> 字符串
    列表 字节 = 字节列表(原文)
    对于 i 从 0 到 内置长度(字节) - 1 循环
        字节[i] = 字节[i] ^ 密钥
    结束
    返回 字节转文本(字节)
结束

# XOR解密(字符串 密文, 整数 密钥) -> 字符串：同 XOR加密
# 参数 密文：密文；密钥：单字节密钥
# 返回值：原文
函数 XOR解密(字符串 密文, 整数 密钥) -> 字符串
    返回 XOR加密(密文, 密钥)
结束

# ============================================================
# 凯撒密码
# ============================================================

# 凯撒加密(字符串 原文, 整数 移位) -> 字符串：字母移位
# 参数 原文：字符串；移位：位移量
# 返回值：密文
函数 凯撒加密(字符串 原文, 整数 移位) -> 字符串
    字符串 结果 = ""
    对于 i 从 0 到 内置长度(原文) - 1 循环
        c = 截取(原文, i, 1)
        整数 码 = 转ASCII(c)
        如果 码 >= 65 且 码 <= 90 则
            结果 = 结果 + 从ASCII((码 - 65 + 移位) % 26 + 65)
        否则 如果 码 >= 97 且 码 <= 122 则
            结果 = 结果 + 从ASCII((码 - 97 + 移位) % 26 + 97)
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 凯撒解密(字符串 密文, 整数 移位) -> 字符串：反向移位
# 参数 密文：密文；移位：位移量
# 返回值：原文
函数 凯撒解密(字符串 密文, 整数 移位) -> 字符串
    返回 凯撒加密(密文, 26 - 移位 % 26)
结束

# ROT13(字符串 原文) -> 字符串：ROT13
# 参数 原文：字符串
# 返回值：ROT13 串
函数 ROT13(字符串 原文) -> 字符串
    返回 凯撒加密(原文, 13)
结束

# ============================================================
# 维吉尼亚密码
# ============================================================

# 维吉尼亚加密(字符串 原文, 字符串 密钥) -> 字符串：多表替换
# 参数 原文：字符串；密钥：密钥词
# 返回值：密文
函数 维吉尼亚加密(字符串 原文, 字符串 密钥) -> 字符串
    字符串 结果 = ""
    整数 ki = 0
    对于 i 从 0 到 内置长度(原文) - 1 循环
        c = 截取(原文, i, 1)
        整数 码 = 转ASCII(c)
        整数 k = 转ASCII(截取(密钥, 转整数(ki % 内置长度(密钥)), 1))
        如果 码 >= 65 且 码 <= 90 则
            结果 = 结果 + 从ASCII((码 - 65 + k - 65 + 26) % 26 + 65)
            ki = ki + 1
        否则 如果 码 >= 97 且 码 <= 122 则
            结果 = 结果 + 从ASCII((码 - 97 + k - 97 + 26) % 26 + 97)
            ki = ki + 1
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 维吉尼亚解密(字符串 密文, 字符串 密钥) -> 字符串：反向
# 参数 密文：密文；密钥：密钥词
# 返回值：原文
函数 维吉尼亚解密(字符串 密文, 字符串 密钥) -> 字符串
    字符串 结果 = ""
    整数 ki = 0
    对于 i 从 0 到 内置长度(密文) - 1 循环
        c = 截取(密文, i, 1)
        整数 码 = 转ASCII(c)
        整数 k = 转ASCII(截取(密钥, 转整数(ki % 内置长度(密钥)), 1))
        如果 码 >= 65 且 码 <= 90 则
            结果 = 结果 + 从ASCII((码 - 65 - (k - 65) + 26) % 26 + 65)
            ki = ki + 1
        否则 如果 码 >= 97 且 码 <= 122 则
            结果 = 结果 + 从ASCII((码 - 97 - (k - 97) + 26) % 26 + 97)
            ki = ki + 1
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# ============================================================
# 校验
# ============================================================

# 校验和(字符串 原文) -> 整数：8位求和校验和
# 参数 原文：字符串
# 返回值：0~255
函数 校验和(字符串 原文) -> 整数
    列表 字节 = 字节列表(原文)
    整数 s = 0
    对于 i 从 0 到 内置长度(字节) - 1 循环
        s = (s + 字节[i]) % 256
    结束
    返回 s
结束

# CRC32(字符串 原文) -> 整数：CRC32 校验（简化）
# 参数 原文：字符串
# 返回值：32位 CRC
函数 CRC32(字符串 原文) -> 整数
    列表 表 = CRC32建表()
    整数 crc = 4294967295
    列表 字节 = 字节列表(原文)
    对于 i 从 0 到 内置长度(字节) - 1 循环
        整数 idx = (crc ^ 字节[i]) & 255
        crc = (crc >> 8) ^ 表[idx]
    结束
    返回 crc ^ 4294967295
结束

# CRC32建表() -> 列表：生成 CRC32 查表
# 参数：无
# 返回值：256 项表
函数 CRC32建表() -> 列表
    列表 表 = []
    对于 n 从 0 到 255 循环
        整数 c = n
        对于 k 从 0 到 7 循环
            如果 c & 1 == 1 则
                c = 3988292383 ^ (c >> 1)
            否则
                c = c >> 1
            结束
        结束
        内置追加(表, c)
    结束
    返回 表
结束

