# ============================================================
# 库/字典.co —— coCN 标准库·字典模块
#
# 用途：字典（键值对）的基础操作、遍历、变换、判断与转换。
# 仅依赖宿主内置函数；与内置同名者先捕获再遮蔽并委托。
#
# 函数清单：
#   基础：创建 / 设置 / 获取 / 删除 / 包含 / 长度 / 清空 / 复制
#   遍历：键 / 值 / 条目 / 遍历 / 键列表 / 值列表
#   变换：映射键 / 映射值 / 过滤 / 合并 / 反转
#   判断：相等 / 子集 / 超集
#   转换：转列表 / 列表转字典 / 键值对反转
# ============================================================

让 内置键 = 键
让 内置值 = 值
让 内置删除键 = 删除键
让 内置条目 = 条目
让 内置包含 = 包含
让 内置长度 = 长度
让 内置深拷贝 = 深拷贝
让 内置排序 = 排序

# ============================================================
# 基础
# ============================================================

# 创建() -> 字典：新建空字典
# 参数：无
# 返回值：空字典 {}
函数 创建() -> 字典
    返回 {}
结束

# 设置(字典 表, 键, 值)：设置键值（原地）
# 参数 表：字典；键：字符串键；值：任意值
# 返回值：无
函数 设置(字典 表, 键, 值)
    表[键] = 值
结束

# 获取(字典 表, 键, 默认值) -> 值：按键取值，不存在返回默认值
# 参数 表：字典；键：字符串键；默认值：缺省返回值
# 返回值：对应值或默认值
函数 获取(字典 表, 键, 默认值)
    如果 内置包含(表, 键) 返回 表[键]
    返回 默认值
结束

# 删除(字典 表, 键)：删除指定键（原地）
# 参数 表：字典；键：待删键
# 返回值：无
函数 删除(字典 表, 键)
    内置删除键(表, 键)
结束

# 包含(字典 表, 键) -> 布尔：字典是否含键
# 参数 表：字典；键：待查键
# 返回值：包含为真
函数 包含(字典 表, 键) -> 布尔
    返回 内置包含(表, 键)
结束

# 长度(字典 表) -> 整数：键个数
# 参数 表：字典
# 返回值：键数
函数 长度(字典 表) -> 整数
    返回 内置长度(表)
结束

# 清空(字典 表)：清空字典（原地）
# 参数 表：字典
# 返回值：无
函数 清空(字典 表)
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        内置删除键(表, ks[i])
    结束
结束

# 复制(字典 表) -> 字典：浅拷贝
# 参数 表：字典
# 返回值：新字典
函数 复制(字典 表) -> 字典
    字典 结果 = {}
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        结果[ks[i]] = 表[ks[i]]
    结束
    返回 结果
结束

# 深复制(字典 表) -> 字典：深拷贝
# 参数 表：字典
# 返回值：完全独立的新字典
函数 深复制(字典 表) -> 字典
    返回 内置深拷贝(表)
结束

# ============================================================
# 遍历
# ============================================================

# 键(字典 表) -> 列表：所有键列表
# 参数 表：字典
# 返回值：键列表
函数 键(字典 表) -> 列表
    返回 内置键(表)
结束

# 值(字典 表) -> 列表：所有值列表
# 参数 表：字典
# 返回值：值列表
函数 值(字典 表) -> 列表
    返回 内置值(表)
结束

# 条目(字典 表) -> 列表：[键, 值] 对列表
# 参数 表：字典
# 返回值：条目列表
函数 条目(字典 表) -> 列表
    返回 内置条目(表)
结束

# 遍历(字典 表, 函数 动作)：对每个键值对执行动作
# 参数 表：字典；动作：(键,值)->()
# 返回值：无
函数 遍历(字典 表, 动作)
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        动作(ks[i], 表[ks[i]])
    结束
结束

# 键列表(字典 表) -> 列表：同 键
# 参数 表：字典
# 返回值：键列表
函数 键列表(字典 表) -> 列表
    返回 内置键(表)
结束

# 值列表(字典 表) -> 列表：同 值
# 参数 表：字典
# 返回值：值列表
函数 值列表(字典 表) -> 列表
    返回 内置值(表)
结束

# ============================================================
# 变换
# ============================================================

# 映射值(字典 表, 函数 变换) -> 字典：对每个值应用变换
# 参数 表：字典；变换：(键,值)->新值
# 返回值：新字典
函数 映射值(字典 表, 变换) -> 字典
    字典 结果 = {}
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        结果[ks[i]] = 变换(ks[i], 表[ks[i]])
    结束
    返回 结果
结束

# 映射键(字典 表, 函数 变换) -> 字典：对每个键应用变换
# 参数 表：字典；变换：(键,值)->新键
# 返回值：新字典
函数 映射键(字典 表, 变换) -> 字典
    字典 结果 = {}
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        结果[变换(ks[i], 表[ks[i]])] = 表[ks[i]]
    结束
    返回 结果
结束

# 过滤(字典 表, 函数 谓词) -> 字典：保留满足谓词的条目
# 参数 表：字典；谓词：(键,值)->布尔
# 返回值：新字典
函数 过滤(字典 表, 谓词) -> 字典
    字典 结果 = {}
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 谓词(ks[i], 表[ks[i]]) 则
            结果[ks[i]] = 表[ks[i]]
        结束
    结束
    返回 结果
结束

# 合并(字典 甲, 字典 乙) -> 字典：合并两字典（乙覆盖甲）
# 参数 甲, 乙：字典
# 返回值：合并后新字典
函数 合并(字典 甲, 字典 乙) -> 字典
    字典 结果 = 复制(甲)
    列表 ks = 内置键(乙)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        结果[ks[i]] = 乙[ks[i]]
    结束
    返回 结果
结束

# 反转(字典 表) -> 字典：键值互换
# 参数 表：字典（值需可转字符串作键）
# 返回值：值为键、键为值的新字典
函数 反转(字典 表) -> 字典
    字典 结果 = {}
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        结果[转字符串(表[ks[i]])] = ks[i]
    结束
    返回 结果
结束

# ============================================================
# 判断
# ============================================================

# 相等(字典 甲, 字典 乙) -> 布尔：两字典内容相等
# 参数 甲, 乙：字典
# 返回值：键集合与各值都相等为真
函数 相等(字典 甲, 字典 乙) -> 布尔
    如果 内置长度(甲) != 内置长度(乙) 返回 假
    列表 ks = 内置键(甲)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 非 内置包含(乙, ks[i]) 则
            返回 假
        结束
        如果 甲[ks[i]] != 乙[ks[i]] 则
            返回 假
        结束
    结束
    返回 真
结束

# 子集(字典 甲, 字典 乙) -> 布尔：甲是否为乙子集（键值都含于乙）
# 参数 甲, 乙：字典
# 返回值：甲的每个键值都在乙中为真
函数 子集(字典 甲, 字典 乙) -> 布尔
    列表 ks = 内置键(甲)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 非 内置包含(乙, ks[i]) 则
            返回 假
        结束
        如果 甲[ks[i]] != 乙[ks[i]] 则
            返回 假
        结束
    结束
    返回 真
结束

# 超集(字典 甲, 字典 乙) -> 布尔：甲是否为乙超集
# 参数 甲, 乙：字典
# 返回值：乙是否为甲子集
函数 超集(字典 甲, 字典 乙) -> 布尔
    返回 子集(乙, 甲)
结束

# 有交集键(字典 甲, 字典 乙) -> 布尔：两字典是否有公共键
# 参数 甲, 乙：字典
# 返回值：有公共键为真
函数 有交集键(字典 甲, 字典 乙) -> 布尔
    列表 ks = 内置键(甲)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 内置包含(乙, ks[i]) 则
            返回 真
        结束
    结束
    返回 假
结束

# ============================================================
# 转换
# ============================================================

# 转列表(字典 表) -> 列表：转为 [键, 值] 列表
# 参数 表：字典
# 返回值：条目列表
函数 转列表(字典 表) -> 列表
    返回 内置条目(表)
结束

# 列表转字典(列表 对) -> 字典：由 [键,值] 对列表构造字典
# 参数 对：[[k,v], ...] 列表
# 返回值：字典
函数 列表转字典(列表 对) -> 字典
    字典 结果 = {}
    对于 i 从 0 到 内置长度(对) - 1 循环
        结果[转字符串(对[i][0])] = 对[i][1]
    结束
    返回 结果
结束

# 键值对反转(字典 表) -> 字典：同 反转
# 参数 表：字典
# 返回值：键值互换字典
函数 键值对反转(字典 表) -> 字典
    返回 反转(表)
结束

# 按键排序(字典 表) -> 列表：按键排序后的 [键,值] 列表
# 参数 表：字典
# 返回值：排序条目列表
函数 按键排序(字典 表) -> 列表
    列表 条目表 = 内置条目(表)
    内置排序(条目表)
    返回 条目表
结束

# 按值排序(字典 表) -> 列表：按值排序后的条目列表
# 参数 表：字典
# 返回值：按值排序的条目列表
函数 按值排序(字典 表) -> 列表
    列表 条目表 = 内置条目(表)
    # 简单按第二项冒泡
    整数 n = 内置长度(条目表)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - i - 2 循环
            如果 条目表[j][1] > 条目表[j + 1][1] 则
                临时 = 条目表[j]
                条目表[j] = 条目表[j + 1]
                条目表[j + 1] = 临时
            结束
        结束
    结束
    返回 条目表
结束

# ============================================================
# 扩展：计数与统计
# ============================================================

# 键数(字典 表) -> 整数：键个数
# 参数 表：字典
# 返回值：键数
函数 键数(字典 表) -> 整数
    返回 内置长度(表)
结束

# 所有键都满足(字典 表, 函数 谓词) -> 布尔：所有键满足谓词
# 参数 表：字典；谓词：键->布尔
# 返回值：全部满足为真
函数 所有键都满足(字典 表, 谓词) -> 布尔
    列表 ks = 内置键(表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 非 谓词(ks[i]) 则
            返回 假
        结束
    结束
    返回 真
结束

# 所有值都满足(字典 表, 函数 谓词) -> 布尔：所有值满足谓词
# 参数 表：字典；谓词：值->布尔
# 返回值：全部满足为真
函数 所有值都满足(字典 表, 谓词) -> 布尔
    列表 vs = 内置值(表)
    对于 i 从 0 到 内置长度(vs) - 1 循环
        如果 非 谓词(vs[i]) 则
            返回 假
        结束
    结束
    返回 真
结束

# 值求和(字典 表) -> 数值：所有数值之和
# 参数 表：值为数值的字典
# 返回值：值总和
函数 值求和(字典 表)
    列表 vs = 内置值(表)
    浮点 s = 0.0
    对于 i 从 0 到 内置长度(vs) - 1 循环
        s = s + vs[i]
    结束
    返回 s
结束

# 值最大(字典 表) -> 值：最大值（按值）
# 参数 表：值可比较的字典
# 返回值：最大的值
函数 值最大(字典 表)
    列表 vs = 内置值(表)
    如果 内置长度(vs) == 0 抛出 "值最大：空字典"
    浮点 最 = vs[0]
    对于 i 从 1 到 内置长度(vs) - 1 循环
        如果 vs[i] > 最 则
            最 = vs[i]
        结束
    结束
    返回 最
结束

# 值最小(字典 表) -> 值：最小值（按值）
# 参数 表：值可比较的字典
# 返回值：最小的值
函数 值最小(字典 表)
    列表 vs = 内置值(表)
    如果 内置长度(vs) == 0 抛出 "值最小：空字典"
    浮点 最 = vs[0]
    对于 i 从 1 到 内置长度(vs) - 1 循环
        如果 vs[i] < 最 则
            最 = vs[i]
        结束
    结束
    返回 最
结束

# 找最大值键(字典 表) -> 键：返回值最大的键
# 参数 表：值可比较的字典
# 返回值：对应键
函数 找最大值键(字典 表)
    列表 ks = 内置键(表)
    如果 内置长度(ks) == 0 返回 空
    字符串 最佳键 = ks[0]
    对于 i 从 1 到 内置长度(ks) - 1 循环
        如果 表[ks[i]] > 表[最佳键] 则
            最佳键 = ks[i]
        结束
    结束
    返回 最佳键
结束

# 找最小值键(字典 表) -> 键：返回值最小的键
# 参数 表：值可比较的字典
# 返回值：对应键
函数 找最小值键(字典 表)
    列表 ks = 内置键(表)
    如果 内置长度(ks) == 0 返回 空
    字符串 最佳键 = ks[0]
    对于 i 从 1 到 内置长度(ks) - 1 循环
        如果 表[ks[i]] < 表[最佳键] 则
            最佳键 = ks[i]
        结束
    结束
    返回 最佳键
结束

# ============================================================
# 扩展：默认字典与计数
# ============================================================

# 计数器(列表 表) -> 字典：统计元素频次
# 参数 表：列表
# 返回值：元素 -> 次数
函数 计数器(列表 表) -> 字典
    字典 结果 = {}
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 内置包含(结果, k) 则
            结果[k] = 结果[k] + 1
        否则
            结果[k] = 1
        结束
    结束
    返回 结果
结束

# 增量(字典 表, 键, 步长)：把键对应值加 步长（无则从 0 开始）
# 参数 表：字典；键：字符串键；步长：增量
# 返回值：无
函数 增量(字典 表, 键, 增量值)
    如果 内置包含(表, 键) 则
        表[键] = 表[键] + 增量值
    否则
        表[键] = 增量值
    结束
结束

# 获取或插入(字典 表, 键, 默认值) -> 值：取键，不存在则写入默认值
# 参数 表：字典；键：字符串键；默认值：缺省值
# 返回值：键对应的值
函数 获取或插入(字典 表, 键, 默认值)
    如果 内置包含(表, 键) 返回 表[键]
    表[键] = 默认值
    返回 默认值
结束

# 从键值列表构造(列表 键表, 列表 值表) -> 字典：两列表构造字典
# 参数 键表：键列表；值表：值列表（等长）
# 返回值：字典
函数 从键值列表构造(列表 键表, 列表 值表) -> 字典
    字典 结果 = {}
    整数 n = 内置长度(键表)
    如果 内置长度(值表) < n 则 n = 内置长度(值表) 结束
    对于 i 从 0 到 n - 1 循环
        结果[转字符串(键表[i])] = 值表[i]
    结束
    返回 结果
结束

# 键差集(字典 甲, 字典 乙) -> 列表：甲有而乙没有的键
# 参数 甲, 乙：字典
# 返回值：键列表
函数 键差集(字典 甲, 字典 乙) -> 列表
    列表 结果 = []
    列表 ks = 内置键(甲)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 非 内置包含(乙, ks[i]) 则
            内置追加(结果, ks[i])
        结束
    结束
    返回 结果
结束

# 键交集(字典 甲, 字典 乙) -> 列表：共同键
# 参数 甲, 乙：字典
# 返回值：共同键列表
函数 键交集(字典 甲, 字典 乙) -> 列表
    列表 结果 = []
    列表 ks = 内置键(甲)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 内置包含(乙, ks[i]) 则
            内置追加(结果, ks[i])
        结束
    结束
    返回 结果
结束

# ============================================================
# 扩展：嵌套访问与默认值
# ============================================================

# 深度获取(字典 表, 列表 路径, 默认值) -> 值：按路径深层取值
# 参数 表：嵌套字典；路径：键列表；默认值：取不到时返回
# 返回值：路径末端的值
函数 深度获取(字典 表, 列表 路径, 默认值)
    字典 当前 = 表
    对于 i 从 0 到 内置长度(路径) - 1 循环
        如果 非 内置包含(当前, 路径[i]) 则
            返回 默认值
        结束
        当前 = 当前[路径[i]]
    结束
    返回 当前
结束

# 深度设置(字典 表, 列表 路径, 值)：按路径深层设值（自动建中间层）
# 参数 表：根字典；路径：键列表；值：目标值
# 返回值：无
函数 深度设置(字典 表, 列表 路径, 值)
    字典 当前 = 表
    对于 i 从 0 到 内置长度(路径) - 2 循环
        如果 非 内置包含(当前, 路径[i]) 则
            当前[路径[i]] = {}
        结束
        当前 = 当前[路径[i]]
    结束
    当前[路径[内置长度(路径) - 1]] = 值
结束

# 默认字典(字典 表, 默认值) -> 字典：取不存在键时返回默认值的包装
