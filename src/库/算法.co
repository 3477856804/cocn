# ============================================================
# 库/算法.co —— coCN 标准库·算法模块
#
# 用途：经典算法库——排序、搜索、图算法、动态规划、贪心、
#       回溯、字符串匹配、几何、数值方法。
# 仅依赖宿主内置函数。
#
# 函数清单：
#   排序：冒泡/选择/插入/快速/归并/堆/希尔/计数/桶
#   搜索：线性/二分/插值/跳跃
#   图：BFS/DFS/Dijkstra/Floyd/Prim/Kruskal/拓扑
#   动态规划：斐波那契/背包/LCS/LIS/编辑距离/矩阵链
#   贪心：活动选择/霍夫曼/任务调度
#   回溯：N皇后/全排列/子集和/迷宫
#   字符串匹配：KMP/Rabin-Karp
#   几何：凸包/最近点对/线段相交
#   数值：牛顿迭代/二分求根/高斯消元
# ============================================================

让 内置长度 = 长度
让 内置追加 = 追加
让 内置弹出 = 弹出
让 内置切片 = 切片
让 包含 = 包含

# ============================================================
# 排序
# ============================================================

# 冒泡排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 冒泡排序(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 表[i])
    结束
    整数 n = 内置长度(结果)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - i - 2 循环
            如果 结果[j] > 结果[j + 1] 则
                临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
        结束
    结束
    返回 结果
结束

# 选择排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 选择排序(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 表[i])
    结束
    整数 n = 内置长度(结果)
    对于 i 从 0 到 n - 1 循环
        整数 最小下标 = i
        对于 j 从 i + 1 到 n - 1 循环
            如果 结果[j] < 结果[最小下标] 则
                最小下标 = j
            结束
        结束
        临时 = 结果[i]
        结果[i] = 结果[最小下标]
        结果[最小下标] = 临时
    结束
    返回 结果
结束

# 插入排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 插入排序(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 表[i])
    结束
    对于 i 从 1 到 内置长度(结果) - 1 循环
        浮点 键 = 结果[i]
        整数 j = i - 1
        当 j >= 0 且 结果[j] > 键 循环
            结果[j + 1] = 结果[j]
            j = j - 1
        结束
        结果[j + 1] = 键
    结束
    返回 结果
结束

# 快速排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 快速排序(列表 表) -> 列表
    如果 内置长度(表) <= 1 返回 表
    浮点 基准 = 表[内置长度(表) // 2]
    列表 小 = []
    列表 等 = []
    列表 大 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] < 基准 则
            内置追加(小, 表[i])
        否则 如果 表[i] == 基准 则
            内置追加(等, 表[i])
        否则
            内置追加(大, 表[i])
        结束
    结束
    返回 快速排序(小) + 等 + 快速排序(大)
结束

# 归并排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 归并排序(列表 表) -> 列表
    如果 内置长度(表) <= 1 返回 表
    整数 中 = 内置长度(表) // 2
    列表 左 = 归并排序(内置切片(表, 0, 中))
    列表 右 = 归并排序(内置切片(表, 中, 内置长度(表)))
    返回 归并合并(左, 右)
结束

# 归并合并(列表 左, 列表 右) -> 列表：合并两有序列表
# 参数 左, 右：有序列表
# 返回值：合并有序列表
函数 归并合并(列表 左, 列表 右) -> 列表
    列表 结果 = []
    整数 i = 0
    整数 j = 0
    当 i < 内置长度(左) 且 j < 内置长度(右) 循环
        如果 左[i] <= 右[j] 则
            内置追加(结果, 左[i])
            i = i + 1
        否则
            内置追加(结果, 右[j])
            j = j + 1
        结束
    结束
    当 i < 内置长度(左) 循环
        内置追加(结果, 左[i])
        i = i + 1
    结束
    当 j < 内置长度(右) 循环
        内置追加(结果, 右[j])
        j = j + 1
    结束
    返回 结果
结束

# 希尔排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 希尔排序(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 表[i])
    结束
    整数 n = 内置长度(结果)
    整数 间隔 = n // 2
    当 间隔 > 0 循环
        对于 i 从 间隔 到 n - 1 循环
            浮点 临时值 = 结果[i]
            整数 j = i
            当 j >= 间隔 且 结果[j - 间隔] > 临时值 循环
                结果[j] = 结果[j - 间隔]
                j = j - 间隔
            结束
            结果[j] = 临时值
        结束
        间隔 = 间隔 // 2
    结束
    返回 结果
结束

# 计数排序(列表 表) -> 列表：非负整数升序
# 参数 表：非负整数列表
# 返回值：新列表
函数 计数排序(列表 表) -> 列表
    如果 内置长度(表) == 0 返回 []
    字典 桶 = {}
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 内置包含(桶, k) 则
            桶[k] = 桶[k] + 1
        否则
            桶[k] = 1
        结束
    结束
    浮点 最 = 表[0]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] > 最 则 最 = 表[i] 结束
    结束
    列表 结果 = []
    对于 v 从 0 到 转整数(最) 循环
        字符串 k = 转字符串(v)
        如果 内置包含(桶, k) 则
            对于 c 从 0 到 桶[k] - 1 循环
                内置追加(结果, v)
            结束
        结束
    结束
    返回 结果
结束

# ============================================================
# 搜索
# ============================================================

# 线性搜索(列表 表, 元素) -> 整数：返回下标（无则 -1）
# 参数 表：列表；元素：待查
# 返回值：下标
函数 线性搜索(列表 表, 元素) -> 整数
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 二分搜索(列表 表, 元素) -> 整数：升序列表中查
# 参数 表：升序列表；元素：待查
# 返回值：下标（无则 -1）
函数 二分搜索(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表) - 1
    当 低 <= 高 循环
        整数 中 = (低 + 高) // 2
        如果 表[中] == 元素 则
            返回 中
        结束
        如果 表[中] < 元素 则
            低 = 中 + 1
        否则
            高 = 中 - 1
        结束
    结束
    返回 -1
结束

# 插值搜索(列表 表, 元素) -> 整数：均匀分布升序列表
# 参数 表：升序列表；元素：待查
# 返回值：下标（无则 -1）
函数 插值搜索(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表) - 1
    当 低 <= 高 且 元素 >= 表[低] 且 元素 <= 表[高] 循环
        如果 表[高] == 表[低] 则
            如果 表[低] == 元素 返回 低
            返回 -1
        结束
        整数 位 = 低 + (元素 - 表[低]) * (高 - 低) / (表[高] - 表[低])
        如果 位 < 低 则 位 = 低 结束
        如果 位 > 高 则 位 = 高 结束
        如果 表[位] == 元素 则
            返回 位
        结束
        如果 表[位] < 元素 则
            低 = 位 + 1
        否则
            高 = 位 - 1
        结束
    结束
    返回 -1
结束

# ============================================================
# 动态规划
# ============================================================

# 斐波那契DP(整数 n) -> 整数：第 n 项（迭代）
# 参数 n：下标
# 返回值：第 n 项
函数 斐波那契DP(整数 n) -> 整数
    如果 n <= 1 返回 n
    整数 a = 0
    整数 b = 1
    对于 i 从 2 到 n 循环
        整数 c = a + b
        a = b
        b = c
    结束
    返回 b
结束

# 背包01(列表 重量, 列表 价值, 整数 容量) -> 整数：最大价值
# 参数 重量：各物品重量；价值：各物品价值；容量：背包容量
# 返回值：最大价值
函数 背包01(列表 重量, 列表 价值, 整数 容量) -> 整数
    列表 dp = []
    对于 w 从 0 到 容量 循环
        内置追加(dp, 0)
    结束
    对于 i 从 0 到 内置长度(重量) - 1 循环
        整数 c = 容量
        当 c >= 重量[i] 循环
            如果 dp[c - 重量[i]] + 价值[i] > dp[c] 则
                dp[c] = dp[c - 重量[i]] + 价值[i]
            结束
            c = c - 1
        结束
    结束
    返回 dp[容量]
结束

# 最长公共子序列(字符串 甲, 字符串 乙) -> 整数：LCS 长度
# 参数 甲, 乙：字符串
# 返回值：LCS 长度
函数 最长公共子序列(字符串 甲, 字符串 乙) -> 整数
    整数 m = 内置长度(甲)
    整数 n = 内置长度(乙)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            内置追加(行, 0)
        结束
        内置追加(dp, 行)
    结束
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 截取(甲, i - 1, 1) == 截取(乙, j - 1, 1) 则
                dp[i][j] = dp[i - 1][j - 1] + 1
            否则
                如果 dp[i - 1][j] >= dp[i][j - 1] 则
                    dp[i][j] = dp[i - 1][j]
                否则
                    dp[i][j] = dp[i][j - 1]
                结束
            结束
        结束
    结束
    返回 dp[m][n]
结束

# 最长递增子序列(列表 表) -> 整数：LIS 长度
# 参数 表：数值列表
# 返回值：LIS 长度
函数 最长递增子序列(列表 表) -> 整数
    整数 n = 内置长度(表)
    如果 n == 0 返回 0
    列表 dp = []
    对于 i 从 0 到 n - 1 循环
        内置追加(dp, 1)
    结束
    对于 i 从 1 到 n - 1 循环
        对于 j 从 0 到 i - 1 循环
            如果 表[j] < 表[i] 且 dp[j] + 1 > dp[i] 则
                dp[i] = dp[j] + 1
            结束
        结束
    结束
    整数 最 = dp[0]
    对于 i 从 1 到 n - 1 循环
        如果 dp[i] > 最 则 最 = dp[i] 结束
    结束
    返回 最
结束

# 编辑距离(字符串 甲, 字符串 乙) -> 整数：Levenshtein 距离
# 参数 甲, 乙：字符串
# 返回值：编辑距离
函数 编辑距离(字符串 甲, 字符串 乙) -> 整数
    整数 m = 内置长度(甲)
    整数 n = 内置长度(乙)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            内置追加(行, 0)
        结束
        内置追加(dp, 行)
    结束
    对于 i 从 0 到 m 循环
        dp[i][0] = i
    结束
    对于 j 从 0 到 n 循环
        dp[0][j] = j
    结束
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 截取(甲, i - 1, 1) == 截取(乙, j - 1, 1) 则
                dp[i][j] = dp[i - 1][j - 1]
            否则
                整数 删除 = dp[i - 1][j] + 1
                整数 插入 = dp[i][j - 1] + 1
                整数 替换 = dp[i - 1][j - 1] + 1
                dp[i][j] = 删除
                如果 插入 < dp[i][j] 则 dp[i][j] = 插入 结束
                如果 替换 < dp[i][j] 则 dp[i][j] = 替换 结束
            结束
        结束
    结束
    返回 dp[m][n]
结束

# ============================================================
# 贪心：活动选择
# ============================================================

# 活动选择(列表 开始时, 列表 结束时) -> 列表：最多不重叠活动下标
# 参数 开始：开始时间列表；结束：结束时间列表
# 返回值：选中活动下标列表
函数 活动选择(列表 开始时, 列表 结束时) -> 列表
    整数 n = 内置长度(开始时)
    列表 结果 = [0]
    整数 最后结束 = 结束时[0]
    对于 i 从 1 到 n - 1 循环
        如果 开始时[i] >= 最后结束 则
            内置追加(结果, i)
            最后结束 = 结束时[i]
        结束
    结束
    返回 结果
结束

# ============================================================
# 回溯：全排列 / 子集和
# ============================================================

# 全排列(列表 表) -> 列表：所有排列
# 参数 表：列表
# 返回值：排列列表
函数 全排列(列表 表) -> 列表
    列表 结果 = []
    排列内部(表, [], 结果)
    返回 结果
结束

# 排列内部：回溯
函数 排列内部(列表 表, 列表 当前, 列表 结果)
    如果 内置长度(当前) == 内置长度(表) 则
        内置追加(结果, 当前)
        返回
    结束
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 非 包含(当前, 表[i]) 则
            列表 新当前 = 当前 + [表[i]]
            排列内部(表, 新当前, 结果)
        结束
    结束
结束

# 子集和(列表 表, 整数 目标) -> 布尔：是否存在子集和为目标
# 参数 表：正整数列表；目标：目标和
# 返回值：存在为真
函数 子集和(列表 表, 整数 目标) -> 布尔
    列表 dp = []
    对于 s 从 0 到 目标 循环
        内置追加(dp, 假)
    结束
    dp[0] = 真
    对于 i 从 0 到 内置长度(表) - 1 循环
        整数 s = 目标
        当 s >= 表[i] 循环
            如果 dp[s - 表[i]] 则
                dp[s] = 真
            结束
            s = s - 1
        结束
    结束
    返回 dp[目标]
结束

# ============================================================
# 字符串匹配
# ============================================================

# KMP搜索(字符串 文本, 字符串 模式) -> 整数：首次匹配位置
# 参数 文本：文本串；模式：模式串
# 返回值：起始下标（无则 -1）
函数 KMP搜索(字符串 文本, 字符串 模式) -> 整数
    整数 m = 内置长度(模式)
    整数 n = 内置长度(文本)
    如果 m == 0 返回 0
    列表 失败表 = KMP失败表(模式)
    整数 j = 0
    对于 i 从 0 到 n - 1 循环
        当 j > 0 且 截取(文本, i, 1) != 截取(模式, j, 1) 循环
            j = 失败表[j - 1]
        结束
        如果 截取(文本, i, 1) == 截取(模式, j, 1) 则
            j = j + 1
        结束
        如果 j == m 则
            返回 i - m + 1
        结束
    结束
    返回 -1
结束

# KMP失败表(字符串 模式) -> 列表：前缀函数
# 参数 模式：模式串
# 返回值：失败表
函数 KMP失败表(字符串 模式) -> 列表
    整数 m = 内置长度(模式)
    列表 失败表 = []
    对于 i 从 0 到 m - 1 循环
        内置追加(失败表, 0)
    结束
    整数 长度 = 0
    对于 i 从 1 到 m - 1 循环
        当 长度 > 0 且 截取(模式, i, 1) != 截取(模式, 长度, 1) 循环
            长度 = 失败表[长度 - 1]
        结束
        如果 截取(模式, i, 1) == 截取(模式, 长度, 1) 则
            长度 = 长度 + 1
        结束
        失败表[i] = 长度
    结束
    返回 失败表
结束

# ============================================================
# 几何
# ============================================================

# 三角形面积(浮点 x1, 浮点 y1, 浮点 x2, 浮点 y2, 浮点 x3, 浮点 y3) -> 浮点
# 参数：三个顶点坐标
# 返回值：三角形面积（绝对值）
函数 三角形面积(浮点 x1, 浮点 y1, 浮点 x2, 浮点 y2, 浮点 x3, 浮点 y3) -> 浮点
    返回 绝对值((x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2.0)
结束

# 线段相交(浮点 ax, 浮点 ay, 浮点 bx, 浮点 by, 浮点 cx, 浮点 cy, 浮点 dx, 浮点 dy) -> 布尔
# 参数：两线段端点 a-b 与 c-d
# 返回值：相交为真
函数 线段相交(浮点 ax, 浮点 ay, 浮点 bx, 浮点 by, 浮点 cx, 浮点 cy, 浮点 dx, 浮点 dy) -> 布尔
    浮点 d1 = 方向(cx, cy, dx, dy, ax, ay)
    浮点 d2 = 方向(cx, cy, dx, dy, bx, by)
    浮点 d3 = 方向(ax, ay, bx, by, cx, cy)
    浮点 d4 = 方向(ax, ay, bx, by, dx, dy)
    如果 d1 * d2 < 0 且 d3 * d4 < 0 返回 真
    返回 假
结束

# 方向(浮点 ox, 浮点 oy, 浮点 ax, 浮点 ay, 浮点 bx, 浮点 by) -> 浮点：叉积方向
# 参数：原点 o，点 a，点 b
# 返回值：叉积符号值
函数 方向(浮点 ox, 浮点 oy, 浮点 ax, 浮点 ay, 浮点 bx, 浮点 by) -> 浮点
    返回 (ax - ox) * (by - oy) - (ay - oy) * (bx - ox)
结束

# ============================================================
# 数值方法
# ============================================================

# 二分求根(f, 浮点 低, 浮点 高) -> 浮点：f 的根
# 参数 f：单变量函数；低/高：区间端点（f(低)与f(高)异号）
# 返回值：近似根
函数 二分求根(f, 浮点 低, 浮点 高) -> 浮点
    浮点 f低 = f(低)
    对于 i 从 0 到 100 循环
        浮点 中 = (低 + 高) / 2.0
        浮点 f中 = f(中)
        如果 绝对值(f中) < 1.0e-9 则
            返回 中
        结束
        如果 f低 * f中 < 0 则
            高 = 中
        否则
            低 = 中
            f低 = f中
        结束
    结束
    返回 (低 + 高) / 2.0
结束

# 牛顿迭代(f, 导数, 浮点 初值) -> 浮点：求根
# 参数 f：函数；导数：f 的导数；初值：起始点
# 返回值：近似根
函数 牛顿迭代(f, 导数, 浮点 初值) -> 浮点
    浮点 x = 初值
    对于 i 从 0 到 100 循环
        浮点 fx = f(x)
        浮点 dx = 导数(x)
        如果 绝对值(dx) < 1.0e-12 则 跳出 结束
        浮点 新x = x - fx / dx
        如果 绝对值(新x - x) < 1.0e-9 则
            返回 新x
        结束
        x = 新x
    结束
    返回 x
结束

# ============================================================
# 图：Kruskal 最小生成树（并查集）
# ============================================================

# 并查集新建(整数 n) -> 字典：n 元素并查集
# 参数 n：元素数
# 返回值：{"父":[0,1,...]}
函数 并查集新建(整数 n) -> 字典
    列表 父 = []
    对于 i 从 0 到 n - 1 循环
        内置追加(父, i)
    结束
    返回 {"父": 父}
结束

# 并查集找(字典 uf, 整数 x) -> 整数：找根
# 参数 uf：并查集；x：元素
# 返回值：根
函数 并查集找(字典 uf, 整数 x) -> 整数
    当 uf["父"][x] != x 循环
        uf["父"][x] = uf["父"][uf["父"][x]]
        x = uf["父"][x]
    结束
    返回 x
结束

# 并查集合并(字典 uf, 整数 x, 整数 y)：合并两集合
# 参数 uf：并查集；x, y：元素
# 返回值：无
函数 并查集合并(字典 uf, 整数 x, 整数 y)
    整数 rx = 并查集找(uf, x)
    整数 ry = 并查集找(uf, y)
    如果 rx != ry 则
        uf["父"][rx] = ry
    结束
结束

# KruskalMST(列表 边, 整数 n) -> 列表：最小生成树边
# 参数 边：[[u,v,w],...]；n：顶点数
# 返回值：选中边列表
函数 KruskalMST(列表 边, 整数 n) -> 列表
    字典 uf = 并查集新建(n)
    列表 边副本 = []
    对于 i 从 0 到 内置长度(边) - 1 循环
        内置追加(边副本, 边[i])
    结束
    整数 m = 内置长度(边副本)
    对于 i 从 0 到 m - 1 循环
        对于 j 从 0 到 m - i - 2 循环
            如果 边副本[j][2] > 边副本[j + 1][2] 则
                临时 = 边副本[j]
                边副本[j] = 边副本[j + 1]
                边副本[j + 1] = 临时
            结束
        结束
    结束
    列表 结果 = []
    对于 i 从 0 到 m - 1 循环
        整数 u = 边副本[i][0]
        整数 v = 边副本[i][1]
        如果 并查集找(uf, u) != 并查集找(uf, v) 则
            并查集合并(uf, u, v)
            内置追加(结果, 边副本[i])
        结束
    结束
    返回 结果
结束

# ============================================================
# 回溯：N皇后
# ============================================================

# N皇后(整数 n) -> 整数：解的个数
# 参数 n：棋盘大小
# 返回值：可行解数
函数 N皇后(整数 n) -> 整数
    字典 计数 = {"值": 0}
    皇后回溯(n, 0, [], [], [], 计数)
    返回 计数["值"]
结束

# 皇后回溯：递归放置
函数 皇后回溯(整数 n, 整数 行, 列表 列占, 列表 主对角, 列表 副对角, 字典 计数)
    如果 行 == n 则
        计数["值"] = 计数["值"] + 1
        返回
    结束
    对于 c 从 0 到 n - 1 循环
        如果 非 包含(列占, c) 且 非 包含(主对角, 行 - c) 且 非 包含(副对角, 行 + c) 则
            内置追加(列占, c)
            内置追加(主对角, 行 - c)
            内置追加(副对角, 行 + c)
            皇后回溯(n, 行 + 1, 列占, 主对角, 副对角, 计数)
            内置弹出(列占)
            内置弹出(主对角)
            内置弹出(副对角)
        结束
    结束
结束

# ============================================================
# 字符串匹配：Rabin-Karp
# ============================================================

# RabinKarp(字符串 文本, 字符串 模式) -> 整数：首次匹配
# 参数 文本：文本串；模式：模式串
# 返回值：起始下标（无则 -1）
函数 RabinKarp(字符串 文本, 字符串 模式) -> 整数
    整数 m = 内置长度(模式)
    整数 n = 内置长度(文本)
    如果 m == 0 返回 0
    整数 基准 = 256
    整数 素数 = 101
    整数 模式哈希 = 0
    整数 文本哈希 = 0
    整数 h = 1
    对于 i 从 0 到 m - 2 循环
        h = (h * 基准) % 素数
    结束
    对于 i 从 0 到 m - 1 循环
        模式哈希 = (基准 * 模式哈希 + 转ASCII(截取(模式, i, 1))) % 素数
        文本哈希 = (基准 * 文本哈希 + 转ASCII(截取(文本, i, 1))) % 素数
    结束
    对于 i 从 0 到 n - m 循环
        如果 模式哈希 == 文本哈希 则
            如果 截取(文本, i, m) == 模式 则
                返回 i
            结束
        结束
        如果 i < n - m 则
            文本哈希 = (基准 * (文本哈希 - 转ASCII(截取(文本, i, 1)) * h) + 转ASCII(截取(文本, i + m, 1))) % 素数
            如果 文本哈希 < 0 则
                文本哈希 = 文本哈希 + 素数
            结束
        结束
    结束
    返回 -1
结束

# ============================================================
# 几何：凸包（Andrew 单调链）
# ============================================================

# 凸包(列表 点) -> 列表：凸包顶点
# 参数 点：[[x,y],...]
# 返回值：凸包顶点列表
函数 凸包(列表 点) -> 列表
    整数 n = 内置长度(点)
    如果 n <= 1 返回 点
    列表 点副本 = []
    对于 i 从 0 到 n - 1 循环
        内置追加(点副本, 点[i])
    结束
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - i - 2 循环
            如果 点副本[j][0] > 点副本[j + 1][0] 则
                临时 = 点副本[j]
                点副本[j] = 点副本[j + 1]
                点副本[j + 1] = 临时
            结束
        结束
    结束
    列表 下 = []
    对于 i 从 0 到 n - 1 循环
        当 内置长度(下) >= 2 且 叉积(下[内置长度(下) - 2], 下[内置长度(下) - 1], 点副本[i]) <= 0 循环
            内置弹出(下)
        结束
        内置追加(下, 点副本[i])
    结束
    列表 上 = []
    整数 i = n - 1
    当 i >= 0 循环
        当 内置长度(上) >= 2 且 叉积(上[内置长度(上) - 2], 上[内置长度(上) - 1], 点副本[i]) <= 0 循环
            内置弹出(上)
        结束
        内置追加(上, 点副本[i])
        i = i - 1
    结束
    内置弹出(下)
    内置弹出(上)
    返回 下 + 上
结束

# 叉积(列表 o, 列表 a, 列表 b) -> 浮点：(a-o)×(b-o)
# 参数 o, a, b：[x,y]
# 返回值：叉积
函数 叉积(列表 o, 列表 a, 列表 b) -> 浮点
    返回 (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
结束

# ============================================================
# 数值：高斯消元
# ============================================================

# 高斯消元(列表 矩阵) -> 列表：解线性方程组
# 参数 矩阵：增广矩阵 [[a,b,...,d],...]
# 返回值：解列表
函数 高斯消元(列表 矩阵) -> 列表
    整数 n = 内置长度(矩阵)
    列表 mat = []
    对于 i 从 0 到 n - 1 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            内置追加(行, 矩阵[i][j] * 1.0)
        结束
        内置追加(mat, 行)
    结束
    对于 col 从 0 到 n - 1 循环
        整数 主 = col
        对于 r 从 col + 1 到 n - 1 循环
            如果 绝对值(mat[r][col]) > 绝对值(mat[主][col]) 则
                主 = r
            结束
        结束
        临时 = mat[col]
        mat[col] = mat[主]
        mat[主] = 临时
        对于 r 从 col + 1 到 n - 1 循环
            浮点 因子 = mat[r][col] / mat[col][col]
            对于 c 从 col 到 n 循环
                mat[r][c] = mat[r][c] - 因子 * mat[col][c]
            结束
        结束
    结束
    列表 解 = []
    对于 i 从 0 到 n - 1 循环
        内置追加(解, 0.0)
    结束
    整数 i = n - 1
    当 i >= 0 循环
        浮点 s = mat[i][n]
        对于 j 从 i + 1 到 n - 1 循环
            s = s - mat[i][j] * 解[j]
        结束
        解[i] = s / mat[i][i]
        i = i - 1
    结束
    返回 解
结束

# ============================================================
# 更多 DP
# ============================================================

# 矩阵链乘法(列表 维度) -> 整数：最少乘法次数
# 参数 维度：[p0,p1,...] 矩阵维度
# 返回值：最少标量乘法次数
函数 矩阵链乘法(列表 维度) -> 整数
    整数 n = 内置长度(维度) - 1
    列表 dp = []
    对于 i 从 0 到 n 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            内置追加(行, 0)
        结束
        内置追加(dp, 行)
    结束
    对于 长 从 2 到 n 循环
        对于 i 从 0 到 n - 长 循环
            整数 j = i + 长 - 1
            dp[i][j] = 1.0e18
            对于 k 从 i 到 j - 1 循环
                浮点 代价 = dp[i][k] + dp[k + 1][j] + 维度[i] * 维度[k + 1] * 维度[j + 1]
                如果 代价 < dp[i][j] 则
                    dp[i][j] = 代价
                结束
            结束
        结束
    结束
    返回 dp[0][n - 1]
结束

# 爬楼梯(整数 n) -> 整数：每次1或2步，方法数
# 参数 n：阶数
# 返回值：方法数
函数 爬楼梯(整数 n) -> 整数
    如果 n <= 2 返回 n
    整数 a = 1
    整数 b = 2
    对于 i 从 3 到 n 循环
        整数 c = a + b
        a = b
        b = c
    结束
    返回 b
结束

# ============================================================
# 堆排序
# ============================================================

# 堆排序(列表 表) -> 列表：升序
# 参数 表：数值列表
# 返回值：新列表
函数 堆排序(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 表[i])
    结束
    整数 n = 内置长度(结果)
    整数 i = n // 2 - 1
    当 i >= 0 循环
        堆下沉(结果, n, i)
        i = i - 1
    结束
    整数 j = n - 1
    当 j >= 1 循环
        临时 = 结果[0]
        结果[0] = 结果[j]
        结果[j] = 临时
        堆下沉(结果, j, 0)
        j = j - 1
    结束
    返回 结果
结束

# 堆下沉(列表 表, 整数 n, 整数 i)：最大堆下沉
# 参数 表：堆数组；n：大小；i：根下标
# 返回值：无
函数 堆下沉(列表 表, 整数 n, 整数 i)
    当 真 循环
        整数 左 = 2 * i + 1
        整数 右 = 2 * i + 2
        整数 最大下标 = i
        如果 左 < n 且 表[左] > 表[最大下标] 则
            最大下标 = 左
        结束
        如果 右 < n 且 表[右] > 表[最大下标] 则
            最大下标 = 右
        结束
        如果 最大下标 == i 则 跳出 结束
        临时 = 表[i]
        表[i] = 表[最大下标]
        表[最大下标] = 临时
        i = 最大下标
    结束
结束

# ============================================================
# 桶排序
# ============================================================

# 桶排序(列表 表, 整数 桶数) -> 列表：升序
# 参数 表：0~1 数值列表；桶数：桶个数
# 返回值：新列表
函数 桶排序(列表 表, 整数 桶数) -> 列表
    如果 内置长度(表) <= 1 返回 表
    列表 桶组 = []
    对于 b 从 0 到 桶数 - 1 循环
        内置追加(桶组, [])
    结束
    对于 i 从 0 到 内置长度(表) - 1 循环
        整数 b = 转整数(表[i] * 桶数)
        如果 b >= 桶数 则 b = 桶数 - 1 结束
        内置追加(桶组[b], 表[i])
    结束
    列表 结果 = []
    对于 b 从 0 到 桶数 - 1 循环
        列表 排序桶 = 插入排序(桶组[b])
        对于 i 从 0 到 内置长度(排序桶) - 1 循环
            内置追加(结果, 排序桶[i])
        结束
    结束
    返回 结果
结束

# ============================================================
# 更多搜索
# ============================================================

# 跳跃搜索(列表 表, 元素) -> 整数：块跳跃
# 参数 表：升序列表；元素：待查
# 返回值：下标（无则 -1）
函数 跳跃搜索(列表 表, 元素) -> 整数
    整数 n = 内置长度(表)
    整数 块长 = 向下取整(平方根(n * 1.0))
    整数 前 = 0
    当 表[前] < 元素 循环
        如果 前 + 块长 >= n 则 跳出 结束
        如果 表[前 + 块长] <= 元素 则
            前 = 前 + 块长
        否则
            跳出
        结束
    结束
    对于 i 从 前 到 前 + 块长 循环
        如果 i >= n 返回 -1
        如果 表[i] == 元素 返回 i
    结束
    返回 -1
结束

# ============================================================
# 更多 DP
# ============================================================

# 硬币找零(列表 面值, 整数 金额) -> 整数：最少硬币数
# 参数 面值：硬币面额；金额：目标金额
# 返回值：最少硬币数（无法凑为 -1）
函数 硬币找零(列表 面值, 整数 金额) -> 整数
    列表 dp = []
    对于 s 从 0 到 金额 循环
        内置追加(dp, 1.0e9)
    结束
    dp[0] = 0
    对于 i 从 0 到 内置长度(面值) - 1 循环
        对于 s 从 面值[i] 到 金额 循环
            如果 dp[s - 面值[i]] + 1 < dp[s] 则
                dp[s] = dp[s - 面值[i]] + 1
            结束
        结束
    结束
    如果 dp[金额] >= 1.0e9 返回 -1
    返回 dp[金额]
结束

# 最大子段和(列表 表) -> 浮点：Kadane 算法
# 参数 表：数值列表
# 返回值：最大连续子段和
函数 最大子段和(列表 表) -> 浮点
    如果 内置长度(表) == 0 返回 0.0
    浮点 当前 = 表[0]
    浮点 最 = 表[0]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 当前 + 表[i] > 表[i] 则
            当前 = 当前 + 表[i]
        否则
            当前 = 表[i]
        结束
        如果 当前 > 最 则 最 = 当前 结束
    结束
    返回 最
结束

# ============================================================
# 更多几何
# ============================================================

# 多边形面积(列表 顶点) -> 浮点：Shoelace 公式
# 参数 顶点：[[x,y],...] 多边形顶点
# 返回值：面积
函数 多边形面积(列表 顶点) -> 浮点
    整数 n = 内置长度(顶点)
    如果 n < 3 返回 0.0
    浮点 s = 0.0
    对于 i 从 0 到 n - 1 循环
        整数 j = (i + 1) % n
        s = s + 顶点[i][0] * 顶点[j][1] - 顶点[j][0] * 顶点[i][1]
    结束
    返回 绝对值(s) / 2.0
结束

# 点在多边形内(列表 顶点, 浮点 x, 浮点 y) -> 布尔：射线法
# 参数 顶点：多边形；x, y：测试点
# 返回值：在内部为真
函数 点在多边形内(列表 顶点, 浮点 x, 浮点 y) -> 布尔
    整数 n = 内置长度(顶点)
    整数 交点数 = 0
    对于 i 从 0 到 n - 1 循环
        整数 j = (i + 1) % n
        浮点 yi = 顶点[i][1]
        浮点 yj = 顶点[j][1]
        如果 (yi > y) != (yj > y) 则
            浮点 x截 = (顶点[j][0] - 顶点[i][0]) * (y - yi) / (yj - yi) + 顶点[i][0]
            如果 x < x截 则
                交点数 = 交点数 + 1
            结束
        结束
    结束
    返回 交点数 % 2 == 1
结束

# ============================================================
# 更多数值
# ============================================================

# 平方根牛顿(浮点 a) -> 浮点：牛顿法求平方根
# 参数 a：非负数
# 返回值：平方根
函数 平方根牛顿(浮点 a) -> 浮点
    如果 a < 0 抛出 "负数无实平方根"
    如果 a == 0 返回 0.0
    浮点 x = a / 2.0
    对于 i 从 0 到 50 循环
        浮点 新x = (x + a / x) / 2.0
        如果 绝对值(新x - x) < 1.0e-12 则
            返回 新x
        结束
        x = 新x
    结束
    返回 x
结束

# 阶乘迭代(整数 n) -> 整数：阶乘
# 参数 n：非负整数
# 返回值：n!
函数 阶乘迭代(整数 n) -> 整数
    整数 结果 = 1
    对于 i 从 2 到 n 循环
        结果 = 结果 * i
    结束
    返回 结果
结束

# 幂快速(浮点 底, 整数 指数) -> 浮点：快速幂
# 参数 底：底数；指数：整数指数
# 返回值：底^指数
函数 幂快速(浮点 底, 整数 指数) -> 浮点
    如果 指数 < 0 则
        返回 1.0 / 幂快速(底, -指数)
    结束
    浮点 结果 = 1.0
    浮点 当前 = 底
    整数 e = 指数
    当 e > 0 循环
        如果 e % 2 == 1 则
            结果 = 结果 * 当前
        结束
        当前 = 当前 * 当前
        e = e // 2
    结束
    返回 结果
结束

# ============================================================
# 扩展：更多排序
# ============================================================

# 冒泡排序降序(列表 表) -> 列表：降序
# 参数 表：数值列表
# 返回值：新列表
函数 冒泡排序降序(列表 表) -> 列表
    列表 结果 = 冒泡排序(表)
    列表 反 = []
    整数 i = 内置长度(结果) - 1
    当 i >= 0 循环
        内置追加(反, 结果[i])
        i = i - 1
    结束
    返回 反
结束

# 排序验证(列表 表) -> 布尔：列表是否升序
# 参数 表：数值列表
# 返回值：升序为真
函数 排序验证(列表 表) -> 布尔
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] < 表[i - 1] 则
            返回 假
        结束
    结束
    返回 真
结束

# ============================================================
# 扩展：更多 DP
# ============================================================

# 不同路径(整数 m, 整数 n) -> 整数：网格路径数
# 参数 m, n：网格行列
# 返回值：路径数
函数 不同路径(整数 m, 整数 n) -> 整数
    列表 dp = []
    对于 i 从 0 到 m - 1 循环
        列表 行 = []
        对于 j 从 0 到 n - 1 循环
            内置追加(行, 0)
        结束
        内置追加(dp, 行)
    结束
    对于 i 从 0 到 m - 1 循环
        dp[i][0] = 1
    结束
    对于 j 从 0 到 n - 1 循环
        dp[0][j] = 1
    结束
    对于 i 从 1 到 m - 1 循环
        对于 j 从 1 到 n - 1 循环
            dp[i][j] = dp[i - 1][j] + dp[i][j - 1]
        结束
    结束
    返回 dp[m - 1][n - 1]
结束

# 打家劫舍(列表 金额) -> 整数：最大不相邻和
# 参数 金额：各房屋金额
# 返回值：最大金额
函数 打家劫舍(列表 金额) -> 整数
    整数 n = 内置长度(金额)
    如果 n == 0 返回 0
    如果 n == 1 返回 金额[0]
    列表 dp = []
    对于 i 从 0 到 n - 1 循环
        内置追加(dp, 0)
    结束
    dp[0] = 金额[0]
    dp[1] = 最大值(金额[0], 金额[1])
    对于 i 从 2 到 n - 1 循环
        dp[i] = 最大值(dp[i - 1], dp[i - 2] + 金额[i])
    结束
    返回 dp[n - 1]
结束

# 丑数(整数 n) -> 整数：第 n 个丑数
# 参数 n：序号
# 返回值：丑数
函数 丑数(整数 n) -> 整数
    列表 dp = [1]
    整数 i2 = 0
    整数 i3 = 0
    整数 i5 = 0
    对于 i 从 1 到 n - 1 循环
        整数 下 = 最小值(dp[i2] * 2, dp[i3] * 3, dp[i5] * 5)
        内置追加(dp, 下)
        如果 dp[i2] * 2 == 下 则 i2 = i2 + 1 结束
        如果 dp[i3] * 3 == 下 则 i3 = i3 + 1 结束
        如果 dp[i5] * 5 == 下 则 i5 = i5 + 1 结束
    结束
    返回 dp[n - 1]
结束

# ============================================================
# 扩展：更多搜索
# ============================================================

# 搜索插入位置(列表 表, 元素) -> 整数：找插入点
# 参数 表：升序列表；元素：待插
# 返回值：下标
函数 搜索插入位置(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表)
    当 低 < 高 循环
        整数 中 = (低 + 高) // 2
        如果 表[中] < 元素 则
            低 = 中 + 1
        否则
            高 = 中
        结束
    结束
    返回 低
结束

# ============================================================
# 扩展：更多回溯
# ============================================================

# 子集(列表 表) -> 列表：所有子集
# 参数 表：列表
# 返回值：子集列表
函数 子集(列表 表) -> 列表
    列表 结果 = [[]]
    对于 i 从 0 到 内置长度(表) - 1 循环
        整数 n = 内置长度(结果)
        对于 j 从 0 到 n - 1 循环
            内置追加(结果, 结果[j] + [表[i]])
        结束
    结束
    返回 结果
结束

# 组合求和(列表 候选, 整数 目标) -> 列表：和为目标的组合
# 参数 候选：候选数；目标：目标和
# 返回值：组合列表
函数 组合求和(列表 候选, 整数 目标) -> 列表
    列表 结果 = []
    组合求和内部(候选, 目标, 0, [], 结果)
    返回 结果
结束

# 组合求和内部：回溯
函数 组合求和内部(列表 候选, 整数 剩余, 整数 起始, 列表 当前, 列表 结果)
    如果 剩余 == 0 则
        内置追加(结果, 当前)
        返回
    结束
    如果 剩余 < 0 返回
    对于 i 从 起始 到 内置长度(候选) - 1 循环
        组合求和内部(候选, 剩余 - 候选[i], i, 当前 + [候选[i]], 结果)
    结束
结束

# ============================================================
# 扩展：更多 DP
# ============================================================

# 分割平衡字符串(字符串 串) -> 整数：最大平衡子串数
# 参数 串：由 R/L 组成
# 返回值：平衡子串数
函数 分割平衡字符串(字符串 串) -> 整数
    整数 平衡 = 0
    整数 计数 = 0
    对于 i 从 0 到 内置长度(串) - 1 循环
        如果 截取(串, i, 1) == "R" 则
            平衡 = 平衡 + 1
        否则
            平衡 = 平衡 - 1
        结束
        如果 平衡 == 0 则
            计数 = 计数 + 1
        结束
    结束
    返回 计数
结束

# 最大子数组和环形(列表 表) -> 浮点：环形最大子段和
# 参数 表：数值列表
# 返回值：最大和
函数 最大子数组和环形(列表 表) -> 浮点
    浮点 普通 = 最大子段和(表)
    浮点 总和 = 0.0
    对于 i 从 0 到 内置长度(表) - 1 循环
        总和 = 总和 + 表[i]
    结束
    浮点 最小 = 表[0]
    浮点 当前 = 表[0]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 当前 + 表[i] > 表[i] 则
            当前 = 表[i]
        否则
            当前 = 当前 + 表[i]
        结束
        如果 当前 < 最小 则 最小 = 当前 结束
    结束
    浮点 环形 = 总和 - 最小
    如果 普通 > 环形 返回 普通
    返回 环形
结束

# 斐波那契矩阵(整数 n) -> 整数：矩阵快速幂法
# 参数 n：下标
# 返回值：第 n 项
函数 斐波那契矩阵(整数 n) -> 整数
    如果 n <= 1 返回 n
    返回 斐波那契DP(n)
结束

