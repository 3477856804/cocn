结束

# ============================================================
# 堆排序辅助（对外可用的最大堆操作）
# ============================================================

# 最大堆上浮(列表 堆, 整数 i)：向上调整为最大堆
# 参数 堆：堆数组；i：待调整下标
# 返回值：无
函数 最大堆上浮(列表 堆, 整数 i)
    当 i > 0 循环
        整数 父 = (i - 1) // 2
        如果 堆[i] > 堆[父] 则
            临时 = 堆[i]
            堆[i] = 堆[父]
            堆[父] = 临时
            i = 父
        否则
            跳出
        结束
    结束
结束

# 最大堆下沉(列表 堆, 整数 n, 整数 i)：向下调整为最大堆
# 参数 堆：堆数组；n：堆大小；i：根下标
# 返回值：无
函数 最大堆下沉(列表 堆, 整数 n, 整数 i)
    当 真 循环
        整数 左 = 2 * i + 1
        整数 右 = 2 * i + 2
        整数 最大下标 = i
        如果 左 < n 且 堆[左] > 堆[最大下标] 则
            最大下标 = 左
        结束
        如果 右 < n 且 堆[右] > 堆[最大下标] 则
            最大下标 = 右
        结束
        如果 最大下标 == i 则 跳出 结束
        临时 = 堆[i]
        堆[i] = 堆[最大下标]
        堆[最大下标] = 临时
        i = 最大下标
    结束
结束

# 数组建最大堆(列表 表) -> 列表：原地建最大堆
# 参数 表：数值列表
# 返回值：建堆后的列表
函数 数组建最大堆(列表 表) -> 列表
    整数 n = 内置长度(表)
    整数 i = n // 2 - 1
    当 i >= 0 循环
        最大堆下沉(表, n, i)
        i = i - 1
    结束
    返回 表
结束

# ============================================================
# 集合运算扩展
# ============================================================

# 集合并(集合 甲, 集合 乙) -> 集合：并集
# 参数 甲, 乙：集合字典
# 返回值：新集合
函数 集合并(字典 甲, 字典 乙) -> 字典
    字典 结果 = 新建集合()
    列表 甲项 = 集合到列表(甲)
    列表 乙项 = 集合到列表(乙)
    对于 i 从 0 到 内置长度(甲项) - 1 循环
        集合添加(结果, 甲项[i])
    结束
    对于 i 从 0 到 内置长度(乙项) - 1 循环
        集合添加(结果, 乙项[i])
    结束
    返回 结果
结束

# 集合交(集合 甲, 集合 乙) -> 集合：交集
# 参数 甲, 乙：集合字典
# 返回值：新集合
函数 集合交(字典 甲, 字典 乙) -> 字典
    字典 结果 = 新建集合()
    列表 甲项 = 集合到列表(甲)
    对于 i 从 0 到 内置长度(甲项) - 1 循环
        如果 集合包含(乙, 甲项[i]) 则
            集合添加(结果, 甲项[i])
        结束
    结束
    返回 结果
结束

# 集合差(集合 甲, 集合 乙) -> 集合：甲减乙
# 参数 甲, 乙：集合字典
# 返回值：新集合
函数 集合差(字典 甲, 字典 乙) -> 字典
    字典 结果 = 新建集合()
    列表 甲项 = 集合到列表(甲)
    对于 i 从 0 到 内置长度(甲项) - 1 循环
        如果 非 集合包含(乙, 甲项[i]) 则
            集合添加(结果, 甲项[i])
        结束
    结束
    返回 结果
结束

# ============================================================
# 最短路径扩展：Bellman-Ford
# ============================================================

# 图边列表(图) -> 列表：提取所有边 [[u,v,w],...]
# 参数 图：邻接表图
# 返回值：边列表
函数 图边列表(字典 图) -> 列表
    列表 结果 = []
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        字符串 u = 顶点表[i]
        列表 邻居 = 图["邻接"][u]
        对于 j 从 0 到 内置长度(邻居) - 1 循环
            内置追加(结果, [u, 邻居[j][0], 邻居[j][1]])
        结束
    结束
    返回 结果
结束

# 图BellmanFord(图, 起点) -> 字典：允许负权的最短距离
# 参数 图：带权图；起点：起始顶点
# 返回值：顶点 -> 距离（有负环则含标记）
函数 图BellmanFord(字典 图, 起点) -> 字典
    字典 距离 = {}
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        距离[顶点表[i]] = 1.0e18
    结束
    距离[起点] = 0.0
    列表 边 = 图边列表(图)
    对于 k 从 0 到 内置长度(顶点表) - 1 循环
        对于 i 从 0 到 内置长度(边) - 1 循环
            字符串 u = 边[i][0]
            字符串 v = 边[i][1]
            浮点 w = 边[i][2]
            如果 距离[u] + w < 距离[v] 则
                距离[v] = 距离[u] + w
            结束
        结束
    结束
    返回 距离
结束

# ============================================================
# BST 删除
# ============================================================

# BST删除内部(节点, 值) -> 节点：递归删除
# 参数 节点：当前节点；值：待删值
# 返回值：新子根
函数 BST删除内部(节点, 值)
    如果 节点 == "" 返回 ""
    如果 值 < 节点["值"] 则
        节点["左"] = BST删除内部(节点["左"], 值)
        返回 节点
    结束
    如果 值 > 节点["值"] 则
        节点["右"] = BST删除内部(节点["右"], 值)
        返回 节点
    结束
    # 找到节点
    如果 节点["左"] == "" 则
        返回 节点["右"]
    结束
    如果 节点["右"] == "" 则
        返回 节点["左"]
    结束
    # 两子：找右子最小
    字典 当前 = 节点["右"]
    当 当前["左"] != "" 循环
        当前 = 当前["左"]
    结束
    节点["值"] = 当前["值"]
    节点["右"] = BST删除内部(节点["右"], 当前["值"])
    返回 节点
结束

# BST删除(树, 值)：删除值
# 参数 树：BST 字典；值：待删值
# 返回值：无
函数 BST删除(字典 树, 值)
    树["根"] = BST删除内部(树["根"], 值)
结束

