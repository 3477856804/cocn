函数 集合大小(字典 集合) -> 整数
    返回 内置长度(集合["集合"])
结束

# 集合到列表(集合) -> 列表：转列表
# 参数 集合：集合字典
# 返回值：元素列表
函数 集合到列表(字典 集合) -> 列表
    返回 内置值(集合["集合"])
结束

# ============================================================
# Trie 树（节点：{"子":{字符:节点}, "结束":布尔}）
# ============================================================

# 新建Trie() -> 字典：返回空 Trie
# 参数：无
# 返回值：根节点字典
函数 新建Trie() -> 字典
    返回 {"子": {}, "结束": 假}
结束

# Trie插入(根, 词)：插入单词
# 参数 根：Trie 根；词：待插字符串
# 返回值：无
函数 Trie插入(字典 根, 字符串 词)
    字典 当前 = 根
    对于 i 从 0 到 内置长度(词) - 1 循环
        字符串 ch = 截取(词, i, 1)
        如果 非 内置包含(当前["子"], ch) 则
            当前["子"][ch] = {"子": {}, "结束": 假}
        结束
        当前 = 当前["子"][ch]
    结束
    当前["结束"] = 真
结束

# Trie查找(根, 词) -> 布尔：是否含完整词
# 参数 根：Trie 根；词：待查字符串
# 返回值：是完整词为真
函数 Trie查找(字典 根, 字符串 词) -> 布尔
    字典 当前 = 根
    对于 i 从 0 到 内置长度(词) - 1 循环
        字符串 ch = 截取(词, i, 1)
        如果 非 内置包含(当前["子"], ch) 则
            返回 假
        结束
        当前 = 当前["子"][ch]
    结束
    返回 当前["结束"]
结束

# Trie前缀匹配(根, 前缀) -> 布尔：是否存在以前缀开头的词
# 参数 根：Trie 根；前缀：前缀字符串
# 返回值：存在为真
函数 Trie前缀匹配(字典 根, 字符串 前缀) -> 布尔
    字典 当前 = 根
    对于 i 从 0 到 内置长度(前缀) - 1 循环
        字符串 ch = 截取(前缀, i, 1)
        如果 非 内置包含(当前["子"], ch) 则
            返回 假
        结束
        当前 = 当前["子"][ch]
    结束
    返回 真
结束

# ============================================================
# 布隆过滤器（位数组 + 多哈希）
# ============================================================

# 新建布隆(整数 位数) -> 字典：返回布隆过滤器
# 参数 位数：位数组大小
# 返回值：{"位":列表, "大小":位数}
函数 新建布隆(整数 位数) -> 字典
    列表 位 = []
    对于 i 从 0 到 位数 - 1 循环
        内置追加(位, 0)
    结束
    返回 {"位": 位, "大小": 位数}
结束

# 布隆哈希1(字符串 词, 整数 大小) -> 整数：哈希1
# 参数 词：字符串；大小：位数
# 返回值：位下标
函数 布隆哈希1(字符串 词, 整数 大小) -> 整数
    整数 h = 0
    对于 i 从 0 到 内置长度(词) - 1 循环
        h = (h * 31 + 转ASCII(截取(词, i, 1))) % 大小
    结束
    返回 h
结束

# 布隆哈希2(字符串 词, 整数 大小) -> 整数：哈希2
# 参数 词：字符串；大小：位数
# 返回值：位下标
函数 布隆哈希2(字符串 词, 整数 大小) -> 整数
    整数 h = 7
    对于 i 从 0 到 内置长度(词) - 1 循环
        h = (h * 131 + 转ASCII(截取(词, i, 1))) % 大小
    结束
    返回 h
结束

# 布隆加入(布隆, 词)：加入词
# 参数 布隆：布隆过滤器；词：字符串
# 返回值：无
函数 布隆加入(字典 布隆, 字符串 词)
    整数 大小 = 布隆["大小"]
    布隆["位"][布隆哈希1(词, 大小)] = 1
    布隆["位"][布隆哈希2(词, 大小)] = 1
结束

# 布隆可能包含(布隆, 词) -> 布尔：词是否可能存在
# 参数 布隆：布隆过滤器；词：字符串
# 返回值：可能存在为真（有误报，无漏报）
函数 布隆可能包含(字典 布隆, 字符串 词) -> 布尔
    整数 大小 = 布隆["大小"]
    返回 布隆["位"][布隆哈希1(词, 大小)] == 1 且 布隆["位"][布隆哈希2(词, 大小)] == 1
结束

# ============================================================
# AVL 树（自平衡 BST，节点：{"值":v,"左":左,"右":右,"高":h}）
# ============================================================

# AVL新节点(值) -> 节点：新建 AVL 节点
# 参数 值：节点值
# 返回值：节点字典
函数 AVL新节点(值) -> 字典
    返回 {"值": 值, "左": "", "右": "", "高": 1}
结束

# AVL取高(节点) -> 整数：取节点高度（空为0）
# 参数 节点：节点或 ""
# 返回值：高度
函数 AVL取高(节点) -> 整数
    如果 节点 == "" 返回 0
    返回 节点["高"]
结束

# AVL平衡因子(节点) -> 整数：左高减右高
# 参数 节点：节点
# 返回值：平衡因子
函数 AVL平衡因子(节点) -> 整数
    如果 节点 == "" 返回 0
    返回 AVL取高(节点["左"]) - AVL取高(节点["右"])
结束

# AVL右旋转(节点) -> 节点：右旋
# 参数 节点：失衡节点
# 返回值：新子根
函数 AVL右旋转(节点) -> 字典
    字典 新根 = 节点["左"]
    节点["左"] = 新根["右"]
    新根["右"] = 节点
    节点["高"] = 最大值(AVL取高(节点["左"]), AVL取高(节点["右"])) + 1
    新根["高"] = 最大值(AVL取高(新根["左"]), AVL取高(新根["右"])) + 1
    返回 新根
结束

# AVL左旋转(节点) -> 节点：左旋
# 参数 节点：失衡节点
# 返回值：新子根
函数 AVL左旋转(节点) -> 字典
    字典 新根 = 节点["右"]
    节点["右"] = 新根["左"]
    新根["左"] = 节点
    节点["高"] = 最大值(AVL取高(节点["左"]), AVL取高(节点["右"])) + 1
    新根["高"] = 最大值(AVL取高(新根["左"]), AVL取高(新根["右"])) + 1
    返回 新根
结束

# AVL插入内部(节点, 值) -> 节点：递归插入并平衡
# 参数 节点：当前节点；值：待插值
# 返回值：新子根
函数 AVL插入内部(节点, 值)
    如果 节点 == "" 返回 AVL新节点(值)
    如果 值 < 节点["值"] 则
        节点["左"] = AVL插入内部(节点["左"], 值)
    否则
        节点["右"] = AVL插入内部(节点["右"], 值)
    结束
    节点["高"] = 最大值(AVL取高(节点["左"]), AVL取高(节点["右"])) + 1
    整数 平衡 = AVL平衡因子(节点)
    如果 平衡 > 1 且 值 < 节点["左"]["值"] 则
        返回 AVL右旋转(节点)
    结束
    如果 平衡 < -1 且 值 > 节点["右"]["值"] 则
        返回 AVL左旋转(节点)
    结束
    如果 平衡 > 1 且 值 > 节点["左"]["值"] 则
        节点["左"] = AVL左旋转(节点["左"])
        返回 AVL右旋转(节点)
    结束
    如果 平衡 < -1 且 值 < 节点["右"]["值"] 则
        节点["右"] = AVL右旋转(节点["右"])
        返回 AVL左旋转(节点)
    结束
    返回 节点
结束

# 新建AVL() -> 字典：返回空 AVL 树
# 参数：无
# 返回值：{"根":""}
函数 新建AVL() -> 字典
    返回 {"根": ""}
结束

# AVL插入(树, 值)：插入值并保持平衡
# 参数 树：AVL 字典；值：待插值
# 返回值：无
函数 AVL插入(字典 树, 值)
    树["根"] = AVL插入内部(树["根"], 值)
结束

# AVL中序(树) -> 列表：中序遍历（升序）
# 参数 树：AVL 字典
# 返回值：节点值列表
函数 AVL中序(字典 树) -> 列表
    列表 结果 = []
    AVL中序内部(树["根"], 结果)
    返回 结果
结束

# AVL中序内部：递归中序
函数 AVL中序内部(节点, 列表 结果)
    如果 节点 == "" 返回
    AVL中序内部(节点["左"], 结果)
    内置追加(结果, 节点["值"])
    AVL中序内部(节点["右"], 结果)
结束

# AVL高度(树) -> 整数：树高度
# 参数 树：AVL 字典
# 返回值：高度
函数 AVL高度(字典 树) -> 整数
    返回 AVL取高(树["根"])
结束

# ============================================================
# 图算法扩展
# ============================================================

# 图Prim(图, 起点) -> 列表：最小生成树边集
# 参数 图：带权无向图；起点：起始顶点
# 返回值：MST 边列表 [[u,v,w],...]
函数 图Prim(字典 图, 起点) -> 列表
    列表 结果 = []
    列表 顶点表 = 内置键(图["邻接"])
    字典 已选 = {}
    已选[起点] = 1
    当 内置长度(已选) < 内置长度(顶点表) 循环
        浮点 最小权 = 1.0e18
        字符串 最佳u = ""
        字符串 最佳v = ""
        对于 i 从 0 到 内置长度(顶点表) - 1 循环
            字符串 u = 顶点表[i]
            如果 内置包含(已选, u) 则
                列表 邻居 = 图["邻接"][u]
                对于 j 从 0 到 内置长度(邻居) - 1 循环
                    字符串 v = 邻居[j][0]
                    如果 非 内置包含(已选, v) 且 邻居[j][1] < 最小权 则
                        最小权 = 邻居[j][1]
                        最佳u = u
                        最佳v = v
                    结束
                结束
            结束
        结束
        如果 最佳u == "" 则 跳出 结束
        已选[最佳v] = 1
        内置追加(结果, [最佳u, 最佳v, 最小权])
    结束
    返回 结果
结束

# 图拓扑排序(图) -> 列表：Kahn 拓扑排序
# 参数 图：有向无环图
# 返回值：拓扑序顶点列表
函数 图拓扑排序(字典 图) -> 列表
    字典 入度 = {}
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        入度[顶点表[i]] = 0
    结束
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        列表 邻居 = 图["邻接"][顶点表[i]]
        对于 j 从 0 到 内置长度(邻居) - 1 循环
            入度[邻居[j][0]] = 入度[邻居[j][0]] + 1
        结束
    结束
    字典 队列 = {"项": []}
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        如果 入度[顶点表[i]] == 0 则
            内置追加(队列["项"], 顶点表[i])
        结束
    结束
    列表 结果 = []
    当 内置长度(队列["项"]) > 0 循环
        字符串 u = 队列["项"][0]
        队列["项"] = 内置切片(队列["项"], 1, 内置长度(队列["项"]))
        内置追加(结果, u)
        列表 邻居 = 图["邻接"][u]
        对于 j 从 0 到 内置长度(邻居) - 1 循环
            字符串 v = 邻居[j][0]
            入度[v] = 入度[v] - 1
            如果 入度[v] == 0 则
                内置追加(队列["项"], v)
            结束
        结束
    结束
    返回 结果
结束

# 图有环(图) -> 布尔：有向图是否有环
# 参数 图：有向图
# 返回值：有环为真
函数 图有环(字典 图) -> 布尔
    字典 状态 = {}
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        状态[顶点表[i]] = 0
    结束
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        如果 状态[顶点表[i]] == 0 则
            如果 环检测内部(图, 顶点表[i], 状态) 则
                返回 真
            结束
        结束
    结束
    返回 假
结束

# 环检测内部：DFS 三色标记
函数 环检测内部(字典 图, 顶点, 字典 状态) -> 布尔
    状态[顶点] = 1
    列表 邻居 = 图["邻接"][顶点]
    对于 i 从 0 到 内置长度(邻居) - 1 循环
        字符串 v = 邻居[i][0]
        如果 状态[v] == 1 则
            返回 真
        结束
        如果 状态[v] == 0 且 环检测内部(图, v, 状态) 则
            返回 真
        结束
    结束
    状态[顶点] = 2
    返回 假
结束

# ============================================================
# 循环队列（定长数组）
# ============================================================

# 新建循环队列(整数 容量) -> 字典：返回空循环队列
# 参数 容量：最大容量
# 返回值：{"数组":[...], "头":0, "尾":0, "计数":0, "容量":容量}
函数 新建循环队列(整数 容量) -> 字典
    列表 数组 = []
    对于 i 从 0 到 容量 - 1 循环
        内置追加(数组, "")
    结束
    返回 {"数组": 数组, "头": 0, "尾": 0, "计数": 0, "容量": 容量}
结束

# 循环入队(队列, 元素)：入队
# 参数 队列：循环队列；元素：待入元素
# 返回值：是否成功
函数 循环入队(字典 队列, 元素) -> 布尔
    如果 队列["计数"] == 队列["容量"] 则
        返回 假
    结束
    队列["数组"][队列["尾"]] = 元素
    队列["尾"] = (队列["尾"] + 1) % 队列["容量"]
    队列["计数"] = 队列["计数"] + 1
    返回 真
结束

# 循环出队(队列)：出队
# 参数 队列：非空循环队列
# 返回值：队首元素
函数 循环出队(字典 队列)
    如果 队列["计数"] == 0 抛出 "循环队列为空"
    字典 首 = 队列["数组"][队列["头"]]
    队列["头"] = (队列["头"] + 1) % 队列["容量"]
    队列["计数"] = 队列["计数"] - 1
    返回 首
结束

# ============================================================
# 哈希表（链地址法）
# ============================================================

# 哈希表哈希(字符串 键, 整数 桶数) -> 整数：简单字符串哈希
# 参数 键：字符串键；桶数：桶个数
# 返回值：桶下标
函数 哈希表哈希(字符串 键, 整数 桶数) -> 整数
    整数 h = 0
    对于 i 从 0 到 内置长度(键) - 1 循环
        h = (h * 33 + 转ASCII(截取(键, i, 1))) % 1000000007
    结束
    返回 h % 桶数
结束

# 新建哈希表(整数 桶数) -> 字典：返回空哈希表
# 参数 桶数：桶个数
# 返回值：{"桶":[[],...], "大小":0}
函数 新建哈希表(整数 桶数) -> 字典
    列表 桶 = []
    对于 i 从 0 到 桶数 - 1 循环
        内置追加(桶, [])
    结束
    返回 {"桶": 桶, "大小": 0, "桶数": 桶数}
结束

# 哈希插入(哈希表, 键, 值)：插入/更新键值
# 参数 哈希表：哈希表字典；键：字符串键；值：任意值
# 返回值：无
函数 哈希插入(字典 哈希表, 字符串 键, 值)
    整数 idx = 哈希表哈希(键, 哈希表["桶数"])
    列表 桶 = 哈希表["桶"][idx]
    对于 i 从 0 到 内置长度(桶) - 1 循环
        如果 桶[i][0] == 键 则
            桶[i][1] = 值
            返回
        结束
    结束
    内置追加(桶, [键, 值])
    哈希表["大小"] = 哈希表["大小"] + 1
结束

# 哈希查找(哈希表, 键, 默认值) -> 值：查找键
# 参数 哈希表：哈希表字典；键：字符串键；默认值：缺省值
# 返回值：找到的值或默认值
函数 哈希查找(字典 哈希表, 字符串 键, 默认值)
    整数 idx = 哈希表哈希(键, 哈希表["桶数"])
    列表 桶 = 哈希表["桶"][idx]
    对于 i 从 0 到 内置长度(桶) - 1 循环
        如果 桶[i][0] == 键 则
            返回 桶[i][1]
        结束
    结束
    返回 默认值
结束

# 哈希删除(哈希表, 键) -> 布尔：删除键
# 参数 哈希表：哈希表字典；键：字符串键
# 返回值：是否删除成功
函数 哈希删除(字典 哈希表, 字符串 键) -> 布尔
    整数 idx = 哈希表哈希(键, 哈希表["桶数"])
    列表 桶 = 哈希表["桶"][idx]
    对于 i 从 0 到 内置长度(桶) - 1 循环
        如果 桶[i][0] == 键 则
            桶[i] = ""
            哈希表["大小"] = 哈希表["大小"] - 1
            返回 真
        结束
    结束
    返回 假
结束

# ============================================================
# 层序遍历与树工具
# ============================================================

# BST层序(树) -> 列表：广度优先层序遍历
# 参数 树：BST 字典
# 返回值：按层节点值列表
函数 BST层序(字典 树) -> 列表
    列表 结果 = []
    如果 树["根"] == "" 返回 结果
    字典 队列 = {"项": [树["根"]]}
    当 内置长度(队列["项"]) > 0 循环
        字典 当前 = 队列["项"][0]
        队列["项"] = 内置切片(队列["项"], 1, 内置长度(队列["项"]))
        内置追加(结果, 当前["值"])
        如果 当前["左"] != "" 则
            内置追加(队列["项"], 当前["左"])
        结束
        如果 当前["右"] != "" 则
            内置追加(队列["项"], 当前["右"])
        结束
    结束
    返回 结果
结束

# BST节点数(树) -> 整数：节点总数
# 参数 树：BST 字典
# 返回值：节点数
函数 BST节点数(字典 树) -> 整数
    列表 中 = BST中序(树)
    返回 内置长度(中)
结束

# BST最小值(树) -> 值：最小键
# 参数 树：非空 BST
# 返回值：最小键
函数 BST最小值(字典 树)
    字典 当前 = 树["根"]
    当 当前["左"] != "" 循环
        当前 = 当前["左"]
    结束
    返回 当前["值"]
结束

# BST最大值(树) -> 值：最大键
# 参数 树：非空 BST
# 返回值：最大键
函数 BST最大值(字典 树)
    字典 当前 = 树["根"]
    当 当前["右"] != "" 循环
        当前 = 当前["右"]
    结束
    返回 当前["值"]
结束

