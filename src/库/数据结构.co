# 返回值：尾端元素
函数 双端队列尾(字典 双端队列)
    返回 双端队列["项"][内置长度(双端队列["项"]) - 1]
结束

# ============================================================
# 图连通性
# ============================================================

# 图连通(图) -> 布尔：无向图是否连通
# 参数 图：无向邻接表图
# 返回值：连通为真
函数 图连通(字典 图) -> 布尔
    列表 顶点表 = 内置键(图["邻接"])
    如果 内置长度(顶点表) == 0 返回 真
    列表 访问 = 图BFS(图, 顶点表[0])
    返回 内置长度(访问) == 内置长度(顶点表)
结束

# 图连通分量数(图) -> 整数：连通分量个数
# 参数 图：无向图
# 返回值：分量数
函数 图连通分量数(字典 图) -> 整数
    字典 访问过 = {}
    整数 计数 = 0
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        如果 非 内置包含(访问过, 顶点表[i]) 则
            列表 一批 = 图BFS(图, 顶点表[i])
            对于 j 从 0 到 内置长度(一批) - 1 循环
                访问过[一批[j]] = 1
            结束
            计数 = 计数 + 1
        结束
    结束
    返回 计数
结束

# ============================================================
# LRU 缓存（字典 + 双端列表模拟访问顺序）
# ============================================================

# 列表索引(列表 表, 元素) -> 整数：找元素下标（无则 -1）
# 参数 表：列表；元素：待查元素
# 返回值：下标
函数 列表索引(列表 表, 元素) -> 整数
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 新建LRU(整数 容量) -> 字典：返回 LRU 缓存
# 参数 容量：缓存大小
# 返回值：{"数据":{}, "顺序":[], "容量":容量}
函数 新建LRU(整数 容量) -> 字典
    返回 {"数据": {}, "顺序": [], "容量": 容量}
结束

# LRU取(缓存, 键) -> 值：访问键（移到最近）
# 参数 缓存：LRU 字典；键：字符串键
# 返回值：对应值或 ""
函数 LRU取(字典 缓存, 字符串 键)
    如果 非 内置包含(缓存["数据"], 键) 返回 ""
    整数 idx = 列表索引(缓存["顺序"], 键)
    缓存["顺序"] = 内置切片(缓存["顺序"], 0, idx) + 内置切片(缓存["顺序"], idx + 1, 内置长度(缓存["顺序"]))
    内置追加(缓存["顺序"], 键)
    返回 缓存["数据"][键]
结束

# LRU放(缓存, 键, 值)：写入键值（超容量淘汰最久）
# 参数 缓存：LRU 字典；键：字符串键；值：任意值
# 返回值：无
函数 LRU放(字典 缓存, 字符串 键, 值)
    如果 内置包含(缓存["数据"], 键) 则
        整数 idx = 列表索引(缓存["顺序"], 键)
        缓存["顺序"] = 内置切片(缓存["顺序"], 0, idx) + 内置切片(缓存["顺序"], idx + 1, 内置长度(缓存["顺序"]))
    结束
    缓存["数据"][键] = 值
    内置追加(缓存["顺序"], 键)
    如果 内置长度(缓存["顺序"]) > 缓存["容量"] 则
        字符串 最久 = 缓存["顺序"][0]
        缓存["顺序"] = 内置切片(缓存["顺序"], 1, 内置长度(缓存["顺序"]))
        内置删除键(缓存["数据"], 最久)
    结束
结束

# ============================================================
# 图最短路径：Floyd-Warshall（邻接矩阵）
# ============================================================

# 矩阵Floyd(图) -> 列表：全点对最短路径
# 参数 图：邻接矩阵图
# 返回值：距离矩阵（列表的列表）
函数 矩阵Floyd(字典 图) -> 列表
    整数 n = 图["n"]
    列表 距离 = []
    对于 i 从 0 到 n - 1 循环
        列表 行 = []
        对于 j 从 0 到 n - 1 循环
            如果 i == j 则
                内置追加(行, 0.0)
            否则 如果 图["矩阵"][i][j] != 0 则
                内置追加(行, 图["矩阵"][i][j] * 1.0)
            否则
                内置追加(行, 1.0e18)
            结束
        结束
        内置追加(距离, 行)
    结束
    对于 k 从 0 到 n - 1 循环
        对于 i 从 0 到 n - 1 循环
            对于 j 从 0 到 n - 1 循环
                如果 距离[i][k] + 距离[k][j] < 距离[i][j] 则
                    距离[i][j] = 距离[i][k] + 距离[k][j]
                结束
            结束
        结束
    结束
    返回 距离
结束

# ============================================================
# 树工具：叶子数 / 路径和
# ============================================================

# BST叶子数(树) -> 整数：叶子节点数
# 参数 树：BST 字典
# 返回值：叶子数
函数 BST叶子数(字典 树) -> 整数
    返回 叶子数内部(树["根"])
结束

# 叶子数内部：递归
函数 叶子数内部(节点) -> 整数
    如果 节点 == "" 返回 0
    如果 节点["左"] == "" 且 节点["右"] == "" 返回 1
    返回 叶子数内部(节点["左"]) + 叶子数内部(节点["右"])
结束

# BST路径和(树, 目标) -> 布尔：是否存在根到叶路径和等于目标
# 参数 树：BST 字典；目标：目标和
# 返回值：存在为真
函数 BST路径和(字典 树, 目标) -> 布尔
    返回 路径和内部(树["根"], 目标)
结束

# 路径和内部：递归
函数 路径和内部(节点, 剩余) -> 布尔
    如果 节点 == "" 返回 假
    如果 节点["左"] == "" 且 节点["右"] == "" 则
        返回 剩余 == 节点["值"]
    结束
    返回 路径和内部(节点["左"], 剩余 - 节点["值"]) 或 路径和内部(节点["右"], 剩余 - 节点["值"])
结束

# ============================================================
# 单调栈辅助
# ============================================================

# 下一个更大元素(列表 表) -> 列表：每个元素之后第一个更大值
# 参数 表：数值列表
# 返回值：结果列表（无则 -1）
函数 下一个更大元素(列表 表) -> 列表
    整数 n = 内置长度(表)
    列表 结果 = []
    对于 i 从 0 到 n - 1 循环
        内置追加(结果, -1)
    结束
    字典 栈 = {"项": []}
    对于 i 从 0 到 n - 1 循环
        当 内置长度(栈["项"]) > 0 且 表[栈["项"][内置长度(栈["项"]) - 1]] < 表[i] 循环
            整数 idx = 内置弹出(栈["项"])
            结果[idx] = 表[i]
        结束
        内置追加(栈["项"], i)
    结束
    返回 结果
结束

# ============================================================
# ============================================================
# 扩展：更多树工具
# ============================================================

# BST树高(字典 树) -> 整数：同 BST高度
# 参数 树：BST 字典
# 返回值：高度
函数 BST树高(字典 树) -> 整数
    返回 BST高度(树)
结束

# BST是否平衡(字典 树) -> 布尔：BST 是否平衡
# 参数 树：BST 字典
# 返回值：平衡为真
函数 BST是否平衡(字典 树) -> 布尔
    返回 平衡检查内部(树["根"]) != -1
结束

# 平衡检查内部：返回高度，不平衡返回 -1
函数 平衡检查内部(节点) -> 整数
    如果 节点 == "" 返回 0
    整数 左 = 平衡检查内部(节点["左"])
    如果 左 == -1 返回 -1
    整数 右 = 平衡检查内部(节点["右"])
    如果 右 == -1 返回 -1
    如果 绝对值(左 - 右) > 1 返回 -1
    如果 左 > 右 返回 左 + 1
    返回 右 + 1
结束

# BST转有序列表(字典 树) -> 列表：中序转列表
# 参数 树：BST 字典
# 返回值：有序列表
函数 BST转有序列表(字典 树) -> 列表
    返回 BST中序(树)
结束

# 有序列表转BST(列表 表) -> 字典：有序列表转平衡 BST
# 参数 表：升序列表
# 返回值：BST 字典
函数 有序列表转BST(列表 表) -> 字典
    字典 树 = 新建BST()
    树["根"] = 排序数组转BST内部(表, 0, 内置长度(表) - 1)
    返回 树
结束

# 排序数组转BST内部：递归
函数 排序数组转BST内部(列表 表, 整数 低, 整数 高)
    如果 低 > 高 返回 ""
    整数 中 = (低 + 高) // 2
    字典 节点 = {"值": 表[中], "左": "", "右": ""}
    节点["左"] = 排序数组转BST内部(表, 低, 中 - 1)
    节点["右"] = 排序数组转BST内部(表, 中 + 1, 高)
    返回 节点
结束

# ============================================================
# 扩展：更多图工具
# ============================================================

# 图边数(字典 图) -> 整数：边总数
# 参数 图：邻接表图
# 返回值：边数
函数 图边数(字典 图) -> 整数
    列表 顶点表 = 内置键(图["邻接"])
    整数 总 = 0
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        总 = 总 + 内置长度(图["邻接"][顶点表[i]])
    结束
    返回 总
结束

# 图平均度(字典 图) -> 浮点：平均度
# 参数 图：无向图
# 返回值：平均度
函数 图平均度(字典 图) -> 浮点
    整数 v = 内置长度(内置键(图["邻接"]))
    如果 v == 0 返回 0.0
    返回 图边数(图) * 2.0 / v
结束

# 图最大度顶点(字典 图) -> 字典：返回度最大的顶点
# 参数 图：邻接表图
# 返回值：顶点名
函数 图最大度顶点(字典 图) -> 字典
    列表 顶点表 = 内置键(图["邻接"])
    如果 内置长度(顶点表) == 0 返回 ""
    字典 最佳 = 顶点表[0]
    整数 最大度 = 内置长度(图["邻接"][顶点表[0]])
    对于 i 从 1 到 内置长度(顶点表) - 1 循环
        整数 d = 内置长度(图["邻接"][顶点表[i]])
        如果 d > 最大度 则
            最大度 = d
            最佳 = 顶点表[i]
        结束
    结束
    返回 最佳
结束

