# ============================================================
# 库/数据结构.co —— coCN 标准库·数据结构模块
#
# 用途：链表、栈、队列、优先队列、树、图、哈希表、集合、Trie、
#       布隆过滤器等经典数据结构的纯 coCN 实现。
# 结构均以字典 + 列表模拟，仅依赖宿主内置函数。
#
# 函数清单：
#   单链表：新建单链表 / 链表追加 / 链表前插 / 链表删除 / 链表查找 / 链表遍历 / 链表反转 / 链表长度
#   双链表：新建双链表 / 双端追加 / 双端弹出 / 双链表长度
#   栈：新建栈 / 入栈 / 出栈 / 栈顶 / 栈空
#   队列：新建队列 / 入队 / 出队 / 队首 / 队列空
#   双端队列：新建双端队列 / 队首进 / 队尾进 / 队首出 / 队尾出
#   优先队列：新建优先队列 / 优先入队 / 优先出队 / 优先堆顶
#   二叉搜索树：新建BST / BST插入 / BST查找 / BST删除 / BST遍历 / BST高度
#   图：新建图 / 添加顶点 / 添加边 / 删除边 / 邻接表图遍历
#   图算法：BFS / DFS / Dijkstra / Prim / 拓扑排序 / 环检测
#   哈希表：新建哈希表 / 哈希插入 / 哈希查找 / 哈希删除
#   集合：新建集合 / 集合添加 / 集合删除 / 集合包含 / 并集 / 交集 / 差集
#   Trie：新建Trie / Trie插入 / Trie查找 / Trie前缀匹配
#   布隆过滤器：新建布隆 / 布隆加入 / 布隆可能包含
# ============================================================

让 内置长度 = 长度
让 内置追加 = 追加
让 内置弹出 = 弹出
让 内置切片 = 切片
让 内置包含 = 包含
让 内置删除键 = 删除键
让 内置键 = 键
让 内置值 = 值
让 内置查找 = 查找

# ============================================================
# 单链表（节点字典：{"值":v, "下一个":下一个节点或空}）
# ============================================================

# 新建单链表() -> 字典：返回空单链表
# 参数：无
# 返回值：{"头":空, "尾":空}
函数 新建单链表() -> 字典
    返回 {"头": "", "尾": ""}
结束

# 链表追加(链表, 值)：尾部追加节点
# 参数 链表：单链表字典；值：节点值
# 返回值：无
函数 链表追加(字典 链表, 值)
    字典 节点 = {"值": 值, "下一个": ""}
    如果 链表["尾"] == "" 则
        链表["头"] = 节点
        链表["尾"] = 节点
    否则
        链表["尾"]["下一个"] = 节点
        链表["尾"] = 节点
    结束
结束

# 链表前插(链表, 值)：头部插入节点
# 参数 链表：单链表字典；值：节点值
# 返回值：无
函数 链表前插(字典 链表, 值)
    字典 节点 = {"值": 值, "下一个": 链表["头"]}
    链表["头"] = 节点
    如果 链表["尾"] == "" 则
        链表["尾"] = 节点
    结束
结束

# 链表删除(链表, 值)：删除首个等于值的节点
# 参数 链表：单链表字典；值：待删值
# 返回值：是否删除成功
函数 链表删除(字典 链表, 值) -> 布尔
    如果 链表["头"] == "" 返回 假
    如果 链表["头"]["值"] == 值 则
        链表["头"] = 链表["头"]["下一个"]
        如果 链表["头"] == "" 则 链表["尾"] = 空 结束
        返回 真
    结束
    字典 当前 = 链表["头"]
    当 当前["下一个"] != "" 循环
        如果 当前["下一个"]["值"] == 值 则
            当前["下一个"] = 当前["下一个"]["下一个"]
            如果 当前["下一个"] == "" 则
                链表["尾"] = 当前
            结束
            返回 真
        结束
        当前 = 当前["下一个"]
    结束
    返回 假
结束

# 链表查找(链表, 值) -> 布尔：链表是否含值
# 参数 链表：单链表字典；值：待查值
# 返回值：包含为真
函数 链表查找(字典 链表, 值) -> 布尔
    字典 当前 = 链表["头"]
    当 当前 != "" 循环
        如果 当前["值"] == 值 则
            返回 真
        结束
        当前 = 当前["下一个"]
    结束
    返回 假
结束

# 链表遍历(链表) -> 列表：转成值列表
# 参数 链表：单链表字典
# 返回值：值列表
函数 链表遍历(字典 链表) -> 列表
    列表 结果 = []
    字典 当前 = 链表["头"]
    当 当前 != "" 循环
        内置追加(结果, 当前["值"])
        当前 = 当前["下一个"]
    结束
    返回 结果
结束

# 链表反转(链表)：原地反转
# 参数 链表：单链表字典
# 返回值：无
函数 链表反转(字典 链表)
    字典 前 = ""
    字典 当前 = 链表["头"]
    当 当前 != "" 循环
        字典 下一个 = 当前["下一个"]
        当前["下一个"] = 前
        前 = 当前
        当前 = 下一个
    结束
    链表["尾"] = 链表["头"]
    链表["头"] = 前
结束

# 链表长度(链表) -> 整数：链表节点数
# 参数 链表：单链表字典
# 返回值：节点数
函数 链表长度(字典 链表) -> 整数
    整数 n = 0
    字典 当前 = 链表["头"]
    当 当前 != "" 循环
        n = n + 1
        当前 = 当前["下一个"]
    结束
    返回 n
结束

# ============================================================
# 双链表（节点：{"值":v,"前":prev,"后":next}）
# ============================================================

# 新建双链表() -> 字典：返回空双链表
# 参数：无
# 返回值：{"头":空,"尾":空}
函数 新建双链表() -> 字典
    返回 {"头": "", "尾": ""}
结束

# 双链表尾增(链表, 值)：尾部插入
# 参数 链表：双链表字典；值：节点值
# 返回值：无
函数 双链表尾增(字典 链表, 值)
    字典 节点 = {"值": 值, "前": "", "后": ""}
    如果 链表["尾"] == "" 则
        链表["头"] = 节点
        链表["尾"] = 节点
    否则
        链表["尾"]["后"] = 节点
        节点["前"] = 链表["尾"]
        链表["尾"] = 节点
    结束
结束

# 双链表首增(链表, 值)：头部插入
# 参数 链表：双链表字典；值：节点值
# 返回值：无
函数 双链表首增(字典 链表, 值)
    字典 节点 = {"值": 值, "前": "", "后": ""}
    如果 链表["头"] == "" 则
        链表["头"] = 节点
        链表["尾"] = 节点
    否则
        链表["头"]["前"] = 节点
        节点["后"] = 链表["头"]
        链表["头"] = 节点
    结束
结束

# 双链表首删(链表) -> 值：删除并返回首节点值
# 参数 链表：非空双链表
# 返回值：首节点值
函数 双链表首删(字典 链表)
    如果 链表["头"] == "" 抛出 "双链表为空"
    字典 节点 = 链表["头"]
    链表["头"] = 节点["后"]
    如果 链表["头"] != "" 则
        链表["头"]["前"] = ""
    否则
        链表["尾"] = ""
    结束
    返回 节点["值"]
结束

# 双链表尾删(链表) -> 值：删除并返回尾节点值
# 参数 链表：非空双链表
# 返回值：尾节点值
函数 双链表尾删(字典 链表)
    如果 链表["尾"] == "" 抛出 "双链表为空"
    字典 节点 = 链表["尾"]
    链表["尾"] = 节点["前"]
    如果 链表["尾"] != "" 则
        链表["尾"]["后"] = ""
    否则
        链表["头"] = ""
    结束
    返回 节点["值"]
结束

# 双链表长度(链表) -> 整数：节点数
# 参数 链表：双链表字典
# 返回值：节点数
函数 双链表长度(字典 链表) -> 整数
    整数 n = 0
    字典 当前 = 链表["头"]
    当 当前 != "" 循环
        n = n + 1
        当前 = 当前["后"]
    结束
    返回 n
结束

# ============================================================
# 栈（基于列表）
# ============================================================

# 新建栈() -> 字典：返回空栈
# 参数：无
# 返回值：{"项":[]}
函数 新建栈() -> 字典
    返回 {"项": []}
结束

# 入栈(栈, 元素)：压栈
# 参数 栈：栈字典；元素：待压元素
# 返回值：无
函数 入栈(字典 栈, 元素)
    内置追加(栈["项"], 元素)
结束

# 出栈(栈)：弹栈
# 参数 栈：非空栈
# 返回值：栈顶元素
函数 出栈(字典 栈)
    如果 栈空(栈) 抛出 "栈为空"
    返回 内置弹出(栈["项"])
结束

# 栈顶(栈)：查看栈顶
# 参数 栈：非空栈
# 返回值：栈顶元素
函数 栈顶(字典 栈)
    如果 栈空(栈) 抛出 "栈为空"
    返回 栈["项"][内置长度(栈["项"]) - 1]
结束

# 栈空(栈) -> 布尔：栈是否为空
# 参数 栈：栈字典
# 返回值：空为真
函数 栈空(字典 栈) -> 布尔
    返回 内置长度(栈["项"]) == 0
结束

# ============================================================
# 队列（基于列表）
# ============================================================

# 新建队列() -> 字典：返回空队列
# 参数：无
# 返回值：{"项":[]}
函数 新建队列() -> 字典
    返回 {"项": []}
结束

# 入队(队列, 元素)：入队尾
# 参数 队列：队列字典；元素：待入元素
# 返回值：无
函数 入队(字典 队列, 元素)
    内置追加(队列["项"], 元素)
结束

# 出队(队列)：出队首
# 参数 队列：非空队列
# 返回值：队首元素
函数 出队(字典 队列)
    如果 队列空(队列) 抛出 "队列为空"
    字典 首 = 队列["项"][0]
    队列["项"] = 内置切片(队列["项"], 1, 内置长度(队列["项"]))
    返回 首
结束

# 队首(队列)：查看队首
# 参数 队列：非空队列
# 返回值：队首元素
函数 队首(字典 队列)
    如果 队列空(队列) 抛出 "队列为空"
    返回 队列["项"][0]
结束

# 队列空(队列) -> 布尔：队列是否为空
# 参数 队列：队列字典
# 返回值：空为真
函数 队列空(字典 队列) -> 布尔
    返回 内置长度(队列["项"]) == 0
结束

# ============================================================
# 双端队列
# ============================================================

# 新建双端队列() -> 字典：返回空双端队列
# 参数：无
# 返回值：{"项":[]}
函数 新建双端队列() -> 字典
    返回 {"项": []}
结束

# 队首进(双端队列, 元素)：从首端入
# 参数 双端队列：双端队列字典；元素：待入元素
# 返回值：无
函数 队首进(字典 双端队列, 元素)
    双端队列["项"] = [元素] + 双端队列["项"]
结束

# 队尾进(双端队列, 元素)：从尾端入
# 参数 双端队列：双端队列字典；元素：待入元素
# 返回值：无
函数 队尾进(字典 双端队列, 元素)
    内置追加(双端队列["项"], 元素)
结束

# 队首出(双端队列)：从首端出
# 参数 双端队列：非空
# 返回值：首端元素
函数 队首出(字典 双端队列)
    如果 内置长度(双端队列["项"]) == 0 抛出 "双端队列为空"
    字典 首 = 双端队列["项"][0]
    双端队列["项"] = 内置切片(双端队列["项"], 1, 内置长度(双端队列["项"]))
    返回 首
结束

# 队尾出(双端队列)：从尾端出
# 参数 双端队列：非空
# 返回值：尾端元素
函数 队尾出(字典 双端队列)
    如果 内置长度(双端队列["项"]) == 0 抛出 "双端队列为空"
    返回 内置弹出(双端队列["项"])
结束

# ============================================================
# 优先队列（二叉最小堆）
# ============================================================

# 新建优先队列() -> 字典：返回空优先队列（最小堆）
# 参数：无
# 返回值：{"堆":[]}
函数 新建优先队列() -> 字典
    返回 {"堆": []}
结束

# 优先入队(优先队列, 元素)：插入元素（堆向上冒泡）
# 参数 优先队列：优先队列字典；元素：待插元素
# 返回值：无
函数 优先入队(字典 优先队列, 元素)
    列表 堆 = 优先队列["堆"]
    内置追加(堆, 元素)
    整数 i = 内置长度(堆) - 1
    当 i > 0 循环
        整数 父 = (i - 1) // 2
        如果 堆[i] < 堆[父] 则
            临时 = 堆[i]
            堆[i] = 堆[父]
            堆[父] = 临时
            i = 父
        否则
            跳出
        结束
    结束
结束

# 优先出队(优先队列)：取出最小元素（堆向下调整）
# 参数 优先队列：非空
# 返回值：最小元素
函数 优先出队(字典 优先队列)
    列表 堆 = 优先队列["堆"]
    如果 内置长度(堆) == 0 抛出 "优先队列为空"
    字典 最小 = 堆[0]
    堆[0] = 内置弹出(堆)
    整数 n = 内置长度(堆)
    整数 i = 0
    当 真 循环
        整数 左 = 2 * i + 1
        整数 右 = 2 * i + 2
        整数 最小下标 = i
        如果 左 < n 且 堆[左] < 堆[最小下标] 则
            最小下标 = 左
        结束
        如果 右 < n 且 堆[右] < 堆[最小下标] 则
            最小下标 = 右
        结束
        如果 最小下标 == i 则 跳出 结束
        临时 = 堆[i]
        堆[i] = 堆[最小下标]
        堆[最小下标] = 临时
        i = 最小下标
    结束
    返回 最小
结束

# 优先堆顶(优先队列)：查看最小元素
# 参数 优先队列：非空
# 返回值：最小元素
函数 优先堆顶(字典 优先队列)
    如果 内置长度(优先队列["堆"]) == 0 抛出 "优先队列为空"
    返回 优先队列["堆"][0]
结束

# 优先队列空(优先队列) -> 布尔：是否为空
# 参数 优先队列：优先队列字典
# 返回值：空为真
函数 优先队列空(字典 优先队列) -> 布尔
    返回 内置长度(优先队列["堆"]) == 0
结束

# ============================================================
# 二叉搜索树（节点：{"值":v,"左":左,"右":右}，空用 "" 表示）
# ============================================================

# 新建BST() -> 字典：返回空二叉搜索树
# 参数：无
# 返回值：{"根":""}
函数 新建BST() -> 字典
    返回 {"根": ""}
结束

# BST插入(树, 值)：插入值
# 参数 树：BST字典；值：待插数值
# 返回值：无
函数 BST插入(字典 树, 值)
    树["根"] = BST插入内部(树["根"], 值)
结束

# BST插入内部(节点, 值) -> 节点：递归插入
# 参数 节点：当前节点；值：待插值
# 返回值：新子树根
函数 BST插入内部(节点, 值)
    如果 节点 == "" 则
        返回 {"值": 值, "左": "", "右": ""}
    结束
    如果 值 < 节点["值"] 则
        节点["左"] = BST插入内部(节点["左"], 值)
    否则
        节点["右"] = BST插入内部(节点["右"], 值)
    结束
    返回 节点
结束

# BST查找(树, 值) -> 布尔：树是否含值
# 参数 树：BST字典；值：待查值
# 返回值：包含为真
函数 BST查找(字典 树, 值) -> 布尔
    返回 BST查找内部(树["根"], 值)
结束

# BST查找内部(节点, 值) -> 布尔：递归查找
# 参数 节点：当前节点；值：待查值
# 返回值：包含为真
函数 BST查找内部(节点, 值) -> 布尔
    如果 节点 == "" 返回 假
    如果 值 == 节点["值"] 返回 真
    如果 值 < 节点["值"] 则
        返回 BST查找内部(节点["左"], 值)
    结束
    返回 BST查找内部(节点["右"], 值)
结束

# BST前序(树) -> 列表：前序遍历
# 参数 树：BST字典
# 返回值：节点值列表
函数 BST前序(字典 树) -> 列表
    列表 结果 = []
    BST前序内部(树["根"], 结果)
    返回 结果
结束

# BST前序内部：递归前序
函数 BST前序内部(节点, 列表 结果)
    如果 节点 == "" 返回
    内置追加(结果, 节点["值"])
    BST前序内部(节点["左"], 结果)
    BST前序内部(节点["右"], 结果)
结束

# BST中序(树) -> 列表：中序遍历（升序）
# 参数 树：BST字典
# 返回值：节点值列表
函数 BST中序(字典 树) -> 列表
    列表 结果 = []
    BST中序内部(树["根"], 结果)
    返回 结果
结束

# BST中序内部：递归中序
函数 BST中序内部(节点, 列表 结果)
    如果 节点 == "" 返回
    BST中序内部(节点["左"], 结果)
    内置追加(结果, 节点["值"])
    BST中序内部(节点["右"], 结果)
结束

# BST高度(树) -> 整数：树高度（空树 0）
# 参数 树：BST字典
# 返回值：高度
函数 BST高度(字典 树) -> 整数
    返回 BST高度内部(树["根"])
结束

# BST高度内部(节点) -> 整数：递归高度
# 参数 节点：当前节点
# 返回值：高度
函数 BST高度内部(节点) -> 整数
    如果 节点 == "" 返回 0
    整数 左高 = BST高度内部(节点["左"])
    整数 右高 = BST高度内部(节点["右"])
    如果 左高 > 右高 则
        返回 左高 + 1
    结束
    返回 右高 + 1
结束

# ============================================================
# 图（邻接表：邻接表{顶点:[[邻接,权重],...]}）
# ============================================================

# 新建图() -> 字典：返回空有向图
# 参数：无
# 返回值：{"邻接":{}}
函数 新建图() -> 字典
    返回 {"邻接": {}}
结束

# 图加顶点(图, 顶点)：添加顶点
# 参数 图：图字典；顶点：字符串顶点
# 返回值：无
函数 图加顶点(字典 图, 顶点)
    如果 非 内置包含(图["邻接"], 顶点) 则
        图["邻接"][顶点] = []
    结束
结束

# 图加边(图, 起点, 终点, 权重)：加有向边
# 参数 图：图字典；起点/终点：顶点；权重：边权
# 返回值：无
函数 图加边(字典 图, 起点, 终点, 权重)
    图加顶点(图, 起点)
    图加顶点(图, 终点)
    内置追加(图["邻接"][起点], [终点, 权重])
结束

# 图加无向边(图, 甲, 乙, 权重)：加无向边
# 参数 图：图字典；甲/乙：顶点；权重：边权
# 返回值：无
函数 图加无向边(字典 图, 甲, 乙, 权重)
    图加边(图, 甲, 乙, 权重)
    图加边(图, 乙, 甲, 权重)
结束

# 图顶点列表(图) -> 列表：所有顶点
# 参数 图：图字典
# 返回值：顶点列表
函数 图顶点列表(字典 图) -> 列表
    返回 内置键(图["邻接"])
结束

# 图BFS(图, 起点) -> 列表：广度优先遍历顺序
# 参数 图：图字典；起点：起始顶点
# 返回值：访问顺序列表
函数 图BFS(字典 图, 起点) -> 列表
    字典 访问过 = {}
    字典 队列 = {"项": [起点]}
    列表 结果 = []
    当 内置长度(队列["项"]) > 0 循环
        字典 当前 = 队列["项"][0]
        队列["项"] = 内置切片(队列["项"], 1, 内置长度(队列["项"]))
        如果 内置包含(访问过, 当前) 则 继续 结束
        访问过[当前] = 1
        内置追加(结果, 当前)
        列表 邻居 = 图["邻接"][当前]
        对于 i 从 0 到 内置长度(邻居) - 1 循环
            如果 非 内置包含(访问过, 邻居[i][0]) 则
                内置追加(队列["项"], 邻居[i][0])
            结束
        结束
    结束
    返回 结果
结束

# 图DFS(图, 起点) -> 列表：深度优先遍历顺序
# 参数 图：图字典；起点：起始顶点
# 返回值：访问顺序列表
函数 图DFS(字典 图, 起点) -> 列表
    字典 访问过 = {}
    列表 结果 = []
    图DFS内部(图, 起点, 访问过, 结果)
    返回 结果
结束

# 图DFS内部：递归 DFS
函数 图DFS内部(字典 图, 顶点, 字典 访问过, 列表 结果)
    如果 内置包含(访问过, 顶点) 返回
    访问过[顶点] = 1
    内置追加(结果, 顶点)
    列表 邻居 = 图["邻接"][顶点]
    对于 i 从 0 到 内置长度(邻居) - 1 循环
        图DFS内部(图, 邻居[i][0], 访问过, 结果)
    结束
结束

# 图Dijkstra(图, 起点) -> 字典：最短距离表
# 参数 图：带权图；起点：起始顶点
# 返回值：顶点 -> 最短距离
函数 图Dijkstra(字典 图, 起点) -> 字典
    字典 距离 = {}
    字典 已确定 = {}
    列表 顶点表 = 内置键(图["邻接"])
    对于 i 从 0 到 内置长度(顶点表) - 1 循环
        距离[顶点表[i]] = 1.0e18
    结束
    距离[起点] = 0.0
    当 真 循环
        浮点 最小距 = 1.0e18
        字符串 选中 = ""
        对于 i 从 0 到 内置长度(顶点表) - 1 循环
            字符串 v = 顶点表[i]
            如果 非 内置包含(已确定, v) 且 距离[v] < 最小距 则
                最小距 = 距离[v]
                选中 = v
            结束
        结束
        如果 选中 == "" 则 跳出 结束
        已确定[选中] = 1
        列表 邻居 = 图["邻接"][选中]
        对于 i 从 0 到 内置长度(邻居) - 1 循环
            字符串 邻 = 邻居[i][0]
            浮点 新距 = 距离[选中] + 邻居[i][1]
            如果 新距 < 距离[邻] 则
                距离[邻] = 新距
            结束
        结束
    结束
    返回 距离
结束

# ============================================================
