# ============================================================
# 库/日期时间.co —— coCN 标准库·日期时间模块
#
# 用途：基于 Unix 时间戳的日期计算、闰年判断、星期、格式化。
# 依赖宿主内置：时间戳()。
#
# 函数清单：
#   当前时间戳 / 现在日期 / 是闰年 / 月份天数
#   星期几 / 加天数 / 日期差
#   格式化日期 / 计时器
# ============================================================

让 内置时间戳 = 时间戳
让 内置长度 = 长度

# ============================================================
# 基础
# ============================================================

# 当前时间戳() -> 浮点：当前 Unix 秒
# 参数：无
# 返回值：秒数
函数 当前时间戳() -> 浮点
    返回 内置时间戳()
结束

# 是闰年(整数 年) -> 布尔：是否闰年
# 参数 年：公历年份
# 返回值：闰年为真
函数 是闰年(整数 年) -> 布尔
    如果 年 % 400 == 0 返回 真
    如果 年 % 100 == 0 返回 假
    返回 年 % 4 == 0
结束

# 月份天数(整数 年, 整数 月) -> 整数：该月天数
# 参数 年：年份；月：1~12
# 返回值：天数
函数 月份天数(整数 年, 整数 月) -> 整数
    列表 天数表 = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    如果 月 == 2 且 是闰年(年) 返回 29
    返回 天数表[月 - 1]
结束

# 日期转天数(整数 年, 整数 月, 整数 日) -> 整数：从公元元年起的天数
# 参数 年, 月, 日：公历日期
# 返回值：累计天数
函数 日期转天数(整数 年, 整数 月, 整数 日) -> 整数
    整数 总 = 0
    对于 y 从 1 到 年 - 1 循环
        总 = 总 + 365
        如果 是闰年(y) 则 总 = 总 + 1 结束
    结束
    对于 m 从 1 到 月 - 1 循环
        总 = 总 + 月份天数(年, m)
    结束
    返回 总 + 日
结束

# 星期几(整数 年, 整数 月, 整数 日) -> 整数：0=周日
# 参数 年, 月, 日：公历日期
# 返回值：0~6
函数 星期几(整数 年, 整数 月, 整数 日) -> 整数
    整数 d = 日期转天数(年, 月, 日)
    返回 d % 7
结束

# 是周末(整数 年, 整数 月, 整数 日) -> 布尔：是否周末
# 参数 年, 月, 日：公历日期
# 返回值：周末为真
函数 是周末(整数 年, 整数 月, 整数 日) -> 布尔
    整数 w = 星期几(年, 月, 日)
    返回 w == 0 或 w == 6
结束

# ============================================================
# 计算
# ============================================================

# 日期差(整数 年1, 整数 月1, 整数 日1, 整数 年2, 整数 月2, 整数 日2) -> 整数
# 参数：两个日期
# 返回值：日2 - 日1 的天数
函数 日期差(整数 年1, 整数 月1, 整数 日1, 整数 年2, 整数 月2, 整数 日2) -> 整数
    返回 日期转天数(年2, 月2, 日2) - 日期转天数(年1, 月1, 日1)
结束

# 加天数(整数 年, 整数 月, 整数 日, 整数 加) -> 列表：加 N 天后的日期
# 参数 年, 月, 日：原日期；加：天数（可负）
# 返回值：[年, 月, 日]
函数 加天数(整数 年, 整数 月, 整数 日, 整数 加) -> 列表
    整数 d = 日期转天数(年, 月, 日) + 加
    返回 天数转日期(d)
结束

# 天数转日期(整数 总) -> 列表：累计天数转日期
# 参数 总：从公元元年起的天数
# 返回值：[年, 月, 日]
函数 天数转日期(整数 总) -> 列表
    整数 年 = 1
    当 总 > 366 循环
        整数 年天数 = 365
        如果 是闰年(年) 则 年天数 = 366 结束
        如果 总 <= 年天数 则 跳出 结束
        总 = 总 - 年天数
        年 = 年 + 1
    结束
    整数 月 = 1
    当 月 <= 12 循环
        整数 md = 月份天数(年, 月)
        如果 总 <= md 则 跳出 结束
        总 = 总 - md
        月 = 月 + 1
    结束
    返回 [年, 月, 总]
结束

# ============================================================
# 格式化
# ============================================================

# 补零(整数 n, 整数 宽) -> 字符串：数字前补零
# 参数 n：数字；宽：总宽
# 返回值：补零字符串
函数 补零(整数 n, 整数 宽) -> 字符串
    字符串 s = 转字符串(n)
    当 内置长度(s) < 宽 循环
        s = "0" + s
    结束
    返回 s
结束

# 格式化日期(整数 年, 整数 月, 整数 日) -> 字符串：YYYY-MM-DD
# 参数 年, 月, 日：公历日期
# 返回值：格式化串
函数 格式化日期(整数 年, 整数 月, 整数 日) -> 字符串
    返回 转字符串(年) + "-" + 补零(月, 2) + "-" + 补零(日, 2)
结束

# ============================================================
# 计时器
# ============================================================

# 开始计时() -> 浮点：返回当前时间戳（计时起点）
# 参数：无
# 返回值：时间戳
函数 开始计时() -> 浮点
    返回 内置时间戳()
结束

# 经过时间(浮点 起点) -> 浮点：从起点到现在的秒数
# 参数 起点：开始计时返回值
# 返回值：秒数
函数 经过时间(浮点 起点) -> 浮点
    返回 内置时间戳() - 起点
结束

# ============================================================
# 扩展：更多日期工具
# ============================================================

# 是工作日(整数 年, 整数 月, 整数 日) -> 布尔：周一~周五
# 参数 年, 月, 日：公历日期
# 返回值：工作日为真
函数 是工作日(整数 年, 整数 月, 整数 日) -> 布尔
    整数 w = 星期几(年, 月, 日)
    返回 w != 0 且 w != 6
结束

# 年末(整数 年) -> 列表：当年 12 月 31 日
# 参数 年：年份
# 返回值：[年,12,31]
函数 年末(整数 年) -> 列表
    返回 [年, 12, 31]
结束

# 一年天数(整数 年) -> 整数：该年天数
# 参数 年：年份
# 返回值：365 或 366
函数 一年天数(整数 年) -> 整数
    如果 是闰年(年) 返回 366
    返回 365
结束

# 加月(整数 年, 整数 月, 整数 日, 整数 加) -> 列表：加 N 月
# 参数 年, 月, 日：原日期；加：月数
# 返回值：[年,月,日]
函数 加月(整数 年, 整数 月, 整数 日, 整数 加) -> 列表
    整数 总月 = (年 - 1) * 12 + 月 - 1 + 加
    整数 新年 = 总月 // 12 + 1
    整数 新月 = 总月 % 12 + 1
    返回 [新年, 新月, 日]
结束

# 加年(整数 年, 整数 月, 整数 日, 整数 加) -> 列表：加 N 年
# 参数 年, 月, 日：原日期；加：年数
# 返回值：[年,月,日]
函数 加年(整数 年, 整数 月, 整数 日, 整数 加) -> 列表
    返回 [年 + 加, 月, 日]
结束

# 周几名称(整数 年, 整数 月, 整数 日) -> 字符串：星期中文名
# 参数 年, 月, 日：公历日期
# 返回值：如 "星期一"
函数 周几名称(整数 年, 整数 月, 整数 日) -> 字符串
    列表 名 = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    返回 名[星期几(年, 月, 日)]
结束

# 天数差绝对值(整数 年1, 整数 月1, 整数 日1, 整数 年2, 整数 月2, 整数 日2) -> 整数
# 参数：两个日期
# 返回值：相差天数绝对值
函数 天数差绝对值(整数 年1, 整数 月1, 整数 日1, 整数 年2, 整数 月2, 整数 日2) -> 整数
    整数 d = 日期转天数(年2, 月2, 日2) - 日期转天数(年1, 月1, 日1)
    如果 d < 0 返回 -d
    返回 d
结束

# ============================================================
# 扩展：更多日期工具
# ============================================================

# 本季度(整数 月) -> 整数：所属季度 1~4
# 参数 月：月份
# 返回值：季度
函数 本季度(整数 月) -> 整数
    返回 (月 - 1) // 3 + 1
结束

# 是否同一天(列表 甲, 列表 乙) -> 布尔：两日期是否相同
# 参数 甲, 乙：[年,月,日]
# 返回值：相同为真
函数 是否同一天(列表 甲, 列表 乙) -> 布尔
    返回 甲[0] == 乙[0] 且 甲[1] == 乙[1] 且 甲[2] == 乙[2]
结束

# 日期比较(列表 甲, 列表 乙) -> 整数：甲-乙天数差
# 参数 甲, 乙：[年,月,日]
# 返回值：天数差
函数 日期比较(列表 甲, 列表 乙) -> 整数
    返回 日期差(甲[0], 甲[1], 甲[2], 乙[0], 乙[1], 乙[2])
结束

# 下一天(整数 年, 整数 月, 整数 日) -> 列表：次日
# 参数 年, 月, 日：日期
# 返回值：[年,月,日]
函数 下一天(整数 年, 整数 月, 整数 日) -> 列表
    返回 加天数(年, 月, 日, 1)
结束

# 上一天(整数 年, 整数 月, 整数 日) -> 列表：前一天
# 参数 年, 月, 日：日期
# 返回值：[年,月,日]
函数 上一天(整数 年, 整数 月, 整数 日) -> 列表
    返回 加天数(年, 月, 日, -1)
结束

# 年龄计算(整数 出生年, 整数 当前年) -> 整数：年龄
# 参数 出生年：出生年；当前年：当前年
# 返回值：年龄
函数 年龄计算(整数 出生年, 整数 当前年) -> 整数
    返回 当前年 - 出生年
结束

# 月份名称(整数 月) -> 字符串：月份中文名
# 参数 月：1~12
# 返回值：月份名
函数 月份名称(整数 月) -> 字符串
    列表 名 = ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"]
    返回 名[月 - 1]
结束

# ============================================================
# 扩展：更多日期工具
# ============================================================

# 星期名称(整数 星期) -> 字符串：星期中文名
# 参数 星期：0~6
# 返回值：星期名
函数 星期名称(整数 星期) -> 字符串
    列表 名 = ["日", "一", "二", "三", "四", "五", "六"]
    返回 "星期" + 名[星期]
结束

# 月份天数表() -> 列表：各月天数
# 参数：无
# 返回值：天数列表
函数 月份天数表() -> 列表
    返回 [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
结束

# 年总天数(整数 年) -> 整数：该年天数
# 参数 年：年份
# 返回值：365或366
函数 年总天数(整数 年) -> 整数
    如果 是闰年(年) 返回 366
    返回 365
结束

# 时间戳到日期(浮点 戳) -> 列表：戳转[年,月,日]
# 参数 戳：时间戳
# 返回值：[年,月,日]
函数 时间戳到日期(浮点 戳) -> 列表
    整数 总秒 = 转整数(戳)
    整数 天 = 总秒 / 86400
    整数 年 = 1970
    当 天 >= 年总天数(年) 循环
        天 = 天 - 年总天数(年)
        年 = 年 + 1
    结束
    整数 月 = 1
    当 天 >= 月份天数(年, 月) 循环
        天 = 天 - 月份天数(年, 月)
        月 = 月 + 1
    结束
    返回 [年, 月, 天 + 1]
结束

# 日期到时间戳(列表 日期) -> 浮点：[年,月,日]转戳
# 参数 日期：[年,月,日]
# 返回值：时间戳
函数 日期到时间戳(列表 日期) -> 浮点
    整数 天 = 日期转天数(日期[0], 日期[1], 日期[2])
    返回 天 * 86400.0
结束

