# ============================================================
# 库/列表.co —— coCN 标准库·列表模块
#
# 用途：列表的基础操作、查找、修改、变换、集合运算、统计、
#       排列组合与经典排序/搜索算法。
# 仅依赖宿主内置函数；与内置同名者先捕获再遮蔽并委托。
#
# 函数清单：
#   基础：长度 / 追加 / 扩展 / 插入 / 删除 / 移除 / 弹出 / 清空 / 复制
#   查找：索引 / 计数 / 包含 / 查找 / 查找所有
#   修改：排序 / 反向 / 打乱 / 去重 / 去相邻重复 / 旋转 / 切片
#   变换：映射 / 过滤 / 归约 / 扁平化 / 深扁平化 / 压缩 / 枚举 / 窗口 / 累积
#   集合：并集 / 交集 / 差集 / 对称差 / 子集 / 超集
#   统计：求和 / 平均 / 最大 / 最小 / 最大索引 / 最小索引 / 中位数
#   排列组合：排列 / 组合 / 笛卡尔积 / 幂集
#   算法：二分搜索 / 线性搜索 / 冒泡排序 / 选择排序 / 插入排序 /
#         快速排序 / 归并排序 / 堆排序
# ============================================================

让 内置长度 = 长度
让 内置追加 = 追加
让 内置插入 = 插入
让 内置弹出 = 弹出
让 内置切片 = 切片
让 内置排序 = 排序
让 内置去重 = 去重
让 内置索引 = 索引
让 内置计数 = 计数
让 内置包含 = 包含
让 内置范围 = 范围
让 内置累加 = 累加
让 内置随机选取 = 随机选取
让 内置打乱 = 打乱
让 内置深拷贝 = 深拷贝
让 内置删除键 = 删除键

# ============================================================
# 基础
# ============================================================

# 长度(列表 表) -> 整数：列表元素个数
# 参数 表：列表
# 返回值：元素个数
函数 长度(列表 表) -> 整数
    返回 内置长度(表)
结束

# 追加(列表 表, 元素)：尾部追加元素（原地）
# 参数 表：列表；元素：待加元素
# 返回值：无
函数 追加(列表 表, 元素)
    内置追加(表, 元素)
结束

# 扩展(列表 表, 列表 其他)：把其他列表元素逐个追加到表尾
# 参数 表：目标列表；其他：被并入列表
# 返回值：无
函数 扩展(列表 表, 列表 其他)
    对于 i 从 0 到 内置长度(其他) - 1 循环
        内置追加(表, 其他[i])
    结束
结束

# 插入(列表 表, 整数 下标, 元素)：在下标处插入元素
# 参数 表：列表；下标：插入位置；元素：待插元素
# 返回值：无
函数 插入(列表 表, 整数 下标, 元素)
    内置插入(表, 下标, 元素)
结束

# 删除(列表 表, 整数 下标)：按下标删除元素（原地）
# 参数 表：列表；下标：待删下标
# 返回值：无
函数 删除(列表 表, 整数 下标)
    列表 前 = 内置切片(表, 0, 下标)
    列表 后 = 内置切片(表, 下标 + 1, 内置长度(表))
    扩展(表, [])
    对于 i 从 0 到 内置长度(表) - 1 循环
        弹出(表)
    结束
    扩展(表, 前)
    扩展(表, 后)
结束

# 移除(列表 表, 元素)：删除第一个等于 元素 的项（原地）
# 参数 表：列表；元素：待移除元素
# 返回值：是否删除成功
函数 移除(列表 表, 元素) -> 布尔
    整数 idx = 索引(表, 元素)
    如果 idx == -1 返回 假
    删除(表, idx)
    返回 真
结束

# 弹出(列表 表) -> 元素：移除并返回末元素
# 参数 表：非空列表
# 返回值：末元素
函数 弹出(列表 表)
    返回 内置弹出(表)
结束

# 清空(列表 表)：清空列表
# 参数 表：列表
# 返回值：无
函数 清空(列表 表)
    当 内置长度(表) > 0 循环
        内置弹出(表)
    结束
结束

# 复制(列表 表) -> 列表：浅拷贝
# 参数 表：列表
# 返回值：新列表
函数 复制(列表 表) -> 列表
    返回 内置切片(表, 0, 内置长度(表))
结束

# 深复制(列表 表) -> 列表：深拷贝
# 参数 表：列表（可嵌套）
# 返回值：完全独立的新列表
函数 深复制(列表 表) -> 列表
    返回 内置深拷贝(表)
结束

# ============================================================
# 查找
# ============================================================

# 索引(列表 表, 元素) -> 整数：返回元素首次出现下标
# 参数 表：列表；元素：待查元素
# 返回值：下标；未找到返回 -1
函数 索引(列表 表, 元素) -> 整数
    返回 内置索引(表, 元素)
结束

# 计数(列表 表, 元素) -> 整数：统计元素出现次数
# 参数 表：列表；元素：待计数元素
# 返回值：次数
函数 计数(列表 表, 元素) -> 整数
    返回 内置计数(表, 元素)
结束

# 包含(列表 表, 元素) -> 布尔：表是否含元素
# 参数 表：列表；元素：待查元素
# 返回值：包含为真
函数 包含(列表 表, 元素) -> 布尔
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] == 元素 则
            返回 真
        结束
    结束
    返回 假
结束

# 查找(列表 表, 函数 谓词) -> 元素：返回首个满足谓词的元素
# 参数 表：列表；谓词：元素->布尔
# 返回值：首个满足元素；无则返回 空
函数 查找(列表 表, 谓词)
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 谓词(表[i]) 则
            返回 表[i]
        结束
    结束
    返回 空
结束

# 查找所有(列表 表, 函数 谓词) -> 列表：返回所有满足谓词的元素
# 参数 表：列表；谓词：元素->布尔
# 返回值：满足元素列表
函数 查找所有(列表 表, 谓词) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 谓词(表[i]) 则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 索引所有(列表 表, 元素) -> 列表：返回元素所有出现下标
# 参数 表：列表；元素：待查元素
# 返回值：下标列表
函数 索引所有(列表 表, 元素) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] == 元素 则
            内置追加(结果, i)
        结束
    结束
    返回 结果
结束

# ============================================================
# 修改
# ============================================================

# 排序(列表 表) -> 列表：升序排序（返回新列表）
# 参数 表：数值列表
# 返回值：排序后的新列表
函数 排序(列表 表) -> 列表
    列表 副本 = 复制(表)
    内置排序(副本)
    返回 副本
结束

# 反向(列表 表) -> 列表：返回逆序新列表
# 参数 表：列表
# 返回值：逆序列表
函数 反向(列表 表) -> 列表
    列表 结果 = []
    整数 i = 内置长度(表) - 1
    当 i >= 0 循环
        内置追加(结果, 表[i])
        i = i - 1
    结束
    返回 结果
结束

# 打乱(列表 表) -> 列表：返回随机打乱的新列表
# 参数 表：列表
# 返回值：打乱后的新列表
函数 打乱(列表 表) -> 列表
    列表 副本 = 复制(表)
    返回 内置打乱(副本)
结束

# 去重(列表 表) -> 列表：去重（保留首次出现顺序）
# 参数 表：列表
# 返回值：去重后列表
函数 去重(列表 表) -> 列表
    列表 结果 = []
    字典 见过 = {}
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 非 内置包含(见过, k) 则
            见过[k] = 1
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 去相邻重复(列表 表) -> 列表：去除相邻重复元素
# 参数 表：列表
# 返回值：去相邻重复后列表
函数 去相邻重复(列表 表) -> 列表
    如果 内置长度(表) == 0 返回 []
    列表 结果 = [表[0]]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] != 表[i - 1] 则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 旋转(列表 表, 整数 步数) -> 列表：循环旋转
# 参数 表：列表；步数：正向右旋、负向左旋
# 返回值：旋转后的新列表
函数 旋转(列表 表, 整数 步数) -> 列表
    整数 n = 内置长度(表)
    如果 n == 0 返回 []
    步数 = 步数 % n
    如果 步数 < 0 则 步数 = 步数 + n 结束
    列表 右 = 内置切片(表, n - 步数, n)
    列表 左 = 内置切片(表, 0, n - 步数)
    列表 结果 = 复制(右)
    扩展(结果, 左)
    返回 结果
结束

# 切片(列表 表, 整数 起, 整数 止) -> 列表：切片副本
# 参数 表：列表；起/止：起止下标
# 返回值：子列表
函数 切片(列表 表, 整数 起, 整数 止) -> 列表
    返回 内置切片(表, 起, 止)
结束

# 反转原地(列表 表)：原地反转列表
# 参数 表：列表
# 返回值：无
函数 反转原地(列表 表)
    整数 n = 内置长度(表)
    对于 i 从 0 到 n // 2 - 1 循环
        整数 j = n - 1 - i
        临时 = 表[i]
        表[i] = 表[j]
        表[j] = 临时
    结束
结束

# ============================================================
# 变换
# ============================================================

# 映射(列表 表, 函数 变换) -> 列表：对每个元素应用变换
# 参数 表：列表；变换：元素->新值
# 返回值：新列表
函数 映射(列表 表, 变换) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, 变换(表[i]))
    结束
    返回 结果
结束

# 过滤(列表 表, 函数 谓词) -> 列表：保留满足谓词的元素
# 参数 表：列表；谓词：元素->布尔
# 返回值：过滤后列表
函数 过滤(列表 表, 谓词) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 谓词(表[i]) 则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 归约(列表 表, 函数 操作, 初值) -> 值：左折叠
# 参数 表：列表；操作：(累加,元素)->新累加；初值：初始累加
# 返回值：折叠结果
函数 归约(列表 表, 操作, 初值)
    整数 累加 = 初值
    对于 i 从 0 到 内置长度(表) - 1 循环
        累加 = 操作(累加, 表[i])
    结束
    返回 累加
结束

# 扁平化(列表 表) -> 列表：展开一层嵌套
# 参数 表：可能嵌套一层的列表
# 返回值：展开后的列表
函数 扁平化(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 是列表(表[i]) 则
            扩展(结果, 表[i])
        否则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 深扁平化(列表 表) -> 列表：递归展开所有嵌套
# 参数 表：任意嵌套列表
# 返回值：完全展开的列表
函数 深扁平化(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 是列表(表[i]) 则
            扩展(结果, 深扁平化(表[i]))
        否则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 压缩(列表 表, 列表 掩码) -> 列表：按布尔掩码挑选元素
# 参数 表：列表；掩码：等长布尔列表
# 返回值：掩码为真处的元素
函数 压缩(列表 表, 列表 掩码) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 掩码[i] 则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 枚举(列表 表) -> 列表：转为 [下标, 元素] 对列表
# 参数 表：列表
# 返回值：如 ["a","b"] -> [[0,"a"],[1,"b"]]
函数 枚举化(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        内置追加(结果, [i, 表[i]])
    结束
    返回 结果
结束

# 窗口(列表 表, 整数 大小) -> 列表：滑动窗口
# 参数 表：列表；大小：窗口长度
# 返回值：连续窗口列表
函数 窗口(列表 表, 整数 大小) -> 列表
    列表 结果 = []
    如果 大小 <= 0 返回 []
    对于 i 从 0 到 内置长度(表) - 大小 循环
        内置追加(结果, 内置切片(表, i, i + 大小))
    结束
    返回 结果
结束

# 累积(列表 表, 函数 操作, 初值) -> 列表：累积折叠
# 参数 表：列表；操作：二元函数；初值：初值
# 返回值：各步累积结果
函数 累积(列表 表, 操作, 初值) -> 列表
    列表 结果 = []
    整数 累 = 初值
    对于 i 从 0 到 内置长度(表) - 1 循环
        累 = 操作(累, 表[i])
        内置追加(结果, 累)
    结束
    返回 结果
结束

# ============================================================
# 集合运算
# ============================================================

# 并集(列表 甲, 列表 乙) -> 列表：两列表并集（去重）
# 参数 甲, 乙：列表
# 返回值：合并去重后的列表
函数 并集(列表 甲, 列表 乙) -> 列表
    列表 结果 = 复制(甲)
    扩展(结果, 乙)
    返回 去重(结果)
结束

# 交集(列表 甲, 列表 乙) -> 列表：两列表交集
# 参数 甲, 乙：列表
# 返回值：共同元素
函数 交集(列表 甲, 列表 乙) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(甲) - 1 循环
        如果 包含(乙, 甲[i]) 且 非 包含(结果, 甲[i]) 则
            内置追加(结果, 甲[i])
        结束
    结束
    返回 结果
结束

# 差集(列表 甲, 列表 乙) -> 列表：甲减去乙中元素
# 参数 甲, 乙：列表
# 返回值：甲中不在乙的元素
函数 差集(列表 甲, 列表 乙) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(甲) - 1 循环
        如果 非 包含(乙, 甲[i]) 且 非 包含(结果, 甲[i]) 则
            内置追加(结果, 甲[i])
        结束
    结束
    返回 结果
结束

# 对称差(列表 甲, 列表 乙) -> 列表：仅属于一方的元素
# 参数 甲, 乙：列表
# 返回值：对称差
函数 对称差(列表 甲, 列表 乙) -> 列表
    列表 a = 差集(甲, 乙)
    列表 b = 差集(乙, 甲)
    扩展(a, b)
    返回 去重(a)
结束

# 子集(列表 甲, 列表 乙) -> 布尔：甲是否为乙子集
# 参数 甲, 乙：列表
# 返回值：甲所有元素都在乙中为真
函数 子集(列表 甲, 列表 乙) -> 布尔
    对于 i 从 0 到 内置长度(甲) - 1 循环
        如果 非 包含(乙, 甲[i]) 则
            返回 假
        结束
    结束
    返回 真
结束

# 超集(列表 甲, 列表 乙) -> 布尔：甲是否为乙超集
# 参数 甲, 乙：列表
# 返回值：乙所有元素都在甲中为真
函数 超集(列表 甲, 列表 乙) -> 布尔
    返回 子集(乙, 甲)
结束

# ============================================================
# 统计
# ============================================================

# 求和(列表 表) -> 数值：元素和
# 参数 表：数值列表
# 返回值：总和
函数 求和(列表 表)
    浮点 s = 0.0
    对于 i 从 0 到 内置长度(表) - 1 循环
        s = s + 表[i]
    结束
    返回 s
结束

# 平均(列表 表) -> 浮点：平均值
# 参数 表：非空数值列表
# 返回值：平均值
函数 平均(列表 表) -> 浮点
    如果 内置长度(表) == 0 返回 0.0
    返回 求和(表) / 内置长度(表)
结束

# 最大(列表 表) -> 数值：最大值
# 参数 表：非空数值列表
# 返回值：最大值
函数 最大(列表 表)
    如果 内置长度(表) == 0 抛出 "最大：空列表"
    浮点 最 = 表[0]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] > 最 则
            最 = 表[i]
        结束
    结束
    返回 最
结束

# 最小(列表 表) -> 数值：最小值
# 参数 表：非空数值列表
# 返回值：最小值
函数 最小(列表 表)
    如果 内置长度(表) == 0 抛出 "最小：空列表"
    浮点 最 = 表[0]
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] < 最 则
            最 = 表[i]
        结束
    结束
    返回 最
结束

# 最大索引(列表 表) -> 整数：最大值下标
# 参数 表：非空数值列表
# 返回值：最大元素下标
函数 最大索引(列表 表) -> 整数
    如果 内置长度(表) == 0 返回 -1
    整数 idx = 0
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] > 表[idx] 则
            idx = i
        结束
    结束
    返回 idx
结束

# 最小索引(列表 表) -> 整数：最小值下标
# 参数 表：非空数值列表
# 返回值：最小元素下标
函数 最小索引(列表 表) -> 整数
    如果 内置长度(表) == 0 返回 -1
    整数 idx = 0
    对于 i 从 1 到 内置长度(表) - 1 循环
        如果 表[i] < 表[idx] 则
            idx = i
        结束
    结束
    返回 idx
结束

# 中位数(列表 表) -> 浮点：中位数
# 参数 表：数值列表
# 返回值：中位数
函数 中位数(列表 表) -> 浮点
    整数 n = 内置长度(表)
    如果 n == 0 返回 0.0
    列表 副本 = 排序(表)
    如果 n % 2 == 1 返回 副本[n // 2]
    返回 (副本[n // 2 - 1] + 副本[n // 2]) / 2.0
结束

# ============================================================
# 排列组合
# ============================================================

# 排列(列表 表, 整数 k) -> 列表：选 k 个的所有排列
# 参数 表：列表；k：选取个数
# 返回值：排列列表（每项是一个列表）
函数 排列(列表 表, 整数 k) -> 列表
    列表 结果 = []
    列表 当前 = []
    排列内部(表, k, 当前, 结果)
    返回 结果
结束

# 排列内部：递归辅助
函数 排列内部(列表 表, 整数 k, 列表 当前, 列表 结果)
    如果 内置长度(当前) == k 则
        内置追加(结果, 复制(当前))
        返回
    结束
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 非 包含(当前, 表[i]) 则
            内置追加(当前, 表[i])
            排列内部(表, k, 当前, 结果)
            内置弹出(当前)
        结束
    结束
结束

# 组合(列表 表, 整数 k) -> 列表：选 k 个的所有组合
# 参数 表：列表；k：选取个数
# 返回值：组合列表
函数 组合(列表 表, 整数 k) -> 列表
    列表 结果 = []
    列表 当前 = []
    组合内部(表, k, 0, 当前, 结果)
    返回 结果
结束

# 组合内部：递归辅助
函数 组合内部(列表 表, 整数 k, 整数 起点, 列表 当前, 列表 结果)
    如果 内置长度(当前) == k 则
        内置追加(结果, 复制(当前))
        返回
    结束
    对于 i 从 起点 到 内置长度(表) - 1 循环
        内置追加(当前, 表[i])
        组合内部(表, k, i + 1, 当前, 结果)
        内置弹出(当前)
    结束
结束

# 笛卡尔积(列表 甲, 列表 乙) -> 列表：两列表笛卡尔积
# 参数 甲, 乙：列表
# 返回值：所有配对列表
函数 笛卡尔积(列表 甲, 列表 乙) -> 列表
    列表 结果 = []
    对于 i 从 0 到 内置长度(甲) - 1 循环
        对于 j 从 0 到 内置长度(乙) - 1 循环
            内置追加(结果, [甲[i], 乙[j]])
        结束
    结束
    返回 结果
结束

# 幂集(列表 表) -> 列表：所有子集
# 参数 表：列表
# 返回值：子集列表（含空集）
函数 幂集(列表 表) -> 列表
    列表 结果 = [[]]
    对于 i 从 0 到 内置长度(表) - 1 循环
        整数 n = 内置长度(结果)
        对于 j 从 0 到 n - 1 循环
            列表 新 = 复制(结果[j])
            内置追加(新, 表[i])
            内置追加(结果, 新)
        结束
    结束
    返回 结果
结束

# ============================================================
# 搜索算法
# ============================================================

# 线性搜索(列表 表, 元素) -> 整数：线性查找下标
# 参数 表：列表；元素：待查
# 返回值：下标；未找到 -1
函数 线性搜索(列表 表, 元素) -> 整数
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 二分搜索(列表 表, 元素) -> 整数：在升序表中二分查找
# 参数 表：升序列表；元素：待查
# 返回值：下标；未找到 -1
函数 二分搜索(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表) - 1
    当 低 <= 高 循环
        整数 中 = (低 + 高) // 2
        如果 表[中] == 元素 返回 中
        如果 表[中] < 元素 则
            低 = 中 + 1
        否则
            高 = 中 - 1
        结束
    结束
    返回 -1
结束

# ============================================================
# 排序算法（均返回新列表）
# ============================================================

# 冒泡排序(列表 表) -> 列表：冒泡升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 冒泡排序(列表 表) -> 列表
    列表 结果 = 复制(表)
    整数 n = 内置长度(结果)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - i - 2 循环
            如果 结果[j] > 结果[j + 1] 则
                临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
        结束
    结束
    返回 结果
结束

# 选择排序(列表 表) -> 列表：选择升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 选择排序(列表 表) -> 列表
    列表 结果 = 复制(表)
    整数 n = 内置长度(结果)
    对于 i 从 0 到 n - 1 循环
        整数 最小下标 = i
        对于 j 从 i + 1 到 n - 1 循环
            如果 结果[j] < 结果[最小下标] 则
                最小下标 = j
            结束
        结束
        临时 = 结果[i]
        结果[i] = 结果[最小下标]
        结果[最小下标] = 临时
    结束
    返回 结果
结束

# 插入排序(列表 表) -> 列表：插入升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 插入排序(列表 表) -> 列表
    列表 结果 = 复制(表)
    对于 i 从 1 到 内置长度(结果) - 1 循环
        整数 j = i
        当 j > 0 循环
            如果 结果[j] < 结果[j - 1] 则
                临时 = 结果[j]
                结果[j] = 结果[j - 1]
                结果[j - 1] = 临时
                j = j - 1
            否则
                j = 0
            结束
        结束
    结束
    返回 结果
结束

# 快速排序(列表 表) -> 列表：快速升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 快速排序(列表 表) -> 列表
    如果 内置长度(表) <= 1 返回 复制(表)
    浮点 基准 = 表[内置长度(表) // 2]
    列表 小 = []
    列表 等 = []
    列表 大 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        如果 表[i] < 基准 则
            内置追加(小, 表[i])
        否则
            如果 表[i] == 基准 则
                内置追加(等, 表[i])
            否则
                内置追加(大, 表[i])
            结束
        结束
    结束
    列表 结果 = 快速排序(小)
    扩展(结果, 等)
    扩展(结果, 快速排序(大))
    返回 结果
结束

# 归并排序(列表 表) -> 列表：归并升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 归并排序(列表 表) -> 列表
    整数 n = 内置长度(表)
    如果 n <= 1 返回 复制(表)
    整数 中 = n // 2
    列表 左 = 归并排序(内置切片(表, 0, 中))
    列表 右 = 归并排序(内置切片(表, 中, n))
    列表 结果 = []
    整数 i = 0
    整数 j = 0
    当 i < 内置长度(左) 且 j < 内置长度(右) 循环
        如果 左[i] <= 右[j] 则
            内置追加(结果, 左[i])
            i = i + 1
        否则
            内置追加(结果, 右[j])
            j = j + 1
        结束
    结束
    当 i < 内置长度(左) 循环
        内置追加(结果, 左[i])
        i = i + 1
    结束
    当 j < 内置长度(右) 循环
        内置追加(结果, 右[j])
        j = j + 1
    结束
    返回 结果
结束

# 堆排序(列表 表) -> 列表：堆升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 堆排序(列表 表) -> 列表
    列表 结果 = 复制(表)
    整数 n = 内置长度(结果)
    # 建最大堆（自底向上）
    整数 hi = n // 2 - 1
    当 hi >= 0 循环
        堆化(结果, n, hi)
        hi = hi - 1
    结束
    # 逐个取出（自顶向下）
    整数 j = n - 1
    当 j >= 1 循环
        临时 = 结果[0]
        结果[0] = 结果[j]
        结果[j] = 临时
        堆化(结果, j, 0)
        j = j - 1
    结束
    返回 结果
结束

# 堆化(列表 表, 整数 n, 整数 i)：堆排序辅助——维护最大堆性质
# 参数 表：堆数组；n：堆大小；i：根下标
# 返回值：无
函数 堆化(列表 表, 整数 n, 整数 i)
    整数 最大 = i
    整数 左 = 2 * i + 1
    整数 右 = 2 * i + 2
    如果 左 < n 且 表[左] > 表[最大] 则
        最大 = 左
    结束
    如果 右 < n 且 表[右] > 表[最大] 则
        最大 = 右
    结束
    如果 最大 != i 则
        临时 = 表[i]
        表[i] = 表[最大]
        表[最大] = 临时
        堆化(表, n, 最大)
    结束
结束

# ============================================================
# 扩展：配对与组合变换
# ============================================================

# 配对(列表 甲, 列表 乙) -> 列表：按位配对成 [a,b] 列表
# 参数 甲, 乙：等长列表
# 返回值：配对列表
函数 配对(列表 甲, 列表 乙) -> 列表
    列表 结果 = []
    整数 n = 内置长度(甲)
    如果 内置长度(乙) < n 则 n = 内置长度(乙) 结束
    对于 i 从 0 到 n - 1 循环
        内置追加(结果, [甲[i], 乙[i]])
    结束
    返回 结果
结束

# 拉链(列表 表) -> 列表：把多个列表按位合并
# 参数 表：列表的列表
# 返回值：如 [[1,2],[3,4]] -> [[1,3],[2,4]]
函数 拉链(列表 表) -> 列表
    如果 内置长度(表) == 0 返回 []
    整数 n = 内置长度(表[0])
    列表 结果 = []
    对于 i 从 0 到 n - 1 循环
        列表 行 = []
        对于 j 从 0 到 内置长度(表) - 1 循环
            内置追加(行, 表[j][i])
        结束
        内置追加(结果, 行)
    结束
    返回 结果
结束

# 分块(列表 表, 整数 块大小) -> 列表：按块大小切分
# 参数 表：列表；块大小：每块长度
# 返回值：块列表
函数 分块(列表 表, 整数 块大小) -> 列表
    列表 结果 = []
    如果 块大小 <= 0 返回 []
    整数 i = 0
    当 i < 内置长度(表) 循环
        整数 止 = i + 块大小
        如果 止 > 内置长度(表) 则 止 = 内置长度(表) 结束
        内置追加(结果, 内置切片(表, i, 止))
        i = i + 块大小
    结束
    返回 结果
结束

# 交错(列表 甲, 列表 乙) -> 列表：两列表交错合并
# 参数 甲, 乙：列表
# 返回值：如 [1,2],[3,4] -> [1,3,2,4]
函数 交错(列表 甲, 列表 乙) -> 列表
    列表 结果 = []
    整数 i = 0
    当 i < 内置长度(甲) 且 i < 内置长度(乙) 循环
        内置追加(结果, 甲[i])
        内置追加(结果, 乙[i])
        i = i + 1
    结束
    当 i < 内置长度(甲) 循环
        内置追加(结果, 甲[i])
        i = i + 1
    结束
    当 i < 内置长度(乙) 循环
        内置追加(结果, 乙[i])
        i = i + 1
    结束
    返回 结果
结束

# 频率(列表 表) -> 字典：统计各元素频次
# 参数 表：列表
# 返回值：元素字符串键 -> 次数
函数 频率(列表 表) -> 字典
    字典 结果 = {}
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 内置包含(结果, k) 则
            结果[k] = 结果[k] + 1
        否则
            结果[k] = 1
        结束
    结束
    返回 结果
结束

# ============================================================
# 扩展：更多统计
# ============================================================

# 乘积(列表 表) -> 数值：所有元素之积
# 参数 表：数值列表
# 返回值：乘积
函数 乘积(列表 表)
    浮点 p = 1.0
    对于 i 从 0 到 内置长度(表) - 1 循环
        p = p * 表[i]
    结束
    返回 p
结束

# 方差(列表 表) -> 浮点：总体方差
# 参数 表：数值列表
# 返回值：方差
函数 方差(列表 表) -> 浮点
    整数 n = 内置长度(表)
    如果 n == 0 返回 0.0
    浮点 均 = 平均(表)
    浮点 s = 0.0
    对于 i 从 0 到 n - 1 循环
        s = s + (表[i] - 均) * (表[i] - 均)
    结束
    返回 s / n
结束

# 标准差(列表 表) -> 浮点：总体标准差
# 参数 表：数值列表
# 返回值：标准差
函数 标准差(列表 表) -> 浮点
    返回 平方根(方差(表))
结束

# 众数(列表 表) -> 列表：出现最多的元素
# 参数 表：列表
# 返回值：众数列表
函数 众数(列表 表) -> 列表
    字典 频次表 = 频率(表)
    整数 最大频次 = 0
    列表 ks = 键(频次表)
    对于 i 从 0 到 内置长度(ks) - 1 循环
        如果 频次表[ks[i]] > 最大频次 则
            最大频次 = 频次表[ks[i]]
        结束
    结束
    列表 结果 = []
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 频次表[k] == 最大频次 且 非 内置包含(结果, 表[i]) 则
            内置追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 累积和(列表 表) -> 列表：前缀和
# 参数 表：数值列表
# 返回值：前缀和列表
函数 累积和(列表 表) -> 列表
    列表 结果 = []
    浮点 s = 0.0
    对于 i 从 0 到 内置长度(表) - 1 循环
        s = s + 表[i]
        内置追加(结果, s)
    结束
    返回 结果
结束

# 极差(列表 表) -> 浮点：最大减最小
# 参数 表：数值列表
# 返回值：极差
函数 极差(列表 表) -> 浮点
    如果 内置长度(表) == 0 返回 0.0
    返回 最大(表) - 最小(表)
结束

# ============================================================
# 扩展：更多排序
# ============================================================

# 希尔排序(列表 表) -> 列表：希尔升序
# 参数 表：数值列表
# 返回值：新排序列表
函数 希尔排序(列表 表) -> 列表
    列表 结果 = 复制(表)
    整数 n = 内置长度(结果)
    整数 间隔 = n // 2
    当 间隔 > 0 循环
        对于 i 从 间隔 到 n - 1 循环
            浮点 临时值 = 结果[i]
            整数 j = i
            当 j >= 间隔 且 结果[j - 间隔] > 临时值 循环
                结果[j] = 结果[j - 间隔]
                j = j - 间隔
            结束
            结果[j] = 临时值
        结束
        间隔 = 间隔 // 2
    结束
    返回 结果
结束

# 计数排序(列表 表) -> 列表：整数计数排序
# 参数 表：非负整数列表
# 返回值：新排序列表
函数 计数排序(列表 表) -> 列表
    如果 内置长度(表) == 0 返回 []
    整数 上界 = 最大(表)
    字典 桶 = {}
    对于 i 从 0 到 内置长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        如果 内置包含(桶, k) 则
            桶[k] = 桶[k] + 1
        否则
            桶[k] = 1
        结束
    结束
    列表 结果 = []
    对于 v 从 0 到 上界 循环
        字符串 k = 转字符串(v)
        如果 内置包含(桶, k) 则
            对于 c 从 0 到 桶[k] - 1 循环
                内置追加(结果, v)
            结束
        结束
    结束
    返回 结果
结束

# ============================================================
# 扩展：更多搜索与查询
# ============================================================

# 二分左界(列表 表, 元素) -> 整数：找第一个 >= 元素 的位置
# 参数 表：升序列表；元素：待查
# 返回值：下标
函数 二分左界(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表)
    当 低 < 高 循环
        整数 中 = (低 + 高) // 2
        如果 表[中] < 元素 则
            低 = 中 + 1
        否则
            高 = 中
        结束
    结束
    返回 低
结束

# 二分右界(列表 表, 元素) -> 整数：找第一个 > 元素 的位置
# 参数 表：升序列表；元素：待查
# 返回值：下标
函数 二分右界(列表 表, 元素) -> 整数
    整数 低 = 0
    整数 高 = 内置长度(表)
    当 低 < 高 循环
        整数 中 = (低 + 高) // 2
        如果 表[中] <= 元素 则
            低 = 中 + 1
        否则
            高 = 中
        结束
    结束
    返回 低
结束

# 跳跃搜索(列表 表, 元素) -> 整数：块跳跃搜索
# 参数 表：升序列表；元素：待查
# 返回值：下标；未找到 -1
函数 跳跃搜索(列表 表, 元素) -> 整数
    整数 n = 内置长度(表)
    整数 块长 = 向下取整(平方根(n * 1.0))
    整数 前 = 0
    当 表[前] < 元素 循环
        如果 前 + 块长 >= n 则 跳出 结束
        如果 表[前 + 块长] <= 元素 则
            前 = 前 + 块长
        否则
            跳出
        结束
    结束
    对于 i 从 前 到 前 + 块长 循环
        如果 i >= n 返回 -1
        如果 表[i] == 元素 返回 i
    结束
    返回 -1
结束

