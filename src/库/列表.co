# 参数 表：嵌套一层列表
# 返回值：展开列表
函数 展平一层(列表 表) -> 列表
    返回 扁平化(表)
结束

# 逆序对计数(列表 表) -> 整数：逆序对个数（冒泡思想）
# 参数 表：数值列表
# 返回值：逆序对数
函数 逆序对计数(列表 表) -> 整数
    列表 副本 = 复制(表)
    整数 计数 = 0
    整数 n = 内置长度(副本)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 i + 1 到 n - 1 循环
            如果 副本[i] > 副本[j] 则
                计数 = 计数 + 1
            结束
        结束
    结束
    返回 计数
结束

# 列表包含所有(列表 表, 列表 子集) -> 布尔：表是否含子集全部
# 参数 表：列表；子集：候选列表
# 返回值：全部包含为真
函数 列表包含所有(列表 表, 列表 子集) -> 布尔
    对于 i 从 0 到 内置长度(子集) - 1 循环
        如果 非 内置包含(表, 子集[i]) 则
            返回 假
        结束
    结束
    返回 真
结束

# 首尾(列表 表) -> 列表：返回 [首元素, 末元素]
# 参数 表：非空列表
# 返回值：[首, 尾]
函数 首尾(列表 表) -> 列表
    如果 内置长度(表) == 0 返回 []
    返回 [表[0], 表[内置长度(表) - 1]]
结束

# 倒数第(列表 表, 整数 k) -> 元素：返回倒数第 k 个元素
# 参数 表：列表；k：倒数位置（1 为末元素）
# 返回值：元素
函数 倒数第(列表 表, 整数 k)
    整数 idx = 内置长度(表) - k
    如果 idx < 0 或 idx >= 内置长度(表) 返回 空
    返回 表[idx]
结束

# 分位数列表(列表 表, 整数 等份数) -> 列表：把排序表等分
# 参数 表：数值列表；等份数：等分数
# 返回值：分位点列表
函数 分位数列表(列表 表, 整数 等份数) -> 列表
    列表 副本 = 排序(表)
    列表 结果 = []
    对于 i 从 0 到 等份数 循环
        浮点 位置 = i * (内置长度(副本) - 1) / 等份数
        整数 下 = 向下取整(位置)
        整数 上 = 向上取整(位置)
        如果 下 == 上 则
            内置追加(结果, 副本[下])
        否则
            浮点 部分 = 位置 - 下
            内置追加(结果, 副本[下] * (1.0 - 部分) + 副本[上] * 部分)
        结束
    结束
    返回 结果
结束

