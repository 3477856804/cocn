# ============================================================
# 网络.co —— 纯 coCN 网络模块
#
# 本宿主 coCN 没有原生 socket / http 内置，所有网络操作都通过
# 执行命令 调用系统工具（curl / nc）完成。
#
# 通过 导入 "网络" 引入；顶层函数会被合并到调用方环境。
#
# 约定：
#   - 执行命令(cmd) 返回【去首尾空白后的 stdout】字符串，并把真实退出码
#     记录到 上次退出码，用 退出码() 读取（0=成功）。
#   - 命令输出若需要原样保留，一律写入自己的临时文件，再用 读取文件 读回，
#     避免依赖 stdout 捕获（捕获会合并 stderr 并去空白）。
#   - 超时：curl --max-time 10，nc -w 3。
# ============================================================

导入 "标准库"

# ---------------- 内部工具（收进字典，避免占用顶层命名空间） ----------------
字典 网络内部 = {}

# 运行命令并返回退出码（0 表示成功）
网络内部["运行"] = 函数(字符串 命令) -> 整数
    执行命令(命令)
    返回 退出码()
结束

# 字节(0~255) 转两位大写十六进制，如 255 -> "FF"
网络内部["字节hex"] = 函数(整数 b) -> 字符串
    字符串 表 = "0123456789ABCDEF"
    返回 切片(表, b // 16, b // 16 + 1) + 切片(表, b % 16, b % 16 + 1)
结束

# 单个十六进制字符转数值，如 "A" -> 10
网络内部["hex值"] = 函数(字符串 c) -> 整数
    如果 c >= "0" 且 c <= "9" 则
        返回 转整数(c)
    结束
    字符串 lc = 小写(c)
    如果 lc == "a" 则 返回 10 结束
    如果 lc == "b" 则 返回 11 结束
    如果 lc == "c" 则 返回 12 结束
    如果 lc == "d" 则 返回 13 结束
    如果 lc == "e" 则 返回 14 结束
    如果 lc == "f" 则 返回 15 结束
    返回 0
结束

# 两位十六进制字符串转字节，如 "E4" -> 228
网络内部["hex字节"] = 函数(字符串 h) -> 整数
    返回 网络内部["hex值"](切片(h, 0, 1)) * 16 + 网络内部["hex值"](切片(h, 1, 2))
结束

# curl 通用抓取：按给定命令行片段，把响应体写入 临时文件 后读回；
# 失败（退出码非 0）时返回空字符串。调用方负责清理。
网络内部["curl抓体"] = 函数(字符串 curl片段, 字符串 临时文件) -> 字符串
    整数 rc = 网络内部["运行"]("curl -s --max-time 10 -o '" + 临时文件 + "' " + curl片段)
    如果 rc != 0 则
        执行命令("rm -f '" + 临时文件 + "'")
        返回 ""
    结束
    字符串 体 = 读取文件(临时文件)
    执行命令("rm -f '" + 临时文件 + "'")
    返回 体
结束

# ---------------- HTTP 客户端 ----------------

# HTTP获取(URL) -> 字符串：GET 请求，返回响应体；失败返回空串
函数 HTTP获取(字符串 URL) -> 字符串
    返回 网络内部["curl抓体"]("'" + URL + "'", "/tmp/cocn_http_body")
结束

# HTTP获取带头部(URL, 头列表) -> 字符串：带自定义请求头的 GET
# 头列表 形如 ["Accept: application/json", "User-Agent: cocn"]
函数 HTTP获取带头部(字符串 URL, 列表 头列表) -> 字符串
    字符串 hflags = ""
    对于 i 从 0 到 长度(头列表) - 1 循环
        hflags = hflags + " -H '" + 头列表[i] + "'"
    结束
    返回 网络内部["curl抓体"](hflags + " '" + URL + "'", "/tmp/cocn_http_body")
结束

# HTTP发布(URL, 数据) -> 字符串：POST 表单/原始数据，返回响应体
# 数据写入临时文件用 --data @file 引用，避免 shell 转义问题
函数 HTTP发布(字符串 URL, 字符串 数据) -> 字符串
    字符串 数据文件 = "/tmp/cocn_post_data"
    字符串 临时文件 = "/tmp/cocn_http_body"
    写入文件(数据文件, 数据)
    整数 rc = 网络内部["运行"]("curl -s --max-time 10 -X POST --data @" + 数据文件 + " -o '" + 临时文件 + "' '" + URL + "'")
    执行命令("rm -f '" + 数据文件 + "'")
    如果 rc != 0 则
        执行命令("rm -f '" + 临时文件 + "'")
        返回 ""
    结束
    字符串 体 = 读取文件(临时文件)
    执行命令("rm -f '" + 临时文件 + "'")
    返回 体
结束

# HTTP发布JSON(URL, 字典) -> 字符串：POST JSON，返回响应体
# 用标准库的 JSON序列化 把字典序列化为 JSON 字符串
函数 HTTP发布JSON(字符串 URL, 字典 数据) -> 字符串
    字符串 json = JSON序列化(数据)
    字符串 数据文件 = "/tmp/cocn_post_data"
    字符串 临时文件 = "/tmp/cocn_http_body"
    写入文件(数据文件, json)
    整数 rc = 网络内部["运行"]("curl -s --max-time 10 -X POST -H 'Content-Type: application/json' --data @" + 数据文件 + " -o '" + 临时文件 + "' '" + URL + "'")
    执行命令("rm -f '" + 数据文件 + "'")
    如果 rc != 0 则
        执行命令("rm -f '" + 临时文件 + "'")
        返回 ""
    结束
    字符串 体 = 读取文件(临时文件)
    执行命令("rm -f '" + 临时文件 + "'")
    返回 体
结束

# HTTP下载(URL, 保存路径) -> 布尔：下载文件到指定路径，是否成功
函数 HTTP下载(字符串 URL, 字符串 保存路径) -> 布尔
    整数 rc = 网络内部["运行"]("curl -s --max-time 30 -o '" + 保存路径 + "' '" + URL + "'")
    如果 rc == 0 则 返回 真 结束
    返回 假
结束

# HTTP状态码(URL) -> 整数：返回 HTTP 状态码（200/404...）；失败返回 0
函数 HTTP状态码(字符串 URL) -> 整数
    字符串 输出 = 执行命令("curl -s -o /dev/null --max-time 10 -w '%{http_code}' '" + URL + "'")
    输出 = 去除空白(输出)
    如果 输出 == "" 则 返回 0 结束
    返回 转整数(输出)
结束

# ---------------- TCP 基础（通过 nc） ----------------

# TCP发送(主机, 端口, 数据) -> 字符串：向 TCP 端口发送数据，返回对端响应
# 数据写入临时文件后用重定向喂给 nc，避免 echo 的转义问题
函数 TCP发送(字符串 主机, 整数 端口, 字符串 数据) -> 字符串
    字符串 数据文件 = "/tmp/cocn_tcp_in"
    写入文件(数据文件, 数据)
    字符串 输出 = 执行命令("nc -w 3 " + 主机 + " " + 转字符串(端口) + " < " + 数据文件)
    执行命令("rm -f '" + 数据文件 + "'")
    返回 输出
结束

# 端口开放(主机, 端口) -> 布尔：用 nc -z 探测端口是否可连通
函数 端口开放(字符串 主机, 整数 端口) -> 布尔
    整数 rc = 网络内部["运行"]("nc -z -w 2 " + 主机 + " " + 转字符串(端口))
    如果 rc == 0 则 返回 真 结束
    返回 假
结束

# ---------------- URL 工具 ----------------

# URL编码(字符串) -> 字符串：百分号编码
# 保留 [A-Za-z0-9-_.~]，其余字符按 UTF-8 字节逐字节编码为 %XX
函数 URL编码(字符串 s) -> 字符串
    字符串 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        字符串 c = 切片(s, i, i + 1)
        整数 cp = 转ASCII(c)
        布尔 保留 = (cp >= 48 且 cp <= 57) 或 (cp >= 65 且 cp <= 90) 或 (cp >= 97 且 cp <= 122) 或 c == "-" 或 c == "_" 或 c == "." 或 c == "~"
        如果 保留 则
            结果 = 结果 + c
        否则
            列表 bs = 字节列表(c)
            对于 j 从 0 到 长度(bs) - 1 循环
                结果 = 结果 + "%" + 网络内部["字节hex"](bs[j])
            结束
        结束
    结束
    返回 结果
结束

# URL解码(字符串) -> 字符串：把 %XX 与 + 还原为原文（按 UTF-8 解码）
函数 URL解码(字符串 s) -> 字符串
    列表 字节 = []
    整数 i = 0
    当 i < 长度(s) 循环
        字符串 c = 切片(s, i, i + 1)
        如果 c == "%" 且 i + 2 < 长度(s) 则
            追加(字节, 网络内部["hex字节"](切片(s, i + 1, i + 3)))
            i = i + 3
        否则
            如果 c == "+" 则
                追加(字节, 32)
                i = i + 1
            否则
                列表 bs = 字节列表(c)
                对于 j 从 0 到 长度(bs) - 1 循环
                    追加(字节, bs[j])
                结束
                i = i + 1
            结束
        结束
    结束
    返回 字节转文本(字节)
结束

# 解析URL(URL) -> 字典：拆出 协议/主机/端口/路径/查询
# 例：https://example.com:8080/path?q=1
#   -> {"协议":"https","主机":"example.com","端口":8080,"路径":"/path","查询":{"q":"1"}}
# 端口缺省时按协议补默认值（http=80, https=443）
函数 解析URL(字符串 URL) -> 字典
    字符串 协议 = ""
    字符串 剩余 = URL
    # 1) 分离协议前缀 scheme://
    整数 双斜杠 = 查找(URL, "://")
    如果 双斜杠 >= 0 则
        协议 = 切片(URL, 0, 双斜杠)
        剩余 = 切片(URL, 双斜杠 + 3, 长度(URL))
    结束
    # 2) 分离路径（第一个 / 之后）
    整数 斜杠 = 查找(剩余, "/")
    字符串 主机端口 = 剩余
    字符串 路径 = "/"
    如果 斜杠 >= 0 则
        主机端口 = 切片(剩余, 0, 斜杠)
        路径 = 切片(剩余, 斜杠, 长度(剩余))
    结束
    # 3) 分离主机与端口
    字符串 主机 = 主机端口
    整数 端口 = 0
    整数 冒号 = 查找(主机端口, ":")
    如果 冒号 >= 0 则
        主机 = 切片(主机端口, 0, 冒号)
        端口 = 转整数(切片(主机端口, 冒号 + 1, 长度(主机端口)))
    结束
    # 4) 分离查询串 ?k=v&k=v
    字典 查询 = {}
    整数 问号 = 查找(路径, "?")
    如果 问号 >= 0 则
        字符串 查询串 = 切片(路径, 问号 + 1, 长度(路径))
        路径 = 切片(路径, 0, 问号)
        列表 段 = 分割(查询串, "&")
        对于 i 从 0 到 长度(段) - 1 循环
            如果 段[i] != "" 则
                整数 eq = 查找(段[i], "=")
                如果 eq >= 0 则
                    查询[URL解码(切片(段[i], 0, eq))] = URL解码(切片(段[i], eq + 1, 长度(段[i])))
                结束
            结束
        结束
    结束
    # 5) 缺省端口按协议补
    如果 端口 == 0 则
        如果 协议 == "https" 则 端口 = 443 结束
        如果 协议 == "http" 则 端口 = 80 结束
    结束
    返回 {"协议": 协议, "主机": 主机, "端口": 端口, "路径": 路径, "查询": 查询}
结束
