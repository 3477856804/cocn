# ============================================================
# 语法分析器.co —— coCN 递归下降语法分析器
#
# 输入：词法分析器产出的 token 列表（每个 token 是字典，
#       含 "类型"/"值"/"行"/"列" 四个字段）。
# 输出：AST 程序节点（字典），严格遵循 重写规范.md 第二节。
#
# 导出：
#   函数 语法分析(列表 tokens) -> 字典   # token 列表 → AST
#   函数 解析源(字符串 源) -> 字典       # 词法 + 语法 一站式
#
# 设计要点：
#   1. 换行是语句分隔符；块由 结束 关键字终止。
# 2. 单行糖（若 条件 语句 / 如果 条件 则 语句 / 当 条件 循环 语句 /
#    对于 … 循环 语句 / 函数 f() => 表达式）不强制 结束；
#    但若同一行写了 结束 则必须正确消费，避免被外层块抢走。
#   3. 表达式优先级（低 → 高）：
#      或 < 且 < 位或 | < 位异或 ^ < 位与 &
#      < 相等 ==/!= < 关系 </>/<=/>= < 移位 << />>
#      < 加减 + /- < 乘除模 */ / /% / // < 幂 **
#      < 一元 非 / - / + / ~ < 下标 / 调用 < 主要
#   4. 语法错误：打印行号与当前记号后致命退出。
# ============================================================

导入 "词法分析器"

# ---------- 模块状态 ----------
让 g_tokens = []        # 待解析的 token 列表
让 g_pos = 0            # 当前 token 下标
让 g_括号深度 = 0       # 花括号块嵌套深度（块内 } 等价行尾）

# ---------- 节点坐标（对齐宿主 make_node 时机） ----------
# 宿主 ./bin/引导器 的 make_node 在【构造那颗节点的那一刻】抓当前 token 的行列，
# 而各类节点的构造时机不同，所以坐标不是统一的「节点起点」。
# 实测标定（./bin/引导器，样例见 测试/坐标用例/）：
#   字面量/标识符  构造于 consume 之前            → 自身起点
#                 输出 甲乙丙丁 - 1 → 未定义变量坐标 (1,4)（标识符起点）
#   二元运算      读完右操作数之后构造            → 表达式后第一个 token
#                 输出 "ab" - "cd"   → (1,15)（换行 token 处）
#                 输出 ("s" - 2) + 1 → (1,12)（报错的是内层 '-'，坐标在它自己之后）
#                 输出 0 + ("s" - 2) → (1,16)
#   一元运算      吃掉运算符、读操作数之前构造    → 操作数起点
#                 输出 -"甲" → 取负报错 (1,5)（操作数起点，不是运算符后的下一个 token）
#   函数调用      吃掉左括号、解析实参之前构造    → 第一个实参起点（无实参则 ')'）
#   下标          读完 ']' 之后构造              → ']' 后第一个 token
#                 让 L = [1,2]  L[10] → 列表越界 (2,9)
#                 让 t = 全零([2,2]) t[0][9] → 张量越界 (2,11)
# 求值器/VM 在【即将报错】时才把这些坐标取出来（冷路径），所以逐节点盖戳
# 只花在解析期一次，不进执行热路径 —— 早先用 OP_设置行 逐指令盖戳实测把
# fib(20) 从 9.9s 拖到 17.2s，就是因为那条路每条指令两次全局写。
函数 盖位置(字典 节点) -> 字典
    节点["行"] = 行号()
    节点["列"] = 列号()
    返回 节点
结束

# 用【提前记下的坐标】盖戳（一元运算/抛出 这类「构造时机在关键字之后、
# 但宿主记的是操作数/关键字本身位置」的节点用这个）。
函数 盖在(字典 节点, 整数 行, 整数 列) -> 字典
    节点["行"] = 行
    节点["列"] = 列
    返回 节点
结束

# ---------- 词法游标辅助 ----------
# 当前 token 的类型字段；越界一律当作 文件结束，避免崩溃
函数 词类() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 "文件结束"
    结束
    返回 g_tokens[g_pos]["类型"]
结束

# 当前 token 的值字段
函数 词值() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 ""
    结束
    返回 g_tokens[g_pos]["值"]
结束

# 前瞻：取下标 i 处的 token 类型/值（越界按 文件结束）
函数 词类于(i) -> 字符串
    若 i >= 长度(g_tokens)
        返回 "文件结束"
    结束
    返回 g_tokens[i]["类型"]
结束

函数 词值于(i) -> 字符串
    若 i >= 长度(g_tokens)
        返回 ""
    结束
    返回 g_tokens[i]["值"]
结束

# 当前 token 的行号
函数 行号() -> 整数
    若 g_pos >= 长度(g_tokens)
        返回 0
    结束
    返回 g_tokens[g_pos]["行"]
结束

# 当前 token 的列号
函数 列号() -> 整数
    若 g_pos >= 长度(g_tokens)
        返回 0
    结束
    返回 g_tokens[g_pos]["列"]
结束

# 前进一格
函数 前进()
    g_pos = g_pos + 1
结束

# 致命语法错误：打印行号、期望说明与实际记号，然后退出
函数 报错(字符串 消息)
    输出错误("语法错误 (第" + 转字符串(行号()) + "行): " + 消息 + "，得到 '" + 词值() + "'")
    断言(假, "语法分析失败")
结束

# 期望某个关键字，否则报错；匹配则前进
函数 期望关键字(字符串 期望)
    若 词类() != "关键字" 或 词值() != 期望
        报错("期望关键字 '" + 期望 + "'")
    结束
    前进()
结束

# 期望某个运算符，否则报错；匹配则前进
函数 期望运算符(字符串 期望)
    若 词类() != "运算符" 或 词值() != 期望
        报错("期望运算符 '" + 期望 + "'")
    结束
    前进()
结束

# 判断某关键字是否为「类型标注」关键字（用于变量声明/函数参数/返回类型）
函数 是类型关键字(字符串 k) -> 布尔
    返回 k == "整数" 或 k == "浮点" 或 k == "布尔" 或 k == "字符串" 或 k == "列表" 或 k == "字典" 或 k == "空"
结束

# 「软类型标注」名：README 的类型表里还列了 数字/任意/张量/函数值，
# 但词法分析器并没有把它们登记成关键字（它们走 标识符 分支）。
# 麻烦点在于同一串字常常真是变量名——例子/07_foreach遍历.co:24 就有
# `让 数字 = [10, 20, 30, 40]`，例子/48_密码生成器.co:14 有 `字符串 数字 = "0123456789"`。
# 把它们升级成关键字会当场改坏这些既有代码，所以按上下文识别：
#   只有当它【后面紧跟一个标识符】时，才当类型标注吃掉；否则仍按普通名字处理。
# 宿主 ./bin/引导器 对 `函数 f(数字 a, 数字 b)` 给出 a=10 b=20（标注不改变传参），
# 自举前端以前把 数字 当第 1 个形参名，实参整体左移一位 —— 测试/异常测试.co:177
# 的「安全除法正常分支」因此静默算成 除以零 → -1。属于「编得过但算错」，必须修。
函数 是软标注名(字符串 k) -> 布尔
    返回 k == "数字" 或 k == "任意" 或 k == "张量" 或 k == "函数值"
结束

# 当前位置是否是「标注 + 名字」的开头（前瞻一位）。
# 硬类型关键字总是标注；软名字只在后跟标识符时算标注。
函数 是标注起始() -> 布尔
    如果 词类() == "关键字" 且 是类型关键字(词值()) 则
        返回 真
    结束
    如果 非 是软标注名(词值()) 则
        返回 假
    结束
    如果 词类() != "关键字" 且 词类() != "标识符" 则
        返回 假
    结束
    让 下一 = g_pos + 1
    返回 词类于(下一) == "标识符"
结束

# 判断某词是否是「类型标注」（硬关键字 + 上下文中成立的软名字）。
# 前置条件：当前 token 就是那个候选标注词。
函数 是类型标注(字符串 k) -> 布尔
    如果 词类() == "关键字" 则
        如果 是类型关键字(k) 则
            返回 真
        结束
    否则
        如果 词类() != "标识符" 则
            返回 假
        结束
    结束
    如果 非 是软标注名(k) 则
        返回 假
    结束
    返回 词类于(g_pos + 1) == "标识符"
结束

# 「-> 类型」返回标注位置专用：这里后面跟的是换行而不是名字，
# 所以不能复用 是类型标注 的前瞻规则，按「是标注词」直接判定即可。
函数 是返回类型标注(字符串 k) -> 布尔
    如果 词类() == "关键字" 且 是类型关键字(k) 则
        返回 真
    结束
    如果 词类() == "标识符" 且 是软标注名(k) 则
        返回 真
    结束
    返回 假
结束

# 当前是否为块结束关键字 结束
函数 是结束() -> 布尔
    返回 词类() == "关键字" 且 词值() == "结束"
结束

# 当前是否为分支头关键字（否则 / 否则如果 / 否则若）
函数 是分支头() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "否则" 或 词值() == "否则如果" 或 词值() == "否则若"
结束

# 当前 token 是否为「语句结束」（换行 / 文件结束 / 块结束 / 分支头）
# 用于判定无括号命令调用之后是否还有实参
函数 是语句结束() -> 布尔
    返回 词类() == "换行" 或 词类() == "文件结束" 或 是结束() 或 是分支头()
结束

# §4.6 裸打印脱糖的排除条件：「输出」后面紧跟的这些记号说明它不是命令式打印，
# 而是把 输出 当普通名字用（函数调用写法 / 赋值 / 自增）。
# 依据（全部实测 ./bin/引导器 + 本层现有用法）：
#   输出(1)      下一词 '('  → 本来就是调用，脱糖与否结果相同，走原路径最稳
#   输出 = 5     下一词 '='   → 宿主报语法错误；层里 src/网络.co、工具/ 确实
#                               有 输出 作变量/字典键的写法，不能一并打死
#   输出 += 1 / 输出++        → 同理，属于对 输出 这个标识符的赋值
函数 打印后接非调用记号() -> 布尔
    让 下一 = g_pos + 1
    如果 词类于(下一) != "运算符" 则
        返回 假
    结束
    让 值 = 词值于(下一)
    如果 值 == "(" 或 值 == "=" 则
        返回 真
    结束
    如果 值 == "++" 或 值 == "--" 则
        返回 真
    结束
    返回 是复合赋值(值)
结束

# 当前 token 是否为「则」关键字（含口语别名 那么）
函数 是则() -> 布尔
    返回 词类() == "关键字" 且 (词值() == "则" 或 词值() == "那么")
结束

# 花括号块的收尾判定：} 与行尾等价
函数 是右括号() -> 布尔
    返回 词类() == "运算符" 且 词值() == "}"
结束

# 花括号块：{ 语句; 语句; ... } —— 与 工具/原生编译器/语法分析器.js 严格一致
# 块内换行与分号等价，整条逻辑可压成一行。
函数 解析花括号块(字符串 上下文) -> 列表
    期望运算符("{")
    g_括号深度 = g_括号深度 + 1
    列表 体 = []
    当 词类() != "文件结束" 且 非 是右括号() 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        让 st = 解析语句()
        若 st != 空
            追加(体, st)
        结束
    结束
    若 非 是右括号()
        报错(上下文 + " 的花括号块缺少 }")
    结束
    前进()
    g_括号深度 = g_括号深度 - 1
    返回 体
结束

# 跳过连续换行
函数 跳过换行()
    当 词类() == "换行" 循环
        前进()
    结束
结束

# 当前运算符词值是否为复合赋值运算符
# （+= -= *= /= %= //= **= &= |= ^= <<= >>=）
函数 是复合赋值(字符串 v) -> 布尔
    返回 v == "+=" 或 v == "-=" 或 v == "*=" 或 v == "/=" 或 v == "%=" 或 v == "//=" 或 v == "**=" 或 v == "&=" 或 v == "|=" 或 v == "^=" 或 v == "<<=" 或 v == ">>="
结束

# 复合赋值运算符 → 基础二元运算符（去掉尾部的 =）
# "+=" → "+"，"**=" → "**"，"<<=" → "<<"
函数 复合基础(字符串 v) -> 字符串
    返回 截取(v, 0, 长度(v) - 1)
结束

# ============================================================
# 循环体解析（当 / 对于 共用）
#
# 三种形式：
#   块形式：循环 换行 … 结束          （原有语法，完全兼容）
#   空块：  循环 结束                  （原有语法，完全兼容）
#   单行：  循环 语句                  （新增：免写 结束）
# 调用前提：调用方已消费 循环 关键字；返回后游标停在循环体之后。
# ============================================================
函数 解析循环体() -> 字典
    # 花括号块形式：循环 { … } —— 不需要结尾 结束
    若 词类() == "运算符" 且 词值() == "{"
        返回 {"体":解析花括号块("循环")}
    结束
    # 空块：循环 后紧跟 结束
    若 是结束()
        前进()
        返回 {"体":[]}
    结束
    # 单行形式：循环 后整行都是循环体（可用 ; 串联多条语句）
    # 例：当 i < 5 循环 和 += i; i++    —— 两条语句都进循环体，免写 结束
    # 注意：; 发出的换行 token 值为 ";"，不视为行尾；只有真换行（值 "\n"）才结束收集
    若 词类() != "换行"
        列表 单行体 = []
        当 词类() != "文件结束" 且 非 是结束() 且 非 是分支头() 且 非 (词类() == "换行" 且 词值() != ";") 且 非 (g_括号深度 > 0 且 是右括号()) 循环
            让 st = 解析语句()
            若 st != 空
                追加(单行体, st)
            结束
        结束
        # 与单行 如果 一致：同一行若写了 结束 则必须消费
        若 是结束()
            前进()
        结束
        返回 {"体":单行体}
    结束
    # 块形式：换行后收集语句直到 结束
    前进()  # 吃掉换行
    列表 体 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        让 st = 解析语句()
        若 st != 空
            追加(体, st)
        结束
    结束
    若 非 是结束()
        报错("循环体缺少 结束（或写成单行：当 条件 循环 语句）")
    结束
    前进()
    返回 {"体":体}
结束

# ============================================================
# 表达式层（递归下降优先级）
# ============================================================

# 主要：字面量 / 标识符 / 括号 / 列表 / 字典
# 坐标规则：字面量与标识符在宿主是【consume 之前】make_node，坐标 = 自身起点，
# 所以直接把 行号()/列号() 写进字典字面量（前进() 之前取值）。
函数 解析主要() -> 字典
    若 词类() == "整数"
        字典 n = {"类型":"字面量", "值":词值(), "字面类型":"整数", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "浮点"
        字典 n = {"类型":"字面量", "值":词值(), "字面类型":"浮点", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "字符串"
        字典 n = {"类型":"字面量", "值":词值(), "字面类型":"字符串", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "关键字" 且 词值() == "真"
        字典 n = {"类型":"字面量", "值":"1", "字面类型":"布尔", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "关键字" 且 词值() == "假"
        字典 n = {"类型":"字面量", "值":"0", "字面类型":"布尔", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "关键字" 且 词值() == "空"
        字典 n = {"类型":"字面量", "值":"空", "字面类型":"空", "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "标识符"
        字典 n = {"类型":"标识符", "名字":词值(), "行":行号(), "列":列号()}
        前进()
        返回 n
    结束
    若 词类() == "运算符" 且 词值() == "("
        前进()
        # 空括号 () → 空元组（元素为零）
        若 词类() == "运算符" 且 词值() == ")"
            前进()
            返回 {"类型":"元组字面量", "元素":[]}
        结束
        字典 首个 = 解析或()
        # (a, b, ...) 含逗号 → 元组字面量；(a) → 普通括号表达式
        若 词类() == "运算符" 且 词值() == ","
            列表 元素 = [首个]
            当 词类() == "运算符" 且 词值() == "," 循环
                前进()
                若 词类() == "运算符" 且 词值() == ")"
                    跳出
                结束
                追加(元素, 解析或())
            结束
            期望运算符(")")
            返回 {"类型":"元组字面量", "元素":元素}
        结束
        期望运算符(")")
        返回 首个
    结束
    若 词类() == "运算符" 且 词值() == "["
        返回 解析列表字面量()
    结束
    若 词类() == "运算符" 且 词值() == "{"
        返回 解析字典字面量()
    结束
    # 匿名函数字面量：函数(参数) [-> 返回类型] 体 ... 结束
    # 仅在表达式上下文出现（语句级的「函数 名(...)」由 解析语句 分发到 解析函数定义）
    若 词类() == "关键字" 且 词值() == "函数"
        返回 解析匿名函数()
    结束
    # 匹配 表达式（表达式上下文：匹配结果作为值）
    若 词类() == "关键字" 且 词值() == "匹配"
        返回 解析匹配()
    结束
    # 并发 表达式 ／ 并发 块（创建任务句柄，延迟执行）
    若 词类() == "关键字" 且 词值() == "并发"
        返回 解析并发任务()
    结束
    # 等待 任务（紧绑定一个任务句柄/后缀表达式）
    若 词类() == "关键字" 且 词值() == "等待"
        返回 解析等待任务()
    结束
    # self / 自己：作为标识符处理（方法内引用当前实例，由求值器在方法环境中绑定）
    若 词类() == "关键字" 且 (词值() == "self" 或 词值() == "自己")
        字典 n = {"类型":"标识符", "名字":词值()}
        前进()
        返回 n
    结束
    # super：超引用节点（super(...) 调父类构造；super.方法(...) 调父类被覆盖方法）
    若 词类() == "关键字" 且 词值() == "super"
        前进()
        返回 {"类型":"超引用"}
    结束
    若 是结束()
        报错("多余的 '结束'（单行的「如果 … 则 …」若要写 结束，必须写在同一行）")
    结束
    报错("意外的表达式记号")
结束

# 列表字面量 / 列表推导式
#   普通：[1, 2, 3]
#   推导：[x * x 对于 x 于 列表 若 过滤]
函数 解析列表字面量() -> 字典
    前进()  # 吃掉 [
    # 跨行字面量：`[` 与 `]` 之间的换行只是排版，不是语句分隔符。
    # 否则 `[\n 1,\n 2\n]` 在第一个换行处报「意外的表达式记号」——
    # 这是 2026-10 实测的缺陷：几乎所有其它语言都允许这样排版。
    跳过换行()
    若 词类() == "运算符" 且 词值() == "]"
        前进()
        返回 {"类型":"列表字面量", "元素":[], "是否推导式":0}
    结束
    字典 首个 = 解析或()
    跳过换行()
    # 推导式判定：首个表达式之后紧跟 关键字 对于
    若 词类() == "关键字" 且 词值() == "对于"
        前进()
        若 词类() != "标识符"
            报错("列表推导式需要迭代变量")
        结束
        字符串 迭代名 = 词值()
        前进()
        若 词类() != "关键字" 或 (词值() != "于" 且 词值() != "在")
            报错("列表推导式需要迭代源（于/在）")
        结束
        前进()
        字典 推导源 = 解析或()
        跳过换行()
        让 过滤器 = 空
        若 词类() == "关键字" 且 (词值() == "若" 或 词值() == "如果")
            前进()
            过滤器 = 解析或()
            跳过换行()
        结束
        期望运算符("]")
        返回 {"类型":"列表字面量", "元素":[], "是否推导式":1, "推导体":首个, "迭代变量":迭代名, "推导源":推导源, "过滤器":过滤器}
    结束
    列表 元素 = [首个]
    当 词类() == "运算符" 且 词值() == "," 循环
        前进()
        跳过换行()
        # 容忍尾逗号：[1, 2,]
        若 词类() == "运算符" 且 词值() == "]"
            跳出
        结束
        追加(元素, 解析或())
        跳过换行()
    结束
    期望运算符("]")
    返回 {"类型":"列表字面量", "元素":元素, "是否推导式":0}
结束

# 字典字面量：{"甲": 1, "乙": 2}
# 裸标识符键（如 {苹果: 1}）按 coCN 语法糖退化为字符串字面量
# 字典推导式：{键: 值 对于 变量 在/于 容器 [若 过滤]}
#   例：{w: 长度(w) 对于 w 在 ["甲", "乙"]}  →  {"甲": 1, "乙": 2}
函数 解析字典字面量() -> 字典
    前进()  # 吃掉 {
    跳过换行()
    若 词类() == "运算符" 且 词值() == "}"
        前进()
        返回 {"类型":"字典字面量", "键":[], "值":[]}
    结束
    # 先解析第一对键值；若其后紧跟 对于 则整体是字典推导式
    让 首键 = 解析或()
    跳过换行()
    期望运算符(":")
    跳过换行()
    字典 首值 = 解析或()
    跳过换行()
    若 词类() == "关键字" 且 词值() == "对于"
        前进()
        若 词类() != "标识符"
            报错("字典推导式需要迭代变量")
        结束
        字符串 迭代名 = 词值()
        前进()
        若 词类() != "关键字" 或 (词值() != "于" 且 词值() != "在")
            报错("字典推导式需要迭代源（于/在）")
        结束
        前进()
        字典 推导源 = 解析或()
        跳过换行()
        让 过滤器 = 空
        若 词类() == "关键字" 且 (词值() == "若" 或 词值() == "如果")
            前进()
            过滤器 = 解析或()
            跳过换行()
        结束
        期望运算符("}")
        返回 {"类型":"字典字面量", "键":[], "值":[], "是否推导式":1, "键体":首键, "值体":首值, "迭代变量":迭代名, "推导源":推导源, "过滤器":过滤器}
    结束
    # 普通字典：裸标识符键 → 字符串字面量（推导式的键体不退化，需按变量求值）
    若 首键["类型"] == "标识符"
        首键 = {"类型":"字面量", "值":首键["名字"], "字面类型":"字符串"}
    结束
    列表 键 = [首键]
    列表 值 = [首值]
    当 词类() != "文件结束" 循环
        跳过换行()
        若 词类() == "运算符" 且 词值() == "}"
            跳出
        结束
        若 词类() == "运算符" 且 词值() == ","
            前进()
            跳过换行()
            # 容忍尾逗号：{a: 1, b: 2,}
            若 词类() == "运算符" 且 词值() == "}"
                跳出
            结束
        结束
        让 k = 空
        若 词类() == "字符串"
            k = {"类型":"字面量", "值":词值(), "字面类型":"字符串"}
            前进()
        否则
            k = 解析或()
            # 裸标识符键 → 字符串字面量
            若 k["类型"] == "标识符"
                k = {"类型":"字面量", "值":k["名字"], "字面类型":"字符串"}
            结束
        结束
        期望运算符(":")
        跳过换行()
        字典 v = 解析或()
        追加(键, k)
        追加(值, v)
    结束
    期望运算符("}")
    返回 {"类型":"字典字面量", "键":键, "值":值}
结束

# 后缀：函数调用 f(a, b) 与下标 lst[i]，支持链式 a[b][c]
函数 解析后缀() -> 字典
    字典 n = 解析主要()
    整数 变 = 1
    当 变 == 1 循环
        整数 消费了 = 0
        若 词类() == "运算符" 且 词值() == "("
            消费了 = 1
            前进()
            # 跨行调用：`f(` 后的换行只是排版（与跨行列表/字典字面量同一规则）。
            跳过换行()
            # 坐标：宿主在【吃掉左括号之后、解析实参之前】make_node，
            # 所以记的是第一个实参的起点（无实参时就是 ')'）。
            # 必须在解析实参【之前】取行号/列号，实参解析完游标已经走了。
            整数 调用行 = 行号()
            整数 调用列 = 列号()
            列表 参数 = []
            若 非 (词类() == "运算符" 且 词值() == ")")
                当 1 循环
                    追加(参数, 解析或())
                    跳过换行()
                    若 词类() == "运算符" 且 词值() == ","
                        前进()
                        跳过换行()
                        继续
                    结束
                    跳出
                结束
            结束
            期望运算符(")")
            n = 盖在({"类型":"函数调用", "被调者":n, "参数":参数}, 调用行, 调用列)
        结束
        若 词类() == "运算符" 且 词值() == "["
            消费了 = 1
            前进()
            跳过换行()
            字典 idx = 解析或()
            跳过换行()
            期望运算符("]")
            # 坐标：宿主读完 ']' 之后 make_node → ']' 后第一个 token
            # 实测 让 L = [1,2] 的 L[10] → 列表越界 (2,9)；t[0][9] → 张量越界 (2,11)
            n = 盖位置({"类型":"下标", "容器":n, "索引":idx})
        结束
        # 成员访问 obj.成员 → 下标访问 obj["成员"]（用于 枚举.成员 等字典取值）
        若 词类() == "运算符" 且 词值() == "."
            消费了 = 1
            前进()
            若 词类() != "标识符"
                报错("成员访问 '.' 后需要标识符")
            结束
            字符串 成员名 = 词值()
            前进()
            n = 盖位置({"类型":"下标", "容器":n, "索引":{"类型":"字面量", "值":成员名, "字面类型":"字符串"}})
        结束
        若 消费了 == 0
            变 = 0
        结束
    结束
    返回 n
结束

# 一元前缀：非 / 负号 - / 正号 + / 按位取反 ~
# 坐标：宿主在【吃掉运算符之后、解析操作数之前】make_node，
# 也就是操作数的起点（实测 输出 -"甲" → 取负报错 (1,5)，正是操作数起点）。
# 注意必须先把 行号()/列号() 取进变量再解析操作数：
# 盖在(dict字面量含 解析一元() 调用, 行号(), 列号()) 的实参是从左到右求值的，
# 直接写在后面拿到的是【操作数之后】的位置（实测旧写法报 (1,8) 而非 (1,5)）。
函数 解析一元() -> 字典
    若 词类() == "运算符" 且 (词值() == "-" 或 词值() == "+")
        字符串 op = 词值()
        前进()
        整数 一元行 = 行号()
        整数 一元列 = 列号()
        字典 操作数 = 解析一元()
        返回 盖在({"类型":"一元", "运算符":op, "操作数":操作数}, 一元行, 一元列)
    结束
    若 词类() == "关键字" 且 词值() == "非"
        前进()
        整数 一元行 = 行号()
        整数 一元列 = 列号()
        字典 操作数 = 解析一元()
        返回 盖在({"类型":"一元", "运算符":"非", "操作数":操作数}, 一元行, 一元列)
    结束
    若 词类() == "运算符" 且 词值() == "~"
        前进()
        整数 一元行 = 行号()
        整数 一元列 = 列号()
        字典 操作数 = 解析一元()
        返回 盖在({"类型":"一元", "运算符":"~", "操作数":操作数}, 一元行, 一元列)
    结束
    返回 解析后缀()
结束

# 幂 **（右结合，优先级最高的二元）
函数 解析幂() -> 字典
    字典 左 = 解析一元()
    若 词类() == "运算符" 且 词值() == "**"
        前进()
        字典 右 = 解析幂()
        返回 盖位置({"类型":"二元", "运算符":"**", "左":左, "右":右})
    结束
    返回 左
结束

# 乘除模 * / % //  （左结合）
函数 解析乘除模() -> 字典
    字典 左 = 解析幂()
    整数 变 = 1
    当 变 == 1 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "*" 或 词值() == "/" 或 词值() == "%" 或 词值() == "//")
            op = 词值()
        结束
        若 op == ""
            变 = 0
            继续
        结束
        前进()
        左 = 盖位置({"类型":"二元", "运算符":op, "左":左, "右":解析幂()})
    结束
    返回 左
结束

# 加减 + - （左结合）
函数 解析加减() -> 字典
    字典 左 = 解析乘除模()
    整数 变 = 1
    当 变 == 1 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "+" 或 词值() == "-")
            op = 词值()
        结束
        若 op == ""
            变 = 0
            继续
        结束
        前进()
        左 = 盖位置({"类型":"二元", "运算符":op, "左":左, "右":解析乘除模()})
    结束
    返回 左
结束

# 移位 << >> （左结合）
函数 解析移位() -> 字典
    字典 左 = 解析加减()
    整数 变 = 1
    当 变 == 1 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<<" 或 词值() == ">>")
            op = 词值()
        结束
        若 op == ""
            变 = 0
            继续
        结束
        前进()
        左 = 盖位置({"类型":"二元", "运算符":op, "左":左, "右":解析加减()})
    结束
    返回 左
结束

# 关系比较 < > <= >= （左结合）
函数 解析关系() -> 字典
    字典 左 = 解析移位()
    整数 变 = 1
    当 变 == 1 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<" 或 词值() == ">" 或 词值() == "<=" 或 词值() == ">=")
            op = 词值()
        结束
        若 op == ""
            变 = 0
            继续
        结束
        前进()
        左 = 盖位置({"类型":"二元", "运算符":op, "左":左, "右":解析移位()})
    结束
    返回 左
结束

# 相等 == != （左结合，优先级低于关系）
函数 解析相等() -> 字典
    字典 左 = 解析关系()
    整数 变 = 1
    当 变 == 1 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "==" 或 词值() == "!=")
            op = 词值()
        结束
        若 op == ""
            变 = 0
            继续
        结束
        前进()
        左 = 盖位置({"类型":"二元", "运算符":op, "左":左, "右":解析关系()})
    结束
    返回 左
结束

# 位与 & （左结合）
函数 解析位与() -> 字典
    字典 左 = 解析相等()
    当 词类() == "运算符" 且 词值() == "&" 循环
        前进()
        左 = 盖位置({"类型":"二元", "运算符":"&", "左":左, "右":解析相等()})
    结束
    返回 左
结束

# 位异或 ^ （左结合）
函数 解析位异或() -> 字典
    字典 左 = 解析位与()
    当 词类() == "运算符" 且 词值() == "^" 循环
        前进()
        左 = 盖位置({"类型":"二元", "运算符":"^", "左":左, "右":解析位与()})
    结束
    返回 左
结束

# 位或 | （左结合）
函数 解析位或() -> 字典
    字典 左 = 解析位异或()
    当 词类() == "运算符" 且 词值() == "|" 循环
        前进()
        左 = 盖位置({"类型":"二元", "运算符":"|", "左":左, "右":解析位异或()})
    结束
    返回 左
结束

# 逻辑与 且 （左结合；语义短路由求值器负责）
函数 解析且() -> 字典
    字典 左 = 解析位或()
    当 词类() == "关键字" 且 词值() == "且" 循环
        前进()
        左 = 盖位置({"类型":"二元", "运算符":"且", "左":左, "右":解析位或()})
    结束
    返回 左
结束

# 逻辑或 或 （左结合；语义短路由求值器负责）
函数 解析或() -> 字典
    字典 左 = 解析且()
    当 词类() == "关键字" 且 词值() == "或" 循环
        前进()
        左 = 盖位置({"类型":"二元", "运算符":"或", "左":左, "右":解析且()})
    结束
    返回 左
结束

# ============================================================
# 语句层
# ============================================================

# 变量声明：让 / 变量 / 常量 / 类型标注 名 [= 初始化]
函数 解析变量声明() -> 字典
    字符串 标注 = ""
    字符串 头 = 词值()
    整数 是常量 = 0
    若 头 == "让" 或 头 == "变量" 或 头 == "常量"
        若 头 == "常量"
            是常量 = 1
        结束
        前进()
    结束
    # 可选类型标注（此时当前 token 是 类型关键字）
    若 是类型标注(词值())
        标注 = 词值()
        前进()
    结束
    若 词类() != "标识符"
        报错("变量声明需要标识符")
    结束
    字符串 名 = 词值()
    前进()
    让 初始化 = 空
    若 词类() == "运算符" 且 词值() == "="
        前进()
        初始化 = 解析或()
    结束
    # 坐标：宿主在读完初值之后 make_node（无初值则停在名字处）。
    # 实测 整数 乙 = "字符串" → 类型错误（变量声明）坐标正是行尾 token。
    返回 盖位置({"类型":"变量声明", "名字":名, "类型标注":标注, "初始化":初始化, "是否常量":是常量})
结束

# 返回 [表达式]
函数 解析返回() -> 字典
    # 坐标：宿主在【吃掉 返回 关键字之后】才 make_node，所以记的是
    # 「关键字后面第一个 token」的起点（实测 m21：4 空格缩进 + 返回 "甲" →
    # 第2行,8列 = 开引号所在列；裸 返回 后接换行 → 第2行,3列 = 换行 token）。
    # 返回值自身报错时用的是【值那颗节点】的坐标（实测 返回 "x" - 1 → (3,19)
    # 正是二元 '-' 读完右操作数之后的位置），与本节点无关。
    前进()
    让 返回节点 = {"类型":"返回", "行":行号(), "列":列号()}
    让 v = 空
    # 若下一个是换行 / 结束 / 分支头 / 文件结束，则为裸返回
    若 词类() != "换行" 且 词类() != "文件结束" 且 非 是结束() 且 非 是分支头()
        v = 解析或()
    结束
    返回节点["值"] = v
    返回 返回节点
结束

# 如果 / 若 条件 ... [否则如果 ...] [否则 ...] 结束
# 块形式由「条件后是否紧跟换行」决定（则 始终可选）。
函数 解析如果() -> 字典
    前进()  # 吃掉 如果 / 若
    字典 条件 = 解析或()
    若 是则()
        前进()
    结束
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    列表 则体 = 解析分支体()
    列表 否则链 = []
    当 是分支头() 循环
        让 分支条件 = 空
        字符串 v = 词值()
        若 v == "否则如果" 或 v == "否则若"
            前进()
            分支条件 = 解析或()
        结束
        若 v == "否则"
            前进()
            # 兼容「否则 如果」/「否则 若」（无合并关键字时拆成两个 token）
            若 词类() == "关键字" 且 (词值() == "如果" 或 词值() == "若")
                前进()
                分支条件 = 解析或()
            结束
        结束
        若 是则()
            前进()
        结束
        列表 分支体 = 解析分支体()
        追加(否则链, {"条件":分支条件, "体":分支体})
    结束
    # 块形式必须消费 结束；单行形式仅当同行遇到 结束 才消费
    若 块形式 == 1
        若 非 是结束()
            报错("如果 块缺少 结束")
        结束
        前进()
    否则
        若 是结束()
            前进()
        结束
    结束
    返回 {"类型":"如果", "条件":条件, "则体":则体, "否则链":否则链}
结束

# 解析一个分支体（则体 / 否则体 / 否则如果体）
# 块形式：收集语句直到分支头 / 结束 / EOF；单行形式：仅取一条语句
函数 解析分支体() -> 列表
    列表 体 = []
    # 花括号块形式：如果 条件 { 语句; 语句 }
    若 词类() == "运算符" 且 词值() == "{"
        返回 解析花括号块("分支")
    结束
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    若 块形式 == 1
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 是分支头() 或 是结束()
                跳出
            结束
            让 st = 解析语句()
            若 st != 空
                追加(体, st)
            结束
        结束
    否则
        # 单行形式：如果 条件 则 语句 —— 只取一条语句。
        # 分号属于外层（块或行），不能被吸收进分支体，否则
        # {如果 n<2 则 返回 n;返回 …} 会把第二个返回错当 then 体。
        若 g_括号深度 == 0
            跳过换行()
        结束
        若 非 (是分支头() 或 是结束() 或 (词类() == "换行" 且 词值() != ";") 或 是右括号())
            让 st = 解析语句()
            若 st != 空
                追加(体, st)
            结束
        结束
    结束
    返回 体
结束

# 当 条件 循环 … 结束   （块形式）
# 当 条件 循环 语句     （单行形式，免写 结束）
函数 解析当() -> 字典
    前进()
    字典 条件 = 解析或()
    期望关键字("循环")
    字典 块 = 解析循环体()
    返回 {"类型":"当", "条件":条件, "体":块["体"]}
结束

# 对于 [类型] 变量 从 起点 到 终点 [步长 s] 循环 ... 结束
# 对于 [类型] 变量 在/于 容器 循环 ... 结束   （for-each 遍历形式）
函数 解析对于() -> 字典
    前进()
    若 是类型标注(词值())
        前进()  # 跳过可选类型标注
    结束
    若 词类() != "标识符"
        报错("对于 循环需要标识符")
    结束
    字符串 变量名 = 词值()
    前进()
    # ---- for-each 形式：变量名后紧跟 在/于 ----
    若 词类() == "关键字" 且 (词值() == "在" 或 词值() == "于")
        前进()
        字典 容器节点 = 解析或()
        期望关键字("循环")
        字典 遍历循环 = 解析循环体()
        返回 {"类型":"对于", "变量":变量名, "遍历源":容器节点, "体":遍历循环["体"], "是否遍历":1}
    结束
    # ---- 原有范围形式 ----
    期望关键字("从")
    字典 起点 = 解析或()
    期望关键字("到")
    字典 终点 = 解析或()
    让 步长值 = 空
    若 词类() == "关键字" 且 词值() == "步长"
        前进()
        步长值 = 解析或()
    结束
    期望关键字("循环")
    字典 范围循环 = 解析循环体()
    # 坐标：宿主在消费 结束（或单行体的行尾）之后 make_node。
    # 实测 f1：四格缩进「结束」的下一 token 是第4行,7列；八格缩进 → 第4行,11列；
    # 单行「… 结束」同行 → 行尾换行 token 列。步长零报错正是用这颗节点的坐标。
    返回 盖位置({"类型":"对于", "变量":变量名, "起点":起点, "终点":终点, "步长":步长值, "体":范围循环["体"]})
结束

# 函数 名(类型 a, 类型 b) -> 返回类型 ... 结束
函数 解析函数定义() -> 字典
    前进()
    若 词类() != "标识符"
        报错("函数定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    期望运算符("(")
    跳过换行()
    列表 参数 = []
    列表 参数类型 = []
    列表 参数默认 = []
    若 非 (词类() == "运算符" 且 词值() == ")")
        当 非 (词类() == "运算符" 且 词值() == ")") 且 词类() != "文件结束" 循环
            跳过换行()
            字符串 pt = ""
            若 是类型标注(词值())
                pt = 词值()
                前进()
            结束
            # 可变参数前缀：...名
            整数 可变标记 = 0
            若 词类() == "运算符" 且 词值() == "..."
                可变标记 = 1
                前进()
            结束
            若 词类() != "标识符" 且 非 (词类() == "关键字" 且 (词值() == "self" 或 词值() == "自己"))
                报错("函数参数需要标识符")
            结束
            追加(参数, 词值())
            若 可变标记 == 1
                追加(参数类型, "可变")
            否则
                追加(参数类型, pt)
            结束
            前进()
            # 默认参数：名 = 表达式
            让 默认值 = 空
            若 词类() == "运算符" 且 词值() == "="
                前进()
                默认值 = 解析或()
            结束
            追加(参数默认, 默认值)
            若 词类() == "运算符" 且 词值() == ","
                前进()
                跳过换行()
            结束
            跳过换行()
        结束
    结束
    期望运算符(")")
    字符串 返回类型 = ""
    若 词类() == "运算符" 且 词值() == "->"
        前进()
        若 是返回类型标注(词值())
            返回类型 = 词值()
            前进()
        否则
            报错("函数返回类型标注无效")
        结束
    结束
    # 箭头函数单行体：函数 f(...) => 表达式 （隐式返回，免写 结束）
    若 词类() == "运算符" 且 词值() == "=>"
        前进()
        字典 返回值 = 解析或()
        列表 箭头体 = [{"类型":"返回", "值":返回值}]
        字典 箭头程序 = {"类型":"程序", "语句":箭头体}
        返回 {"类型":"函数定义", "名字":名, "参数":参数, "参数类型":参数类型, "参数默认":参数默认, "返回类型":返回类型, "体":箭头程序}
    结束
    # 花括号块形式：函数 名(...){ 语句; 语句 } —— 不需要结尾 结束
    若 词类() == "运算符" 且 词值() == "{"
        列表 花体语句 = 解析花括号块("函数定义")
        字典 花体 = {"类型":"程序", "语句":花体语句}
        返回 {"类型":"函数定义", "名字":名, "参数":参数, "参数类型":参数类型, "参数默认":参数默认, "返回类型":返回类型, "体":花体}
    结束
    列表 体语句 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        让 st = 解析语句()
        若 st != 空
            追加(体语句, st)
        结束
    结束
    若 非 是结束()
        报错("函数定义缺少 结束")
    结束
    前进()
    字典 体 = {"类型":"程序", "语句":体语句}
    返回 {"类型":"函数定义", "名字":名, "参数":参数, "参数类型":参数类型, "参数默认":参数默认, "返回类型":返回类型, "体":体}
结束

# 尝试 ... [捕获 变量 ...] [最终 ...] 结束
函数 解析尝试() -> 字典
    前进()
    列表 体 = []
    当 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        若 词类() == "关键字" 且 (词值() == "捕获" 或 词值() == "最终" 或 词值() == "结束")
            跳出
        结束
        让 st = 解析语句()
        若 st != 空
            追加(体, st)
        结束
    结束
    字符串 捕获变量 = ""
    列表 捕获体 = []
    若 词类() == "关键字" 且 词值() == "捕获"
        前进()
        若 词类() == "标识符"
            捕获变量 = 词值()
            前进()
        结束
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 词类() == "关键字" 且 (词值() == "最终" 或 词值() == "结束")
                跳出
            结束
            让 st = 解析语句()
            若 st != 空
                追加(捕获体, st)
            结束
        结束
    结束
    列表 最终体 = []
    若 词类() == "关键字" 且 词值() == "最终"
        前进()
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 词类() == "关键字" 且 词值() == "结束"
                跳出
            结束
            让 st = 解析语句()
            若 st != 空
                追加(最终体, st)
            结束
        结束
    结束
    若 非 是结束()
        报错("尝试 缺少 结束")
    结束
    前进()
    返回 {"类型":"尝试", "体":体, "捕获变量":捕获变量, "捕获体":捕获体, "最终体":最终体}
结束

# 单条语句分发；遇到换行则前进并返回 空（空语句）
# 单条语句分发（外层包装）：为每条语句附加源码位置（行/列）。
# 运行时的异常对象要能报出「第几行」，靠的就是这里写进节点的 行/列。
函数 解析语句()
    若 词类() == "换行"
        前进()
        返回 空
    结束
    若 词类() == "文件结束"
        返回 空
    结束
    让 当前行 = 行号()
    让 当前列 = 列号()
    让 st = 解析语句主体()
    若 st != 空 且 类型(st) == "字典"
        # 只在节点【自己还没带坐标】时兜底覆盖。表达式节点与 抛出/返回/变量声明/对于
        # 已在各自构造时机按宿主 make_node 口径提前盖好，被语句起点覆盖就会全部错位
        # （例：对于 的宿主坐标在【结束之后】第4行,7列，而语句起点是第2行,5列）。
        如果 非 包含(st, "行") 则
            st["行"] = 当前行
        结束
        如果 非 包含(st, "列") 则
            st["列"] = 当前列
        结束
    结束
    返回 st
结束

# 语句主体分发；位置信息由 解析语句 包装层附加
函数 解析语句主体()
    # ---- §4.6 裸打印语句脱糖（宿主口径，实测 ./bin/引导器）----
    # 宿主把「语句开头的 输出 + 同一行后续内容」当命令式调用，优先级【高于】二元运算：
    #   输出 -"甲"   → 取负报错 (1,5)（实参是一元，不是「输出 减去 甲」）
    #   输出 1 - 2   → -1（实参是整个二元式，与旧行为一致）
    # 层里以前直接走 解析或()，把 输出 吃成左操作数，于是
    #   输出 -"甲" 报成「不支持的运算: 函数 - 字符串 (1,10)」——消息和坐标双错。
    # 边界（都实测过，必须保留）：
    #   下一词是 '('     → 普通表达式路径（输出(1) 本来就是调用）
    #   下一词是 '='     → 「输出 = 5」在宿主是语法错误；层里保留标识符用法
    #                      （src/网络.co、工具/ 确有 输出 当变量/键的写法，不能打死）
    #   下一词是 复合赋值/++/-- → 同上，走表达式路径
    #   后面直接换行     → 无参打印（输出 空行），也走表达式路径（结果相同）
    # 只脱糖 输出：输出错误 在宿主不是语句关键字（实测 输出错误 -1 →
    # 未定义变量: 输出错误），层里它靠既有的命令式调用分支工作，不动。
    若 词类() == "标识符" 且 词值() == "输出" 且 非 打印后接非调用记号() 且 非 是语句结束()
        字典 输出节点 = 盖位置({"类型": "标识符", "名字": "输出"})
        前进()
        # 宿主的调用节点坐标 = 第一个实参的起点（实测 表(10) 的报错在 (1,6)）。
        整数 调用行 = 行号()
        整数 调用列 = 列号()
        列表 打印参数 = [解析或()]
        当 词类() == "运算符" 且 词值() == "," 循环
            前进()
            追加(打印参数, 解析或())
        结束
        返回 盖在({"类型":"函数调用", "被调者":输出节点, "参数":打印参数}, 调用行, 调用列)
    结束
    # 类型标注开头的声明：`整数 x = 1` 走关键字分支，`数字 甲 = 5` 这类
    # 软标注名在词法里是 标识符，得靠「标注 + 标识符」的前瞻认出来。
    如果 是标注起始() 则
        返回 解析变量声明()
    结束
    若 词类() == "关键字"
        字符串 k = 词值()
        若 k == "让" 或 k == "变量" 或 k == "常量"
            返回 解析变量声明()
        结束
        若 是类型关键字(k)
            返回 解析变量声明()
        结束
        若 k == "函数"
            返回 解析函数定义()
        结束
        若 k == "返回"
            返回 解析返回()
        结束
        若 k == "如果" 或 k == "若"
            返回 解析如果()
        结束
        若 k == "当"
            返回 解析当()
        结束
        若 k == "对于"
            返回 解析对于()
        结束
        若 k == "枚举"
            返回 解析枚举()
        结束
        若 k == "结构体"
            返回 解析结构体()
        结束
        若 k == "类"
            返回 解析类定义()
        结束
        若 k == "尝试"
            返回 解析尝试()
        结束
        若 k == "抛出"
            # 坐标：宿主在关键字处 make_node（实测 抛出 "纯文本" → 异常对象 (2,5)=关键字起点；
            # 而 抛出 未定义名 → (2,8) 报的是【值那颗标识符节点】，不冲突）
            字典 n = {"类型":"抛出", "行":行号(), "列":列号()}
            前进()
            n["值"] = 解析或()
            返回 n
        结束
        若 k == "跳出"
            字典 n = {"类型":"跳出", "行":行号(), "列":列号()}
            前进()
            返回 n
        结束
        若 k == "继续"
            字典 n = {"类型":"继续", "行":行号(), "列":列号()}
            前进()
            返回 n
        结束
        若 k == "导入"
            前进()
            若 词类() != "字符串"
                报错("导入需要字符串路径")
            结束
            字符串 p = 词值()
            前进()
            # 可选命名空间：导入 "路径" 作为 名
            字符串 命名空间 = ""
            若 词类() == "关键字" 且 词值() == "作为"
                前进()
                若 词类() != "标识符"
                    报错("导入 ... 作为 后面需要标识符")
                结束
                命名空间 = 词值()
                前进()
            结束
            返回 {"类型":"导入", "路径":p, "命名空间":命名空间}
        结束
        若 k == "匹配"
            返回 解析匹配()
        结束
        若 k == "是" 或 k == "情况" 或 k == "默认"
            报错("'" + k + "' 只能出现在 匹配 语句内部")
        结束
    结束
    # 表达式语句 / 赋值 / 命令式无括号调用
    字典 左 = 解析或()
    若 词类() == "运算符" 且 词值() == "="
        前进()
        字典 v = 解析或()
        返回 {"类型":"赋值", "目标":左, "值":v}
    结束
    # 复合赋值：x += e 脱糖为 x = x + e（免重复写目标变量名）
    # 目标可以是标识符，也可以是下标（如 arr[i] += 1 / obj["键"] *= 2）
    若 词类() == "运算符" 且 是复合赋值(词值())
        字符串 op = 复合基础(词值())
        前进()
        字典 v = 解析或()
        返回 {"类型":"赋值", "目标":左, "值":{"类型":"二元", "运算符":op, "左":左, "右":v}}
    结束
    # 自增自减（语句级后置）：i++ / i-- 脱糖为 i = i + 1 / i = i - 1
    # 表达式中间不会出现裸的 ++/--（a + (+b) 由 解析一元 消化 +），
    # 语句尾残留的 ++/-- 只能是自增自减。
    若 词类() == "运算符" 且 (词值() == "++" 或 词值() == "--")
        若 左["类型"] != "标识符" 且 左["类型"] != "下标"
            报错("'++' / '--' 只能用于变量或下标")
        结束
        字符串 自增op = "+"
        若 词值() == "--"
            自增op = "-"
        结束
        前进()
        返回 {"类型":"赋值", "目标":左, "值":{"类型":"二元", "运算符":自增op, "左":左, "右":{"类型":"字面量", "值":"1", "字面类型":"整数"}}}
    结束
    # 命令式调用：左 是裸标识符（未带括号/下标），且同一行后续还有表达式
    # 例如：输出 x ／ 输出 长度(s) ／ 读取文件 路径
    若 左["类型"] == "标识符" 且 非 是语句结束()
        列表 参数 = [解析或()]
        当 词类() == "运算符" 且 词值() == "," 循环
            前进()
            追加(参数, 解析或())
        结束
        返回 {"类型":"函数调用", "被调者":左, "参数":参数}
    结束
    返回 左
结束

# ============================================================
# 导出入口
# ============================================================

# token 列表 → AST 程序节点
函数 语法分析(列表 tokens) -> 字典
    g_tokens = tokens
    g_pos = 0
    g_括号深度 = 0
    列表 语句表 = []
    当 词类() != "文件结束" 循环
        让 st = 解析语句()
        若 st != 空
            追加(语句表, st)
        结束
    结束
    返回 {"类型":"程序", "语句":语句表}
结束

# 源码字符串 → AST 程序节点（先词法，再语法）
函数 解析源(字符串 源) -> 字典
    列表 tokens = 词法分析(源)
    返回 语法分析(tokens)
结束

# ============================================================
# 匹配（模式匹配）语句
#
#   匹配 表达式
#       是 模式1:
#           语句1
#       是 90 到 100:      # 范围模式
#           语句
#       是 n:              # 标识符模式（通配绑定 n）
#           语句
#       默认:
#           默认语句
#   结束
#   单行：匹配 x 是 1: "一" 是 2: "二" 默认: "其他" 结束
#
# AST：{"类型":"匹配", "表达式":节点, "分支":[{"模式":节点|空, "体":[...], "是否默认":0|1}]}
# 范围节点：{"类型":"范围", "起点":节点, "终点":节点}
# ============================================================

# 当前 token 是否为 匹配 分支头（是 / 情况 / 默认）
函数 是匹配分支头() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "是" 或 词值() == "情况" 或 词值() == "默认"
结束

# 匹配 表达式 ... 结束
函数 解析匹配() -> 字典
    前进()  # 吃掉 匹配
    字典 匹配值节点 = 解析或()
    列表 分支 = []
    当 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        若 非 是匹配分支头()
            跳出
        结束
        字典 arm = 解析匹配分支()
        追加(分支, arm)
    结束
    若 非 是结束()
        报错("匹配 语句缺少 结束")
    结束
    前进()  # 吃掉 结束
    返回 {"类型":"匹配", "表达式":匹配值节点, "分支":分支}
结束

# 解析单个分支：是 模式: 体 ／ 默认: 体
# 模式：先解析一个表达式；若其后紧跟关键字「到」则构成范围模式
函数 解析匹配分支() -> 字典
    整数 默认标志 = 0
    让 模式节点 = 空
    若 词值() == "默认"
        默认标志 = 1
        前进()
    否则
        前进()  # 吃掉 是
        字典 首 = 解析或()
        若 词类() == "关键字" 且 词值() == "到"
            前进()
            字典 尾 = 解析或()
            模式节点 = {"类型":"范围", "起点":首, "终点":尾}
        否则
            模式节点 = 首
        结束
    结束
    # 冒号可选（块式与单行式都带；容错起见缺省也允许）
    若 词类() == "运算符" 且 词值() == ":"
        前进()
    结束
    列表 体 = 解析匹配分支体()
    返回 {"模式":模式节点, "体":体, "是否默认":默认标志}
结束

# 解析一个分支体：块形式（冒号后换行 → 收集多条语句）
# 或单行形式（冒号后同行 → 仅取一条语句）
函数 解析匹配分支体() -> 列表
    列表 体 = []
    若 词类() == "换行"
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 是匹配分支头() 或 是结束()
                跳出
            结束
            让 st = 解析语句()
            若 st != 空
                追加(体, st)
            结束
        结束
    否则
        跳过换行()
        若 非 (是匹配分支头() 或 是结束())
            让 st = 解析语句()
            若 st != 空
                追加(体, st)
            结束
        结束
    结束
    返回 体
结束

# ============================================================
# 并发 / 等待（协作式多任务）
#
#   并发 表达式            → {"类型":"并发","表达式":节点}
#   并发                   → 块形式：换行后接语句块直到 结束，
#                            表达式字段包成 {"类型":"程序","语句":[...]}
#   等待 任务             → {"类型":"等待","表达式":节点}（紧绑定一个后缀表达式）
# ============================================================

# 解析 并发：块形式（换行后收集语句直到 结束）或表达式形式
函数 解析并发任务() -> 字典
    前进()  # 吃掉 并发
    # 块形式：并发 之后紧跟换行
    若 词类() == "换行"
        列表 体语句 = []
        当 非 是结束() 且 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            让 st = 解析语句()
            若 st != 空
                追加(体语句, st)
            结束
        结束
        若 非 是结束()
            报错("并发 块缺少 结束")
        结束
        前进()  # 吃掉 结束
        字典 体 = {"类型":"程序", "语句":体语句}
        返回 {"类型":"并发", "表达式":体}
    结束
    # 表达式形式：并发 后面是一个完整表达式
    字典 e = 解析或()
    返回 {"类型":"并发", "表达式":e}
结束

# 解析 等待：紧绑定一个后缀表达式（任务句柄/带括号/带下标），
# 不吞掉整个剩余表达式，以便 等待 A + 等待 B 被解析为两个独立等待相加。
函数 解析等待任务() -> 字典
    前进()  # 吃掉 等待
    字典 e = 解析后缀()
    返回 {"类型":"等待", "表达式":e}
结束

# 解析匿名函数字面量：函数(参数) [-> 返回类型] 体 ... 结束
# 与 解析函数定义 的区别：不解析函数名，产出 "函数字面量" 节点而非 "函数定义"
函数 解析匿名函数() -> 字典
    前进()  # 吃掉 函数
    期望运算符("(")
    跳过换行()
    列表 参数 = []
    列表 参数类型 = []
    列表 参数默认 = []
    若 非 (词类() == "运算符" 且 词值() == ")")
        当 非 (词类() == "运算符" 且 词值() == ")") 且 词类() != "文件结束" 循环
            跳过换行()
            字符串 pt = ""
            若 是类型标注(词值())
                pt = 词值()
                前进()
            结束
            # 可变参数前缀：...名
            整数 可变标记 = 0
            若 词类() == "运算符" 且 词值() == "..."
                可变标记 = 1
                前进()
            结束
            若 词类() != "标识符" 且 非 (词类() == "关键字" 且 (词值() == "self" 或 词值() == "自己"))
                报错("函数参数需要标识符")
            结束
            追加(参数, 词值())
            若 可变标记 == 1
                追加(参数类型, "可变")
            否则
                追加(参数类型, pt)
            结束
            前进()
            # 默认参数：名 = 表达式
            让 默认值 = 空
            若 词类() == "运算符" 且 词值() == "="
                前进()
                默认值 = 解析或()
            结束
            追加(参数默认, 默认值)
            若 词类() == "运算符" 且 词值() == ","
                前进()
                跳过换行()
            结束
            跳过换行()
        结束
    结束
    期望运算符(")")
    字符串 返回类型 = ""
    若 词类() == "运算符" 且 词值() == "->"
        前进()
        若 是返回类型标注(词值())
            返回类型 = 词值()
            前进()
        否则
            报错("函数返回类型标注无效")
        结束
    结束
    # 箭头匿名函数单行体：函数(...) => 表达式 （隐式返回，免写 结束）
    若 词类() == "运算符" 且 词值() == "=>"
        前进()
        字典 返回值 = 解析或()
        列表 箭头体 = [{"类型":"返回", "值":返回值}]
        字典 箭头程序 = {"类型":"程序", "语句":箭头体}
        返回 {"类型":"函数字面量", "名字":"", "参数":参数, "参数类型":参数类型, "参数默认":参数默认, "返回类型":返回类型, "体":箭头程序}
    结束
    列表 体语句 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        让 st = 解析语句()
        若 st != 空
            追加(体语句, st)
        结束
    结束
    若 非 是结束()
        报错("匿名函数缺少 结束")
    结束
    前进()
    字典 体 = {"类型":"程序", "语句":体语句}
    返回 {"类型":"函数字面量", "名字":"", "参数":参数, "参数类型":参数类型, "参数默认":参数默认, "返回类型":返回类型, "体":体}
结束

# ============================================================
# 枚举（新增，追加在文件末尾）
#
#   块形式：
#       枚举 颜色
#           红
#           绿
#           蓝
#       结束
#   单行形式：枚举 颜色 { 红, 绿, 蓝 }
#
# AST：{"类型":"枚举", "名字":"颜色", "成员":["红","绿","蓝"]}
# 求值时注册为字典：{"__枚举__":1, "红":0, "绿":1, "蓝":2}
# 访问 颜色.红 → 下标访问 颜色["红"] = 0
# ============================================================
函数 解析枚举() -> 字典
    前进()  # 吃掉 枚举
    若 词类() != "标识符"
        报错("枚举定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    列表 成员 = []
    # 单行形式：枚举 名字 { 成员, 成员, ... }
    若 词类() == "运算符" 且 词值() == "{"
        前进()
        当 非 (词类() == "运算符" 且 词值() == "}") 且 词类() != "文件结束" 循环
            若 词类() != "标识符"
                报错("枚举成员需要标识符")
            结束
            追加(成员, 词值())
            前进()
            若 词类() == "运算符" 且 词值() == ","
                前进()
            结束
        结束
        期望运算符("}")
        返回 {"类型":"枚举", "名字":名, "成员":成员}
    结束
    # 块形式：换行后成员标识符列表，直到 结束
    当 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        若 是结束()
            跳出
        结束
        若 词类() == "标识符"
            追加(成员, 词值())
            前进()
            # 允许成员行尾逗号
            若 词类() == "运算符" 且 词值() == ","
                前进()
            结束
            继续
        结束
        报错("枚举成员需要标识符")
    结束
    若 非 是结束()
        报错("枚举 块缺少 结束")
    结束
    前进()  # 吃掉 结束
    返回 {"类型":"枚举", "名字":名, "成员":成员}
结束

# ============================================================
# 结构体（新增，追加在文件末尾）
#
#   结构体 点
#       浮点 x
#       浮点 y
#   结束
#
# AST：{"类型":"结构体定义", "名字":"点", "字段":["x","y"]}
# 求值时注册构造函数值；结构体名(3,4) → 实例字典
# 字段访问/赋值复用已有 . 下标（p.x → p["x"]）
# ============================================================
函数 解析结构体() -> 字典
    前进()  # 吃掉 结构体
    若 词类() != "标识符"
        报错("结构体定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    列表 字段 = []
    当 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        若 是结束()
            跳出
        结束
        # 可选类型标注（浮点 x / 整数 y ...），仅作文档用途
        若 是类型标注(词值())
            前进()
        结束
        若 词类() != "标识符"
            报错("结构体字段需要标识符")
        结束
        追加(字段, 词值())
        前进()
        # 允许字段行尾逗号
        若 词类() == "运算符" 且 词值() == ","
            前进()
        结束
    结束
    若 非 是结束()
        报错("结构体 块缺少 结束")
    结束
    前进()  # 吃掉 结束
    返回 {"类型":"结构体定义", "名字":名, "字段":字段}
结束

# ============================================================
# 类（OOP，新增，追加在文件末尾）
#
#   类 动物
#       让 名字 = ""
#       函数 构造(字符串 n)
#           self.名字 = n
#       结束
#       函数 说话()
#           输出 self.名字 + "发出声音"
#       结束
#   结束
#
#   类 狗 继承 动物
#       函数 说话()
#           输出 self.名字 + "汪汪汪"
#       结束
#   结束
#
# AST：{"类型":"类定义", "名字":"动物", "父类":"",
#        "字段":[变量声明节点,...], "方法":[函数定义节点,...]}
# 求值时注册：
#   - 类注册表[类名] = 类对象 {"类型":"类","名字":..,"父类":..,"方法":{名:fn},"字段":[{名,默认}],"环境":..}
#   - 环境中声明 类名 = {"类型":"类构造器","类名":..}
#   - 实例化：类名(实参) → 实例字典 {"类型":"对象","类名":.., 字段名:值...}
# ============================================================

# 当前 token 是否为「类字段声明头」（让/变量/常量 或 类型标注关键字）
函数 是字段声明头() -> 布尔
    如果 词类() != "关键字" 则
        返回 假
    结束
    让 k = 词值()
    如果 k == "让" 或 k == "变量" 或 k == "常量" 则
        返回 真
    结束
    返回 是类型关键字(k)
结束

# 类 名 [继承[自] 父类] 体 结束
# 体内：字段声明（让/变量）与方法定义（函数），方法内 self/super 由 解析主要 处理
函数 解析类定义() -> 字典
    前进()  # 吃掉 类
    如果 词类() != "标识符" 则
        报错("类定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    # ---- 可选父类：继承 父类名 ／ 继承自 父类名 ----
    字符串 父类 = ""
    如果 词类() == "关键字" 且 (词值() == "继承" 或 词值() == "继承自") 则
        前进()
        如果 词类() != "标识符" 则
            报错("类继承需要父类名")
        结束
        父类 = 词值()
        前进()
    结束
    # ---- 类体：字段声明 + 方法定义 ----
    列表 字段 = []
    列表 方法 = []
    当 词类() != "文件结束" 循环
        如果 词类() == "换行" 则
            前进()
            继续
        结束
        如果 是结束() 则
            跳出
        结束
        # 方法：函数 名(...) ... 结束
        如果 词类() == "关键字" 且 词值() == "函数" 则
            追加(方法, 解析函数定义())
            继续
        结束
        # 字段：让/变量/常量 [类型] 名 [= 默认值]
        如果 是字段声明头() 则
            追加(字段, 解析变量声明())
            继续
        结束
        报错("类体内只允许字段声明（让）与方法定义（函数）")
    结束
    如果 非 是结束() 则
        报错("类 块缺少 结束")
    结束
    前进()  # 吃掉 结束
    返回 {"类型":"类定义", "名字":名, "父类":父类, "字段":字段, "方法":方法}
结束
