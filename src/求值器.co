# ============================================================
# 协作式并发（并发 / 等待）—— 本块在文件末尾追加，不改动已有逻辑
#
# 模型：单线程树遍历解释器上的协作式多任务。
#   并发 表达式  → 创建任务字典并入队，立即返回句柄（不执行）；
#   等待 任务    → 已完成则返回缓存结果；待运行则在当前线程协作式执行。
# 任务字典：{"类型":"任务","状态":"待运行|已完成","表达式":AST,"结果":值,"环境":创建时环境}
# ============================================================

# 全局任务队列（协作式执行下主要用于登记；未来真线程并发在此调度）
让 任务队列 = []

# 执行一个待运行任务：以任务捕获的环境为父建子环境，跑表达式节点或语句块节点
函数 执行任务(任务)
    让 体 = 任务["表达式"]
    让 子 = {"变量": [{}], "父": 任务["环境"]}
    让 结果值 = 空
    # 块形式：表达式字段是一个程序节点 {"类型":"程序","语句":[...]}
    如果 体["类型"] == "程序" 则
        让 r = 执行块(体["语句"], 子)
        如果 是异常(r) 则
            任务["状态"] = "已完成"
            任务["结果"] = r
            返回 r
        结束
        如果 是控制(r) 且 r["__控制__"] == "返回" 则
            结果值 = r["值"]
        否则
            结果值 = 0
        结束
    否则
        # 表达式形式：直接求值
        让 v = 求值(体, 子)
        如果 是异常(v) 则
            任务["状态"] = "已完成"
            任务["结果"] = v
            返回 v
        结束
        结果值 = v
    结束
    任务["状态"] = "已完成"
    任务["结果"] = 结果值
    返回 结果值
结束

# 等待一个任务句柄：已完成直接返回缓存结果（不重复执行）；待运行则协作式执行
函数 等待任务(任务)
    如果 类型(任务) != "字典" 或 非 包含(任务, "类型") 则
        返回 造异常("等待 需要一个任务句柄")
    结束
    如果 任务["类型"] != "任务" 则
        返回 造异常("等待 的对象不是任务")
    结束
    如果 任务["状态"] == "已完成" 则
        返回 任务["结果"]
    结束
    返回 执行任务(任务)
结束

# ============================================================
# for-each 遍历（新增，追加在文件末尾）
#   对于 元素 在/于 容器 循环 ... 结束
# 支持：列表(逐个元素)、字符串(逐字符)、字典(逐键)、元组(逐元素)。
# 快照迭代：先求值容器并取长度/键表，循环期间对容器的修改不影响本次遍历。
# ============================================================
函数 执行对于遍历(语句, 环境)
    让 容器值 = 求值(语句["遍历源"], 环境)
    如果 是异常(容器值) 则 返回 容器值
    让 变量名 = 语句["变量"]
    让 体语句 = 语句["体"]
    让 容器类型 = 类型(容器值)

    # 元组：自定义类型标记 → 迭代内部元素
    如果 容器类型 == "字典" 且 包含(容器值, "类型") 且 容器值["类型"] == "元组" 则
        让 elems = 容器值["元素"]
        对于 i 从 0 到 长度(elems) - 1 循环
            声明变量(环境, 变量名, elems[i])
            让 r = 执行块(体语句, 环境)
            如果 是异常(r) 则 返回 r
            如果 是控制(r) 则
                让 标签 = r["__控制__"]
                如果 标签 == "返回" 则 返回 r
                如果 标签 == "跳出" 则 返回 0
            结束
        结束
        返回 0
    结束

    # 字典：迭代键
    如果 容器类型 == "字典" 则
        让 键表 = 键(容器值)
        对于 k 从 0 到 长度(键表) - 1 循环
            声明变量(环境, 变量名, 键表[k])
            让 r = 执行块(体语句, 环境)
            如果 是异常(r) 则 返回 r
            如果 是控制(r) 则
                让 标签 = r["__控制__"]
                如果 标签 == "返回" 则 返回 r
                如果 标签 == "跳出" 则 返回 0
            结束
        结束
        返回 0
    结束

    # 列表 / 字符串：按下标迭代（字符串逐项为单字符）
    让 n = 长度(容器值)
    对于 i 从 0 到 n - 1 循环
        声明变量(环境, 变量名, 容器值[i])
        让 r = 执行块(体语句, 环境)
        如果 是异常(r) 则 返回 r
        如果 是控制(r) 则
            让 标签 = r["__控制__"]
            如果 标签 == "返回" 则 返回 r
            如果 标签 == "跳出" 则 返回 0
        结束
    结束
    返回 0
结束

# ============================================================
# OOP 运行时支持（追加在文件末尾）
#
# 数据约定：
#   类对象  : {"类型":"类","名字":类名,"父类":父类名,"方法":{方法名:函数值},
#              "字段":[{"名字":..,"默认":节点}],"环境":定义环境}
#   实例    : {"类型":"对象","类名":类名, 字段名:值 ...}
#   绑定方法: {"类型":"绑定方法","实例":obj,"方法":fn,"定义类":定义该方法的类名}
#   超对象  : {"类型":"超对象","起始类":当前方法所在类名}
# ============================================================

# 把「类参数」规范化为类名字符串。
# 入参可为类名字符串，也可为类构造器 {"类名":..} 或类对象 {"名字":..}。
函数 规范类名(类参数) -> 字符串
    如果 类参数 == 空 则
        返回 ""
    结束
    如果 类型(类参数) == "字符串" 则
        返回 类参数
    结束
    如果 类型(类参数) == "字典" 则
        如果 包含(类参数, "类名") 则
            返回 类参数["类名"]
        结束
        如果 包含(类参数, "名字") 则
            返回 类参数["名字"]
        结束
    结束
    返回 ""
结束

# 取父类名(类) → 字符串：返回该类的父类名；未注册/无父类返回 ""
函数 取父类名(类参数) -> 字符串
    让 类名 = 规范类名(类参数)
    如果 类名 == "" 则
        返回 ""
    结束
    如果 非 包含(类注册表, 类名) 则
        返回 ""
    结束
    让 父 = 类注册表[类名]["父类"]
    如果 父 == 空 则
        返回 ""
    结束
    返回 父
结束

# 沿继承链查找方法：从 类名 起向上找第一个拥有 方法名 的类。
# 命中返回 {"fn":函数值, "类名":定义该方法的类}；未找到返回异常信号。
函数 查找方法对象(类名, 方法名)
    让 当前 = 类名
    当 当前 != "" 且 当前 != 空 循环
        如果 非 包含(类注册表, 当前) 则
            返回 造异常("未定义的类: " + 转字符串(当前))
        结束
        让 类对象 = 类注册表[当前]
        如果 包含(类对象["方法"], 方法名) 则
            返回 {"fn": 类对象["方法"][方法名], "类名": 当前}
        结束
        当前 = 类对象["父类"]
    结束
    返回 造异常("找不到方法: " + 转字符串(方法名))
结束

# 递归初始化实例字段：先父类后子类（子类默认值覆盖父类同名字段）。
# 字段默认节点在类定义环境中求值，保证每个实例拿到独立值。
函数 初始化字段链(实例, 类名)
    如果 类名 == "" 或 类名 == 空 则
        返回 0
    结束
    如果 非 包含(类注册表, 类名) 则
        返回 造异常("未定义的类: " + 转字符串(类名))
    结束
    让 类对象 = 类注册表[类名]
    让 父类名 = 类对象["父类"]
    # 先初始化父类字段
    如果 父类名 != "" 且 父类名 != 空 则
        让 r = 初始化字段链(实例, 父类名)
        如果 是异常(r) 则 返回 r
    结束
    # 再初始化本类字段
    让 字段表 = 类对象["字段"]
    对于 i 从 0 到 长度(字段表) - 1 循环
        让 fd = 字段表[i]
        让 v = 0
        如果 是节点(fd["默认"]) 则
            v = 求值(fd["默认"], 类对象["环境"])
            如果 是异常(v) 则 返回 v
        结束
        实例[fd["名字"]] = v
    结束
    返回 0
结束

# 调用一个方法：以 self=实例 建立方法环境，绑定形参，执行方法体。
# 形参处理：若首个形参名为 self/自己，则绑定为实例且不消费实参；其余形参按序取实参。
# 同时在方法环境中声明 self/自己（别名）与 __当前类__（供 super 向上查找）。
函数 调用方法函数(fn, 实例, 定义类名, 实参)
    让 子 = {"变量": [{}], "父": fn["闭包"]}
    声明变量(子, "self", 实例)
    声明变量(子, "自己", 实例)
    声明变量(子, "__当前类__", 定义类名)
    让 形参 = fn["参数"]
    让 形参类型 = fn["参数类型"]
    让 默认表 = fn["参数默认"]
    让 n形参 = 长度(形参)
    让 n实参 = 长度(实参)
    让 ai = 0
    对于 i 从 0 到 n形参 - 1 循环
        让 名 = 形参[i]
        # self/自己 形参：绑定为当前实例，不消费实参
        如果 名 == "self" 或 名 == "自己" 则
            声明变量(子, 名, 实例)
            继续
        结束
        让 标注 = ""
        如果 类型(形参类型) == "列表" 且 i < 长度(形参类型) 则
            标注 = 形参类型[i]
        结束
        # 可变参数：把第 ai 个实参起全部打包成列表
        如果 标注 == "可变" 则
            让 打包 = []
            对于 j 从 ai 到 n实参 - 1 循环
                追加(打包, 实参[j])
            结束
            声明变量(子, 名, 打包)
            ai = n实参
            继续
        结束
        # 普通形参：按实参序绑定；缺省则用默认值或 0
        如果 ai < n实参 则
            声明变量(子, 名, 实参[ai])
            ai = ai + 1
        否则
            让 用默认 = 0
            如果 类型(默认表) == "列表" 且 i < 长度(默认表) 则
                如果 是节点(默认表[i]) 则
                    用默认 = 1
                结束
            结束
            如果 用默认 == 1 则
                # 默认表达式在【被调作用域】求值：子环境以 fn["闭包"] 为父，
                # 闭包变量照样可见，差别只在「前一个形参」可见（f(a, b = a + 1)）。
                # 字节码通道在函数序言里求默认值，那时形参槽已落位、天然看得见；
                # 两通道必须同义，否则 标准库 的 断言相等(实际, 期望, 说明="") 分叉。
                让 dval = 求值(默认表[i], 子)
                如果 是异常(dval) 则 返回 dval
                声明变量(子, 名, dval)
            否则
                声明变量(子, 名, 0)
            结束
        结束
    结束
    让 结果 = 执行块(fn["体"]["语句"], 子)
    如果 是异常(结果) 则
        返回 结果
    结束
    如果 是控制(结果) 且 结果["__控制__"] == "返回" 则
        返回 结果["值"]
    结束
    返回 0
结束

# 实例化一个类：建实例字典 → 初始化继承链字段 → 调用构造函数。
函数 实例化类(类名, 实参)
    如果 非 包含(类注册表, 类名) 则
        返回 造异常("未定义的类: " + 转字符串(类名))
    结束
    让 实例 = {"类型": "对象", "类名": 类名}
    让 r = 初始化字段链(实例, 类名)
    如果 是异常(r) 则 返回 r
    让 查找 = 查找方法对象(类名, "构造")
    # 无构造函数：若未传实参则直接返回；传了实参则报错
    如果 是异常(查找) 则
        如果 长度(实参) > 0 则
            返回 造异常("类 " + 转字符串(类名) + " 没有构造函数，但传入了 " + 转字符串(长度(实参)) + " 个参数")
        结束
        返回 实例
    结束
    让 cr = 调用方法函数(查找["fn"], 实例, 查找["类名"], 实参)
    如果 是异常(cr) 则 返回 cr
    返回 实例
结束

# 是实例(obj, 类) → 0/1：obj 是否为 类 或其子类的实例（沿继承链）
# 类 可为类名字符串或类引用（类构造器/类对象）。
函数 是实例值(obj, 类参数) -> 整数
    如果 类型(obj) != "字典" 则
        返回 0
    结束
    如果 非 包含(obj, "类型") 则
        返回 0
    结束
    如果 obj["类型"] != "对象" 则
        返回 0
    结束
    让 目标 = 规范类名(类参数)
    让 当前 = obj["类名"]
    当 当前 != "" 且 当前 != 空 循环
        如果 当前 == 目标 则
            返回 1
        结束
        当前 = 取父类名(当前)
    结束
    返回 0
结束
