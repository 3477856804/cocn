# 创建根环境
函数 新建环境() -> 字典
    让 env = {"变量": [{}], "父": 空}
    注册内置(env)
    注册张量内置(env)
    返回 env
结束

# 一站式运行：解析源 -> 执行
函数 运行(字符串 源)
    导入 "语法分析器"
    让 ast = 解析源(源)
    让 env = 新建环境()
    提升顶层函数(ast["语句"], env)
    让 r = 执行块(ast["语句"], env)
    如果 是异常(r) 则
        打印异常(r["__异常__"])
        返回 r
    结束
    返回 0
结束

# ---------------- 匹配（模式匹配）执行 ----------------

# 判断节点是否为「纯表达式节点」（可作为表达式语句的取值）。
# 语句节点（赋值/声明/控制流/块等）没有「值」，返回 0。
函数 是表达式节点(节点)
    如果 是节点(节点) 则
        让 t = 节点["类型"]
        如果 t == "字面量" 或 t == "标识符" 或 t == "二元" 或 t == "一元" 或 t == "下标" 或 t == "列表字面量" 或 t == "字典字面量" 或 t == "函数调用" 或 t == "匹配" 则
            返回 1
        结束
    结束
    返回 0
结束

# 执行一个命中分支的体：逐条执行语句。
# 返回 异常信号 / 控制信号；否则返回末条纯表达式语句的值。
# 语句上下文忽略该返回值；表达式上下文（匹配作为值）取用它。
# 末条语句直接经 求值 执行一次，保证每句恰好执行一次、无副作用重复。
函数 执行匹配分支值(分支体, 环境)
    让 n = 长度(分支体)
    让 结果 = 0
    对于 j 从 0 到 n - 1 循环
        让 st = 分支体[j]
        如果 j == n - 1 且 是表达式节点(st) 则
            让 v = 求值(st, 环境)
            如果 是异常(v) 则 返回 v
            结果 = v
        否则
            让 r = 执行语句(st, 环境)
            如果 是异常(r) 则 返回 r
            如果 是控制(r) 则 返回 r
        结束
    结束
    返回 结果
结束

# 执行 匹配 节点：
#   1. 求值被匹配表达式
#   2. 按序检查分支：字面量相等 / 范围区间[起点,终点] / 标识符通配绑定 / 默认
#   3. 执行首个命中分支的体（返回其取值）
#   4. 无命中且无默认 → 报错
函数 执行匹配(语句, 环境)
    让 匹配值 = 求值(语句["表达式"], 环境)
    如果 是异常(匹配值) 则 返回 匹配值
    让 分支 = 语句["分支"]
    让 匹配了 = 0
    对于 i 从 0 到 长度(分支) - 1 循环
        让 br = 分支[i]
        让 命中 = 0
        让 分支环境 = 环境
        如果 br["是否默认"] == 1 则
            命中 = 1
        否则
            让 模式 = br["模式"]
            让 mt = 模式["类型"]
            如果 mt == "范围" 则
                让 s = 求值(模式["起点"], 环境)
                如果 是异常(s) 则 返回 s
                让 e = 求值(模式["终点"], 环境)
                如果 是异常(e) 则 返回 e
                如果 匹配值 >= s 且 匹配值 <= e 则
                    命中 = 1
                结束
            结束
            如果 mt == "标识符" 则
                # 通配模式：总是匹配，把被匹配值绑定到该变量（分支体子环境中可见）
                分支环境 = {"变量": [{}], "父": 环境}
                声明变量(分支环境, 模式["名字"], 匹配值)
                命中 = 1
            结束
            如果 mt != "范围" 且 mt != "标识符" 则
                # 字面量/其它表达式模式：求值后比较相等
                让 pv = 求值(模式, 环境)
                如果 是异常(pv) 则 返回 pv
                如果 匹配值 == pv 则
                    命中 = 1
                结束
            结束
        结束
        如果 命中 == 1 则
            匹配了 = 1
            返回 执行匹配分支值(br["体"], 分支环境)
        结束
    结束
    如果 匹配了 == 0 则
        返回 造异常("匹配失败：没有任何分支匹配，且无默认分支（被匹配值=" + 转字符串(匹配值) + "）")
    结束
    返回 0
结束

# ============================================================
# 张量子系统（自解释器内用 coCN 列表操作实现）
# 张量值: {"类型":"张量","数据":扁平列表,"形状":[...],"维度":n}
# 行主序（C 顺序）存储。本块在文件末尾追加，不改动已有逻辑。
# ============================================================

# ---- 内部工具 ----

# 嵌套列表 -> 形状列表（标量返回空列表）
函数 张形状(嵌套)
    如果 类型(嵌套) != "列表" 则
        返回 []
    结束
    让 n = 长度(嵌套)
    如果 n == 0 则
        返回 [0]
    结束
    返回 [n] + 张形状(嵌套[0])
结束

# 嵌套列表展平并追加到 out
函数 张展平(嵌套, out)
    如果 类型(嵌套) != "列表" 则
        追加(out, 嵌套)
        返回 out
    结束
    对于 i 从 0 到 长度(嵌套) - 1 循环
        张展平(嵌套[i], out)
    结束
    返回 out
结束

# 形状 -> 元素总数
函数 张元素数(形状)
    让 p = 1
    对于 i 从 0 到 长度(形状) - 1 循环
        p = p * 形状[i]
    结束
    返回 p
结束

# 从嵌套列表构造张量
函数 张构造(嵌套)
    让 形状 = 张形状(嵌套)
    让 扁平 = []
    张展平(嵌套, 扁平)
    # 宿主张量对象自带 requires_grad/grad/om/ov 字段（初值 0/NULL），
    # 层的字典必须同样带齐，否则 优化 里 p["需梯度"] 取到的是缺失值，
    # 判断走空——又是一次「跑得通但不动」。
    返回 {"类型":"张量","数据":扁平,"形状":形状,"维度":长度(形状),
        "需梯度": 0, "梯度": "-", "父": "-", "动量": "-", "一阶矩": "-", "二阶矩": "-", "步数": 0}
结束

# 判断张量数据是否全为整数
函数 张全整(t)
    让 d = t["数据"]
    对于 i 从 0 到 长度(d) - 1 循环
        如果 类型(d[i]) == "浮点" 则
            返回 0
        结束
    结束
    返回 1
结束

# ---- 索引互转 ----

# 形状 + 多维索引列表 -> 行主序扁平偏移
函数 索引转扁平(形状, 索引列表)
    让 n = 长度(形状)
    让 偏移 = 0
    让 间距 = 1
    对于 i 从 n - 1 到 0 步长 -1 循环
        偏移 = 偏移 + 索引列表[i] * 间距
        间距 = 间距 * 形状[i]
    结束
    返回 偏移
结束

# 形状 + 扁平偏移 -> 多维索引列表
函数 扁平转索引(形状, 扁平索引)
    让 n = 长度(形状)
    让 间距表 = []
    让 累 = 1
    对于 i 从 n - 1 到 0 步长 -1 循环
        间距表 = [累] + 间距表
        累 = 累 * 形状[i]
    结束
    让 索引 = []
    让 剩余 = 扁平索引
    对于 i 从 0 到 n - 1 循环
        让 v = 截断(剩余 / 间距表[i])
        追加(索引, v)
        剩余 = 剩余 - v * 间距表[i]
    结束
    返回 索引
结束

# ---- 广播 ----

# 两形状广播后的结果形状；不兼容返回 空
函数 张广播形(形状A, 形状B)
    让 na = 长度(形状A)
    让 nb = 长度(形状B)
    让 结果 = []
    让 i = 0
    当 (i < na) 或 (i < nb) 循环
        让 da = 1
        让 db = 1
        如果 i < na 则 da = 形状A[na - 1 - i] 结束
        如果 i < nb 则 db = 形状B[nb - 1 - i] 结束
        如果 da != db 且 da != 1 且 db != 1 则
            返回 空
        结束
        让 d = da
        如果 db > d 则 d = db 结束
        结果 = [d] + 结果
        i = i + 1
    结束
    返回 结果
结束

# 按结果坐标在源张量中取值（支持维度为 1 的广播）
函数 张广播取(源, 结果形状, 目标坐标)
    让 s形状 = 源["形状"]
    让 nr = 长度(结果形状)
    让 ns = 长度(s形状)
    让 对齐 = nr - ns
    让 源坐标 = []
    对于 sa 从 0 到 ns - 1 循环
        让 目标轴 = sa + 对齐
        让 sv = 目标坐标[目标轴]
        如果 s形状[sa] == 1 则
            sv = 0
        结束
        追加(源坐标, sv)
    结束
    返回 源["数据"][索引转扁平(s形状, 源坐标)]
结束

# 逐元素二元运算（支持广播）
函数 张元二元(A, B, 符号)
    让 结果形状 = 张广播形(A["形状"], B["形状"])
    如果 结果形状 == 空 则
        返回 造异常("张量形状不兼容，无法广播")
    结束
    让 总数 = 张元素数(结果形状)
    让 新数据 = []
    对于 flat 从 0 到 总数 - 1 循环
        让 坐标 = 扁平转索引(结果形状, flat)
        让 a = 张广播取(A, 结果形状, 坐标)
        让 b = 张广播取(B, 结果形状, 坐标)
        让 r = 0.0
        如果 符号 == "+" 则 r = 转浮点(a) + 转浮点(b) 结束
        如果 符号 == "-" 则 r = 转浮点(a) - 转浮点(b) 结束
        如果 符号 == "*" 则 r = 转浮点(a) * 转浮点(b) 结束
        如果 符号 == "/" 则 r = 转浮点(a) / 转浮点(b) 结束
        追加(新数据, r)
    结束
    如果 张全整(A) 且 张全整(B) 且 符号 != "/" 则
        让 整数据 = []
        对于 i 从 0 到 总数 - 1 循环
            追加(整数据, 转整数(新数据[i]))
        结束
        新数据 = 整数据
    结束
    返回 {"类型":"张量","数据":新数据,"形状":结果形状,"维度":长度(结果形状)}
结束

# 张量与标量二元运算
函数 张标二元(T, s, 符号)
    让 d = T["数据"]
    让 新 = []
    对于 i 从 0 到 长度(d) - 1 循环
        让 r = 0.0
        如果 符号 == "+" 则 r = 转浮点(d[i]) + 转浮点(s) 结束
        如果 符号 == "*" 则 r = 转浮点(d[i]) * 转浮点(s) 结束
        追加(新, r)
    结束
    如果 张全整(T) 且 类型(s) != "浮点" 则
        让 整 = []
        对于 i 从 0 到 长度(新) - 1 循环
            追加(整, 转整数(新[i]))
        结束
        新 = 整
    结束
    返回 {"类型":"张量","数据":新,"形状":T["形状"],"维度":T["维度"]}
结束

# ---- 矩阵运算 ----

# 矩阵乘法 A(m×n) × B(n×p) = C(m×p)
函数 张矩阵乘(A, B)
    让 sa = A["形状"]
    让 sb = B["形状"]
    让 m = sa[0]
    让 n = sa[1]
    让 p = sb[1]
    让 C = []
    对于 i 从 0 到 m - 1 循环
        对于 j 从 0 到 p - 1 循环
            让 s = 0.0
            对于 k 从 0 到 n - 1 循环
                s = s + 转浮点(A["数据"][i * n + k]) * 转浮点(B["数据"][k * p + j])
            结束
            追加(C, s)
        结束
    结束
    如果 张全整(A) 且 张全整(B) 则
        让 整 = []
        对于 i 从 0 到 长度(C) - 1 循环
            追加(整, 转整数(C[i]))
        结束
        C = 整
    结束
    返回 {"类型":"张量","数据":C,"形状":[m, p],"维度":2}
结束

# 转置：2维交换两维；更高维交换最后两维
函数 张转置(T)
    让 形状 = T["形状"]
    让 n = 长度(形状)
    如果 n < 2 则
        返回 T
    结束
    让 新形状 = 切片(形状, 0, n - 2) + [形状[n - 1], 形状[n - 2]]
    让 总数 = 张元素数(新形状)
    让 新数据 = []
    对于 flat 从 0 到 总数 - 1 循环
        让 coord = 扁平转索引(新形状, flat)
        让 tmp = coord[n - 2]
        coord[n - 2] = coord[n - 1]
        coord[n - 1] = tmp
        追加(新数据, T["数据"][索引转扁平(形状, coord)])
    结束
    返回 {"类型":"张量","数据":新数据,"形状":新形状,"维度":n}
结束

# 行列式（Laplace 递归展开），数据为 n×n 行主序扁平列表
函数 张行列式(数据, n)
    如果 n == 1 则
        返回 数据[0]
    结束
    如果 n == 2 则
        返回 数据[0] * 数据[3] - 数据[1] * 数据[2]
    结束
    让 总和 = 0.0
    对于 j 从 0 到 n - 1 循环
        让 小数据 = []
        对于 r 从 1 到 n - 1 循环
            对于 c 从 0 到 n - 1 循环
                如果 c != j 则
                    追加(小数据, 数据[r * n + c])
                结束
            结束
        结束
        让 符号 = 1
        如果 (j % 2) == 1 则
            符号 = -1
        结束
        总和 = 总和 + 符号 * 转浮点(数据[j]) * 转浮点(张行列式(小数据, n - 1))
    结束
    返回 总和
结束

# 迹：主对角线元素之和
函数 张迹(T)
    让 形状 = T["形状"]
    让 n = 形状[0]
    让 s = 0.0
    对于 i 从 0 到 n - 1 循环
        s = s + 转浮点(T["数据"][i * 形状[1] + i])
    结束
    返回 s
结束

# ---- 索引与切片 ----

# 多维索引：索引列表长度 k，取前 k 维固定后的子张量/标量
函数 张索引取(T, 索引列表)
    让 形状 = T["形状"]
    让 k = 长度(索引列表)
    让 n = 长度(形状)
    让 间距 = 1
    对于 q 从 n - 1 到 k 步长 -1 循环
        间距 = 间距 * 形状[q]
    结束
    让 base = 0
    对于 i 从 k - 1 到 0 步长 -1 循环
        base = base + 索引列表[i] * 间距
        间距 = 间距 * 形状[i]
    结束
    如果 k >= n 则
        返回 T["数据"][base]
    结束
    让 剩余形状 = 切片(形状, k, n)
    让 rem = 张元素数(剩余形状)
    让 子数据 = 切片(T["数据"], base, base + rem)
    返回 {"类型":"张量","数据":子数据,"形状":剩余形状,"维度":长度(剩余形状)}
结束

# 沿某维度切片 [起, 止)
函数 张切片(T, 轴, 起, 止)
    让 形状 = T["形状"]
    让 d = 轴
    让 该轴长 = 形状[d]
    如果 起 < 0 则 起 = 起 + 该轴长 结束
    如果 止 < 0 则 止 = 止 + 该轴长 结束
    让 块长 = 1
    对于 q 从 长度(形状) - 1 到 d + 1 步长 -1 循环
        块长 = 块长 * 形状[q]
    结束
    让 外块数 = 1
    对于 q 从 0 到 d - 1 循环
        外块数 = 外块数 * 形状[q]
    结束
    让 外步长 = 块长 * 该轴长
    让 新数据 = []
    对于 o 从 0 到 外块数 - 1 循环
        让 基 = o * 外步长 + 起 * 块长
        对于 c 从 0 到 (止 - 起) * 块长 - 1 循环
            追加(新数据, T["数据"][基 + c])
        结束
    结束
    让 新形状 = 切片(形状, 0, d) + [(止 - 起)] + 切片(形状, d + 1, 长度(形状))
    返回 {"类型":"张量","数据":新数据,"形状":新形状,"维度":长度(形状)}
结束

# ---- 聚合 ----

# 沿指定轴求和
函数 张轴和(T, 轴)
    让 形状 = T["形状"]
    让 n = 长度(形状)
    让 新形状 = 切片(形状, 0, 轴) + 切片(形状, 轴 + 1, n)
    让 新总数 = 张元素数(新形状)
    让 累 = []
    对于 i 从 0 到 新总数 - 1 循环
        追加(累, 0.0)
    结束
    对于 f 从 0 到 长度(T["数据"]) - 1 循环
        让 coord = 扁平转索引(形状, f)
        让 子 = 切片(coord, 0, 轴) + 切片(coord, 轴 + 1, n)
        让 fi = 索引转扁平(新形状, 子)
        累[fi] = 累[fi] + 转浮点(T["数据"][f])
    结束
    返回 {"类型":"张量","数据":累,"形状":新形状,"维度":长度(新形状)}
结束

# 递归把扁平数据按形状重建为嵌套列表（偏移盒 [偏移] 跨递归共享）
函数 张嵌套(形状, 轴, 偏移盒, 数据)
    让 d = 长度(形状)
    如果 轴 >= d 则
        让 v = 数据[偏移盒[0]]
        偏移盒[0] = 偏移盒[0] + 1
        返回 v
    结束
    让 s = 形状[轴]
    让 lst = []
    对于 i 从 0 到 s - 1 循环
        追加(lst, 张嵌套(形状, 轴 + 1, 偏移盒, 数据))
    结束
    返回 lst
结束

# ---- 统一分发：名字 + 已求值实参 -> 返回值 ----
函数 引_扁平化(嵌套)
    如果 类型(嵌套) != "列表" 则
        返回 [嵌套]
    结束
    让 结果 = []
    对于 i 从 0 到 长度(嵌套) - 1 循环
        如果 类型(嵌套[i]) == "列表" 则
            让 子 = 引_扁平化(嵌套[i])
            对于 j 从 0 到 长度(子) - 1 循环
                追加(结果, 子[j])
            结束
        否则
            追加(结果, 嵌套[i])
        结束
    结束
    返回 结果
结束

函数 引_是张量(v)
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "类型") 且 v["类型"] == "张量" 则
        返回 1
    结束
    返回 0
结束

函数 引_收集节点(node, 节点表, 已访问)
    如果 非 引_是张量(node) 则
        返回
    结束
    让 id = 转字符串(node["数据"])
    如果 包含(已访问, id) 则
        返回
    结束
    已访问[id] = 1
    如果 node["父"] != "-" 且 类型(node["父"]) == "字典" 则
        引_收集节点(node["父"]["左"], 节点表, 已访问)
        引_收集节点(node["父"]["右"], 节点表, 已访问)
    结束
    追加(节点表, node)
结束

函数 引_加(a, b)
    让 a是张量 = 引_是张量(a)
    让 b是张量 = 引_是张量(b)
    
    如果 a是张量 且 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] + b["数据"][i])
        结束
        让 需梯度 = a["需梯度"] 或 b["需梯度"]
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": 需梯度,
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "+"}
        }
    结束
    
    如果 a是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] + b)
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": a["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "+"}
        }
    结束
    
    如果 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(b["数据"]) - 1 循环
            追加(result_data, a + b["数据"][i])
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(b["形状"]),
            "维度": b["维度"],
            "需梯度": b["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "+"}
        }
    结束
    
    返回 a + b
结束

函数 引_减(a, b)
    让 a是张量 = 引_是张量(a)
    让 b是张量 = 引_是张量(b)
    
    如果 a是张量 且 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] - b["数据"][i])
        结束
        让 需梯度 = a["需梯度"] 或 b["需梯度"]
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": 需梯度,
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "-"}
        }
    结束
    
    如果 a是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] - b)
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": a["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "-"}
        }
    结束
    
    如果 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(b["数据"]) - 1 循环
            追加(result_data, a - b["数据"][i])
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(b["形状"]),
            "维度": b["维度"],
            "需梯度": b["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "-"}
        }
    结束
    
    返回 a - b
结束

函数 引_乘(a, b)
    让 a是张量 = 引_是张量(a)
    让 b是张量 = 引_是张量(b)
    
    如果 a是张量 且 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] * b["数据"][i])
        结束
        让 需梯度 = a["需梯度"] 或 b["需梯度"]
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": 需梯度,
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "*"}
        }
    结束
    
    如果 a是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] * b)
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": a["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "*"}
        }
    结束
    
    如果 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(b["数据"]) - 1 循环
            追加(result_data, a * b["数据"][i])
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(b["形状"]),
            "维度": b["维度"],
            "需梯度": b["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "*"}
        }
    结束
    
    返回 a * b
结束

函数 引_除(a, b)
    让 a是张量 = 引_是张量(a)
    让 b是张量 = 引_是张量(b)
    
    如果 a是张量 且 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] / b["数据"][i])
        结束
        让 需梯度 = a["需梯度"] 或 b["需梯度"]
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": 需梯度,
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "/"}
        }
    结束
    
    如果 a是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(a["数据"]) - 1 循环
            追加(result_data, a["数据"][i] / b)
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(a["形状"]),
            "维度": a["维度"],
            "需梯度": a["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "/"}
        }
    结束
    
    如果 b是张量 则
        让 result_data = []
        对于 i 从 0 到 长度(b["数据"]) - 1 循环
            追加(result_data, a / b["数据"][i])
        结束
        返回 {
            "类型": "张量",
            "数据": result_data,
            "形状": 复制(b["形状"]),
            "维度": b["维度"],
            "需梯度": b["需梯度"],
            "梯度": "-",
            "父": {"左": a, "右": b, "算": "/"}
        }
    结束
    
    返回 a / b
结束

# 形状校验：逐字对齐宿主 dim_of + 形状维数检查（co_old.c 2831-2836、4532-4545）。
# 宿主顺序是：列表型（各函数自己的文案）→ 维数 1..8 → 逐维（数字型 → 向零截断
# → 必须正整数 → 上限 1 亿）。实测（/tmp/svp/gen.sh，宿主通道）：
#   全零([0,3])   → 形状列表 的维度必须是正整数，收到 0
#   全零([0.5])   → 形状列表 的维度必须是正整数，收到 0   ← 截断后才报，不是 0.5
#   全零([真])    → 正常（真=1，num_of 允许布尔）
#   全零([])      → 形状维数必须在 1..8 之间，收到 0
#   全零(3)       → 全零函数需要形状列表
# 返回 {"错误": "-", "形状": 规范化整数列表}；错误不为 "-" 时由调用方 造异常。
函数 引_规范形状(形状)
    让 结果 = {"错误": "-", "形状": []}
    让 维数 = 长度(形状)
    如果 维数 < 1 或 维数 > 8 则
        结果["错误"] = "形状维数必须在 1..8 之间，收到 " + 转字符串(维数)
        返回 结果
    结束
    让 规范化 = []
    对于 i 从 0 到 维数 - 1 循环
        让 元素 = 形状[i]
        让 型 = 类型(元素)
        如果 型 != "整数" 且 型 != "浮点" 且 型 != "布尔" 则
            结果["错误"] = "形状列表 需要数字参数，收到 " + 型
            返回 结果
        结束
        让 d = 转整数(元素)
        如果 d <= 0 则
            结果["错误"] = "形状列表 的维度必须是正整数，收到 " + 转字符串(d)
            返回 结果
        结束
        如果 d > 100000000 则
            结果["错误"] = "形状列表 的维度过大：" + 转字符串(d) + "（上限 100000000）"
            返回 结果
        结束
        追加(规范化, d)
    结束
    结果["形状"] = 规范化
    返回 结果
结束

# 取/置：索引定位规则逐字抄宿主（co_old.c 4695-4727，实测 /tmp/svp/t3.co）：
#   维度==2      → 行/列两段索引，缺列按 0；文案「取函数 的行索引越界：5（共 2 行）」
#                 「取函数 的列索引越界：9（共 3 列）」
#   其余维度     → 只有 1 个索引，按【整个扁平数据的线性偏移】，
#                 文案「取函数 的索引越界：99（共 8 个元素）」
# 负索引两轴都先加长度（所以 取(张,-1) 合法）；索引非数字走 num_of 文案。
函数 引_索引数(值, 谁)
    让 型 = 类型(值)
    如果 型 != "整数" 且 型 != "浮点" 且 型 != "布尔" 则
        返回 {"错误": 谁 + " 需要数字参数，收到 " + 型, "值": 0}
    结束
    返回 {"错误": "-", "值": 转整数(值)}
结束

函数 引_线性偏移(目标, 索引值, 谁)
    让 取整 = 引_索引数(索引值, 谁)
    如果 取整["错误"] != "-" 则
        返回 取整
    结束
    让 n = 取整["值"]
    让 总 = 长度(目标["数据"])
    如果 n < 0 则
        n = n + 总
    结束
    如果 n < 0 或 n >= 总 则
        返回 {"错误": 谁 + " 的索引越界：" + 转字符串(n) + "（共 " + 转字符串(总) + " 个元素）", "值": 0}
    结束
    返回 {"错误": "-", "值": n}
结束

函数 引_二维偏移(目标, 行值, 列值, 谁)
    让 shape = 目标["形状"]
    让 行 = 引_索引数(行值, 谁)
    如果 行["错误"] != "-" 则
        返回 行
    结束
    让 列 = 引_索引数(列值, 谁)
    如果 列["错误"] != "-" 则
        返回 列
    结束
    让 行数 = shape[0]
    让 列数 = shape[1]
    让 i = 行["值"]
    让 j = 列["值"]
    如果 i < 0 则
        i = i + 行数
    结束
    如果 j < 0 则
        j = j + 列数
    结束
    如果 i < 0 或 i >= 行数 则
        返回 {"错误": 谁 + " 的行索引越界：" + 转字符串(i) + "（共 " + 转字符串(行数) + " 行）", "值": 0}
    结束
    如果 j < 0 或 j >= 列数 则
        返回 {"错误": 谁 + " 的列索引越界：" + 转字符串(j) + "（共 " + 转字符串(列数) + " 列）", "值": 0}
    结束
    返回 {"错误": "-", "值": i * 列数 + j}
结束

# 定位索引：宿主按维度分流，2 维走行列、其余走线性。
函数 引_定位(目标, 实参, 起始, 谁)
    如果 目标["维度"] == 2 则
        如果 起始 + 1 < 长度(实参) 则
            返回 引_二维偏移(目标, 实参[起始], 实参[起始 + 1], 谁)
        结束
        返回 引_二维偏移(目标, 实参[起始], 0, 谁)
    结束
    返回 引_线性偏移(目标, 实参[起始], 谁)
结束

函数 引_取实现(实参)
    # 宿主：argc < 2 或首参非张量 → 「取函数需要: 张量, 索引...」
    如果 长度(实参) < 2 或 非 引_是张量(实参[0]) 则
        返回 造内置异常("取函数需要: 张量, 索引...")
    结束
    让 落点 = 引_定位(实参[0], 实参, 1, "取函数")
    如果 落点["错误"] != "-" 则
        返回 造内置异常(落点["错误"])
    结束
    返回 实参[0]["数据"][落点["值"]]
结束

函数 引_置实现(实参)
    # 宿主：argc < 3 或首参非张量 → 「置函数需要: 张量, 索引, 值」
    如果 长度(实参) < 3 或 非 引_是张量(实参[0]) 则
        返回 造内置异常("置函数需要: 张量, 索引, 值")
    结束
    让 t = 实参[0]
    # 宿主先算偏移、再 num_of(值)；这里同样先查值的类型，文案照抄
    让 值型 = 类型(实参[长度(实参) - 1])
    如果 值型 != "整数" 且 值型 != "浮点" 且 值型 != "布尔" 则
        返回 造内置异常("置函数的值 需要数字参数，收到 " + 值型)
    结束
    让 尾 = 长度(实参) - 1
    让 落点 = 引_定位(t, 实参, 1, "置函数")
    如果 落点["错误"] != "-" 则
        返回 造内置异常(落点["错误"])
    结束
    t["数据"][落点["值"]] = 实参[尾]
    返回 空
结束

函数 引_形状(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("形状函数需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("形状函数需要一个张量")
    结束
    返回 实参[0]["形状"]
结束

函数 引_转置(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("转置需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("转置需要一个张量")
    结束
    让 t = 实参[0]
    如果 t["维度"] != 2 则
        返回 造内置异常("转置仅支持二维张量")
    结束
    让 rows = t["形状"][0]
    让 cols = t["形状"][1]
    让 new_data = []
    对于 i 从 0 到 cols - 1 循环
        对于 j 从 0 到 rows - 1 循环
            追加(new_data, t["数据"][j * cols + i])
        结束
    结束
    返回 {
        "类型": "张量",
        "数据": new_data,
        "形状": [cols, rows],
        "维度": 2,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_重塑(实参)
    # 宿主文案（co_old.c 4601）：argc!=2 / 首参非张量 / 次参非列表 都是同一条
    如果 长度(实参) != 2 或 非 引_是张量(实参[0]) 或 类型(实参[1]) != "列表" 则
        返回 造内置异常("重塑函数需要: 张量, 形状列表")
    结束
    让 t = 实参[0]
    # 宿主顺序：先校验形状，再比元素总数（重塑(全零([2,2]),[0,2]) 报的是维度非法，
    # 不是总数不一致——实测 /tmp/svp/gen.sh 重塑零）。
    让 校验 = 引_规范形状(实参[1])
    如果 校验["错误"] != "-" 则
        返回 造内置异常(校验["错误"])
    结束
    让 new_shape = 校验["形状"]
    让 total = 张元素数(new_shape)
    如果 total != 长度(t["数据"]) 则
        返回 造内置异常("重塑前后元素总数不一致")
    结束
    返回 {
        "类型": "张量",
        "数据": 复制(t["数据"]),
        "形状": new_shape,
        "维度": 长度(new_shape),
        "需梯度": 0,
        "梯度": "-",
        "父": "-",
        "动量": "-",
        "一阶矩": "-",
        "二阶矩": "-",
        "步数": 0
    }
结束

函数 引_随机(实参)
    # 均匀分布随机张量，宿主 builtin_rand_tensor（co_old.c 4550-4561）：
    # 顺序 参数/列表型 → 形状校验 → 下限 → 上限 → 下限<=上限。文案逐字抄。
    如果 长度(实参) != 3 或 类型(实参[0]) != "列表" 则
        返回 造内置异常("随机张量需要: 形状列表, 下限, 上限")
    结束
    让 校验 = 引_规范形状(实参[0])
    如果 校验["错误"] != "-" 则
        返回 造内置异常(校验["错误"])
    结束
    让 shape = 校验["形状"]
    让 lo = 实参[1]
    让 hi = 实参[2]
    让 lo型 = 类型(lo)
    如果 lo型 != "整数" 且 lo型 != "浮点" 且 lo型 != "布尔" 则
        返回 造内置异常("随机张量的下限 需要数字参数，收到 " + lo型)
    结束
    让 hi型 = 类型(hi)
    如果 hi型 != "整数" 且 hi型 != "浮点" 且 hi型 != "布尔" 则
        返回 造内置异常("随机张量的上限 需要数字参数，收到 " + hi型)
    结束
    如果 lo > hi 则
        返回 造内置异常("随机张量的下限不能大于上限")
    结束
    让 data = []
    对于 i 从 0 到 张元素数(shape) - 1 循环
        追加(data, lo + 随机数() * (hi - lo))
    结束
    返回 {
        "类型": "张量",
        "数据": data,
        "形状": shape,
        "维度": 长度(shape),
        "需梯度": 0,
        "梯度": "-",
        "父": "-",
        "动量": "-",
        "一阶矩": "-",
        "二阶矩": "-",
        "步数": 0
    }
结束

函数 引_矩阵乘(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("矩阵乘需要两个张量")
    结束
    如果 非 引_是张量(实参[0]) 或 非 引_是张量(实参[1]) 则
        返回 造内置异常("矩阵乘需要两个张量")
    结束
    让 a = 实参[0]
    让 b = 实参[1]
    如果 a["维度"] != 2 或 b["维度"] != 2 则
        返回 造内置异常("矩阵乘仅支持二维张量")
    结束
    如果 a["形状"][1] != b["形状"][0] 则
        返回 造内置异常("矩阵乘形状不匹配")
    结束
    让 m = a["形状"][0]
    让 n = b["形状"][1]
    让 k = a["形状"][1]
    让 result_data = []
    对于 i 从 0 到 m - 1 循环
        对于 j 从 0 到 n - 1 循环
            让 sum = 0
            对于 p 从 0 到 k - 1 循环
                sum = sum + a["数据"][i * k + p] * b["数据"][p * n + j]
            结束
            追加(result_data, sum)
        结束
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": [m, n],
        "维度": 2,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_全零(实参)
    如果 长度(实参) != 1 或 类型(实参[0]) != "列表" 则
        返回 造内置异常("全零函数需要形状列表")
    结束
    让 校验 = 引_规范形状(实参[0])
    如果 校验["错误"] != "-" 则
        返回 造内置异常(校验["错误"])
    结束
    让 shape = 校验["形状"]
    让 data = []
    对于 i 从 0 到 张元素数(shape) - 1 循环
        追加(data, 0)
    结束
    返回 {
        "类型": "张量",
        "数据": data,
        "形状": shape,
        "维度": 长度(shape),
        "需梯度": 0,
        "梯度": "-",
        "父": "-",
        "动量": "-",
        "一阶矩": "-",
        "二阶矩": "-",
        "步数": 0
    }
结束

函数 引_全一(实参)
    如果 长度(实参) != 1 或 类型(实参[0]) != "列表" 则
        返回 造内置异常("全一函数需要形状列表")
    结束
    让 校验 = 引_规范形状(实参[0])
    如果 校验["错误"] != "-" 则
        返回 造内置异常(校验["错误"])
    结束
    让 shape = 校验["形状"]
    让 data = []
    对于 i 从 0 到 张元素数(shape) - 1 循环
        追加(data, 1)
    结束
    返回 {
        "类型": "张量",
        "数据": data,
        "形状": shape,
        "维度": 长度(shape),
        "需梯度": 0,
        "梯度": "-",
        "父": "-",
        "动量": "-",
        "一阶矩": "-",
        "二阶矩": "-",
        "步数": 0
    }
结束

函数 引_高斯随机(实参)
    # 宿主顺序（co_old.c 4563-4571）：参数个数/形状列表型 → 形状校验 →
    # 均值/标准差数值 → 标准差非负。文案逐字抄。
    如果 长度(实参) != 3 或 类型(实参[0]) != "列表" 则
        返回 造内置异常("高斯随机需要: 形状列表, 均值, 标准差")
    结束
    让 校验 = 引_规范形状(实参[0])
    如果 校验["错误"] != "-" 则
        返回 造内置异常(校验["错误"])
    结束
    让 shape = 校验["形状"]
    让 mean = 实参[1]
    让 std = 实参[2]
    让 mean型 = 类型(mean)
    如果 mean型 != "整数" 且 mean型 != "浮点" 且 mean型 != "布尔" 则
        返回 造内置异常("高斯随机的均值 需要数字参数，收到 " + mean型)
    结束
    让 std型 = 类型(std)
    如果 std型 != "整数" 且 std型 != "浮点" 且 std型 != "布尔" 则
        返回 造内置异常("高斯随机的标准差 需要数字参数，收到 " + std型)
    结束
    如果 std < 0 则
        返回 造内置异常("高斯随机的标准差不能为负")
    结束
    让 data = []
    对于 i 从 0 到 张元素数(shape) - 1 循环
        # 与宿主同一个 Box-Muller：u1 取 (rand+1)/(RAND_MAX+1) 避开 log(0)
        让 u1 = 随机数()
        让 u2 = 随机数()
        如果 u1 <= 0 则
            u1 = 0.0000000001
        结束
        让 z = 平方根(-2 * 自然对数(u1)) * 余弦(6.283185307 * u2)
        追加(data, mean + std * z)
    结束
    返回 {
        "类型": "张量",
        "数据": data,
        "形状": shape,
        "维度": 长度(shape),
        "需梯度": 0,
        "梯度": "-",
        "父": "-",
        "动量": "-",
        "一阶矩": "-",
        "二阶矩": "-",
        "步数": 0
    }
结束

# 张量深拷贝：宿主 复制(张量) 是【新建张量 + memcpy 数据】（co_old.c 3969），
# 梯度/计算图不带。层的 复制() 对字典是浅拷贝，内层 数据 列表是共享的
# （实测 /tmp/copydict.co：复制 后 追加 子列表，原件同步变 [1,2,3,9]，
# 三通道一致）——所以 让 张2 = 复制(张) 后 置(张2,...) 会写坏 张，
# 正是 系统函数测试「张量深拷贝」那条断言失败的原因（期望 1，实际 99）。
函数 引_深拷贝张量(t)
    让 新数据 = []
    对于 i 从 0 到 长度(t["数据"]) - 1 循环
        追加(新数据, t["数据"][i])
    结束
    让 新形状 = []
    对于 i 从 0 到 长度(t["形状"]) - 1 循环
        追加(新形状, t["形状"][i])
    结束
    返回 {
        "类型": "张量",
        "数据": 新数据,
        "形状": 新形状,
        "维度": t["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_需梯度(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("需梯度函数需要1个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("需梯度函数需要1个张量")
    结束
    # 宿主：argv[0]->tval->requires_grad = 1 后 tensor_retain 返回【同一个张量】
    # （co_old.c builtin_requires_grad），不是副本。这里同样就地标记。
    让 t = 实参[0]
    t["需梯度"] = 1
    如果 t["梯度"] == "-" 则
        让 零梯度 = []
        对于 i 从 0 到 长度(t["数据"]) - 1 循环
            追加(零梯度, 0)
        结束
        t["梯度"] = 零梯度
    结束
    返回 t
结束

函数 引_反向(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("反向需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("反向需要一个张量")
    结束
    让 t = 实参[0]
    让 节点表 = []
    让 已访问 = {}
    引_收集节点(t, 节点表, 已访问)
    
    # 实测：同一条语句写成 t["梯度"] = 引_全一([t["形状"]])["数据"]，
    # eval 通道拿到的 梯度 是 <未知>（反向整条链跟着崩，见 /tmp/bp1.co 的
    # 「不支持的类型索引」）；拆成「先取结果、再取字段」两步就正常。
    # 这里按两步写，行为在两通道一致（/tmp/idxassign*.co 实测）。
    让 全一结果 = 引_全一([t["形状"]])
    t["梯度"] = 全一结果["数据"]
    
    # 节点表 是后序（叶在前、根在后），反向必须【从根往叶】传梯度。
    # 这里以前写 对于 i 从 长度(节点表) - 1 到 0 循环 —— 没有 步长 -1，
    # 三通道实测（/tmp/loopdown.co）这种降序写法一次都不执行，
    # 于是梯度永远停在 "-"，优化器拿到空梯度：程序照跑、结果照错。
    对于 i 从 长度(节点表) - 1 到 0 步长 -1 循环
        让 node = 节点表[i]
        如果 node["父"] != "-" 则
            让 parent = node["父"]
            让 op = parent["算"]
            让 左 = parent["左"]
            让 右 = parent["右"]
            
            如果 op == "+" 则
                如果 左["需梯度"] 则
                    如果 左["梯度"] == "-" 则
                        左["梯度"] = 复制(node["梯度"])
                    否则
                        对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                            左["梯度"][j] = 左["梯度"][j] + node["梯度"][j]
                        结束
                    结束
                结束
                如果 右["需梯度"] 则
                    如果 右["梯度"] == "-" 则
                        右["梯度"] = 复制(node["梯度"])
                    否则
                        对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                            右["梯度"][j] = 右["梯度"][j] + node["梯度"][j]
                        结束
                    结束
                结束
            否则如果 op == "-" 则
                如果 左["需梯度"] 则
                    如果 左["梯度"] == "-" 则
                        左["梯度"] = 复制(node["梯度"])
                    否则
                        对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                            左["梯度"][j] = 左["梯度"][j] + node["梯度"][j]
                        结束
                    结束
                结束
                如果 右["需梯度"] 则
                    如果 右["梯度"] == "-" 则
                        让 neg_grad = []
                        对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                            追加(neg_grad, -node["梯度"][j])
                        结束
                        右["梯度"] = neg_grad
                    否则
                        对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                            右["梯度"][j] = 右["梯度"][j] - node["梯度"][j]
                        结束
                    结束
                结束
            否则如果 op == "*" 则
                如果 左["需梯度"] 则
                    让 grad = []
                    对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                        追加(grad, node["梯度"][j] * 右["数据"][j])
                    结束
                    如果 左["梯度"] == "-" 则
                        左["梯度"] = grad
                    否则
                        对于 j 从 0 到 长度(grad) - 1 循环
                            左["梯度"][j] = 左["梯度"][j] + grad[j]
                        结束
                    结束
                结束
                如果 右["需梯度"] 则
                    让 grad = []
                    对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                        追加(grad, node["梯度"][j] * 左["数据"][j])
                    结束
                    如果 右["梯度"] == "-" 则
                        右["梯度"] = grad
                    否则
                        对于 j 从 0 到 长度(grad) - 1 循环
                            右["梯度"][j] = 右["梯度"][j] + grad[j]
                        结束
                    结束
                结束
            否则如果 op == "/" 则
                如果 左["需梯度"] 则
                    让 grad = []
                    对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                        追加(grad, node["梯度"][j] / 右["数据"][j])
                    结束
                    如果 左["梯度"] == "-" 则
                        左["梯度"] = grad
                    否则
                        对于 j 从 0 到 长度(grad) - 1 循环
                            左["梯度"][j] = 左["梯度"][j] + grad[j]
                        结束
                    结束
                结束
                如果 右["需梯度"] 则
                    让 grad = []
                    对于 j 从 0 到 长度(node["梯度"]) - 1 循环
                        追加(grad, -node["梯度"][j] * 左["数据"][j] / (右["数据"][j] * 右["数据"][j]))
                    结束
                    如果 右["梯度"] == "-" 则
                        右["梯度"] = grad
                    否则
                        对于 j 从 0 到 长度(grad) - 1 循环
                            右["梯度"][j] = 右["梯度"][j] + grad[j]
                        结束
                    结束
                结束
            结束
        结束
    结束
结束

函数 引_优化(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("优化函数需要2个参数: 学习率, 参数列表")
    结束
    让 lr = 实参[0]
    让 params = 实参[1]
    如果 类型(lr) != "整数" 且 类型(lr) != "浮点" 则
        返回 造内置异常("优化函数的学习率 需要数字参数，收到 " + 类型(lr))
    结束
    如果 类型(params) != "列表" 则
        返回 造内置异常("优化函数第二个参数必须是参数列表")
    结束
    对于 i 从 0 到 长度(params) - 1 循环
        让 p = params[i]
        如果 p["需梯度"] 且 p["梯度"] != "-" 则
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                p["数据"][j] = p["数据"][j] - lr * p["梯度"][j]
            结束
            # 宿主每次更新后 memset(t->grad, 0, ...)（co_old.c builtin_optim）。
            # 不清零的话，下一轮 反向 是在旧梯度上【再累加一遍】，
            # 学习率等效被放大、动量项更会指数跑飞——典型「能跑但算错」。
            让 零梯度 = []
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                追加(零梯度, 0)
            结束
            p["梯度"] = 零梯度
        结束
    结束
结束

# 动量 SGD：v ← 动量·v + 梯度，θ ← θ - 学习率·v，更新后梯度清零。
# 宿主（co_old.c builtin_momentum）的三处关键语义，层必须逐一对齐：
#   1) argc 必须正好 3 —— 状态不在参数里，而是懒分配在张量自身
#      （C 里是 Tensor->om/ov/ot）。以前层要 实参[3] 当状态，
#      测试按宿主的 3 参写法调用 → 直接返回异常被静默丢掉，
#      参数根本没更新，这就是「动量SGD未收敛到3」的另一半根因。
#   2) 动量系数越界报「动量系数必须在 0~1 之间，收到 X」。
#   3) 每次更新后 memset(grad, 0)——不清零会跨轮累加，等效放大学习率。
函数 引_动量优化(实参)
    如果 长度(实参) != 3 则
        返回 造内置异常("动量优化需要3个参数: 学习率, 动量系数, 参数列表")
    结束
    让 lr = 实参[0]
    让 mu = 实参[1]
    让 params = 实参[2]
    让 lr型 = 类型(lr)
    如果 lr型 != "整数" 且 lr型 != "浮点" 且 lr型 != "布尔" 则
        返回 造内置异常("动量优化的学习率 需要数字参数，收到 " + lr型)
    结束
    让 mu型 = 类型(mu)
    如果 mu型 != "整数" 且 mu型 != "浮点" 且 mu型 != "布尔" 则
        返回 造内置异常("动量优化的动量系数 需要数字参数，收到 " + mu型)
    结束
    如果 mu < 0 或 mu > 1 则
        返回 造内置异常("动量系数必须在 0~1 之间，收到 " + 转字符串(mu))
    结束
    如果 类型(params) != "列表" 则
        返回 造内置异常("动量优化的第三个参数必须是参数列表")
    结束
    对于 i 从 0 到 长度(params) - 1 循环
        让 p = params[i]
        如果 引_是张量(p) 且 p["需梯度"] 且 p["梯度"] != "-" 则
            如果 非 包含(p, "动量") 则
                p["动量"] = "-"
            结束
            如果 p["动量"] == "-" 则
                让 初速 = []
                对于 j 从 0 到 长度(p["数据"]) - 1 循环
                    追加(初速, 0)
                结束
                p["动量"] = 初速
            结束
            让 v = p["动量"]
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                让 新速 = mu * v[j] + p["梯度"][j]
                v[j] = 新速
                p["数据"][j] = p["数据"][j] - lr * 新速
            结束
            让 零梯度 = []
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                追加(零梯度, 0)
            结束
            p["梯度"] = 零梯度
        结束
    结束
    返回 空
结束

# Adam：一阶/二阶矩 + 偏差修正，Adam(学习率, 参数列表[, β1, β2, ε])，
# 默认 β1=0.9、β2=0.999、ε=1e-8。状态与步数同样挂在张量自身字段上
# （宿主 Tensor->om/ov/ot），更新后梯度清零；越界文案逐字抄宿主：
# 「Adam的β1 必须在 0~1 之间」「Adam的β2 必须在 0~1 之间」「Adam的ε 不能为负」。
函数 引_Adam(实参)
    如果 长度(实参) < 2 则
        返回 造内置异常("Adam需要至少2个参数: 学习率, 参数列表")
    结束
    让 lr = 实参[0]
    让 params = 实参[1]
    让 beta1 = 0.9
    如果 长度(实参) > 2 则
        beta1 = 实参[2]
    结束
    让 beta2 = 0.999
    如果 长度(实参) > 3 则
        beta2 = 实参[3]
    结束
    让 epsilon = 1e-8
    如果 长度(实参) > 4 则
        epsilon = 实参[4]
    结束
    让 lr型 = 类型(lr)
    如果 lr型 != "整数" 且 lr型 != "浮点" 且 lr型 != "布尔" 则
        返回 造内置异常("Adam的学习率 需要数字参数，收到 " + lr型)
    结束
    如果 类型(params) != "列表" 则
        返回 造内置异常("Adam的第二个参数必须是参数列表")
    结束
    让 b1型 = 类型(beta1)
    如果 b1型 != "整数" 且 b1型 != "浮点" 且 b1型 != "布尔" 则
        返回 造内置异常("Adam的β1 需要数字参数，收到 " + b1型)
    结束
    让 b2型 = 类型(beta2)
    如果 b2型 != "整数" 且 b2型 != "浮点" 且 b2型 != "布尔" 则
        返回 造内置异常("Adam的β2 需要数字参数，收到 " + b2型)
    结束
    让 ep型 = 类型(epsilon)
    如果 ep型 != "整数" 且 ep型 != "浮点" 且 ep型 != "布尔" 则
        返回 造内置异常("Adam的ε 需要数字参数，收到 " + ep型)
    结束
    如果 beta1 < 0 或 beta1 > 1 则
        返回 造内置异常("Adam的β1 必须在 0~1 之间")
    结束
    如果 beta2 < 0 或 beta2 > 1 则
        返回 造内置异常("Adam的β2 必须在 0~1 之间")
    结束
    如果 epsilon < 0 则
        返回 造内置异常("Adam的ε 不能为负")
    结束
    对于 i 从 0 到 长度(params) - 1 循环
        让 p = params[i]
        如果 引_是张量(p) 且 p["需梯度"] 且 p["梯度"] != "-" 则
            如果 非 包含(p, "一阶矩") 则
                p["一阶矩"] = "-"
            结束
            如果 非 包含(p, "二阶矩") 则
                p["二阶矩"] = "-"
            结束
            如果 非 包含(p, "步数") 则
                p["步数"] = 0
            结束
            如果 p["一阶矩"] == "-" 则
                让 m0 = []
                让 v0 = []
                对于 j 从 0 到 长度(p["数据"]) - 1 循环
                    追加(m0, 0)
                    追加(v0, 0)
                结束
                p["一阶矩"] = m0
                p["二阶矩"] = v0
            结束
            p["步数"] = p["步数"] + 1
            让 步 = p["步数"]
            让 m = p["一阶矩"]
            让 v = p["二阶矩"]
            让 bc1 = 1 - 幂(beta1, 步)
            让 bc2 = 1 - 幂(beta2, 步)
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                让 g = p["梯度"][j]
                m[j] = beta1 * m[j] + (1 - beta1) * g
                v[j] = beta2 * v[j] + (1 - beta2) * g * g
                让 mh = m[j] / bc1
                让 vh = v[j] / bc2
                p["数据"][j] = p["数据"][j] - lr * mh / (平方根(vh) + epsilon)
            结束
            让 零梯度 = []
            对于 j 从 0 到 长度(p["数据"]) - 1 循环
                追加(零梯度, 0)
            结束
            p["梯度"] = 零梯度
        结束
    结束
    返回 空
结束

# 梯度裁剪：把每个参数的【梯度】逐元素限幅到 [-上限, 上限]，就地改。
# 以前层里写的是「按 L2 范数整体缩放 数据 并返回新张量」——那是另一个函数：
# 它动的是 数据 不是 梯度，且返回副本，优化器随后拿到的还是原始大梯度，
# 裁剪等于没做（宿主 co_old.c builtin_clip_grad 明确是 grad 的逐元素 clamp）。
函数 引_裁剪梯度(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("裁剪梯度需要2个参数: 上限, 参数列表")
    结束
    让 lim = 实参[0]
    让 上限型 = 类型(lim)
    如果 上限型 != "整数" 且 上限型 != "浮点" 且 上限型 != "布尔" 则
        返回 造内置异常("裁剪梯度的上限 需要数字参数，收到 " + 上限型)
    结束
    如果 lim < 0 则
        返回 造内置异常("裁剪梯度的上限不能为负")
    结束
    如果 类型(实参[1]) != "列表" 则
        返回 造内置异常("裁剪梯度的第二个参数必须是参数列表")
    结束
    让 params = 实参[1]
    对于 i 从 0 到 长度(params) - 1 循环
        让 p = params[i]
        # 宿主：非张量、或没有梯度缓冲的，一律 continue（静默跳过）。
        # 层里「没有梯度」等价于 梯度 == "-"（还没跑过 反向）。
        如果 引_是张量(p) 且 p["梯度"] != "-" 则
            让 g = p["梯度"]
            对于 j 从 0 到 长度(g) - 1 循环
                如果 g[j] > lim 则
                    g[j] = lim
                结束
                如果 g[j] < 0 - lim 则
                    g[j] = 0 - lim
                结束
            结束
        结束
    结束
    返回 空
结束

# 模型保存/加载：宿主是二进制格式（n, 每项 ndim+shape+data，co_old.c
# builtin_save_model），层的 写文件 只能写文本，所以这里用文本编码，
# 但【校验顺序与报错文案逐字对齐宿主】——包括先整表校验再写、
# 个数不符、维度不符、形状不符三类，保证错误用例的 捕获 文案一致。
函数 引_保存模型(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("保存模型需要2个参数: 路径, 参数列表")
    结束
    让 路径 = 实参[0]
    让 params = 实参[1]
    如果 类型(路径) != "字符串" 则
        返回 造内置异常("保存模型 需要字符串参数")
    结束
    如果 类型(params) != "列表" 则
        返回 造内置异常("保存模型的第二个参数必须是参数列表")
    结束
    让 n = 长度(params)
    # 先统一校验，避免写一半留下残缺文件（宿主持相同注释与做法）
    对于 i 从 0 到 n - 1 循环
        如果 非 引_是张量(params[i]) 则
            返回 造内置异常("保存模型的参数列表里包含非张量（第 " + 转字符串(i) + " 项）")
        结束
    结束
    让 内容 = 转字符串(n)
    对于 i 从 0 到 n - 1 循环
        让 t = params[i]
        让 头 = 转字符串(t["维度"])
        对于 d 从 0 到 长度(t["形状"]) - 1 循环
            头 = 头 + "," + 转字符串(t["形状"][d])
        结束
        让 体 = ""
        对于 j 从 0 到 长度(t["数据"]) - 1 循环
            如果 j > 0 则
                体 = 体 + ","
            结束
            体 = 体 + 转字符串(t["数据"][j])
        结束
        内容 = 内容 + ";" + 头 + "|" + 体
    结束
    写文件(转字符串(路径), 内容)
    返回 空
结束

函数 引_加载模型(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("加载模型需要2个参数: 路径, 参数列表")
    结束
    让 路径 = 实参[0]
    让 params = 实参[1]
    如果 类型(路径) != "字符串" 则
        返回 造内置异常("加载模型 需要字符串参数")
    结束
    如果 类型(params) != "列表" 则
        返回 造内置异常("加载模型的第二个参数必须是参数列表")
    结束
    让 内容 = 读文件(转字符串(路径))
    如果 内容 == "" 则
        返回 造内置异常("无法打开模型文件: " + 转字符串(路径))
    结束
    让 段 = 分割(内容, ";")
    让 n = 转整数(段[0])
    如果 n != 长度(params) 则
        返回 造内置异常("模型文件参数个数与目标不符: 文件 " + 转字符串(n) + " 个, 目标 " + 转字符串(长度(params)) + " 个")
    结束
    对于 i 从 0 到 长度(params) - 1 循环
        让 p = params[i]
        如果 非 引_是张量(p) 则
            返回 造内置异常("加载模型的目标列表包含非张量（第 " + 转字符串(i) + " 项）")
        结束
        让 块 = 分割(段[i + 1], "|")
        让 元 = 分割(块[0], ",")
        让 ndim = 转整数(元[0])
        如果 ndim != p["维度"] 或 ndim < 1 则
            返回 造内置异常("模型文件与目标张量维度不符（第 " + 转字符串(i) + " 项）")
        结束
        对于 d 从 0 到 ndim - 1 循环
            如果 转整数(元[d + 1]) != p["形状"][d] 则
                返回 造内置异常("模型文件与目标张量形状不符（第 " + 转字符串(i) + " 项）")
            结束
        结束
        让 数 = 分割(块[1], ",")
        如果 长度(数) != 长度(p["数据"]) 则
            返回 造内置异常("读取模型数据未完成（第 " + 转字符串(i) + " 项）")
        结束
        让 新数据 = []
        对于 j 从 0 到 长度(数) - 1 循环
            追加(新数据, 转浮点(数[j]))
        结束
        p["数据"] = 新数据
    结束
    返回 空
结束

函数 引_平均绝对误差(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("平均绝对误差需要两个张量")
    结束
    如果 非 引_是张量(实参[0]) 或 非 引_是张量(实参[1]) 则
        返回 造内置异常("平均绝对误差需要两个张量")
    结束
    让 a = 实参[0]
    让 b = 实参[1]
    如果 长度(a["数据"]) != 长度(b["数据"]) 则
        返回 造内置异常("平均绝对误差张量形状不匹配")
    结束
    让 sum = 0
    对于 i 从 0 到 长度(a["数据"]) - 1 循环
        让 diff = a["数据"][i] - b["数据"][i]
        如果 diff < 0 则
            diff = -diff
        结束
        sum = sum + diff
    结束
    返回 {
        "类型": "张量",
        "数据": [sum / 长度(a["数据"])],
        "形状": [1],
        "维度": 1,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_均方误差(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("均方误差需要两个张量")
    结束
    如果 非 引_是张量(实参[0]) 或 非 引_是张量(实参[1]) 则
        返回 造内置异常("均方误差需要两个张量")
    结束
    让 a = 实参[0]
    让 b = 实参[1]
    如果 长度(a["数据"]) != 长度(b["数据"]) 则
        返回 造内置异常("均方误差张量形状不匹配")
    结束
    让 sum = 0
    对于 i 从 0 到 长度(a["数据"]) - 1 循环
        让 diff = a["数据"][i] - b["数据"][i]
        sum = sum + diff * diff
    结束
    返回 {
        "类型": "张量",
        "数据": [sum / 长度(a["数据"])],
        "形状": [1],
        "维度": 1,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_交叉熵(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("交叉熵需要两个张量")
    结束
    如果 非 引_是张量(实参[0]) 或 非 引_是张量(实参[1]) 则
        返回 造内置异常("交叉熵需要两个张量")
    结束
    让 p = 实参[0]
    让 q = 实参[1]
    如果 p["维度"] != 2 则
        返回 造内置异常("交叉熵概率张量需为二维")
    结束
    如果 长度(p["数据"]) != 长度(q["数据"]) 则
        返回 造内置异常("交叉熵张量形状不匹配")
    结束
    让 sum = 0
    对于 i 从 0 到 长度(p["数据"]) - 1 循环
        sum = sum - p["数据"][i] * 自然对数(q["数据"][i])
    结束
    返回 {
        "类型": "张量",
        "数据": [sum / (p["形状"][0])],
        "形状": [1],
        "维度": 1,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_对数交叉熵(实参)
    如果 长度(实参) != 2 则
        返回 造内置异常("对数交叉熵需要两个张量")
    结束
    如果 非 引_是张量(实参[0]) 或 非 引_是张量(实参[1]) 则
        返回 造内置异常("对数交叉熵需要两个张量")
    结束
    让 p = 实参[0]
    让 q = 实参[1]
    如果 p["维度"] != 2 则
        返回 造内置异常("对数交叉熵概率张量需为二维")
    结束
    如果 长度(p["数据"]) != 长度(q["数据"]) 则
        返回 造内置异常("对数交叉熵张量形状不匹配")
    结束
    让 sum = 0
    对于 i 从 0 到 长度(p["数据"]) - 1 循环
        sum = sum + p["数据"][i] * 自然对数(p["数据"][i] / q["数据"][i])
    结束
    返回 {
        "类型": "张量",
        "数据": [sum / (p["形状"][0])],
        "形状": [1],
        "维度": 1,
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_柔性最大值(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("柔性最大值需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("柔性最大值需要一个张量")
    结束
    让 t = 实参[0]
    让 max_val = t["数据"][0]
    对于 i 从 1 到 长度(t["数据"]) - 1 循环
        如果 t["数据"][i] > max_val 则
            max_val = t["数据"][i]
        结束
    结束
    让 exp_data = []
    让 sum = 0
    对于 i 从 0 到 长度(t["数据"]) - 1 循环
        让 e = 幂(2.718281828459045, t["数据"][i] - max_val)
        追加(exp_data, e)
        sum = sum + e
    结束
    让 result_data = []
    对于 i 从 0 到 长度(exp_data) - 1 循环
        追加(result_data, exp_data[i] / sum)
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(t["形状"]),
        "维度": t["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_西格莫德(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("西格莫德需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("西格莫德需要一个张量")
    结束
    让 t = 实参[0]
    让 result_data = []
    对于 i 从 0 到 长度(t["数据"]) - 1 循环
        追加(result_data, 1 / (1 + 幂(2.718281828459045, -t["数据"][i])))
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(t["形状"]),
        "维度": t["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_线性整流(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("线性整流需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("线性整流需要一个张量")
    结束
    让 t = 实参[0]
    让 result_data = []
    对于 i 从 0 到 长度(t["数据"]) - 1 循环
        让 val = t["数据"][i]
        如果 val < 0 则
            val = 0
        结束
        追加(result_data, val)
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(t["形状"]),
        "维度": t["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_双曲正切(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("双曲正切需要一个张量")
    结束
    如果 非 引_是张量(实参[0]) 则
        返回 造内置异常("双曲正切需要一个张量")
    结束
    让 t = 实参[0]
    让 result_data = []
    对于 i 从 0 到 长度(t["数据"]) - 1 循环
        让 e_pos = 幂(2.718281828459045, t["数据"][i])
        让 e_neg = 幂(2.718281828459045, -t["数据"][i])
        追加(result_data, (e_pos - e_neg) / (e_pos + e_neg))
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(t["形状"]),
        "维度": t["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_指数实现(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("指数需要一个参数")
    结束
    让 x = 实参[0]
    如果 非 引_是张量(x) 则
        返回 幂(2.718281828459045, x)
    结束
    让 result_data = []
    对于 i 从 0 到 长度(x["数据"]) - 1 循环
        追加(result_data, 幂(2.718281828459045, x["数据"][i]))
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(x["形状"]),
        "维度": x["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 引_对数实现(实参)
    如果 长度(实参) != 1 则
        返回 造内置异常("对数需要一个参数")
    结束
    让 x = 实参[0]
    如果 非 引_是张量(x) 则
        返回 自然对数(x)
    结束
    让 result_data = []
    对于 i 从 0 到 长度(x["数据"]) - 1 循环
        追加(result_data, 自然对数(x["数据"][i]))
    结束
    返回 {
        "类型": "张量",
        "数据": result_data,
        "形状": 复制(x["形状"]),
        "维度": x["维度"],
        "需梯度": 0,
        "梯度": "-",
        "父": "-"
    }
结束

函数 张量分发(名字, 实参)

    # 创建
    如果 名字 == "张量" 则 返回 张构造(实参[0]) 结束

    # 零张量/一张量 是老一层的别名，语义与 全零/全一 相同。
    # 之前这里自己算 张元素数(形状) 且【完全不校验】，全零([0]) 报错、
    # 零张量([0]) 静默给 0 元素张量——同一件事两条路，一条有闸一条没闸。
    # 现在统一走引擎的校验版。
    如果 名字 == "零张量" 则
        返回 引_全零([实参[0]])
    结束

    如果 名字 == "一张量" 则
        返回 引_全一([实参[0]])
    结束

    如果 名字 == "单位矩阵" 则
        让 n = 转整数(实参[0])
        让 d = []
        对于 i 从 0 到 n - 1 循环
            对于 j 从 0 到 n - 1 循环
                如果 i == j 则
                    追加(d, 1)
                否则
                    追加(d, 0)
                结束
            结束
        结束
        返回 {"类型":"张量","数据":d,"形状":[n, n],"维度":2}
    结束

    # 随机张量：与宿主同名同参（形状, 下限, 上限），统一走校验版
    如果 名字 == "随机张量" 则
        返回 引_随机(实参)
    结束

    如果 名字 == "张量范围" 则
        让 起 = 转浮点(实参[0])
        让 止 = 转浮点(实参[1])
        让 步 = 转浮点(实参[2])
        让 d = []
        让 v = 起
        当 v < 止 循环
            追加(d, v)
            v = v + 步
        结束
        返回 {"类型":"张量","数据":d,"形状":[长度(d)],"维度":1}
    结束

    # 属性
    如果 名字 == "张量形状" 则 返回 实参[0]["形状"] 结束
    如果 名字 == "张量维度" 则 返回 实参[0]["维度"] 结束
    如果 名字 == "张量元素数" 则 返回 张元素数(实参[0]["形状"]) 结束
    如果 名字 == "张量数据" 则 返回 实参[0]["数据"] 结束

    # 逐元素运算
    如果 名字 == "张量加法" 则 返回 张元二元(实参[0], 实参[1], "+") 结束
    如果 名字 == "张量减法" 则 返回 张元二元(实参[0], 实参[1], "-") 结束
    如果 名字 == "张量乘法" 则 返回 张元二元(实参[0], 实参[1], "*") 结束
    如果 名字 == "张量除法" 则 返回 张元二元(实参[0], 实参[1], "/") 结束
    如果 名字 == "张量标量加" 则 返回 张标二元(实参[0], 实参[1], "+") 结束
    如果 名字 == "张量标量乘" 则 返回 张标二元(实参[0], 实参[1], "*") 结束

    如果 名字 == "张量幂" 则
        让 T = 实参[0]
        让 e = 转浮点(实参[1])
        让 新 = []
        对于 i 从 0 到 长度(T["数据"]) - 1 循环
            追加(新, 幂(转浮点(T["数据"][i]), e))
        结束
        返回 {"类型":"张量","数据":新,"形状":T["形状"],"维度":T["维度"]}
    结束

    如果 名字 == "张量平方根" 则
        让 T = 实参[0]
        让 新 = []
        对于 i 从 0 到 长度(T["数据"]) - 1 循环
            追加(新, 平方根(转浮点(T["数据"][i])))
        结束
        返回 {"类型":"张量","数据":新,"形状":T["形状"],"维度":T["维度"]}
    结束

    # 矩阵运算
    如果 名字 == "矩阵乘法" 则 返回 张矩阵乘(实参[0], 实参[1]) 结束
    如果 名字 == "张量转置" 则 返回 张转置(实参[0]) 结束
    如果 名字 == "张量行列式" 则
        返回 张行列式(实参[0]["数据"], 实参[0]["形状"][0])
    结束
    如果 名字 == "张量迹" 则 返回 张迹(实参[0]) 结束

    # 索引与切片
    如果 名字 == "张量索引" 则
        让 idx = 切片(实参, 1, 长度(实参))
        返回 张索引取(实参[0], idx)
    结束
    如果 名字 == "张量切片" 则
        返回 张切片(实参[0], 转整数(实参[1]), 转整数(实参[2]), 转整数(实参[3]))
    结束

    # 聚合
    如果 名字 == "张量求和" 则 返回 累加(实参[0]["数据"]) 结束
    如果 名字 == "张量平均值" 则
        让 d = 实参[0]["数据"]
        返回 转浮点(累加(d)) / 转浮点(长度(d))
    结束
    如果 名字 == "张量最大值" 则
        让 d = 实参[0]["数据"]
        让 m = d[0]
        对于 i 从 1 到 长度(d) - 1 循环
            如果 d[i] > m 则 m = d[i] 结束
        结束
        返回 m
    结束
    如果 名字 == "张量最小值" 则
        让 d = 实参[0]["数据"]
        让 m = d[0]
        对于 i 从 1 到 长度(d) - 1 循环
            如果 d[i] < m 则 m = d[i] 结束
        结束
        返回 m
    结束
    如果 名字 == "张量按轴求和" 则
        返回 张轴和(实参[0], 转整数(实参[1]))
    结束
    如果 名字 == "张量展平" 则
        让 T = 实参[0]
        返回 {"类型":"张量","数据":T["数据"],"形状":[长度(T["数据"])],"维度":1}
    结束

    # 转换
    如果 名字 == "张量转列表" 则
        让 T = 实参[0]
        如果 T["维度"] == 0 则
            返回 T["数据"][0]
        结束
        让 盒 = [0]
        返回 张嵌套(T["形状"], 0, 盒, T["数据"])
    结束

    如果 名字 == "张量重塑" 则
        让 T = 实参[0]
        让 新形状 = 实参[1]
        如果 张元素数(新形状) != 长度(T["数据"]) 则
            返回 造内置异常("张量重塑错误: 元素总数不匹配")
        结束
        返回 {"类型":"张量","数据":T["数据"],"形状":新形状,"维度":长度(新形状)}
    结束

    如果 名字 == "打印张量" 则
        让 T = 实参[0]
        让 盒 = [0]
        输出(转字符串(张嵌套(T["形状"], 0, 盒, T["数据"])))
        返回 0
    结束

    # 辅助
    如果 名字 == "索引转扁平" 则
        返回 索引转扁平(实参[0], 实参[1])
    结束
    如果 名字 == "扁平转索引" 则
        返回 扁平转索引(实参[0], 实参[1])
    结束

    # ---- 自动微分引擎公共 API ----
    如果 名字 == "取" 则 返回 引_取实现(实参) 结束
    如果 名字 == "置" 则 返回 引_置实现(实参) 结束
    如果 名字 == "形状" 则 返回 引_形状(实参) 结束
    如果 名字 == "转置" 则 返回 引_转置(实参) 结束
    如果 名字 == "重塑" 则 返回 引_重塑(实参) 结束
    如果 名字 == "矩阵乘" 则 返回 引_矩阵乘(实参) 结束
    如果 名字 == "全零" 则 返回 引_全零(实参) 结束
    如果 名字 == "全一" 则 返回 引_全一(实参) 结束
    如果 名字 == "高斯随机" 则 返回 引_高斯随机(实参) 结束
    如果 名字 == "需梯度" 则 返回 引_需梯度(实参) 结束
    如果 名字 == "反向" 则 返回 引_反向(实参) 结束
    如果 名字 == "优化" 则 返回 引_优化(实参) 结束
    如果 名字 == "动量优化" 则 返回 引_动量优化(实参) 结束
    如果 名字 == "Adam" 则 返回 引_Adam(实参) 结束
    如果 名字 == "裁剪梯度" 则 返回 引_裁剪梯度(实参) 结束
    如果 名字 == "保存模型" 则 返回 引_保存模型(实参) 结束
    如果 名字 == "加载模型" 则 返回 引_加载模型(实参) 结束
    如果 名字 == "平均绝对误差" 则 返回 引_平均绝对误差(实参) 结束
    如果 名字 == "均方误差" 则 返回 引_均方误差(实参) 结束
    如果 名字 == "交叉熵" 则 返回 引_交叉熵(实参) 结束
    如果 名字 == "对数交叉熵" 则 返回 引_对数交叉熵(实参) 结束
    如果 名字 == "柔性最大值" 则 返回 引_柔性最大值(实参) 结束
    如果 名字 == "西格莫德" 则 返回 引_西格莫德(实参) 结束
    如果 名字 == "线性整流" 则 返回 引_线性整流(实参) 结束
    如果 名字 == "双曲正切" 则 返回 引_双曲正切(实参) 结束
    如果 名字 == "指数" 则 返回 引_指数实现(实参) 结束
    如果 名字 == "对数" 则 返回 引_对数实现(实参) 结束

    返回 造内置异常("未知张量函数: " + 名字)
结束

