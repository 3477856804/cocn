# 把张量内置占位注册到根环境
函数 注册张量内置(env)
    让 v = env["变量"][0]
    v["张量"] = {"类型":"内置","名字":"张量"}
    v["零张量"] = {"类型":"内置","名字":"零张量"}
    v["一张量"] = {"类型":"内置","名字":"一张量"}
    v["单位矩阵"] = {"类型":"内置","名字":"单位矩阵"}
    v["随机张量"] = {"类型":"内置","名字":"随机张量"}
