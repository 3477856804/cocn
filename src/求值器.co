# ============================================================
# 求值器.co —— coCN 树遍历求值器 + 全部内置函数库
#
# 本模块用 coCN 自身实现，对语法分析器产出的 AST 做树遍历求值。
# 严格遵守《重写规范.md》第三、四、五、八节。
#
# 导出函数：
#   新建环境() -> 字典            创建根环境，注册全部内置函数
#   求值(节点, 环境) -> 值         求值表达式节点
#   执行语句(语句, 环境) -> 值      执行语句节点（可能返回控制流/异常信号）
#   运行(源) -> 值                 一站式：导入语法分析器 -> 解析 -> 执行
# ============================================================

# ---------------- 基础工具：真值 / 信号判定 ----------------

# 把布尔判定转成整数 0/1（宿主 coCN 严格区分 布尔 与 整数）
函数 为整数(b) -> 整数
    如果 b 则
        返回 1
    结束
    返回 0
结束

# 真值判断：0、0.0、""、[]、{}、空 为假，其余为真
函数 真值(v) -> 整数
    让 t = 类型(v)
    如果 t == "整数" 或 t == "布尔" 则
        返回 为整数(v != 0)
    结束
    如果 t == "浮点" 则
        返回 为整数(v != 0.0)
    结束
    如果 t == "字符串" 或 t == "列表" 或 t == "字典" 则
        返回 为整数(长度(v) > 0)
    结束
    返回 0
结束

# 判断一个值是否是「AST 节点字典」（可选字段存在性检测用）
函数 是节点(v) -> 整数
    返回 为整数(类型(v) == "字典")
结束

# 构造异常信号字典（附带当前执行位置，捕获方能拿到 行/列）
函数 造异常(消息) -> 字典
    返回 {"__异常__": {"类型": "运行时错误", "消息": 消息, "行": g_当前行, "列": g_当前列}}
结束

# ---------------- 报错坐标（对齐宿主 runtime_error 的两条来源） ----------------
# 宿主 ./bin/引导器 的报错坐标有两个来源，实测结论（样例见 测试/坐标用例/）：
#   事实① 表达式错误出自 runtime_error(n, …) —— 用【那颗节点】make_node 时刻的坐标。
#          所以求值器在【即将报错的冷路径】上调 标(节点)，把节点坐标搬进 g_当前行/列，
#          再由 造异常 读出。绝不在求值入口/出口逐节点同步位置：
#          实测那条路把 fib(20) 从 13.6s 拖到 48s。
#   事实② 内置函数错误全部出自 runtime_error(NULL) —— 异常 行=0 列=0，
#          打印层（行>0 才带坐标）因此不带坐标。实测 40 个内置喂错类型，
#          除 等待（语言层语句，带坐标）外全部无坐标，所以 造内置异常 直接给 0/0。
#          例：平方根("甲") → 运行时错误: 平方根函数 需要数字参数，收到 字符串
#              下标 "a"      → 运行时错误: 下标必须是数字
#              未知内置函数   → 运行时错误: 未知内置函数: 表
#   标(节点) 只在报错前调用；坐标缺失（节点没盖到）时保留语句级坐标兜底。
函数 标(节点)
    如果 是节点(节点) 则
        如果 包含(节点, "行") 则
            g_当前行 = 节点["行"]
        结束
        如果 包含(节点, "列") 则
            g_当前列 = 节点["列"]
        结束
    结束
    返回 0
结束

# 内置分派族的异常：行=0 列=0（宿主 runtime_error(NULL)），打印层不带坐标。
函数 造内置异常(字符串 消息) -> 字典
    返回 {"__异常__": {"类型": "运行时错误", "消息": 消息, "行": 0, "列": 0}}
结束

# 无坐标报错族判定（求值器与虚拟机【共用这一份】，避免两条通道各自漂移）。
# 宿主里这些消息出自内置实现内部的 runtime_error(NULL)，即使报错点在语言层表达式里，
# 异常也是 0/0：实测 让 L = [1,2] 的 L["a"] → 无坐标「下标必须是数字」，
# 而同一行的 L[10] → 带坐标 (2,9)「列表索引越界」。两者消息族不同，正是这条规则。
# 判据只用【消息本身】，因此两通道拿到同一条消息必定给出同一形态。
函数 是无坐标消息(字符串 消息) -> 布尔
    如果 消息 == "下标必须是数字" 则
        返回 真
    结束
    # num_of 族：「X 需要数字参数，收到 Y」「X 收到空值」
    如果 包含(消息, "需要数字参数，收到") 则
        返回 真
    结束
    如果 包含(消息, "收到空值") 则
        返回 真
    结束
    # 调用位置分派族：宿主在 builtin 表里查不到名字时 runtime_error(NULL)，
    # 无论报错点在哪个表达式里都是 0/0（实测 e07 表(10)、e08 让 n=5 后 n(1)）。
    如果 包含(消息, "未知内置函数: ") 则
        返回 真
    结束
    返回 假
结束

# 共享分类器：由消息本身决定该条报错属于无坐标族（内置 runtime_error(NULL)），
# 还是带坐标族（用当前节点/语句坐标）。
函数 无坐标报错(字符串 消息) -> 字典
    如果 是无坐标消息(消息) 则
        返回 造内置异常(消息)
    结束
    返回 造异常(消息)
结束

# 未捕获异常的打印格式，逐字对齐宿主（实测 ./bin/引导器）：
#   行>0 → 「运行时错误 (第2行,9列): 列表索引越界: 10 (列表长度 2)」
#   行=0 → 「运行时错误: 下标必须是数字」          （内置族，不带坐标）
# 前缀取异常自身的 类型 字段：主动 抛出 的异常是「抛出」，宿主就打印
#   抛出 (第1行,1列): 纯文本
# 求值器与虚拟机【共用这一份】，两条通道的用户可见文案不可能漂移。
函数 打印异常(字典 异常)
    让 前缀 = "运行时错误"
    如果 包含(异常, "类型") 且 异常["类型"] != "" 且 异常["类型"] != "运行时错误" 则
        前缀 = 异常["类型"]
    结束
    让 消息 = "未知异常"
    如果 包含(异常, "消息") 则
        消息 = 转字符串(异常["消息"])
    结束
    让 行 = 0
    让 列 = 0
    如果 包含(异常, "行") 则
        行 = 转整数(异常["行"])
    结束
    如果 包含(异常, "列") 则
        列 = 转整数(异常["列"])
    结束
    如果 行 > 0 则
        输出错误(前缀 + " (第" + 转字符串(行) + "行," + 转字符串(列) + "列): " + 消息)
    否则
        输出错误(前缀 + ": " + 消息)
    结束
    返回 0
结束

# 格式化(模板, 参数...)：把每个 {} 依序换成一个参数的 转字符串。
# 宿主内置也支持最多 8 个位置参数，但自解释器这里拿到的是「已求值的实参列表」，
# 没有可变参数展开语法，直接在 .co 层用 分割 + 交错拼接实现，
# 语义与宿主对齐：占位符数 != 参数数时同样报中文错误。
# 求值器/虚拟机两条通道共用这一份（模块符号在同一根环境里合并）。
函数 内部格式化(实参)
    如果 长度(实参) < 1 则
        返回 造内置异常("格式化需要一个模板参数")
    结束
    让 模板 = 转字符串(实参[0])
    让 段 = 分割(模板, "{}")
    让 占位数 = 长度(段) - 1
    让 参数数 = 长度(实参) - 1
    如果 占位数 != 参数数 则
        返回 造内置异常("格式化模板有 " + 转字符串(占位数) + " 个占位符 {}，但提供了 " + 转字符串(参数数) + " 个参数")
    结束
    让 结果 = 段[0]
    对于 i 从 1 到 占位数 循环
        结果 = 结果 + 转字符串(实参[i]) + 段[i]
    结束
    返回 结果
结束

# 判断值是否是异常信号
# 【热路径】为整数(包含(...)) 原本是「一次 .co 函数调用 + 一次宿主内置调用」。
# 宿主 C 里 .co 函数调用要沿作用域链找函数名（链深 × 每层变量数 的 strcmp），
# 是异常/是异常或控制 在递归负载里每层要调好几次，这里把 为整数 展开成
# 直接返回 1/0 —— 判定结果逐字节不变，少一次作用域链遍历。
函数 是异常(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__异常__") 则
        返回 1
    结束
    返回 0
结束

# 判断值是否是控制流信号
函数 是控制(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__控制__") 则
        返回 1
    结束
    返回 0
结束

# 是异常或控制(v) -> 整数：一次类型判定 + 至多两次键判定
# 为什么要合并：执行块 里原本写「是异常(r) 或 是控制(r)」，
# 两者判定后走的分支完全相同（都直接 return r），却各付一次
# 函数调用 + 一次 类型() + 一次 包含()。循环体里每条语句都要走这一遍，
# 合并后每条语句少一次函数调用与一次类型判定。
函数 是异常或控制(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__异常__") 则
        返回 1
    结束
    如果 包含(v, "__控制__") 则
        返回 1
    结束
    返回 0
结束

# 当前正在执行的语句位置（语法分析器把 行/列 写进每条语句节点，执行时记录）
# 异常对象靠它报出「第几行第几列」——没有这两个字段，用户的 捕获 里拿不到定位信息。
让 g_当前行 = 0
让 g_当前列 = 0

# ---------------- 环境：变量链（分块字典，突破宿主单字典 256 键上限） ----------------
#
# 宿主 C 引导解释器的字典硬上限为 256 键，根环境注册 183 个内置函数后
# 几乎占满，标准库导入即溢出。故每层环境的变量不再存单个字典，而是
# 「分块字典列表」：env["变量"] = [块0, 块1, ...]，每块最多 200 键。
# 查找/赋值沿父链逐层、逐块线性扫描；声明时同层重名原地更新，否则追加到
# 末块，末块写满则新开一块。环境变量规模通常 < 500，线性扫描开销可忽略。

# 在一层的分块表里声明/覆盖变量：同层重名更新原块，否则追加末块（写满新开块）
函数 层声明(表, 名字, 值)
    对于 i 从 0 到 长度(表) - 1 循环
        让 块 = 表[i]
        如果 包含(块, 名字) 则
            块[名字] = 值
            返回 1
        结束
    结束
    整数 n = 长度(表)
    让 末块 = 表[n - 1]
    # 宿主 长度(字典) 数的就是「已用槽位数」，与 长度(键(字典)) 完全等价
    # （实测 键() 返回全部键、长度() 数 used 条目），但 键() 每次都要新建一个
    # 键列表（分配 + 拷贝）。声明路径上这是纯浪费，去掉。
    如果 长度(末块) >= 200 则
        末块 = {}
        追加(表, 末块)
    结束
    末块[名字] = 值
    返回 0
结束

# 把一层的全部分块导出合并成一个普通字典（模块导入合并/缓存/命名空间用）
函数 层导出字典(表)
    让 d = {}
    对于 i 从 0 到 长度(表) - 1 循环
        让 块 = 表[i]
        让 ks = 键(块)
        对于 j 从 0 到 长度(ks) - 1 循环
            d[ks[j]] = 块[ks[j]]
        结束
    结束
    返回 d
结束

# 沿父链查找变量；找不到返回 空
# 注意：调用方【不能】用「返回值 == 空」判断查无此名 —— 名字的值可能恰好是 空
# （实测 让 暂无 = 空 / 输出 暂无 在宿主就是 空）。需要存在性时用 变量已声明。
函数 查找变量(env, 名字)
    让 e = env
    当 e != 空 循环
        让 表 = e["变量"]
        对于 i 从 0 到 长度(表) - 1 循环
            让 块 = 表[i]
            如果 包含(块, 名字) 则
                返回 块[名字]
            结束
        结束
        e = e["父"]
    结束
    返回 空
结束

# 在当前层声明/覆盖变量
函数 声明变量(env, 名字, 值)
    层声明(env["变量"], 名字, 值)
结束

# 沿父链找到已有变量所在层并修改；找不到则在当前层新建
函数 赋值变量(env, 名字, 值)
    让 底 = env
    让 e = env
    当 e != 空 循环
        让 表 = e["变量"]
        对于 i 从 0 到 长度(表) - 1 循环
            让 块 = 表[i]
            如果 包含(块, 名字) 则
                块[名字] = 值
                返回 1
            结束
        结束
        e = e["父"]
    结束
    层声明(底["变量"], 名字, 值)
    返回 0
结束

# ---------------- 内置函数分发 ----------------

# 调用一个内置函数：名字 + 已求值的实参列表 -> 返回值
# 这里大量复用宿主 cocn 已经提供的原生内置函数。
函数 调用内置(名字, 实参)
    # ---- 输出与断言 ----
    如果 名字 == "输出" 则
        让 s = ""
        对于 i 从 0 到 长度(实参) - 1 循环
            如果 i > 0 则
                s = s + " "
            结束
            s = s + 值转字符串(实参[i])
        结束
        输出 s
        返回 0
    结束

    如果 名字 == "输出错误" 则
        让 s = ""
        对于 i 从 0 到 长度(实参) - 1 循环
            如果 i > 0 则
                s = s + " "
            结束
            s = s + 值转字符串(实参[i])
        结束
        # 必须用括号调用形式：宿主只把裸「输出 表达式」当特殊语句，
        # 「输出错误 s」会被解析成读取一个名为 输出错误 的变量 → 未定义变量。
        输出错误(s)
        返回 0
    结束

    如果 名字 == "断言" 则
        如果 非 真值(实参[0]) 则
            # 说明文字同样可选（同 断言相等，避免报错路径自己越界）
            让 说 = "（无说明）"
            如果 长度(实参) > 1 则
                说 = 转字符串(实参[1])
            结束
            输出错误("断言失败: " + 说)
            退出(1)
        结束
        返回 0
    结束

    如果 名字 == "断言相等" 则
        如果 实参[0] != 实参[1] 则
            # 第三参数（说明文字）是可选的：测试/原生/系统函数原生.co 里
            # 大量断言只传两个参数。以前无条件读 实参[2]，失败时先撞
            # 「列表索引越界: 2 (列表长度 2)」，真正的断言信息反而丢了。
            让 说明 = "（无说明）"
            如果 长度(实参) > 2 则
                说明 = 转字符串(实参[2])
            结束
            输出错误("断言失败 [" + 说明 + "]: 期望 " + 转字符串(实参[1]) + ", 实际 " + 转字符串(实参[0]))
            退出(1)
        结束
        返回 0
    结束

    # ---- 类型与长度 ----
    如果 名字 == "长度" 则
        # 张量：宿主对 长度(张量) 恒返回 1（实测 长度(全零([2,3])) → 1）。
        # 层的张量是带标记字典，不走这一支就会掉进宿主字典分支数出全部
        # 内部键（数据/形状/梯度/父/动量/一阶矩/二阶矩/步数/需梯度/维度 = 11），
        # 与宿主张量语义对不上——README 0.1.17 挂账的在案分歧，本轮收口。
        如果 是张量字典(实参[0]) 则 返回 1 结束
        返回 长度(实参[0])
    结束

    如果 名字 == "包含" 则
        返回 包含(实参[0], 实参[1])
    结束

    如果 名字 == "类型" 则
        让 v = 实参[0]
        如果 v == 空 则 返回 "空" 结束
        如果 类型(v) == "字典" 且 包含(v, "类型") 则
            如果 v["类型"] == "函数" 或 v["类型"] == "内置" 则
                返回 "函数"
            结束
            如果 v["类型"] == "张量" 则
                返回 "张量"
            结束
            如果 v["类型"] == "元组" 则
                返回 "元组"
            结束
            如果 v["类型"] == "枚举" 则
                返回 "枚举"
            结束
            如果 v["类型"] == "结构体" 则
                返回 v["结构体名"]
            结束
            # OOP：实例 → 其类名；类对象 → "类"
            如果 v["类型"] == "对象" 则
                返回 v["类名"]
            结束
            如果 v["类型"] == "类" 则
                返回 "类"
            结束
        结束
        返回 类型(v)
    结束

    如果 名字 == "转整数" 则
        返回 转整数(实参[0])
    结束
    如果 名字 == "转浮点" 则
        返回 转浮点(实参[0])
    结束
    如果 名字 == "转字符串" 则
        # 张量：走专门的渲染路径（嵌套列表 / 3维+摘要），不让内部字典泄露
        如果 是张量字典(实参[0]) 则
            返回 张量渲染(实参[0])
        结束
        # 列表：coCN 层递归拼接（宿主对列表元素的渲染有缺陷，会把 1 渲染成 真）
        如果 类型(实参[0]) == "列表" 则
            让 源表 = 实参[0]
            让 拼串 = "["
            对于 i 从 0 到 长度(源表) - 1 循环
                如果 i > 0 则
                    拼串 = 拼串 + ", "
                结束
                如果 类型(源表[i]) == "列表" 则
                    拼串 = 拼串 + 调用内置("转字符串", [源表[i]])
                否则
                    # 叶子走 值转字符串：列表里嵌张量时宿主原语会泄露内部键
                    拼串 = 拼串 + 值转字符串(源表[i])
                结束
            结束
            返回 拼串 + "]"
        结束
        返回 转字符串(实参[0])
    结束

    # 位计数(整数) -> 整数：64 位补码中 1 的个数
    如果 名字 == "位计数" 则
        让 数 = 实参[0]
        让 计 = 0
        让 位 = 0
        当 位 < 64 循环
            如果 (数 >> 位) & 1 则
                计 = 计 + 1
            结束
            位 = 位 + 1
        结束
        返回 计
    结束

    # 取位(整数, 位序) -> 整数：取第 n 位的值（0 或 1）
    如果 名字 == "取位" 则
        返回 (实参[0] >> 实参[1]) & 1
    结束

    # 置位(整数, 位序, 0或1) -> 整数：把第 n 位置 1 或清 0，返回新值（不改原值）
    如果 名字 == "置位" 则
        让 置数 = 实参[0]
        让 置位序 = 实参[1]
        如果 实参[2] 则
            返回 置数 | (1 << 置位序)
        结束
        返回 置数 & ~(1 << 置位序)
    结束

    # 转布尔(值) -> 布尔：任意值的真值语义转换为宿主真布尔
    # 假值：0 / 0.0 / 假 / 空 / 空串 / 空列表 / 空字典；其余为真
    如果 名字 == "转布尔" 则
        让 bv = 实参[0]
        让 bt = 类型(bv)
        如果 bt == "整数" 或 bt == "布尔" 则
            返回 bv != 0
        结束
        如果 bt == "浮点" 则
            返回 bv != 0.0
        结束
        如果 bt == "字符串" 或 bt == "列表" 或 bt == "字典" 则
            返回 长度(bv) > 0
        结束
        返回 0 == 1
    结束

    # 开头是(串, 前缀) -> 布尔：判断字符串是否以指定前缀开头
    如果 名字 == "开头是" 则
        让 整串 = 实参[0]
        让 前缀 = 实参[1]
        如果 长度(前缀) > 长度(整串) 则
            返回 0 == 1
        结束
        返回 截取(整串, 0, 长度(前缀)) == 前缀
    结束

    # 结尾是(串, 后缀) -> 布尔：判断字符串是否以指定后缀结尾
    如果 名字 == "结尾是" 则
        让 尾串 = 实参[0]
        让 后缀 = 实参[1]
        如果 长度(后缀) > 长度(尾串) 则
            返回 0 == 1
        结束
        返回 截取(尾串, 长度(尾串) - 长度(后缀), 长度(后缀)) == 后缀
    结束

    # 进制格式化：十六进制(255)="0xff"、十六进制(255, 6)="0x00ff"（第二参数为最小宽度，左补零）
    # 负数按 64 位补码呈现（逐半字节提取，宿主算术移位与位与精确）
    如果 名字 == "十六进制" 或 名字 == "二进制" 或 名字 == "八进制" 则
        让 数 = 实参[0]
        让 基数 = 16
        让 位表 = "0123456789abcdef"
        让 前缀 = "0x"
        让 每组位 = 4
        如果 名字 == "二进制" 则
            基数 = 2
            位表 = "01"
            前缀 = "0b"
            每组位 = 1
        结束
        如果 名字 == "八进制" 则
            基数 = 8
            位表 = "01234567"
            前缀 = "0o"
            每组位 = 3
        结束
        让 出 = ""
        若 数 == 0
            出 = "0"
        结束
        当 数 > 0 循环
            出 = 截取(位表, 数 % 基数, 1) + 出
            数 = 转整数(数 / 基数)
        结束
        # 负数：64 位补码位形（按组提取，宿主算术移位保持符号，位与取组精确）
        如果 数 < 0 则
            出 = ""
            让 移 = 0
            当 移 < 64 循环
                让 组 = (数 >> 移) & (基数 - 1)
                出 = 截取(位表, 组, 1) + 出
                移 = 移 + 每组位
            结束
            # 去前导零（至少保留一位）
            当 长度(出) > 1 循环
                若 截取(出, 0, 1) != "0"
                    跳出
                结束
                出 = 截取(出, 1, 长度(出))
            结束
        结束
        # 可选第二参数：最小位宽，不足左补零
        如果 长度(实参) > 1 则
            让 宽 = 转整数(实参[1])
            当 长度(出) < 宽 循环
                出 = "0" + 出
            结束
        结束
        返回 前缀 + 出
    结束

    # ---- OOP 类型判断 ----
    # 是实例(对象, 类名) → 整数：obj 是否为 类名 或其子类的实例（沿继承链判断）
    如果 名字 == "是实例" 则
        返回 是实例值(实参[0], 实参[1])
    结束
    # 父类(类名) → 字符串：返回该类的父类名；无父类或未注册返回 ""
    如果 名字 == "父类" 则
        返回 取父类名(实参[0])
    结束

    # ---- 数学 ----
    如果 名字 == "绝对值" 则 返回 绝对值(实参[0])
    # 平方根：宿主对非数字会 longjmp 直接终止进程（.co 的 尝试/捕获 拦不住），
    # 所以必须在这一层先校验。文案与 虚拟机.co 的 v_宿主内置 逐字节一致，
    # 也让 异常测试 里「内建函数参数错误可被捕获」在两通道都真的可捕获。
    如果 名字 == "平方根" 则
        如果 类型(实参[0]) != "整数" 且 类型(实参[0]) != "浮点" 则
            返回 造内置异常("平方根函数 需要数字参数，收到 " + 类型(实参[0]))
        结束
        返回 平方根(实参[0])
    结束
    如果 名字 == "取整" 则 返回 取整(实参[0])
    如果 名字 == "向下取整" 则 返回 向下取整(实参[0])
    如果 名字 == "向上取整" 则 返回 向上取整(实参[0])
    如果 名字 == "截断" 则 返回 截断(实参[0])
    如果 名字 == "符号" 则 返回 符号(实参[0])
    如果 名字 == "正弦" 则 返回 正弦(实参[0])
    如果 名字 == "余弦" 则 返回 余弦(实参[0])
    如果 名字 == "幂" 则 返回 幂(实参[0], 实参[1])
    如果 名字 == "圆周率" 则 返回 圆周率()

    如果 名字 == "最大值" 则
        如果 长度(实参) == 1 且 类型(实参[0]) == "列表" 则
            让 lst = 实参[0]
            让 m = lst[0]
            对于 i 从 1 到 长度(lst) - 1 循环
                如果 lst[i] > m 则
                    m = lst[i]
                结束
            结束
            返回 m
        结束
        返回 最大值(实参[0], 实参[1])
    结束

    如果 名字 == "最小值" 则
        如果 长度(实参) == 1 且 类型(实参[0]) == "列表" 则
            让 lst = 实参[0]
            让 m = lst[0]
            对于 i 从 1 到 长度(lst) - 1 循环
                如果 lst[i] < m 则
                    m = lst[i]
                结束
            结束
            返回 m
        结束
        返回 最小值(实参[0], 实参[1])
    结束

    如果 名字 == "自然对数" 则
        如果 长度(实参) == 1 则
            返回 自然对数(实参[0])
        结束
        返回 自然对数(实参[0]) / 自然对数(实参[1])
    结束

    # ---- 字符串 ----
    如果 名字 == "截取" 则 返回 截取(实参[0], 实参[1], 实参[2])
    如果 名字 == "查找" 则 返回 查找(实参[0], 实参[1])
    如果 名字 == "分割" 则 返回 分割(实参[0], 实参[1])
    如果 名字 == "连接" 则 返回 连接(实参[0], 实参[1])
    如果 名字 == "替换" 则 返回 替换(实参[0], 实参[1], 实参[2])
    如果 名字 == "大写" 则 返回 大写(实参[0])
    如果 名字 == "小写" 则 返回 小写(实参[0])
    如果 名字 == "去除空白" 则 返回 去空白(实参[0])
    # 去空白/去左空白/去右空白/字符码/码转字符：宿主都有同名原语，
    # 以前派发表只写了别名「去除空白」，正主 去空白 反而查不到（测试用的正是正主）。
    如果 名字 == "去空白" 则 返回 去空白(转字符串(实参[0]))
    如果 名字 == "去左空白" 则 返回 去左空白(转字符串(实参[0]))
    如果 名字 == "去右空白" 则 返回 去右空白(转字符串(实参[0]))
    如果 名字 == "字符码" 则
        # 宿主支持 字符码(单字符) 与 字符码(串, 下标) 两种形态，原样转发
        如果 长度(实参) >= 2 则
            返回 字符码(转字符串(实参[0]), 转整数(实参[1]))
        结束
        返回 字符码(转字符串(实参[0]))
    结束
    如果 名字 == "码转字符" 则 返回 码转字符(转整数(实参[0]))

    # ---- 列表 ----
    如果 名字 == "追加" 则 返回 追加(实参[0], 实参[1])
    如果 名字 == "反转" 则 返回 反转(实参[0])
    # 排序：宿主 排序(表[, 是否降序]) 是【就地】排序并返回同一个表（实测 r==s 为真），
    # 降序标志由宿主自己按真值判断。这里以前只传 实参[0]，第二参被静默丢掉——
    # 排序([3,1,2], 真) 返回升序，属于「跑得动但结果是错的」。
    # 中途版本用 反转(排序(...)) 造降序也错了：宿主 反转 是就地改表且返回 空，
    # 结果排序([3,1,2], 真) 变成 空。正确做法：校验后把第二参原样转发给宿主。
    如果 名字 == "排序" 则
        如果 长度(实参) < 1 或 长度(实参) > 2 则
            返回 造内置异常("排序函数需要1-2个参数（列表[, 是否降序]）")
        结束
        如果 语言类型(实参[0]) != "列表" 则
            返回 造内置异常("排序函数的第一个参数必须是列表")
        结束
        如果 长度(实参) == 1 则
            返回 排序(实参[0])
        结束
        返回 排序(实参[0], 实参[1])
    结束
    # 切片：宿主 切片(表, 起[, 止])，以前这里硬写 实参[2]——两参调用直接
    # 「列表索引越界: 2 (列表长度 2)」崩在层内（标准库测试「切片负起点到末尾」抓到）。
    # 宿主对越界/类型错误跨边界不可捕获，故层内先校验（文案逐字抄宿主实测），再转发。
    如果 名字 == "切片" 则
        如果 长度(实参) < 2 或 长度(实参) > 3 则
            返回 造内置异常("切片函数需要2-3个参数")
        结束
        让 目_ = 语言类型(实参[0])
        如果 目_ != "列表" 且 目_ != "字符串" 则
            返回 造内置异常("切片函数的第一个参数必须是列表或字符串")
        结束
        让 i1 = 语言类型(实参[1])
        如果 i1 != "整数" 且 i1 != "浮点" 且 i1 != "布尔" 则
            返回 造内置异常("切片 需要数字参数，收到 " + i1)
        结束
        如果 长度(实参) == 2 则
            返回 切片(实参[0], 实参[1])
        结束
        让 i2 = 语言类型(实参[2])
        如果 i2 != "整数" 且 i2 != "浮点" 且 i2 != "布尔" 则
            返回 造内置异常("切片 需要数字参数，收到 " + i2)
        结束
        返回 切片(实参[0], 实参[1], 实参[2])
    结束
    # 范围：以前这里硬写 范围(实参[0], 实参[1])，两个缺陷——
    # 单参 范围(5) 直接越界崩在 实参[1]；三参 范围(0,10,3) 静默丢掉步长，
    # 返回 [0..9]（编得过、跑得动、结果是错的，最危险的一类）。
    # 现在走本层的 范围实现（语义与宿主逐项对齐，见其注释）。
    如果 名字 == "范围" 则 返回 范围实现(实参)
    如果 名字 == "累加" 则 返回 累加(实参[0])
    如果 名字 == "去重" 则 返回 唯一(实参[0])
    如果 名字 == "插入" 则 返回 插入(实参[0], 实参[1], 实参[2])
    # 弹出：宿主支持 弹出(表) 与 弹出(表, 下标)（负下标可用，就地删除并返回被弹元素）。
    # 以前只转发 实参[0]，弹出(乙, 0) 静默弹了末尾——标准库测试「弹出指定下标」抓到。
    # 注意：宿主的下标越界/空表错误跨 .co 边界【不可捕获】（实测 eval/vm 直接 rc=1，
    # 尝试/捕获 根本不跑），所以必须在本层先校验并造出逐字同款异常，只有合法调用才转发。
    如果 名字 == "弹出" 则
        如果 长度(实参) < 1 或 长度(实参) > 2 则
            返回 造内置异常("弹出函数需要1-2个参数")
        结束
        如果 语言类型(实参[0]) != "列表" 则
            返回 造内置异常("弹出函数的第一个参数必须是列表")
        结束
        让 表_ = 实参[0]
        如果 长度(表_) == 0 则
            返回 造内置异常("无法从空列表弹出元素")
        结束
        如果 长度(实参) == 1 则
            返回 弹出(表_)
        结束
        # 下标：宿主接受 整数/浮点（向零截断）/布尔（真=1），其余报「需要数字参数」
        让 类_ = 语言类型(实参[1])
        如果 类_ != "整数" 且 类_ != "浮点" 且 类_ != "布尔" 则
            返回 造内置异常("弹出 需要数字参数，收到 " + 类_)
        结束
        让 下_ = 转整数(实参[1])
        如果 下_ < 0 - 长度(表_) 或 下_ >= 长度(表_) 则
            返回 造内置异常("弹出的下标越界")
        结束
        返回 弹出(表_, 下_)
    结束
    如果 名字 == "索引" 则 返回 索引(实参[0], 实参[1])
    如果 名字 == "计数" 则 返回 计数(实参[0], 实参[1])

    # ---- 字节级（宿主越界会 longjmp，无法被本解释器的 尝试/捕获 拦截，故先自行校验）----
    如果 名字 == "字节数" 则
        # 用 字节列表 的真实长度：宿主原语，UTF-8 精确（4 字节 emoji 也算 4）。
        # 之前这里用「非 ASCII 一律 3 字节」的启发式，😀 会算成 3，是静默算错。
        返回 长度(字节列表(转字符串(实参[0])))
    结束
    如果 名字 == "字节" 则
        让 bs = 实参[0]
        让 bi = 转整数(实参[1])
        让 bl = 字节列表(转字符串(bs))
        让 bn = 长度(bl)
        如果 bi < 0 则 bi = bi + bn 结束
        如果 bi < 0 或 bi >= bn 则
            返回 造内置异常("字节下标越界: " + 转字符串(实参[1]) + "（共 " + 转字符串(bn) + " 字节）")
        结束
        返回 bl[bi]
    结束
    如果 名字 == "字节列表" 则 返回 字节列表(实参[0])
    如果 名字 == "字节转文本" 则
        让 blst = 实参[0]
        对于 bj 从 0 到 长度(blst) - 1 循环
            让 bv = 转整数(blst[bj])
            如果 bv < 0 或 bv > 255 则
                返回 造内置异常("字节值须在 0~255 之间，第 " + 转字符串(bj) + " 项是 " + 转字符串(bv))
            结束
            如果 bv == 0 则
                返回 造内置异常("字节值不能是 0（字符串以 0 结尾，会被截断）")
            结束
        结束
        返回 字节转文本(blst)
    结束

    # ---- 字典 ----
    如果 名字 == "键" 则 返回 键(实参[0])
    如果 名字 == "值" 则 返回 值(实参[0])
    如果 名字 == "删除键" 则
        移除键(实参[0], 实参[1])
        返回 0
    结束
    如果 名字 == "条目" 则 返回 项(实参[0])

    # ---- 进制 ----
    如果 名字 == "十六进制" 则 返回 十六进制(实参[0])
    如果 名字 == "二进制" 则 返回 二进制(实参[0])
    如果 名字 == "八进制" 则 返回 八进制(实参[0])

    # ---- 随机 / 时间 ----
    如果 名字 == "随机" 则 返回 随机数()
    如果 名字 == "随机整数" 则 返回 随机整数(实参[0], 实参[1])
    如果 名字 == "现在" 则 返回 时钟()

    # ---- 输入 / 文件 / 系统 ----
    如果 名字 == "输入" 则 返回 输入(实参[0])
    如果 名字 == "读取文件" 则 返回 读文件(实参[0])
    如果 名字 == "写入文件" 则
        写文件(实参[0], 实参[1])
        返回 0
    结束
    如果 名字 == "执行" 则 返回 执行命令(实参[0])

    # ---- 抛出 ----
    如果 名字 == "错误" 则
        返回 造内置异常(转字符串(实参[0]))
    结束

    # ============ 新增内置函数：数学补充 ============
    如果 名字 == "双曲正弦" 则
        让 x = 转浮点(实参[0])
        返回 (幂(2.718281828459045, x) - 幂(2.718281828459045, -x)) / 2.0
    结束
    如果 名字 == "双曲余弦" 则
        让 x = 转浮点(实参[0])
        返回 (幂(2.718281828459045, x) + 幂(2.718281828459045, -x)) / 2.0
    结束
    如果 名字 == "双曲正切" 则
        让 x = 转浮点(实参[0])
        让 e1 = 幂(2.718281828459045, x)
        让 e2 = 幂(2.718281828459045, -x)
        返回 (e1 - e2) / (e1 + e2)
    结束
    如果 名字 == "反正弦" 则
        让 x = 转浮点(实参[0])
        如果 x < -1.0 或 x > 1.0 则
            返回 造内置异常("反正弦参数须在 -1 到 1 之间")
        结束
        如果 x >= 1.0 则 返回 1.5707963267948966 结束
        如果 x <= -1.0 则 返回 -1.5707963267948966 结束
        返回 反正切值(x / 平方根(1.0 - x * x))
    结束
    如果 名字 == "反余弦" 则
        让 x = 转浮点(实参[0])
        如果 x < -1.0 或 x > 1.0 则
            返回 造内置异常("反余弦参数须在 -1 到 1 之间")
        结束
        如果 x >= 1.0 则 返回 0.0 结束
        如果 x <= -1.0 则 返回 3.141592653589793 结束
        返回 1.5707963267948966 - 反正切值(x / 平方根(1.0 - x * x))
    结束
    如果 名字 == "反正切" 则
        返回 反正切值(转浮点(实参[0]))
    结束
    如果 名字 == "对数10" 则
        返回 自然对数(转浮点(实参[0])) / 自然对数(10.0)
    结束
    如果 名字 == "对数2" 则
        返回 自然对数(转浮点(实参[0])) / 自然对数(2.0)
    结束
    如果 名字 == "弧度转角度" 则
        返回 转浮点(实参[0]) * 180.0 / 圆周率()
    结束
    如果 名字 == "角度转弧度" 则
        返回 转浮点(实参[0]) * 圆周率() / 180.0
    结束
    如果 名字 == "最大公约数" 则
        返回 gcd值(转整数(实参[0]), 转整数(实参[1]))
    结束
    如果 名字 == "最小公倍数" 则
        返回 转整数(实参[0]) * 转整数(实参[1]) / gcd值(转整数(实参[0]), 转整数(实参[1]))
    结束
    如果 名字 == "阶乘" 则
        让 n = 转整数(实参[0])
        让 结果 = 1
        对于 i 从 2 到 n 循环
            结果 = 结果 * i
        结束
        返回 结果
    结束
    如果 名字 == "是素数" 则
        返回 是素数值(转整数(实参[0]))
    结束
    如果 名字 == "随机种子" 则
        种子值 = 转整数(实参[0])
        返回 0
    结束
    如果 名字 == "约束" 则
        让 v = 转浮点(实参[0])
        让 lo = 转浮点(实参[1])
        让 hi = 转浮点(实参[2])
        如果 v < lo 则 返回 lo 结束
        如果 v > hi 则 返回 hi 结束
        返回 v
    结束
    如果 名字 == "映射范围" 则
        返回 转浮点(实参[3]) + (转浮点(实参[0]) - 转浮点(实参[1])) * (转浮点(实参[4]) - 转浮点(实参[3])) / (转浮点(实参[2]) - 转浮点(实参[1]))
    结束
    如果 名字 == "线性插值" 则
        返回 转浮点(实参[0]) + (转浮点(实参[1]) - 转浮点(实参[0])) * 转浮点(实参[2])
    结束
    如果 名字 == "距离" 则
        让 dx = 转浮点(实参[2]) - 转浮点(实参[0])
        让 dy = 转浮点(实参[3]) - 转浮点(实参[1])
        返回 平方根(dx * dx + dy * dy)
    结束

    # ============ 新增内置函数：字符串补充 ============
    如果 名字 == "重复" 则
        返回 重复(转字符串(实参[0]), 转整数(实参[1]))
    结束
    如果 名字 == "填充左侧" 则
        返回 填充左值(转字符串(实参[0]), 转整数(实参[1]), 转字符串(实参[2]))
    结束
    如果 名字 == "填充右侧" 则
        返回 填充右值(转字符串(实参[0]), 转整数(实参[1]), 转字符串(实参[2]))
    结束
    如果 名字 == "居中" 则
        返回 居中值(转字符串(实参[0]), 转整数(实参[1]), 转字符串(实参[2]))
    结束
    如果 名字 == "以...开头" 则
        返回 开头是(转字符串(实参[0]), 转字符串(实参[1]))
    结束
    如果 名字 == "以...结尾" 则
        返回 结尾是(转字符串(实参[0]), 转字符串(实参[1]))
    结束
    如果 名字 == "计数子串" 则
        返回 计数子串值(转字符串(实参[0]), 转字符串(实参[1]))
    结束
    如果 名字 == "分割行" 则
        让 行s = 分割(转字符串(实参[0]), "\n")
        如果 长度(行s) > 0 且 行s[长度(行s) - 1] == "" 则
            弹出(行s)
        结束
        返回 行s
    结束
    如果 名字 == "去前缀" 则
        返回 去前缀值(转字符串(实参[0]), 转字符串(实参[1]))
    结束
    如果 名字 == "去后缀" 则
        返回 去后缀值(转字符串(实参[0]), 转字符串(实参[1]))
    结束
    如果 名字 == "是数字" 则
        返回 是数字值(转字符串(实参[0]))
    结束
    如果 名字 == "是字母" 则
        返回 是字母值(转字符串(实参[0]))
    结束
    如果 名字 == "是空白" 则
        返回 是空白值(转字符串(实参[0]))
    结束
    如果 名字 == "标题化" 则
        返回 标题化值(转字符串(实参[0]))
    结束
    如果 名字 == "交换大小写" 则
        返回 交换大小写值(转字符串(实参[0]))
    结束

    # ============ 新增内置函数：列表补充 ============
    # 全部满足/任一满足：宿主约定是 (列表, 函数)，README 与 布尔与比较测试
    # 也是这个顺序；本层此前按 (函数, 列表) 取参，实参一进来就把列表当函数调，
    # 报出与语义无关的「字典键必须是字符串」。现在按宿主顺序取参，并且把
    # 参数检查放在 .co 层做——宿主查无此名时会先报「未定义变量」，那类错误
    # 由 调用内置 之外的路径负责，这里只对齐宿主实证过的三条文案：
    #   需要2个参数（列表, 函数） / 第一个参数必须是列表 / 第二个参数必须是函数
    如果 名字 == "全部满足" 则
        让 表错 = 满足类校验("全部满足", 实参)
        如果 表错 != "" 则 返回 造内置异常(表错) 结束
        让 解 = 高次参数解析("全部满足", 实参)
        返回 全部满足值(解["函数"], 解["表"])
    结束
    如果 名字 == "任一满足" 则
        让 表错 = 满足类校验("任一满足", 实参)
        如果 表错 != "" 则 返回 造内置异常(表错) 结束
        让 解 = 高次参数解析("任一满足", 实参)
        返回 任一满足值(解["函数"], 解["表"])
    结束
    如果 名字 == "扁平化" 则
        让 结果 = []
        深展开(实参[0], 结果)
        返回 结果
    结束
    如果 名字 == "分组" 则
        返回 分组值(实参[0], 转整数(实参[1]))
    结束
    如果 名字 == "旋转" 则
        返回 旋转值(实参[0], 转整数(实参[1]))
    结束
    如果 名字 == "去相邻重复" 则
        返回 去相邻重复值(实参[0])
    结束
    如果 名字 == "压缩" 则
        返回 压缩值(实参[0], 实参[1])
    结束
    如果 名字 == "枚举" 则
        返回 枚举值(实参[0])
    结束
    如果 名字 == "最小值索引" 则
        返回 极值索引(实参[0], 0)
    结束
    如果 名字 == "最大值索引" 则
        返回 极值索引(实参[0], 1)
    结束
    如果 名字 == "累加和" 则
        返回 累加和值(实参[0])
    结束
    如果 名字 == "随机选取" 则
        让 n = 长度(实参[0])
        如果 n == 0 则 返回 造内置异常("无法从空列表随机选取") 结束
        返回 实参[0][随机整数(0, n - 1)]
    结束
    如果 名字 == "打乱" 则
        返回 打乱值(实参[0])
    结束

    # 合并字典：宿主是【就地】合并并把目标字典原样返回（实测 r == 目标 为真）。
    # 以前这里用本层 合并字典值 造了新字典，身份断言（系统函数测试）必挂。
    # 文案与宿主逐项对齐后转发宿主（宿主 1.5 之类截断行为也一并继承）。
    如果 名字 == "合并字典" 则
        如果 长度(实参) != 2 则
            返回 造内置异常("合并字典函数需要2个参数（目标字典, 源字典）")
        结束
        如果 语言类型(实参[0]) != "字典" 则
            返回 造内置异常("合并字典的第一个参数必须是字典，收到 " + 语言类型(实参[0]))
        结束
        如果 语言类型(实参[1]) != "字典" 则
            返回 造内置异常("合并字典的第二个参数必须是字典，收到 " + 语言类型(实参[1]))
        结束
        返回 合并字典(实参[0], 实参[1])
    结束
    如果 名字 == "反转字典" 则
        返回 反转字典值(实参[0])
    结束
    如果 名字 == "挑选" 则
        返回 挑选值(实参[0], 实参[1])
    结束
    如果 名字 == "省略" 则
        返回 省略值(实参[0], 实参[1])
    结束
    如果 名字 == "深拷贝" 则
        返回 深拷贝值(实参[0])
    结束

    # ============ 新增内置函数：系统 / 转换 ============
    如果 名字 == "执行命令" 则
        返回 运行并捕获(转字符串(实参[0]))
    结束
    如果 名字 == "退出码" 则
        返回 上次退出码
    结束
    如果 名字 == "环境变量" 则
        返回 环境变量(转字符串(实参[0]))
    结束

    # 读取命令行(默认值) -> 列表
    # 返回程序命令行参数（不含程序名），由 cocn 启动器经环境变量 COCN_ARGV
    # 以换行分隔传入。宿主不提供命令行参数能力，此为层扩展。
    # 无参数时返回传入的默认值列表；未提供默认值则返回空列表。
    # 注意：以换行分隔，故参数本身不应含换行（CLI 约定）。
    如果 名字 == "读取命令行" 则
        让 缺省 = []
        如果 长度(实参) >= 1 则
            缺省 = 实参[0]
        结束
        让 raw = 环境变量("COCN_ARGV")
        如果 raw == "" 则
            返回 缺省
        结束
        返回 分割(raw, "\n")
    结束
    如果 名字 == "设置环境变量" 则
        设置环境变量(转字符串(实参[0]), 转字符串(实参[1]))
        返回 0
    结束
    如果 名字 == "当前目录" 则
        返回 运行并捕获("pwd")
    结束
    如果 名字 == "切换目录" 则
        返回 运行并捕获("cd '" + 转字符串(实参[0]) + "' && pwd")
    结束
    如果 名字 == "目录存在" 则
        让 out = 运行并捕获("test -d '" + 转字符串(实参[0]) + "' && echo COCN_DIR_YES")
        返回 为整数(包含(out, "COCN_DIR_YES"))
    结束
    如果 名字 == "创建目录" 则
        运行并捕获("mkdir -p '" + 转字符串(实参[0]) + "'")
        返回 0
    结束
    如果 名字 == "列出目录" 则
        返回 列出目录值(转字符串(实参[0]))
    结束
    如果 名字 == "删除文件" 则
        # 宿主返回布尔（成功=真），测试里 断言(删除文件(...)) 要用这个返回值；
        # 以前写死 返回 0，等于把所有删除都报告成失败。
        返回 删除文件(转字符串(实参[0]))
    结束
    如果 名字 == "重命名" 则
        运行并捕获("mv '" + 转字符串(实参[0]) + "' '" + 转字符串(实参[1]) + "'")
        返回 0
    结束
    如果 名字 == "文件大小" 则
        返回 转整数(运行并捕获("stat -c %s '" + 转字符串(实参[0]) + "' 2>/dev/null"))
    结束
    如果 名字 == "文件修改时间" 则
        返回 转整数(运行并捕获("stat -c %Y '" + 转字符串(实参[0]) + "' 2>/dev/null"))
    结束
    如果 名字 == "睡眠" 则
        等待毫秒(转整数(转浮点(实参[0]) * 1000.0))
        返回 0
    结束
    如果 名字 == "时间戳" 则
        返回 时钟()
    结束
    如果 名字 == "格式化时间" 则
        返回 运行并捕获("date -d @" + 转字符串(转浮点(实参[0])) + " +'" + 转字符串(实参[1]) + "'")
    结束
    如果 名字 == "转ASCII" 则
        返回 字符码(转字符串(实参[0]))
    结束
    如果 名字 == "从ASCII" 则
        返回 码转字符(转整数(实参[0]))
    结束
    如果 名字 == "转字符" 则
        返回 码转字符(转整数(实参[0]))
    结束
    如果 名字 == "转码" 则
        返回 字符码(转字符串(实参[0]))
    结束

    # ============ 新增内置函数：类型检查 ============
    如果 名字 == "是整数" 则
        返回 为整数(类型(实参[0]) == "整数")
    结束
    如果 名字 == "是浮点" 则
        返回 为整数(类型(实参[0]) == "浮点")
    结束
    如果 名字 == "是字符串" 则
        返回 为整数(类型(实参[0]) == "字符串")
    结束
    如果 名字 == "是列表" 则
        返回 为整数(类型(实参[0]) == "列表")
    结束
    如果 名字 == "是字典" 则
        返回 为整数(类型(实参[0]) == "字典")
    结束
    如果 名字 == "是函数" 则
        让 v = 实参[0]
        如果 类型(v) == "字典" 且 包含(v, "类型") 且 (v["类型"] == "函数" 或 v["类型"] == "内置") 则
            返回 1
        结束
        返回 0
    结束
    如果 名字 == "是布尔" 则
        返回 为整数(类型(实参[0]) == "布尔")
    结束
    如果 名字 == "为空" 则
        返回 为整数(实参[0] == 空)
    结束

    # ---- 张量：统一分发到自实现的张量函数（见文件末尾）----
    如果 包含(张量名表, 名字) 则
        返回 张量分发(名字, 实参)
    结束

    # ---- 协作式并发 ----
    # 并发执行(任务列表)：依次等待所有任务（协作式），返回结果列表
    如果 名字 == "并发执行" 则
        让 任务列表 = 实参[0]
        让 结果 = []
        对于 i 从 0 到 长度(任务列表) - 1 循环
            让 r = 等待任务(任务列表[i])
            如果 是异常(r) 则 返回 r
            追加(结果, r)
        结束
        返回 结果
    结束

    # 让出()：协作式让出控制权（当前为空操作，为未来真线程并发预留接口）
    如果 名字 == "让出" 则
        返回 0
    结束

    # 任务状态(任务)：返回任务状态字符串（"待运行" / "已完成"）
    如果 名字 == "任务状态" 则
        让 t = 实参[0]
        如果 类型(t) != "字典" 或 非 包含(t, "类型") 或 t["类型"] != "任务" 则
            返回 造内置异常("任务状态 需要一个任务句柄")
        结束
        返回 t["状态"]
    结束

    # 高阶函数：映射/过滤 参数顺序做成无关（(表,函数) 与 (函数,表) 都接）。
    # 依据：宿主实测只认 (表,函数)（映射(平方,[1,2,3]) 报「映射函数的第一个
    # 参数必须是列表」），README 也写 (表, 函数)；但 函数测试/回归测试/并发测试/
    # 异常测试 用的是 (函数, 表)。硬取任一顺序都会让另一半测试红。
    如果 名字 == "映射" 则
        让 解 = 高次参数解析("映射", 实参)
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 fn = 解["函数"]
        让 lst = 解["表"]
        让 结果 = []
        对于 i 从 0 到 长度(lst) - 1 循环
            让 r = 调用值(fn, [lst[i]])
            如果 是异常(r) 则 返回 r
            追加(结果, r)
        结束
        返回 结果
    结束

    如果 名字 == "过滤" 则
        让 解 = 高次参数解析("过滤", 实参)
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 fn = 解["函数"]
        让 lst = 解["表"]
        让 结果 = []
        对于 i 从 0 到 长度(lst) - 1 循环
            让 r = 调用值(fn, [lst[i]])
            如果 是异常(r) 则 返回 r
            如果 真值(r) 则 追加(结果, lst[i])
        结束
        返回 结果
    结束

    # 归约：宿主约定 (表, 函数, 初值)；(函数, 表, 初值) 同样接受。
    如果 名字 == "归约" 则
        如果 长度(实参) < 2 则
            返回 造内置异常("归约函数需要至少2个参数（列表, 函数）")
        结束
        让 解 = 高次参数解析("归约", [实参[0], 实参[1]])
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 fn = 解["函数"]
        让 lst = 解["表"]
        让 acc = 0
        让 起 = 0
        如果 长度(实参) >= 3 则
            acc = 实参[2]
        否则
            如果 长度(lst) == 0 则 返回 造内置异常("归约空列表需要初始值") 结束
            acc = lst[0]
            起 = 1
        结束
        对于 i 从 起 到 长度(lst) - 1 循环
            让 r = 调用值(fn, [acc, lst[i]])
            如果 是异常(r) 则 返回 r
            acc = r
        结束
        返回 acc
    结束

    # 应用(函数, 参数列表) → 把列表摊开作为实参调用函数。
    # 与其它高阶函数不同：这里【不】做顺序无关——宿主语义就是函数在前、
    # 参数表在后（实测 应用(平方,[5]) 得 25），而 (表,函数) 的形态和
    # 映射/过滤 撞名，猜错顺序会把「用表当参数调用函数」悄悄跑通。
    如果 名字 == "应用" 则
        如果 长度(实参) != 2 则 返回 造内置异常("应用函数需要2个参数（函数, 参数列表）") 结束
        如果 非 值可调(实参[0]) 或 类型(实参[1]) != "列表" 则
            返回 造内置异常("应用函数的第一个参数必须是函数，第二个必须是参数列表")
        结束
        返回 调用值(实参[0], 实参[1])
    结束

    # 求和(列表|张量) → 转发宿主同名原语。
    # 自证：./bin/引导器 直跑 求和([1,2,3]) 得 6、求和([1.5,2]) 得 3.5、
    # 求和("abc") 报「求和需要1个张量或列表」（rc=1）。两条通道都转宿主，
    # 错误文案就与宿主逐字节一致，不会出现 eval/vm 各说各话。
    如果 名字 == "求和" 则
        返回 求和(实参[0])
    结束

    # ============ 宿主原语转发（缺陷修复：这些名字以前根本不在派发表里）============
    # 症状分两种：求值器通道报「未定义变量: 复制」，因为 注册内置 没登记它们；
    # 虚拟机通道更坏——v_宿主内置 末尾的 返回 0 把「不认识」伪装成「调用成功且返回 0」，
    # 于是 复制("你好") 得 0、时钟毫秒() 得 0，测试只是断言没炸而已。
    # 这里显式转发到宿主同名原语（宿主侧 复制/时钟毫秒/等待毫秒/写文件/读文件/
    # 文件存在/删除文件/格式化/字节 都已实证存在，见 引导器 直跑）。
    如果 名字 == "复制" 则
        # 宿主 复制(张量) 是【新建张量 + 拷贝数据】（co_old.c:3969），
        # 层的 复制 对字典是浅拷贝、内层 数据 列表共享，
        # 于是 让 张2 = 复制(张) 后 置(张2,...) 会连带改坏 张
        # （系统函数测试「张量深拷贝」断言就是被这条抓出来的：期望 1，实际 99）。
        # 所以张量走引擎的显式深拷贝，其余类型保持宿主原语不变。
        如果 引_是张量(实参[0]) 则
            返回 引_深拷贝张量(实参[0])
        结束
        # 宿主的 复制 对并发任务句柄是 runtime_error（co_old.c:3980
        # 「复制函数不支持复制并发任务句柄」）；层里句柄只是个字典，
        # 直接转给宿主就变成「浅拷贝成功」——错误用例 复制任务句柄 长期静默通过。
        如果 类型(实参[0]) == "字典" 且 包含(实参[0], "类型") 且 实参[0]["类型"] == "任务" 则
            返回 造内置异常("复制函数不支持复制并发任务句柄")
        结束
        返回 复制(实参[0])
    结束
    如果 名字 == "时钟毫秒" 则
        返回 时钟毫秒()
    结束
    如果 名字 == "等待毫秒" 则
        等待毫秒(转整数(实参[0]))
        返回 0
    结束
    如果 名字 == "写文件" 则
        写文件(转字符串(实参[0]), 转字符串(实参[1]))
        返回 0
    结束
    如果 名字 == "读文件" 则
        返回 读文件(转字符串(实参[0]))
    结束
    如果 名字 == "文件存在" 则
        返回 文件存在(转字符串(实参[0]))
    结束
    # 格式化：.co 层自己展开（见 内部格式化），不受宿主 8 参上限约束
    如果 名字 == "格式化" 则
        返回 内部格式化(实参)
    结束

    # ============ 宿主同名、但此前【既没注册也没实现】的值级内置 ============
    # 这些名字宿主早就有（实测见各行注释），自举层一直是空洞：程序里一用就
    # 「未定义变量」。全部在本层实现/校验，错误文案逐字节抄宿主实测——因为
    # 宿主的参数错误是跨不过 .co 边界的 longjmp（实测 尝试/捕获 拦不住），
    # 而测试要求它们可捕获。数值型标量在 校验 通过后转发宿主，保证结果一致。
    如果 名字 == "唯一" 则
        如果 长度(实参) != 1 则 返回 造内置异常("唯一函数需要1个参数") 结束
        如果 语言类型(实参[0]) != "列表" 则 返回 造内置异常("唯一函数的参数必须是列表") 结束
        # 去重交给宿主：宿主按自身等值语义去重（实测 [1,"1",1]→[1,"1"]、
        # [真,1]→[真]），本层用 转字符串 当键反而算错。校验留在本层只为
        # 拿到可捕获的中文错误，真算的时候口径必须跟宿主一致。
        返回 唯一(实参[0])
    结束
    如果 名字 == "扁平" 则
        如果 长度(实参) != 1 则 返回 造内置异常("扁平函数需要1个参数") 结束
        如果 语言类型(实参[0]) != "列表" 则 返回 造内置异常("扁平函数的参数必须是列表") 结束
        返回 扁平(实参[0])
    结束
    如果 名字 == "均值" 则
        如果 长度(实参) != 1 则 返回 造内置异常("均值函数需要1个参数") 结束
        让 v0 = 实参[0]
        如果 语言类型(v0) != "列表" 则
            返回 造内置异常("均值需要1个张量或列表")
        结束
        如果 长度(v0) == 0 则 返回 造内置异常("均值不能作用于空列表") 结束
        让 total = 0
        对于 i 从 0 到 长度(v0) - 1 循环
            让 元素型 = 语言类型(v0[i])
            如果 元素型 != "整数" 且 元素型 != "浮点" 且 元素型 != "布尔" 则
                返回 造内置异常("均值 需要数字参数，收到 " + 元素型)
            结束
            total = total + v0[i]
        结束
        返回 total / 长度(v0)
    结束
    如果 名字 == "项" 则
        如果 长度(实参) != 1 则 返回 造内置异常("项函数需要1个参数") 结束
        如果 语言类型(实参[0]) != "字典" 则 返回 造内置异常("项函数的参数必须是字典") 结束
        返回 项(实参[0])
    结束
    如果 名字 == "移除键" 则
        如果 长度(实参) != 2 则 返回 造内置异常("移除键函数需要2个参数") 结束
        如果 语言类型(实参[0]) != "字典" 则 返回 造内置异常("移除键函数的第一个参数必须是字典") 结束
        # 宿主 移除键 是就地删除并返回 1/0（实测：命中 1、未命中 0、字典长度 -1）。
        # 本层早期版本调了个【不存在的】 删除键 —— 宿主报「未知内置函数: 删除键」，
        # 那种错在 .co 层是拦不住的 longjmp，只能靠这种直转保证同源。
        返回 移除键(实参[0], 实参[1])
    结束
    如果 名字 == "删除" 则
        # 宿主 删除(列表, 下标) 是【就地】删除并返回同一个表（实测 r == c 为真，
        # 且原表同步变短）。中途版本造新表返回，身份/副作用都对不上宿主。
        # 越界文案宿主自己也能报（"列表索引越界: 9（列表长度 3）"），但跨 .co 边界
        # 转发不可捕获，故先在层内校验并造同款异常；合法时下标再转发宿主就地执行。
        如果 长度(实参) != 2 则 返回 造内置异常("删除函数需要2个参数") 结束
        让 lst = 实参[0]
        如果 语言类型(lst) != "列表" 则 返回 造内置异常("删除函数的第一个参数必须是列表") 结束
        让 类型串 = 语言类型(实参[1])
        如果 类型串 != "整数" 且 类型串 != "浮点" 且 类型串 != "布尔" 则
            返回 造内置异常("删除 需要数字参数，收到 " + 类型串)
        结束
        让 n = 长度(lst)
        # 宿主对浮点下标向零截断（删除([1,2,3], 1.5) → [1, 3]），转整数 同为向零截断；
        # 越界文案用的也是【截断后】的整数（删除([1,2,3], 9.5) → 「列表索引越界: 9…」）。
        让 idx = 转整数(实参[1])
        如果 非 删除下标合法(idx, n) 则
            返回 造内置异常("列表索引越界: " + 转字符串(idx) + "（列表长度 " + 转字符串(n) + "）")
        结束
        删除(lst, idx)
        返回 lst
    结束
    如果 名字 == "时钟" 则
        # 宿主 时钟() 返回 Unix 秒（浮点），多传参数宿主不挑（实测 时钟(1) 正常）。
        # 但本层不能直接 实参[0]——0 参调用会先崩在取参上（自己的假红）。
        如果 长度(实参) == 0 则 返回 时钟() 结束
        返回 时钟(实参[0])
    结束
    如果 名字 == "随机数" 则
        如果 长度(实参) == 0 则 返回 随机数() 结束
        返回 随机数(实参[0])
    结束
    如果 名字 == "正切" 则
        让 et = 正切校验(实参)
        如果 et != "" 则 返回 造内置异常(et) 结束
        返回 正切(实参[0])
    结束
    如果 名字 == "追加文件" 则
        让 路径 = 转字符串(实参[0])
        让 内容 = 转字符串(实参[1])
        让 现有 = ""
        如果 文件存在(路径) 则
            现有 = 读文件(路径)
        结束
        写文件(转字符串(实参[0]), 现有 + 内容)
        返回 1
    结束
    如果 名字 == "读取行" 则
        让 路径 = 转字符串(实参[0])
        如果 非 文件存在(路径) 则
            返回 造内置异常("无法打开文件: " + 路径)
        结束
        让 内容 = 读文件(路径)
        # 宿主语义（实测）：按换行切分，【保留中间空行】，只把结尾换行产生的
        # 那一个空尾巴去掉；空文件得 []。
        #   "a\n\nb\n\n" → [a, , b, ]；"a\nb\nc\n" → [a,b,c]；"" → []
        如果 内容 == "" 则 返回 [] 结束
        让 行s = 分割(内容, "\n")
        让 n = 长度(行s)
        如果 n > 0 且 行s[n - 1] == "" 且 截取(内容, 长度(内容) - 1, 1) == "\n" 则
            返回 切片(行s, 0, n - 1)
        结束
        返回 行s
    结束
    如果 名字 == "退出" 则
        如果 长度(实参) != 1 则
            返回 造内置异常("退出函数需要1个参数（状态码）")
        结束
        让 码型 = 语言类型(实参[0])
        如果 码型 != "整数" 且 码型 != "浮点" 且 码型 != "布尔" 则
            返回 造内置异常("退出 需要数字参数，收到 " + 码型)
        结束
        退出(转整数(实参[0]))
        返回 0
    结束

    返回 造内置异常("未知内置函数: " + 名字)
结束

# 删除/取/置 共用的下标合法性：宿主负索引 -n..n-1 合法，越界报「列表索引越界」
函数 删除下标合法(整数 idx, 整数 n) -> 布尔
    如果 n == 0 则 返回 假 结束
    返回 idx >= 0 - n 且 idx < n
结束

# 正切/退出这类「宿主只吃标量数字」的校验：文案抄宿主实测
# （「正切 需要数字参数，收到 字符串」——注意是半角空格 + 「收到」）。
函数 正切校验(实参) -> 字符串
    如果 长度(实参) != 1 则 返回 "正切函数需要1个参数" 结束
    让 t = 语言类型(实参[0])
    如果 t != "整数" 且 t != "浮点" 且 t != "布尔" 则
        返回 "正切 需要数字参数，收到 " + t
    结束
    返回 ""
结束

# ---------------- 新增内置函数的辅助实现 ----------------

让 上次退出码 = 0
让 种子值 = 1

# 求值临时目录：优先 TMPDIR（Android/Termux 的 /tmp 通常不可写），否则 /tmp
函数 求值临时目录()
    让 t = 环境变量("TMPDIR")
    如果 t == "" 或 t == 空 则
        返回 "/tmp"
    结束
    返回 t
结束

# 运行 shell 命令并捕获标准输出（去首尾空白）；同时记录打包退出码
函数 运行并捕获(命令)
    让 捕获文件 = 求值临时目录() + "/cocn_captured_out.txt"
    让 rc = 执行命令(命令 + " > '" + 捕获文件 + "' 2>&1")
    上次退出码 = 转整数(rc) / 256
    返回 去空白(读文件(捕获文件))
结束

# 反正切（泰勒级数 + 区间约化）
函数 反正切值(x)
    让 符号 = 1.0
    让 z = 转浮点(x)
    如果 z < 0.0 则
        z = -z
        符号 = -1.0
    结束
    让 反向 = 0.0
    如果 z > 1.0 则
        z = 1.0 / z
        反向 = 1.5707963267948966
    结束
    让 项 = z
    让 总和 = z
    让 幂 = z * z
    对于 k 从 1 到 60 循环
        项 = 项 * 幂
        如果 k % 2 == 1 则
            总和 = 总和 - 项 / (2 * k + 1)
        否则
            总和 = 总和 + 项 / (2 * k + 1)
        结束
    结束
    如果 反向 > 0.0 则
        返回 符号 * (反向 - 总和)
    结束
    返回 符号 * 总和
结束

函数 gcd值(a, b)
    让 x = a
    让 y = b
    当 y != 0 循环
        让 t = x % y
        x = y
        y = t
    结束
    如果 x < 0 则 x = -x 结束
    返回 x
结束

函数 是素数值(n)
    如果 n < 2 则 返回 0 结束
    如果 n == 2 则 返回 1 结束
    如果 n % 2 == 0 则 返回 0 结束
    让 因子 = 3
    当 因子 * 因子 <= n 循环
        如果 n % 因子 == 0 则 返回 0 结束
        因子 = 因子 + 2
    结束
    返回 1
结束

函数 填充左值(s, 宽度, 符)
    让 r = s
    当 长度(r) < 宽度 循环
        r = 符 + r
    结束
    返回 r
结束

函数 填充右值(s, 宽度, 符)
    让 r = s
    当 长度(r) < 宽度 循环
        r = r + 符
    结束
    返回 r
结束

函数 居中值(s, 宽度, 符)
    让 缺 = 宽度 - 长度(s)
    如果 缺 <= 0 则 返回 s 结束
    让 左 = 转整数(缺 / 2)
    返回 填充右值(填充左值(s, 长度(s) + 左, 符), 宽度, 符)
结束

函数 计数子串值(s, 子)
    让 计数 = 0
    让 n = 长度(s)
    让 m = 长度(子)
    如果 m == 0 则 返回 0 结束
    让 i = 0
    当 i <= n - m 循环
        如果 截取(s, i, m) == 子 则
            计数 = 计数 + 1
            i = i + m
        否则
            i = i + 1
        结束
    结束
    返回 计数
结束

函数 去前缀值(s, 前缀)
    如果 开头是(s, 前缀) 则
        返回 截取(s, 长度(前缀), 长度(s) - 长度(前缀))
    结束
    返回 s
结束

函数 去后缀值(s, 后缀)
    如果 结尾是(s, 后缀) 则
        返回 截取(s, 0, 长度(s) - 长度(后缀))
    结束
    返回 s
结束

函数 是数字值(s)
    如果 长度(s) == 0 则 返回 0 结束
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = 字符码(s[i])
        如果 c < 48 或 c > 57 则 返回 0 结束
    结束
    返回 1
结束

函数 是字母值(s)
    如果 长度(s) == 0 则 返回 0 结束
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = 字符码(s[i])
        如果 (c < 65 或 c > 90) 且 (c < 97 或 c > 122) 则 返回 0 结束
    结束
    返回 1
结束

函数 是空白值(s)
    如果 长度(s) == 0 则 返回 1 结束
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = 字符码(s[i])
        如果 c != 32 且 c != 9 且 c != 10 且 c != 13 则 返回 0 结束
    结束
    返回 1
结束

函数 标题化值(s)
    让 结果 = ""
    让 新词 = 1
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = s[i]
        如果 c == " " 则
            结果 = 结果 + c
            新词 = 1
        否则
            如果 新词 则
                结果 = 结果 + 大写(c)
                新词 = 0
            否则
                结果 = 结果 + 小写(c)
            结束
        结束
    结束
    返回 结果
结束

函数 交换大小写值(s)
    让 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = s[i]
        让 码 = 字符码(c)
        如果 码 >= 65 且 码 <= 90 则
            结果 = 结果 + 小写(c)
        否则
            如果 码 >= 97 且 码 <= 122 则
                结果 = 结果 + 大写(c)
            否则
                结果 = 结果 + c
            结束
        结束
    结束
    返回 结果
结束

# 高阶函数（映射/过滤/归约/应用/全部满足/任一满足）实参解析。
# 事实：宿主只认 (列表, 函数)（实测 映射(平方,[1,2,3]) 报「映射函数的第一个
# 参数必须是列表」），README 与 标准库测试/边界测试 也是 (表, 函数)；
# 但 函数测试/回归测试/并发测试/异常测试 里写的是 (函数, 表)。
# 两渠道此前各按一种顺序硬取，另一种写法就崩。这里做成顺序无关：
# 认出哪个是列表、哪个可调用，两种写法都接；都认不出来才按宿主的
# (表, 函数) 约定报错（文案与宿主逐字节一致）。
# 返回 {"表": 列表, "函数": 可调用, "错": ""} 或 {"错": "消息"}。
# 放在 求值器.co 顶层：VM 通道和 eval 通道共用同一根环境，两边都调这一份。
函数 高次参数解析(名字, 实参) -> 字典
    # 先挡参数个数：宿主实测 映射([1,2,3]) 报「映射函数需要2个参数（列表, 函数）」。
    # 少了这一层，下面直接取 实参[1] 会越界崩在半路，报出跟语义无关的错。
    如果 长度(实参) != 2 则
        返回 {"表": 0, "函数": 0, "错": 名字 + "函数需要2个参数（列表, 函数）"}
    结束
    让 甲 = 实参[0]
    让 乙 = 实参[1]
    让 甲是表 = 类型(甲) == "列表"
    让 乙是表 = 类型(乙) == "列表"
    让 乙可调 = 值可调(乙)
    让 甲可调 = 值可调(甲)
    如果 甲是表 且 乙可调 则
        返回 {"表": 甲, "函数": 乙, "错": ""}
    结束
    如果 甲可调 且 乙是表 则
        返回 {"表": 乙, "函数": 甲, "错": ""}
    结束
    如果 非 甲是表 则
        返回 {"错": 名字 + "函数的第一个参数必须是列表"}
    结束
    返回 {"错": 名字 + "函数的第二个参数必须是函数"}
结束

函数 值可调(v) -> 布尔
    # 两种上下文都要对：本函数是【库层】代码，跑在宿主 C 解释器里，
    # 那里的 类型() 是宿主原语——用户函数值（带 "类型":"函数" 的字典）
    # 在宿主眼里是 "字典"；而用户程序里写的 类型(f) 走语言层分派，得 "函数"。
    # 只认其中一种就会把合法谓词全判成非法（我第一版就踩了这条）。
    让 t = 类型(v)
    如果 t == "函数" 则 返回 真 结束
    如果 t != "字典" 则 返回 假 结束
    如果 非 包含(v, "类型") 则 返回 假 结束
    返回 v["类型"] == "函数" 或 v["类型"] == "内置" 或 v["类型"] == "绑定方法"
结束

函数 满足类校验(字符串 名, 实参) -> 字符串
    如果 长度(实参) != 2 则
        返回 名 + "函数需要2个参数（列表, 函数）"
    结束
    让 解 = 高次参数解析(名, 实参)
    返回 解["错"]
结束

# 语言层的 类型 名（给库内部用）。不能直接调 类型：本文件跑在宿主 C 解释器
# 里，那里的 类型 是宿主原语——用户函数在语言层是 {"类型":"函数",...} 的
# 字典，宿主只报「字典」，错误文案就错了。这里委托 调用内置 的 类型 分支，
# 保持单一事实来源，不再抄一份会漂移的副本。
函数 语言类型(v) -> 字符串
    返回 调用内置("类型", [v])
结束

# ---------------- 宿主语义的公共校验（求值器/虚拟机两条通道共用这一份） ----------------
#
# 为什么需要一个专门的「宿主类型名」而不是直接用 类型()：
# 自举层自己跑在宿主里，宿主的 类型() 对张量/函数/任务这些【自定义字典】
# 一律返回「字典」。要抄宿主的报错文案（val_type_name，co_old.c:4685），
# 就必须按字段把它们还原成「张量」「函数」「任务」。
# 注意：这段代码在【库上下文】（求值器/虚拟机的函数体）和宿主上下文都能成立，
# 因为两条通道的运行时都是宿主。
函数 宿主类型名(v) -> 字符串
    让 t = 类型(v)
    如果 t != "字典" 则
        返回 t
    结束
    如果 非 包含(v, "类型") 则
        返回 "字典"
    结束
    让 k = v["类型"]
    如果 k == "张量" 则 返回 "张量" 结束
    如果 k == "函数" 或 k == "内置" 或 k == "绑定方法" 则 返回 "函数" 结束
    如果 k == "任务" 则 返回 "任务" 结束
    如果 k == "元组" 则 返回 "元组" 结束
    返回 "字典"
结束

# 宿主 num_of（co_old.c:2810）的等价物：整数/浮点/布尔放行（真=1 假=0），
# 其余报「谁 需要数字参数，收到 X」。用于 对于 的起点/终点/步长。
函数 数值参数(值, 谁) -> 字典
    让 名 = 宿主类型名(值)
    如果 名 == "整数" 或 名 == "浮点" 则
        返回 {"错误": "-", "值": 值}
    结束
    如果 名 == "布尔" 则
        如果 值 则 返回 {"错误": "-", "值": 1} 结束
        返回 {"错误": "-", "值": 0}
    结束
    返回 {"错误": 谁 + " 需要数字参数，收到 " + 名, "值": 0}
结束

# 宿主 idx_val（co_old.c:549）的等价物：列表/字符串/元组的下标必须是数字，
# 曾经这里裸转整数，表["键"] 会静默取到第 1 个元素——「跑得动但结果是错的」。
函数 下标数字错(idx) -> 字符串
    让 名 = 宿主类型名(idx)
    如果 名 == "整数" 或 名 == "浮点" 或 名 == "布尔" 则
        返回 ""
    结束
    返回 "下标必须是数字"
结束

# 宿主 type_matches（co_old.c:5069）逐条对照：
#   整数 只接 INT；浮点/数字 接 FLOAT 或 INT（数值加宽，布尔仍拒绝）；
#   字符串/布尔/列表/字典/张量/空 严格；函数值→函数；任意/未知标注放行。
# 层内差异（诚实记录）：张量、对象实例在层里都是字典，所以「字典」标注
# 对它们放行——宿主那边张量是独立类型，会被拒。
函数 类型相符(字符串 标注, v) -> 整数
    如果 标注 == "" 或 标注 == "任意" 则 返回 1 结束
    让 名 = 宿主类型名(v)
    如果 标注 == "函数值" 则 标注 = "函数" 结束
    如果 标注 == "整数" 则 返回 为整数(名 == "整数") 结束
    如果 标注 == "浮点" 则 返回 为整数(名 == "浮点" 或 名 == "整数") 结束
    如果 标注 == "数字" 则 返回 为整数(名 == "浮点" 或 名 == "整数") 结束
    如果 标注 == "字符串" 则 返回 为整数(名 == "字符串") 结束
    如果 标注 == "布尔" 则 返回 为整数(名 == "布尔") 结束
    如果 标注 == "列表" 则 返回 为整数(名 == "列表") 结束
    如果 标注 == "字典" 则 返回 为整数(名 == "字典" 或 名 == "张量" 或 名 == "对象") 结束
    如果 标注 == "张量" 则 返回 为整数(名 == "张量") 结束
    如果 标注 == "函数" 则 返回 为整数(名 == "函数") 结束
    如果 标注 == "空" 则 返回 为整数(名 == "空") 结束
    返回 1
结束

# 宿主 ensure_type 的文案（全角括号 + 全角冒号，实测逐字节抄自 ./bin/引导器）
函数 类型错误消息(字符串 标注, v, 字符串 哪里) -> 字符串
    返回 "类型错误（" + 哪里 + "）：期望 " + 标注 + "，得到 " + 宿主类型名(v)
结束

# 带标注的变量声明：把标注记进本层的「类型表」，之后每次赋值都按它复查
# （宿主 env_set_type/env_get_type，co_old.c:993/1017）。
函数 记标注(env, 名字, 字符串 标注)
    如果 非 包含(env, "类型表") 则
        env["类型表"] = {}
    结束
    env["类型表"][名字] = 标注
结束

# 沿父链判断名字是否已声明（区别于 查找变量：变量可以被显式赋 空，
# 那时 查找变量 返回 空，会被误判成「没声明过」——宿主的 常量不能重复声明
# 用的是 env_get 指针是否存在，这里按【键存在性】走同一套分块扫描。
函数 变量已声明(env, 名字) -> 整数
    让 e = env
    当 e != 空 循环
        让 表 = e["变量"]
        对于 i 从 0 到 长度(表) - 1 循环
            如果 包含(表[i], 名字) 则
                返回 1
            结束
        结束
        e = e["父"]
    结束
    返回 0
结束

# 沿作用域链查标注，语义严格对齐宿主 env_get_type（co_old.c:1017）：
# 命中【第一个声明了该名字的层】就返回它的标注，没记标注就返回空——
# 不能继续往父层找。否则「内层 让 数 = 0 遮蔽外层 列表 数」会被误判成
# 「期望 列表」（闭包计数器、记忆化那类标准库写法当场就红）。
函数 查标注(env, 名字) -> 字符串
    让 e = env
    当 e != 空 循环
        让 表 = e["变量"]
        让 命中 = 0
        对于 i 从 0 到 长度(表) - 1 循环
            如果 包含(表[i], 名字) 则
                命中 = 1
                跳出
            结束
        结束
        如果 命中 == 1 则
            如果 包含(e, "类型表") 且 包含(e["类型表"], 名字) 则
                返回 e["类型表"][名字]
            结束
            返回 ""
        结束
        e = e["父"]
    结束
    返回 ""
结束

# 层里的张量是带 "类型": "张量" 标记的字典；这个判定在 下标读/元素写/链式写
# 三处都要用，抽出来免得三处写法漂移。
函数 是张量字典(v) -> 整数
    返回 为整数(类型(v) == "字典" 且 包含(v, "类型") 且 v["类型"] == "张量")
结束

# 张量渲染（对齐宿主 co_old.c 的张量打印，实测 /tmp/probe/p1-p9）：
#   一维   → [0, 0, 0]
#   二维   → [[0, 0, 0], [0, 0, 0]]（按行宽切分，", " 分隔）
#   三维+ → <张量 3维 size=8> 摘要形式
# 层的张量是带标记字典，宿主原语 转字符串 对它只能渲染出全部内部键
# （数据/形状/梯度/父/动量/一阶矩/二阶矩/步数/需梯度/维度…），
# 「跑得动但泄露实现细节」——宿主对张量有专门打印路径，两层必须逐字一致。
# 输出/转字符串/字符串拼接三条入口都经 转字符串 内置，在那里挂接即可全覆盖。
函数 张量行渲染(行) -> 字符串
    让 出 = "["
    对于 i 从 0 到 长度(行) - 1 循环
        如果 i > 0 则 出 = 出 + ", " 结束
        出 = 出 + 转字符串(行[i])
    结束
    返回 出 + "]"
结束

函数 张量渲染(v) -> 字符串
    让 维 = 0
    如果 包含(v, "维度") 则 维 = 转整数(v["维度"]) 结束
    如果 维 >= 3 则
        返回 "<张量 " + 转字符串(维) + "维 size=" + 转字符串(张元素数(v["形状"])) + ">"
    结束
    让 数据 = v["数据"]
    如果 维 <= 1 则
        返回 张量行渲染(数据)
    结束
    # 二维：行优先切分（展平数据 + 形状[1] 行宽）
    让 形状 = v["形状"]
    让 行宽 = 转整数(形状[1])
    让 行数 = 转整数(形状[0])
    让 出 = "["
    对于 r 从 0 到 行数 - 1 循环
        如果 r > 0 则 出 = 出 + ", " 结束
        让 行 = []
        对于 c 从 0 到 行宽 - 1 循环
            追加(行, 数据[r * 行宽 + c])
        结束
        出 = 出 + 张量行渲染(行)
    结束
    返回 出 + "]"
结束

# 容器里是否嵌了张量（直接或嵌套）：宿主原语 转字符串 会把层的张量字典
# 渲染成全部内部键，所以只要沾上张量，整个容器就要走层的递归渲染。
函数 含张量(v) -> 整数
    让 t = 类型(v)
    如果 t == "字典" 则
        如果 是张量字典(v) 则 返回 1 结束
        让 vs = 值(v)
        对于 i 从 0 到 长度(vs) - 1 循环
            如果 含张量(vs[i]) 则 返回 1 结束
        结束
        返回 0
    结束
    如果 t == "列表" 则
        对于 i 从 0 到 长度(v) - 1 循环
            如果 含张量(v[i]) 则 返回 1 结束
        结束
        返回 0
    结束
    返回 0
结束

# 层列表渲染（宿主格式：[a, b]，元素间 ", "，字符串元素不加引号）
函数 层列表渲染(l) -> 字符串
    让 出 = "["
    对于 i 从 0 到 长度(l) - 1 循环
        如果 i > 0 则 出 = 出 + ", " 结束
        出 = 出 + 值转字符串(l[i])
    结束
    返回 出 + "]"
结束

# 层字典渲染（宿主格式：{"键": 值}，键带双引号，条目间 ", "）
函数 层字典渲染(d) -> 字符串
    让 出 = "{"
    让 ks = 键(d)
    对于 i 从 0 到 长度(ks) - 1 循环
        如果 i > 0 则 出 = 出 + ", " 结束
        出 = 出 + "\"" + ks[i] + "\": " + 值转字符串(d[ks[i]])
    结束
    返回 出 + "}"
结束

# 值→字符串的层入口：输出/输出错误/字符串拼接/断言消息/容器元素都经这里。
# 宿主原语 转字符串 对层的张量字典只能渲染出全部内部键（数据/形状/梯度/父/
# 动量…），而宿主对张量有专门渲染——两层必须逐字一致。不含张量的值直接交给
# 宿主原语：它的格式（列表 [a, b]、字典 {"k": v}、字符串值不加引号）经实测
# 与层既有渲染逐字节相同，层里重写反而有漂移风险。
函数 值转字符串(v) -> 字符串
    如果 是张量字典(v) 则
        返回 张量渲染(v)
    结束
    如果 含张量(v) 则
        让 t = 类型(v)
        如果 t == "列表" 则 返回 层列表渲染(v) 结束
        如果 t == "字典" 则 返回 层字典渲染(v) 结束
    结束
    返回 转字符串(v)
结束

# 宿主张量下标读取（co_old.c:5352-5366，实测 /tmp/tr1.co）：
#   一维 → 取扁平数据第 i 个（负数【不绕回】，越界报「张量索引越界」）
#   二维 → 返回第 i 行（一维张量字典），行越界同样报错
#   三维及以上 → 「不支持的张量维度索引」
# 层的张量是字典，以前 求值器 走到「字典键必须是字符串」、虚拟机 直接给 空，
# 两条通道都和宿主不一致——属于「跑得动但结果是错的」。
函数 引_张量下标读(目标, idx, 节点)
    让 错 = 下标数字错(idx)
    如果 错 != "" 则 返回 无坐标报错(错) 结束
    让 维 = 0
    如果 包含(目标, "维度") 则
        维 = 转整数(目标["维度"])
    结束
    让 i = 转整数(idx)
    如果 维 == 1 则
        让 n = 长度(目标["数据"])
        如果 i < 0 或 i >= n 则
            标(节点)
            返回 造异常("张量索引越界")
        结束
        返回 目标["数据"][i]
    结束
    如果 维 == 2 则
        让 行数 = 转整数(目标["形状"][0])
        让 列数 = 转整数(目标["形状"][1])
        如果 i < 0 或 i >= 行数 则
            标(节点)
            返回 造异常("张量索引越界")
        结束
        让 新数据 = []
        让 新形状 = [列数]
        对于 c 从 0 到 列数 - 1 循环
            追加(新数据, 目标["数据"][i * 列数 + c])
        结束
        返回 {"类型": "张量", "数据": 新数据, "形状": 新形状, "维度": 1,
              "需梯度": 0, "梯度": "-", "父": "-", "动量": "-",
              "一阶矩": "-", "二阶矩": "-", "步数": 0}
    结束
    # 三维及以上读不出行视图：宿主报「不支持的张量维度索引」。
    # 实测 d02（让 t = 全零([2,2,2]) / t[0][1] = 5）报的是【内层】下标节点 t[0]
    # 的坐标（第2行,5列），不是整条链最外层——所以标的是【产生这次读的那个下标节点】。
    标(节点)
    返回 造异常("不支持的张量维度索引")
结束

# 宿主张量元素写入（co_old.c:4434 assign_tensor）的一维形态：下标过 idx_val、
# 负数【不绕回】直接越界、值必须过 num_of（「张量元素赋值 需要数字参数，收到 X」）。
# 返回 "" 表示成功，否则是可直接造异常的报错文本。
# 二维链式 t[r][c] = v 不走这里——见 引_张量链式写。
函数 引_张量元素写(目标, idx, 值) -> 字符串
    让 错 = 下标数字错(idx)
    如果 错 != "" 则 返回 错 结束
    如果 转整数(目标["维度"]) != 1 则
        返回 "只能对列表或字典进行索引赋值"
    结束
    让 i = 转整数(idx)
    如果 i < 0 或 i >= 长度(目标["数据"]) 则 返回 "张量索引越界" 结束
    让 值检 = 数值参数(值, "张量元素赋值")
    如果 值检["错误"] != "-" 则 返回 值检["错误"] 结束
    目标["数据"][i] = 值检["值"]
    返回 ""
结束

# 宿主 assign_tensor 的二维链式形态：t[r][c] = v。
# 关键点：宿主的 C 实现拿到的是【整条 lvalue 语法链】，所以能直接对父张量
# 定位；自举层里 求值(t[r]) 只是一个【一维行切片】（副本），对它写 [c]
# 就静默丢进副本里 —— 0.1.16 实测 t[0][1] = 5 再读回 0，正是「跑得动但错」。
# 这里显式回看一层语法节点，取到真正的父张量，再按宿主的行/列越界规则写。
函数 引_张量链式写(父, 行, 列, 值) -> 字符串
    如果 非 是张量字典(父) 则 返回 "只能对列表或字典进行索引赋值" 结束
    如果 转整数(父["维度"]) != 2 则 返回 "只能对列表或字典进行索引赋值" 结束
    # 链式写的下标【不过 idx_val】——实测宿主对 t["a"][0] = 1、t[0]["a"] = 1
    # 报的都是「张量索引越界」（挂在 '=' 的坐标上），而不是单层的
    # 「下标必须是数字」0/0。非数字在这里按「取不到合法下标」处理。
    如果 宿主类型名(行) != "整数" 且 宿主类型名(行) != "浮点" 且 宿主类型名(行) != "布尔" 则
        返回 "张量索引越界"
    结束
    如果 宿主类型名(列) != "整数" 且 宿主类型名(列) != "浮点" 且 宿主类型名(列) != "布尔" 则
        返回 "张量索引越界"
    结束
    让 r = 转整数(行)
    让 c = 转整数(列)
    让 行数 = 转整数(父["形状"][0])
    让 列数 = 转整数(父["形状"][1])
    如果 r < 0 或 r >= 行数 或 c < 0 或 c >= 列数 则 返回 "张量索引越界" 结束
    让 值检 = 数值参数(值, "张量元素赋值")
    如果 值检["错误"] != "-" 则 返回 值检["错误"] 结束
    父["数据"][r * 列数 + c] = 值检["值"]
    返回 ""
结束

# 宿主浮点循环的续判条件（co_old.c:5974-5976）：按步长方向比较，带 ±0.0001 容差。
# 容差是宿主行为的一部分：0.1 累加 10 次会略小于 1，没有容差就少跑最后一轮
# （VM 以前没有容差，「对于 i 从 1 到 2 步长 0.1」少输出一个 2）。
函数 循环继续(f, 终点值, 步) -> 整数
    如果 步 > 0 则
        返回 为整数(f <= 终点值 + 0.0001)
    结束
    返回 为整数(f >= 终点值 - 0.0001)
结束

# 当前函数的返回类型（宿主 g_cur_ret_type，co_old.c:5095）：
# 调用用户函数/调用方法函数 进入时保存、退出时复原，返回语句按它复查。
# 存放在 g_上下文[2]（见 g_上下文 的说明：把三个热路径全局合成一个列表，
# 每次访问只走一次作用域链）。

# 安全读字符串字段：老版本的 AST 节点、外部构造的函数字典可能没有这个键，
# 缺失时按「无标注」处理，而不是把 空/0 当标注串用。
函数 文本字段(d, 键名) -> 字符串
    如果 类型(d) != "字典" 或 非 包含(d, 键名) 则
        返回 ""
    结束
    让 v = d[键名]
    如果 类型(v) != "字符串" 则
        返回 ""
    结束
    返回 v
结束

# 范围(结束) / 范围(开始, 结束) / 范围(开始, 结束, 步长)：在 .co 层完整实现。
# 为什么不直接转发宿主：宿主的参数错误是跨不过 .co 边界的 longjmp——实测
# 「尝试 输出(求和("abc")) 捕获 e」里 捕获 块根本不执行，进程直接终止。
# 测试要求这类错误可捕获，所以校验必须在本层做，文案逐字节抄宿主实测：
#   范围()      → 「范围函数需要1-3个参数」
#   范围("a")   → 「范围 需要数字参数，收到 字符串」（空 同理报「空」）
#   范围(0,5,0.5)→ 「范围的步长不能为 0」（先转整数再判 0，与宿主一致）
# 数值语义（宿主实测）：三个参数都先向零截断成整数，再按整数步进：
#   范围(5)=[0,1,2,3,4]  范围(2,8)=[2..7]  范围(0,10,3)=[0,3,6,9]
#   范围(1,5,1.5)=[1,2,3,4]（步长截成 1）  范围(2.5)=[0,1]
#   范围(5,0,-1)=[5,4,3,2,1]  范围(0,10,-1)=[]  范围(3,0,1)=[]
函数 范围实现(实参)
    让 个数 = 长度(实参)
    如果 个数 < 1 或 个数 > 3 则
        返回 造内置异常("范围函数需要1-3个参数")
    结束
    对于 i 从 0 到 个数 - 1 循环
        让 元型 = 语言类型(实参[i])
        如果 元型 != "整数" 且 元型 != "浮点" 且 元型 != "布尔" 则
            返回 造内置异常("范围 需要数字参数，收到 " + 元型)
        结束
    结束
    让 起 = 0
    让 止 = 0
    让 步 = 1
    如果 个数 == 1 则
        止 = 转整数(实参[0])
    否则
        起 = 转整数(实参[0])
        止 = 转整数(实参[1])
        如果 个数 == 3 则
            步 = 转整数(实参[2])
            如果 步 == 0 则
                返回 造内置异常("范围的步长不能为 0")
            结束
        结束
    结束
    让 结果 = []
    如果 步 > 0 则
        让 当前 = 起
        当 当前 < 止 循环
            追加(结果, 当前)
            当前 = 当前 + 步
        结束
    否则
        让 当前 = 起
        当 当前 > 止 循环
            追加(结果, 当前)
            当前 = 当前 + 步
        结束
    结束
    返回 结果
结束

函数 全部满足值(fn, lst)
    对于 i 从 0 到 长度(lst) - 1 循环
        # 用 调用值 而不是 调用用户函数：谓词可能是内置（类型/是正数 这种），
        # 调用用户函数 只认用户函数的 参数/闭包 键，喂内置会当场崩。
        让 r = 调用值(fn, [lst[i]])
        如果 是异常(r) 则 返回 r 结束
        如果 非 真值(r) 则 返回 假 结束
    结束
    # 返回真布尔而不是 1/0：宿主 类型(全部满足([1], f)) 实测是「布尔」，
    # 且本层 真 == 1 成立，测试里 断言相等(..., 1) 与 断言相等(..., 真) 都能过。
    返回 真
结束

函数 任一满足值(fn, lst)
    对于 i 从 0 到 长度(lst) - 1 循环
        让 r = 调用值(fn, [lst[i]])
        如果 是异常(r) 则 返回 r 结束
        如果 真值(r) 则 返回 真 结束
    结束
    返回 假
结束

函数 深展开(项, 结果)
    如果 类型(项) == "列表" 则
        对于 i 从 0 到 长度(项) - 1 循环
            深展开(项[i], 结果)
        结束
    否则
        追加(结果, 项)
    结束
结束

函数 分组值(lst, 大小)
    让 结果 = []
    让 n = 长度(lst)
    让 i = 0
    当 i < n 循环
        让 块 = []
        对于 j 从 0 到 大小 - 1 循环
            如果 i + j < n 则
                追加(块, lst[i + j])
            结束
        结束
        追加(结果, 块)
        i = i + 大小
    结束
    返回 结果
结束

函数 旋转值(lst, 步数)
    让 n = 长度(lst)
    如果 n == 0 则 返回 [] 结束
    让 k = 步数 % n
    如果 k < 0 则 k = k + n 结束
    让 结果 = []
    对于 i 从 0 到 n - 1 循环
        追加(结果, lst[(i + n - k) % n])
    结束
    返回 结果
结束

函数 去相邻重复值(lst)
    让 结果 = []
    对于 i 从 0 到 长度(lst) - 1 循环
        如果 i == 0 或 lst[i] != lst[i - 1] 则
            追加(结果, lst[i])
        结束
    结束
    返回 结果
结束

函数 压缩值(a, b)
    让 n = 最小值(长度(a), 长度(b))
    让 结果 = []
    对于 i 从 0 到 n - 1 循环
        追加(结果, [a[i], b[i]])
    结束
    返回 结果
结束

函数 枚举值(lst)
    让 结果 = []
    对于 i 从 0 到 长度(lst) - 1 循环
        追加(结果, [i, lst[i]])
    结束
    返回 结果
结束

函数 极值索引(lst, 模式)
    让 n = 长度(lst)
    如果 n == 0 则 返回 -1 结束
    让 idx = 0
    对于 i 从 1 到 n - 1 循环
        如果 模式 == 0 则
            如果 lst[i] < lst[idx] 则 idx = i 结束
        否则
            如果 lst[i] > lst[idx] 则 idx = i 结束
        结束
    结束
    返回 idx
结束

函数 累加和值(lst)
    让 结果 = []
    让 总和 = 0.0
    对于 i 从 0 到 长度(lst) - 1 循环
        总和 = 总和 + 转浮点(lst[i])
        追加(结果, 总和)
    结束
    返回 结果
结束

函数 打乱值(lst)
    让 结果 = 复制(lst)
    让 n = 长度(结果)
    让 i = n - 1
    当 i >= 1 循环
        让 j = 随机整数(0, i)
        让 临时 = 结果[i]
        结果[i] = 结果[j]
        结果[j] = 临时
        i = i - 1
    结束
    返回 结果
结束

函数 合并字典值(a, b)
    让 d = {}
    让 键s = 键(a)
    对于 i 从 0 到 长度(键s) - 1 循环
        d[键s[i]] = a[键s[i]]
    结束
    键s = 键(b)
    对于 i 从 0 到 长度(键s) - 1 循环
        d[键s[i]] = b[键s[i]]
    结束
    返回 d
结束

函数 反转字典值(d)
    让 结果 = {}
    让 键s = 键(d)
    对于 i 从 0 到 长度(键s) - 1 循环
        结果[转字符串(d[键s[i]])] = 键s[i]
    结束
    返回 结果
结束

函数 挑选值(d, 键列表)
    让 结果 = {}
    对于 i 从 0 到 长度(键列表) - 1 循环
        让 k = 转字符串(键列表[i])
        如果 包含(d, k) 则
            结果[k] = d[k]
        结束
    结束
    返回 结果
结束

函数 省略值(d, 键列表)
    让 结果 = {}
    让 键s = 键(d)
    对于 i 从 0 到 长度(键s) - 1 循环
        如果 非 包含(键列表, 键s[i]) 则
            结果[键s[i]] = d[键s[i]]
        结束
    结束
    返回 结果
结束

函数 深拷贝值(v)
    让 t = 类型(v)
    如果 t == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(v) - 1 循环
            追加(结果, 深拷贝值(v[i]))
        结束
        返回 结果
    结束
    如果 t == "字典" 则
        让 结果 = {}
        让 键s = 键(v)
        对于 i 从 0 到 长度(键s) - 1 循环
            结果[键s[i]] = 深拷贝值(v[键s[i]])
        结束
        返回 结果
    结束
    返回 v
结束

函数 列出目录值(路径)
    让 out = 运行并捕获("ls -1A '" + 路径 + "' 2>/dev/null")
    让 行s = 分割(out, "\n")
    让 结果 = []
    对于 i 从 0 到 长度(行s) - 1 循环
        如果 行s[i] != "" 则
            追加(结果, 行s[i])
        结束
    结束
    返回 结果
结束


# ---------------- 用户函数调用 ----------------

# 把「参数类型」规范成【每个形参一条标注字符串】的列表：
#   形参类型 不是列表 / 下标越界 / 元素不是字符串 → 该形参的标注为 ""
#   元素本身（含 "可变"）→ 原样
# 为什么要在【函数定义时】就规范化：原来 调用用户函数 里【每个形参】都要付
# 一次 类型() + 一次 长度()（宿主里一次内置调用 ≈ 一次作用域链遍历），
# N 个形参就是 N 倍开销。规范化之后调用时只查表，一次内置调用都不用付。
# 判定规则与原实现逐条一致（见 调用用户函数 里 形参标注 的用法）。
函数 规范参数标注(形参, 形参类型) -> 列表
    让 结果 = []
    让 n = 长度(形参)
    如果 类型(形参类型) != "列表" 则
        对于 i 从 0 到 n - 1 循环
            追加(结果, "")
        结束
        返回 结果
    结束
    让 m = 长度(形参类型)
    对于 i 从 0 到 n - 1 循环
        让 标注 = ""
        如果 i < m 则
            让 原始 = 形参类型[i]
            如果 类型(原始) == "字符串" 则
                标注 = 原始
            结束
        结束
        追加(结果, 标注)
    结束
    返回 结果
结束

# 调用用户函数值字典：建子环境绑定形参，执行体，拆包返回信号
# 支持：默认参数（缺省时在闭包环境求值默认表达式）、可变参数（...名 收集剩余实参为列表）
函数 调用用户函数(fn, 实参)
    让 子 = {"变量": [{}], "父": fn["闭包"]}
    # 返回类型上下文（宿主 invoke_func 里 g_cur_ret_type 的保存/复原）：
    # 嵌套调用时内层函数不能沿用外层的返回标注。
    让 上下文 = g_上下文
    让 旧返回类型 = 上下文[2]
    # 返回类型标注：与 文本字段(fn, "返回类型") 逐条等价（缺失或非字符串 → ""），
    # 但省掉一次 .co 函数查找与一次 包含 内置调用。
    上下文[2] = fn["返回类型"]
    如果 上下文[2] == 空 或 类型(上下文[2]) != "字符串" 则
        上下文[2] = ""
    结束
    让 形参 = fn["参数"]
    让 n形参 = 长度(形参)
    让 n实参 = 长度(实参)
    # 每个形参的标注（已规范化，定义时算好）：调用时不再付 类型()/长度() 的钱
    让 形参标注 = fn["参数标注"]
    如果 形参标注 == 空 则
        形参标注 = 规范参数标注(形参, fn["参数类型"])
    结束
    # ---- 参数数量守卫（宿主 invoke_func 的第一道检查，实测 e04/e05/m15）----
    # 顺序在【类型复查之前】：函数 f(整数 a) 用 0 个实参调用报的是
    # 「参数数量错误: 期望 1, 得到 0」，而不是类型错。
    # 缺省实参只有在【有默认值表达式】时才算数（层里的扩展，宿主没有默认参数）；
    # 可变参数（标注 "可变"）收走第 i 个之后的全部实参，检查必须跳过。
    # 【热路径快路】实参数 == 形参数 时守卫必然通过（默认值/可变参数都只
    # 放宽范围，不收紧），整段跳过：宿主 C 解释器里每个函数调用的成本是
    # 实打实的，fib(20) 级别的负载实测无条件走一遍扫描要 +3s（16.9→20.4）。
    # 守卫要用到的临时量（需最少/需最多/有可变/默认表）也一并挪进慢路径，
    # 快路径的栈帧因此少 4 个变量 —— 宿主里每个栈帧变量都要被作用域链
    # 遍历扫一遍，帧越小、链越短。
    如果 n实参 != n形参 则
        让 默认表 = fn["参数默认"]
        让 需最少 = n形参
        让 需最多 = n形参
        让 有可变 = 0
        对于 i 从 0 到 n形参 - 1 循环
            如果 形参标注[i] == "可变" 则
                有可变 = 1
                需最少 = i
            结束
        结束
        如果 有可变 == 1 则
            需最多 = n实参
        结束
        # 有默认值的形参不计入「至少要有几个」
        让 默认个数 = 0
        如果 类型(默认表) == "列表" 则
            对于 i 从 0 到 长度(默认表) - 1 循环
                如果 是节点(默认表[i]) 则
                    默认个数 = 默认个数 + 1
                结束
            结束
        结束
        需最少 = 需最少 - 默认个数
        如果 需最少 < 0 则
            需最少 = 0
        结束
        如果 n实参 < 需最少 或 n实参 > 需最多 则
            上下文[2] = 旧返回类型
            让 函数名 = 文本字段(fn, "名字")
            如果 函数名 == "" 则
                函数名 = "（匿名）"
            结束
            返回 造异常("函数 " + 函数名 + " 参数数量错误: 期望 " +
                        转字符串(n形参) + ", 得到 " + 转字符串(n实参))
        结束
    结束
    让 i = 0
    让 参数错 = ""
    当 i < n形参 循环
        让 名 = 形参[i]
        让 标注 = 形参标注[i]
        # ---- 可变参数：把第 i 个形参起的所有剩余实参打包成列表 ----
        如果 标注 == "可变" 则
            让 打包 = []
            对于 j 从 i 到 n实参 - 1 循环
                追加(打包, 实参[j])
            结束
            声明变量(子, 名, 打包)
            跳出
        结束
        # ---- 普通形参 ----
        如果 i < n实参 则
            # 宿主 invoke_func（co_old.c:5256）：实参按形参标注 ensure_type("函数参数")
            如果 标注 != "" 且 类型相符(标注, 实参[i]) == 0 则
                参数错 = 类型错误消息(标注, 实参[i], "函数参数")
                跳出
            结束
            声明变量(子, 名, 实参[i])
            如果 标注 != "" 则
                记标注(子, 名, 标注)
            结束
        否则
            # 缺省实参：尝试默认值表达式（在函数闭包环境中求值）
            让 用默认 = 0
            如果 类型(fn["参数默认"]) == "列表" 且 i < 长度(fn["参数默认"]) 则
                如果 是节点(fn["参数默认"][i]) 则
                    用默认 = 1
                结束
            结束
            如果 用默认 == 1 则
                # 默认表达式在【被调作用域】求值：子环境以 fn["闭包"] 为父，
                # 闭包变量照样可见，差别只在「前一个形参」可见（f(a, b = a + 1)）。
                # 字节码通道在函数序言里求默认值，那时形参槽已落位、天然看得见；
                # 两通道必须同义，否则 标准库 的 断言相等(实际, 期望, 说明="") 分叉。
                让 dval = 求值(fn["参数默认"][i], 子)
                如果 是异常(dval) 则
                    上下文[2] = 旧返回类型
                    返回 dval
                结束
                声明变量(子, 名, dval)
            否则
                声明变量(子, 名, 0)
            结束
        结束
        i = i + 1
    结束
    如果 参数错 != "" 则
        上下文[2] = 旧返回类型
        返回 造异常(参数错)
    结束
    让 结果 = 执行块(fn["体"]["语句"], 子)
    # 体执行完（无论正常/异常/返回）都复原返回类型上下文，
    # 否则外层函数的 返回 会被内层的标注复查。
    上下文[2] = 旧返回类型
    # 内联 是异常 的判定（内容与 是异常 逐条一致）：省一次 .co 函数查找
    如果 类型(结果) == "字典" 且 包含(结果, "__异常__") 则
        返回 结果
    结束
    如果 是控制(结果) 且 结果["__控制__"] == "返回" 则
        返回 结果["值"]
    结束
    返回 0
结束

# 统一调用可调用值：用户函数（走 调用用户函数）或内置函数（走 调用内置）
# 供高阶函数（映射/过滤/归约/应用）使用，使其既能接 coCN 函数也能接内置
函数 调用值(可调用, 实参)
    如果 类型(可调用) == "字典" 且 包含(可调用, "类型") 则
        如果 可调用["类型"] == "函数" 则
            返回 调用用户函数(可调用, 实参)
        结束
        如果 可调用["类型"] == "内置" 则
            返回 调用内置(可调用["名字"], 实参)
        结束
        # 绑定方法作为回调：直接以已绑定的实例/定义类调用
        如果 可调用["类型"] == "绑定方法" 则
            返回 调用方法函数(可调用["方法"], 可调用["实例"], 可调用["定义类"], 实参)
        结束
    结束
    返回 造异常("值不是一个可调用的函数")
结束

# ---------------- 表达式求值 ----------------

# ---- 位运算前置校验（求值器/虚拟机两条通道共用）----
# 为什么必须在 .co 层做，而不是让宿主报错：
#   宿主的「移位位数不能为负 / 位运算需要整数」是致命退出（longjmp 到顶层），
#   自举解释器的 尝试/捕获 拦不住它 —— 测试/位运算测试.co 那五条错误路径断言
#   要的就是「能捕获到中文消息」。
# 为什么不能像以前那样直接 转整数 再算：
#   那会把 1.5 & 1 静默算成 1、~1.5 算成 -2.5 —— 不给报错的错误答案，
#   正是本项目优先级最高的缺陷类别。文案逐字对齐宿主，保证三通道一致。
函数 是位运算类型(字符串 型) -> 布尔
    返回 型 == "整数" 或 型 == "布尔"
结束

# 返回 "" 表示可继续；否则返回中文错误消息
函数 位运算校验(op, 左, 右)
    让 左型 = 宿主类型名(左)
    让 右型 = 宿主类型名(右)
    如果 非 是位运算类型(左型) 或 非 是位运算类型(右型) 则
        返回 "位运算 " + op + " 需要整数，收到 " + 左型 + " " + op + " " + 右型 + "（浮点请先用 取整 转换）"
    结束
    # 只有移位才检查位数范围；& | ^ 的右操作数没有此约束
    如果 op == "<<" 或 op == ">>" 则
        让 位数 = 转整数(右)
        如果 位数 < 0 则
            返回 "移位位数不能为负: " + 转字符串(位数)
        结束
        如果 位数 > 63 则
            返回 "移位位数超出范围: " + 转字符串(位数) + "（0~63）"
        结束
    结束
    返回 ""
结束

# 一元 ~ 的校验：同样只吃 整数/布尔
函数 取反校验(v)
    让 型 = 宿主类型名(v)
    如果 非 是位运算类型(型) 则
        返回 "按位取反需要整数，得到 " + 型 + "（浮点请先用 取整 转换）"
    结束
    返回 ""
结束

# ---- 宿主二元运算的类型闸门（求值器/虚拟机两条通道共用这一份） ----
# 真值来源：/tmp/host_op_matrix.txt（7 类型 × 7 类型 × 11 运算符 = 539 格逐一实测）。
# 宿主的分派顺序：数字×数字 → 直接算；任一侧是字符串 → 只许 "+"（其余报
# 「字符串只支持 + 拼接，不支持 -（字符串 - 整数）」，括号里是【实际类型对】）；
# 列表+列表 拼接、列表/字典/空 ×其余 → 「不支持的运算: 左 op 右」。
# 层里以前没有这道闸门：转浮点 对 列表/字典/空/函数 是未定义行为——
# [1]+2 静默得 3、{}+1 静默得 1、"甲"*2 还多出一个宿主没有的「重复」功能。
# 返回值 "" 表示放行；非空即报错消息（坐标由调用方 标(节点) 后交给 造异常）。
函数 字符串运算错(左, 右, op) -> 字符串
    如果 op == "+" 则 返回 "" 结束
    返回 "字符串只支持 + 拼接，不支持 " + op + "（" + 宿主类型名(左) + " " + op + " " + 宿主类型名(右) + "）"
结束

函数 数值闸门(左, 右, op) -> 字符串
    让 左型 = 宿主类型名(左)
    让 右型 = 宿主类型名(右)
    让 左数 = (左型 == "整数" 或 左型 == "浮点" 或 左型 == "布尔")
    让 右数 = (右型 == "整数" 或 右型 == "浮点" 或 右型 == "布尔")
    如果 左数 且 右数 则 返回 "" 结束
    # 宿主的分派顺序（实测矩阵 + /tmp/probe/e*.co、q*.co）：数字 → 字符串 → 张量
    # → 列表 → 其余。字符串规则【优先于】张量规则：
    #   "x" + 全零([2])  → 宿主放行并拼接成 "x[0, 0]"（两侧都转字符串）
    #   全零([2]) * "x"  → 宿主报「字符串只支持 + 拼接，不支持 *（张量 * 字符串）」
    # 旧顺序把张量检查放在字符串前面，这两条全部对不上（前者误拒、后者误报）。
    如果 左型 == "字符串" 或 右型 == "字符串" 则
        返回 字符串运算错(左, 右, op)
    结束
    # 张量×张量 走 引_加/引_减/引_乘/引_除（层里做自动微分，宿主是 C 张量）；
    # 张量×标量【不】放行——实测宿主对算术族（含 % //）一律报
    # 「张量运算需要两个张量」，层里以前的广播写法（t * 2 → 每元素乘 2）
    # 是宿主没有的功能；位运算在到达本闸门前已被 位运算校验 拦下。
    如果 左型 == "张量" 且 右型 == "张量" 则 返回 "" 结束
    如果 左型 == "张量" 或 右型 == "张量" 则
        如果 op == "+" 或 op == "-" 或 op == "*" 或 op == "/" 或 op == "%" 或 op == "//" 则
            返回 "张量运算需要两个张量"
        结束
        返回 "张量不支持运算符: " + op
    结束
    如果 op == "+" 且 左型 == "列表" 且 右型 == "列表" 则 返回 "" 结束
    返回 "不支持的运算: " + 左型 + " " + op + " " + 右型
结束

# 二元运算（独立出来控制复杂度）
函数 求值二元(节点, 环境)
    让 op = 节点["运算符"]

    # 短路逻辑
    如果 op == "且" 则
        让 l = 求值(节点["左"], 环境)
        如果 是异常(l) 则 返回 l
        如果 非 真值(l) 则 返回 0 == 1
        让 r = 求值(节点["右"], 环境)
        如果 是异常(r) 则 返回 r
        返回 真值(r) != 0
    结束

    如果 op == "或" 则
        让 l = 求值(节点["左"], 环境)
        如果 是异常(l) 则 返回 l
        如果 真值(l) 则 返回 0 == 0
        让 r = 求值(节点["右"], 环境)
        如果 是异常(r) 则 返回 r
        返回 真值(r) != 0
    结束

    # 【热路径】是异常(...) 的判定就地展开：它是本函数里最频繁的 .co 调用，
    # 每一次都要沿作用域链找函数名（链深 × 每层变量数的 strcmp + 逐帧指针追逐）。
    # 判定内容与 是异常 完全一致（类型是字典 且 含 "__异常__" 键），
    # 展开后语义逐字节不变，只是省掉那次查找。
    # 【热路径】类型只算一次：下面既用它做异常判定，又用它做算术/比较分派。
    # 原来这条路径要算四遍（异常判定两遍 + 比较支两遍 + 算术支两遍），
    # 现在每侧一遍 —— 类型() 是宿主内置调用，每次都要沿作用域链找内置名。
    # 类型() 是纯函数，重排先后不改变任何可观察语义。
    让 l = 求值(节点["左"], 环境)
    让 lt2 = 类型(l)
    如果 lt2 == "字典" 且 包含(l, "__异常__") 则 返回 l
    让 r = 求值(节点["右"], 环境)
    让 rt2 = 类型(r)
    如果 rt2 == "字典" 且 包含(r, "__异常__") 则 返回 r

    # 【热路径重排】相等/不等直接走宿主语义（宿主语义对任意类型都给答案），
    # 不需要类型闸门。
    如果 op == "==" 则 返回 l == r
    如果 op == "!=" 则 返回 l != r

    # 【整数×整数 早退】+ - * 直接在宿主 64 位整数上算完返回。
    # 不这么做的话这三条要经过 转浮点/转浮点/转整数 三次宿主调用（HEAD 的老路径
    # 就是这样，它本来就是那个开销）；类型判定把两侧都确认成数字后，
    # 字符串/列表/张量分支对 整数×整数 必然不命中，提前返回不改变任何语义。
    # 除零、类型规则（整数//整数→整数、/ →浮点）由下面的原路径继续负责。
    如果 op == "+" 或 op == "-" 或 op == "*" 则
        如果 lt2 == "整数" 且 rt2 == "整数" 则
            如果 op == "+" 则 返回 l + r 结束
            如果 op == "-" 则 返回 l - r 结束
            返回 l * r
        结束
    结束

    # 大小比较：类型不可比时返回可捕获异常（宿主比较会直接致命退出）
    # 宿主持比性规则（实测 /tmp/probe/e*.co）：数字三者互比、列表×列表、
    # 字符串×字符串；字典/张量/空 即使同类型也不可比（宿主对 字典<字典 一样
    # 报「无法比较大小: 字典 < 字典」）。旧判定「同类型即可比」把 字典<字典、
    # 张量<张量、空<空 放行给宿主深比较，报错坐标于是变成求值器内部行号
    # （实测 第2416行,28列）而非源码位置——消息对得上、坐标对不上。
    #
    # 【热路径】判定用的是【可比性】，而不是【完整类型名】：
    #   宿主类型名 会把字典按 "类型" 字段还原成 张量/函数/任务/元组，
    #   但这些类型在「可比性」这一项上与普通字典【完全一样：都不可比】。
    #   所以判定阶段直接用 类型()（宿主原语）即可，判定结果逐条相同；
    #   宿主类型名 只在【报错文案】里才需要，那时才付这次调用。
    #   实测递归负载每层两次 宿主类型名 = 两次 .co 调用 + 两次 包含 内置调用，
    #   合计约 1/4 的作用域链遍历开销。
    如果 op == "<" 或 op == ">" 或 op == "<=" 或 op == ">=" 则
        # 可比性判定：数字三者互比、列表×列表、字符串×字符串。
        # 判定内容与原来的「可比」临时量逐条一致，只是不再占用栈帧变量。
        如果 非 ((lt2 == "整数" 或 lt2 == "浮点" 或 lt2 == "布尔") 且 (rt2 == "整数" 或 rt2 == "浮点" 或 rt2 == "布尔")) 且 非 (lt2 == "列表" 且 rt2 == "列表") 且 非 (lt2 == "字符串" 且 rt2 == "字符串") 则
            标(节点)
            返回 造异常("无法比较大小: " + 宿主类型名(l) + " " + op + " " + 宿主类型名(r))
        结束
        如果 op == "<" 则 返回 l < r
        如果 op == ">" 则 返回 l > r
        如果 op == "<=" 则 返回 l <= r
        返回 l >= r
    结束

    # 位运算（仅整数）
    # 必须在 .co 层先校验：宿主对 浮点/字符串 参与位运算是直接致命退出（longjmp），
    # 本解释器的 尝试/捕获 拦不住；而先前这里是直接 转整数 后再运算，
    # 1.5 & 1 静默算成 1、~1.5 算成 -2.5 —— 属于「不给报错的错误答案」，最危险那类。
    # 校验通过后，实际运算仍交给宿主原语（宿主也做同样的范围检查）。
    如果 op == "&" 或 op == "|" 或 op == "^" 或 op == "<<" 或 op == ">>" 则
        让 位错 = 位运算校验(op, l, r)
        如果 位错 != "" 则
            标(节点)
            返回 造异常(位错)
        结束
        如果 op == "&" 则 返回 转整数(l) & 转整数(r)
        如果 op == "|" 则 返回 转整数(l) | 转整数(r)
        如果 op == "^" 则 返回 转整数(l) ^ 转整数(r)
        如果 op == "<<" 则 返回 转整数(l) << 转整数(r)
        返回 转整数(l) >> 转整数(r)
    结束

    # ---- 宿主类型闸门（实测矩阵，见 数值闸门 的注释） ----
    # 放在比较/位运算之后、字符串/列表/张量分支之前：
    # 宿主就是按「数字 → 字符串 → 列表/张量 → 其余不支持」的顺序分派的，
    # 闸门一旦漏过，下面的 转浮点 会对着 列表/字典/空 产生未定义行为。
    #
    # 【热路径快路】两侧都是数字时闸门必然放行，直接跳过这次函数调用：
    # 宿主 C 解释器里 类型()+字符串比较 是实打实的开销，实测 紧凑基准 的
    # fib(20) 无条件走闸门要从 16.9s 涨到 21.8s（+29%）。lt2/rt2 顺手给
    # 下面的字符串分支和 得浮点 复用，一共省下 4 次 类型()。
    #
    # 两侧都是数字时闸门必然放行（数值闸门 的第一条就是「两侧都是数字 → 返回 ""」），
    # 直接跳过这次函数调用：宿主 C 解释器里 类型()+字符串比较 是实打实的开销。
    # 整数×整数 已在上面早退，这里只剩 浮点/布尔 参与的组合。
    让 两侧是数字 = 0
    如果 (lt2 == "整数" 或 lt2 == "浮点" 或 lt2 == "布尔") 且 (rt2 == "整数" 或 rt2 == "浮点" 或 rt2 == "布尔") 则
        两侧是数字 = 1
    结束
    如果 两侧是数字 == 0 则
        让 闸门错 = 数值闸门(l, r, op)
        如果 闸门错 != "" 则
            标(节点)
            返回 造异常(闸门错)
        结束
    结束

    # 字符串参与运算（任意类型 + 字符串）：宿主只许 "+"，其余报完整文案
    # （实测矩阵：字符串*整数、整数-字符串、列表/字符串 全都要报
    #   「字符串只支持 + 拼接，不支持 *（字符串 * 整数）」——
    #   以前这里只报前半截，且还带一个宿主没有的 「字符串 * 整数 = 重复」功能，
    #   三通道对不上。重复串() 仍然存在，要用函数调，不能用运算符。）
    如果 lt2 == "字符串" 或 rt2 == "字符串" 则
        让 串错 = 字符串运算错(l, r, op)
        如果 串错 != "" 则
            标(节点)
            返回 造异常(串错)
        结束
        # 宿主原语 转字符串 会把层的张量字典（及含张量的容器）渲染成内部键，
        # 而宿主对张量有专门渲染——一侧是字典时走层入口 值转字符串。
        # 字符串+字符串 的热路径（紧凑基准的拼接负载）不多付任何调用。
        让 左串 = 转字符串(l)
        如果 lt2 == "字典" 则 左串 = 值转字符串(l) 结束
        让 右串 = 转字符串(r)
        如果 rt2 == "字典" 则 右串 = 值转字符串(r) 结束
        返回 左串 + 右串
    结束

    # 列表拼接
    如果 op == "+" 且 lt2 == "列表" 且 rt2 == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(l) - 1 循环
            追加(结果, l[i])
        结束
        对于 i 从 0 到 长度(r) - 1 循环
            追加(结果, r[i])
        结束
        返回 结果
    结束

    # 张量运算
    # 检查是否为张量：宿主类型()返回"字典"，需要检查dict的"类型"字段
    让 l是张量 = (类型(l) == "字典" 且 包含(l, "类型") 且 l["类型"] == "张量")
    让 r是张量 = (类型(r) == "字典" 且 包含(r, "类型") 且 r["类型"] == "张量")
    如果 l是张量 或 r是张量 则
        如果 op == "+" 则 返回 引_加(l, r) 结束
        如果 op == "-" 则 返回 引_减(l, r) 结束
        如果 op == "*" 则 返回 引_乘(l, r) 结束
        如果 op == "/" 则 返回 引_除(l, r) 结束
        标(节点)
        返回 造异常("张量不支持运算符: " + op)
    结束

    # 数值算术
    让 lf = 转浮点(l)
    让 rf = 转浮点(r)
    让 结果 = 0.0
    让 得浮点 = (lt2 == "浮点" 或 rt2 == "浮点")

    # 数值算术：特殊运算符提前返回，普通四则落到 结果
    如果 op == "/" 则
        标(节点)
        如果 rf == 0.0 则 返回 造异常("除以零")
        返回 lf / rf
    结束
    如果 op == "//" 则
        标(节点)
        如果 rf == 0.0 则 返回 造异常("整除的除数为零")
        # 宿主 // 是【向下取整】（floor），不是截断：-10//3 → -4、-10.5//3 → -4、
        # 10.0//3 → 3.0（保浮点）。旧写法用 截断（向零），-10//3 静默算成 -3，
        # 属于「跑得动但结果是错的」。类型规则照宿主：任一侧浮点→浮点结果，否则整数
        # （向下取整 本身吐整数，浮点侧要再 转浮点 抬回来）。
        让 商 = 向下取整(lf / rf)
        如果 得浮点 则 返回 转浮点(商)
        返回 转整数(商)
    结束
    如果 op == "%" 则
        标(节点)
        如果 rf == 0.0 则 返回 造异常("取模的除数为零")
        # 整数取模必须走整型运算：以前一律用 转浮点 后的 lf/rf 算，结果【类型错】——
        # 宿主 类型(7 % 3) == 整数（实测 /tmp/mod1.co），eval 却给 浮点。
        # 值常常凑对（-10 % 3 → -1），类型不对就会污染下游：
        # 「整数 b」形参里写 b = a % b 会被赋值标注复查拦成
        # 「类型错误（赋值）：期望 整数，得到 浮点」，整份带标注的递归函数在
        # eval 通道直接崩、vm 通道正常 —— 实测 例子/巨量算法/高级动态规划/01背包.co。
        如果 lt2 == "整数" 且 rt2 == "整数" 则
            返回 l % r
        结束
        返回 lf - 截断(lf / rf) * rf
    结束
    如果 op == "**" 则
        返回 幂(lf, rf)
    结束
    如果 op == "+" 则
        结果 = lf + rf
    结束
    如果 op == "-" 则
        结果 = lf - rf
    结束
    如果 op == "*" 则
        结果 = lf * rf
    结束
    如果 op != "+" 且 op != "-" 且 op != "*" 则
        标(节点)
        返回 造异常("未知运算符: " + op)
    结束

    如果 得浮点 则 返回 结果
    返回 转整数(结果)
结束

# 字符串重复 n 次
函数 重复串(s, n)
    让 r = ""
    对于 i 从 0 到 n - 1 循环
        r = r + s
    结束
    返回 r
结束

# 表达式主求值函数
函数 求值(节点, 环境)
    让 k = 节点["类型"]

    如果 k == "标识符" 则
        让 名字 = 节点["名字"]
        # 「查无此名」与「名字的值恰好是 空」是两件事：以前用 v == 空 判定，
        # 于是 让 暂无 = 空 / 输出 暂无 报「未定义变量: 暂无」。宿主实测给 空
        # （vm 通道一直是对的，因为它按槽位取值）。判据改用 包含() 的存在性。
        让 v = 查找变量(环境, 名字)
        # 热路径不变量：值非空 = 一定声明过，直接返回（HEAD 的同一条快路）。
        # 只有值【恰好是 空】时才补一次存在性复查——这是稀有分支，代价可接受。
        如果 v == 空 且 变量已声明(环境, 名字) == 0 则
            标(节点)
            返回 造异常("未定义变量: " + 名字)
        结束
        返回 v
    结束

    如果 k == "二元" 则
        返回 求值二元(节点, 环境)
    结束

    如果 k == "函数调用" 则
        # ---- 宿主的调用位置分派（实测 e04~e08、m11/m12 探针族）----
        #   被调者是【裸标识符】时不走普通变量读取：
        #     · 名字不存在 → 「未知内置函数: X」0/0（不是带坐标的「未定义变量」，
        #       那只在值位置成立：输出 表 → (1,4) 未定义变量）
        #     · 名字存在但值不可调用（数字/字符串/列表/普通字典）→ 同样
        #       「未知内置函数: X」0/0（e08：让 n = 5 / 输出 n(1)）
        #   被调者是别的表达式（字面量、下标、嵌套调用）→「值不是一个函数」，
        #   坐标 = 调用节点（第一个实参起点）。
        # 实参永远先求值，且实参自己的错误优先（丙(1/0) → 除以零、丙(L[9]) → 越界、
        # 丙(g(1,2)) → 内层参数数量错，全部实测先于 未知内置函数）。
        让 被调节点 = 节点["被调者"]
        # 调用名 非空 ⇔ 被调者是【裸标识符】：原来另有一个 是裸标识符 标志位，
        # 那个标志只是给末尾的「未知内置函数」分支用的，用 调用名 是否为空
        # 表达同一件事（标识符名永远非空），少一个栈帧变量 —— 宿主里每个栈帧
        # 变量都要被作用域链遍历扫一遍。
        让 调用名 = ""
        让 callee = 0
        如果 是节点(被调节点) 且 被调节点["类型"] == "标识符" 则
            调用名 = 被调节点["名字"]
            callee = 查找变量(环境, 调用名)
        否则
            callee = 求值(被调节点, 环境)
            如果 是异常(callee) 则 返回 callee
        结束
        让 实参节点 = 节点["参数"]
        让 实参 = []
        # 实参按下标写入而不是 追加()：宿主里 追加 是一次内置调用
        # （要沿作用域链找内置名），按下标写是纯列表操作，结果逐条相同
        # （i 从 0 递增，宿主按下标写会自动扩容，与 追加 的顺序一致）。
        对于 i 从 0 到 长度(实参节点) - 1 循环
            让 a = 求值(实参节点[i], 环境)
            # 内联 是异常 的判定（内容与 是异常 逐条一致）：省一次 .co 函数查找
            如果 类型(a) == "字典" 且 包含(a, "__异常__") 则 返回 a
            实参[i] = a
        结束
        如果 类型(callee) == "字典" 且 包含(callee, "类型") 则
            如果 callee["类型"] == "函数" 则
                # 参数数量/类型两道守卫都挂在【调用节点】坐标上
                # （实测 e04/e05：输出 f(1) → (4,6) 正是第一个实参起点）。
                # 这里不用 标(节点) 而是直接赋值：宿主 C 里一次 .co 函数调用
                # 就要 1~2µs，fib(20) 级负载实测 每次调用多一次函数调用 要多花
                # 1.95s（12.0→10.1）；两次全局赋值几乎不要钱，语义完全一样
                # （函数体内的错误本来就会自己 标()，覆盖这个值）。
                # 存在性判定用「取值 != 空」代替 包含()：宿主里字典缺键返回 空，
                # 而 行/列 永远是整数，判定等价，但省掉两次宿主内置调用
                # （内置调用要沿整条作用域链找内置名）。
                如果 节点["行"] != 空 则
                    g_当前行 = 节点["行"]
                结束
                如果 节点["列"] != 空 则
                    g_当前列 = 节点["列"]
                结束
                返回 调用用户函数(callee, 实参)
            结束
            如果 callee["类型"] == "内置" 则
                返回 调用内置(callee["名字"], 实参)
            结束
            # 结构体构造：结构体名(字段值...) → 实例字典
            如果 callee["类型"] == "结构体构造器" 则
                让 d = {"类型": "结构体", "结构体名": callee["结构体名"]}
                让 字段 = callee["字段"]
                对于 i 从 0 到 长度(字段) - 1 循环
                    让 vv = 0
                    如果 i < 长度(实参) 则
                        vv = 实参[i]
                    结束
                    d[字段[i]] = vv
                结束
                返回 d
            结束
            # 绑定方法：obj.方法(实参) → 以 self=obj 调用方法
            如果 callee["类型"] == "绑定方法" 则
                返回 调用方法函数(callee["方法"], callee["实例"], callee["定义类"], 实参)
            结束
            # super(实参)：调用父类构造函数（self 取当前方法环境中的 self）
            如果 callee["类型"] == "超对象" 则
                让 父类名 = 取父类名(callee["起始类"])
                让 自 = 查找变量(环境, "self")
                让 结果 = 查找方法对象(父类名, "构造")
                如果 是异常(结果) 则 返回 结果
                返回 调用方法函数(结果["fn"], 自, 结果["类名"], 实参)
            结束
            # 类构造：类名(实参) → 创建实例并调用构造函数
            如果 callee["类型"] == "类构造器" 则
                返回 实例化类(callee["类名"], 实参)
            结束
        结束
        # 走到这里 = 被调者的值不可调用（或裸名字根本没定义）。
        # 实测分两种：被调者是【裸标识符】→ 宿主按内置名分派，查无此函数就报
        #   「未知内置函数: X」（runtime_error(NULL) → 0/0）；数字、字符串、列表、
        #   普通字典、未定义名字全都走这一支（e07/e08 + m11 探针族实测）。
        # 被调者是【其它表达式】（5(1)、"x"(1)、下标/嵌套调用的结果）→
        #   「值不是一个函数」，坐标是调用节点（实测 m11：输出 5(1) → (1,6)）。
        #   且当同名变量的值【不可调用】时，宿主仍然退回 builtin 表再试一次
        #   （实测 /tmp/p2：让 平方根 = 5 / 平方根(4) → 2；/tmp/p6 同理）。
        #   所以裸名字一律交给 调用内置 分派：表里有就跑，表里查无此名时
        #   它自己的兜底给出逐字节相同的 0/0「未知内置函数: X」。
        如果 调用名 != "" 则
            返回 调用内置(调用名, 实参)
        结束
        标(节点)
        返回 造异常("值不是一个函数")
    结束

    如果 k == "字面量" 则
        让 lt = 节点["字面类型"]
        让 raw = 节点["值"]
        如果 lt == "整数" 则 返回 转整数(raw)
        如果 lt == "浮点" 则 返回 转浮点(raw)
        如果 lt == "字符串" 则 返回 raw
        如果 lt == "布尔" 则
            # 产生宿主真布尔值（而非整数），保证 类型(真) == "布尔"
            如果 raw == "真" 或 raw == "1" 则 返回 0 == 0
            返回 0 == 1
        结束
        如果 lt == "空" 则 返回 空 结束
        返回 0
    结束

    如果 k == "下标" 则
        让 obj = 求值(节点["容器"], 环境)
        如果 是异常(obj) 则 返回 obj
        让 idx = 求值(节点["索引"], 环境)
        如果 是异常(idx) 则 返回 idx
        # 字典：宿主先验键类型（co_old.c:5346「字典键必须是字符串」，带节点位置）。
        # 自举层以前是 obj[转字符串(idx)]，于是 d[1] 静默取到不存在的键 "1" → 0，
        # 属于「跑得动但结果是错的」。
        让 容器型 = 类型(obj)
        让 是自定义 = 0
        如果 容器型 == "字典" 且 包含(obj, "类型") 则
            是自定义 = 1
        结束
        如果 容器型 == "字典" 且 非 是自定义 则
            如果 类型(idx) != "字符串" 则
                标(节点)
                返回 造异常("字典键必须是字符串")
            结束
        结束
        # 元组/列表/字符串：宿主的 idx_val 只接 整数/浮点/布尔，其余报
        # 「下标必须是数字」（runtime_error(NULL) → 行0列0，与宿主一致）。
        让 下标错 = ""
        如果 容器型 == "列表" 或 (容器型 == "字符串") 则
            下标错 = 下标数字错(idx)
        结束
        如果 是自定义 且 obj["类型"] == "元组" 则
            下标错 = 下标数字错(idx)
        结束
        如果 下标错 != "" 则
            # 实测 c03/d08：宿主的「下标必须是数字」出自内置 num 分派的
            # runtime_error(NULL) → 行0列0，不带坐标（同一条语句的【越界】才带）。
            返回 无坐标报错(下标错)
        结束
        # 元组：自定义类型标记优先于宿主类型
        如果 是自定义 且 obj["类型"] == "元组" 则
            让 elems = obj["元素"]
            让 i = 转整数(idx)
            让 n = 长度(elems)
            如果 i < 0 则 i = i + n
            标(节点)
            如果 i < 0 或 i >= n 则 返回 造异常("元组索引越界")
            返回 elems[i]
        结束
        # 张量：宿主的 t[i] 是一等公民（一维取值、二维取行），见 引_张量下标读
        如果 是自定义 且 obj["类型"] == "张量" 则
            返回 引_张量下标读(obj, idx, 节点)
        结束
        让 t = 类型(obj)
        # super.方法名 → 绑定父类中该方法（跳过当前类，从父类链向上查找）
        如果 t == "字典" 且 包含(obj, "类型") 且 obj["类型"] == "超对象" 则
            让 父类名 = 取父类名(obj["起始类"])
            让 结果 = 查找方法对象(父类名, 转字符串(idx))
            如果 是异常(结果) 则 返回 结果
            让 自 = 查找变量(环境, "self")
            返回 {"类型": "绑定方法", "实例": 自, "方法": 结果["fn"], "定义类": 结果["类名"]}
        结束
        # 对象实例：obj.字段 → 字段值；obj.方法 → 绑定方法（沿继承链查找）
        如果 t == "字典" 且 包含(obj, "类型") 且 obj["类型"] == "对象" 则
            如果 类型(idx) != "字符串" 则
                标(节点)
                返回 造异常("对象成员访问需要字符串名")
            结束
            # 真实字段优先于方法
            如果 包含(obj, idx) 则
                返回 obj[idx]
            结束
            让 结果 = 查找方法对象(obj["类名"], idx)
            如果 是异常(结果) 则
                标(节点)
                返回 造异常("对象没有成员 '" + idx + "'")
            结束
            返回 {"类型": "绑定方法", "实例": obj, "方法": 结果["fn"], "定义类": 结果["类名"]}
        结束
        如果 t == "列表" 则
            让 i = 转整数(idx)
            让 n = 长度(obj)
            让 实际 = i
            如果 实际 < 0 则 实际 = 实际 + n 结束
            # 越界文案带【换算前】的原始下标（宿主 co_old.c:5332 用 i0），
            # 以前这里报的是补码后的 -2，双通道与宿主三方才对齐。
            如果 实际 < 0 或 实际 >= n 则
                标(节点)
                返回 造异常("列表索引越界: " + 转字符串(i) + " (列表长度 " + 转字符串(n) + ")")
            结束
            返回 obj[实际]
        结束
        如果 t == "字符串" 则
            让 i = 转整数(idx)
            让 n = 长度(obj)
            让 实际 = i
            如果 实际 < 0 则 实际 = 实际 + n 结束
            如果 实际 < 0 或 实际 >= n 则
                标(节点)
                返回 造异常("字符串索引越界: " + 转字符串(i) + "（长度 " + 转字符串(n) + "）")
            结束
            返回 截取(obj, 实际, 1)
        结束
        如果 t == "字典" 则
            如果 类型(idx) != "字符串" 则
                标(节点)
                返回 造异常("字典键必须是字符串")
            结束
            如果 包含(obj, idx) 则 返回 obj[idx]
            # 宿主 dict_get 缺失键返回 VAL_NULL（实测 输出 d["z"] 得「空」）；
            # 以前这里给 0，与 VM 通道的「空」不一致，属于静默算错。
            返回 空
        结束
        标(节点)
        返回 造异常("不支持的类型索引")
    结束

    如果 k == "一元" 则
        让 op = 节点["运算符"]
        让 v = 求值(节点["操作数"], 环境)
        如果 是异常(v) 则 返回 v
        如果 op == "非" 或 op == "not" 则
            返回 真值(v) == 0
        结束
        如果 op == "-" 则
            # 取负仅对数值类有意义，其余返回可捕获异常
            让 负型 = 类型(v)
            如果 负型 != "整数" 且 负型 != "浮点" 且 负型 != "布尔" 则
                标(节点)
                返回 造异常("取负需要数字或张量，得到 " + 负型)
            结束
            返回 -v
        结束
        # 按位取反：补码恒等式 ~x == -x - 1
        如果 op == "~" 则
            让 反错 = 取反校验(v)
            如果 反错 != "" 则
                标(节点)
                返回 造异常(反错)
            结束
            返回 -转整数(v) - 1
        结束
        返回 v
    结束

    如果 k == "列表字面量" 则
        # 列表推导式（防御式读取可选字段）
        如果 是节点(节点["推导源"]) 则
            让 体节点 = 节点["推导体"]
            让 变量名 = 节点["迭代变量"]
            让 过滤节点 = 节点["过滤器"]
            让 源值 = 求值(节点["推导源"], 环境)
            如果 是异常(源值) 则 返回 源值
            让 结果 = []
            让 n = 长度(源值)
            对于 i 从 0 到 n - 1 循环
                让 子 = {"变量": [{}], "父": 环境}
                声明变量(子, 变量名, 源值[i])
                让 取 = 1
                如果 是节点(过滤节点) 则
                    让 fv = 求值(过滤节点, 子)
                    如果 是异常(fv) 则 返回 fv
                    取 = 真值(fv)
                结束
                如果 取 则
                    让 bv = 求值(体节点, 子)
                    如果 是异常(bv) 则 返回 bv
                    追加(结果, bv)
                结束
            结束
            返回 结果
        结束
        让 元素 = 节点["元素"]
        让 结果 = []
        对于 i 从 0 到 长度(元素) - 1 循环
            让 v = 求值(元素[i], 环境)
            如果 是异常(v) 则 返回 v
            追加(结果, v)
        结束
        返回 结果
    结束

    如果 k == "字典字面量" 则
        # 字典推导式 {键: 值 对于 变量 在/于 容器 [若 过滤]}
        如果 节点["是否推导式"] == 1 则
            让 键体节点 = 节点["键体"]
            让 值体节点 = 节点["值体"]
            让 迭代名 = 节点["迭代变量"]
            让 过滤节点 = 节点["过滤器"]
            让 源值 = 求值(节点["推导源"], 环境)
            如果 是异常(源值) 则 返回 源值
            让 结果字典 = {}
            让 总数 = 长度(源值)
            对于 i 从 0 到 总数 - 1 循环
                让 子环境 = {"变量": [{}], "父": 环境}
                声明变量(子环境, 迭代名, 源值[i])
                让 采纳 = 1
                如果 是节点(过滤节点) 则
                    让 过滤值 = 求值(过滤节点, 子环境)
                    如果 是异常(过滤值) 则 返回 过滤值
                    采纳 = 真值(过滤值)
                结束
                如果 采纳 则
                    让 键值 = 求值(键体节点, 子环境)
                    如果 是异常(键值) 则 返回 键值
                    让 项值 = 求值(值体节点, 子环境)
                    如果 是异常(项值) 则 返回 项值
                    结果字典[转字符串(键值)] = 项值
                结束
            结束
            返回 结果字典
        结束
        让 键s = 节点["键"]
        让 值s = 节点["值"]
        让 d = {}
        对于 i 从 0 到 长度(键s) - 1 循环
            让 kk = 求值(键s[i], 环境)
            如果 是异常(kk) 则 返回 kk
            让 vv = 求值(值s[i], 环境)
            如果 是异常(vv) 则 返回 vv
            d[转字符串(kk)] = vv
        结束
        返回 d
    结束

    # 元组字面量：(a, b, c) → {"类型":"元组", "元素":[a,b,c]}
    如果 k == "元组字面量" 则
        让 元素节点 = 节点["元素"]
        让 结果 = []
        对于 i 从 0 到 长度(元素节点) - 1 循环
            让 v = 求值(元素节点[i], 环境)
            如果 是异常(v) 则 返回 v
            追加(结果, v)
        结束
        返回 {"类型": "元组", "元素": 结果}
    结束

    # 匿名函数字面量：函数(参数) 体 结束 → 创建函数值，捕获当前环境为闭包
    如果 k == "函数字面量" 则
        返回 {"类型": "函数", "名字": 节点["名字"], "参数": 节点["参数"], "参数类型": 节点["参数类型"], "参数默认": 节点["参数默认"], "参数标注": 规范参数标注(节点["参数"], 节点["参数类型"]), "返回类型": 节点["返回类型"], "体": 节点["体"], "闭包": 环境}
    结束

    # super（超引用）：构造一个「超对象」，记录当前方法所在类，供向上查找父类方法/构造
    如果 k == "超引用" 则
        让 当前类 = 查找变量(环境, "__当前类__")
        返回 {"类型": "超对象", "起始类": 当前类}
    结束

    # 匹配 作为表达式：返回首个命中分支体的取值（末条表达式语句的值）
    如果 k == "匹配" 则
        返回 执行匹配(节点, 环境)
    结束

    # 协作式并发：并发 表达式 → 创建任务句柄，加入任务队列，立即返回（延迟执行）
    如果 k == "并发" 则
        让 任务 = {"类型":"任务", "状态":"待运行", "表达式": 节点["表达式"], "结果": 空, "环境": 环境}
        追加(任务队列, 任务)
        返回 任务
    结束

    # 等待 任务 → 已完成直接返回缓存结果；待运行则在当前线程协作式执行
    如果 k == "等待" 则
        让 t = 求值(节点["表达式"], 环境)
        如果 是异常(t) 则 返回 t
        返回 等待任务(t)
    结束

    标(节点)
    返回 造异常("无法求值的节点: " + k)
结束

# ---------------- 语句执行 ----------------

# 执行一串语句，返回：0 / 控制信号 / 异常信号
# 求值深度守卫：无限递归在自举层必须变成【可捕获】的中文错误。
# 为什么必须自己数：宿主 C 栈守卫虽然也在，但它触发的「调用栈即将耗尽」
# 跨 .co 边界【不可捕获】（实测直接 rc=1，尝试/捕获 根本不跑），而且默认
# 8MB 栈下自举层 ~460 层就撞墙——合法递归（边界测试 累加到(500)）先于无限
# 递归被误杀。启动器已把栈软限抬到 64MB 给合法递归留足余量；这里在语言层
# 设 700 层嵌套执行上限，触发时返回可捕获异常，三条路径都还原计数
# （正常返回/控制穿透/异常展开），捕获后继续跑不留残值（异常测试的
# 「反复栈耗尽后一切正常」断言正是查这个）。
# ---- 求值上下文（热路径上的三个全局合成一个列表）----
# 为什么合成一个：宿主 C 里读/写一个【全局变量】要沿整条作用域链找它的绑定
# （链深 × 每层变量数的 strcmp + 逐帧指针追逐），是本通道最贵的单项操作之一。
# 求值_深度 / 求值_深度上限 / g_返回类型 这三个全局只在【求值器.co 内部】用
# （虚拟机.co 用的是自己那套 g_当前返回类型，不碰这三个），所以可以安全地
# 收进一个列表：取一次列表引用（一次链遍历）之后，读写都是列表下标，
# 便宜得多。语义逐条不变：
#   g_上下文[0] = 当前嵌套执行深度   （原 求值_深度）
#   g_上下文[1] = 深度上限           （原 求值_深度上限）
#   g_上下文[2] = 当前返回类型标注   （原 g_返回类型）
让 g_上下文 = [0, 700, ""]

函数 执行块(语句列表, 环境)
    # 取一次上下文引用：下面所有深度读写都走列表下标，不再逐次走作用域链
    让 上下文 = g_上下文
    让 深 = 上下文[0] + 1
    上下文[0] = 深
    如果 深 > 上下文[1] 则
        上下文[0] = 深 - 1
        返回 造异常("调用栈即将耗尽（嵌套执行超过 " + 转字符串(上下文[1]) + " 层），请检查是否存在无限递归")
    结束
    对于 i 从 0 到 长度(语句列表) - 1 循环
        让 r = 执行语句(语句列表[i], 环境)
        # 内联 是异常或控制 的判定（内容与 是异常或控制 逐条一致）：
        # 省一次 .co 函数查找（沿作用域链找函数名）。
        如果 类型(r) == "字典" 且 (包含(r, "__异常__") 或 包含(r, "__控制__")) 则
            上下文[0] = 深 - 1
            返回 r
        结束
    结束
    上下文[0] = 深 - 1
    返回 0
结束

# 顶层函数提升：先把语句列表里的【顶层】函数定义登记进环境，再按序执行。
# C 宿主（co_old.c hoist_functions）与字节码通道（编译程序 第一遍扫全局槽位）
# 都有这一步，自举求值器以前没有——「先用后定义」在 eval 通道报
# 「未定义变量: 先用后定义」（模块并发测试抓到）。只扫顶层、不穿进
# 如果/循环体：嵌套定义随控制流执行时才登记，与宿主一致。
# 后续按序执行到 函数定义 语句时会再用 声明变量 覆写一次同值，无害。
函数 提升顶层函数(语句列表, 环境)
    对于 i 从 0 到 长度(语句列表) - 1 循环
        让 st = 语句列表[i]
        如果 是节点(st) 且 st["类型"] == "函数定义" 则
            让 fn = {"类型": "函数", "名字": st["名字"], "参数": st["参数"], "参数类型": st["参数类型"], "参数默认": st["参数默认"], "参数标注": 规范参数标注(st["参数"], st["参数类型"]), "返回类型": st["返回类型"], "体": st["体"], "闭包": 环境}
            声明变量(环境, st["名字"], fn)
        结束
    结束
结束

# 赋值目标处理（标识符 / 下标）
# 赋值标识符(env, 名字, 值) -> 字典：一次作用域链遍历完成「取旧值 + 查标注 + 写新值」
#
# 为什么合并：原来这条路径要走三遍作用域链 ——
#   查找变量(取旧值) → 查标注(类型标注) → 赋值变量(写新值)，
# 每遍都要从当前环境一路走到根，链条越深越贵。循环体里赋值是最高频操作，
# 合并成一遍后，链深为 d 时从 3d 次遍历降到 d 次。
#
# 语义保持不变（三处判定各自对应的条件与原来逐条一致）：
#   1) 函数名不可覆盖（宿主 ND_ASSIGN，co_old.c:5846-5852）
#   2) 带标注的变量每次赋值都按声明时的标注复查
#   3) 写回同一层作用域的同一个块（原来 赋值变量 找的也是「第一个含该名字的块」）
#
# 返回：{"错误": "..."} 表示要报错；否则 {"旧值":..., "新值":...}。
函数 赋值标识符(env, 名字, 值)
    让 e = env
    当 e != 空 循环
        让 表 = e["变量"]
        对于 i 从 0 到 长度(表) - 1 循环
            让 块 = 表[i]
            如果 包含(块, 名字) 则
                让 旧 = 块[名字]
                如果 类型(旧) == "字典" 且 包含(旧, "类型") 且 旧["类型"] == "函数" 则
                    返回 {"错误": "不能给函数名赋值"}
                结束
                # 类型表存在性：用「取值 != 空」代替 包含()（宿主里字典缺键返回 空，
                # 而类型表要么不存在、要么是一个非空字典），省掉一次内置调用。
                让 标注 = ""
                让 类型表 = e["类型表"]
                如果 类型表 != 空 且 包含(类型表, 名字) 则
                    标注 = 类型表[名字]
                结束
                如果 标注 != "" 且 类型相符(标注, 值) == 0 则
                    返回 {"错误": 类型错误消息(标注, 值, "赋值")}
                结束
                块[名字] = 值
                返回 {"旧值": 旧, "新值": 值}
            结束
        结束
        e = e["父"]
    结束
    # 一路都没找到 → 与原 赋值变量 一致：声明到最内层作用域
    层声明(env["变量"], 名字, 值)
    返回 {"旧值": 空, "新值": 值}
结束

函数 执行赋值(目标, 值, 环境)
    如果 目标["类型"] == "标识符" 则
        # 宿主 ND_ASSIGN（co_old.c:5846-5852）：函数名不可覆盖，
        # 带标注的变量每次赋值都按声明时的标注复查。
        # 一次作用域链遍历搞定（见 赋值标识符 的说明）。
        让 结果 = 赋值标识符(环境, 目标["名字"], 值)
        如果 包含(结果, "错误") 则
            标(目标)
            返回 造异常(结果["错误"])
        结束
        返回 0
    结束
    如果 目标["类型"] == "下标" 则
        # ---- 链式张量写必须【先于】中间读识别（实测 d04/d06/m9 探针族）----
        # 宿主把整条 lvalue 语法链直接交给 assign_tensor，不做「先求值 t[r] 拿行视图」
        # 这一步。后果是坐标完全不同：
        #   t[5][0] = 1（行越界）  → (2,9)「张量索引越界」坐标是【'='】（外层下标节点），
        #   若先做中间读会报成 (2,5)（内层节点 t[5]）——0.1.16 的 vm/eval 都错在这里。
        # 唯一例外是维度检查：t(3维)[0][1] = 5 → (2,5)「不支持的张量维度索引」
        # 仍挂内层节点（宿主的形状检查发生在拿行视图之前，实测 m9）。
        让 内层 = 目标["容器"]
        如果 是节点(内层) 且 内层["类型"] == "下标" 则
            让 链父 = 求值(内层["容器"], 环境)
            如果 是异常(链父) 则 返回 链父 结束
            如果 是张量字典(链父) 则
                如果 转整数(链父["维度"]) > 2 则
                    标(内层)
                    返回 造异常("不支持的张量维度索引")
                结束
                让 链行 = 求值(内层["索引"], 环境)
                如果 是异常(链行) 则 返回 链行 结束
                让 链列 = 求值(目标["索引"], 环境)
                如果 是异常(链列) 则 返回 链列 结束
                让 链错 = 引_张量链式写(链父, 链行, 链列, 值)
                标(目标)
                如果 链错 != "" 则 返回 无坐标报错(链错) 结束
                返回 0
            结束
        结束
        让 obj = 求值(目标["容器"], 环境)
        如果 是异常(obj) 则 返回 obj
        让 idx = 求值(目标["索引"], 环境)
        如果 是异常(idx) 则 返回 idx
        让 容器型 = 类型(obj)
        # 宿主的张量下标赋值（co_old.c:4434 assign_tensor）只认两种写法：
        #   一维：t[i] = v        → i 过 idx_val，负数【不绕回】直接「张量索引越界」
        #   二维链式：t[r][c] = v → 见上面的链式分支
        # 其余（t[0] = 标量 给二维）落到「只能对列表或字典进行索引赋值」。
        # 自举层以前把所有张量都转给 置()，于是 t[-1]、高维 都静默写进去了。
        如果 容器型 == "字典" 且 包含(obj, "类型") 且 obj["类型"] == "张量" 则
            让 写错 = 引_张量元素写(obj, idx, 值)
            标(目标)
            如果 写错 != "" 则 返回 无坐标报错(写错) 结束
            返回 0
        结束
        如果 容器型 == "列表" 则
            # 宿主的下标赋值同样过 idx_val，再拒负索引（co_old.c:5862）
            让 错 = 下标数字错(idx)
            如果 错 != "" 则 返回 无坐标报错(错) 结束
            让 i = 转整数(idx)
            标(目标)
            如果 i < 0 则 返回 造异常("索引不能为负数") 结束
            obj[i] = 值
            返回 0
        结束
        如果 容器型 == "字典" 则
            如果 类型(idx) != "字符串" 则
                标(目标)
                返回 造异常("字典键必须是字符串")
            结束
            obj[idx] = 值
            返回 0
        结束
        标(目标)
        返回 造异常("只能对列表或字典进行索引赋值")
    结束
    标(目标)
    返回 造异常("无效的赋值目标")
结束

# 处理循环体返回结果：返回值=继续/跳出后的动作
# 返回 0 表示正常继续；返回非0即应作为执行语句结果返回
函数 循环结果(r)
    如果 是异常(r) 则 返回 r
    如果 是控制(r) 则
        让 标签 = r["__控制__"]
        如果 标签 == "返回" 则 返回 r
        如果 标签 == "跳出" 则 返回 "__跳出__"
    结束
    返回 0
结束

# 主语句执行函数
函数 执行语句(语句, 环境)
    让 k = 语句["类型"]
    # 记录当前位置：本语句里任何一步失败，异常对象都能报出 行/列
    # 【热路径】原来用 包含(语句, "行") 判定——那是一次宿主内置调用，
    # 要沿整条作用域链找内置名（链深 × 变量数的 strcmp），每条语句都付一次。
    # 宿主里「字典缺键返回 空」，而 行/列 永远是整数（不会是 空），
    # 所以「语句["行"] != 空」与「包含(语句,"行")」逐字等价，且便宜得多。
    如果 语句["行"] != 空 则
        g_当前行 = 语句["行"]
        g_当前列 = 语句["列"]
    结束

    如果 k == "赋值" 则
        让 v = 求值(语句["值"], 环境)
        # 内联 是异常 的判定（内容与 是异常 逐条一致）：省一次 .co 函数查找
        如果 类型(v) == "字典" 且 包含(v, "__异常__") 则 返回 v
        返回 执行赋值(语句["目标"], v, 环境)
    结束

    如果 k == "如果" 则
        让 c = 求值(语句["条件"], 环境)
        # 内联 是异常 的判定（内容与 是异常 逐条一致）：省一次 .co 函数查找
        如果 类型(c) == "字典" 且 包含(c, "__异常__") 则 返回 c
        如果 真值(c) 则
            返回 执行块(语句["则体"], 环境)
        结束
        让 链 = 语句["否则链"]
        对于 i 从 0 到 长度(链) - 1 循环
            让 br = 链[i]
            如果 是节点(br["条件"]) 则
                让 bc = 求值(br["条件"], 环境)
                如果 是异常(bc) 则 返回 bc
                如果 真值(bc) 则
                    返回 执行块(br["体"], 环境)
                结束
            否则
                返回 执行块(br["体"], 环境)
            结束
        结束
        返回 0
    结束

    如果 k == "返回" 则
        让 v = 0
        让 有值 = 0
        如果 是节点(语句["值"]) 则
            有值 = 1
            v = 求值(语句["值"], 环境)
            # 内联 是异常 的判定（内容与 是异常 逐条一致）：省一次 .co 函数查找
            如果 类型(v) == "字典" 且 包含(v, "__异常__") 则 返回 v
        结束
        # 宿主 ND_RETURN（co_old.c:6030）：函数写了 -> 返回类型 时，
        # 每条 返回 都要 ensure_type("返回语句")。裸 返回 的宿主值是 空。
        # 返回类型标注从上下文列表取一次即可（原来要读三次全局）
        让 返回类型 = g_上下文[2]
        如果 返回类型 != "" 则
            如果 有值 == 0 则
                返回 造异常("类型错误（返回语句）：期望 " + 返回类型 + "，得到 空")
            结束
            如果 类型相符(返回类型, v) == 0 则
                返回 造异常(类型错误消息(返回类型, v, "返回语句"))
            结束
        结束
        返回 {"__控制__": "返回", "值": v}
    结束

    如果 k == "变量声明" 则
        让 v = 0
        让 标注 = 文本字段(语句, "类型标注")
        让 有初始化 = 0
        如果 是节点(语句["初始化"]) 则
            有初始化 = 1
            v = 求值(语句["初始化"], 环境)
            如果 是异常(v) 则 返回 v
        结束
        # 宿主 ND_VAR_DECL（co_old.c:5831-5840）：先 常量重复声明 检查，
        # 再 ensure_type("变量声明")，最后 env_set_type 记下标注供后续赋值复查。
        # 自举层以前完全不看标注，「布尔 开关 = 1」静默通过——错误用例长期假绿。
        如果 包含(语句, "是否常量") 且 转整数(语句["是否常量"]) == 1 则
            如果 变量已声明(环境, 语句["名字"]) == 1 则
                返回 造异常("常量不能重复声明")
            结束
        结束
        如果 标注 != "" 则
            # 宿主的裸声明（整数 n）初始值是 VAL_NULL，标注复查直接判「得到 空」；
            # 层的默认值是 0，所以这里显式按宿主的值报错，而不是拿 0 去比。
            如果 有初始化 == 0 则
                返回 造异常("类型错误（变量声明）：期望 " + 标注 + "，得到 空")
            结束
            如果 类型相符(标注, v) == 0 则
                返回 造异常(类型错误消息(标注, v, "变量声明"))
            结束
            记标注(环境, 语句["名字"], 标注)
        结束
        声明变量(环境, 语句["名字"], v)
        返回 0
    结束

    如果 k == "函数定义" 则
        让 fn = {"类型": "函数", "名字": 语句["名字"], "参数": 语句["参数"], "参数类型": 语句["参数类型"], "参数默认": 语句["参数默认"], "参数标注": 规范参数标注(语句["参数"], 语句["参数类型"]), "返回类型": 语句["返回类型"], "体": 语句["体"], "闭包": 环境}
        声明变量(环境, 语句["名字"], fn)
        返回 0
    结束

    如果 k == "跳出" 则 返回 {"__控制__": "跳出"}
    如果 k == "继续" 则 返回 {"__控制__": "继续"}

    如果 k == "当" 则
        当 1 循环
            让 c = 求值(语句["条件"], 环境)
            如果 是异常(c) 则 返回 c
            如果 非 真值(c) 则 返回 0
            让 r = 执行块(语句["体"], 环境)
            如果 是异常(r) 则 返回 r
            如果 是控制(r) 则
                让 标签 = r["__控制__"]
                如果 标签 == "返回" 则 返回 r
                如果 标签 == "跳出" 则 返回 0
                # 继续：进入下一轮
            结束
        结束
    结束

    如果 k == "对于" 则
        # for-each 形式：对于 元素 在/于 容器 ... 结束
        如果 包含(语句, "是否遍历") 且 语句["是否遍历"] == 1 则
            返回 执行对于遍历(语句, 环境)
        结束
        # 数值循环：语义逐条抄宿主 ND_FOR（co_old.c:5940-6008）
        #   1) 起点/终点/步长 都要过 num_of：非数字报「循环起点 需要数字参数，收到 X」
        #      （以前这里直接 转整数("十")，字符串静默变 0，循环体一次都不跑）
        #   2) 步长为 0 必须报错：宿主的 direction=(0>0)?1:-1 会得到 -1，
        #      「从小到大」的循环被【静默跳过】——「能跑但结果错」，比死循环难查
        #   3) 只要起点/终点/步长任一【求值后是浮点】，就走浮点通道：
        #      i 保持浮点类型逐步累加，终点比较带 ±0.0001 容差；
        #      全整数才走整数通道。以前 eval 通道一律 转整数，
        #      「对于 i 从 1 到 3 步长 0.5」被截成步长 0 → 输出空，
        #      而宿主/VM 给 1 1.5 2 2.5 3 —— 双通道结果不一致的静默算错。
        让 sv = 求值(语句["起点"], 环境)
        如果 是异常(sv) 则 返回 sv
        让 ev = 求值(语句["终点"], 环境)
        如果 是异常(ev) 则 返回 ev
        # 起/终/步长的 num_of 报错是内置族 runtime_error(NULL) → 0/0（实测 f05：
        # 「循环终点 需要数字参数，收到 字符串」不带坐标）；
        # 「循环步长不能为 0」则带坐标（f04 (3,3) = 循环 结束 的 token 位置）。
        让 起检 = 数值参数(sv, "循环起点")
        如果 起检["错误"] != "-" 则 返回 无坐标报错(起检["错误"]) 结束
        让 终检 = 数值参数(ev, "循环终点")
        如果 终检["错误"] != "-" 则 返回 无坐标报错(终检["错误"]) 结束
        让 stv = 1
        让 步长浮 = 0
        如果 是节点(语句["步长"]) 则
            让 步值 = 求值(语句["步长"], 环境)
            如果 是异常(步值) 则 返回 步值
            让 步检 = 数值参数(步值, "循环步长")
            如果 步检["错误"] != "-" 则 返回 无坐标报错(步检["错误"]) 结束
            stv = 步检["值"]
            如果 宿主类型名(步值) == "浮点" 则
                步长浮 = 1
            结束
            如果 stv == 0 则
                # 宿主：runtime_error(n, ...) 带节点位置 → 行/列就是 对于 那一行
                返回 造异常("循环步长不能为 0")
            结束
        结束
        让 名字 = 语句["变量"]
        如果 步长浮 == 1 或 宿主类型名(sv) == "浮点" 或 宿主类型名(ev) == "浮点" 则
            让 f = 转浮点(起检["值"])
            让 fe = 转浮点(终检["值"])
            让 fs = 转浮点(stv)
            当 循环继续(f, fe, fs) 循环
                声明变量(环境, 名字, f)
                让 r = 执行块(语句["体"], 环境)
                如果 是异常(r) 则 返回 r
                如果 是控制(r) 则
                    让 标签 = r["__控制__"]
                    如果 标签 == "返回" 则 返回 r
                    如果 标签 == "跳出" 则 返回 0
                结束
                f = f + fs
            结束
            返回 0
        结束
        让 i = 转整数(起检["值"])
        让 终点 = 转整数(终检["值"])
        让 stp = 转整数(stv)
        当 (stp > 0 且 i <= 终点) 或 (stp < 0 且 i >= 终点) 循环
            声明变量(环境, 名字, i)
            让 r = 执行块(语句["体"], 环境)
            如果 是异常(r) 则 返回 r
            如果 是控制(r) 则
                让 标签 = r["__控制__"]
                如果 标签 == "返回" 则 返回 r
                如果 标签 == "跳出" 则 返回 0
            结束
            i = i + stp
        结束
        返回 0
    结束

    如果 k == "尝试" 则
        让 结果 = 执行块(语句["体"], 环境)
        让 后续 = 0
        如果 是异常(结果) 则
            如果 长度(语句["捕获体"]) > 0 则
                让 捕获变量名 = 语句["捕获变量"]
                如果 捕获变量名 != "" 且 捕获变量名 != 空 则
                    声明变量(环境, 捕获变量名, 结果["__异常__"])
                结束
                后续 = 执行块(语句["捕获体"], 环境)
            否则
                后续 = 结果
            结束
        否则
            后续 = 结果
        结束
        # 最终块总是执行
        如果 长度(语句["最终体"]) > 0 则
            让 fr = 执行块(语句["最终体"], 环境)
            如果 是异常(fr) 或 是控制(fr) 则
                返回 fr
            结束
        结束
        返回 后续
    结束

    如果 k == "抛出" 则
        让 v = 求值(语句["值"], 环境)
        如果 是异常(v) 则 返回 v
        # 抛出字典：原样传递，自定义字段要留着（测试用 抛出 {"类型":"业务错误",…}）
        如果 类型(v) == "字典" 则
            让 异常体 = v
            如果 非 包含(异常体, "类型") 则 异常体["类型"] = "抛出" 结束
            如果 非 包含(异常体, "行") 则
                异常体["行"] = g_当前行
                异常体["列"] = g_当前列
            结束
            返回 {"__异常__": 异常体}
        结束
        # 抛出非字典：自动转成消息文本，类型记为 抛出
        返回 {"__异常__": {"类型": "抛出", "消息": 转字符串(v), "行": g_当前行, "列": g_当前列}}
    结束

    # 枚举定义：注册为字典 {"类型":"枚举", 成员: 递增整数}
    如果 k == "枚举" 则
        让 成员 = 语句["成员"]
        让 d = {"类型": "枚举"}
        对于 i 从 0 到 长度(成员) - 1 循环
            d[成员[i]] = i
        结束
        声明变量(环境, 语句["名字"], d)
        返回 0
    结束

    # 结构体定义：注册构造函数值
    # 结构体名(...) → 实例字典 {"类型":"结构体", "结构体名":..., 字段名: 值...}
    如果 k == "结构体定义" 则
        声明变量(环境, 语句["名字"], {"类型": "结构体构造器", "结构体名": 语句["名字"], "字段": 语句["字段"]})
        返回 0
    结束

    # 类定义：注册类对象到类注册表，并在环境中声明「类构造器」供 类名(...) 实例化
    # 类对象：{"类型":"类","名字":..,"父类":..,"方法":{方法名:函数值},"字段":[{名字,默认节点}],"环境":定义环境}
    如果 k == "类定义" 则
        让 类名 = 语句["名字"]
        让 方法表 = {}
        让 方法节点 = 语句["方法"]
        对于 i 从 0 到 长度(方法节点) - 1 循环
            让 m = 方法节点[i]
            方法表[m["名字"]] = {"类型": "函数", "名字": m["名字"], "参数": m["参数"], "参数类型": m["参数类型"], "参数默认": m["参数默认"], "参数标注": 规范参数标注(m["参数"], m["参数类型"]), "返回类型": m["返回类型"], "体": m["体"], "闭包": 环境}
        结束
        让 字段表 = []
        让 字段节点 = 语句["字段"]
        对于 i 从 0 到 长度(字段节点) - 1 循环
            追加(字段表, {"名字": 字段节点[i]["名字"], "默认": 字段节点[i]["初始化"]})
        结束
        类注册表[类名] = {"类型": "类", "名字": 类名, "父类": 语句["父类"], "方法": 方法表, "字段": 字段表, "环境": 环境}
        声明变量(环境, 类名, {"类型": "类构造器", "类名": 类名})
        返回 0
    结束

    如果 k == "导入" 则
        返回 执行导入(语句, 环境)
    结束

    如果 k == "匹配" 则
        返回 执行匹配(语句, 环境)
    结束

    # 表达式语句：求值后丢弃
    让 v = 求值(语句, 环境)
    如果 是异常(v) 则 返回 v
    返回 0
结束

# 模块缓存：绝对路径 -> 导出字典（模块顶层符号的合并结果）。
# 重复导入同一模块直接命中缓存，跳过读文件/解析/执行，避免重复副作用。
让 模块缓存 = {}
让 根目录 = ""   # 惰性缓存的进程工作目录（绝对路径缓存键用）

# OOP 类注册表：类名 -> 类对象 {"类型":"类","名字":..,"父类":..,"方法":{名:fn},"字段":[{名,默认节点}],"环境":..}
# 模块级全局字典；类定义时写入，实例化/方法查找/继承/super 均经此表按名定位。
让 类注册表 = {}

# 导入模块：读文件 -> 解析 -> 子环境执行 -> 合并顶层符号
# 命名空间形式：导入 "路径" 作为 名 → 不合并符号，把模块导出字典绑定为 名
函数 执行导入(语句, 环境)
    让 路径 = 语句["路径"]
    如果 非 包含(路径, ".co") 则
        路径 = 路径 + ".co"
    结束
    # ---- 生态回退：本地无此文件时，查 ~/.cocn/registry/<包名>/当前/<包名>.co ----
    # cocn install 会把包的 lib 入口复制为 当前/<包名>.co，故此处无需解析 co.toml 即可定位。
    让 包名 = 语句["路径"]
    如果 包含(包名, "/") 则
        让 段 = 分割(包名, "/")
        包名 = 段[长度(段) - 1]
    结束
    如果 包含(包名, ".co") 则
        包名 = 分割(包名, ".co")[0]
    结束
    如果 包名 != "" 且 非 文件存在(路径) 则
        让 家目录 = 环境变量("HOME")
        如果 家目录 != "" 且 家目录 != 空 则
            让 候选 = 家目录 + "/.cocn/registry/" + 包名 + "/当前/" + 包名 + ".co"
            如果 文件存在(候选) 则
                路径 = 候选
            结束
        结束
    结束
    # 绝对路径作为缓存键（消除相对路径歧义）
    # 相对路径解析：优先按「用户工作目录」定位。
    # 背景：解释器自身 cwd 被设为 src（为让 导入 "求值器" 命中），直接把相对路径交给 读文件
    # 会按 src 解析，于是用户程序里 导入 "同目录模块" 一律找不到。此处先试 PWD；
    # 命中则改用绝对路径（路径与缓存键同步），未命中保持旧行为，确保不回归既有门禁。
    让 缓存键 = 路径
    如果 非 (长度(路径) > 0 且 路径[0] == "/") 则
        让 用户目录 = 去空白(环境变量("PWD"))
        如果 用户目录 != "" 且 用户目录 != 空 且 文件存在(用户目录 + "/" + 路径) 则
            路径 = 用户目录 + "/" + 路径
            缓存键 = 路径
        否则
            如果 根目录 == "" 则
                让 工作目录文件 = 求值临时目录() + "/cocn_cwd.txt"
                执行命令("pwd > '" + 工作目录文件 + "'")
                根目录 = 去空白(读文件(工作目录文件))
            结束
            缓存键 = 根目录 + "/" + 路径
        结束
    结束
    # 命名空间名（可选，由解析器写入 AST 字段）
    让 命名空间名 = ""
    如果 包含(语句, "命名空间") 且 语句["命名空间"] != "" 且 语句["命名空间"] != 空 则
        命名空间名 = 语句["命名空间"]
    结束
    # ---- 缓存命中：直接取导出字典，不重复执行模块顶层代码 ----
    让 导出 = 空
    如果 包含(模块缓存, 缓存键) 则
        导出 = 模块缓存[缓存键]
    否则
        让 源 = 读文件(路径)
        导入 "语法分析器"
        让 ast = 解析源(源)
        让 子 = {"变量": [{}], "父": 环境}
        提升顶层函数(ast["语句"], 子)
        让 r = 执行块(ast["语句"], 子)
        如果 是异常(r) 则 返回 r
        导出 = 层导出字典(子["变量"])
        模块缓存[缓存键] = 导出
    结束
    # ---- 交付：命名空间绑定 或 全量合并 ----
    如果 命名空间名 != "" 则
        声明变量(环境, 命名空间名, 导出)
        返回 0
    结束
    让 键s = 键(导出)
    对于 i 从 0 到 长度(键s) - 1 循环
        声明变量(环境, 键s[i], 导出[键s[i]])
    结束
    返回 0
结束

# ---------------- 根环境注册 ----------------

# 把全部内置函数占位值注册到根环境
函数 注册内置(env)
    让 v = env["变量"][0]
    v["输出"] = {"类型": "内置", "名字": "输出"}
    v["输出错误"] = {"类型": "内置", "名字": "输出错误"}
    v["断言"] = {"类型": "内置", "名字": "断言"}
    v["断言相等"] = {"类型": "内置", "名字": "断言相等"}
    v["长度"] = {"类型": "内置", "名字": "长度"}
    v["包含"] = {"类型": "内置", "名字": "包含"}
    v["类型"] = {"类型": "内置", "名字": "类型"}
    v["转整数"] = {"类型": "内置", "名字": "转整数"}
    v["转浮点"] = {"类型": "内置", "名字": "转浮点"}
    v["转字符串"] = {"类型": "内置", "名字": "转字符串"}
    v["转布尔"] = {"类型": "内置", "名字": "转布尔"}
    v["开头是"] = {"类型": "内置", "名字": "开头是"}
    v["结尾是"] = {"类型": "内置", "名字": "结尾是"}
    v["十六进制"] = {"类型": "内置", "名字": "十六进制"}
    v["二进制"] = {"类型": "内置", "名字": "二进制"}
    v["八进制"] = {"类型": "内置", "名字": "八进制"}
    v["绝对值"] = {"类型": "内置", "名字": "绝对值"}
    v["最大值"] = {"类型": "内置", "名字": "最大值"}
    v["最小值"] = {"类型": "内置", "名字": "最小值"}
    # 读取命令行：返回程序命令行参数列表（不含程序名）。
    # 由 cocn 启动器经环境变量 COCN_ARGV（换行分隔的字符串）传入；宿主不提供此能力，属层扩展。
    v["读取命令行"] = {"类型": "内置", "名字": "读取命令行"}
    v["平方根"] = {"类型": "内置", "名字": "平方根"}
    v["取整"] = {"类型": "内置", "名字": "取整"}
    v["向下取整"] = {"类型": "内置", "名字": "向下取整"}
    v["向上取整"] = {"类型": "内置", "名字": "向上取整"}
    v["截断"] = {"类型": "内置", "名字": "截断"}
    v["幂"] = {"类型": "内置", "名字": "幂"}
    v["符号"] = {"类型": "内置", "名字": "符号"}
    v["正弦"] = {"类型": "内置", "名字": "正弦"}
    v["余弦"] = {"类型": "内置", "名字": "余弦"}
    v["自然对数"] = {"类型": "内置", "名字": "自然对数"}
    v["圆周率"] = {"类型": "内置", "名字": "圆周率"}
    v["截取"] = {"类型": "内置", "名字": "截取"}
    v["查找"] = {"类型": "内置", "名字": "查找"}
    v["分割"] = {"类型": "内置", "名字": "分割"}
    v["连接"] = {"类型": "内置", "名字": "连接"}
    v["替换"] = {"类型": "内置", "名字": "替换"}
    v["追加"] = {"类型": "内置", "名字": "追加"}
    v["反转"] = {"类型": "内置", "名字": "反转"}
    v["排序"] = {"类型": "内置", "名字": "排序"}
    v["切片"] = {"类型": "内置", "名字": "切片"}
    v["字节数"] = {"类型": "内置", "名字": "字节数"}
    v["字节"] = {"类型": "内置", "名字": "字节"}
    v["字节列表"] = {"类型": "内置", "名字": "字节列表"}
    v["字节转文本"] = {"类型": "内置", "名字": "字节转文本"}
    v["输入"] = {"类型": "内置", "名字": "输入"}
    v["读取文件"] = {"类型": "内置", "名字": "读取文件"}
    v["写入文件"] = {"类型": "内置", "名字": "写入文件"}
    v["执行"] = {"类型": "内置", "名字": "执行"}
    v["范围"] = {"类型": "内置", "名字": "范围"}
    v["累加"] = {"类型": "内置", "名字": "累加"}
    v["去重"] = {"类型": "内置", "名字": "去重"}
    v["插入"] = {"类型": "内置", "名字": "插入"}
    v["弹出"] = {"类型": "内置", "名字": "弹出"}
    v["索引"] = {"类型": "内置", "名字": "索引"}
    v["计数"] = {"类型": "内置", "名字": "计数"}
    v["键"] = {"类型": "内置", "名字": "键"}
    v["值"] = {"类型": "内置", "名字": "值"}
    v["删除键"] = {"类型": "内置", "名字": "删除键"}
    v["条目"] = {"类型": "内置", "名字": "条目"}
    v["大写"] = {"类型": "内置", "名字": "大写"}
    v["小写"] = {"类型": "内置", "名字": "小写"}
    v["去除空白"] = {"类型": "内置", "名字": "去除空白"}
    v["十六进制"] = {"类型": "内置", "名字": "十六进制"}
    v["二进制"] = {"类型": "内置", "名字": "二进制"}
    v["八进制"] = {"类型": "内置", "名字": "八进制"}
    v["位计数"] = {"类型": "内置", "名字": "位计数"}
    v["取位"] = {"类型": "内置", "名字": "取位"}
    v["置位"] = {"类型": "内置", "名字": "置位"}
    v["随机"] = {"类型": "内置", "名字": "随机"}
    v["随机整数"] = {"类型": "内置", "名字": "随机整数"}
