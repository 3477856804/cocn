# ============================================================
# 虚拟机.co —— coCN 栈式字节码虚拟机（扩展版）
#
# 把语法分析器产出的 AST 编译为字节码，再用栈式虚拟机执行。
# 目的：替代树遍历求值器，提升执行速度（语义保持一致）。
#
# 三部分：
#   1. 指令表（整数操作码 + 助记符字典）
#   2. 编译器（AST → 字节码）
#   3. 虚拟机（执行字节码）
#
# 入口：
#   函数 编译执行AST(ast) -> 值   # 直接吃 AST；遇不支持节点返回 {"__VM不支持__":1}
#   函数 编译执行(字符串 源)       # 词法→语法→编译→执行
#
# 作用域模型（第二阶段：完整词法闭包）：
#   - 全局变量：全局槽位数组（共享、可变）
#   - 函数局部：每个局部槽是「单元」（单元素列表 [v]），按引用捕获
#   - 自由变量：子函数通过 OP_闭包捕获 把父作用域的单元按引用打包成闭包数组
#   - 未在局部/全局表中登记的名字视为宿主内置函数，压入内置标记值
#
# 失败语义：编译器遇到无法处理的 AST 节点时置 g_不支持=1，
#           编译完成后由入口返回回退哨兵，解释器据此改用树遍历求值器。
# ============================================================

# ============================================================
# 虚拟机状态（【必须放在本模块最前面】）
# ------------------------------------------------------------
# 宿主的变量查找是「作用域链 + 作用域内线性 strcmp 扫描」：
# 读一个模块级全局变量 = 先扫调用函数的全部局部名，再扫模块环境的
# 全部名字。本模块的环境里挤着 60+ 个操作码常量，全局变量声明得
# 越靠后，单次读取越贵（实测差 ~0.6us/次）。
# 热路径每条指令要读 v_异常 / v_栈 / v_帧栈，所以把运行期状态
# 提到模块最前面，让它们在模块环境里排第 1..N 位。
# 声明顺序只影响查找代价，不影响任何语义。
# ============================================================
让 v_栈 = []
让 v_帧栈 = []
让 v_全局槽 = []
让 v_异常槽 = [0]
# 调用深度原本是标量全局：热路径每次调用都要读写它，
# 而宿主读一个模块级全局要先扫完调用函数的全部局部名（实测 ≈1us/次）。
# 改成 1 元列表后，v_执行 可以把「列表引用」缓存进局部，
# 之后 槽[0] 的读写只多一次下标（≈0.15us），语义完全不变。
让 v_深度槽 = [0]
让 v_调用深度上限 = 15000
让 v_当前行 = 0
让 v_当前列 = 0
让 v_待捕获异常 = 0
让 v_待返回 = 0
让 v_有待返回 = 0
让 v_返回栈深 = 0
让 v_待最终槽 = [0]
让 v_最终块栈深 = 0
# 运行期「已声明名字」集合，供 常量不能重复声明 检查（宿主的 env_get 指针判存）
让 v_声明表 = {}

# ============================================================
# 第一部分：指令表（整数操作码）
# ============================================================
让 OP_加载常量 = 1
让 OP_加载全局 = 2
让 OP_存储全局 = 3
让 OP_加载局部 = 4
让 OP_存储局部 = 5
让 OP_二元 = 6
让 OP_一元 = 7
让 OP_跳转 = 8
让 OP_跳转若假 = 9
让 OP_调用 = 10
让 OP_返回 = 11
让 OP_创建列表 = 12
让 OP_创建字典 = 13
让 OP_下标获取 = 14
让 OP_下标赋值 = 15
让 OP_弹出 = 16
让 OP_暂停 = 17
让 OP_加载内置 = 18
让 OP_跳转若真 = 19
# —— 闭包 ——
让 OP_加载自由 = 20
让 OP_存储自由 = 21
让 OP_闭包捕获 = 22
让 OP_取局部单元 = 30
让 OP_取自由单元 = 31
# —— 复合类型 ——
让 OP_创建元组 = 23
让 OP_枚举声明 = 32
# OP_循环推进：整数/浮点循环的「步长更新 + 续判条件」合并成一条指令。
#   循环变量/终点/步长/模式 全部放在帧的单元里（不再每轮经操作数栈倒来倒去），
#   一轮循环省掉 3 条「加载局部」+ 1 条「二元」+ 1 条「存储局部」。
让 OP_循环推进 = 33
# —— 异常 ——
让 OP_抛出 = 24
让 OP_进入处理 = 25
让 OP_退出处理 = 26
让 OP_加载异常 = 28
让 OP_清除异常 = 29
# —— 遍历 ——
让 OP_物化遍历 = 27
# —— 快捷内置操作（字符串/列表/字典/数学，直接由 VM 主循环派发宿主原语）——
让 OP_串截取 = 34
让 OP_串查找 = 35
让 OP_串替换 = 36
让 OP_串大写 = 37
让 OP_串小写 = 38
让 OP_表追加 = 39
让 OP_表插入 = 40
让 OP_表弹出 = 41
让 OP_表切片 = 42
让 OP_表排序 = 43
让 OP_表索引 = 44
让 OP_表包含 = 45
让 OP_字典键 = 46
让 OP_字典值 = 47
让 OP_字典删除 = 48
让 OP_类型判断 = 49
让 OP_数正弦 = 50
让 OP_数余弦 = 51
让 OP_数对数 = 52
让 OP_数平方根 = 53
让 OP_数绝对值 = 54
让 OP_数取整 = 55
让 OP_数幂 = 56
让 OP_设置行 = 57
让 OP_循环条件 = 58
让 OP_检查重抛 = 59
# —— 宿主语义守卫（0.1.16）——
# OP_检查标注：栈顶【不弹出】地按类型标注复查，不符则置 v_异常。
# 用在三处：变量声明（宿主 ND_VAR_DECL 的 ensure_type）、赋值（env_get_type 复查）、
# 返回语句（g_cur_ret_type）。标注与「哪里」都以常量索引传入，报错文案与求值器
# 通道共用同一份 类型错误消息，保证双通道逐字节一致。
让 OP_检查标注 = 60
# OP_循环校验：入口一次性校验 起点/终点/步长（宿主 num_of + 步长非零），
#   把归一化后的起点回推栈上（写回循环变量），并算出「浮点通道」标志存进模式槽。
# OP_循环条件 多带一个操作数（模式槽），每轮按标志选 整数比较 / 浮点+0.0001 容差比较。
让 OP_循环校验 = 62
# OP_报错：栈顶是消息字符串，弹出后转成 v_异常（编译期已确定必错的分支用）
让 OP_报错 = 63
# OP_检查常量重复 指令[1]=名字常量索引：宿主 ND_VAR_DECL 的 is_const 分支
# OP_检查赋值目标 指令[1]=0局部/1全局 指令[2]=槽位：宿主「不能给函数名赋值」
让 OP_检查常量重复 = 64
让 OP_检查赋值目标 = 65
# OP_记标注 指令[1]=名字常量索引：把名字登记进「已声明表」（宿主的 env_set 占位）
让 OP_记标注 = 66
# 链式下标赋值 t[r][c] = v / m[r][c] = v：栈上带齐 父/行/行视图/列/值，
# 父是张量时走宿主的整链写入（行视图只是临时副本，写它等于丢），
# 否则写进行视图（层的列表是引用，行为与宿主一致）。
让 OP_下标链赋值 = 67
# OP_加载argc：压入本帧实参数量。服务于「默认参数前置」：宿主没有默认参数，
# 求值器通道却有（缺省实参时用默认值表达式，且【在函数体之前】求值）。
# 编译函数段 为每个带默认值的形参 i 生成：
#   加载argc / 常量 i / 二元 ">" / 跳转若真(跳过) / <默认表达式> / 存储局部 i
# 即「实参没给到第 i 个才求默认值」，与 调用用户函数 的缺省分支同序同义。
让 OP_加载argc = 68

# 内置名白名单：用于把 OP_加载内置 的「查无此名」报成和求值器通道一样的
# 「未定义变量: X」（求值器 求值 标识符分支就是这个文案，门禁做逐字节对照）。
#
# 关键：这张表【必须】从 新建环境() 现取，不能手抄。
# 之前这里手抄了约 80 个名字，而 求值器.co 的注册表有 204 个——结果 时钟、
# 字节列表、深拷贝、随机种子 这些【本来就有】的内置被误报成「未定义变量」，
# 是新的假红。手抄必然与注册表漂移，所以运行时直接从唯一事实来源生成。
让 v_内置白名单 = {}

函数 v_确保内置白名单()
    如果 长度(v_内置白名单) > 0 则
        返回
    结束
    让 env = 新建环境()
    v_内置白名单 = 层导出字典(env["变量"])
结束

让 助记符 = {"1":"加载常量","2":"加载全局","3":"存储全局","4":"加载局部","5":"存储局部","6":"二元","7":"一元","8":"跳转","9":"跳转若假","10":"调用","11":"返回","12":"创建列表","13":"创建字典","14":"下标获取","15":"下标赋值","16":"弹出","17":"暂停","18":"加载内置","19":"跳转若真","20":"加载自由","21":"存储自由","22":"闭包捕获","23":"创建元组","24":"抛出","25":"进入处理","26":"退出处理","27":"物化遍历","28":"加载异常","29":"清除异常","30":"取局部单元","31":"取自由单元","32":"枚举声明","34":"串截取","35":"串查找","36":"串替换","37":"串大写","38":"串小写","39":"表追加","40":"表插入","41":"表弹出","42":"表切片","43":"表排序","44":"表索引","45":"表包含","46":"字典键","47":"字典值","48":"字典删除","49":"类型判断","50":"数正弦","51":"数余弦","52":"数对数","53":"数平方根","54":"数绝对值","55":"数取整","56":"数幂","57":"设置行"}

# ============================================================
# 基础工具
# ============================================================
函数 为整数(b) -> 整数
    如果 b 则 返回 1 结束
    返回 0
结束

# ============================================================
# 编译器状态
# ============================================================
让 g_函数表 = []
让 g_指令 = []
让 g_常量 = []
让 g_局部表 = {}
让 g_局部数 = 0
让 g_全局表 = {}
让 g_全局槽数 = 0
让 g_不支持 = 0
# 当前正在编译的函数的自由变量表（名字 -> 闭包槽位）
让 g_自由表 = {}
让 g_自由数 = 0
# 外层作用域局部表栈（用于区分「自由变量」与「宿主内置函数」）
让 g_作用域栈 = []

# 判断名字是否在某个外层函数作用域中声明（即它是真正的自由变量，而非宿主内置）
函数 是外层名(名字) -> 整数
    对于 s 从 0 到 长度(g_作用域栈) - 1 循环
        如果 包含(g_作用域栈[s], 名字) 则
            返回 1
        结束
    结束
    返回 0
结束
# 当前是否处于函数体内部（决定命名函数落到局部还是全局）
让 g_在函数内 = 0
# 循环栈：每层 {"跳出":[...],"继续":[...]}
让 g_循环栈 = []
# 当前函数内为 for-each / 匹配 预留的临时单元数量
让 g_临时数 = 0
# 编译期「标注表」：宿主用 env_set_type/env_get_type 在运行时按作用域链记标注
# （co_old.c:993/1017）。字节码通道的名字在编译期就解析成 局部槽/全局槽，
# 所以这里用两张表等价复刻：L 表随函数段重置（等价于函数的新作用域），
# G 表全程序累计（等价于根作用域）。赋值语句据此复查，和求值器通道同文案。
让 g_标注L = {}
让 g_标注G = {}
# 当前函数段的返回类型标注（宿主 g_cur_ret_type），编译 返回 语句时用它复查。
让 g_当前返回类型 = ""

函数 标记不支持()
    g_不支持 = 1
结束

函数 登记常量(v) -> 整数
    对于 i 从 0 到 长度(g_常量) - 1 循环
        如果 g_常量[i] == v 且 类型(g_常量[i]) == 类型(v) 则 返回 i 结束
    结束
    追加(g_常量, v)
    返回 长度(g_常量) - 1
结束

函数 发射(指令)
    追加(g_指令, 指令)
结束

# ---- 报错坐标尾槽（0.1.17，§4.4）----
# 约定：凡是【运行期能报错】的操作码，编译期一律在指令末尾追加两槽
# 「行, 列」——就是宿主 make_node 时刻盖在 AST 节点上的那对坐标
# （标定见 语法分析器.co 的 盖位置/盖在 与 求值器.co 的 标(节点)）。
# -1 表示这条指令没有可归属的节点（语句级检查、旧式指令），退回语句坐标。
#
# 为什么不在每条指令执行前把坐标同步进 v_当前行/列：
# 逐指令同步 = 每个 opcode 两次全局写，实测把 fib(20) 从 13.6s 拖到 48s，
# 字节码通道就废了。所以坐标只在【报错那条冷路径】上取：
# 主循环检测到 v_异常 时，回看【上一条指令】的尾槽回填。
函数 指令行(指令) -> 整数
    让 n = 长度(指令)
    如果 n < 3 则 返回 -1 结束
    让 值 = 指令[n - 2]
    如果 类型(值) != "整数" 则 返回 -1 结束
    返回 值
结束

函数 指令列(指令) -> 整数
    让 n = 长度(指令)
    如果 n < 3 则 返回 -1 结束
    让 值 = 指令[n - 1]
    如果 类型(值) != "整数" 则 返回 -1 结束
    返回 值
结束

# 节点坐标尾槽：节点没盖到（老 AST/外部构造）时给 -1，让运行期退回语句坐标。
函数 节点行(节点) -> 整数
    如果 是节点(节点) 且 包含(节点, "行") 则
        返回 转整数(节点["行"])
    结束
    返回 -1
结束

函数 节点列(节点) -> 整数
    如果 是节点(节点) 且 包含(节点, "列") 则
        返回 转整数(节点["列"])
    结束
    返回 -1
结束

# ---- 冷路径报错：只有【正在抛错】时才读尾槽，热路径零开销 ----
# 尾槽 >= 0 用节点坐标（对齐宿主 make_node 时机），-1 退回语句坐标（OP_设置行）。
# 消息属于内置 runtime_error(NULL) 族（下标必须是数字 / X 需要数字参数…）时
# 一律 0/0 —— 判据共用 求值器.co 的 是无坐标消息，两条通道不可能分叉。
函数 v_报错(指令, 消息)
    如果 是无坐标消息(消息) 则
        v_异常槽[0] = {"类型": "运行时错误", "消息": 消息, "行": 0, "列": 0}
        返回 0
    结束
    让 行 = 指令行(指令)
    如果 行 < 0 则
        行 = v_当前行
    结束
    让 列 = 指令列(指令)
    如果 列 < 0 则
        列 = v_当前列
    结束
    v_异常槽[0] = {"类型": "运行时错误", "消息": 消息, "行": 行, "列": 列}
    返回 0
结束

# 编译期把节点坐标挂到指令尾部。只在【编译期】跑一次，
# 运行期的开销是「长度() + 两次下标」，且只发生在报错那条冷路径上。
# 形参不写类型标注：这里传进来的可能是 空/非字典（老 AST、外部构造），
# 带了标注就变成宿主的「类型错误（函数参数）」——那是运行期错误，不是我们要的。
函数 带尾(指令, 节点)
    追加(指令, 节点行(节点))
    追加(指令, 节点列(节点))
    返回 指令
结束

函数 发跳转占位(操作码) -> 整数
    发射([操作码, 0])
    返回 长度(g_指令) - 1
结束

函数 修补到当前(下标)
    g_指令[下标][1] = 长度(g_指令)
结束

函数 是局部名(名字) -> 整数
    返回 为整数(包含(g_局部表, 名字))
结束

函数 是全局名(名字) -> 整数
    返回 为整数(包含(g_全局表, 名字))
结束

# 编译期标注表读写：局部表随函数段重置（等价宿主函数新作用域），
# 全局表全程序累计（等价根作用域）。赋值/返回 的复查据此发射 OP_检查标注。
函数 登记标注编译(名字, 标注)
    如果 标注 != "" 则
        如果 是局部名(名字) 则
            g_标注L[名字] = 标注
            返回
        结束
        g_标注G[名字] = 标注
    结束
结束

# 宿主的标注查找在【第一个声明该名字的作用域】就停下（co_old.c:1017 env_get_type）。
# 字节码通道的作用域是「段内局部 + 根全局」两张编译期表，所以：
#   段内声明过 → 用段内标注；
#   段内没声明、但外层函数声明过（是外层名）→ 该名字已被外层局部遮蔽，
#     不能用根作用域的同名标注去判它，否则闭包计数器这类写法会被误杀
#     （顶层 列表 数 = [...] 之后，内层 让 数 = 0 / 数 = 数 + 1 报「期望 列表」）；
#   都没有 → 用根标注。
函数 查标注编译(名字) -> 字符串
    如果 包含(g_标注L, 名字) 则 返回 g_标注L[名字] 结束
    如果 是外层名(名字) == 1 则 返回 "" 结束
    如果 包含(g_标注G, 名字) 则 返回 g_标注G[名字] 结束
    返回 ""
结束

# 老 AST / 外部构造的节点可能没有布尔或数字字段，缺失时按 0 处理
函数 可选数字字段(d, 键名) -> 整数
    如果 类型(d) != "字典" 或 非 包含(d, 键名) 则
        返回 0
    结束
    让 v = d[键名]
    如果 类型(v) == "整数" 或 类型(v) == "布尔" 则
        返回 转整数(v)
    结束
    返回 0
结束

# 栈顶【不弹出】地按标注复查；不符则置 v_异常。指令[1]=标注常量索引，指令[2]=哪里
函数 发射标注检查(标注, 哪里)
    如果 标注 != "" 则
        发射([OP_检查标注, 登记常量(标注), 登记常量(哪里)])
    结束
结束

函数 是节点(v) -> 整数
    如果 类型(v) != "字典" 则 返回 0 结束
    返回 为整数(包含(v, "类型"))
结束

# 在当前作用域中，把名字 N 的「值」压栈（局部 / 外层自由 / 全局 / 内置）
#
# 顺序很关键：【外层作用域必须排在根全局之前】。以前这里先查全局表，
# 于是「顶层有 列表 数 = [...]」时，内层函数里 让 数 = 0 的遮蔽失效——
# 内层对 数 的读写直接打到根全局那格，顶层的列表被静默改成 1
# （实测：VM 通道 后: 1，求值器通道 后: [4, 2, 7]）。宿主是按作用域链
# 由内向外解析的，遮蔽是词法作用域的基本承诺，不能反过来。
函数 编译加载名字(名字, 节点)
    如果 是局部名(名字) 则
        发射(带尾([OP_加载局部, g_局部表[名字]], 节点))
        返回
    结束
    # 既非本段局部：若在外层作用域声明则为自由变量（外层优先于根全局）
    如果 是外层名(名字) 则
        如果 非 包含(g_自由表, 名字) 则
            g_自由表[名字] = g_自由数
            g_自由数 = g_自由数 + 1
        结束
        发射(带尾([OP_加载自由, g_自由表[名字]], 节点))
        返回
    结束
    如果 是全局名(名字) 则
        # 全局槽命中时其实不会报错，坐标无用；但统一挂尾不改变语义，
        # 省掉一个分支（挂尾只在编译期多两格，运行期零成本）。
        发射(带尾([OP_加载全局, g_全局表[名字]], 节点))
        返回
    结束
    如果 裸标识符上下文 == 1 则
        # 调用位置的裸名字、且作用域里【没有同名声明】：压 0 占位。
        # 真正的分派推迟到 OP_调用（实参求值之后）：命中内置白名单就跑内置，
        # 否则报 0/0「未知内置函数: X」。实测 m11：实参里的错误永远优先。
        发射([OP_加载常量, 登记常量(0)])
        返回
    结束
    如果 名字 == "真" 或 名字 == "假" 则
        # 词法/语法层会把 真/假 归成字面量节点，正常不走这里；外部构造的
        # 老 AST 可能带过来，保持与 HEAD 一致的裸发射。
        发射([OP_加载内置, 名字])
        返回
    结束
    # 值位置：查无此名 → 带坐标「未定义变量: X」（实测 e01/e03 (2,8)=标识符节点）。
    # 坐标走 指令尾槽（编译期盖），由 OP_加载内置 交给 v_报错 判定。
    发射(带尾([OP_加载内置, 名字], 节点))
结束

# 调用位置的裸标识符标志：编译 函数调用 的被调者那一刻置 1，其余时刻 0。
# 宿主的调用分派与值分派是两条路（实测 e07/p1/p2/p3）：
#   调用位置 = 先看作用域里有没有同名【可调用】值，再查 builtin 表，都没有才 未知内置函数；
#   值位置   = 作用域链查不到就立刻报带坐标的 未定义变量。
让 裸标识符上下文 = 0

# 在父作用域中，把名字 N 对应的「单元」（而非值）压栈，用于构造子函数闭包
函数 编译取名字单元(名字)
    如果 是局部名(名字) 则
        发射([OP_取局部单元, g_局部表[名字]])
        返回
    结束
    如果 是全局名(名字) 则
        # 全局量按名字动态读取，不进闭包；子函数内部直接用 OP_加载全局
        返回
    结束
    # 父作用域的自由变量：取父的闭包单元
    如果 非 包含(g_自由表, 名字) 则
        g_自由表[名字] = g_自由数
        g_自由数 = g_自由数 + 1
    结束
    发射([OP_取自由单元, g_自由表[名字]])
结束

# 在当前作用域中，对名字 N 赋值（栈顶为值）
函数 编译存储名字(名字)
    如果 是局部名(名字) 则
        发射([OP_存储局部, g_局部表[名字]])
        返回
    结束
    # 与 编译加载名字 同一套顺序：外层作用域优先于根全局，遮蔽才成立
    如果 是外层名(名字) 则
        如果 非 包含(g_自由表, 名字) 则
            g_自由表[名字] = g_自由数
            g_自由数 = g_自由数 + 1
        结束
        发射([OP_存储自由, g_自由表[名字]])
        返回
    结束
    如果 是全局名(名字) 则
        发射([OP_存储全局, g_全局表[名字]])
        返回
    结束
    # 未声明的名字：按全局槽处理（与顶层声明等价）
    如果 非 包含(g_全局表, 名字) 则
        g_全局表[名字] = g_全局槽数
        g_全局槽数 = g_全局槽数 + 1
    结束
    发射([OP_存储全局, g_全局表[名字]])
结束

# ============================================================
# 收集局部变量（参数 + 体内声明 + for 循环变量）
# ============================================================
函数 收集局部(函数节点)
    让 参数表 = 函数节点["参数"]
    g_局部表 = {}
    g_标注L = {}
    g_局部数 = 0
    让 类型表 = 函数节点["参数类型"]
    对于 i 从 0 到 长度(参数表) - 1 循环
        g_局部表[参数表[i]] = g_局部数
        g_局部数 = g_局部数 + 1
        # 宿 invoke_func 给每个形参 env_set_type（co_old.c:5264），
        # 于是形参在函数体内被重新赋值时同样按声明标注复查
        如果 类型(类型表) == "列表" 且 i < 长度(类型表) 则
            让 形参标注 = 类型表[i]
            如果 类型(形参标注) == "字符串" 且 形参标注 != "" 且 形参标注 != "可变" 则
                g_标注L[参数表[i]] = 形参标注
            结束
        结束
    结束
    让 体 = 函数节点["体"]["语句"]
    对于 j 从 0 到 长度(体) - 1 循环
        收集局部语句(体[j])
    结束
结束

函数 登记局部名(名字)
    如果 非 包含(g_局部表, 名字) 则
        g_局部表[名字] = g_局部数
        g_局部数 = g_局部数 + 1
    结束
结束

函数 收集局部语句(语句)
    如果 非 是节点(语句) 则
        返回
    结束
    让 k = 语句["类型"]
    如果 k == "变量声明" 则
        登记局部名(语句["名字"])
        返回
    结束
    如果 k == "函数定义" 则
        登记局部名(语句["名字"])
        返回
    结束
    如果 k == "对于" 则
        登记局部名(语句["变量"])
        对于 j 从 0 到 长度(语句["体"]) - 1 循环
            收集局部语句(语句["体"][j])
        结束
        返回
    结束
    如果 k == "如果" 则
        对于 j 从 0 到 长度(语句["则体"]) - 1 循环
            收集局部语句(语句["则体"][j])
        结束
        对于 c 从 0 到 长度(语句["否则链"]) - 1 循环
            对于 j 从 0 到 长度(语句["否则链"][c]["体"]) - 1 循环
                收集局部语句(语句["否则链"][c]["体"][j])
            结束
        结束
        返回
    结束
    如果 k == "当" 则
        对于 j 从 0 到 长度(语句["体"]) - 1 循环
            收集局部语句(语句["体"][j])
        结束
        返回
    结束
    如果 k == "尝试" 则
        对于 j 从 0 到 长度(语句["体"]) - 1 循环
            收集局部语句(语句["体"][j])
        结束
        如果 语句["捕获变量"] != "" 且 语句["捕获变量"] != 空 则
            登记局部名(语句["捕获变量"])
        结束
        对于 j 从 0 到 长度(语句["捕获体"]) - 1 循环
            收集局部语句(语句["捕获体"][j])
        结束
        对于 j 从 0 到 长度(语句["最终体"]) - 1 循环
            收集局部语句(语句["最终体"][j])
        结束
        返回
    结束
结束

# ============================================================
# 表达式编译
# ============================================================
函数 编译表达式(节点)
    如果 非 是节点(节点) 则
        发射([OP_加载常量, 登记常量(0)])
        返回
    结束
    让 k = 节点["类型"]

    如果 k == "字面量" 则
        让 lt = 节点["字面类型"]
        让 raw = 节点["值"]
        如果 lt == "整数" 则
            发射([OP_加载常量, 登记常量(转整数(raw))])
        否则
            如果 lt == "浮点" 则
                发射([OP_加载常量, 登记常量(转浮点(raw))])
            否则
                如果 lt == "布尔" 则
                    # 产生宿主真布尔值（而非整数），保证 类型(真) == "布尔"
                    让 布尔常量 = 0 == 1
                    如果 raw == "1" 或 raw == "真" 则
                        布尔常量 = 0 == 0
                    结束
                    发射([OP_加载常量, 登记常量(布尔常量)])
                否则
                    如果 lt == "空" 则
                        发射([OP_加载常量, 登记常量(空)])
                    否则
                        发射([OP_加载常量, 登记常量(raw)])
                    结束
                结束
            结束
        结束
        返回
    结束

    如果 k == "标识符" 则
        编译加载名字(节点["名字"], 节点)
        返回
    结束

    如果 k == "二元" 则
        让 op = 节点["运算符"]
        如果 op == "且" 则
            # 短路求值，结果为宿主真布尔值
            编译表达式(节点["左"])
            让 假处 = 发跳转占位(OP_跳转若假)
            编译表达式(节点["右"])
            发射([OP_一元, "真值"])
            发射([OP_加载常量, 登记常量(0)])
            发射([OP_二元, "!="])
            让 结束处 = 发跳转占位(OP_跳转)
            修补到当前(假处)
            发射([OP_加载常量, 登记常量(0 == 1)])
            修补到当前(结束处)
            返回
        结束
        如果 op == "或" 则
            # 短路求值，结果为宿主真布尔值
            编译表达式(节点["左"])
            让 真处 = 发跳转占位(OP_跳转若真)
            编译表达式(节点["右"])
            发射([OP_一元, "真值"])
            发射([OP_加载常量, 登记常量(0)])
            发射([OP_二元, "!="])
            让 结束处 = 发跳转占位(OP_跳转)
            修补到当前(真处)
            发射([OP_加载常量, 登记常量(0 == 0)])
            修补到当前(结束处)
            返回
        结束
        编译表达式(节点["左"])
        编译表达式(节点["右"])
        发射(带尾([OP_二元, op], 节点))
        返回
    结束

    如果 k == "一元" 则
        编译表达式(节点["操作数"])
        发射(带尾([OP_一元, 节点["运算符"]], 节点))
        返回
    结束

    如果 k == "列表字面量" 则
        如果 节点["是否推导式"] == 1 则
            标记不支持()
            返回
        结束
        让 元素 = 节点["元素"]
        对于 i 从 0 到 长度(元素) - 1 循环
            编译表达式(元素[i])
        结束
        发射([OP_创建列表, 长度(元素)])
        返回
    结束

    如果 k == "字典字面量" 则
        如果 节点["是否推导式"] == 1 则
            标记不支持()
            返回
        结束
        让 键s = 节点["键"]
        让 值s = 节点["值"]
        对于 i 从 0 到 长度(键s) - 1 循环
            编译表达式(键s[i])
            编译表达式(值s[i])
        结束
        发射([OP_创建字典, 长度(键s)])
        返回
    结束

    如果 k == "元组字面量" 则
        让 元素 = 节点["元素"]
        对于 i 从 0 到 长度(元素) - 1 循环
            编译表达式(元素[i])
        结束
        发射([OP_创建元组, 长度(元素)])
        返回
    结束

    如果 k == "下标" 则
        编译表达式(节点["容器"])
        编译表达式(节点["索引"])
        # 保留槽固定放在 指令[1]，坐标尾槽在最后两格：
        # 运行期按 【容器类型 → 下标合法性 → 越界】 三层分派，报错时取本节点坐标。
        发射(带尾([OP_下标获取, 0], 节点))
        返回
    结束

    如果 k == "函数调用" 则
        # 被调者的求值形态必须区分「裸标识符」与「其它表达式」——宿主在这两条路上
        # 报的错完全不同（实测 e04~e08/m11/m12）：
        #   裸标识符：宿主按 builtin 表分派，压根不读同名变量。
        #     · 命中 → 内置字典
        #     · 未命中 → 先压 0 占位，实参照常用 编译加载名字 求值（实参里的
        #       「未定义变量/越界」必须能正常报出，且顺序在分派错误之前），
        #       最终由 OP_调用 报 0/0「未知内置函数: X」。
        #     · 同名变量即使是函数值也走 builtin：输出 表(10) 里 表 是用户函数
        #       名时也一样报「未知内置函数: 表」——这是宿主的分派表优先。
        #   其它表达式（字面量/下标/嵌套调用）：普通求值，不可调用时由
        #     OP_调用 报【带坐标】的「值不是一个函数」。
        让 被调节点 = 节点["被调者"]
        让 裸名 = ""
        如果 是节点(被调节点) 且 被调节点["类型"] == "标识符" 则
            裸名 = 被调节点["名字"]
        结束
        让 旧裸上下文 = 裸标识符上下文
        如果 裸名 != "" 则
            裸标识符上下文 = 1
        结束
        编译表达式(被调节点)
        裸标识符上下文 = 旧裸上下文
        让 参数表 = 节点["参数"]
        对于 i 从 0 到 长度(参数表) - 1 循环
            编译表达式(参数表[i])
        结束
        发射(带尾([OP_调用, 长度(参数表), 登记常量(裸名)], 节点))
        返回
    结束

    如果 k == "函数字面量" 则
        让 序号 = 编译函数段(节点, "")
        # 闭包：在父作用域中取子函数所需自由变量对应的单元
        让 子段 = g_函数表[序号]
        让 自由键s = 键(子段["自由表"])
        对于 i 从 0 到 长度(自由键s) - 1 循环
            编译取名字单元(自由键s[i])
        结束
        发射([OP_闭包捕获, 序号, 子段["自由数"]])
        返回
    结束

    # 未知表达式节点 → 回退
    标记不支持()
    发射([OP_加载常量, 登记常量(0)])
结束

# ============================================================
# 语句编译
# ============================================================
函数 编译语句(节点)
    如果 非 是节点(节点) 则
        编译表达式(节点)
        发射([OP_弹出])
        返回
    结束
    让 k = 节点["类型"]
    
    # 为每条语句附带源码位置信息，运行时异常可据此定位行/列
    如果 包含(节点, "行") 则
        发射([OP_设置行, 节点["行"], 节点["列"]])
    结束

    如果 k == "变量声明" 则
        # 宿主 ND_VAR_DECL：常量重复声明 → ensure_type("变量声明") → env_set_type。
        # 字节码通道在编译期就知道名字落在哪个槽，所以标注记在编译期表里，
        # 后续 赋值 据此复查（与求值器通道的 运行期类型表 等价、同文案）。
        让 标注 = 文本字段(节点, "类型标注")
        让 有初始化 = 为整数(是节点(节点["初始化"]))
        如果 转整数(可选数字字段(节点, "是否常量")) == 1 则
            # 宿主的 常量不能重复声明 只看【是否已声明】，与有没有初始化无关
            发射([OP_检查常量重复, 登记常量(节点["名字"])])
        结束
        如果 有初始化 == 0 且 标注 != "" 则
            # 宿主的裸声明初值是 VAL_NULL，带标注必然报「得到 空」——
            # 层里裸声明的默认值是 0，若照 0 复查会放过 整数 n 这种写法
            发射([OP_报错, 登记常量("类型错误（变量声明）：期望 " + 标注 + "，得到 空")])
        结束
        如果 有初始化 == 1 则
            编译表达式(节点["初始化"])
        否则
            发射([OP_加载常量, 登记常量(0)])
        结束
        发射标注检查(标注, "变量声明")
        编译存储名字(节点["名字"])
        发射([OP_记标注, 登记常量(节点["名字"])])
        登记标注编译(节点["名字"], 标注)
        返回
    结束

    如果 k == "赋值" 则
        编译表达式(节点["值"])
        让 目标 = 节点["目标"]
        如果 是节点(目标) 且 目标["类型"] == "标识符" 则
            # 宿主 ND_ASSIGN：先拒「给函数名赋值」，再按声明时的标注复查
            # 槽位定位与 编译存储名字 保持同一套顺序（局部 / 外层自由 / 全局）
            如果 是局部名(目标["名字"]) 则
                发射([OP_检查赋值目标, 0, g_局部表[目标["名字"]]])
            否则
                如果 是外层名(目标["名字"]) 则
                    如果 非 包含(g_自由表, 目标["名字"]) 则
                        g_自由表[目标["名字"]] = g_自由数
                        g_自由数 = g_自由数 + 1
                    结束
                    发射([OP_检查赋值目标, 2, g_自由表[目标["名字"]]])
                否则
                    如果 是全局名(目标["名字"]) 则
                        发射([OP_检查赋值目标, 1, g_全局表[目标["名字"]]])
                    结束
                结束
            结束
            发射标注检查(查标注编译(目标["名字"]), "赋值")
            编译存储名字(目标["名字"])
        否则
            # 下标赋值：栈 [val, obj, idx]
            # 二维链式（t[r][c] = v、m[r][c] = v）要多带一层 父/行，
            # 因为 求值(t[r]) 出来的行切片是副本，宿主却是直接写进父张量的。
            让 内层链 = 目标["容器"]
            如果 是节点(内层链) 且 内层链["类型"] == "下标" 则
                # 值在 如果 k == "赋值" 开头已经压过一次栈，这里不能再压：
                # OP_下标链赋值 恰好弹 5 槽（值/父/行/行视图/列），多留一槽会污染
                # 后续语句的操作数。HEAD 症状实测：输出 "c" 之后改链元素，整行被吞，
                # 下一条 输出 "d" 打成「7 1」。
                编译表达式(内层链["容器"])          # 父
                编译表达式(内层链["索引"])          # 行
                # 尾槽：保留读挂【内层节点】——列表/普通容器越界在宿主那里正是内层报错
                # （a[0][9][0] = 1 → 第2行,8列 = a[0][9] 的节点，实测 m23）；
                # 链赋值挂【目标节点】= '=' 处（t[5][0] = 1 → 第2行,9列，实测 d04）。
                # 张量例外：宿主把整条链交给 assign_tensor，不经过中间读，
                # 运行期见 保留==1 且 容器是张量 时【跳过】这次读（见 OP_下标获取）。
                发射(带尾([OP_下标获取, 1], 内层链))      # -> 行视图/行引用（父、行留在栈上）
                编译表达式(目标["索引"])            # 列
                发射(带尾([OP_下标链赋值], 目标))
                返回
            结束
            编译表达式(目标["容器"])
            编译表达式(目标["索引"])
            发射(带尾([OP_下标赋值], 目标))
        结束
        返回
    结束

    如果 k == "函数定义" 则
        让 序号 = 编译函数段(节点, 节点["名字"])
        让 子段 = g_函数表[序号]
        让 自由键s = 键(子段["自由表"])
        对于 i 从 0 到 长度(自由键s) - 1 循环
            编译取名字单元(自由键s[i])
        结束
        发射([OP_闭包捕获, 序号, 子段["自由数"]])
        编译存储名字(节点["名字"])
        发射([OP_记标注, 登记常量(节点["名字"])])
        登记标注编译(节点["名字"], "函数")
        返回
    结束

    如果 k == "返回" 则
        # 宿主 ND_RETURN（co_old.c:6030）：函数有 -> 返回类型 时逐条 返回 复查
        如果 是节点(节点["值"]) 则
            编译表达式(节点["值"])
            发射标注检查(g_当前返回类型, "返回语句")
        否则
            如果 g_当前返回类型 != "" 则
                发射([OP_报错, 登记常量("类型错误（返回语句）：期望 " + g_当前返回类型 + "，得到 空")])
            结束
            发射([OP_加载常量, 登记常量(0)])
        结束
        发射([OP_返回])
        返回
    结束

    如果 k == "如果" 则
        编译如果语句(节点)
        返回
    结束

    如果 k == "当" 则
        让 循环开始 = 长度(g_指令)
        编译表达式(节点["条件"])
        让 退出 = 发跳转占位(OP_跳转若假)
        压循环栈()
        编译语句列表(节点["体"])
        修补继续到(循环开始)
        发射([OP_跳转, 循环开始])
        修补跳出到(长度(g_指令))
        弹出循环栈()
        修补到当前(退出)
        返回
    结束

    如果 k == "对于" 则
        编译对于语句(节点)
        返回
    结束

    如果 k == "尝试" 则
        编译尝试语句(节点)
        返回
    结束

    如果 k == "抛出" 则
        编译表达式(节点["值"])
        发射([OP_抛出])
        返回
    结束

    如果 k == "跳出" 则
        如果 长度(g_循环栈) == 0 则
            标记不支持()
            返回
        结束
        让 层 = g_循环栈[长度(g_循环栈) - 1]
        追加(层["跳出"], 发跳转占位(OP_跳转))
        返回
    结束

    如果 k == "继续" 则
        如果 长度(g_循环栈) == 0 则
            标记不支持()
            返回
        结束
        让 层 = g_循环栈[长度(g_循环栈) - 1]
        追加(层["继续"], 发跳转占位(OP_跳转))
        返回
    结束

    如果 k == "枚举" 则
        让 d = {"类型":"枚举"}
        让 成员 = 节点["成员"]
        对于 i 从 0 到 长度(成员) - 1 循环
            d[成员[i]] = i
        结束
        发射([OP_加载常量, 登记常量(d)])
        编译存储名字(节点["名字"])
        返回
    结束

    如果 k == "匹配" 则
        编译匹配语句(节点)
        返回
    结束

    # 裸表达式语句（函数调用/标识符/二元/一元/字面量/下标/列表/字典/元组字面量等）
    如果 k == "函数调用" 或 k == "标识符" 或 k == "二元" 或 k == "一元" 或 k == "字面量" 或 k == "下标" 或 k == "列表字面量" 或 k == "字典字面量" 或 k == "元组字面量" 或 k == "函数字面量" 则
        编译表达式(节点)
        发射([OP_弹出])
        返回
    结束

    如果 k == "表达式语句" 则
        编译表达式(节点["表达式"])
        发射([OP_弹出])
        返回
    结束

    如果 k == "导入" 或 k == "并发" 或 k == "等待" 或 k == "结构体定义" 则
        标记不支持()
        返回
    结束

    # 未知语句 → 回退
    标记不支持()
结束

# —— 循环栈辅助 ——
函数 压循环栈()
    追加(g_循环栈, {"跳出":[], "继续":[]})
结束

函数 弹出循环栈()
    弹出(g_循环栈)
结束

函数 修补跳出到(地址)
    如果 长度(g_循环栈) == 0 则
        返回
    结束
    让 层 = g_循环栈[长度(g_循环栈) - 1]
    对于 i 从 0 到 长度(层["跳出"]) - 1 循环
        g_指令[层["跳出"][i]][1] = 地址
    结束
结束

函数 修补继续到(地址)
    如果 长度(g_循环栈) == 0 则
        返回
    结束
    让 层 = g_循环栈[长度(g_循环栈) - 1]
    对于 i 从 0 到 长度(层["继续"]) - 1 循环
        g_指令[层["继续"][i]][1] = 地址
    结束
结束

# —— 如果语句（含否则如果链）——
函数 编译如果语句(节点)
    编译表达式(节点["条件"])
    让 假处 = 发跳转占位(OP_跳转若假)
    编译语句列表(节点["则体"])
    让 链 = 节点["否则链"]
    如果 长度(链) > 0 则
        让 结束处 = 发跳转占位(OP_跳转)
        修补到当前(假处)
        对于 c 从 0 到 长度(链) - 1 循环
            让 分支 = 链[c]
            如果 是节点(分支["条件"]) 则
                编译表达式(分支["条件"])
                让 下一个 = 发跳转占位(OP_跳转若假)
                编译语句列表(分支["体"])
                # 本分支体执行完后跳到整体结束；条件为假时跳到下一分支
                发射([OP_跳转, 结束处])
                修补到当前(下一个)
            否则
                # 无条件的否则分支：体执行完自然落到结束处
                编译语句列表(分支["体"])
            结束
        结束
        修补到当前(结束处)
    否则
        修补到当前(假处)
    结束
结束

# —— 对于语句：数值循环 + for-each 遍历 ——
函数 编译对于语句(节点)
    如果 节点["是否遍历"] == 1 则
        编译对于遍历(节点)
        返回
    结束
    # 数值循环：对于 i 从 起点 到 终点 [步长 s]
    # 语义逐条抄宿主 ND_FOR（co_old.c:5940-6008）：
    #   1) 起点/终点/步长 各只求值一次（以前 终点 每轮重新求值，
    #      「对于 i 从 1 到 弹出(栈)」这种写法在 VM 上会多弹好几次）
    #   2) 入口处 三个值都要过宿主 num_of/步长非零 校验（OP_循环校验）
    #   3) 任一值为浮点 → 浮点通道（i 保持浮点、终点比较带 ±0.0001 容差）
    #      全整数 → 整数通道。以前 VM 靠 步长v > 0 的宿主比较硬撑，
    #      步长 0 会被静默当成「循环不成立」跳过整个循环体。
    编译表达式(节点["起点"])
    编译存储名字(节点["变量"])
    让 终点槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    编译表达式(节点["终点"])
    发射([OP_存储局部, 终点槽])
    让 步长槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    如果 是节点(节点["步长"]) 则
        编译表达式(节点["步长"])
    否则
        发射([OP_加载常量, 登记常量(1)])
    结束
    发射([OP_存储局部, 步长槽])
    让 模式槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    # 入口校验：三个原始值压栈，OP_循环校验 弹出校验后把归一化起点回推栈上
    编译加载名字(节点["变量"], 节点)
    发射([OP_加载局部, 终点槽])
    发射([OP_加载局部, 步长槽])
    发射([OP_循环校验, 模式槽])
    编译存储名字(节点["变量"])
    # 循环变量的存放位置（局部/全局/自由）：推进指令要就地读改它。
    # 种类码：0=局部 1=全局 2=自由
    让 环变量槽 = -1
    让 环变量种类 = 0
    如果 是局部名(节点["变量"]) 则
        环变量槽 = g_局部表[节点["变量"]]
    否则
        如果 是全局名(节点["变量"]) 则
            环变量槽 = g_全局表[节点["变量"]]
            环变量种类 = 1
        否则
            环变量槽 = g_自由表[节点["变量"]]
            环变量种类 = 2
        结束
    结束
    # ---- 初检（只跑一次）：按当前循环变量判「本轮要不要进循环体」 ----
    发射([OP_循环条件, 环变量槽, 环变量种类, 终点槽, 步长槽, 模式槽, -1, -1])
    让 退出 = 发跳转占位(OP_跳转若假)
    # 循环体起点（回边落点）：初检已经单独跑过一轮，回边直接回到循环体。
    让 循环开始 = 长度(g_指令)
    压循环栈()
    编译语句列表(节点["体"])
    # ---- 推进（每轮跑一次）：步长更新 + 续判条件，合成一条指令 ----
    # 继续 语句的落点也在这里（与旧版「步长更新」落点同义）。
    让 继续处 = 长度(g_指令)
    发射([OP_循环推进, 环变量槽, 环变量种类, 终点槽, 步长槽, 模式槽, -1, -1])
    修补继续到(继续处)
    让 退出2 = 发跳转占位(OP_跳转若假)
    发射([OP_跳转, 循环开始])
    修补跳出到(长度(g_指令))
    弹出循环栈()
    修补到当前(退出)
    修补到当前(退出2)
结束

# for-each：对于 x 在 容器 循环 ...
# 物化容器为元素列表，用两个临时单元保存 [元素列表, 当前下标]
函数 编译对于遍历(节点)
    编译表达式(节点["遍历源"])
    发射([OP_物化遍历])
    # 申请两个临时单元槽位
    让 列表槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    让 下标槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    发射([OP_存储局部, 列表槽])
    发射([OP_加载常量, 登记常量(0)])
    发射([OP_存储局部, 下标槽])
    让 循环开始 = 长度(g_指令)
    发射([OP_加载局部, 下标槽])
    发射([OP_加载局部, 列表槽])
    发射([OP_一元, "长度"])
    发射([OP_二元, "<"])
    让 退出 = 发跳转占位(OP_跳转若假)
    # 取 items[index] 写入循环变量
    发射([OP_加载局部, 列表槽])
    发射([OP_加载局部, 下标槽])
    发射([OP_下标获取, 0, 节点行(节点), 节点列(节点)])
    编译存储名字(节点["变量"])
    压循环栈()
    编译语句列表(节点["体"])
    让 继续处 = 长度(g_指令)
    发射([OP_加载局部, 下标槽])
    发射([OP_加载常量, 登记常量(1)])
    发射([OP_二元, "+"])
    发射([OP_存储局部, 下标槽])
    修补继续到(继续处)
    发射([OP_跳转, 循环开始])
    修补跳出到(长度(g_指令))
    弹出循环栈()
    修补到当前(退出)
结束

# —— 尝试/捕获/最终 ——
函数 编译尝试语句(节点)
    让 有捕获 = 为整数(长度(节点["捕获体"]) > 0)
    让 有最终 = 为整数(长度(节点["最终体"]) > 0)
    # 记录捕获块地址（占位，稍后回填）
    发射([OP_进入处理, 0, 0])
    让 处理下标 = 长度(g_指令) - 1
    编译语句列表(节点["体"])
    发射([OP_退出处理])
    # try体正常结束后，跳转到最终块（如果有）或结束
    让 跳过捕获 = 发跳转占位(OP_跳转)
    捕获处 = 长度(g_指令)
    g_指令[处理下标][1] = 捕获处
    如果 有捕获 == 1 则
        # 绑定捕获变量
        如果 节点["捕获变量"] != "" 且 节点["捕获变量"] != 空 则
            发射([OP_加载异常])
            编译存储名字(节点["捕获变量"])
        否则
            # 没有变量绑定，但仍然需要清除待捕获异常
            发射([OP_加载异常])
            发射([OP_弹出])
        结束
        编译语句列表(节点["捕获体"])
        发射([OP_退出处理])
    结束
    # 修补跳过捕获的跳转，指向最终块或结束
    g_指令[跳过捕获][1] = 长度(g_指令)
    # 如果有最终块，记录最终块地址并编译
    如果 有最终 == 1 则
        g_指令[处理下标][2] = 长度(g_指令)
        编译语句列表(节点["最终体"])
        # finally 后需要检查是否有待处理异常或待返回值
        发射([OP_检查重抛])
    结束
结束

# —— 匹配语句 ——
函数 编译匹配语句(节点)
    # 申请一个临时单元保存被匹配值
    让 值槽 = g_局部数 + g_临时数
    g_临时数 = g_临时数 + 1
    编译表达式(节点["表达式"])
    发射([OP_存储局部, 值槽])
    让 分支 = 节点["分支"]
    让 结束跳转 = []
    对于 i 从 0 到 长度(分支) - 1 循环
        让 br = 分支[i]
        如果 br["是否默认"] == 1 则
            编译语句列表(br["体"])
            追加(结束跳转, 发跳转占位(OP_跳转))
            继续
        结束
        让 模式 = br["模式"]
        如果 模式["类型"] == "范围" 则
            发射([OP_加载局部, 值槽])
            编译表达式(模式["起点"])
            发射([OP_二元, ">="])
            发射([OP_加载局部, 值槽])
            编译表达式(模式["终点"])
            发射([OP_二元, "<="])
            发射([OP_二元, "且"])
            让 下一分支 = 发跳转占位(OP_跳转若假)
            编译语句列表(br["体"])
            追加(结束跳转, 发跳转占位(OP_跳转))
            修补到当前(下一分支)
            继续
        结束
        如果 模式["类型"] == "标识符" 则
            # 通配：绑定匹配值到该名字
            发射([OP_加载局部, 值槽])
            编译存储名字(模式["名字"])
            编译语句列表(br["体"])
            追加(结束跳转, 发跳转占位(OP_跳转))
            继续
        结束
        # 字面量相等
        发射([OP_加载局部, 值槽])
        编译表达式(模式)
        发射([OP_二元, "=="])
        让 下一分支 = 发跳转占位(OP_跳转若假)
        编译语句列表(br["体"])
        追加(结束跳转, 发跳转占位(OP_跳转))
        修补到当前(下一分支)
    结束
    让 结束地址 = 长度(g_指令)
    对于 j 从 0 到 长度(结束跳转) - 1 循环
        g_指令[结束跳转[j]][1] = 结束地址
    结束
结束

函数 编译语句列表(语句列表)
    对于 i 从 0 到 长度(语句列表) - 1 循环
        编译语句(语句列表[i])
    结束
结束

# ============================================================
# 编译函数为独立段
# ============================================================
函数 编译函数段(函数节点, 名) -> 整数
    让 旧指令 = g_指令
    让 旧常量 = g_常量
    让 旧局部表 = g_局部表
    让 旧局部数 = g_局部数
    让 旧自由表 = g_自由表
    让 旧自由数 = g_自由数
    让 旧临时数 = g_临时数
    让 旧在函数内 = g_在函数内

    # 把父作用域局部表压栈，供子函数区分「自由变量」与「内置函数」
    追加(g_作用域栈, 旧局部表)

    g_指令 = []
    g_常量 = []
    g_临时数 = 0
    g_在函数内 = 1
    # 记录本段的返回类型标注（宿主在 invoke_func 里设 g_cur_ret_type），
    # 段内的每条 返回 都据此复查；嵌套定义时保存/复原外层值。
    让 旧返回类型标注 = g_当前返回类型
    g_当前返回类型 = 文本字段(函数节点, "返回类型")
    收集局部(函数节点)
    g_自由表 = {}
    g_自由数 = 0
    让 默认表 = 函数节点["参数默认"]

    # ---- 默认参数前置：函数体执行前，缺省的实参用默认表达式补齐 ----
    # 判据与 求值器.调用用户函数 相同：只有 默认表[i] 是节点（写了 = 表达式）才算。
    对于 i 从 0 到 长度(函数节点["参数"]) - 1 循环
        如果 类型(默认表) == "列表" 且 i < 长度(默认表) 且 是节点(默认表[i]) 则
            发射([OP_加载argc])
            发射([OP_加载常量, 登记常量(i)])
            发射([OP_二元, ">"])
            让 已给 = 发跳转占位(OP_跳转若真)
            编译表达式(默认表[i])
            发射([OP_存储局部, g_局部表[函数节点["参数"][i]]])
            修补到当前(已给)
        结束
    结束

    编译语句列表(函数节点["体"]["语句"])
    发射([OP_加载常量, 登记常量(0)])
    发射([OP_返回])

    # ---- 调用守卫所需的两项元数据（判据与 求值器.调用用户函数 逐字对齐）----
    # 最少实参 = 形参数 - 带默认值的个数；可变形参把「至少」降到它自己的位置。
    # 可变起 = -1 表示没有可变参数，此时上界仍是 形参数。
    让 n形参 = 长度(函数节点["参数"])
    让 类型表 = 函数节点["参数类型"]
    让 可变起 = -1
    让 默认个数 = 0
    对于 i 从 0 到 n形参 - 1 循环
        如果 类型(类型表) == "列表" 且 i < 长度(类型表) 且 类型表[i] == "可变" 则
            可变起 = i
        结束
        如果 类型(默认表) == "列表" 且 i < 长度(默认表) 且 是节点(默认表[i]) 则
            默认个数 = 默认个数 + 1
        结束
    结束
    让 最少实参 = n形参
    如果 可变起 >= 0 则
        最少实参 = 可变起
    结束
    最少实参 = 最少实参 - 默认个数
    如果 最少实参 < 0 则
        最少实参 = 0
    结束
    # 有没有【需要按标注复查】的形参：没有的话，运行期整段类型复查可以跳过
    # （宿主 invoke_func 只在形参带标注时才 ensure_type）。
    # 判据与运行期那段一模一样：标注非空、且不是「可变」。
    让 查参数类型 = 0
    如果 类型(类型表) == "列表" 则
        对于 i 从 0 到 n形参 - 1 循环
            如果 i < 长度(类型表) 且 类型(类型表[i]) == "字符串" 且 类型表[i] != "" 且 类型表[i] != "可变" 则
                查参数类型 = 1
                跳出
            结束
        结束
    结束
    让 段 = {"指令": g_指令, "常量": g_常量, "指令数": 长度(g_指令), "局部数": g_局部数 + g_临时数, "参数数": n形参, "参数名": 函数节点["参数"], "参数类型": 函数节点["参数类型"], "返回类型": 文本字段(函数节点, "返回类型"), "自由表": g_自由表, "自由数": g_自由数, "名字": 名, "最少实参": 最少实参, "可变起": 可变起, "查参数类型": 查参数类型}
    追加(g_函数表, 段)
    让 序号 = 长度(g_函数表) - 1

    g_指令 = 旧指令
    g_常量 = 旧常量
    g_局部表 = 旧局部表
    g_局部数 = 旧局部数
    g_自由表 = 旧自由表
    g_自由数 = 旧自由数
    g_临时数 = 旧临时数
    g_在函数内 = 旧在函数内
    g_当前返回类型 = 旧返回类型标注
    # 弹出父作用域栈
    让 新栈 = []
    对于 i 从 0 到 长度(g_作用域栈) - 2 循环
        追加(新栈, g_作用域栈[i])
    结束
    g_作用域栈 = 新栈
    返回 序号
结束

# ============================================================
# 编译整个程序（主段在序号 0）
# ============================================================
函数 编译程序(ast)
    g_函数表 = [0]
    g_全局表 = {}
    g_全局槽数 = 0
    g_不支持 = 0

    让 语句表 = ast["语句"]
    对于 i 从 0 到 长度(语句表) - 1 循环
        让 st = 语句表[i]
        如果 非 是节点(st) 则 继续 结束
        如果 st["类型"] == "变量声明" 或 st["类型"] == "函数定义" 或 st["类型"] == "枚举" 则
            如果 非 包含(g_全局表, st["名字"]) 则
                g_全局表[st["名字"]] = g_全局槽数
                g_全局槽数 = g_全局槽数 + 1
            结束
        结束
    结束

    g_局部表 = {}
    g_局部数 = 0
    g_自由表 = {}
    g_自由数 = 0
    g_临时数 = 0
    g_在函数内 = 0
    g_循环栈 = []
    g_指令 = []
    g_常量 = []

    编译语句列表(语句表)
    发射([OP_暂停])

    让 主段 = {"指令": g_指令, "常量": g_常量, "指令数": 长度(g_指令), "局部数": g_临时数, "参数数": 0, "自由表": {}, "自由数": 0}
    g_函数表[0] = 主段
结束


函数 v_真值(v) -> 整数
    让 t = 类型(v)
    如果 t == "整数" 或 t == "布尔" 则 返回 为整数(v != 0) 结束
    如果 t == "浮点" 则 返回 为整数(v != 0.0) 结束
    如果 t == "字符串" 则 返回 为整数(长度(v) > 0) 结束
    如果 t == "列表" 或 t == "字典" 则 返回 为整数(长度(v) > 0) 结束
    如果 t == "字典" 且 包含(v, "类型") 则 返回 1 结束
    返回 0
结束

函数 v_二元运算(op, l, r, 指令)
    # 大小比较：类型不可比时转入可捕获的 VM 异常（而非宿主致命错误）
    # 必须在到达宿主比较之前预检（宿主 < 直接致命退出，无法捕获）
    # 宿主持比性规则（与 求值器.co 同源实测）：数字三者互比、列表×列表、
    # 字符串×字符串；字典/张量/空 同类型也不可比。旧判定「同类型即可比」
    # 把 字典<字典、张量<张量、空<空 放行给宿主深比较，VM 的报错坐标停在
    # 虚拟机内部行号（实测 第1354行,28列）——消息对得上、坐标对不上。
    如果 op == "<" 或 op == ">" 或 op == "<=" 或 op == ">=" 则
        让 左型 = 宿主类型名(l)
        让 右型 = 宿主类型名(r)
        让 可比 = 0
        如果 (左型 == "整数" 或 左型 == "浮点" 或 左型 == "布尔") 且 (右型 == "整数" 或 右型 == "浮点" 或 右型 == "布尔") 则
            可比 = 1
        结束
        如果 左型 == "列表" 且 右型 == "列表" 则 可比 = 1 结束
        如果 左型 == "字符串" 且 右型 == "字符串" 则 可比 = 1 结束
        如果 可比 == 0 则
            v_报错(指令, "无法比较大小: " + 左型 + " " + op + " " + 右型)
            返回 0
        结束
    结束
    如果 op == "==" 则 返回 l == r
    如果 op == "!=" 则 返回 l != r
    如果 op == "<" 则 返回 l < r
    如果 op == ">" 则 返回 l > r
    如果 op == "<=" 则 返回 l <= r
    如果 op == ">=" 则 返回 l >= r

    # 位运算校验必须在「字符串拼接」分支之前：宿主的报错是 位运算 << 需要整数…，
    # 放在后面会被 字符串只支持 + 拼接 抢先，两条通道的中文报错就不一致了
    # （求值器.co 里位运算本来就在字符串分支之前，这里对齐）。
    如果 op == "&" 或 op == "|" 或 op == "^" 或 op == "<<" 或 op == ">>" 则
        # 同 求值器.co：位运算只吃 整数/布尔，非法类型/越界位数必须在 .co 层
        # 拦成可捕获异常（宿主的同类报错是致命退出，捕获不到；旧写法先 转整数
        # 再算，把 1.5 & 1 静默算成 1）。校验函数两条通道共用一份。
        让 位错 = 位运算校验(op, l, r)
        如果 位错 != "" 则
            v_报错(指令, 位错)
            返回 0
        结束
    结束

    # ---- 宿主类型闸门（与 求值器 同一份 数值闸门，实测矩阵 /tmp/host_op_matrix.txt）----
    # 没有这道闸门时 转浮点 对 列表/字典/空 是未定义行为：
    # [1]+2 静默得 3、{ "a":1 }+1 静默得 1（原生一致性门禁的两条红就是这个）。
    # 判据与求值器完全一致：两侧都是数字（整数/浮点/布尔）时闸门必然放行，
    # 直接跳过 数值闸门 这次函数调用。宿主 C 解释器对 .co 函数调用的开销是
    # 实打实的，fib 级负载不做快路实测 +6%（30.6s→32.5s）。lt/rt 给下面复用。
    让 lt = 类型(l)
    让 rt = 类型(r)
    如果 非 ((lt == "整数" 或 lt == "浮点" 或 lt == "布尔") 且 (rt == "整数" 或 rt == "浮点" 或 rt == "布尔")) 则
        让 闸门错 = 数值闸门(l, r, op)
        如果 闸门错 != "" 则
            v_报错(指令, 闸门错)
            返回 0
        结束
    结束

    如果 lt == "字符串" 或 rt == "字符串" 则
        让 串错 = 字符串运算错(l, r, op)
        如果 串错 != "" 则
            v_报错(指令, 串错)
            返回 0
        结束
        # 同 求值器.co：一侧是字典（张量/含张量的容器）时走层入口 值转字符串，
        # 宿主原语会把层的张量字典渲染成内部键。字符串+字符串 热路径不付额外调用。
        让 左串 = 转字符串(l)
        如果 lt == "字典" 则 左串 = 值转字符串(l) 结束
        让 右串 = 转字符串(r)
        如果 rt == "字典" 则 右串 = 值转字符串(r) 结束
        返回 左串 + 右串
    结束

    # 列表拼接（对齐 求值器.co 的同名分支；宿主 [1,2]+[3] → [1, 2, 3]）。
    # 缺失这一支时 列表+列表 会掉到下面 转浮点(列表)=0 的数值分支，静默返回 0
    # ——「跑得动但结果是错的」（实测 vm 通道 拼([1,2],[3]) → 0，宿主/eval 给
    # [1, 2, 3]；拿结果去索引还会撞「不支持的类型索引」；标准库 子集() 的
    # 结果[j] + [表[i]] 同理由此静默算错）。
    如果 op == "+" 且 lt == "列表" 且 rt == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(l) - 1 循环
            追加(结果, l[i])
        结束
        对于 i 从 0 到 长度(r) - 1 循环
            追加(结果, r[i])
        结束
        返回 结果
    结束

    # 张量运算：必须放在 转浮点 之前——原先这两行 让 lf/rf 在分支前面，
    # 字典进 转浮点 是未定义行为。
    # 判定不能写 类型(l) == "张量"：这里是【库上下文】，类型() 是宿主原语，
    # 对标记字典返回的是「字典」；「张量」只在用户上下文由 调用内置 分派给出。
    # 写错的结果不是报错，而是张量掉进数值分支算出垃圾（实测 /tmp/bp1.co：
    # vm 通道报「反向需要一个张量」，因为 大*大 已经不算张量了）。
    让 vm_l是张量 = (lt == "字典" 且 包含(l, "类型") 且 l["类型"] == "张量")
    让 vm_r是张量 = (rt == "字典" 且 包含(r, "类型") 且 r["类型"] == "张量")
    如果 vm_l是张量 或 vm_r是张量 则
        如果 op == "+" 则 返回 引_加(l, r) 结束
        如果 op == "-" 则 返回 引_减(l, r) 结束
        如果 op == "*" 则 返回 引_乘(l, r) 结束
        如果 op == "/" 则 返回 引_除(l, r) 结束
        v_报错(指令, "张量不支持运算符: " + op)
        返回 0
    结束

    # 整数算术：走宿主 64 位精确整数运算（浮点中转在 |x| > 2^53 时丢精度）
    # 这道闸门必须排在 转浮点 之前：fib/矩阵乘级负载几乎全是 整数×整数，
    # 先 转浮点 再回整数分支等于每次运算白付 2 次宿主调用（实测热路可省）。
    # `/` 不在这里返回，仍然落到下方浮点路径，保持既有的浮点语义与除零报错。
    如果 lt == "整数" 且 rt == "整数" 则
        如果 op == "+" 则 返回 l + r 结束
        如果 op == "-" 则 返回 l - r 结束
        如果 op == "*" 则 返回 l * r 结束
        如果 op == "//" 则
            如果 r == 0 则
                v_报错(指令, "整除的除数为零")
                返回 0
            结束
            # 宿主 // 是 floor（向下取整），不是向零截断：-10//3 → -4。
            # 先用整数精确除拿【截断商】，再按余数与除数异号修正一层，
            # 全程整数运算，不走浮点（>2^53 也不丢精度）。
            让 商 = 转整数(截断(l / r))
            让 余 = l - 商 * r
            如果 余 != 0 且 ((余 < 0) != (r < 0)) 则
                商 = 商 - 1
            结束
            返回 商
        结束
        如果 op == "%" 则
            如果 r == 0 则
                v_报错(指令, "取模的除数为零")
                返回 0
            结束
            返回 l % r
        结束
        # / 保持浮点语义（与既有行为一致），落到下方统一处理
    结束

    让 lf = 转浮点(l)
    让 rf = 转浮点(r)
    
    # 除零：转入可捕获的 VM 异常（而非宿主致命错误）
    如果 rf == 0 且 (op == "/" 或 op == "//" 或 op == "%") 则
        让 除零消息 = "除以零"
        如果 op == "//" 则
            除零消息 = "整除的除数为零"
        结束
        如果 op == "%" 则
            除零消息 = "取模的除数为零"
        结束
        v_报错(指令, 除零消息)
        返回 0
    结束
    如果 op == "+" 则
        如果 lt == "浮点" 或 rt == "浮点" 则 返回 lf + rf 结束
        返回 转整数(lf + rf)
    结束
    如果 op == "-" 则
        如果 lt == "浮点" 或 rt == "浮点" 则 返回 lf - rf 结束
        返回 转整数(lf - rf)
    结束
    如果 op == "*" 则
        如果 lt == "浮点" 或 rt == "浮点" 则 返回 lf * rf 结束
        返回 转整数(lf * rf)
    结束
    如果 op == "/" 则 返回 lf / rf
    # 浮点侧 //：宿主是 floor 且保浮点类型（10.0//3 → 3.0、-10.5//3 → -4.0）。
    # 向下取整 本身吐整数，浮点侧必须 转浮点 抬回来，否则 类型(10.0//3) 错报整数。
    如果 op == "//" 则
        让 商 = 向下取整(lf / rf)
        如果 lt == "浮点" 或 rt == "浮点" 则 返回 转浮点(商) 结束
        返回 转整数(商)
    结束
    如果 op == "%" 则 返回 lf - 截断(lf / rf) * rf
    如果 op == "**" 则 返回 幂(lf, rf)
    如果 op == "&" 则 返回 转整数(lf) & 转整数(rf)
    如果 op == "|" 则 返回 转整数(lf) | 转整数(rf)
    如果 op == "^" 则 返回 转整数(lf) ^ 转整数(rf)
    如果 op == "<<" 则 返回 转整数(lf) << 转整数(rf)
    如果 op == ">>" 则 返回 转整数(lf) >> 转整数(rf)
    # 逻辑运算（匹配范围模式等经 OP_二元 到达）：结果为宿主真布尔值
    如果 op == "且" 则 返回 (真值(l) * 真值(r)) != 0
    如果 op == "或" 则 返回 (真值(l) + 真值(r)) != 0
    返回 0
结束

函数 v_一元运算(op, v, 指令)
    如果 op == "非" 则
        # 结果为宿主真布尔值
        如果 v_真值(v) 则 返回 0 == 1 结束
        返回 0 == 0
    结束
    如果 op == "-" 则
        # 取负仅对数值类有意义，其余转入可捕获的 VM 异常
        让 负型 = 类型(v)
        如果 负型 != "整数" 且 负型 != "浮点" 且 负型 != "布尔" 则
            v_报错(指令, "取负需要数字或张量，得到 " + 负型)
            返回 0
        结束
        返回 -v
    结束
    如果 op == "+" 则 返回 v 结束
    # 按位取反：补码恒等式 ~x == -x - 1（宿主无非原语，纯运算实现）
    # 同样要先校验：旧写法 ~1.5 静默算成 -2.5，宿主则报中文错误。
    如果 op == "~" 则
        让 反错 = 取反校验(v)
        如果 反错 != "" 则
            v_报错(指令, 反错)
            返回 0
        结束
        返回 -转整数(v) - 1
    结束
    如果 op == "真值" 则 返回 v_真值(v)
    如果 op == "长度" 则 返回 长度(v)
    返回 v
结束

# 统一调用可调用值：用户函数或内置函数
# 供高阶函数（映射/过滤/归约/应用）使用
函数 v_调用值(可调用, 实参)
    如果 类型(可调用) == "字典" 且 包含(可调用, "类型") 则
        如果 可调用["类型"] == "函数" 则
            # 调用用户定义的函数
            让 段 = g_函数表[可调用["序号"]]
            让 新局部 = v_新局部(段["局部数"])
            对于 i 从 0 到 长度(实参) - 1 循环
                如果 i < 长度(新局部) 则
                    新局部[i][0] = 实参[i]
                结束
            结束
            # 保存当前帧栈，推入新帧
            让 旧帧栈 = v_帧栈
            v_帧栈 = [[段["指令"], 段["常量"], 0, 新局部, 可调用["闭包"], [], 0, 长度(实参), 段["指令数"]]]
            让 r = v_执行()
            v_帧栈 = 旧帧栈
            # 检查返回值是否为异常
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则
                返回 r
            结束
            # 返回值在栈顶（如果有的话）
            如果 长度(v_栈) > 0 则
                返回 v_弹出()
            结束
            返回 0
        结束
        如果 可调用["类型"] == "内置" 则
            返回 v_宿主内置(可调用["名字"], 实参)
        结束
    结束
    返回 造异常("值不是一个可调用的函数")
结束

# ============================================================
# 宿主内置函数派发（与求值器语义一致，直接调用宿主原语）
# ============================================================
函数 v_宿主内置(名字, 实参)
    # 位置同步：本函数末尾会兜底转给 求值器 的 调用内置（205 个名字的分派都在
    # 那边），而那里所有 造异常 读的是 g_当前行/g_当前列。VM 从不设置这两个变量
    # ——它自己用 v_当前行/v_当前列，于是同一句 全零([0])：eval 报 行2 列5、
    # vm 报 行0 列0。差距只在坐标、消息逐字相同，但「异常带行号」是语言承诺，
    # 0/0 等于没带。进入任何内置分派前把 VM 的位置写进 g_，两通道取同一坐标。
    g_当前行 = v_当前行
    g_当前列 = v_当前列
    # 转布尔(值) -> 布尔：任意值的真值语义转换为宿主真布尔
    如果 名字 == "转布尔" 则
        让 bv = 实参[0]
        让 bt = 类型(bv)
        如果 bt == "整数" 或 bt == "布尔" 则
            返回 bv != 0
        结束
        如果 bt == "浮点" 则
            返回 bv != 0.0
        结束
        如果 bt == "字符串" 或 bt == "列表" 或 bt == "字典" 则
            返回 长度(bv) > 0
        结束
        返回 0 == 1
    结束
    # 开头是(串, 前缀) -> 布尔：判断字符串是否以指定前缀开头
    如果 名字 == "开头是" 则
        让 整串 = 实参[0]
        让 前缀 = 实参[1]
        如果 长度(前缀) > 长度(整串) 则
            返回 0 == 1
        结束
        返回 截取(整串, 0, 长度(前缀)) == 前缀
    结束
    # 结尾是(串, 后缀) -> 布尔：判断字符串是否以指定后缀结尾
    如果 名字 == "结尾是" 则
        让 尾串 = 实参[0]
        让 后缀 = 实参[1]
        如果 长度(后缀) > 长度(尾串) 则
            返回 0 == 1
        结束
        返回 截取(尾串, 长度(尾串) - 长度(后缀), 长度(后缀)) == 后缀
    结束
    # 进制格式化：十六进制/二进制/八进制（与求值器语义一致，负数按 64 位补码）
    如果 名字 == "十六进制" 或 名字 == "二进制" 或 名字 == "八进制" 则
        让 数 = 实参[0]
        让 基数 = 16
        让 位表 = "0123456789abcdef"
        让 前缀 = "0x"
        让 每组位 = 4
        如果 名字 == "二进制" 则
            基数 = 2
            位表 = "01"
            前缀 = "0b"
            每组位 = 1
        结束
        如果 名字 == "八进制" 则
            基数 = 8
            位表 = "01234567"
            前缀 = "0o"
            每组位 = 3
        结束
        让 出 = ""
        若 数 == 0
            出 = "0"
        结束
        当 数 > 0 循环
            出 = 截取(位表, 数 % 基数, 1) + 出
            数 = 转整数(数 / 基数)
        结束
        # 负数：64 位补码位形（按组提取）
        如果 数 < 0 则
            出 = ""
            让 移 = 0
            当 移 < 64 循环
                让 组 = (数 >> 移) & (基数 - 1)
                出 = 截取(位表, 组, 1) + 出
                移 = 移 + 每组位
            结束
            # 去前导零（至少保留一位）
            当 长度(出) > 1 循环
                若 截取(出, 0, 1) != "0"
                    跳出
                结束
                出 = 截取(出, 1, 长度(出))
            结束
        结束
        # 可选第二参数：最小位宽，不足左补零
        如果 长度(实参) > 1 则
            让 宽 = 转整数(实参[1])
            当 长度(出) < 宽 循环
                出 = "0" + 出
            结束
        结束
        返回 前缀 + 出
    结束
    如果 名字 == "输出" 则
        让 s = ""
        对于 i 从 0 到 长度(实参) - 1 循环
            如果 i > 0 则 s = s + " " 结束
            s = s + 值转字符串(实参[i])
        结束
        输出 s
        返回 0
    结束
    如果 名字 == "输出错误" 则
        让 s = ""
        对于 i 从 0 到 长度(实参) - 1 循环
            如果 i > 0 则 s = s + " " 结束
            s = s + 值转字符串(实参[i])
        结束
        输出错误(s)
        返回 0
    结束
    # 位计数(整数) -> 整数：64 位补码中 1 的个数
    如果 名字 == "位计数" 则
        让 数 = 实参[0]
        让 计 = 0
        让 位 = 0
        当 位 < 64 循环
            如果 (数 >> 位) & 1 则
                计 = 计 + 1
            结束
            位 = 位 + 1
        结束
        返回 计
    结束
    # 取位(整数, 位序) -> 整数：取第 n 位的值（0 或 1）
    如果 名字 == "取位" 则
        返回 (实参[0] >> 实参[1]) & 1
    结束
    # 置位(整数, 位序, 0或1) -> 整数：把第 n 位置 1 或清 0，返回新值（不改原值）
    如果 名字 == "置位" 则
        让 置数 = 实参[0]
        让 置位序 = 实参[1]
        如果 实参[2] 则
            返回 置数 | (1 << 置位序)
        结束
        返回 置数 & ~(1 << 置位序)
    结束
    # 转字符串：列表走 coCN 递归拼接（宿主对列表元素的渲染有缺陷）
    如果 名字 == "转字符串" 则
        # 张量：走专门的渲染路径（嵌套列表 / 3维+摘要），不让内部字典泄露
        如果 是张量字典(实参[0]) 则
            返回 张量渲染(实参[0])
        结束
        如果 类型(实参[0]) == "列表" 则
            让 源表 = 实参[0]
            让 拼串 = "["
            对于 i 从 0 到 长度(源表) - 1 循环
                如果 i > 0 则
                    拼串 = 拼串 + ", "
                结束
                如果 类型(源表[i]) == "列表" 则
                    拼串 = 拼串 + v_宿主内置("转字符串", [源表[i]])
                否则
                    # 叶子走 值转字符串：列表里嵌张量时宿主原语会泄露内部键
                    拼串 = 拼串 + 值转字符串(源表[i])
                结束
            结束
            返回 拼串 + "]"
        结束
        返回 转字符串(实参[0])
    结束
    如果 名字 == "断言" 则
        如果 非 v_真值(实参[0]) 则
            # 说明文字可选：两参数断言失败时不能自己去读 实参[1] 越界
            让 说 = "（无说明）"
            如果 长度(实参) > 1 则
                说 = 转字符串(实参[1])
            结束
            输出错误("断言失败: " + 说)
            退出(1)
        结束
        返回 0
    结束
    如果 名字 == "断言相等" 则
        如果 实参[0] != 实参[1] 则
            # 同 求值器.co：第三参数是可选说明，缺失时报「（无说明）」，
            # 绝不能让报错路径自己撞出「列表索引越界」盖掉真实断言信息。
            让 说明 = "（无说明）"
            如果 长度(实参) > 2 则
                说明 = 转字符串(实参[2])
            结束
            输出错误("断言失败 [" + 说明 + "]: 期望 " + 转字符串(实参[1]) + ", 实际 " + 转字符串(实参[0]))
            退出(1)
        结束
        返回 0
    结束
    如果 名字 == "长度" 则
        # 张量：宿主对 长度(张量) 恒返回 1（对齐 求值器.co 的同名分支）。
        # 层的张量是带标记字典，不走这一支会数出全部内部键（11 个）。
        如果 是张量字典(实参[0]) 则 返回 1 结束
        返回 长度(实参[0])
    结束
    如果 名字 == "包含" 则 返回 包含(实参[0], 实参[1])
    如果 名字 == "类型" 则
        让 v = 实参[0]
        # 与求值器通道 调用内置 的 类型 分支逐一对齐（空/函数/张量/元组/枚举/结构体）。
        # 这里少抄过 张量 一项，导致 类型(张量([1,2,3])) 在 vm 报「字典」、
        # eval 报「张量」——同一程序两通道两种答案，属于「跑得动但结果是错的」。
        如果 v == 空 则 返回 "空" 结束
        如果 类型(v) == "字典" 且 包含(v, "类型") 则
            如果 v["类型"] == "函数" 或 v["类型"] == "内置" 则 返回 "函数" 结束
            如果 v["类型"] == "张量" 则 返回 "张量" 结束
            如果 v["类型"] == "元组" 则 返回 "元组" 结束
            如果 v["类型"] == "枚举" 则 返回 "枚举" 结束
            如果 v["类型"] == "结构体" 则 返回 v["结构体名"] 结束
            如果 v["类型"] == "对象" 则 返回 v["类名"] 结束
            如果 v["类型"] == "类" 则 返回 "类" 结束
        结束
        返回 类型(v)
    结束
    如果 名字 == "转整数" 则 返回 转整数(实参[0])
    如果 名字 == "转浮点" 则 返回 转浮点(实参[0])
    如果 名字 == "转字符串" 则 返回 转字符串(实参[0])
    # 数学
    如果 名字 == "绝对值" 则 返回 绝对值(实参[0])
    如果 名字 == "平方根" 则
        如果 类型(实参[0]) != "整数" 且 类型(实参[0]) != "浮点" 则
            返回 造内置异常("平方根函数 需要数字参数，收到 " + 类型(实参[0]))
        结束
        返回 平方根(实参[0])
    结束
    如果 名字 == "取整" 则 返回 取整(实参[0])
    如果 名字 == "向下取整" 则 返回 向下取整(实参[0])
    如果 名字 == "向上取整" 则 返回 向上取整(实参[0])
    如果 名字 == "截断" 则 返回 截断(实参[0])
    如果 名字 == "正弦" 则 返回 正弦(实参[0])
    如果 名字 == "余弦" 则 返回 余弦(实参[0])
    如果 名字 == "幂" 则 返回 幂(实参[0], 实参[1])
    如果 名字 == "自然对数" 则
        如果 长度(实参) >= 2 则
            返回 自然对数(实参[0]) / 自然对数(实参[1])
        结束
        返回 自然对数(实参[0])
    结束
    如果 名字 == "圆周率" 则 返回 圆周率()
    如果 名字 == "符号" 则
        如果 实参[0] > 0 则 返回 1 结束
        如果 实参[0] < 0 则 返回 -1 结束
        返回 0
    结束
    # 字符串
    如果 名字 == "截取" 则 返回 截取(实参[0], 实参[1], 实参[2])
    如果 名字 == "查找" 则 返回 查找(实参[0], 实参[1])
    如果 名字 == "分割" 则 返回 分割(实参[0], 实参[1])
    如果 名字 == "连接" 则 返回 连接(实参[0], 实参[1])
    如果 名字 == "替换" 则 返回 替换(实参[0], 实参[1], 实参[2])
    如果 名字 == "大写" 则 返回 大写(实参[0])
    如果 名字 == "小写" 则 返回 小写(实参[0])
    如果 名字 == "去除空白" 则 返回 去空白(实参[0])
    # 正主名字（测试用的就是这几个，以前只有别名「去除空白」在表里）
    如果 名字 == "去空白" 则 返回 去空白(转字符串(实参[0]))
    如果 名字 == "去左空白" 则 返回 去左空白(转字符串(实参[0]))
    如果 名字 == "去右空白" 则 返回 去右空白(转字符串(实参[0]))
    如果 名字 == "字符码" 则
        如果 长度(实参) >= 2 则
            返回 字符码(转字符串(实参[0]), 转整数(实参[1]))
        结束
        返回 字符码(转字符串(实参[0]))
    结束
    如果 名字 == "码转字符" 则 返回 码转字符(转整数(实参[0]))
    如果 名字 == "重复" 则 返回 重复(转字符串(实参[0]), 转整数(实参[1]))
    如果 名字 == "字节" 则
        # 宿主越界会 longjmp（本解释器捕获不了），先按 字节列表 自行校验
        让 bl = 字节列表(转字符串(实参[0]))
        让 bn = 转整数(实参[1])
        让 blen = 长度(bl)
        如果 bn < 0 则
            bn = bn + blen
        结束
        如果 bn < 0 或 bn >= blen 则
            返回 造内置异常("字节下标越界: " + 转字符串(实参[1]) + "（共 " + 转字符串(blen) + " 字节）")
        结束
        返回 bl[bn]
    结束
    如果 名字 == "字节数" 则
        # 用 字节列表 的真实长度：宿主原语，UTF-8 精确（4 字节 emoji 也算 4）
        返回 长度(字节列表(转字符串(实参[0])))
    结束
    # 列表
    如果 名字 == "追加" 则 返回 追加(实参[0], 实参[1])
    如果 名字 == "反转" 则 返回 反转(实参[0])
    # 排序：与求值器同一条修复——第二参（降序标志）以前被静默丢掉。
    # 宿主 排序(表[, 是否降序]) 就地排序并返回同一个表；降序交给宿主标志，
    # 不要用 反转(...)（宿主 反转 就地改表、返回 空，会把结果弄成 空）。
    如果 名字 == "排序" 则
        如果 长度(实参) < 1 或 长度(实参) > 2 则
            返回 造内置异常("排序函数需要1-2个参数（列表[, 是否降序]）")
        结束
        如果 语言类型(实参[0]) != "列表" 则
            返回 造内置异常("排序函数的第一个参数必须是列表")
        结束
        如果 长度(实参) == 1 则
            返回 排序(实参[0])
        结束
        返回 排序(实参[0], 实参[1])
    结束
    # 切片：不拦截，交给尾部兜底 调用内置 走求值器的「2-3 参校验 + 转发」实现。
    # 以前这里硬写 切片(实参[0], 实参[1], 实参[2])，两参调用直接崩在层内。
    # 范围：与求值器共用 范围实现（1/2/3 参与错误文案全对齐宿主）。
    # 这里以前硬写 范围(实参[0], 实参[1])：单参崩、三参丢步长。
    如果 名字 == "范围" 则 返回 范围实现(实参)
    如果 名字 == "插入" 则 返回 插入(实参[0], 实参[1], 实参[2])
    # 弹出：不在这里拦截，交给尾部兜底 调用内置(名字, 实参) 走求值器那条
    # 「先层内校验、再转发宿主」的完整实现（含 弹出(表, 下标)），避免两处逻辑漂移。
    # 以前这里只转发 实参[0]，第二参被静默丢掉（标准库测试「弹出指定下标」抓到）。
    如果 名字 == "索引" 则 返回 索引(实参[0], 实参[1])
    如果 名字 == "计数" 则 返回 计数(实参[0], 实参[1])
    # 字典
    如果 名字 == "键" 则 返回 键(实参[0])
    如果 名字 == "值" 则 返回 值(实参[0])
    如果 名字 == "删除键" 则
        移除键(实参[0], 实参[1])
        返回 0
    结束
    如果 名字 == "条目" 则 返回 项(实参[0])
    # 最大/最小（支持两参数或单列表）
    如果 名字 == "最大值" 则
        如果 长度(实参) == 1 且 类型(实参[0]) == "列表" 则
            返回 最大值(实参[0])
        结束
        如果 实参[0] >= 实参[1] 则 返回 实参[0] 结束
        返回 实参[1]
    结束
    如果 名字 == "最小值" 则
        如果 长度(实参) == 1 且 类型(实参[0]) == "列表" 则
            返回 最小值(实参[0])
        结束
        如果 实参[0] <= 实参[1] 则 返回 实参[0] 结束
        返回 实参[1]
    结束
    # 其它
    如果 名字 == "随机" 则 返回 随机数()
    如果 名字 == "随机整数" 则 返回 随机整数(实参[0], 实参[1])
    如果 名字 == "现在" 则 返回 时钟()
    如果 名字 == "读取文件" 则 返回 读文件(实参[0])
    # ---- 宿主原语转发：这些名字以前不在派发表里，会一路掉到末尾的 返回 0，
    # 于是 复制("你好") 得 0、时钟毫秒() 得 0——比报错更糟，是「静默算错」。
    如果 名字 == "复制" 则
        # 与求值器通道同一条修复：层的 复制 对字典是浅拷贝（内层 数据 列表共享），
        # 张量必须深拷贝，否则 复制(张量) 后 置 会写坏原件（系统函数测试
        # 「张量深拷贝」在 VM 通道报 期望 1, 实际 99）。库上下文里 类型(张量字典)
        # 是「字典」，所以判定用字段检查而不是 类型()=="张量"。
        让 vm_是张量 = (类型(实参[0]) == "字典" 且 包含(实参[0], "类型") 且 实参[0]["类型"] == "张量")
        如果 vm_是张量 则
            返回 引_深拷贝张量(实参[0])
        结束
        返回 复制(实参[0])
    结束
    如果 名字 == "时钟毫秒" 则 返回 时钟毫秒()
    如果 名字 == "等待毫秒" 则
        等待毫秒(转整数(实参[0]))
        返回 0
    结束
    如果 名字 == "写文件" 则
        写文件(转字符串(实参[0]), 转字符串(实参[1]))
        返回 0
    结束
    如果 名字 == "读文件" 则 返回 读文件(转字符串(实参[0]))
    如果 名字 == "文件存在" 则 返回 文件存在(转字符串(实参[0]))
    如果 名字 == "删除文件" 则
        # 同 求值器.co：转发宿主的布尔返回值，别写死 0 报成失败
        返回 删除文件(转字符串(实参[0]))
    结束
    如果 名字 == "环境变量" 则 返回 环境变量(转字符串(实参[0]))
    如果 名字 == "设置环境变量" 则
        设置环境变量(转字符串(实参[0]), 转字符串(实参[1]))
        返回 0
    结束
    # 格式化：与求值器共用 内部格式化（模块符号合并进同一根环境）
    如果 名字 == "格式化" 则 返回 内部格式化(实参)
    # 高阶函数：与求值器共用 高次参数解析（(表,函数) 与 (函数,表) 都接），
    # 但【调用谓词必须走 v_调用值】：VM 的函数值是 {"类型","序号","闭包"}，
    # 没有求值器 调用用户函数 需要的 参数/参数类型/体 键——之前转给
    # 调用内置 的 全部满足 就是这个原因当场崩在「不支持的类型索引」。
    如果 名字 == "映射" 则
        让 解 = 高次参数解析("映射", 实参)
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 结果 = []
        对于 i 从 0 到 长度(解["表"]) - 1 循环
            让 r = v_调用值(解["函数"], [解["表"][i]])
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则 返回 r
            追加(结果, r)
        结束
        返回 结果
    结束
    如果 名字 == "过滤" 则
        让 解 = 高次参数解析("过滤", 实参)
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 结果 = []
        对于 i 从 0 到 长度(解["表"]) - 1 循环
            让 r = v_调用值(解["函数"], [解["表"][i]])
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则 返回 r
            如果 v_真值(r) 则 追加(结果, 解["表"][i])
        结束
        返回 结果
    结束
    如果 名字 == "归约" 则
        如果 长度(实参) < 2 则
            返回 造内置异常("归约函数需要至少2个参数（列表, 函数）")
        结束
        让 解 = 高次参数解析("归约", [实参[0], 实参[1]])
        如果 解["错"] != "" 则 返回 造内置异常(解["错"]) 结束
        让 lst = 解["表"]
        让 acc = 0
        让 起 = 0
        如果 长度(实参) >= 3 则
            acc = 实参[2]
        否则
            如果 长度(lst) == 0 则 返回 造内置异常("归约空列表需要初始值") 结束
            acc = lst[0]
            起 = 1
        结束
        对于 i 从 起 到 长度(lst) - 1 循环
            让 r = v_调用值(解["函数"], [acc, lst[i]])
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则 返回 r
            acc = r
        结束
        返回 acc
    结束
    # 应用(函数, 参数列表)：与求值器同一套校验，顺序不做交换（见 求值器 注释）。
    如果 名字 == "应用" 则
        如果 长度(实参) != 2 则 返回 造内置异常("应用函数需要2个参数（函数, 参数列表）") 结束
        如果 非 值可调(实参[0]) 或 类型(实参[1]) != "列表" 则
            返回 造内置异常("应用函数的第一个参数必须是函数，第二个必须是参数列表")
        结束
        返回 v_调用值(实参[0], 实参[1])
    结束
    # 全部满足/任一满足：宿主约定 (表, 谓词)，两种顺序都接；返回真布尔。
    如果 名字 == "全部满足" 则
        让 表错 = 满足类校验("全部满足", 实参)
        如果 表错 != "" 则 返回 造内置异常(表错) 结束
        让 解 = 高次参数解析("全部满足", 实参)
        让 lst = 解["表"]
        对于 i 从 0 到 长度(lst) - 1 循环
            让 r = v_调用值(解["函数"], [lst[i]])
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则 返回 r
            如果 非 v_真值(r) 则 返回 假 结束
        结束
        返回 真
    结束
    如果 名字 == "任一满足" 则
        让 表错 = 满足类校验("任一满足", 实参)
        如果 表错 != "" 则 返回 造内置异常(表错) 结束
        让 解 = 高次参数解析("任一满足", 实参)
        让 lst = 解["表"]
        对于 i 从 0 到 长度(lst) - 1 循环
            让 r = v_调用值(解["函数"], [lst[i]])
            如果 类型(r) == "字典" 且 包含(r, "__异常__") 则 返回 r
            如果 v_真值(r) 则 返回 真 结束
        结束
        返回 假
    结束
    # 求和(列表|张量) → 转发宿主，与求值器通道同一来源、同一错误文案。
    # 以前这里是 .co 自己循环累加：对列表结果没错，但 求和("abc") 会静默
    # 变成逐字符加，而宿主报「求和需要1个张量或列表」——两通道口径不一致。
    如果 名字 == "求和" 则
        返回 求和(实参[0])
    结束
    # 末尾兜底：本机没写分派的，一律转给求值器通道的 调用内置。
    # 为什么要转而不是直接报错：调用内置 有 205 个名字的分派，v_宿主内置
    # 只有 80 多个——之前 comm 实测 124 个名字（深拷贝/转字符/随机种子/
    # 字节列表/张量族/全部满足…）在 vm 上被末尾兜底误报「未知内置函数」，
    # 而 eval 通道全都正常。v_宿主内置 是纯分派表、不回调 VM，
    # 调用内置 同样不回拨 v_宿主内置，转过去不会成环。
    # 真正查无此名时，调用内置 自己的末尾兜底给出逐字节相同的
    # 「未知内置函数: X」——两条通道口径一致，也绝不返回 0 冒充成功。
    返回 调用内置(名字, 实参)
结束

# 栈辅助
函数 v_弹出()
    让 n = 长度(v_栈)
    如果 n <= 0 则
        返回 0
    结束
    返回 弹出(v_栈)
结束

函数 v_栈顶()
    返回 v_栈[长度(v_栈) - 1]
结束

# 弹出栈顶 N 个元素，返回收集的列表（栈顶最后一个在末尾）
函数 v_弹出N(n)
    让 取 = []
    对于 k 从 0 到 n - 1 循环
        追加(取, 0)
    结束
    让 深 = 长度(v_栈)
    对于 k 从 0 到 n - 1 循环
        取[k] = v_栈[深 - n + k]
    结束
    当 长度(v_栈) > 深 - n 循环
        弹出(v_栈)
    结束
    返回 取
结束

函数 v_新局部(数量)
    让 局部 = []
    对于 i 从 0 到 数量 - 1 循环
        追加(局部, [0])
    结束
    返回 局部
结束

# ============================================================
# 异常展开：从当前帧向上找最近的处理器
# 返回 1 表示已转入捕获块；0 表示未捕获
# ============================================================
函数 v_展开异常() -> 整数
    当 v_异常槽[0] != 0 且 长度(v_帧栈) > 0 循环
        让 帧 = v_帧栈[长度(v_帧栈) - 1]
        如果 长度(帧[5]) > 0 则
            让 记录 = 帧[5][长度(帧[5]) - 1]
            # 如果有 finally 块，保存它的地址和栈深度供 OP_返回 使用
            如果 记录["最终pc"] != 0 则
                v_待最终槽[0] = 记录["最终pc"]
                v_最终块栈深 = 记录["栈深"]
            结束
            # 弹出该处理器
            弹出(帧[5])
            帧[2] = 记录["捕获pc"]
            # 截断表达式栈到进入 尝试 时的深度，清除异常路径上的栈垃圾
            让 目标深 = 记录["栈深"]
            让 栈长 = 长度(v_栈)
            如果 目标深 > 栈长 则
                目标深 = 栈长
            结束
            当 长度(v_栈) > 目标深 循环
                弹出(v_栈)
            结束
            v_待捕获异常 = v_异常槽[0]
            v_异常槽[0] = 0
            返回 1
        结束
        # 当前帧无处理器：弹出帧继续向上
        如果 帧[6] > 0 则
            v_深度槽[0] = 帧[6] - 1
        结束
        弹出(v_帧栈)
    结束
    # 没找到处理器：保留 v_异常槽[0]，让主循环跳出后由 v_执行 上层转成 __异常__ 信号。
    # 之前这里清掉异常，未捕获错误变成「静默 rc=0」——比崩溃更危险的算错。
    返回 0
结束

# ============================================================
# 虚拟机主循环
# ============================================================
函数 v_执行()
    # ============================================================
    # 热路径局部缓存（VM 性能的核心手段）
    # ------------------------------------------------------------
    # 宿主的变量查找代价 = 作用域链上【每一层】的名字线性 strcmp 扫描。
    # 在 v_执行 里读一个模块级全局变量，要先扫完本函数几十个局部名，
    # 再扫模块环境里的几十个全局名 —— 实测单次全局读 ≈ 1us，
    # 而每条字节码指令原本要读 4~5 次全局（栈/帧栈/v_异常…）。
    #
    # 列表是【引用类型】：把全局列表取一份存进局部，局部与全局指向同一个
    # 列表对象，之后 追加/弹出/下标 改的都是同一份数据，
    # 语义完全不变，只是把「每次都查全局」换成「查一次局部」。
    # 异常标志原本是标量（不能这样缓存），改成 1 元列表 异常槽[0]，
    # 同样可以按引用缓存。
    # ============================================================
    让 栈 = v_栈
    让 帧栈 = v_帧栈
    让 异常槽 = v_异常槽
    让 深度槽 = v_深度槽
    让 最终槽 = v_待最终槽
    让 深度上限 = v_调用深度上限
    让 函数表 = g_函数表
    让 深度 = 长度(帧栈)
    让 栈计数 = 长度(栈)
    # 当前帧与 pc 缓存在局部：每条指令都要用它们，
    # 重新从帧栈里取一趟要多付好几次「作用域链查找 + 下标」。
    # 只在【换帧】时（调用/返回/异常展开）才重新取。
    让 帧 = 帧栈[深度 - 1]
    让 pc = 帧[2]
    当 深度 > 0 循环
        # 异常优先处理
        如果 异常槽[0] != 0 则
            让 已捕获 = v_展开异常()
            深度 = 长度(帧栈)
            栈计数 = 长度(栈)
            如果 深度 > 0 则
                帧 = 帧栈[深度 - 1]
                pc = 帧[2]
            结束
            如果 已捕获 == 0 则
                跳出
            结束
            继续
        结束

        如果 pc >= 帧[8] 则
            跳出
        结束
        让 指令 = 帧[0][pc]
        pc = pc + 1
        让 op = 指令[0]

        如果 op == 4 则
            追加(栈, 帧[3][指令[1]][0])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 6 则
            让 n = 栈计数
            让 r = 栈[n - 1]
            让 l = 栈[n - 2]
            # ---- 快路：最常见的几类运算就地做掉 ----
            # 宿主里一次 .co 函数调用 ≈ 1us（建作用域 + 每个【让】都要建槽），
            # v_二元运算 是递归/循环负载里最高频的调用点。
            # 这里的判据与 v_二元运算【逐条对齐】：同样的宿主运算、同样的类型闸门，
            # 只是省掉「一次函数调用 + 该函数作用域里的建槽开销」。
            # ==/!=：宿主原样比较（v_二元运算 也是直接返回 l==r，不带任何类型闸门）。
            # + - *：两侧都是整数时宿主走 64 位整数运算（v_二元运算 同款）。
            # < > <= >=：两侧都是 整数/浮点/布尔 时宿主判定「可比」，直接比。
            # 其余（字符串/列表/字典/张量/除法/位运算…）一律回落到 v_二元运算，
            # 报错文案与坐标因此逐字节不变。
            让 算符 = 指令[1]
            如果 算符 == "==" 则
                栈[n - 2] = l == r
                弹出(栈)
                栈计数 = 栈计数 - 1
                继续
            结束
            如果 算符 == "!=" 则
                栈[n - 2] = l != r
                弹出(栈)
                栈计数 = 栈计数 - 1
                继续
            结束
            如果 算符 == "+" 或 算符 == "-" 或 算符 == "*" 则
                如果 类型(l) == "整数" 且 类型(r) == "整数" 则
                    如果 算符 == "+" 则
                        栈[n - 2] = l + r
                    否则
                        如果 算符 == "-" 则
                            栈[n - 2] = l - r
                        否则
                            栈[n - 2] = l * r
                        结束
                    结束
                    弹出(栈)
                    栈计数 = 栈计数 - 1
                    继续
                结束
            结束
            如果 算符 == "<" 或 算符 == ">" 或 算符 == "<=" 或 算符 == ">=" 则
                让 tl = 类型(l)
                让 tr = 类型(r)
                如果 (tl == "整数" 或 tl == "浮点" 或 tl == "布尔") 且 (tr == "整数" 或 tr == "浮点" 或 tr == "布尔") 则
                    如果 算符 == "<" 则
                        栈[n - 2] = l < r
                    否则
                        如果 算符 == ">" 则
                            栈[n - 2] = l > r
                        否则
                            如果 算符 == "<=" 则
                                栈[n - 2] = l <= r
                            否则
                                栈[n - 2] = l >= r
                            结束
                        结束
                    结束
                    弹出(栈)
                    栈计数 = 栈计数 - 1
                    继续
                结束
            结束
            让 res = v_二元运算(算符, l, r, 指令)
            栈[n - 2] = res
            弹出(栈)
            栈计数 = 栈计数 - 1
            继续
        结束

        如果 op == 1 则
            追加(栈, 帧[1][指令[1]])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 5 则
            帧[3][指令[1]][0] = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            继续
        结束

        如果 op == 8 则
            pc = 指令[1]
            继续
        结束

        如果 op == 9 则
            让 v = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            # 快路：整数/布尔的真值判定就地做（判据与 v_真值 同款：非零即真）
            让 vt = 类型(v)
            如果 vt == "整数" 或 vt == "布尔" 则
                如果 v == 0 则
                    pc = 指令[1]
                结束
            否则
                如果 非 v_真值(v) 则
                    pc = 指令[1]
                结束
            结束
            继续
        结束

        如果 op == 58 则
            # 循环初检：只判一次「要不要进循环体」。
            # 指令[1]=循环变量槽 指令[2]=种类(0局部/1全局/2自由)
            # 指令[3]=终点槽 指令[4]=步长槽 指令[5]=模式槽
            # 循环变量/终点/步长 都在帧的单元里就地读，不再每轮经操作数栈搬 3 个值。
            让 环_终点 = 帧[3][指令[3]][0]
            让 环_步长 = 帧[3][指令[4]][0]
            让 环_模式 = 帧[3][指令[5]][0]
            让 环_iv = 0
            如果 指令[2] == 0 则
                环_iv = 帧[3][指令[1]][0]
            否则
                如果 指令[2] == 1 则
                    环_iv = v_全局槽[指令[1]]
                否则
                    环_iv = 帧[4][指令[1]][0]
                结束
            结束
            让 环_标志 = 0
            如果 环_模式 == 1 则
                # 浮点通道：宿主 co_old.c:5974 的 ±0.0001 容差（与 循环继续 同款）
                如果 环_步长 > 0 则
                    如果 环_iv <= 环_终点 + 0.0001 则
                        环_标志 = 1
                    结束
                否则
                    如果 环_iv >= 环_终点 - 0.0001 则
                        环_标志 = 1
                    结束
                结束
            否则
                # 整数通道：模式为 0 时 起点/终点/步长 必是 整数或布尔，
                # 转整数 对它们是恒等（布尔 0/1 与宿主数值比较同款），故免掉两次调用。
                如果 环_步长 > 0 则
                    如果 环_iv <= 环_终点 则
                        环_标志 = 1
                    结束
                否则
                    如果 环_步长 < 0 则
                        如果 环_iv >= 环_终点 则
                            环_标志 = 1
                        结束
                    结束
                结束
            结束
            追加(栈, 环_标志)
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 33 则
            # 循环推进：步长更新 + 续判条件，合成一条指令。
            # 旧版一轮要跑 5 条指令（加载变量/加载步长/二元/存储变量/跳转），
            # 现在 1 条搞定；循环体与控制流语义逐条不变：
            #   · 更新顺序仍是「先加步长、再判条件」
            #   · 继续 语句落点 = 本指令（与旧版「步长更新」落点同义）
            #   · 跳出 语句落点 = 循环之后
            #   · 循环体若改写了循环变量，推进读到的就是改后的值（与旧版一致）
            让 环_终点 = 帧[3][指令[3]][0]
            让 环_步长 = 帧[3][指令[4]][0]
            让 环_模式 = 帧[3][指令[5]][0]
            让 环_iv = 0
            如果 指令[2] == 0 则
                环_iv = 帧[3][指令[1]][0]
            否则
                如果 指令[2] == 1 则
                    环_iv = v_全局槽[指令[1]]
                否则
                    环_iv = 帧[4][指令[1]][0]
                结束
            结束
            # 步长更新：与旧版「二元 +」同一宿主运算（整数走 64 位整数加）
            让 环_新 = 0
            如果 类型(环_iv) == "整数" 且 类型(环_步长) == "整数" 则
                环_新 = 环_iv + 环_步长
            否则
                # 非整数（浮点通道 / 循环体把循环变量改成了别的类型）：
                # 交给 v_二元运算，字符串拼接、类型闸门、报错文案与旧版逐字一致。
                环_新 = v_二元运算("+", 环_iv, 环_步长, 指令)
            结束
            如果 指令[2] == 0 则
                帧[3][指令[1]][0] = 环_新
            否则
                如果 指令[2] == 1 则
                    v_全局槽[指令[1]] = 环_新
                否则
                    帧[4][指令[1]][0] = 环_新
                结束
            结束
            # 续判条件（用推进后的新值）
            让 环_标志 = 0
            如果 环_模式 == 1 则
                如果 环_步长 > 0 则
                    如果 环_新 <= 环_终点 + 0.0001 则
                        环_标志 = 1
                    结束
                否则
                    如果 环_新 >= 环_终点 - 0.0001 则
                        环_标志 = 1
                    结束
                结束
            否则
                如果 环_步长 > 0 则
                    如果 环_新 <= 环_终点 则
                        环_标志 = 1
                    结束
                否则
                    如果 环_步长 < 0 则
                        如果 环_新 >= 环_终点 则
                            环_标志 = 1
                        结束
                    结束
                结束
            结束
            追加(栈, 环_标志)
            栈计数 = 栈计数 + 1
            继续
        结束

        # —— 遍历物化 ——
        如果 op == 10 则
            让 参数个数 = 指令[1]
            # 指令[2] = 被调者名字常量索引（编译期 函数调用 登记；非裸标识符为空串）。
            # 帧0/名字常量【只在报错分支】才解引用：正常调用（函数/内置命中）不读。
            # 热路：实参直接在栈上取、不经过 v_弹出N（那函数每次调用要多付
            # 1 次 长度(栈) + n 次 追加 + n 次 弹出 的宿主调用），被调者也
            # 直接从栈槽读、不再走 v_栈顶()。n实参 复用 参数个数（OP_调用 的
            # 操作数就是编译期实参数），下面不再 长度(实参)。
            让 实参 = []
            让 底 = 栈计数 - 1 - 参数个数
            让 被调者 = 栈[底]
            对于 k 从 1 到 参数个数 循环
                追加(实参, 栈[底 + k])
            结束
            对于 k 从 1 到 参数个数 + 1 循环
                弹出(栈)
                栈计数 = 栈计数 - 1
            结束
            让 被调类型 = ""
            如果 类型(被调者) == "字典" 则
                被调类型 = 被调者["类型"]
            结束
            如果 被调类型 != "" 则
                如果 被调类型 == "内置" 则
                    让 返回值 = v_宿主内置(被调者["名字"], 实参)
                    # v_宿主内置 的错误路径和求值器通道一样用 造异常 报告（字典带 __异常__ 键）。
                    # 之前这里无条件压栈，异常字典被当成普通返回值：字节("abc", 9) 不报错，
                    # 反而把 {"__异常__": {...}} 赋给变量 —— 比崩溃更糟的"静默算错"。
                    # 现在转成 v_异常，交给主循环的 v_展开异常 走 尝试/捕获。
                    如果 类型(返回值) == "字典" 且 包含(返回值, "__异常__") 则
                        异常槽[0] = 返回值["__异常__"]
                        继续
                    结束
                    追加(栈, 返回值)
                    栈计数 = 栈计数 + 1
                    继续
                结束
                如果 被调类型 == "函数" 且 包含(被调者, "序号") 则
                    如果 深度槽[0] >= 深度上限 则
                        异常槽[0] = {"类型":"运行时错误","消息":"调用栈即将耗尽（深度上限 " + 转字符串(深度上限) + "），请检查是否存在无限递归","行":v_当前行,"列":v_当前列}
                        继续
                    结束
                    让 段 = 函数表[被调者["序号"]]
                    让 n实参 = 参数个数
                    让 n形参 = 段["参数数"]
                    # ---- 参数数量守卫（宿主 invoke_func 的第一道检查，实测 e04/e05）----
                    # 位置在【类型复查之前】：f(整数 a) 用 0 个实参调用报「参数数量
                    # 错误: 期望 1, 得到 0」。坐标 = 调用节点（第一个实参起点），
                    # 与求值器通道同一判据（标(节点) vs 带尾）。
                    # 快路：实参数 == 形参数 时守卫必然通过（默认值/可变只放宽，不收紧）。
                    # 每调用省 2 次字典查找 —— VM 的 fib/筛法负载对这点开销很敏感。
                    如果 n实参 != n形参 且 (n实参 < 段["最少实参"] 或 (段["可变起"] < 0 且 n实参 > n形参)) 则
                        让 函数名 = 段["名字"]
                        如果 函数名 == "" 则
                            函数名 = "（匿名）"
                        结束
                        v_报错(指令, "函数 " + 函数名 + " 参数数量错误: 期望 " +
                                转字符串(n形参) + ", 得到 " + 转字符串(n实参))
                        继续
                    结束
                    # 宿主 invoke_func（co_old.c:5256）：实参按形参标注 ensure_type("函数参数")
                    让 段参数类型 = 段["参数类型"]
                    让 段参数名 = 段["参数名"]
                    如果 段["查参数类型"] == 1 且 类型(段参数类型) == "列表" 且 类型(段参数名) == "列表" 则
                        对于 ai 从 0 到 n实参 - 1 循环
                            如果 ai >= 长度(段参数名) 则
                                跳出
                            结束
                            让 形参标注 = ""
                            如果 ai < 长度(段参数类型) 则
                                让 原始标注 = 段参数类型[ai]
                                如果 类型(原始标注) == "字符串" 则
                                    形参标注 = 原始标注
                                结束
                            结束
                            如果 形参标注 == "" 或 形参标注 == "可变" 则
                                继续
                            结束
                            如果 类型相符(形参标注, 实参[ai]) == 0 则
                                v_报错(指令, 类型错误消息(形参标注, 实参[ai], "函数参数"))
                                跳出
                            结束
                        结束
                        如果 异常槽[0] != 0 则
                            继续
                        结束
                    结束
                    让 新局部 = v_新局部(段["局部数"])
                    让 可变起 = 段["可变起"]
                    对于 i 从 0 到 n实参 - 1 循环
                        # 可变参数位及其之后交给下面的打包，不逐格落位
                        如果 可变起 >= 0 且 i >= 可变起 则
                            跳出
                        结束
                        如果 i < 长度(新局部) 则
                            新局部[i][0] = 实参[i]
                        结束
                    结束
                    如果 可变起 >= 0 则
                        让 打包 = []
                        对于 j 从 可变起 到 n实参 - 1 循环
                            追加(打包, 实参[j])
                        结束
                        如果 可变起 < 长度(新局部) 则
                            新局部[可变起][0] = 打包
                        结束
                    结束
                    深度槽[0] = 深度槽[0] + 1
                    帧[2] = pc
                    追加(帧栈, [段["指令"], 段["常量"], 0, 新局部, 被调者["闭包"], [], 深度槽[0], n实参, 段["指令数"]])
                    深度 = 深度 + 1
                    帧 = 帧栈[深度 - 1]
                    pc = 0
                    继续
                结束
            结束
            # ---- 值不可调用：宿主的裸名字退到 builtin 表（实测 p2/p3/p6/p7/p8）----
            #   让 平方根 = 5 / 平方根(4) → 2（变量是整数时【照样跑内置】）；
            #   让 n = 5 / n(1) → 0/0「未知内置函数: n」（表里也没有才报）；
            #   被调者是【表达式】（5(1)、"x"(1)、下标结果）→ 带坐标「值不是一个函数」（m11）。
            让 帧0 = 帧
            让 调用名 = 帧0[1][指令[2]]
            如果 调用名 != "" 则
                v_确保内置白名单()
                如果 包含(v_内置白名单, 调用名) 则
                    让 返回2 = v_宿主内置(调用名, 实参)
                    如果 类型(返回2) == "字典" 且 包含(返回2, "__异常__") 则
                        异常槽[0] = 返回2["__异常__"]
                        继续
                    结束
                    追加(栈, 返回2)
                    栈计数 = 栈计数 + 1
                    继续
                结束
                v_报错(指令, "未知内置函数: " + 调用名)
                继续
            结束
            v_报错(指令, "值不是一个函数")
            继续
        结束

        如果 op == 11 则
            让 帧 = 帧栈[深度 - 1]
            # 检查是否有活动的 finally 块需要执行
            让 最终pc = 0
            让 栈深 = 0
            如果 长度(帧[5]) > 0 则
                让 记录 = 帧[5][长度(帧[5]) - 1]
                如果 记录["最终pc"] != 0 则
                    最终pc = 记录["最终pc"]
                    栈深 = 记录["栈深"]
                    # 弹出处理器
                    弹出(帧[5])
                结束
            结束
            # 如果处理栈中没有，检查是否有保存的 finally 块（从捕获路径来的）
            如果 最终pc == 0 且 最终槽[0] != 0 则
                最终pc = 最终槽[0]
                最终槽[0] = 0
                栈深 = v_最终块栈深  # 使用进入 try 块时的栈深度
            结束
            如果 最终pc != 0 则
                # 保存返回值
                栈计数 = 栈计数 - 1
                v_待返回 = 栈[栈计数]
                弹出(栈)
                v_有待返回 = 1
                # 截断栈到进入 try 时的深度
                让 目标深 = 栈深
                让 栈长 = 栈计数
                如果 目标深 > 栈长 则
                    目标深 = 栈长
                结束
                v_返回栈深 = 目标深
                当 栈计数 > 目标深 循环
                    弹出(栈)
                    栈计数 = 栈计数 - 1
                结束
                # 跳转到 finally 块
                pc = 最终pc
                继续
            结束
            # 没有 finally 块，直接返回
            如果 帧[6] > 0 则
                深度槽[0] = 帧[6] - 1
            结束
            弹出(帧栈)
            深度 = 深度 - 1
            如果 深度 > 0 则
                帧 = 帧栈[深度 - 1]
                pc = 帧[2]
            结束
            继续
        结束

        如果 op == 19 则
            让 v = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            # 快路：整数/布尔的真值判定就地做（判据与 v_真值 同款：非零即真）
            让 vt = 类型(v)
            如果 vt == "整数" 或 vt == "布尔" 则
                如果 v != 0 则
                    pc = 指令[1]
                结束
            否则
                如果 v_真值(v) 则
                    pc = 指令[1]
                结束
            结束
            继续
        结束

        如果 op == 7 则
            让 v = 栈[栈计数 - 1]
            栈[栈计数 - 1] = v_一元运算(指令[1], v, 指令)
            继续
        结束

        如果 op == 2 则
            追加(栈, v_全局槽[指令[1]])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 3 则
            v_全局槽[指令[1]] = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            继续
        结束

        如果 op == 20 则
            追加(栈, 帧[4][指令[1]][0])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 21 则
            帧[4][指令[1]][0] = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            继续
        结束

        如果 op == 30 则
            追加(栈, 帧[3][指令[1]])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 31 则
            追加(栈, 帧[4][指令[1]])
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 14 则
            # 指令[1] == 1 时【保留】容器与下标，只把结果压栈：
            # 链式下标赋值 t[r][c] = v 需要同时拿到 父、行 和 行视图，
            # 默认形态（取表达式值）仍然消耗两个操作数。
            让 vm_保留 = 0
            如果 长度(指令) > 1 则
                vm_保留 = 转整数(指令[1])
            结束            让 n = 栈计数
            让 idx = 栈[n - 1]
            让 obj = 栈[n - 2]
            让 结果 = 0
            # 宿主语义：先按容器类型分派，索引一律过 idx_val（只接 整数/浮点/布尔），
            # 非数字报「下标必须是数字」；元组/列表/字符串的越界文案抄宿主并带上
            # 【换算前】的原始下标（宿主 co_old.c:5332 用 i0，不是补码后的 i）。
            # 以前这里全部 转整数 硬转，表["键"] 静默取到 1；越界文案也各通道不一。
            让 vm_容器型 = 类型(obj)
            让 vm_自定义 = 0
            如果 vm_容器型 == "字典" 且 包含(obj, "类型") 则
                vm_自定义 = 1
            结束
            如果 vm_自定义 == 0 且 vm_容器型 == "字典" 则
                # 字典：宿主的键必须是字符串（co_old.c:5346）
                如果 类型(idx) != "字符串" 则
                    v_报错(指令, "字典键必须是字符串")
                    结果 = 0
                否则
                    如果 包含(obj, idx) 则
                        结果 = obj[idx]
                    否则
                        # 宿主 dict_get 缺失键返回 VAL_NULL；以前这里落到宿主的
                        # 字典下标、得到 0，是「静默算错」的一种。
                        结果 = 空
                    结束
                结束
            否则
                如果 vm_自定义 == 1 且 obj["类型"] == "元组" 则
                    让 vm_错 = 下标数字错(idx)
                    如果 vm_错 != "" 则
                        v_报错(指令, vm_错)
                    否则
                        让 vm_元素 = obj["元素"]
                        让 vm_i = 转整数(idx)
                        让 vm_n = 长度(vm_元素)
                        让 vm_实际 = vm_i
                        如果 vm_实际 < 0 则
                            vm_实际 = vm_实际 + vm_n
                        结束
                        如果 vm_实际 < 0 或 vm_实际 >= vm_n 则
                            v_报错(指令, "元组索引越界: " + 转字符串(vm_i))
                        否则
                            结果 = vm_元素[vm_实际]
                        结束
                    结束
                否则
                    如果 vm_自定义 == 1 且 obj["类型"] == "张量" 则
                        # 链式赋值（保留读）【不真的取行视图】：宿主把整条二维 lvalue
                        # 交给 assign_tensor，行越界报在 '='（d04 (2,9)），不是内层节点。
                        # 但维度检查仍在中间读这一层：三维链写 d02 报的是内层节点坐标
                        # （t[0] → (2,5)）——实测 m9/m24，两条通路口径一致。
                        如果 vm_保留 == 1 则
                            如果 可选数字字段(obj, "维度") > 2 则
                                v_报错(指令, "不支持的张量维度索引")
                            结束
                            结果 = 0
                        否则
                            # 宿主的 t[i]：一维取值、二维取行、更高维报「不支持的张量维度索引」
                            让 vm_张 = 引_张量下标读(obj, idx, 空)
                            如果 是异常(vm_张) 则
                                # 层里那份 引_张量下标读 用【求值器的 g_当前行/列】造异常，
                                # 字节码通道不认那套（VM 有 指令尾槽）。这里只取它的【消息】，
                                # 坐标一律经 v_报错 重新按尾槽/语句级/0-0 族判定。
                                v_报错(指令, vm_张["__异常__"]["消息"])
                                结果 = 0
                            否则
                                结果 = vm_张
                            结束
                        结束
                    否则
                        如果 vm_容器型 == "字符串" 则
                            让 vm_错 = 下标数字错(idx)
                            如果 vm_错 != "" 则
                                v_报错(指令, vm_错)
                                结果 = 0
                            否则
                                让 实际idx = 转整数(idx)
                                让 vm_n = 长度(obj)
                                让 vm_实际 = 实际idx
                                如果 vm_实际 < 0 则
                                    vm_实际 = vm_n + vm_实际
                                结束
                                如果 vm_实际 < 0 或 vm_实际 >= vm_n 则
                                    v_报错(指令, "字符串索引越界: " + 转字符串(实际idx) + "（长度 " + 转字符串(vm_n) + "）")
                                    结果 = 0
                                否则
                                    结果 = 截取(obj, vm_实际, 1)
                                结束
                            结束
                        否则
                            如果 vm_容器型 == "列表" 则
                                让 vm_错 = 下标数字错(idx)
                                如果 vm_错 != "" 则
                                    v_报错(指令, vm_错)
                                    结果 = 0
                                否则
                                    让 实际idx = 转整数(idx)
                                    让 vm_n = 长度(obj)
                                    让 vm_实际 = 实际idx
                                    如果 vm_实际 < 0 则
                                        vm_实际 = vm_n + vm_实际
                                    结束
                                    # 越界：转入可捕获的 VM 异常（而非宿主致命错误）
                                    如果 vm_实际 < 0 或 vm_实际 >= vm_n 则
                                        v_报错(指令, "列表索引越界: " + 转字符串(实际idx) + " (列表长度 " + 转字符串(vm_n) + ")")
                                        结果 = 0
                                    否则
                                        结果 = obj[vm_实际]
                                    结束
                                结束
                            否则
                                如果 vm_容器型 == "字典" 则
                                    # 其余自定义字典（异常对象/枚举/结构体/对象实例/任务…）
                                    # 保持层的既有语义：按键取值，缺键给 空。
                                    # 注意这里【不能】套用宿主的「字典键必须是字符串」——
                                    # 层的这些字典都靠 转字符串(键) 寻址，收紧会把
                                    # 捕获 e["消息"] 之外的写法一起打死。
                                    让 vm_键 = 转字符串(idx)
                                    如果 包含(obj, vm_键) 则
                                        结果 = obj[vm_键]
                                    否则
                                        结果 = 空
                                    结束
                                否则
                                    v_报错(指令, "不支持的类型索引")
                                    结果 = 0
                                结束
                            结束
                        结束
                    结束
                结束
            结束
            如果 vm_保留 == 1 则
                追加(栈, 结果)
                栈计数 = 栈计数 + 1
                继续
            结束
            栈[n - 2] = 结果
            弹出(栈)
            栈计数 = 栈计数 - 1
            继续
        结束

        如果 op == 12 则
            让 个数 = 指令[1]
            让 元素 = v_弹出N(个数)
            栈计数 = 栈计数 - 个数
            追加(栈, 元素)
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 18 则
            让 名字 = 指令[1]
            v_确保内置白名单()
            如果 非 包含(v_内置白名单, 名字) 则
                # 值位置的查无此名 = 带坐标「未定义变量: X」（实测 e01/e03）。
                # 坐标走本指令尾槽（编译加载名字 挂的标识符节点）。
                v_报错(指令, "未定义变量: " + 名字)
                继续
            结束
            追加(栈, {"类型":"内置","名字":名字})
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 22 则
            让 个数 = 指令[2]
            让 序号 = 指令[1]
            # 栈上压了 个数 个单元
            让 n = 栈计数
            让 闭包 = []
            对于 i 从 0 到 个数 - 1 循环
                追加(闭包, 栈[n - 个数 + i])
            结束
            当 栈计数 > n - 个数 循环
                弹出(栈)
                栈计数 = 栈计数 - 1
            结束
            追加(栈, {"类型":"函数","序号":序号,"闭包":闭包})
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 16 则
            栈计数 = 栈计数 - 1
            弹出(栈)
            继续
        结束

        如果 op == 62 则
            让 模式槽 = 指令[1]
            让 步长原始 = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            让 终点原始 = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            让 起点原始 = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            # 判据共用 求值器 的 数值参数 + v_报错：num_of 族自动 0/0（实测 f05），
            # 「循环步长不能为 0」是有坐标的，本指令不挂尾 → 退回语句坐标（实测 f04 (3,3)）。
            让 起检 = 数值参数(起点原始, "循环起点")
            如果 起检["错误"] != "-" 则
                v_报错(指令, 起检["错误"])
                继续
            结束
            让 终检 = 数值参数(终点原始, "循环终点")
            如果 终检["错误"] != "-" 则
                v_报错(指令, 终检["错误"])
                继续
            结束
            让 步检 = 数值参数(步长原始, "循环步长")
            如果 步检["错误"] != "-" 则
                v_报错(指令, 步检["错误"])
                继续
            结束
            如果 步检["值"] == 0 则
                # 宿主：步长为 0 立即报错。以前 VM 靠 步长v > 0 的分支硬撑，
                # 结果是「循环被静默跳过」——程序跑完、rc=0、一个数都没输出。
                v_报错(指令, "循环步长不能为 0")
                继续
            结束
            让 浮点模式 = 0
            如果 宿主类型名(起点原始) == "浮点" 或 宿主类型名(终点原始) == "浮点" 或 宿主类型名(步长原始) == "浮点" 则
                浮点模式 = 1
            结束
            帧[3][模式槽][0] = 浮点模式
            如果 浮点模式 == 1 则
                追加(栈, 转浮点(起检["值"]))
                栈计数 = 栈计数 + 1
            否则
                追加(栈, 转整数(起检["值"]))
                栈计数 = 栈计数 + 1
            结束
            继续
        结束

        # 循环条件：栈上 [i, 终点, 步长]，弹出三者，按步长方向判断是否继续
        # 指令[1] = 模式槽（0=整数通道，1=浮点通道带 ±0.0001 容差，宿主 co_old.c:5974）
        如果 op == 68 则
            # 主帧没有 argc 键时（外部构造）按 0 处理：全部走默认值
            让 帧c = 帧栈[深度 - 1]
            让 argc值 = 0
            如果 帧c[7] >= 0 则
                argc值 = 帧c[7]
            结束
            追加(栈, argc值)
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 13 则
            让 对数 = 指令[1]
            让 n = 栈计数
            让 结果 = {}
            对于 i 从 0 到 对数 - 1 循环
                让 k = 栈[n - 2 * 对数 + 2 * i]
                让 v = 栈[n - 2 * 对数 + 2 * i + 1]
                结果[转字符串(k)] = v
            结束
            当 栈计数 > n - 2 * 对数 循环
                弹出(栈)
                栈计数 = 栈计数 - 1
            结束
            追加(栈, 结果)
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 23 则
            让 个数 = 指令[1]
            让 元素 = v_弹出N(个数)
            栈计数 = 栈计数 - 个数
            追加(栈, {"类型":"元组","元素":元素})
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 67 则
            # 栈：[val, 父, 行, 行视图, 列]
            让 n5 = 栈计数
            让 vm_列 = 栈[n5 - 1]
            让 vm_视图 = 栈[n5 - 2]
            让 vm_行 = 栈[n5 - 3]
            让 vm_父 = 栈[n5 - 4]
            让 vm_值 = 栈[n5 - 5]
            让 vm_链错 = ""
            如果 是张量字典(vm_父) == 1 则
                vm_链错 = 引_张量链式写(vm_父, vm_行, vm_列, vm_值)
            否则
                如果 是异常(vm_视图) 则
                    vm_链错 = "只能对列表或字典进行索引赋值"
                否则
                    如果 类型(vm_视图) == "列表" 则
                        让 vm_数错 = 下标数字错(vm_列)
                        如果 vm_数错 != "" 则
                            vm_链错 = vm_数错
                        否则
                            如果 转整数(vm_列) < 0 则
                                vm_链错 = "索引不能为负数"
                            结束
                        结束
                    否则
                        如果 类型(vm_视图) == "字典" 则
                            如果 类型(vm_列) != "字符串" 则
                                vm_链错 = "字典键必须是字符串"
                            结束
                        否则
                            vm_链错 = "只能对列表或字典进行索引赋值"
                        结束
                    结束
                结束
            结束
            如果 vm_链错 != "" 则
                v_报错(指令, vm_链错)
            结束
            如果 vm_链错 == "" 且 是张量字典(vm_父) == 0 则
                如果 类型(vm_视图) == "列表" 则
                    vm_视图[转整数(vm_列)] = vm_值
                否则
                    vm_视图[转字符串(vm_列)] = vm_值
                结束
            结束
            当 栈计数 > n5 - 5 循环
                弹出(栈)
                栈计数 = 栈计数 - 1
            结束
            继续
        结束

        如果 op == 15 则
            让 n = 栈计数
            让 idx = 栈[n - 1]
            让 obj = 栈[n - 2]
            让 val = 栈[n - 3]
            让 vm_写型 = 类型(obj)
            让 vm_写自定义 = 0
            如果 vm_写型 == "字典" 且 包含(obj, "类型") 则
                vm_写自定义 = 1
            结束
            让 vm_写错 = ""
            如果 vm_写自定义 == 1 且 obj["类型"] == "张量" 则
                # 宿主 assign_tensor 的一维形态：下标过 idx_val、负数不绕回、
                # 值必须过 num_of。以前 VM 把张量当普通字典 转字符串 存键，
                # t[0][1] = 5 静默写成 "1" 键、再读回 0 —— 跑得动但结果是错的。
                # 二维链式由 OP_下标链赋值 直接写父张量，不会走到这里。
                让 vm_张错 = 引_张量元素写(obj, idx, val)
                如果 vm_张错 != "" 则
                    vm_写错 = vm_张错
                结束
            否则
                如果 vm_写型 == "列表" 则
                    # 宿主 idx_val + 负索引拒绝（co_old.c:5862）
                    让 vm_数错 = 下标数字错(idx)
                    如果 vm_数错 != "" 则
                        vm_写错 = vm_数错
                    否则
                        让 vm_wi = 转整数(idx)
                        如果 vm_wi < 0 则
                            vm_写错 = "索引不能为负数"
                        结束
                    结束
                否则
                    如果 vm_写型 == "字典" 且 vm_写自定义 == 0 则
                        如果 类型(idx) != "字符串" 则
                            vm_写错 = "字典键必须是字符串"
                        结束
                    否则
                        如果 vm_写型 != "字典" 则
                            # 字符串/整数/浮点/函数 等一律拒绝（宿主同款文案）
                            vm_写错 = "只能对列表或字典进行索引赋值"
                        结束
                    结束
                结束
            结束
            如果 vm_写错 != "" 则
                v_报错(指令, vm_写错)
                当 栈计数 > n - 3 循环
                    弹出(栈)
                    栈计数 = 栈计数 - 1
                结束
                继续
            结束
            如果 vm_写型 == "列表" 则
                obj[转整数(idx)] = val
            结束
            # 张量分支已由 引_张量元素写 直接写进 数据（或穿透父张量），
            # 绝不能再存成键，否则 t[0][1] = 5 会多出一个 "1" 键而值仍是 0。
            如果 vm_写型 == "字典" 且 非 (vm_写自定义 == 1 且 obj["类型"] == "张量") 则
                obj[转字符串(idx)] = val
            结束
            当 栈计数 > n - 3 循环
                弹出(栈)
                栈计数 = 栈计数 - 1
            结束
            继续
        结束

        # —— 异常 ——
        如果 op == 24 则
            让 v = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            如果 类型(v) == "字典" 则
                # 抛出字典时，直接使用字典作为异常对象
                异常槽[0] = v
                如果 非 包含(异常槽[0], "行") 则
                    异常槽[0]["行"] = v_当前行
                结束
                如果 非 包含(异常槽[0], "列") 则
                    异常槽[0]["列"] = v_当前列
                结束
            否则
                # 抛出非字典值时，创建标准异常对象
                异常槽[0] = {"类型": "抛出", "消息": 转字符串(v), "行": v_当前行, "列": v_当前列}
            结束
            继续
        结束

        如果 op == 25 则
            让 帧 = 帧栈[深度 - 1]
            # 记录捕获点与进入时的表达式栈深，展开异常时据此截断栈垃圾
            追加(帧[5], {"捕获pc": 指令[1], "最终pc": 指令[2], "栈深": 栈计数})
            继续
        结束

        如果 op == 26 则
            让 帧 = 帧栈[深度 - 1]
            如果 长度(帧[5]) > 0 则
                弹出(帧[5])
            结束
            继续
        结束

        如果 op == 28 则
            追加(栈, v_待捕获异常)
            栈计数 = 栈计数 + 1
            v_待捕获异常 = 0
            继续
        结束

        如果 op == 29 则
            异常槽[0] = 0
            继续
        结束

        # 检查重抛：finally 执行完后，检查是否有待捕获异常或待返回值
        如果 op == 59 则
            # 清除待执行最终标记（finally 块已完成）
            最终槽[0] = 0
            如果 v_待捕获异常 != 0 则
                异常槽[0] = v_待捕获异常
                v_待捕获异常 = 0
                继续
            结束
            如果 v_有待返回 == 1 则
                # 完成延迟的返回：弹出当前帧，把返回值压到调用者栈上
                让 返回值 = v_待返回
                v_待返回 = 0
                v_有待返回 = 0
                让 帧 = 帧栈[深度 - 1]
                如果 帧[6] > 0 则
                    深度槽[0] = 帧[6] - 1
                结束
                弹出(帧栈)
                深度 = 深度 - 1
                如果 深度 > 0 则
                    帧 = 帧栈[深度 - 1]
                    pc = 帧[2]
                结束
                # 恢复栈到进入 try 时的深度
                当 栈计数 > v_返回栈深 循环
                    弹出(栈)
                    栈计数 = 栈计数 - 1
                结束
                追加(栈, 返回值)
                栈计数 = 栈计数 + 1
                继续
            结束
            继续
        结束

        如果 op == 57 则
            v_当前行 = 指令[1]
            v_当前列 = 指令[2]
            继续
        结束

        # —— 宿主语义守卫（0.1.16）——
        # 类型标注复查：栈顶不弹出；不符置 v_异常（消息与求值器通道同一份实现）。
        如果 op == 60 则
            让 标注 = 帧[1][指令[1]]
            让 哪里 = 帧[1][指令[2]]
            让 待检 = 栈[栈计数 - 1]
            如果 类型相符(标注, 待检) == 0 则
                异常槽[0] = {"类型": "运行时错误", "消息": 类型错误消息(标注, 待检, 哪里), "行": v_当前行, "列": v_当前列}
            结束
            继续
        结束

        # 编译期已确定必错（带标注的裸声明）：直接报错，不给静默默认值
        如果 op == 63 则
            异常槽[0] = {"类型": "运行时错误", "消息": 帧[1][指令[1]], "行": v_当前行, "列": v_当前列}
            继续
        结束

        # 常量重复声明（宿主 co_old.c:5833，只看名字是否已占用）
        如果 op == 64 则
            让 名 = 帧[1][指令[1]]
            如果 包含(v_声明表, 名) 则
                异常槽[0] = {"类型": "运行时错误", "消息": "常量不能重复声明", "行": v_当前行, "列": v_当前列}
            结束
            继续
        结束

        如果 op == 66 则
            v_声明表[帧[1][指令[1]]] = 1
            继续
        结束

        # 不能给函数名赋值（宿主 co_old.c:5848）：指令[1]=0 局部 / 1 全局
        如果 op == 65 则
            让 旧值 = 0
            如果 指令[1] == 0 则
                旧值 = 帧[3][指令[2]][0]
            否则
                如果 指令[1] == 2 则
                    旧值 = 帧[4][指令[2]][0]
                否则
                    旧值 = v_全局槽[指令[2]]
                结束
            结束
            如果 类型(旧值) == "字典" 且 包含(旧值, "类型") 且 旧值["类型"] == "函数" 则
                异常槽[0] = {"类型": "运行时错误", "消息": "不能给函数名赋值", "行": v_当前行, "列": v_当前列}
            结束
            继续
        结束

        # 循环入口校验：栈上 [起点, 终点, 步长]，弹出后按宿主顺序逐个数检，
        # 通过后把【归一化的起点】回推栈上（由 编译存储名字 写回循环变量），
        # 并把「是否走浮点通道」的标志存进 模式槽。指令[1] = 模式槽。
        # 校验顺序与文案都抄宿主 ND_FOR：起点 → 终点 → 步长 → 步长非零。
        如果 op == 27 则
            让 容器 = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            让 物料 = []
            如果 类型(容器) == "字典" 且 包含(容器, "类型") 且 容器["类型"] == "元组" 则
                物料 = 容器["元素"]
            否则
                如果 类型(容器) == "字典" 则
                    物料 = 键(容器)
                否则
                    物料 = 容器
                结束
            结束
            追加(栈, 物料)
            栈计数 = 栈计数 + 1
            继续
        结束

        # —— 枚举声明：构造 {"类型":"枚举", 成员: 递增整数} ——
        如果 op == 32 则
            让 名 = 栈[栈计数 - 1]
            栈计数 = 栈计数 - 1
            弹出(栈)
            让 d = {"类型":"枚举"}
            # 成员列表在编译期由常量表给出？这里简化：枚举成员在 AST 中是字符串列表，
            # 由编译期直接构造为常量字典。OP_枚举声明 仅作为占位，实际字典已在常量中。
            追加(栈, d)
            栈计数 = 栈计数 + 1
            继续
        结束

        # —— 快捷内置操作 ——
        如果 op == 34 则
            让 a = v_弹出N(3)
            栈计数 = 栈计数 - 3
            栈计数 = 栈计数 - 3
            追加(栈, 截取(a[0], a[1], a[2]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 35 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            追加(栈, 查找(a[0], a[1]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 36 则
            让 a = v_弹出N(3)
            栈计数 = 栈计数 - 3
            栈计数 = 栈计数 - 3
            追加(栈, 替换(a[0], a[1], a[2]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 37 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 大写(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 38 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 小写(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 39 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            追加(栈, 追加(a[0], a[1]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 40 则
            让 a = v_弹出N(3)
            栈计数 = 栈计数 - 3
            栈计数 = 栈计数 - 3
            追加(栈, 插入(a[0], a[1], a[2]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 41 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 弹出(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 42 则
            让 a = v_弹出N(3)
            栈计数 = 栈计数 - 3
            栈计数 = 栈计数 - 3
            追加(栈, 切片(a[0], a[1], a[2]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 43 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 排序(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 44 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            追加(栈, 索引(a[0], a[1]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 45 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            追加(栈, 包含(a[0], a[1]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 46 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 键(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 47 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 值(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 48 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            移除键(a[0], a[1])
            追加(栈, 0)
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 49 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 类型(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 50 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 正弦(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 51 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 余弦(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 52 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 自然对数(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 53 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 平方根(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 54 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 绝对值(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 55 则
            让 a = v_弹出N(1)
            栈计数 = 栈计数 - 1
            栈计数 = 栈计数 - 1
            追加(栈, 取整(a[0]))
            栈计数 = 栈计数 + 1
            继续
        结束
        如果 op == 56 则
            让 a = v_弹出N(2)
            栈计数 = 栈计数 - 2
            栈计数 = 栈计数 - 2
            追加(栈, 幂(a[0], a[1]))
            栈计数 = 栈计数 + 1
            继续
        结束

        如果 op == 17 则
            跳出
        结束
    结束

    # 异常未捕获：返回异常字典给调用方。
    # 必须把 行/列/类型 一起带出去——以前这里只抄 消息，坐标在出口就被丢掉，
    # 于是 vm 通道的每一条报错都变成无坐标的「运行时错误: X」，
    # 与宿主/eval 的「运行时错误 (第2行,9列): X」永远对不上。
    如果 异常槽[0] != 0 则
        让 异 = 异常槽[0]
        异常槽[0] = 0
        让 包 = {"消息": 异["消息"]}
        如果 包含(异, "行") 则
            包["行"] = 异["行"]
        结束
        如果 包含(异, "列") 则
            包["列"] = 异["列"]
        结束
        如果 包含(异, "类型") 则
            包["类型"] = 异["类型"]
        结束
        返回 {"__异常__": 包}
    结束
    返回 0
结束

# ============================================================
# 一站式入口：接受 AST 直接编译并执行
# ============================================================
函数 编译执行AST(ast)
    编译程序(ast)
    如果 g_不支持 == 1 则
        返回 {"__VM不支持__": 1}
    结束

    v_全局槽 = []
    对于 i 从 0 到 g_全局槽数 - 1 循环
        追加(v_全局槽, 0)
    结束
    v_声明表 = {}

    v_栈 = []
    v_帧栈 = []
    v_深度槽[0] = 0
    v_异常槽[0] = 0
    让 主段 = g_函数表[0]
    追加(v_帧栈, [主段["指令"], 主段["常量"], 0, v_新局部(主段["局部数"]), [], [], 0, 0, 主段["指令数"]])

    让 r = v_执行()
    如果 类型(r) == "字典" 且 包含(r, "__异常__") 则
        # 与 求值器.运行 同构：未捕获异常打到 stderr 并保留异常信号（上层据此 rc=1）。
        # 必须走共享的 打印异常：以前这里自己拼「运行时错误: 」+ 消息，
        # 把异常自带的 行/列 整个丢掉，于是 vm 通道【所有】报错都没有坐标
        # （实测同一条越界：宿主/eval (2,9)、vm 无坐标）。
        打印异常(r["__异常__"])
        返回 r
    结束
    返回 0
结束

# 便捷入口：接受源字符串，内部尝试解析（需要环境中有 解析源）
函数 编译执行(字符串 源)
    让 ast = 解析源(源)
    返回 编译执行AST(ast)
结束
