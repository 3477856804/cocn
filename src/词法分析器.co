# ============================================================
# 词法分析器.co —— coCN 自解释器的词法分析模块
#
# 导出：函数 词法分析(字符串 源) -> 列表
#
# 每个 token 是一个字典：
#   {"类型": ..., "值": ..., "行": 整数, "列": 整数}
# 类型取值："整数" | "浮点" | "字符串" | "标识符" | "关键字" | "运算符" | "换行" | "文件结束"
#
# 设计要点：
#   1. 行/列均为 1-based，按【字符】计列（UTF-8 安全，与 截取/索引 的字符语义一致）。
#   2. 换行 token 只在「该行出现过真实记号」时产生；空行、纯注释行不产生。
#   3. 注释 # 到行尾跳过，但不抑制它前面同一行已经产生的换行。
#   4. 双字符运算符贪婪匹配：== != <= >= // ** -> << >>，其余单字符单出。
#   5. 字符串 token 的「值」是转义解析后的内容；数值/标识符/运算符的「值」是原始文本。
#   6. 关键字优先于标识符；扫描器结构为守卫链（若...继续），不用深层嵌套。
# ============================================================

# ---------------- 字符分类辅助 ----------------

# 是否为十进制数字字符
函数 是数字(字符串 c) -> 布尔
    返回 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9"
结束

# 一个字符在源码里占几个 UTF-8 字节（1/2/3/4）。
# 为什么需要它：宿主 ./bin/引导器 的【字符串扫描器是按字节推进列号】的，
# 而标识符/注释/运算符扫描器是按字符推进的 —— 同一行存在两套列口径。
# 实测（./bin/引导器）：
#   输出 "ab" - "cd"   → 第1行,15列      （纯 ASCII，与字符口径一致）
#   输出 "甲"  - "cd"   → 第1行,16列      （甲 3 字节，比字符口径多 2 列）
#   输出 "中文中文中文" - "甲" → 第1行,32列 （7 个汉字 = 21 字节，多 14 列）
#   输出 "a\甲" - "b"   → 第1行,17列      （转义：反斜杠算 1 列，被转义字符按字节）
# 这是宿主既有的缺陷（含中文的字符串一旦出现，其后所有报错列号都会偏），
# 但「行列坐标对齐宿主」是本层的硬承诺，所以照抄这个怪癖，不做假对齐。
# 用码点区间判定，不依赖额外的字节内置：字符码 是宿主原语，两通道都有。
函数 字符字节数(字符串 字符) -> 整数
    让 码 = 字符码(字符)
    如果 码 < 128 则
        返回 1
    结束
    如果 码 < 2048 则
        返回 2
    结束
    如果 码 < 65536 则
        返回 3
    结束
    返回 4
结束

# 是否为数字或字母（ASCII）：进制字面量的尾巴判定用。
# 宿主把 0b12 / 0x1Fz / 0o19 一律按「该进制不允许的数字」拒绝，
# 也就是数位序列后面还粘着字母/数字时同样是错误，不能当两个记号吞掉。
# 用字符串比较而不是取字节码：本模块运行在宿主/自举两种环境里，
# 字符串的字典序比较两边一致，不依赖额外的字节内置。
函数 是数字或字母(字符串 c) -> 布尔
    如果 是数字(c) 则
        返回 真
    结束
    如果 c == "_" 则
        返回 真
    结束
    如果 长度(c) != 1 则
        返回 假
    结束
    返回 (c >= "a" 且 c <= "z") 或 (c >= "A" 且 c <= "Z")
结束

# 是否为运算符字符（单/双字符运算符的首字符集合）
# 用于标识符扫描时停止，以及主循环分派。
# 注：新增 "." 以支持 枚举.成员 成员访问 与 ... 可变参数（均由语法层处理）
# 注：";" 为语句分隔符，排在分号专属分支之前被处理；列入操作符字符集
#     是为了让标识符扫描在遇到 ; 时正确终止（如 a=1;b=2 不得扫成 "1;b"）。
函数 是操作符字符(字符串 c) -> 布尔
    返回 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" 或 c == "!" 或 c == "<" 或 c == ">" 或 c == "(" 或 c == ")" 或 c == "[" 或 c == "]" 或 c == "{" 或 c == "}" 或 c == "," 或 c == ":" 或 c == "&" 或 c == "|" 或 c == "^" 或 c == "~" 或 c == "." 或 c == ";"
结束

# 是否为关键字（命中则标记为「关键字」而非「标识符」）
函数 是关键字(字符串 词) -> 布尔
    返回 词 == "让" 或 词 == "整数" 或 词 == "浮点" 或 词 == "布尔" 或 词 == "字符串" 或 词 == "列表" 或 词 == "字典" 或 词 == "空" 或 词 == "变量" 或 词 == "常量" 或 词 == "函数" 或 词 == "返回" 或 词 == "如果" 或 词 == "否则" 或 词 == "否则如果" 或 词 == "否则若" 或 词 == "若" 或 词 == "当" 或 词 == "对于" 或 词 == "从" 或 词 == "到" 或 词 == "步长" 或 词 == "循环" 或 词 == "结束" 或 词 == "跳出" 或 词 == "继续" 或 词 == "真" 或 词 == "假" 或 词 == "且" 或 词 == "或" 或 词 == "非" 或 词 == "导入" 或 词 == "匹配" 或 词 == "是" 或 词 == "情况" 或 词 == "默认" 或 词 == "于" 或 词 == "在" 或 词 == "那么" 或 词 == "尝试" 或 词 == "捕获" 或 词 == "最终" 或 词 == "抛出" 或 词 == "并发" 或 词 == "等待" 或 词 == "则" 或 词 == "枚举" 或 词 == "结构体" 或 词 == "作为" 或 词 == "类" 或 词 == "继承" 或 词 == "继承自" 或 词 == "self" 或 词 == "自己" 或 词 == "super"
结束

# 十六进制数字字符 → 数值（0-15）；非十六进制数字返回 -1
函数 十六进制数值(字符串 c) -> 整数
    若 c == "0" 则 返回 0 结束
    若 c == "1" 则 返回 1 结束
    若 c == "2" 则 返回 2 结束
    若 c == "3" 则 返回 3 结束
    若 c == "4" 则 返回 4 结束
    若 c == "5" 则 返回 5 结束
    若 c == "6" 则 返回 6 结束
    若 c == "7" 则 返回 7 结束
    若 c == "8" 则 返回 8 结束
    若 c == "9" 则 返回 9 结束
    若 c == "a" 或 c == "A" 则 返回 10 结束
    若 c == "b" 或 c == "B" 则 返回 11 结束
    若 c == "c" 或 c == "C" 则 返回 12 结束
    若 c == "d" 或 c == "D" 则 返回 13 结束
    若 c == "e" 或 c == "E" 则 返回 14 结束
    若 c == "f" 或 c == "F" 则 返回 15 结束
    返回 -1
结束

# 字符串大数助手：十进制串 × 倍 + 加 → 新十进制串
# （宿主整数算术内部经浮点中转，>2^53 丢精度；进制字面量转十进制
#   全程用字符串进位，任何中间值都不经过数值运算，64 位永不丢精度）
函数 十进串乘加(字符串 串, 整数 倍, 整数 加) -> 字符串
    整数 进位 = 加
    让 出 = ""
    整数 i = 长度(串) - 1
    当 i >= 0 循环
        整数 d = 转整数(串[i]) * 倍 + 进位
        出 = 转字符串(d % 10) + 出
        进位 = d // 10
        i = i - 1
    结束
    若 进位 > 0
        出 = 转字符串(进位) + 出
    结束
    返回 出
结束

# 十进制串是否 <= 上限串（纯字符串比较：先比长度、再比字典序）。
# 为什么不用数值比较：能走到这里的串本身就已经超出 64 位了，
# 转整数会溢出/截断，比较结果不可信——越界判定必须自己不退化成数值运算。
函数 十进串不超(字符串 串, 字符串 上限) -> 布尔
    让 a = 去前导零(串)
    让 b = 去前导零(上限)
    如果 长度(a) < 长度(b) 则
        返回 真
    结束
    如果 长度(a) > 长度(b) 则
        返回 假
    结束
    对于 i 从 0 到 长度(a) - 1 循环
        如果 a[i] < b[i] 则
            返回 真
        结束
        如果 a[i] > b[i] 则
            返回 假
        结束
    结束
    返回 真
结束

函数 去前导零(字符串 串) -> 字符串
    让 i = 0
    当 i < 长度(串) - 1 且 串[i] == "0" 循环
        i = i + 1
    结束
    返回 截取(串, i, 长度(串) - i)
结束

# 进制字面量的两道闸（文案与判定逐字抄宿主，实测 /tmp/lx/*.co）：
#   数位不合法（0b12 / 0x1g / 0o19，以及数位后紧跟字母 0b11a / 0x1Fz）
#     → 「词法错误 (第R行,C列): 进制字面量中出现该进制不允许的数字」
#   数值超出 int64 上限 9223372036854775807
#     → 「词法错误 (第R行,C列): 整数字面量超出范围」
# 以前这里只算不查：0b12 被当成 0b1 静默吞掉（值错），
# 99999999999999999999 静默变成 9223372036854775807（值错）——
# 正是「编得过、跑得动、但结果是错的」那一类。
# 致命词法错误：打完中文消息直接退出。宿主实测只打印一行「词法错误 …」
# 就 rc=1，没有第二行；早期这里跟一句 断言(假,"词法分析失败")，
# 于是三通道对照多出「断言失败: 词法分析失败」一整行（i01 坐标用例抓到）。
函数 词法致命(整数 记行, 整数 记列, 字符串 消息)
    输出错误("词法错误 (第" + 转字符串(记行) + "行," + 转字符串(记列) + "列): " + 消息)
    退出(1)
结束

函数 校验进制数字(字符串 串, 整数 记行, 整数 记列)
    如果 非 十进串不超(串, "9223372036854775807") 则
        词法致命(记行, 记列, "整数字面量超出范围")
    结束
结束

# ---------------- 词法分析主函数 ----------------

# 把 coCN 源代码字符串切分为 token 列表
函数 词法分析(字符串 源) -> 列表
    列表 表 = []              # 输出 token 列表
    整数 n = 长度(源)         # 源串字符总数
    整数 p = 0                # 当前扫描位置（按字符计）
    整数 行 = 1               # 当前行号（1-based）
    整数 列 = 1               # 当前列号（1-based，按字符计）
    整数 行有内容 = 0         # 当前物理行是否已出现真实记号（空行/纯注释行不发换行）

    当 p < n 循环
        字符串 c = 源[p]

        # ---- 空白：空格/制表符/回车，跳过不发 token ----
        若 c == " " 或 c == "\t" 或 c == "\r"
            p = p + 1
            列 = 列 + 1
            继续
        结束

        # ---- 注释：# 到行尾全部跳过（不吞掉换行本身，由后续分支处理）----
        若 c == "#"
            当 p < n 且 源[p] != "\n" 循环
                p = p + 1
                列 = 列 + 1
            结束
            继续
        结束

        # ---- 换行：该行有记号才发「换行」token，然后切行 ----
        若 c == "\n"
            若 行有内容 == 1
                字典 t = {"类型": "换行", "值": "\n", "行": 行, "列": 列}
                追加(表, t)
            结束
            行 = 行 + 1
            列 = 1
            p = p + 1
            行有内容 = 0
            继续
        结束

        # ---- 分号：语句分隔符，与换行同义（一行多语句：a = 1; b = 2）----
        若 c == ";"
            若 行有内容 == 1
                字典 t = {"类型": "换行", "值": ";", "行": 行, "列": 列}
                追加(表, t)
            结束
            p = p + 1
            列 = 列 + 1
            继续
        结束

        # ---- 数字：整数 或 浮点（数字.数字），支持 0x 十六进制 与 0b 二进制 ----
        若 是数字(c)
            整数 记行 = 行
            整数 记列 = 列
            # 十六进制字面量：0x / 0X 后接十六进制数位（允许 _ 分隔）
            # 十进制串进位累积：任何中间值都不经过数值运算，64 位永不丢精度
            若 c == "0" 且 p + 1 < n 且 (源[p + 1] == "x" 或 源[p + 1] == "X")
                让 十六串 = ""
                整数 十六数 = 0
                p = p + 2
                列 = 列 + 2
                整数 十六停 = 0
                当 p < n 循环
                    若 源[p] == "_"
                        p = p + 1
                        列 = 列 + 1
                        继续
                    结束
                    整数 位 = 十六进制数值(源[p])
                    若 位 < 0
                        十六停 = 1
                        跳出
                    结束
                    十六串 = 十进串乘加(十六串, 16, 位)
                    十六数 = 十六数 + 1
                    p = p + 1
                    列 = 列 + 1
                结束
                若 十六数 == 0
                    词法致命(记行, 记列, "进制前缀后缺少有效数字")
                结束
                # 数位后紧跟字母/数字（0x1Fz、0b12）在宿主里是「该进制不允许的数字」，
                # 不能像以前那样跳出循环把它当成下一个记号——那是把 0x1Fz 静默读成 0x1F。
                若 十六停 == 1 且 是数字或字母(源[p])
                    词法致命(记行, 记列, "进制字面量中出现该进制不允许的数字")
                结束
                校验进制数字(十六串, 记行, 记列)
                字典 t = {"类型": "整数", "值": 十六串, "行": 记行, "列": 记列}
                追加(表, t)
                行有内容 = 1
                继续
            结束
            # 二进制字面量：0b / 0B 后接 0/1 数位（允许 _ 分隔，同样字符串进位）
            若 c == "0" 且 p + 1 < n 且 (源[p + 1] == "b" 或 源[p + 1] == "B")
                让 二串 = ""
                整数 二数 = 0
                整数 二停 = 0
                p = p + 2
                列 = 列 + 2
                当 p < n 循环
                    若 源[p] == "_"
                        p = p + 1
                        列 = 列 + 1
                        继续
                    结束
                    若 源[p] == "0"
                        二串 = 十进串乘加(二串, 2, 0)
                        二数 = 二数 + 1
                    否则若 源[p] == "1"
                        二串 = 十进串乘加(二串, 2, 1)
                        二数 = 二数 + 1
                    否则
                        二停 = 1
                        跳出
                    结束
                    p = p + 1
                    列 = 列 + 1
                结束
                若 二数 == 0
                    词法致命(记行, 记列, "进制前缀后缺少有效数字")
                结束
                若 二停 == 1 且 是数字或字母(源[p])
                    词法致命(记行, 记列, "进制字面量中出现该进制不允许的数字")
                结束
                校验进制数字(二串, 记行, 记列)
                字典 t = {"类型": "整数", "值": 二串, "行": 记行, "列": 记列}
                追加(表, t)
                行有内容 = 1
                继续
            结束
            # 八进制字面量：0o / 0O 后接 0-7 数位（允许 _ 分隔，同样字符串进位）
            若 c == "0" 且 p + 1 < n 且 (源[p + 1] == "o" 或 源[p + 1] == "O")
                让 八串 = ""
                整数 八数 = 0
                整数 八停 = 0
                p = p + 2
                列 = 列 + 2
                当 p < n 循环
                    若 源[p] == "_"
                        p = p + 1
                        列 = 列 + 1
                        继续
                    结束
                    若 源[p] == "0" 或 源[p] == "1" 或 源[p] == "2" 或 源[p] == "3" 或 源[p] == "4" 或 源[p] == "5" 或 源[p] == "6" 或 源[p] == "7"
                        八串 = 十进串乘加(八串, 8, 转整数(源[p]))
                        八数 = 八数 + 1
                    否则
                        八停 = 1
                        跳出
                    结束
                    p = p + 1
                    列 = 列 + 1
                结束
                若 八数 == 0
                    词法致命(记行, 记列, "进制前缀后缺少有效数字")
                结束
                若 八停 == 1 且 是数字或字母(源[p])
                    词法致命(记行, 记列, "进制字面量中出现该进制不允许的数字")
                结束
                校验进制数字(八串, 记行, 记列)
                字典 t = {"类型": "整数", "值": 八串, "行": 记行, "列": 记列}
                追加(表, t)
                行有内容 = 1
                继续
            结束
            整数 起 = p
            布尔 浮 = 假
            # 整数部分（允许 _ 分隔：1_000_000）
            当 p < n 且 (是数字(源[p]) 或 源[p] == "_") 循环
                p = p + 1
                列 = 列 + 1
            结束
            # 小数部分：仅当 . 后紧跟数字才吞（否则 1. 按整数+未识别点处理）
            若 p < n 且 源[p] == "." 且 p + 1 < n 且 是数字(源[p + 1])
                浮 = 真
                p = p + 1
                列 = 列 + 1
                当 p < n 且 (是数字(源[p]) 或 源[p] == "_") 循环
                    p = p + 1
                    列 = 列 + 1
                结束
            结束
            # 科学计数法：e/E 后可跟 +/- 再接至少一位数字才吞（避免 1e 被误判）
            若 p < n 且 (源[p] == "e" 或 源[p] == "E")
                整数 q = p + 1
                若 q < n 且 (源[q] == "+" 或 源[q] == "-")
                    q = q + 1
                结束
                若 q < n 且 是数字(源[q])
                    浮 = 真
                    p = p + 1
                    列 = 列 + 1
                    若 p < n 且 (源[p] == "+" 或 源[p] == "-")
                        p = p + 1
                        列 = 列 + 1
                    结束
                    当 p < n 且 是数字(源[p]) 循环
                        p = p + 1
                        列 = 列 + 1
                    结束
                结束
            结束
            # 词值清洗：去掉数字中的 _ 分隔符，保证 转整数/转浮点 能解析
            字符串 词 = 替换(截取(源, 起, p - 起), "_", "")
            若 浮
                字典 t = {"类型": "浮点", "值": 词, "行": 记行, "列": 记列}
                追加(表, t)
            否则
                校验进制数字(词, 记行, 记列)
                字典 t = {"类型": "整数", "值": 词, "行": 记行, "列": 记列}
                追加(表, t)
            结束
            行有内容 = 1
            继续
        结束

        # ---- 字符串：双引号包裹，转义 \\ \" \n \t \0(及其余未知转义保留原字符) ----
        # 列号口径注意：本分支【按字节】进列（见 字符字节数 的实测依据），
        # 其余分支按字符进列 —— 这是复刻宿主字符串扫描器的既有怪癖。
        若 c == "\""
            整数 记行 = 行
            整数 记列 = 列
            p = p + 1          # 吞掉开引号
            列 = 列 + 1
            字符串 内容 = ""
            当 p < n 且 源[p] != "\"" 循环
                若 源[p] == "\\" 且 p + 1 < n
                    # 转义序列
                    字符串 e = 源[p + 1]
                    若 e == "n"
                        内容 = 内容 + "\n"
                    否则若 e == "t"
                        内容 = 内容 + "\t"
                    否则若 e == "\""
                        内容 = 内容 + "\""
                    否则若 e == "\\"
                        内容 = 内容 + "\\"
                    否则
                        # \0 / \r 等其余转义：保留被转义字符本身（与宿主词法一致）
                        内容 = 内容 + e
                    结束
                    p = p + 2
                    # 反斜杠 1 列，被转义字符按它在【源码里】占的字节数
                    # 实测 输出 "a\甲" - "b" → 第1行,17列（甲 按 3 字节进列）
                    列 = 列 + 1 + 字符字节数(e)
                否则
                    字符串 串字符 = 源[p]
                    内容 = 内容 + 串字符
                    p = p + 1
                    列 = 列 + 字符字节数(串字符)
                结束
            结束
            # 吞掉闭引号（若有）
            若 p < n 且 源[p] == "\""
                p = p + 1
                列 = 列 + 1
            结束
            字典 t = {"类型": "字符串", "值": 内容, "行": 记行, "列": 记列}
            追加(表, t)
            行有内容 = 1
            继续
        结束

        # ---- 运算符：贪婪匹配（长运算符优先：三字符 > 两字符 > 单字符）----
        若 是操作符字符(c)
            整数 记行 = 行
            整数 记列 = 列
            字符串 词 = c
            若 c == "-" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = "->"
                p = p + 2
                列 = 列 + 2
            否则若 c == "*" 且 p + 2 < n 且 源[p + 1] == "*" 且 源[p + 2] == "="
                词 = "**="
                p = p + 3
                列 = 列 + 3
            否则若 c == "*" 且 p + 1 < n 且 源[p + 1] == "*"
                词 = "**"
                p = p + 2
                列 = 列 + 2
            否则若 c == "/" 且 p + 2 < n 且 源[p + 1] == "/" 且 源[p + 2] == "="
                词 = "//="
                p = p + 3
                列 = 列 + 3
            否则若 c == "/" 且 p + 1 < n 且 源[p + 1] == "/"
                词 = "//"
                p = p + 2
                列 = 列 + 2
            否则若 c == "<" 且 p + 2 < n 且 源[p + 1] == "<" 且 源[p + 2] == "="
                词 = "<<="
                p = p + 3
                列 = 列 + 3
            否则若 c == ">" 且 p + 2 < n 且 源[p + 1] == ">" 且 源[p + 2] == "="
                词 = ">>="
                p = p + 3
                列 = 列 + 3
            否则若 c == "<" 且 p + 1 < n 且 源[p + 1] == "<"
                词 = "<<"
                p = p + 2
                列 = 列 + 2
            否则若 c == ">" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = ">>"
                p = p + 2
                列 = 列 + 2
            否则若 c == "=" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "=="
                p = p + 2
                列 = 列 + 2
            否则若 c == "!" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "!="
                p = p + 2
                列 = 列 + 2
            否则若 c == "<" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "<="
                p = p + 2
                列 = 列 + 2
            否则若 c == ">" 且 p + 1 < n 且 源[p + 1] == "="
                词 = ">="
                p = p + 2
                列 = 列 + 2
            否则若 c == "+" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "+="
                p = p + 2
                列 = 列 + 2
            否则若 c == "-" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "-="
                p = p + 2
                列 = 列 + 2
            否则若 c == "*" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "*="
                p = p + 2
                列 = 列 + 2
            否则若 c == "/" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "/="
                p = p + 2
                列 = 列 + 2
            否则若 c == "%" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "%="
                p = p + 2
                列 = 列 + 2
            否则若 c == "&" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "&="
                p = p + 2
                列 = 列 + 2
            否则若 c == "|" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "|="
                p = p + 2
                列 = 列 + 2
            否则若 c == "^" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "^="
                p = p + 2
                列 = 列 + 2
            否则若 c == "+" 且 p + 1 < n 且 源[p + 1] == "+"
                词 = "++"
                p = p + 2
                列 = 列 + 2
            否则若 c == "-" 且 p + 1 < n 且 源[p + 1] == "-"
                词 = "--"
                p = p + 2
                列 = 列 + 2
            否则若 c == "=" 且 p + 1 < n 且 源[p + 1] == ">"
                # 箭头函数：函数 f() => 表达式
                词 = "=>"
                p = p + 2
                列 = 列 + 2
            否则若 c == "." 且 p + 2 < n 且 源[p + 1] == "." 且 源[p + 2] == "."
                # 可变参数前缀 ...（必须在单字符 "." 分支之前贪婪匹配）
                词 = "..."
                p = p + 3
                列 = 列 + 3
            否则
                p = p + 1
                列 = 列 + 1
            结束
            字典 t = {"类型": "运算符", "值": 词, "行": 记行, "列": 记列}
            追加(表, t)
            行有内容 = 1
            继续
        结束

        # ---- 标识符 / 关键字：中文字符、字母、下划线开头，后续可含数字 ----
        整数 记行 = 行
        整数 记列 = 列
        整数 起 = p
        当 p < n 循环
            字符串 cc = 源[p]
            # 遇到空白/换行/注释起始/字符串起始/运算符字符即终止
            若 cc == " " 或 cc == "\t" 或 cc == "\r" 或 cc == "\n"
                跳出
            结束
            若 cc == "#" 或 cc == "\""
                跳出
            结束
            若 是操作符字符(cc)
                跳出
            结束
            p = p + 1
            列 = 列 + 1
        结束
        字符串 词 = 截取(源, 起, p - 起)
        # 中文位运算别名 → 映射为符号运算符 token
        若 词 == "按位与" 则
            追加(表, {"类型": "运算符", "值": "&", "行": 记行, "列": 记列})
        否则若 词 == "按位或" 则
            追加(表, {"类型": "运算符", "值": "|", "行": 记行, "列": 记列})
        否则若 词 == "按位异或" 则
            追加(表, {"类型": "运算符", "值": "^", "行": 记行, "列": 记列})
        否则若 词 == "按位取反" 则
            追加(表, {"类型": "运算符", "值": "~", "行": 记行, "列": 记列})
        否则若 词 == "左移" 则
            追加(表, {"类型": "运算符", "值": "<<", "行": 记行, "列": 记列})
        否则若 词 == "右移" 则
            追加(表, {"类型": "运算符", "值": ">>", "行": 记行, "列": 记列})
        否则若 是关键字(词)
            字典 t = {"类型": "关键字", "值": 词, "行": 记行, "列": 记列}
            追加(表, t)
        否则
            字典 t = {"类型": "标识符", "值": 词, "行": 记行, "列": 记列}
            追加(表, t)
        结束
        行有内容 = 1
    结束

    # ---- 文件结束标记（最后一个 token）----
    追加(表, {"类型": "文件结束", "值": "", "行": 行, "列": 列})
    返回 表
结束
