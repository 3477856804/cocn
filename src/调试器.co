# ============================================================
# 调试器.co —— coCN 源码级调试器
#
# 设计说明：
#   不修改求值器（其他模块独占）。由于自托管运行时无法重新导入
#   词法/语法分析器（其源码含「否则若」语法，自托管词法分析器
#   不把「否则若」识别为关键字），本调试器在内部自带一个精简的
#   词法分析器与递归下降语法分析器，直接产出标准 AST；并在每条
#   语句节点上标注起始行号（节点["行"]），以便按物理源码行设断点。
#
#   执行端是一个带「调试钩子」的树遍历执行器：每执行一条语句前
#   调用 调试钩子()，检查断点/单步，命中则进入交互调试循环。
#
# 公开接口：
#   调试运行(路径)                  —— 交互模式调试运行目标 .co 文件
#   调试运行_脚本(路径, 断言行列表, 命令列表) —— 非交互脚本模式（便于自动化测试）
#   设置断点(行号)
#   清除断点(行号)
#   查看变量(名字)
#   查看所有变量()
#   查看栈()
#   退出调试()
# ============================================================

# ---------------- 调试器全局状态 ----------------
# 空值哨兵（用户级环境拿不到宿主原始 空，用唯一字典充当）
让 g_空 = {"__空标记__": 1}

让 g_断点集合 = {}        # 键为字符串行号，值为 1 表示有效断点
让 g_单步 = 0             # 1=执行完当前语句后下一条暂停
让 g_当前环境 = g_空        # 暂停时的栈顶环境（供变量查看）
让 g_调用栈 = []          # 调用栈：[{"函数":名}]
让 g_源码 = ""            # 目标源码全文
让 g_源码行 = []          # 目标源码按行切分
让 g_退出 = 0             # 1=用户请求退出调试
让 g_脚本模式 = 0         # 1=非交互（命令由脚本提供，不读 stdin）
让 g_命令脚本 = []        # 脚本命令列表
让 g_脚本指针 = 0         # 已消费到的脚本命令下标

# ============================================================
# 第一部分：迷你词法分析器（自包含）
# ============================================================

# 是否数字字符
函数 _是数字(字符串 c) -> 整数
    如果 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 则 返回 1 结束
    如果 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9" 则 返回 1 结束
    返回 0
结束

# 是否运算符首字符
函数 _是运算符字符(字符串 c) -> 整数
    如果 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 则 返回 1 结束
    如果 c == "=" 或 c == "!" 或 c == "<" 或 c == ">" 则 返回 1 结束
    如果 c == "(" 或 c == ")" 或 c == "[" 或 c == "]" 则 返回 1 结束
    如果 c == "{" 或 c == "}" 或 c == "," 或 c == ":" 则 返回 1 结束
    返回 0
结束

# 是否关键字
函数 _是关键字(字符串 词) -> 整数
    如果 词 == "让" 或 词 == "如果" 或 词 == "否则" 或 词 == "若" 则 返回 1 结束
    如果 词 == "当" 或 词 == "循环" 或 词 == "对于" 或 词 == "从" 则 返回 1 结束
    如果 词 == "到" 或 词 == "步长" 或 词 == "结束" 或 词 == "返回" 则 返回 1 结束
    如果 词 == "函数" 或 词 == "跳出" 或 词 == "继续" 或 词 == "真" 则 返回 1 结束
    如果 词 == "假" 或 词 == "且" 或 词 == "或" 或 词 == "非" 则 返回 1 结束
    如果 词 == "则" 或 词 == "那么" 或 词 == "在" 或 词 == "于" 则 返回 1 结束
    返回 0
结束

# 把源码切为 token 列表：{"类型","值","行"}
函数 迷你词法(字符串 源) -> 列表
    列表 表 = []
    整数 n = 长度(源)
    整数 p = 0
    整数 行 = 1
    整数 行有内容 = 0

    当 p < n 循环
        字符串 c = 源[p]

        # 空白
        如果 c == " " 或 c == "\t" 或 c == "\r" 则
            p = p + 1
            继续
        结束
        # 注释
        如果 c == "#" 则
            当 p < n 且 源[p] != "\n" 循环
                p = p + 1
            结束
            继续
        结束
        # 换行
        如果 c == "\n" 则
            如果 行有内容 == 1 则
                追加(表, {"类型": "换行", "值": "\n", "行": 行})
            结束
            行 = 行 + 1
            p = p + 1
            行有内容 = 0
            继续
        结束

        # 数字
        如果 _是数字(c) == 1 则
            整数 记行 = 行
            整数 起 = p
            整数 有小数 = 0
            当 p < n 且 _是数字(源[p]) == 1 循环
                p = p + 1
            结束
            如果 p < n 且 源[p] == "." 且 p + 1 < n 且 _是数字(源[p + 1]) == 1 则
                有小数 = 1
                p = p + 1
                当 p < n 且 _是数字(源[p]) == 1 循环
                    p = p + 1
                结束
            结束
            字符串 词 = 截取(源, 起, p - 起)
            如果 有小数 == 1 则
                追加(表, {"类型": "浮点", "值": 词, "行": 记行})
            否则
                追加(表, {"类型": "整数", "值": 词, "行": 记行})
            结束
            行有内容 = 1
            继续
        结束

        # 字符串
        如果 c == "\"" 则
            整数 记行 = 行
            p = p + 1
            字符串 内容 = ""
            当 p < n 且 源[p] != "\"" 循环
                如果 源[p] == "\\" 且 p + 1 < n 则
                    字符串 e = 源[p + 1]
                    如果 e == "n" 则
                        内容 = 内容 + "\n"
                    否则
                        内容 = 内容 + e
                    结束
                    p = p + 2
                否则
                    内容 = 内容 + 源[p]
                    p = p + 1
                结束
            结束
            如果 p < n 且 源[p] == "\"" 则
                p = p + 1
            结束
            追加(表, {"类型": "字符串", "值": 内容, "行": 记行})
            行有内容 = 1
            继续
        结束

        # 运算符
        如果 _是运算符字符(c) == 1 则
            整数 记行 = 行
            字符串 词 = c
            如果 c == "=" 且 p + 1 < n 且 源[p + 1] == "=" 则
                词 = "=="
                p = p + 2
            否则
                如果 c == "!" 且 p + 1 < n 且 源[p + 1] == "=" 则
                    词 = "!="
                    p = p + 2
                否则
                    如果 c == "<" 且 p + 1 < n 且 源[p + 1] == "=" 则
                        词 = "<="
                        p = p + 2
                    否则
                        如果 c == ">" 且 p + 1 < n 且 源[p + 1] == "=" 则
                            词 = ">="
                            p = p + 2
                        否则
                            如果 c == "<" 且 p + 1 < n 且 源[p + 1] == "<" 则
                                词 = "<<"
                                p = p + 2
                            否则
                                如果 c == ">" 且 p + 1 < n 且 源[p + 1] == ">" 则
                                    词 = ">>"
                                    p = p + 2
                                否则
                                    如果 c == "/" 且 p + 1 < n 且 源[p + 1] == "/" 则
                                        词 = "//"
                                        p = p + 2
                                    否则
                                        如果 c == "*" 且 p + 1 < n 且 源[p + 1] == "*" 则
                                            词 = "**"
                                            p = p + 2
                                        否则
                                            p = p + 1
                                        结束
                                    结束
                                结束
                            结束
                        结束
                    结束
                结束
            结束
            追加(表, {"类型": "运算符", "值": 词, "行": 记行})
            行有内容 = 1
            继续
        结束

        # 标识符 / 关键字
        整数 记行 = 行
        整数 起 = p
        当 p < n 循环
            字符串 cc = 源[p]
            如果 cc == " " 或 cc == "\t" 或 cc == "\r" 或 cc == "\n" 则
                跳出
            结束
            如果 cc == "#" 或 cc == "\"" 则
                跳出
            结束
            如果 _是运算符字符(cc) == 1 则
                跳出
            结束
            p = p + 1
        结束
        字符串 词 = 截取(源, 起, p - 起)
        如果 _是关键字(词) == 1 则
            追加(表, {"类型": "关键字", "值": 词, "行": 记行})
        否则
            追加(表, {"类型": "标识符", "值": 词, "行": 记行})
        结束
        行有内容 = 1
    结束

    追加(表, {"类型": "文件结束", "值": "", "行": 行})
    返回 表
结束

# ============================================================
# 第二部分：迷你递归下降语法分析器
# ============================================================

让 p_tokens = []
让 p_pos = 0

函数 _p类型() -> 字符串
    如果 p_pos >= 长度(p_tokens) 则
        返回 "文件结束"
    结束
    返回 p_tokens[p_pos]["类型"]
结束

函数 _p值() -> 字符串
    如果 p_pos >= 长度(p_tokens) 则
        返回 ""
    结束
    返回 p_tokens[p_pos]["值"]
结束

函数 _p行() -> 整数
    如果 p_pos >= 长度(p_tokens) 则
        返回 0
    结束
    返回 p_tokens[p_pos]["行"]
结束

函数 _p前进()
    p_pos = p_pos + 1
结束

函数 _p报错(字符串 消息)
    输出错误("调试器解析错误 (第" + 转字符串(_p行()) + "行): " + 消息)
    断言(假, "调试器解析失败")
结束

# 跳过连续换行
函数 _p跳换行()
    当 _p类型() == "换行" 循环
        _p前进()
    结束
结束

# 期望某运算符
函数 _p期望运算符(字符串 期望)
    如果 _p类型() != "运算符" 或 _p值() != 期望 则
        _p报错("期望运算符 '" + 期望 + "'，得到 '" + _p值() + "'")
    结束
    _p前进()
结束

# 期望某关键字
函数 _p期望关键字(字符串 期望)
    如果 _p类型() != "关键字" 或 _p值() != 期望 则
        _p报错("期望关键字 '" + 期望 + "'，得到 '" + _p值() + "'")
    结束
    _p前进()
结束

# ---- 表达式层 ----

# 字面量 / 标识符 / 括号 / 列表 / 字典
函数 _p主要() -> 字典
    让 t = _p类型()
    如果 t == "整数" 则
        字典 n = {"类型": "字面量", "值": _p值(), "字面类型": "整数"}
        _p前进()
        返回 n
    结束
    如果 t == "浮点" 则
        字典 n = {"类型": "字面量", "值": _p值(), "字面类型": "浮点"}
        _p前进()
        返回 n
    结束
    如果 t == "字符串" 则
        字典 n = {"类型": "字面量", "值": _p值(), "字面类型": "字符串"}
        _p前进()
        返回 n
    结束
    如果 t == "关键字" 且 _p值() == "真" 则
        _p前进()
        返回 {"类型": "字面量", "值": "1", "字面类型": "布尔"}
    结束
    如果 t == "关键字" 且 _p值() == "假" 则
        _p前进()
        返回 {"类型": "字面量", "值": "0", "字面类型": "布尔"}
    结束
    如果 t == "标识符" 则
        字典 n = {"类型": "标识符", "名字": _p值()}
        _p前进()
        返回 n
    结束
    如果 t == "运算符" 且 _p值() == "(" 则
        _p前进()
        字典 e = _p或()
        _p期望运算符(")")
        返回 e
    结束
    如果 t == "运算符" 且 _p值() == "[" 则
        返回 _p列表()
    结束
    如果 t == "运算符" 且 _p值() == "{" 则
        返回 _p字典()
    结束
    _p报错("意外的表达式记号 '" + _p值() + "'")
    返回 {"类型": "字面量", "值": "0", "字面类型": "整数"}
结束

# 列表字面量 [a, b, c]
函数 _p列表() -> 字典
    _p前进()  # [
    列表 元素 = []
    如果 _p类型() == "运算符" 且 _p值() == "]" 则
        _p前进()
        返回 {"类型": "列表字面量", "元素": 元素}
    结束
    追加(元素, _p或())
    当 _p类型() == "运算符" 且 _p值() == "," 循环
        _p前进()
        如果 _p类型() == "运算符" 且 _p值() == "]" 则
            跳出
        结束
        追加(元素, _p或())
    结束
    _p期望运算符("]")
    返回 {"类型": "列表字面量", "元素": 元素}
结束

# 字典字面量 {"k": v, ...}
函数 _p字典() -> 字典
    _p前进()  # {
    列表 键s = []
    列表 值s = []
    如果 _p类型() == "运算符" 且 _p值() == "}" 则
        _p前进()
        返回 {"类型": "字典字面量", "键": 键s, "值": 值s}
    结束
    当 _p类型() != "文件结束" 循环
        如果 _p类型() == "运算符" 且 _p值() == "}" 则
            跳出
        结束
        让 k = _p或()
        # 裸标识符键退化为字符串字面量
        如果 k["类型"] == "标识符" 则
            k = {"类型": "字面量", "值": k["名字"], "字面类型": "字符串"}
        结束
        _p期望运算符(":")
        让 v = _p或()
        追加(键s, k)
        追加(值s, v)
        如果 _p类型() == "运算符" 且 _p值() == "," 则
            _p前进()
        结束
    结束
    _p期望运算符("}")
    返回 {"类型": "字典字面量", "键": 键s, "值": 值s}
结束

# 后缀：调用 f(...) / 下标 [...]
函数 _p后缀() -> 字典
    字典 n = _p主要()
    整数 变 = 1
    当 变 == 1 循环
        整数 消费 = 0
        如果 _p类型() == "运算符" 且 _p值() == "(" 则
            消费 = 1
            _p前进()
            列表 参数 = []
            如果 非 (_p类型() == "运算符" 且 _p值() == ")") 则
                当 1 循环
                    追加(参数, _p或())
                    如果 _p类型() == "运算符" 且 _p值() == "," 则
                        _p前进()
                        继续
                    结束
                    跳出
                结束
            结束
            _p期望运算符(")")
            n = {"类型": "函数调用", "被调者": n, "参数": 参数}
        结束
        如果 _p类型() == "运算符" 且 _p值() == "[" 则
            消费 = 1
            _p前进()
            字典 idx = _p或()
            _p期望运算符("]")
            n = {"类型": "下标", "容器": n, "索引": idx}
        结束
        # 裸调用：输出 x / 输出 "你好"（仅当被调者是标识符且后续是值起始）
        如果 消费 == 0 且 n["类型"] == "标识符" 则
            让 tt = _p类型()
            让 vv = _p值()
            整数 裸参 = 0
            如果 tt == "整数" 或 tt == "浮点" 或 tt == "字符串" 则
                裸参 = 1
            结束
            如果 tt == "标识符" 则
                裸参 = 1
            结束
            如果 tt == "关键字" 且 (vv == "真" 或 vv == "假") 则
                裸参 = 1
            结束
            如果 裸参 == 1 则
                消费 = 1
                列表 参数 = [_p或()]
                n = {"类型": "函数调用", "被调者": n, "参数": 参数}
            结束
        结束
        如果 消费 == 0 则
            变 = 0
        结束
    结束
    返回 n
结束

# 一元：非 / 负号
函数 _p一元() -> 字典
    如果 _p类型() == "运算符" 且 (_p值() == "-" 或 _p值() == "+") 则
        字符串 op = _p值()
        _p前进()
        返回 {"类型": "一元", "运算符": op, "操作数": _p一元()}
    结束
    如果 _p类型() == "关键字" 且 _p值() == "非" 则
        _p前进()
        返回 {"类型": "一元", "运算符": "非", "操作数": _p一元()}
    结束
    返回 _p后缀()
结束

# 乘除模
函数 _p乘除() -> 字典
    字典 左 = _p一元()
    当 _p类型() == "运算符" 且 (_p值() == "*" 或 _p值() == "/" 或 _p值() == "%" 或 _p值() == "//" 或 _p值() == "**") 循环
        字符串 op = _p值()
        _p前进()
        字典 右 = _p一元()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 右}
    结束
    返回 左
结束

# 加减
函数 _p加减() -> 字典
    字典 左 = _p乘除()
    当 _p类型() == "运算符" 且 (_p值() == "+" 或 _p值() == "-") 循环
        字符串 op = _p值()
        _p前进()
        字典 右 = _p乘除()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 右}
    结束
    返回 左
结束

# 关系比较
函数 _p关系() -> 字典
    字典 左 = _p加减()
    当 _p类型() == "运算符" 且 (_p值() == "<" 或 _p值() == ">" 或 _p值() == "<=" 或 _p值() == ">=") 循环
        字符串 op = _p值()
        _p前进()
        字典 右 = _p加减()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 右}
    结束
    返回 左
结束

# 相等
函数 _p相等() -> 字典
    字典 左 = _p关系()
    当 _p类型() == "运算符" 且 (_p值() == "==" 或 _p值() == "!=") 循环
        字符串 op = _p值()
        _p前进()
        字典 右 = _p关系()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 右}
    结束
    返回 左
结束

# 且
函数 _p且() -> 字典
    字典 左 = _p相等()
    当 _p类型() == "关键字" 且 _p值() == "且" 循环
        _p前进()
        字典 右 = _p且()
        左 = {"类型": "二元", "运算符": "且", "左": 左, "右": 右}
    结束
    返回 左
结束

# 或
函数 _p或() -> 字典
    字典 左 = _p且()
    当 _p类型() == "关键字" 且 _p值() == "或" 循环
        _p前进()
        字典 右 = _p或()
        左 = {"类型": "二元", "运算符": "或", "左": 左, "右": 右}
    结束
    返回 左
结束

# ---- 语句层 ----

# 解析一个块体（直到 结束 / 否则 / 文件结束）
函数 _p块体() -> 列表
    列表 体 = []
    当 _p类型() != "文件结束" 循环
        如果 _p类型() == "换行" 则
            _p前进()
            继续
        结束
        如果 _p类型() == "关键字" 且 (_p值() == "结束" 或 _p值() == "否则") 则
            跳出
        结束
        让 st = _p语句()
        如果 st != g_空 则
            追加(体, st)
        结束
    结束
    返回 体
结束

# 单条语句
函数 _p语句()
    让 行 = _p行()

    如果 _p类型() == "换行" 则
        _p前进()
        返回 g_空
    结束

    # 变量声明：让 x [= expr]
    如果 _p类型() == "关键字" 且 _p值() == "让" 则
        _p前进()
        如果 _p类型() != "标识符" 则
            _p报错("变量声明需要标识符")
        结束
        字符串 名 = _p值()
        _p前进()
        让 初始化 = g_空
        如果 _p类型() == "运算符" 且 _p值() == "=" 则
            _p前进()
            初始化 = _p或()
        结束
        返回 {"类型": "变量声明", "名字": 名, "初始化": 初始化, "行": 行}
    结束

    # 返回
    如果 _p类型() == "关键字" 且 _p值() == "返回" 则
        _p前进()
        让 v = g_空
        如果 _p类型() != "换行" 且 _p类型() != "文件结束" 且 非 (_p类型() == "关键字" 且 (_p值() == "结束" 或 _p值() == "否则")) 则
            v = _p或()
        结束
        返回 {"类型": "返回", "值": v, "行": 行}
    结束

    # 跳出 / 继续
    如果 _p类型() == "关键字" 且 _p值() == "跳出" 则
        _p前进()
        返回 {"类型": "跳出", "行": 行}
    结束
    如果 _p类型() == "关键字" 且 _p值() == "继续" 则
        _p前进()
        返回 {"类型": "继续", "行": 行}
    结束

    # 如果 / 若
    如果 _p类型() == "关键字" 且 (_p值() == "如果" 或 _p值() == "若") 则
        _p前进()
        字典 条件 = _p或()
        如果 _p类型() == "关键字" 且 (_p值() == "则" 或 _p值() == "那么") 则
            _p前进()
        结束
        列表 则体 = _p块体()
        列表 否则链 = []
        当 _p类型() == "关键字" 且 _p值() == "否则" 循环
            _p前进()
            # 否则 若 / 否则 如果 形式
            让 分支条件 = g_空
            如果 _p类型() == "关键字" 且 (_p值() == "若" 或 _p值() == "如果") 则
                _p前进()
                分支条件 = _p或()
            结束
            如果 _p类型() == "关键字" 且 (_p值() == "则" 或 _p值() == "那么") 则
                _p前进()
            结束
            列表 分支体 = _p块体()
            追加(否则链, {"条件": 分支条件, "体": 分支体})
        结束
        如果 _p类型() == "关键字" 且 _p值() == "结束" 则
            _p前进()
        结束
        返回 {"类型": "如果", "条件": 条件, "则体": 则体, "否则链": 否则链, "行": 行}
    结束

    # 当 条件 循环 ... 结束
    如果 _p类型() == "关键字" 且 _p值() == "当" 则
        _p前进()
        字典 条件 = _p或()
        _p期望关键字("循环")
        列表 体 = _p块体()
        如果 _p类型() == "关键字" 且 _p值() == "结束" 则
            _p前进()
        结束
        返回 {"类型": "当", "条件": 条件, "体": 体, "行": 行}
    结束

    # 对于 变量 从 a 到 b [步长 s] 循环 ... 结束
    如果 _p类型() == "关键字" 且 _p值() == "对于" 则
        _p前进()
        如果 _p类型() != "标识符" 则
            _p报错("对于 循环需要变量名")
        结束
        字符串 变量名 = _p值()
        _p前进()
        字典 起点 = g_空
        字典 终点 = g_空
        如果 _p类型() == "关键字" 且 (_p值() == "在" 或 _p值() == "于") 则
            _p前进()
            字典 容器 = _p或()
            _p期望关键字("循环")
            列表 体 = _p块体()
            如果 _p类型() == "关键字" 且 _p值() == "结束" 则
                _p前进()
            结束
            返回 {"类型": "对于", "变量": 变量名, "遍历源": 容器, "体": 体, "是否遍历": 1, "行": 行}
        结束
        _p期望关键字("从")
        起点 = _p或()
        _p期望关键字("到")
        终点 = _p或()
        _p期望关键字("循环")
        列表 体 = _p块体()
        如果 _p类型() == "关键字" 且 _p值() == "结束" 则
            _p前进()
        结束
        返回 {"类型": "对于", "变量": 变量名, "起点": 起点, "终点": 终点, "体": 体, "行": 行}
    结束

    # 函数 名(参数) ... 结束
    如果 _p类型() == "关键字" 且 _p值() == "函数" 则
        _p前进()
        如果 _p类型() != "标识符" 则
            _p报错("函数定义需要名字")
        结束
        字符串 名 = _p值()
        _p前进()
        _p期望运算符("(")
        列表 参数 = []
        如果 非 (_p类型() == "运算符" 且 _p值() == ")") 则
            当 非 (_p类型() == "运算符" 且 _p值() == ")") 且 _p类型() != "文件结束" 循环
                如果 _p类型() != "标识符" 则
                    _p报错("函数参数需要标识符")
                结束
                追加(参数, _p值())
                _p前进()
                如果 _p类型() == "运算符" 且 _p值() == "=" 则
                    _p前进()
                    _p或()
                结束
                如果 _p类型() == "运算符" 且 _p值() == "," 则
                    _p前进()
                结束
            结束
        结束
        _p期望运算符(")")
        # 跳过可选返回类型 -> 整数 等
        如果 _p类型() == "运算符" 且 _p值() == "->" 则
            _p前进()
            _p前进()
        结束
        列表 体语句 = _p块体()
        如果 _p类型() == "关键字" 且 _p值() == "结束" 则
            _p前进()
        结束
        字典 体 = {"类型": "程序", "语句": 体语句}
        返回 {"类型": "函数定义", "名字": 名, "参数": 参数, "体": 体, "行": 行}
    结束

    # 表达式语句 / 赋值
    字典 左 = _p或()
    如果 _p类型() == "运算符" 且 _p值() == "=" 则
        _p前进()
        字典 v = _p或()
        返回 {"类型": "赋值", "目标": 左, "值": v, "行": 行}
    结束
    返回 {"类型": "表达式语句", "表达式": 左, "行": 行}
结束

# 解析整个源
函数 迷你解析(字符串 源) -> 字典
    p_tokens = 迷你词法(源)
    p_pos = 0
    列表 语句表 = []
    _p跳换行()
    当 _p类型() != "文件结束" 循环
        让 st = _p语句()
        如果 st != g_空 则
            追加(语句表, st)
        结束
        _p跳换行()
    结束
    返回 {"类型": "程序", "语句": 语句表}
结束

# ============================================================
# 第三部分：目标程序环境与信号
# ============================================================

# 创建目标程序的根环境（注册调试器支持的内置函数占位）
函数 新建目标环境() -> 字典
    让 env = {"变量": {}, "父": g_空}
    让 v = env["变量"]
    v["输出"] = {"类型": "内置", "名字": "输出"}
    v["长度"] = {"类型": "内置", "名字": "长度"}
    v["类型"] = {"类型": "内置", "名字": "类型"}
    v["转字符串"] = {"类型": "内置", "名字": "转字符串"}
    v["转整数"] = {"类型": "内置", "名字": "转整数"}
    v["转浮点"] = {"类型": "内置", "名字": "转浮点"}
    v["包含"] = {"类型": "内置", "名字": "包含"}
    v["键"] = {"类型": "内置", "名字": "键"}
    v["追加"] = {"类型": "内置", "名字": "追加"}
    v["截取"] = {"类型": "内置", "名字": "截取"}
    v["输入"] = {"类型": "内置", "名字": "输入"}
    v["读文件"] = {"类型": "内置", "名字": "读文件"}
    v["执行命令"] = {"类型": "内置", "名字": "执行命令"}
    v["断言"] = {"类型": "内置", "名字": "断言"}
    v["空"] = g_空
    返回 env
结束

# 沿父链查找变量；找不到返回 g_空
函数 _查找(env, 名字)
    当 env != g_空 循环
        如果 包含(env["变量"], 名字) 则
            返回 env["变量"][名字]
        结束
        env = env["父"]
    结束
    返回 g_空
结束

# 在当前层声明变量
函数 _声明(env, 名字, 值)
    env["变量"][名字] = 值
结束

# 沿父链赋值；找不到则在当前层新建
函数 _赋值(env, 名字, 值)
    让 底 = env
    当 env != g_空 循环
        如果 包含(env["变量"], 名字) 则
            env["变量"][名字] = 值
            返回
        结束
        env = env["父"]
    结束
    底["变量"][名字] = 值
结束

# 判断是否为字典节点
函数 _是节点(v) -> 整数
    如果 类型(v) == "字典" 则
        返回 1
    结束
    返回 0
结束

函数 _造异常(消息) -> 字典
    返回 {"__异常__": {"消息": 消息}}
结束

函数 _是异常(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__异常__") 则
        返回 1
    结束
    返回 0
结束

函数 _是控制(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__控制__") 则
        返回 1
    结束
    返回 0
结束

函数 _是调试退出(v) -> 整数
    如果 类型(v) != "字典" 则
        返回 0
    结束
    如果 包含(v, "__调试退出__") 则
        返回 1
    结束
    返回 0
结束

# 真值判断
函数 _真值(v) -> 整数
    让 t = 类型(v)
    如果 t == "整数" 或 t == "布尔" 则
        如果 v != 0 则 返回 1 结束
        返回 0
    结束
    如果 t == "浮点" 则
        如果 v != 0.0 则 返回 1 结束
        返回 0
    结束
    如果 t == "字符串" 则
        如果 长度(v) > 0 则 返回 1 结束
        返回 0
    结束
    如果 t == "列表" 或 t == "字典" 则
        如果 长度(v) > 0 则 返回 1 结束
        返回 0
    结束
    返回 0
结束

# ============================================================
# 第四部分：内置函数分发
# ============================================================

函数 _调用内置(名字, 实参)
    如果 名字 == "输出" 则
        让 s = ""
        对于 i 从 0 到 长度(实参) - 1 循环
            如果 i > 0 则
                s = s + " "
            结束
            s = s + 转字符串(实参[i])
        结束
        输出 s
        返回 0
    结束

    如果 名字 == "长度" 则 返回 长度(实参[0])
    如果 名字 == "转字符串" 则 返回 转字符串(实参[0])
    如果 名字 == "转整数" 则 返回 转整数(实参[0])
    如果 名字 == "转浮点" 则 返回 转浮点(实参[0])
    如果 名字 == "包含" 则 返回 包含(实参[0], 实参[1])
    如果 名字 == "键" 则 返回 键(实参[0])
    如果 名字 == "截取" 则 返回 截取(实参[0], 实参[1], 实参[2])

    如果 名字 == "类型" 则
        让 v = 实参[0]
        如果 类型(v) == "字典" 且 包含(v, "类型") 则
            如果 v["类型"] == "函数" 或 v["类型"] == "内置" 则
                返回 "函数"
            结束
        结束
        返回 类型(v)
    结束

    如果 名字 == "追加" 则
        追加(实参[0], 实参[1])
        返回 0
    结束

    如果 名字 == "输入" 则
        如果 长度(实参) > 0 则
            返回 输入(转字符串(实参[0]))
        结束
        返回 输入("")
    结束

    如果 名字 == "读文件" 则
        返回 读取文件(转字符串(实参[0]))
    结束

    如果 名字 == "执行命令" 则
        返回 执行命令(转字符串(实参[0]))
    结束

    如果 名字 == "断言" 则
        如果 _真值(实参[0]) == 0 则
            返回 _造异常("断言失败: " + 转字符串(实参[1]))
        结束
        返回 0
    结束

    返回 _造异常("调试器暂不支持的内置函数: " + 名字)
结束

# ============================================================
# 第五部分：表达式求值
# ============================================================

函数 _调二元(节点, 环境)
    让 op = 节点["运算符"]

    如果 op == "且" 则
        让 l = 调求值(节点["左"], 环境)
        如果 _是异常(l) 则 返回 l 结束
        如果 _真值(l) == 0 则 返回 0 结束
        让 r = 调求值(节点["右"], 环境)
        如果 _是异常(r) 则 返回 r 结束
        返回 _真值(r)
    结束
    如果 op == "或" 则
        让 l = 调求值(节点["左"], 环境)
        如果 _是异常(l) 则 返回 l 结束
        如果 _真值(l) == 1 则 返回 1 结束
        让 r = 调求值(节点["右"], 环境)
        如果 _是异常(r) 则 返回 r 结束
        返回 _真值(r)
    结束

    让 l = 调求值(节点["左"], 环境)
    如果 _是异常(l) 则 返回 l 结束
    让 r = 调求值(节点["右"], 环境)
    如果 _是异常(r) 则 返回 r 结束

    如果 op == "==" 则 返回 l == r
    如果 op == "!=" 则 返回 l != r
    如果 op == "<" 则 返回 l < r
    如果 op == ">" 则 返回 l > r
    如果 op == "<=" 则 返回 l <= r
    如果 op == ">=" 则 返回 l >= r

    如果 类型(l) == "字符串" 或 类型(r) == "字符串" 则
        如果 op == "+" 则
            返回 转字符串(l) + 转字符串(r)
        结束
        返回 _造异常("字符串只支持 + 拼接")
    结束

    如果 op == "+" 且 类型(l) == "列表" 且 类型(r) == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(l) - 1 循环
            追加(结果, l[i])
        结束
        对于 i 从 0 到 长度(r) - 1 循环
            追加(结果, r[i])
        结束
        返回 结果
    结束

    让 lf = 转浮点(l)
    让 rf = 转浮点(r)
    让 得浮点 = (类型(l) == "浮点" 或 类型(r) == "浮点")

    如果 op == "+" 则
        让 x = lf + rf
        如果 得浮点 则 返回 x 结束
        返回 转整数(x)
    结束
    如果 op == "-" 则
        让 x = lf - rf
        如果 得浮点 则 返回 x 结束
        返回 转整数(x)
    结束
    如果 op == "*" 则
        让 x = lf * rf
        如果 得浮点 则 返回 x 结束
        返回 转整数(x)
    结束
    如果 op == "/" 则
        如果 rf == 0.0 则 返回 _造异常("除以零") 结束
        返回 lf / rf
    结束
    如果 op == "//" 则
        如果 rf == 0.0 则 返回 _造异常("整除的除数为零") 结束
        返回 转整数(lf / rf)
    结束
    返回 _造异常("调试器未知运算符: " + op)
结束

函数 _调下标(节点, 环境)
    让 obj = 调求值(节点["容器"], 环境)
    如果 _是异常(obj) 则 返回 obj 结束
    让 idx = 调求值(节点["索引"], 环境)
    如果 _是异常(idx) 则 返回 idx 结束
    让 t = 类型(obj)
    如果 t == "列表" 则
        让 i = 转整数(idx)
        让 n = 长度(obj)
        如果 i < 0 则 i = i + n 结束
        如果 i < 0 或 i >= n 则 返回 _造异常("列表索引越界") 结束
        返回 obj[i]
    结束
    如果 t == "字符串" 则
        返回 obj[转整数(idx)]
    结束
    如果 t == "字典" 则
        让 kk = 转字符串(idx)
        如果 包含(obj, kk) 则
            返回 obj[kk]
        结束
        返回 0
    结束
    返回 _造异常("不支持下标索引的类型")
结束

函数 调求值(节点, 环境)
    如果 _是节点(节点) == 0 则
        返回 节点
    结束
    让 k = 节点["类型"]

    如果 k == "字面量" 则
        让 lt = 节点["字面类型"]
        让 raw = 节点["值"]
        如果 lt == "整数" 则 返回 转整数(raw) 结束
        如果 lt == "浮点" 则 返回 转浮点(raw) 结束
        如果 lt == "字符串" 则 返回 raw 结束
        如果 lt == "布尔" 则
            如果 raw == "1" 则 返回 1 结束
            返回 0
        结束
        返回 0
    结束

    如果 k == "标识符" 则
        让 v = _查找(环境, 节点["名字"])
        如果 v == g_空 则
            返回 _造异常("未定义变量: " + 节点["名字"])
        结束
        返回 v
    结束

    如果 k == "二元" 则
        返回 _调二元(节点, 环境)
    结束

    如果 k == "一元" 则
        让 v = 调求值(节点["操作数"], 环境)
        如果 _是异常(v) 则 返回 v 结束
        如果 节点["运算符"] == "非" 则
            返回 1 - _真值(v)
        结束
        如果 节点["运算符"] == "-" 则
            返回 -v
        结束
        返回 v
    结束

    如果 k == "下标" 则
        返回 _调下标(节点, 环境)
    结束

    如果 k == "列表字面量" 则
        让 元素 = 节点["元素"]
        让 结果 = []
        对于 i 从 0 到 长度(元素) - 1 循环
            让 v = 调求值(元素[i], 环境)
            如果 _是异常(v) 则 返回 v 结束
            追加(结果, v)
        结束
        返回 结果
    结束

    如果 k == "字典字面量" 则
        让 键s = 节点["键"]
        让 值s = 节点["值"]
        让 d = {}
        对于 i 从 0 到 长度(键s) - 1 循环
            让 kk = 调求值(键s[i], 环境)
            如果 _是异常(kk) 则 返回 kk 结束
            让 vv = 调求值(值s[i], 环境)
            如果 _是异常(vv) 则 返回 vv 结束
            d[转字符串(kk)] = vv
        结束
        返回 d
    结束

    如果 k == "函数字面量" 则
        返回 {"类型": "函数", "名字": 节点["名字"], "参数": 节点["参数"], "体": 节点["体"], "闭包": 环境}
    结束

    如果 k == "函数调用" 则
        让 被调 = 调求值(节点["被调者"], 环境)
        如果 _是异常(被调) 则 返回 被调 结束
        让 实参节点 = 节点["参数"]
        让 实参 = []
        对于 i 从 0 到 长度(实参节点) - 1 循环
            让 a = 调求值(实参节点[i], 环境)
            如果 _是异常(a) 则 返回 a 结束
            追加(实参, a)
        结束
        # 注意：coCN 中函数/内置对象的 类型() 返回 "函数"，不是 "字典"，
        # 故不能用 类型(被调)=="字典" 判断；直接查 "类型" 键。
        如果 包含(被调, "类型") 则
            如果 被调["类型"] == "函数" 则
                返回 _调用户函数(被调, 实参)
            结束
            如果 被调["类型"] == "内置" 则
                返回 _调用内置(被调["名字"], 实参)
            结束
        结束
        返回 _造异常("值不是一个函数")
    结束

    返回 _造异常("调试器无法求值节点: " + k)
结束

函数 _调用户函数(fn, 实参)
    让 子 = {"变量": {}, "父": fn["闭包"]}
    让 形参 = fn["参数"]
    让 n形参 = 长度(形参)
    让 n实参 = 长度(实参)
    对于 i 从 0 到 n形参 - 1 循环
        如果 i < n实参 则
            子["变量"][形参[i]] = 实参[i]
        否则
            子["变量"][形参[i]] = 0
        结束
    结束
    追加(g_调用栈, {"函数": fn["名字"]})
    让 结果 = 调执行块(fn["体"]["语句"], 子)
    如果 长度(g_调用栈) > 0 则
        弹出(g_调用栈)
    结束
    如果 _是异常(结果) 则 返回 结果 结束
    如果 _是调试退出(结果) 则 返回 结果 结束
    如果 _是控制(结果) 则
        如果 结果["__控制__"] == "返回" 则
            返回 结果["值"]
        结束
    结束
    返回 0
结束

# ============================================================
# 第六部分：语句执行（带调试钩子）
# ============================================================

函数 _执行赋值(目标, 值, 环境)
    如果 目标["类型"] == "标识符" 则
        _赋值(环境, 目标["名字"], 值)
        返回 0
    结束
    如果 目标["类型"] == "下标" 则
        让 obj = 调求值(目标["容器"], 环境)
        如果 _是异常(obj) 则 返回 obj 结束
        让 idx = 调求值(目标["索引"], 环境)
        如果 _是异常(idx) 则 返回 idx 结束
        如果 类型(obj) == "列表" 则
            obj[转整数(idx)] = 值
            返回 0
        结束
        如果 类型(obj) == "字典" 则
            obj[转字符串(idx)] = 值
            返回 0
        结束
        返回 _造异常("只能对列表或字典下标赋值")
    结束
    返回 _造异常("无效的赋值目标")
结束

函数 调执行语句(语句, 环境)
    让 k = 语句["类型"]

    如果 k == "变量声明" 则
        让 v = 0
        如果 _是节点(语句["初始化"]) 则
            v = 调求值(语句["初始化"], 环境)
            如果 _是异常(v) 则 返回 v 结束
        结束
        _声明(环境, 语句["名字"], v)
        返回 0
    结束

    如果 k == "赋值" 则
        让 v = 调求值(语句["值"], 环境)
        如果 _是异常(v) 则 返回 v 结束
        返回 _执行赋值(语句["目标"], v, 环境)
    结束

    如果 k == "函数定义" 则
        让 fn = {"类型": "函数", "名字": 语句["名字"], "参数": 语句["参数"], "体": 语句["体"], "闭包": 环境}
        _声明(环境, 语句["名字"], fn)
        返回 0
    结束

    如果 k == "返回" 则
        让 v = 0
        如果 _是节点(语句["值"]) 则
            v = 调求值(语句["值"], 环境)
            如果 _是异常(v) 则 返回 v 结束
        结束
        返回 {"__控制__": "返回", "值": v}
    结束

    如果 k == "跳出" 则 返回 {"__控制__": "跳出"}
    如果 k == "继续" 则 返回 {"__控制__": "继续"}

    如果 k == "如果" 则
        让 c = 调求值(语句["条件"], 环境)
        如果 _是异常(c) 则 返回 c 结束
        如果 _真值(c) == 1 则
            返回 调执行块(语句["则体"], 环境)
        结束
        让 链 = 语句["否则链"]
        对于 i 从 0 到 长度(链) - 1 循环
            让 br = 链[i]
            如果 _是节点(br["条件"]) 则
                让 bc = 调求值(br["条件"], 环境)
                如果 _是异常(bc) 则 返回 bc 结束
                如果 _真值(bc) == 1 则
                    返回 调执行块(br["体"], 环境)
                结束
            否则
                返回 调执行块(br["体"], 环境)
            结束
        结束
        返回 0
    结束

    如果 k == "当" 则
        当 1 循环
            让 c = 调求值(语句["条件"], 环境)
            如果 _是异常(c) 则 返回 c 结束
            如果 _真值(c) == 0 则 返回 0 结束
            让 r = 调执行块(语句["体"], 环境)
            如果 _是异常(r) 则 返回 r 结束
            如果 _是调试退出(r) 则 返回 r 结束
            如果 _是控制(r) 则
                如果 r["__控制__"] == "返回" 则 返回 r 结束
                如果 r["__控制__"] == "跳出" 则 返回 0 结束
            结束
        结束
        返回 0
    结束

    如果 k == "对于" 则
        # for-each 形式
        如果 包含(语句, "是否遍历") 且 语句["是否遍历"] == 1 则
            让 源值 = 调求值(语句["遍历源"], 环境)
            如果 _是异常(源值) 则 返回 源值 结束
            让 n = 长度(源值)
            对于 i 从 0 到 n - 1 循环
                _声明(环境, 语句["变量"], 源值[i])
                让 r = 调执行块(语句["体"], 环境)
                如果 _是异常(r) 则 返回 r 结束
                如果 _是调试退出(r) 则 返回 r 结束
                如果 _是控制(r) 则
                    如果 r["__控制__"] == "返回" 则 返回 r 结束
                    如果 r["__控制__"] == "跳出" 则 返回 0 结束
                结束
            结束
            返回 0
        结束
        # 范围形式
        让 sv = 调求值(语句["起点"], 环境)
        如果 _是异常(sv) 则 返回 sv 结束
        让 ev = 调求值(语句["终点"], 环境)
        如果 _是异常(ev) 则 返回 ev 结束
        让 i = 转整数(sv)
        让 终点 = 转整数(ev)
        当 i <= 终点 循环
            _声明(环境, 语句["变量"], i)
            让 r = 调执行块(语句["体"], 环境)
            如果 _是异常(r) 则 返回 r 结束
            如果 _是调试退出(r) 则 返回 r 结束
            如果 _是控制(r) 则
                如果 r["__控制__"] == "返回" 则 返回 r 结束
                如果 r["__控制__"] == "跳出" 则 返回 0 结束
            结束
            i = i + 1
        结束
        返回 0
    结束

    # 表达式语句
    如果 k == "表达式语句" 则
        让 v = 调求值(语句["表达式"], 环境)
        如果 _是异常(v) 则 返回 v 结束
        返回 0
    结束

    # 裸表达式兜底
    让 v = 调求值(语句, 环境)
    如果 _是异常(v) 则 返回 v 结束
    返回 0
结束

函数 调执行块(语句列表, 环境)
    对于 i 从 0 到 长度(语句列表) - 1 循环
        让 st = 语句列表[i]
        让 h = 调试钩子(st, 环境)
        如果 _是调试退出(h) 则 返回 h 结束
        让 r = 调执行语句(st, 环境)
        如果 _是异常(r) 则 返回 r 结束
        如果 _是调试退出(r) 则 返回 r 结束
        如果 _是控制(r) 则 返回 r 结束
    结束
    返回 0
结束

# ============================================================
# 第七部分：调试钩子与交互命令
# ============================================================

函数 值转可读(v) -> 字符串
    让 t = 类型(v)
    如果 t == "字典" 且 包含(v, "类型") 则
        如果 v["类型"] == "函数" 则
            返回 "<函数 " + v["名字"] + ">"
        结束
        如果 v["类型"] == "内置" 则
            返回 "<内置 " + v["名字"] + ">"
        结束
    结束
    返回 转字符串(v)
结束

函数 打印当前变量()
    如果 g_当前环境 == g_空 则
        输出("    (无活动环境)")
        返回
    结束
    让 变量表 = g_当前环境["变量"]
    让 键s = 键(变量表)
    输出("    局部变量 (" + 转字符串(长度(键s)) + " 个):")
    对于 i 从 0 到 长度(键s) - 1 循环
        让 名 = 键s[i]
        输出("      " + 名 + " = " + 值转可读(变量表[名]))
    结束
结束

函数 打印单个变量(名)
    让 v = _查找(g_当前环境, 名)
    如果 v == g_空 则
        输出("    " + 名 + " = <未定义>")
        返回
    结束
    输出("    " + 名 + " = " + 值转可读(v))
结束

函数 打印调用栈()
    输出("    调用栈 (" + 转字符串(长度(g_调用栈)) + " 层):")
    对于 i 从 0 到 长度(g_调用栈) - 1 循环
        让 帧 = g_调用栈[i]
        输出("      #" + 转字符串(i) + " " + 帧["函数"])
    结束
结束

函数 读一条命令() -> 字符串
    如果 g_脚本模式 == 1 则
        如果 g_脚本指针 < 长度(g_命令脚本) 则
            让 c = g_命令脚本[g_脚本指针]
            g_脚本指针 = g_脚本指针 + 1
            输出("    [脚本命令] " + c)
            返回 c
        结束
        返回 "c"
    结束
    返回 输入("(调试)> ")
结束

# 调试钩子：每条语句执行前调用
函数 调试钩子(语句, 环境)
    g_当前环境 = 环境
    让 行 = 0
    如果 类型(语句) == "字典" 且 包含(语句, "行") 则
        行 = 语句["行"]
    结束
    让 应停 = 0
    如果 g_单步 == 1 则
        应停 = 1
    结束
    如果 行 > 0 且 包含(g_断点集合, 转字符串(行)) 且 g_断点集合[转字符串(行)] == 1 则
        应停 = 1
    结束
    如果 应停 == 0 则
        返回 0
    结束

    输出("")
    输出("· 暂停于第 " + 转字符串(行) + " 行")
    如果 行 > 0 且 行 <= 长度(g_源码行) 则
        输出("    " + g_源码行[行 - 1])
    结束

    当 g_退出 == 0 循环
        让 cmd = 读一条命令()
        如果 cmd == "n" 或 cmd == "next" 则
            g_单步 = 1
            返回 0
        结束
        如果 cmd == "c" 或 cmd == "continue" 则
            g_单步 = 0
            返回 0
        结束
        如果 cmd == "q" 或 cmd == "quit" 则
            g_退出 = 1
            返回 {"__调试退出__": 1}
        结束
        如果 cmd == "l" 或 cmd == "locals" 则
            打印当前变量()
            继续
        结束
        如果 cmd == "bt" 或 cmd == "backtrace" 则
            打印调用栈()
            继续
        结束
        如果 长度(cmd) >= 2 且 截取(cmd, 0, 2) == "p " 则
            让 名 = 截取(cmd, 2, 长度(cmd) - 2)
            打印单个变量(名)
            继续
        结束
        如果 长度(cmd) >= 2 且 截取(cmd, 0, 2) == "b " 则
            让 行号 = 转整数(截取(cmd, 2, 长度(cmd) - 2))
            设置断点(行号)
            输出("    断点已设置: 第 " + 转字符串(行号) + " 行")
            继续
        结束
        输出("    未知命令: " + cmd + "（可用: n/c/p 变量/l/bt/b 行号/q）")
    结束
    返回 0
结束

# ============================================================
# 第八部分：公开 API
# ============================================================

函数 设置断点(行号)
    g_断点集合[转字符串(行号)] = 1
结束

函数 清除断点(行号)
    g_断点集合[转字符串(行号)] = 0
结束

函数 查看变量(名字)
    打印单个变量(名字)
结束

函数 查看所有变量()
    打印当前变量()
结束

函数 查看栈()
    打印调用栈()
结束

函数 退出调试()
    g_退出 = 1
结束

函数 _重置状态()
    g_断点集合 = {}
    g_单步 = 0
    g_调用栈 = []
    g_退出 = 0
    g_当前环境 = g_空
    g_命令脚本 = []
    g_脚本指针 = 0
结束

函数 _执行源码(源)
    g_源码 = 源
    g_源码行 = 分割(源, "\n")
    让 ast = 迷你解析(源)
    输出("===== 调试开始 =====")
    让 env = 新建目标环境()
    让 r = 调执行块(ast["语句"], env)
    如果 _是异常(r) 则
        输出("")
        输出("运行时错误: " + r["__异常__"]["消息"])
    否则
        输出("")
        输出("===== 调试结束 =====")
    结束
结束

# 交互模式
函数 调试运行(路径)
    _重置状态()
    g_脚本模式 = 0
    让 源 = 读取文件(路径)
    _执行源码(源)
结束

# 脚本模式（自动化测试）
函数 调试运行_脚本(路径, 断言行列表, 命令列表)
    _重置状态()
    g_脚本模式 = 1
    g_命令脚本 = 命令列表
    对于 i 从 0 到 长度(断言行列表) - 1 循环
        设置断点(断言行列表[i])
    结束
    让 源 = 读取文件(路径)
    _执行源码(源)
结束
