# ============================================================
# repl.co —— coCN 交互式 REPL（Read-Eval-Print Loop）
#
# 运行方式（由 bin/cocn.js 无参数时拉起）：
#   cocn                      -> 进入本 REPL
#
# 行为：
#   - 打印提示符，逐行读取用户输入；
#   - 在一个【持久根环境】里解析并执行，跨行保留变量/函数；
#   - 若最后一条是纯表达式，求值并打印其结果；语句则不打印；
#   - 运行时错误打印后继续循环；
#   - 空行 或 输入 退出/quit/exit（或 stdin 结束）时退出。
#
# 说明：语法错误由语法分析器经「断言 -> 退出」致命终止当前进程
# （这是自举语法分析器的既定行为，不在本文件改动范围内）；
# 可捕获并恢复的是求值阶段返回的异常信号（__异常__）。
# ============================================================

导入 "求值器"
导入 "语法分析器"

# 持久根环境：整个 REPL 生命周期只创建一次，所有输入行共享
让 环境 = 新建环境()

# 执行一行源：解析 -> 逐条执行语句，最后一条若为纯表达式则求值返回其值。
# 返回：
#   - 异常字典（__异常__）：运行时错误，由调用方打印；
#   - {"__repl__":1, "显示":1, "值":v}：需要打印表达式值 v；
#   - {"__repl__":1, "显示":0, "值":0}：语句，无需打印。
函数 执行一行(字符串 源, 环境)
    让 ast = 解析源(源)
    让 语句列表 = ast["语句"]
    让 n = 长度(语句列表)

    # 先逐条执行除最后一条外的语句（副作用顺序执行，遇到异常立即返回）
    让 i = 0
    当 i < n - 1 循环
        让 r = 执行语句(语句列表[i], 环境)
        如果 是异常(r) 则
            返回 r
        结束
        i = i + 1
    结束

    如果 n == 0 则
        返回 {"__repl__": 1, "显示": 0, "值": 0}
    结束

    让 末 = 语句列表[n - 1]
    # 纯表达式（字面量/标识符/二元/一元/下标/字面量/匹配）：求值并回显；
    # 函数调用视为语句（有副作用，如 输出 x+2），执行后不回显其返回值。
    如果 是表达式节点(末) 且 末["类型"] != "函数调用" 则
        让 v = 求值(末, 环境)
        如果 是异常(v) 则
            返回 v
        结束
        返回 {"__repl__": 1, "显示": 1, "值": v}
    结束

    让 r = 执行语句(末, 环境)
    如果 是异常(r) 则
        返回 r
    结束
    返回 {"__repl__": 1, "显示": 0, "值": 0}
结束

# ---------------- 欢迎信息 ----------------
输出 "coCN 交互式环境"
输出 "输入表达式立即求值；空行或 退出/quit/exit 结束。"

# ---------------- REPL 主循环 ----------------
当 1 循环
    让 行 = 输入("coCN> ")

    # 空行 / EOF / 退出命令 -> 结束
    如果 行 == "" 则
        跳出
    结束
    如果 行 == "退出" 或 行 == "quit" 或 行 == "exit" 则
        跳出
    结束

    # 解析并执行（运行时错误以异常信号返回，捕获后继续）
    让 结果 = 执行一行(行, 环境)

    如果 是异常(结果) 则
        输出错误("错误: " + 结果["__异常__"]["消息"])
    否则
        如果 结果["显示"] == 1 则
            输出(结果["值"])
        结束
    结束
结束
