# ============================================================
# 解释器.co —— coCN 自解释器主入口
#
# 运行方式：
#   COCN_TARGET=程序.co cocn 解释器.co
#   （宿主 cocn 不提供「命令行参数」内置函数，多余位置参数会被
#     C 宿主静默忽略，因此目标程序路径经环境变量 COCN_TARGET 传入。）
#
# 后端选择（环境变量 COCN_BACKEND）：
#   - vm   ：默认。先走字节码虚拟机（更快）；遇到不支持的语法自动回退树遍历
#   - eval  ：强制走树遍历求值器
#   - 未设置 ：等价于 vm
#
# 流程：读取目标源文件 → 解析为 AST → VM 编译执行；
#       VM 标记「不支持」时（编译期，尚未产生任何副作用）回退到 求值器.运行。
# ============================================================

导入 "求值器"
导入 "语法分析器"
导入 "虚拟机"

# 读取目标程序路径
让 路径 = 环境变量("COCN_TARGET")

如果 路径 == "" 则
    输出 "用法：COCN_TARGET=程序.co cocn 解释器.co"
    输出 "说明：宿主不支持命令行参数，经环境变量 COCN_TARGET 传入被解释的 .co 文件"
    输出 "可选：COCN_BACKEND=vm（默认，更快）| eval（强制树遍历）"
否则
    如果 非 文件存在(路径) 则
        输出错误("错误：找不到文件 '" + 路径 + "'")
        退出(1)
    结束
    让 源 = 读文件(路径)

    # 决定后端
    让 后端 = 环境变量("COCN_BACKEND")
    如果 后端 == "" 则
        后端 = "vm"
    结束

    让 结果 = 0
    如果 后端 == "eval" 或 后端 == "求值器" 或 后端 == "tree" 或 后端 == "treewalk" 则
        结果 = 运行(源)
    否则
        # 默认 vm：先尝试字节码虚拟机
        让 ast = 解析源(源)
        结果 = 编译执行AST(ast)
        # VM 遇不支持语法会返回哨兵（编译期即回退，无副作用）
        如果 类型(结果) == "字典" 且 包含(结果, "__VM不支持__") 则
            结果 = 运行(源)
        结束
    结束

    # 运行 返回异常信号时，求值器/VM 已打印错误；这里以非零退出码表示失败
    如果 类型(结果) == "字典" 且 包含(结果, "__异常__") 则
        退出(1)
    结束
结束
