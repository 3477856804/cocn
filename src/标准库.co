# ============================================================
# 标准库.co —— coCN 官方标准库
# 通过  导入 "标准库"  引入；所有顶层函数会被合并到调用方环境
#
# 命名约定：本文件中的函数名一律【不与内置函数重名】，
# 避免遮蔽内置实现（例如内置的 求和 用于张量，此处不再重复定义）。
# ============================================================

# ---------------- 数值 ----------------

# 阶乘（递归）
函数 阶乘(整数 n) -> 整数
    若 n <= 1 返回 1
    返回 n * 阶乘(n - 1)
结束

# 平方 / 立方
函数 平方(x)
    返回 x * x
结束

函数 立方(x)
    返回 x * x * x
结束

# 最大公约数（辗转相除）
函数 最大公约(整数 a, 整数 b) -> 整数
    整数 x = 绝对值(a)
    整数 y = 绝对值(b)
    当 y != 0 循环
        整数 t = y
        y = x % y
        x = t
    结束
    返回 x
结束

# 最小公倍数
函数 最小公倍(整数 a, 整数 b) -> 整数
    若 a == 0 或 b == 0 返回 0
    返回 绝对值(a * b) // 最大公约(a, b)
结束

# 素数判断（只试除到平方根，比逐个试除快一个数量级）
函数 是素数(整数 n) -> 布尔
    若 n < 2 返回 假
    若 n < 4 返回 真
    若 n % 2 == 0 返回 假
    整数 上界 = 向下取整(平方根(n))
    对于 i 从 3 到 上界 步长 2 循环
        若 n % i == 0 返回 假
    结束
    返回 真
结束

# 小于 n 的所有素数（埃氏筛思路的简化版）
函数 素数表(整数 n)
    列表 结果 = []
    对于 i 从 2 到 n - 1 循环
        若 是素数(i) 追加(结果, i)
    结束
    返回 结果
结束

# 夹取数值到 [下界, 上界]
函数 夹取(x, 下界, 上界)
    若 x < 下界 返回 下界
    若 x > 上界 返回 上界
    返回 x
结束

# 把 a/b 夹到 [-1, 1]，并对除零做保护
函数 安全比值(浮点 a, 浮点 b) -> 浮点
    若 b == 0.0 返回 0.0
    返回 夹取(a / b, -1.0, 1.0)
结束

# 斐波那契（迭代版，避免指数级重复计算）
函数 斐波那契(整数 n) -> 整数
    若 n < 2 返回 n
    整数 前 = 0
    整数 后 = 1
    对于 i 从 2 到 n 循环
        整数 和 = 前 + 后
        前 = 后
        后 = 和
    结束
    返回 后
结束

# ---------------- 统计 ----------------

# 平均值
函数 平均值(列表 表)
    若 长度(表) == 0 返回 0.0
    返回 累加(表) / 长度(表)
结束

# 中位数（不改动原列表）
函数 中位数(列表 表)
    整数 n = 长度(表)
    若 n == 0 返回 0.0
    列表 副本 = 切片(表, 0, n)
    排序(副本)
    若 n % 2 == 1 返回 副本[n // 2]
    返回 (副本[n // 2 - 1] + 副本[n // 2]) / 2
结束

# 方差（总体方差）
函数 方差(列表 表)
    整数 n = 长度(表)
    若 n == 0 返回 0.0
    浮点 均 = 平均值(表)
    浮点 s = 0.0
    对于 i 从 0 到 n - 1 循环
        s = s + (表[i] - 均) * (表[i] - 均)
    结束
    返回 s / n
结束

# 标准差
函数 标准差(列表 表)
    返回 平方根(方差(表))
结束

# ---------------- 字符串 ----------------

# 字符串反转（内置 反转 已支持字符串，此处保留为语义化别名）
函数 反转字符串(字符串 s) -> 字符串
    返回 反转(s)
结束

# 是否回文（按字符比较，中文安全）
函数 是回文(字符串 s) -> 布尔
    返回 s == 反转(s)
结束

# 左侧补齐到指定字符宽度
函数 左补齐(字符串 s, 整数 宽, 字符串 填充) -> 字符串
    字符串 r = s
    当 长度(r) < 宽 循环
        r = 填充 + r
    结束
    返回 r
结束

# 右侧补齐到指定字符宽度
函数 右补齐(字符串 s, 整数 宽, 字符串 填充) -> 字符串
    字符串 r = s
    当 长度(r) < 宽 循环
        r = r + 填充
    结束
    返回 r
结束

# 首字母大写（仅处理 ASCII 首字符）
函数 首字大写(字符串 s) -> 字符串
    若 长度(s) == 0 返回 s
    返回 大写(切片(s, 0, 1)) + 切片(s, 1, 长度(s))
结束

# ---------------- 列表 ----------------

# 两个列表按位配对成 [[a1,b1], [a2,b2], ...]
函数 配对(列表 甲, 列表 乙)
    整数 n = 最小值(长度(甲), 长度(乙))
    列表 结果 = []
    对于 i 从 0 到 n - 1 循环
        追加(结果, [甲[i], 乙[i]])
    结束
    返回 结果
结束

# 按块大小切分列表
函数 分块(列表 表, 整数 块大小)
    若 块大小 <= 0 返回 []
    列表 结果 = []
    整数 i = 0
    当 i < 长度(表) 循环
        追加(结果, 切片(表, i, i + 块大小))
        i = i + 块大小
    结束
    返回 结果
结束

# 统计各元素出现次数，返回字典（键为元素的字符串形式）
函数 频次(列表 表)
    字典 结果 = {}
    对于 i 从 0 到 长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        若 包含(结果, k) 结果[k] = 结果[k] + 1
        若 非 包含(结果, k) 结果[k] = 1
    结束
    返回 结果
结束

# ============================================================
# 以下为扩充标准库：数据结构 / 算法 / 字符串 / 列表 / 函数工具 / 断言
# 全部用纯 coCN 实现，仅依赖已有内置函数与本文件既有函数。
# ============================================================

# ---------------- 数据结构：栈 ----------------
# 栈用字典 {"项": [...]} 模拟，列表可变引用使入栈/出栈原地生效。

# 新建栈() -> 字典：返回一个空栈
函数 新建栈() -> 字典
    返回 {"项": []}
结束

# 入栈(栈, 元素)：把元素压入栈顶
函数 入栈(字典 栈, 元素)
    追加(栈["项"], 元素)
结束

# 出栈(栈) -> 元素：弹出并返回栈顶元素；空栈时抛出异常
函数 出栈(字典 栈)
    如果 栈空(栈) 则
        抛出 "栈为空，无法出栈"
    结束
    返回 弹出(栈["项"])
结束

# 栈顶(栈) -> 元素：只读查看栈顶元素；空栈时抛出异常
函数 栈顶(字典 栈)
    如果 栈空(栈) 则
        抛出 "栈为空，没有栈顶元素"
    结束
    返回 栈["项"][长度(栈["项"]) - 1]
结束

# 栈空(栈) -> 布尔：栈里是否一个元素都没有
函数 栈空(字典 栈) -> 布尔
    返回 长度(栈["项"]) == 0
结束

# ---------------- 数据结构：队列 ----------------
# 队首在列表头部，入队追加到尾部，出队从头部弹出。

# 新建队列() -> 字典：返回一个空队列
函数 新建队列() -> 字典
    返回 {"项": []}
结束

# 入队(队列, 元素)：把元素加到队尾
函数 入队(字典 队列, 元素)
    追加(队列["项"], 元素)
结束

# 出队(队列) -> 元素：移除并返回队首元素；空队列抛出异常
函数 出队(字典 队列)
    如果 队列空(队列) 则
        抛出 "队列为空，无法出队"
    结束
    让 首 = 队列["项"][0]
    队列["项"] = 切片(队列["项"], 1, 长度(队列["项"]))
    返回 首
结束

# 队首(队列) -> 元素：只读查看队首元素；空队列抛出异常
函数 队首(字典 队列)
    如果 队列空(队列) 则
        抛出 "队列为空，没有队首元素"
    结束
    返回 队列["项"][0]
结束

# 队列空(队列) -> 布尔：队列是否为空
函数 队列空(字典 队列) -> 布尔
    返回 长度(队列["项"]) == 0
结束

# ---------------- 数据结构：集合 ----------------
# 用字典模拟：键是元素的字符串形式，值存原始元素，便于还原列表。

# 新建集合() -> 字典：返回一个空集合
函数 新建集合() -> 字典
    返回 {}
结束

# 集合添加(集合, 元素)：把元素加入集合（重复加入幂等）
函数 集合添加(字典 集合, 元素)
    集合[转字符串(元素)] = 元素
结束

# 集合删除(集合, 元素)：从集合移除元素（不存在也不报错）
函数 集合删除(字典 集合, 元素)
    删除键(集合, 转字符串(元素))
结束

# 集合包含(集合, 元素) -> 布尔：集合是否含有该元素
函数 集合包含(字典 集合, 元素) -> 布尔
    返回 包含(集合, 转字符串(元素))
结束

# 集合并集(集合a, 集合b) -> 集合：返回新集合，含两者全部元素
函数 集合并集(字典 甲, 字典 乙) -> 字典
    字典 结果 = {}
    列表 甲键 = 键(甲)
    对于 i 从 0 到 长度(甲键) - 1 循环
        字符串 k = 甲键[i]
        结果[k] = 甲[k]
    结束
    列表 乙键 = 键(乙)
    对于 i 从 0 到 长度(乙键) - 1 循环
        字符串 k = 乙键[i]
        结果[k] = 乙[k]
    结束
    返回 结果
结束

# 集合交集(集合a, 集合b) -> 集合：返回新集合，只含两者共有的元素
函数 集合交集(字典 甲, 字典 乙) -> 字典
    字典 结果 = {}
    列表 乙键 = 键(乙)
    对于 i 从 0 到 长度(乙键) - 1 循环
        字符串 k = 乙键[i]
        如果 包含(甲, k) 则
            结果[k] = 乙[k]
        结束
    结束
    返回 结果
结束

# 集合差集(集合a, 集合b) -> 集合：甲减去乙中出现的元素
函数 集合差集(字典 甲, 字典 乙) -> 字典
    字典 结果 = {}
    列表 甲键 = 键(甲)
    对于 i 从 0 到 长度(甲键) - 1 循环
        字符串 k = 甲键[i]
        如果 非 包含(乙, k) 则
            结果[k] = 甲[k]
        结束
    结束
    返回 结果
结束

# 集合大小(集合) -> 整数：集合元素个数
函数 集合大小(字典 集合) -> 整数
    返回 长度(集合)
结束

# 集合转列表(集合) -> 列表：把集合元素还原成列表（顺序不保证）
函数 集合转列表(字典 集合) -> 列表
    返回 值(集合)
结束

# ---------------- 算法：排序 ----------------
# 下列排序均返回新列表，不修改入参；比较基于元素自带大小。

# 冒泡排序(列表) -> 列表：升序副本
函数 冒泡排序(列表 表) -> 列表
    列表 结果 = 切片(表, 0, 长度(表))
    整数 n = 长度(结果)
    对于 i 从 0 到 n - 1 循环
        对于 j 从 0 到 n - i - 2 循环
            如果 结果[j] > 结果[j + 1] 则
                让 临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
        结束
    结束
    返回 结果
结束

# 选择排序(列表) -> 列表：每轮选最小放到前面
函数 选择排序(列表 表) -> 列表
    列表 结果 = 切片(表, 0, 长度(表))
    整数 n = 长度(结果)
    对于 i 从 0 到 n - 1 循环
        整数 最小下标 = i
        对于 j 从 i + 1 到 n - 1 循环
            如果 结果[j] < 结果[最小下标] 则
                最小下标 = j
            结束
        结束
        让 临时 = 结果[i]
        结果[i] = 结果[最小下标]
        结果[最小下标] = 临时
    结束
    返回 结果
结束

# 插入排序(列表) -> 列表：逐个把元素插入已排序前缀
函数 插入排序(列表 表) -> 列表
    列表 结果 = 切片(表, 0, 长度(表))
    对于 i 从 1 到 长度(结果) - 1 循环
        整数 j = i
        当 j > 0 循环
            如果 结果[j] < 结果[j - 1] 则
                让 临时 = 结果[j]
                结果[j] = 结果[j - 1]
                结果[j - 1] = 临时
                j = j - 1
            否则
                j = 0
            结束
        结束
    结束
    返回 结果
结束

# ============================================================
# 实用模块：JSON / 正则与通配 / 路径操作 / 日期时间 / 命令行
# 全部用纯 coCN 实现，仅依赖已有内置函数与本文件既有函数。
#
# 说明：coCN 中布尔与整数同型（真=1、假=0），无法在序列化时可靠区分
# JSON 布尔与数字；因此 JSON 的 true / false / null 用「字典哨兵」表示，
# 分别由 JSON真() / JSON假() / JSON空值() 构造。它们与解析出来的同值
# 做结构比较（==）为真。
# ============================================================

# ---------------- JSON ----------------

# JSON真() -> 字典哨兵：表示 JSON 的 true
函数 JSON真() -> 字典
    返回 {"__JSON布尔__": 1}
结束

# JSON假() -> 字典哨兵：表示 JSON 的 false
函数 JSON假() -> 字典
    返回 {"__JSON布尔__": 0}
结束

# JSON空值() -> 字典哨兵：表示 JSON 的 null
函数 JSON空值() -> 字典
    返回 {"__JSON空__": 1}
结束

# JSON内部：解析/序列化辅助函数集合（收进字典以节省顶层命名空间槽位）
# 状态 = {"s": 文本, "i": 当前下标}
字典 JSON内部 = {}

JSON内部["当前字符"] = 函数(字典 状态) -> 字符串
    如果 状态["i"] >= 长度(状态["s"]) 则
        返回 ""
    结束
    返回 切片(状态["s"], 状态["i"], 状态["i"] + 1)
结束

JSON内部["跳过空白"] = 函数(字典 状态)
    当 状态["i"] < 长度(状态["s"]) 循环
        字符串 c = JSON内部["当前字符"](状态)
        如果 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r" 则
            状态["i"] = 状态["i"] + 1
        否则
            跳出
        结束
    结束
结束

JSON内部["期待字面"] = 函数(字典 状态, 字符串 字面值)
    字符串 s = 状态["s"]
    整数 n = 长度(字面值)
    如果 状态["i"] + n > 长度(s) 或 切片(s, 状态["i"], 状态["i"] + n) != 字面值 则
        抛出 "JSON 字面值错误，期望 " + 字面值
    结束
    状态["i"] = 状态["i"] + n
结束

JSON内部["解码unicode"] = 函数(字符串 十六) -> 字符串
    整数 值 = 0
    对于 i 从 0 到 3 循环
        字符串 ch = 切片(十六, i, i + 1)
        整数 d = 0
        如果 ch >= "0" 且 ch <= "9" 则
            d = 转整数(ch)
        结束
        如果 ch == "a" 或 ch == "A" 则 d = 10 结束
        如果 ch == "b" 或 ch == "B" 则 d = 11 结束
        如果 ch == "c" 或 ch == "C" 则 d = 12 结束
        如果 ch == "d" 或 ch == "D" 则 d = 13 结束
        如果 ch == "e" 或 ch == "E" 则 d = 14 结束
        如果 ch == "f" 或 ch == "F" 则 d = 15 结束
        值 = 值 * 16 + d
    结束
    返回 从ASCII(值)
结束

JSON内部["字符串"] = 函数(字典 状态) -> 字符串
    字符串 s = 状态["s"]
    状态["i"] = 状态["i"] + 1
    字符串 结果 = ""
    当 真 循环
        如果 状态["i"] >= 长度(s) 则
            抛出 "JSON 字符串未闭合"
        结束
        字符串 c = 切片(s, 状态["i"], 状态["i"] + 1)
        如果 c == "\"" 则
            状态["i"] = 状态["i"] + 1
            返回 结果
        结束
        如果 c == "\\" 则
            状态["i"] = 状态["i"] + 1
            如果 状态["i"] >= 长度(s) 则
                抛出 "JSON 转义不完整"
            结束
            字符串 e = 切片(s, 状态["i"], 状态["i"] + 1)
            如果 e == "\"" 则 结果 = 结果 + "\"" 结束
            如果 e == "\\" 则 结果 = 结果 + "\\" 结束
            如果 e == "/" 则 结果 = 结果 + "/" 结束
            如果 e == "n" 则 结果 = 结果 + "\n" 结束
            如果 e == "t" 则 结果 = 结果 + "\t" 结束
            如果 e == "r" 则 结果 = 结果 + "\r" 结束
            如果 e == "b" 则 结果 = 结果 + "\b" 结束
            如果 e == "f" 则 结果 = 结果 + "\f" 结束
            如果 e == "u" 则
                如果 状态["i"] + 5 > 长度(s) 则
                    抛出 "JSON \\u 转义不完整"
                结束
                字符串 十六 = 切片(s, 状态["i"] + 1, 状态["i"] + 5)
                结果 = 结果 + JSON内部["解码unicode"](十六)
                状态["i"] = 状态["i"] + 4
            结束
            状态["i"] = 状态["i"] + 1
        否则
            结果 = 结果 + c
            状态["i"] = 状态["i"] + 1
        结束
    结束
结束

JSON内部["数字"] = 函数(字典 状态)
    字符串 s = 状态["s"]
    整数 开始 = 状态["i"]
    如果 JSON内部["当前字符"](状态) == "-" 则
        状态["i"] = 状态["i"] + 1
    结束
    当 状态["i"] < 长度(s) 循环
        字符串 c = 切片(s, 状态["i"], 状态["i"] + 1)
        如果 (c >= "0" 且 c <= "9") 或 c == "." 或 c == "e" 或 c == "E" 或 c == "+" 或 c == "-" 则
            状态["i"] = 状态["i"] + 1
        否则
            跳出
        结束
    结束
    字符串 号 = 切片(s, 开始, 状态["i"])
    如果 长度(号) == 0 或 号 == "-" 则
        抛出 "JSON 数字格式错误"
    结束
    如果 包含(号, ".") 或 包含(号, "e") 或 包含(号, "E") 则
        返回 转浮点(号)
    结束
    返回 转整数(号)
结束

JSON内部["数组"] = 函数(字典 状态) -> 列表
    列表 结果 = []
    状态["i"] = 状态["i"] + 1
    JSON内部["跳过空白"](状态)
    如果 JSON内部["当前字符"](状态) == "]" 则
        状态["i"] = 状态["i"] + 1
        返回 结果
    结束
    当 真 循环
        让 v = JSON内部["值"](状态)
        追加(结果, v)
        JSON内部["跳过空白"](状态)
        字符串 c = JSON内部["当前字符"](状态)
        如果 c == "," 则
            状态["i"] = 状态["i"] + 1
        否则
            如果 c == "]" 则
                状态["i"] = 状态["i"] + 1
                返回 结果
            否则
                抛出 "JSON 数组缺少 ]"
            结束
        结束
    结束
结束

JSON内部["对象"] = 函数(字典 状态) -> 字典
    字典 结果 = {}
    状态["i"] = 状态["i"] + 1
    JSON内部["跳过空白"](状态)
    如果 JSON内部["当前字符"](状态) == "}" 则
        状态["i"] = 状态["i"] + 1
        返回 结果
    结束
    当 真 循环
        JSON内部["跳过空白"](状态)
        如果 JSON内部["当前字符"](状态) != "\"" 则
            抛出 "JSON 对象的键必须是字符串"
        结束
        字符串 键名 = JSON内部["字符串"](状态)
        JSON内部["跳过空白"](状态)
        如果 JSON内部["当前字符"](状态) != ":" 则
            抛出 "JSON 缺少冒号"
        结束
        状态["i"] = 状态["i"] + 1
        让 v = JSON内部["值"](状态)
        结果[键名] = v
        JSON内部["跳过空白"](状态)
        字符串 c = JSON内部["当前字符"](状态)
        如果 c == "," 则
            状态["i"] = 状态["i"] + 1
        否则
            如果 c == "}" 则
                状态["i"] = 状态["i"] + 1
                返回 结果
            否则
                抛出 "JSON 对象缺少 }"
            结束
        结束
    结束
结束

JSON内部["值"] = 函数(字典 状态)
    JSON内部["跳过空白"](状态)
    字符串 c = JSON内部["当前字符"](状态)
    如果 c == "{" 则 返回 JSON内部["对象"](状态) 结束
    如果 c == "[" 则 返回 JSON内部["数组"](状态) 结束
    如果 c == "\"" 则 返回 JSON内部["字符串"](状态) 结束
    如果 c == "t" 则
        JSON内部["期待字面"](状态, "true")
        返回 JSON真()
    结束
    如果 c == "f" 则
        JSON内部["期待字面"](状态, "false")
        返回 JSON假()
    结束
    如果 c == "n" 则
        JSON内部["期待字面"](状态, "null")
        返回 JSON空值()
    结束
    返回 JSON内部["数字"](状态)
结束

# JSON解析(字符串)：解析 JSON 字符串为 coCN 值（对象->字典，数组->列表）
# 解析失败时抛出异常。
函数 JSON解析(字符串 文本)
    字典 状态 = {"s": 文本, "i": 0}
    让 v = JSON内部["值"](状态)
    JSON内部["跳过空白"](状态)
    如果 状态["i"] != 长度(文本) 则
        抛出 "JSON 结尾存在多余字符"
    结束
    返回 v
结束

# JSON序列化字符串(字符串) -> 字符串：加引号并转义特殊字符
函数 JSON序列化字符串(字符串 s) -> 字符串
    字符串 结果 = "\""
    对于 i 从 0 到 长度(s) - 1 循环
        字符串 c = 切片(s, i, i + 1)
        字符串 追加片段 = c
        如果 c == "\"" 则 追加片段 = "\\\"" 结束
        如果 c == "\\" 则 追加片段 = "\\\\" 结束
        如果 c == "\n" 则 追加片段 = "\\n" 结束
        如果 c == "\t" 则 追加片段 = "\\t" 结束
        如果 c == "\r" 则 追加片段 = "\\r" 结束
        结果 = 结果 + 追加片段
    结束
    返回 结果 + "\""
结束

# JSON序列化(v) -> 字符串：coCN 值转 JSON 字符串
# 字典哨兵（JSON真/JSON假/JSON空值）会输出 true/false/null。
函数 JSON序列化(v) -> 字符串
    字符串 t = 类型(v)
    如果 t == "字典" 则
        如果 包含(v, "__JSON空__") 则 返回 "null" 结束
        如果 包含(v, "__JSON布尔__") 则
            如果 v["__JSON布尔__"] == 1 则
                返回 "true"
            结束
            返回 "false"
        结束
        列表 ks = 键(v)
        列表 段 = []
        对于 i 从 0 到 长度(ks) - 1 循环
            追加(段, JSON序列化字符串(ks[i]) + ":" + JSON序列化(v[ks[i]]))
        结束
        返回 "{" + 连接(段, ",") + "}"
    结束
    如果 t == "列表" 则
        列表 段 = []
        对于 i 从 0 到 长度(v) - 1 循环
            追加(段, JSON序列化(v[i]))
        结束
        返回 "[" + 连接(段, ",") + "]"
    结束
    如果 t == "字符串" 则
        返回 JSON序列化字符串(v)
    结束
    如果 t == "整数" 或 t == "浮点" 则
        返回 转字符串(v)
    结束
    抛出 "JSON 不支持的值类型: " + t
结束

# ---------------- 通配与正则 ----------------

# 通配匹配(模式, 文本) -> 布尔
# 支持 *（任意多个任意字符）和 ?（任意一个字符），递归实现。
函数 通配匹配(字符串 模式, 字符串 文本) -> 布尔
    如果 长度(模式) == 0 则
        返回 长度(文本) == 0
    结束
    字符串 p0 = 切片(模式, 0, 1)
    如果 p0 == "*" 则
        # * 匹配 0 个；或消费文本一个字符继续匹配同一 *
        如果 长度(文本) == 0 则
            返回 通配匹配(切片(模式, 1, 长度(模式)), 文本)
        结束
        返回 通配匹配(切片(模式, 1, 长度(模式)), 文本) 或 通配匹配(模式, 切片(文本, 1, 长度(文本)))
    结束
    如果 长度(文本) == 0 则
        返回 假
    结束
    如果 p0 == "?" 或 p0 == 切片(文本, 0, 1) 则
        返回 通配匹配(切片(模式, 1, 长度(模式)), 切片(文本, 1, 长度(文本)))
    结束
    返回 假
结束

# 正则内部：编译/回溯辅助（收进字典以节省顶层槽位）
字典 正则内部 = {}

# 正则内部["字符匹配"](原子, 单字符) -> 布尔
正则内部["字符匹配"] = 函数(字典 原子, 字符串 c) -> 布尔
    字符串 k = 原子["种类"]
    如果 k == "字面" 则 返回 c == 原子["字符"] 结束
    如果 k == "任意" 则 返回 真 结束
    如果 k == "数字" 则
        返回 c >= "0" 且 c <= "9"
    结束
    如果 k == "单词" 则
        返回 (c >= "a" 且 c <= "z") 或 (c >= "A" 且 c <= "Z") 或 (c >= "0" 且 c <= "9") 或 c == "_"
    结束
    如果 k == "空白" 则
        返回 是空白(c)
    结束
    如果 k == "字符类" 则
        返回 包含(原子["字符集"], c)
    结束
    如果 k == "排除类" 则
        返回 非 包含(原子["字符集"], c)
    结束
    返回 假
结束

# 正则内部["解析原子"](模式, i) -> {"原子":字典, "消费":整数}
正则内部["解析原子"] = 函数(字符串 模式, 整数 i) -> 字典
    字符串 c = 切片(模式, i, i + 1)
    如果 c == "\\" 则
        字符串 e = 切片(模式, i + 1, i + 2)
        如果 e == "d" 则 返回 {"原子": {"种类": "数字", "字符": "", "量词": ""}, "消费": 2} 结束
        如果 e == "w" 则 返回 {"原子": {"种类": "单词", "字符": "", "量词": ""}, "消费": 2} 结束
        如果 e == "s" 则 返回 {"原子": {"种类": "空白", "字符": "", "量词": ""}, "消费": 2} 结束
        如果 e == "D" 则 返回 {"原子": {"种类": "排除类", "字符集": "0123456789", "量词": ""}, "消费": 2} 结束
        如果 e == "W" 则 返回 {"原子": {"种类": "字符类", "字符集": "0123456789_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", "量词": ""}, "消费": 2} 结束
        如果 e == "S" 则 返回 {"原子": {"种类": "排除类", "字符集": " \t\n\r", "量词": ""}, "消费": 2} 结束
        返回 {"原子": {"种类": "字面", "字符": e, "量词": ""}, "消费": 2}
    结束
    如果 c == "." 则
        返回 {"原子": {"种类": "任意", "字符": "", "量词": ""}, "消费": 1}
    结束
    如果 c == "[" 则
        整数 j = i + 1
        布尔 排除 = 假
        如果 切片(模式, j, j + 1) == "^" 则
            排除 = 真
            j = j + 1
        结束
        # 展开字符类（支持 a-z / A-Z / 0-9 范围）
        字符串 字符集 = ""
        当 切片(模式, j, j + 1) != "]" 循环
            字符串 ch1 = 切片(模式, j, j + 1)
            # 形如 x-y 的范围（需要第三个字符是 y 且中间是 -）
            如果 j + 2 < 长度(模式) 且 切片(模式, j + 1, j + 2) == "-" 且 切片(模式, j + 2, j + 3) != "]" 则
                字符串 起点 = ch1
                字符串 终点 = 切片(模式, j + 2, j + 3)
                字符串 k = 起点
                当 k <= 终点 循环
                    字符集 = 字符集 + k
                    k = 从ASCII(转ASCII(k) + 1)
                结束
                j = j + 3
            否则
                字符集 = 字符集 + ch1
                j = j + 1
            结束
        结束
        j = j + 1
        字符串 种类 = "字符类"
        如果 排除 则 种类 = "排除类" 结束
        返回 {"原子": {"种类": 种类, "字符集": 字符集, "量词": ""}, "消费": j - i}
    结束
    返回 {"原子": {"种类": "字面", "字符": c, "量词": ""}, "消费": 1}
结束

# 正则内部["编译"](模式) -> {"原子":[...], "开头锚":布尔, "结尾锚":布尔}
正则内部["编译"] = 函数(字符串 模式) -> 字典
    列表 原子表 = []
    整数 n = 长度(模式)
    整数 i = 0
    布尔 开头锚 = 假
    布尔 结尾锚 = 假
    如果 n > 0 且 切片(模式, 0, 1) == "^" 则
        开头锚 = 真
        i = 1
    结束
    当 i < n 循环
        字符串 c = 切片(模式, i, i + 1)
        如果 c == "$" 且 i == n - 1 则
            结尾锚 = 真
            i = i + 1
            继续
        结束
        字典 结果 = 正则内部["解析原子"](模式, i)
        字典 原子 = 结果["原子"]
        i = i + 结果["消费"]
        如果 i < n 则
            字符串 下一个 = 切片(模式, i, i + 1)
            如果 下一个 == "*" 或 下一个 == "+" 则
                原子["量词"] = 下一个
                i = i + 1
            结束
        结束
        追加(原子表, 原子)
    结束
    返回 {"原子": 原子表, "开头锚": 开头锚, "结尾锚": 结尾锚}
结束

# 正则内部["回溯"](原子表, 文本, ai, ti, 结尾锚) -> 布尔：递归回溯匹配
正则内部["回溯"] = 函数(列表 原子表, 字符串 文本, 整数 ai, 整数 ti, 布尔 结尾锚) -> 布尔
    如果 ai >= 长度(原子表) 则
        如果 结尾锚 则 返回 ti == 长度(文本) 结束
        返回 真
    结束
    字典 原子 = 原子表[ai]
    字符串 量词 = 原子["量词"]
    如果 量词 == "*" 或 量词 == "+" 则
        如果 量词 == "*" 则
            如果 正则内部["回溯"](原子表, 文本, ai + 1, ti, 结尾锚) 则
                返回 真
            结束
        结束
        当 真 循环
            如果 ti >= 长度(文本) 则
                返回 假
            结束
            如果 非 正则内部["字符匹配"](原子, 切片(文本, ti, ti + 1)) 则
                返回 假
            结束
            ti = ti + 1
            如果 正则内部["回溯"](原子表, 文本, ai + 1, ti, 结尾锚) 则
                返回 真
            结束
        结束
        返回 假
    结束
    如果 ti >= 长度(文本) 则
        返回 假
    结束
    如果 非 正则内部["字符匹配"](原子, 切片(文本, ti, ti + 1)) 则
        返回 假
    结束
    返回 正则内部["回溯"](原子表, 文本, ai + 1, ti + 1, 结尾锚)
结束

# 正则匹配(模式, 文本) -> 布尔
# 支持 ^ $ [abc] [^abc] . + * 及转义 \d \w \s；未锚定时按子串匹配。
函数 正则匹配(字符串 模式, 字符串 文本) -> 布尔
    字典 c = 正则内部["编译"](模式)
    如果 c["开头锚"] 则
        返回 正则内部["回溯"](c["原子"], 文本, 0, 0, c["结尾锚"])
    结束
    整数 i = 0
    当 i <= 长度(文本) 循环
        如果 正则内部["回溯"](c["原子"], 文本, 0, i, c["结尾锚"]) 则
            返回 真
        结束
        i = i + 1
    结束
    返回 假
结束

# ---------------- 路径操作（Unix 风格，以 / 分隔） ----------------

# 路径内部：去两侧斜杠辅助（收进字典）
字典 路径内部 = {}
路径内部["去两侧斜杠"] = 函数(字符串 s) -> 字符串
    当 切片(s, 0, 1) == "/" 循环
        s = 切片(s, 1, 长度(s))
    结束
    当 长度(s) > 0 且 切片(s, 长度(s) - 1, 长度(s)) == "/" 循环
        s = 切片(s, 0, 长度(s) - 1)
    结束
    返回 s
结束

# 路径拼接(列表 段) -> 字符串：用 / 拼接各段，清理多余斜杠
函数 路径拼接(列表 段) -> 字符串
    列表 干净 = []
    对于 i 从 0 到 长度(段) - 1 循环
        字符串 x = 段[i]
        如果 长度(x) > 0 则
            追加(干净, 路径内部["去两侧斜杠"](x))
        结束
    结束
    字符串 r = 连接(干净, "/")
    如果 长度(段) > 0 且 切片(段[0], 0, 1) == "/" 则
        r = "/" + r
    结束
    返回 r
结束

# 文件名(路径) -> 字符串：取最后一段
函数 文件名(字符串 路径) -> 字符串
    字符串 p = 路径内部["去两侧斜杠"](路径)
    如果 长度(p) == 0 则
        返回 ""
    结束
    列表 段 = 分割(p, "/")
    返回 段[长度(段) - 1]
结束

# 扩展名(路径) -> 字符串：取 .后缀（含点）；无则空串
函数 扩展名(字符串 路径) -> 字符串
    字符串 名 = 文件名(路径)
    整数 最后点 = -1
    对于 i 从 0 到 长度(名) - 1 循环
        如果 切片(名, i, i + 1) == "." 则
            最后点 = i
        结束
    结束
    如果 最后点 <= 0 则
        返回 ""
    结束
    返回 切片(名, 最后点, 长度(名))
结束

# 目录名(路径) -> 字符串：去掉最后一段
函数 目录名(字符串 路径) -> 字符串
    字符串 p = 路径内部["去两侧斜杠"](路径)
    如果 长度(p) == 0 则
        返回 "/"
    结束
    列表 段 = 分割(p, "/")
    如果 长度(段) == 1 则
        如果 切片(路径, 0, 1) == "/" 则
            返回 "/"
        结束
        返回 "."
    结束
    列表 父段 = 切片(段, 0, 长度(段) - 1)
    字符串 r = 连接(父段, "/")
    如果 切片(路径, 0, 1) == "/" 则
        r = "/" + r
    结束
    返回 r
结束

# 路径存在(路径) -> 布尔：文件或目录是否存在
函数 路径存在(字符串 路径) -> 布尔
    字符串 out = 执行命令("test -e '" + 路径 + "' && echo COCN_EXISTS")
    返回 包含(out, "COCN_EXISTS")
结束

# 是绝对路径(路径) -> 布尔：是否以 / 开头
函数 是绝对路径(字符串 路径) -> 布尔
    返回 切片(路径, 0, 1) == "/"
结束

# 规范化路径(路径) -> 字符串：解析 . 和 ..（简单版）
函数 规范化路径(字符串 路径) -> 字符串
    布尔 绝对 = 切片(路径, 0, 1) == "/"
    列表 段 = 分割(路径, "/")
    列表 栈 = []
    对于 i 从 0 到 长度(段) - 1 循环
        字符串 x = 段[i]
        如果 x == "" 或 x == "." 则
            继续
        结束
        如果 x == ".." 则
            如果 长度(栈) > 0 则
                弹出(栈)
            否则
                如果 非 绝对 则
                    追加(栈, "..")
                结束
            结束
        否则
            追加(栈, x)
        结束
    结束
    字符串 r = 连接(栈, "/")
    如果 绝对 则
        返回 "/" + r
    结束
    如果 长度(r) == 0 则
        返回 "."
    结束
    返回 r
结束

# ---------------- 日期时间 ----------------

# 当前时间戳() -> 整数：Unix 秒
函数 当前时间戳() -> 整数
    返回 转整数(时间戳())
结束

# 是闰年(年) -> 布尔
函数 是闰年(整数 年) -> 布尔
    返回 (年 % 4 == 0) 且 (年 % 100 != 0 或 年 % 400 == 0)
结束

# 月份天数(年, 月) -> 整数
函数 月份天数(整数 年, 整数 月) -> 整数
    如果 月 == 2 则
        如果 是闰年(年) 则
            返回 29
        结束
        返回 28
    结束
    如果 月 == 4 或 月 == 6 或 月 == 9 或 月 == 11 则
        返回 30
    结束
    返回 31
结束

# 日期部分(时间戳) -> [年, 月, 日]：从 1970-01-01 起推算（UTC 口径）
函数 日期部分(整数 时间戳) -> 列表
    整数 天数 = 时间戳 // 86400
    整数 年 = 1970
    当 真 循环
        整数 年天数 = 365
        如果 是闰年(年) 则 年天数 = 366 结束
        如果 天数 < 年天数 则
            跳出
        结束
        天数 = 天数 - 年天数
        年 = 年 + 1
    结束
    整数 月 = 1
    当 真 循环
        整数 m天数 = 月份天数(年, 月)
        如果 天数 < m天数 则
            跳出
        结束
        天数 = 天数 - m天数
        月 = 月 + 1
    结束
    返回 [年, 月, 天数 + 1]
结束

# 时间部分(时间戳) -> [时, 分, 秒]
函数 时间部分(整数 时间戳) -> 列表
    整数 当天秒 = 时间戳 % 86400
    整数 时 = 当天秒 // 3600
    整数 分 = (当天秒 % 3600) // 60
    整数 秒 = 当天秒 % 60
    返回 [时, 分, 秒]
结束

# 格式化日期(时间戳) -> "YYYY-MM-DD"
函数 格式化日期(整数 时间戳) -> 字符串
    列表 d = 日期部分(时间戳)
    字符串 年 = 转字符串(d[0])
    字符串 月 = 左补齐(转字符串(d[1]), 2, "0")
    字符串 日 = 左补齐(转字符串(d[2]), 2, "0")
    返回 年 + "-" + 月 + "-" + 日
结束

# 日期差(时间戳A, 时间戳B) -> 天数差
函数 日期差(整数 时间戳A, 整数 时间戳B) -> 整数
    返回 (时间戳A // 86400) - (时间戳B // 86400)
结束

# 今天() -> "YYYY-MM-DD"：用整数时间戳本地推算（避免系统 date 对大浮点的科学计数法问题）
函数 今天() -> 字符串
    返回 格式化日期(当前时间戳())
结束

# ---------------- 命令行参数 ----------------
# 注：读取命令行 已是层内置（见 求值器.调用内置），从环境变量 COCN_ARGV
# 读取程序参数（换行分隔）；宿主不提供此能力，属层扩展。此处在标准库保留
# 说明性注释，不再定义同名函数以免覆盖内置。

# ============================================================
# 扩充模块：单元测试框架 + 分级日志
# 全部纯 coCN 实现，仅依赖内置函数与本文件既有函数。
#
# 设计要点：
#  - 内置 断言/断言相等 失败时直接 退出(1) 终止整个进程，无法被
#    尝试/捕获 拦截；因此本测试框架的断言系列一律用 抛出 抛出【可捕获】
#    异常，由 运行所有测试 统一捕获、计数并汇总。顶层 断言相等 会覆盖
#    内置同名占位（导入后调用方环境优先于根环境内置），行为变为“可捕获”。
#  - 模块级可变状态（用例表、日志级别/颜色开关）收进 测试内部 / 日志内部
#    两个字典，既避免顶层命名空间槽位膨胀，也让跨函数共享状态稳定可靠。
# ============================================================

# ---------------- 单元测试框架 ----------------

# 测试内部：模块状态字典 —— "用例" 存放已注册用例 [{"名字":..,"函数":..}]
字典 测试内部 = {"用例": []}

# 测试用例(名字, 测试函数)：注册一个测试用例
# 参数 名字：用例名称（字符串，运行时逐行打印）
# 参数 测试函数：无参函数，函数体里调用各断言；任一断言失败即视为本用例失败
# 返回值：无
函数 测试用例(名字, 测试函数)
    追加(测试内部["用例"], {"名字": 名字, "函数": 测试函数})
结束

# 断言相等(实际, 期望, 说明="")：断言两值相等
# 不等则 抛出 可捕获异常（覆盖内置同名占位——内置版失败会 退出(1)）
# 返回值：相等时正常返回；不等时抛出
函数 断言相等(实际, 期望, 说明="")
    如果 实际 != 期望 则
        字符串 说明文本 = ""
        如果 说明 == "" 则
            说明文本 = "（无说明）"
        否则
            说明文本 = 说明
        结束
        抛出 "断言相等失败: 期望 " + 转字符串(期望) + "，实际 " + 转字符串(实际) + " —— " + 说明文本
    结束
结束

# 断言接近(实际, 期望, 容差, 说明="")：断言浮点值在容差范围内近似相等
# 用于规避 0.1+0.2 != 0.3 这类浮点误差；|实际-期望| <= 容差 即通过
函数 断言接近(实际, 期望, 容差, 说明="")
    浮点 差 = 绝对值(实际 - 期望)
    如果 差 > 容差 则
        字符串 说明文本 = ""
        如果 说明 == "" 则
            说明文本 = "（无说明）"
        否则
            说明文本 = 说明
        结束
        抛出 "断言接近失败: " + 转字符串(实际) + " 与 " + 转字符串(期望) + " 相差 " + 转字符串(差) + "，超过容差 " + 转字符串(容差) + " —— " + 说明文本
    结束
结束

# 断言为真(条件, 消息="")：断言条件成立；不成立则抛出并附 消息
函数 断言为真(条件, 消息="")
    如果 非 条件 则
        字符串 消息文本 = ""
        如果 消息 == "" 则
            消息文本 = "（无说明）"
        否则
            消息文本 = 消息
        结束
        抛出 "断言为真失败: " + 消息文本
    结束
结束

# 断言为假(条件, 消息="")：断言条件不成立；成立则抛出并附 消息
函数 断言为假(条件, 消息="")
    如果 条件 则
        字符串 消息文本 = ""
        如果 消息 == "" 则
            消息文本 = "（无说明）"
        否则
            消息文本 = 消息
        结束
        抛出 "断言为假失败: " + 消息文本
    结束
结束

# 断言抛出(测试函数, 描述)：断言 测试函数 调用会抛出异常
# 参数 描述：测试用例的描述标签
函数 断言抛出(测试函数, 描述)
    尝试
        测试函数()
    捕获 err
        返回
    结束
    抛出 "断言抛出失败: " + 描述 + " - 期望函数抛出错误，但它正常返回了"
结束

# 断言类型(值, 期望类型, 说明="")：断言值的类型字符串匹配
# 类型字符串见 类型()：整数/浮点/字符串/列表/字典/函数 等
# 说明 有默认值：标准库扩充测试 既用 2 参也用 3 参，参数数量守卫（§4.3 起
# 两通道都会真拦）落地后，缺默认值就把合法用例打成「参数数量错误」。
函数 断言类型(值, 期望类型, 说明="")
    如果 类型(值) != 期望类型 则
        字符串 说明文本 = ""
        如果 说明 == "" 则
            说明文本 = "（无说明）"
        否则
            说明文本 = 说明
        结束
        抛出 "断言类型失败: 期望类型 " + 期望类型 + "，实际 " + 类型(值) + " —— " + 说明文本
    结束
结束

# 断言包含(集合, 元素, 说明="")：断言集合包含元素
# 列表：线性成员判断（按 == 比较）；字典：按 转字符串(元素) 判断键是否存在
函数 断言包含(集合, 元素, 说明="")
    字符串 t = 类型(集合)
    如果 t == "列表" 则
        整数 找到了 = 0
        对于 i 从 0 到 长度(集合) - 1 循环
            如果 集合[i] == 元素 则
                找到了 = 1
            结束
        结束
        如果 找到了 == 0 则
            抛出 "断言包含失败: 列表不含 " + 转字符串(元素)
        结束
        返回
    结束
    如果 t == "字典" 则
        如果 非 包含(集合, 转字符串(元素)) 则
            抛出 "断言包含失败: 字典不含键 " + 转字符串(元素)
        结束
        返回
    结束
    抛出 "断言包含失败: 不支持的集合类型 " + t
结束

# 运行所有测试()：依次执行全部已注册用例
# 每个用例用 尝试/捕获 包裹；失败打印 ✗ 及错误消息，成功打印 ✓
# 末尾输出汇总：通过 X/Y，失败 Z；返回值：通过的用例数
函数 运行所有测试()
    整数 通过 = 0
    整数 失败 = 0
    列表 用例表 = 测试内部["用例"]
    对于 i 从 0 到 长度(用例表) - 1 循环
        字典 条目 = 用例表[i]
        字符串 名 = 条目["名字"]
        字典 r = {"出错": 0, "消息": ""}
        尝试
            条目["函数"]()
        捕获 err
            r["出错"] = 1
            r["消息"] = err["消息"]
        结束
        如果 r["出错"] == 1 则
            输出("✗ " + 名 + ": " + r["消息"])
            失败 = 失败 + 1
        否则
            输出("✓ " + 名)
            通过 = 通过 + 1
        结束
    结束
    输出("通过 " + 转字符串(通过) + "/" + 转字符串(长度(用例表)) + "，失败 " + 转字符串(失败))
    返回 通过
结束

# ---------------- 分级日志 ----------------
# 级别：调试 DEBUG=0 / 信息 INFO=1 / 警告 WARN=2 / 错误 ERROR=3
# 仅输出 级别值 >= 当前级别 的日志；低于当前级别的直接丢弃。
# 颜色默认关闭，调用 启用日志颜色(1) 后为各级别加 ANSI 转义配色。

# 日志级别常量字典：便于 设置日志级别(日志级别常量["调试"])
字典 日志级别常量 = {"调试": 0, "信息": 1, "警告": 2, "错误": 3}

# 日志内部：模块状态 —— "级别" 最低输出级别(默认信息=1)，"颜色" 是否ANSI配色(默认0关)
字典 日志内部 = {"级别": 1, "颜色": 0}

# 日志时间戳() -> 字符串：返回当前本地时间 HH:MM:SS
# 用系统 date 取本地时间；不走 格式化时间(时间戳())（浮点时间戳会被 date 当科学计数法拒绝）
函数 日志时间戳() -> 字符串
    字符串 s = 执行命令("date +%H:%M:%S")
    返回 s
结束

# 设置日志级别(级别)：设定最低输出级别（调试0/信息1/警告2/错误3）
# 例如 设置日志级别(0) 显示全部；设置日志级别(2) 只显示警告与错误
函数 设置日志级别(级别)
    日志内部["级别"] = 级别
结束

# 启用日志颜色(开关)：开关=1 开 ANSI 颜色，0 关（默认关，保证无颜色终端也正常显示）
函数 启用日志颜色(开关)
    日志内部["颜色"] = 开关
结束

# 日志内部["打印"](级别名, 级别值, 色号, 消息)：按级别过滤并输出一行日志
# 行格式：[级别] 时间 消息；开启颜色时包裹对应 ANSI 色码
日志内部["打印"] = 函数(字符串 级别名, 整数 级别值, 字符串 色号, 消息)
    如果 级别值 < 日志内部["级别"] 则
        返回
    结束
    字符串 行 = "[" + 级别名 + "] " + 日志时间戳() + " " + 转字符串(消息)
    如果 日志内部["颜色"] == 1 则
        字符串 转义 = 从ASCII(27)
        行 = 转义 + "[3" + 色号 + "m" + 行 + 转义 + "[0m"
    结束
    输出(行)
结束

# 日志调试(消息)：DEBUG(0) 级别日志；级别名 DEBUG，开启颜色时蓝色
# 消息可为任意值，内部自动 转字符串
函数 日志调试(消息)
    日志内部["打印"]("DEBUG", 0, "4", 消息)
结束

# 日志信息(消息)：INFO(1) 级别日志；开启颜色时绿色
函数 日志信息(消息)
    日志内部["打印"]("INFO", 1, "2", 消息)
结束

# 日志警告(消息)：WARN(2) 级别日志；开启颜色时黄色
函数 日志警告(消息)
    日志内部["打印"]("WARN", 2, "3", 消息)
结束

# 日志错误(消息)：ERROR(3) 级别日志；开启颜色时红色
函数 日志错误(消息)
    日志内部["打印"]("ERROR", 3, "1", 消息)
结束

# ============================================================
# 排序算法
# ============================================================

# 快速排序(列表) -> 列表：快速排序算法
函数 快速排序(列表 表) -> 列表
    如果 长度(表) <= 1 则
        返回 表
    结束
    让 基准 = 表[0]
    列表 小于 = []
    列表 等于 = []
    列表 大于 = []
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] < 基准 则
            追加(小于, 表[i])
        否则 如果 表[i] == 基准 则
            追加(等于, 表[i])
        否则
            追加(大于, 表[i])
        结束
    结束
    返回 快速排序(小于) + 等于 + 快速排序(大于)
结束

# 归并排序(列表) -> 列表：归并排序算法
函数 归并排序(列表 表) -> 列表
    如果 长度(表) <= 1 则
        返回 表
    结束
    让 中 = 长度(表) // 2
    让 左 = 归并排序(切片(表, 0, 中))
    让 右 = 归并排序(切片(表, 中, 长度(表)))
    列表 结果 = []
    让 i = 0
    让 j = 0
    当 i < 长度(左) 且 j < 长度(右) 循环
        如果 左[i] <= 右[j] 则
            追加(结果, 左[i])
            i = i + 1
        否则
            追加(结果, 右[j])
            j = j + 1
        结束
    结束
    当 i < 长度(左) 循环
        追加(结果, 左[i])
        i = i + 1
    结束
    当 j < 长度(右) 循环
        追加(结果, 右[j])
        j = j + 1
    结束
    返回 结果
结束

# 按函数排序(列表, 比较函数) -> 列表：按自定义比较函数排序
函数 按函数排序(列表 表, 比较) -> 列表
    列表 结果 = 切片(表, 0, 长度(表))
    对于 i 从 0 到 长度(结果) - 1 循环
        对于 j 从 0 到 长度(结果) - i - 2 循环
            如果 比较(结果[j + 1], 结果[j]) 则
                让 临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
        结束
    结束
    返回 结果
结束

# ============================================================
# 搜索算法
# ============================================================

# 线性搜索(列表, 元素) -> 整数：线性搜索，返回索引或-1
函数 线性搜索(列表 表, 元素) -> 整数
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 搜索所有(列表, 元素) -> 列表：返回所有匹配的索引
函数 搜索所有(列表 表, 元素) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] == 元素 则
            追加(结果, i)
        结束
    结束
    返回 结果
结束

# 二分搜索(列表, 元素) -> 整数：二分搜索（要求列表已排序）
函数 二分搜索(列表 表, 元素) -> 整数
    让 低 = 0
    让 高 = 长度(表) - 1
    当 低 <= 高 循环
        让 中 = (低 + 高) // 2
        如果 表[中] == 元素 则
            返回 中
        否则 如果 表[中] < 元素 则
            低 = 中 + 1
        否则
            高 = 中 - 1
        结束
    结束
    返回 -1
结束

# ============================================================
# 数学函数
# ============================================================

# 埃氏筛(整数) -> 列表：埃拉托斯特尼筛法求素数
函数 埃氏筛(整数 n) -> 列表
    如果 n < 2 则
        返回 []
    结束
    列表 是素数标记 = []
    对于 i 从 0 到 n - 1 循环
        追加(是素数标记, 真)
    结束
    是素数标记[0] = 假
    是素数标记[1] = 假
    对于 i 从 2 到 平方根(n) 循环
        如果 是素数标记[i] 则
            对于 j 从 i * i 到 n - 1 步长 i 循环
                是素数标记[j] = 假
            结束
        结束
    结束
    列表 结果 = []
    对于 i 从 2 到 n - 1 循环
        如果 是素数标记[i] 则
            追加(结果, i)
        结束
    结束
    返回 结果
结束

# 质因数分解(整数) -> 列表：返回质因数列表
函数 质因数分解(整数 n) -> 列表
    列表 结果 = []
    让 d = 2
    当 n > 1 循环
        当 n % d == 0 循环
            追加(结果, d)
            n = n // d
        结束
        d = d + 1
        如果 d * d > n 且 n > 1 则
            追加(结果, n)
            跳出
        结束
    结束
    返回 结果
结束

# 斐波那契列表(整数) -> 列表：返回前n个斐波那契数
函数 斐波那契列表(整数 n) -> 列表
    如果 n <= 0 则
        返回 []
    结束
    如果 n == 1 则
        返回 [0]
    结束
    列表 结果 = [0, 1]
    对于 i 从 2 到 n - 1 循环
        追加(结果, 结果[i - 1] + 结果[i - 2])
    结束
    返回 结果
结束

# 是完美数(整数) -> 布尔：判断是否为完美数
函数 是完美数(整数 n) -> 布尔
    如果 n <= 1 则
        返回 假
    结束
    让 和 = 1
    对于 i 从 2 到 平方根(n) 循环
        如果 n % i == 0 则
            和 = 和 + i
            如果 i != n // i 则
                和 = 和 + n // i
            结束
        结束
    结束
    返回 和 == n
结束

# 阿姆斯特朗数(整数) -> 布尔：判断是否为阿姆斯特朗数
函数 阿姆斯特朗数(整数 n) -> 布尔
    如果 n < 0 则
        返回 假
    结束
    字符串 s = 转字符串(n)
    让 位数 = 长度(s)
    让 和 = 0
    对于 i 从 0 到 位数 - 1 循环
        让 数字 = 转整数(切片(s, i, i + 1))
        和 = 和 + 幂(数字, 位数)
    结束
    返回 和 == n
结束

# 回文数(整数) -> 布尔：判断是否为回文数
函数 回文数(整数 n) -> 布尔
    如果 n < 0 则
        返回 假
    结束
    字符串 s = 转字符串(n)
    返回 s == 反转(s)
结束

# ============================================================
# 字符串函数
# ============================================================

# 单词列表(字符串) -> 列表：按空白分割字符串为单词列表
函数 单词列表(字符串 s) -> 列表
    列表 全部 = 分割(s, " ")
    列表 结果 = []
    对于 i 从 0 到 长度(全部) - 1 循环
        如果 长度(全部[i]) > 0 则
            追加(结果, 全部[i])
        结束
    结束
    返回 结果
结束

# 句子列表(字符串) -> 列表：按句号分割字符串为句子列表
函数 句子列表(字符串 s) -> 列表
    列表 部分 = 分割(s, "。")
    列表 结果 = []
    对于 i 从 0 到 长度(部分) - 1 循环
        如果 长度(部分[i]) > 0 则
            追加(结果, 部分[i] + "。")
        结束
    结束
    返回 结果
结束

# 首字母大写每个单词(字符串) -> 字符串：每个单词首字母大写
函数 首字母大写每个单词(字符串 s) -> 字符串
    列表 单词 = 分割(s, " ")
    列表 结果 = []
    对于 i 从 0 到 长度(单词) - 1 循环
        如果 长度(单词[i]) > 0 则
            字符串 首 = 大写(切片(单词[i], 0, 1))
            字符串 尾 = 切片(单词[i], 1, 长度(单词[i]))
            追加(结果, 首 + 尾)
        否则
            追加(结果, 单词[i])
        结束
    结束
    返回 连接(结果, " ")
结束

# 驼峰转下划线(字符串) -> 字符串：驼峰命名转下划线命名
函数 驼峰转下划线(字符串 s) -> 字符串
    字符串 结果 = ""
    对于 i 从 0 到 长度(s) - 1 循环
        字符串 c = 切片(s, i, i + 1)
        如果 c >= "A" 且 c <= "Z" 则
            如果 i > 0 则
                结果 = 结果 + "_"
            结束
            结果 = 结果 + 小写(c)
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 下划线转驼峰(字符串) -> 字符串：下划线命名转驼峰命名
函数 下划线转驼峰(字符串 s) -> 字符串
    列表 部分 = 分割(s, "_")
    字符串 结果 = 部分[0]
    对于 i 从 1 到 长度(部分) - 1 循环
        如果 长度(部分[i]) > 0 则
            字符串 首 = 大写(切片(部分[i], 0, 1))
            字符串 尾 = 切片(部分[i], 1, 长度(部分[i]))
            结果 = 结果 + 首 + 尾
        结束
    结束
    返回 结果
结束

# 缩短(字符串, 整数) -> 字符串：缩短字符串到指定长度，超出部分用...表示
函数 缩短(字符串 s, 整数 最大长度) -> 字符串
    如果 长度(s) <= 最大长度 则
        返回 s
    结束
    返回 切片(s, 0, 最大长度 - 3) + "..."
结束

# 包裹(字符串, 整数) -> 列表：按指定宽度包裹字符串为多行
函数 包裹(字符串 s, 整数 宽度) -> 列表
    列表 单词 = 分割(s, " ")
    列表 结果 = []
    字符串 当前行 = ""
    对于 i 从 0 到 长度(单词) - 1 循环
        如果 长度(当前行) == 0 则
            当前行 = 单词[i]
        否则 如果 长度(当前行) + 1 + 长度(单词[i]) <= 宽度 则
            当前行 = 当前行 + " " + 单词[i]
        否则
            追加(结果, 当前行)
            当前行 = 单词[i]
        结束
    结束
    如果 长度(当前行) > 0 则
        追加(结果, 当前行)
    结束
    返回 结果
结束

# 编辑距离(字符串, 字符串) -> 整数：计算两字符串的编辑距离
函数 编辑距离(字符串 a, 字符串 b) -> 整数
    让 m = 长度(a)
    让 n = 长度(b)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    对于 i 从 0 到 m 循环
        dp[i][0] = i
    结束
    对于 j 从 0 到 n 循环
        dp[0][j] = j
    结束
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 切片(a, i - 1, i) == 切片(b, j - 1, j) 则
                dp[i][j] = dp[i - 1][j - 1]
            否则
                dp[i][j] = 最小值(最小值(dp[i - 1][j], dp[i][j - 1]), dp[i - 1][j - 1]) + 1
            结束
        结束
    结束
    返回 dp[m][n]
结束

# 最长公共子串(字符串, 字符串) -> 字符串：返回最长公共子串
函数 最长公共子串(字符串 a, 字符串 b) -> 字符串
    让 m = 长度(a)
    让 n = 长度(b)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    让 最大长度 = 0
    让 结束位置 = 0
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 切片(a, i - 1, i) == 切片(b, j - 1, j) 则
                dp[i][j] = dp[i - 1][j - 1] + 1
                如果 dp[i][j] > 最大长度 则
                    最大长度 = dp[i][j]
                    结束位置 = i
                结束
            结束
        结束
    结束
    返回 切片(a, 结束位置 - 最大长度, 结束位置)
结束

# ============================================================
# 列表函数
# ============================================================

# 窗口(列表, 整数) -> 列表：滑动窗口
函数 窗口(列表 表, 整数 大小) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(表) - 大小 循环
        追加(结果, 切片(表, i, i + 大小))
    结束
    返回 结果
结束

# 累积结果(列表, 函数f) -> 列表：累积计算结果
函数 累积结果(列表 表, f) -> 列表
    如果 长度(表) == 0 则
        返回 []
    结束
    列表 结果 = [表[0]]
    对于 i 从 1 到 长度(表) - 1 循环
        追加(结果, f(结果[i - 1], 表[i]))
    结束
    返回 结果
结束

# 去重保持顺序(列表) -> 列表：去重但保持原有顺序
函数 去重保持顺序(列表 表) -> 列表
    列表 结果 = []
    字典 已见 = {}
    对于 i 从 0 到 长度(表) - 1 循环
        如果 非 包含(已见, 转字符串(表[i])) 则
            追加(结果, 表[i])
            已见[转字符串(表[i])] = 真
        结束
    结束
    返回 结果
结束

# 随机样本(列表, 整数) -> 列表：随机抽取指定数量的样本
函数 随机样本(列表 表, 整数 n) -> 列表
    列表 副本 = 切片(表, 0, 长度(表))
    打乱(副本)
    返回 切片(副本, 0, n)
结束

# 排列(列表) -> 列表：返回所有排列
函数 排列(列表 表) -> 列表
    如果 长度(表) <= 1 则
        返回 [表]
    结束
    列表 结果 = []
    对于 i 从 0 到 长度(表) - 1 循环
        列表 剩余 = []
        对于 j 从 0 到 长度(表) - 1 循环
            如果 j != i 则
                追加(剩余, 表[j])
            结束
        结束
        列表 子排列 = 排列(剩余)
        对于 k 从 0 到 长度(子排列) - 1 循环
            追加(结果, [表[i]] + 子排列[k])
        结束
    结束
    返回 结果
结束

# 取组合(列表, 整数) -> 列表：返回所有组合
函数 取组合(列表 表, 整数 k) -> 列表
    列表 结果 = []
    函数 回溯(开始, 当前)
        如果 长度(当前) == k 则
            追加(结果, 切片(当前, 0, 长度(当前)))
            返回
        结束
        对于 i 从 开始 到 长度(表) - 1 循环
            追加(当前, 表[i])
            回溯(i + 1, 当前)
            弹出(当前)
        结束
    结束
    回溯(0, [])
    返回 结果
结束

# 笛卡尔积(列表, 列表) -> 列表：返回两列表的笛卡尔积
函数 笛卡尔积(列表 a, 列表 b) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(a) - 1 循环
        对于 j 从 0 到 长度(b) - 1 循环
            追加(结果, [a[i], b[j]])
        结束
    结束
    返回 结果
结束

# 转置(列表) -> 列表：矩阵转置
函数 转置(列表 矩阵) -> 列表
    如果 长度(矩阵) == 0 则
        返回 []
    结束
    让 行数 = 长度(矩阵)
    让 列数 = 长度(矩阵[0])
    列表 结果 = []
    对于 j 从 0 到 列数 - 1 循环
        列表 新行 = []
        对于 i 从 0 到 行数 - 1 循环
            追加(新行, 矩阵[i][j])
        结束
        追加(结果, 新行)
    结束
    返回 结果
结束

# 展平(列表) -> 列表：展平一层嵌套
函数 展平(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(表) - 1 循环
        如果 类型(表[i]) == "列表" 则
            对于 j 从 0 到 长度(表[i]) - 1 循环
                追加(结果, 表[i][j])
            结束
        否则
            追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# 深度展平(列表) -> 列表：递归展平所有嵌套
函数 深度展平(列表 表) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(表) - 1 循环
        如果 类型(表[i]) == "列表" 则
            列表 子结果 = 深度展平(表[i])
            对于 j 从 0 到 长度(子结果) - 1 循环
                追加(结果, 子结果[j])
            结束
        否则
            追加(结果, 表[i])
        结束
    结束
    返回 结果
结束

# ============================================================
# 高阶函数
# ============================================================

# 管道(列表, 值) -> 值：将值依次通过函数列表
函数 管道(列表 函数列表, 初始值)
    让 结果 = 初始值
    对于 i 从 0 到 长度(函数列表) - 1 循环
        让 f = 函数列表[i]
        结果 = f(结果)
    结束
    返回 结果
结束

# 函数组合(函数, 函数) -> 函数：返回两函数的组合
函数 函数组合(f, g)
    返回 函数(x)
        返回 f(g(x))
    结束
结束

# 记忆化(函数) -> 函数：返回带缓存的函数
函数 记忆化(f)
    字典 缓存 = {}
    返回 函数(x)
        字符串 键 = 转字符串(x)
        如果 包含(缓存, 键) 则
            返回 缓存[键]
        结束
        让 结果 = f(x)
        缓存[键] = 结果
        返回 结果
    结束
结束

# 一次(函数) -> 函数：返回只执行一次的函数
函数 一次(f)
    字典 状态 = {"已执行": 假, "结果": 空}
    返回 函数(x)
        如果 非 状态["已执行"] 则
            状态["结果"] = f(x)
            状态["已执行"] = 真
        结束
        返回 状态["结果"]
    结束
结束

