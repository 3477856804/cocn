# ============================================================
# 词法分析器.co —— 自举版词法分析器（用 coCN 自身实现）
#
# 输入：coCN 源码字符串
# 输出：token 列表，每个 token 是字典：
#   {"类型": ..., "值": ..., "行": 整数, "列": 整数}
# 类型："整数" | "浮点" | "字符串" | "标识符" | "关键字" | "运算符" | "换行" | "文件结束"
#
# 移植自 原生编译器/词法分析器.js，语义保持一致。
# 注意：本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# ---------------- 字符分类辅助 ----------------

# 是否为十进制数字字符
函数 是数字(字符串 c) -> 布尔
    返回 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9"
结束

# 是否为运算符字符
函数 是操作符字符(字符串 c) -> 布尔
    返回 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" 或 c == "!" 或 c == "<" 或 c == ">" 或 c == "(" 或 c == ")" 或 c == "[" 或 c == "]" 或 c == "{" 或 c == "}" 或 c == "," 或 c == ":" 或 c == "&" 或 c == "|" 或 c == "^" 或 c == "~" 或 c == "."
结束

# 是否为关键字
函数 是关键字(字符串 词) -> 布尔
    返回 词 == "让" 或 词 == "整数" 或 词 == "浮点" 或 词 == "布尔" 或 词 == "字符串" 或 词 == "列表" 或 词 == "字典" 或 词 == "变量" 或 词 == "常量" 或 词 == "函数" 或 词 == "返回" 或 词 == "如果" 或 词 == "否则" 或 词 == "若" 或 词 == "当" 或 词 == "对于" 或 词 == "从" 或 词 == "到" 或 词 == "步长" 或 词 == "循环" 或 词 == "结束" 或 词 == "跳出" 或 词 == "继续" 或 词 == "真" 或 词 == "假" 或 词 == "且" 或 词 == "或" 或 词 == "非" 或 词 == "导入" 或 词 == "匹配" 或 词 == "是" 或 词 == "默认" 或 词 == "于" 或 词 == "在" 或 词 == "那么" 或 词 == "尝试" 或 词 == "捕获" 或 词 == "最终" 或 词 == "抛出" 或 词 == "并发" 或 词 == "等待" 或 词 == "则" 或 词 == "枚举" 或 词 == "结构体" 或 词 == "作为" 或 词 == "类" 或 词 == "继承" 或 词 == "继承自" 或 词 == "self" 或 词 == "自己" 或 词 == "super" 或 词 == "空"
结束

# ---------------- 词法分析主函数 ----------------

函数 词法分析(字符串 源) -> 列表
    列表 表 = []
    整数 n = 长度(源)
    整数 p = 0
    整数 行 = 1
    整数 列 = 1
    整数 行有内容 = 0

    当 p < n 循环
        字符串 c = 源[p]

        # 空白
        若 c == " " 或 c == "\t" 或 c == "\r"
            p = p + 1
            列 = 列 + 1
            继续
        结束

        # 注释
        若 c == "#"
            当 p < n 且 源[p] != "\n" 循环
                p = p + 1
                列 = 列 + 1
            结束
            继续
        结束

        # 换行
        若 c == "\n"
            若 行有内容 == 1
                追加(表, {"类型": "换行", "值": "\n", "行": 行, "列": 列})
            结束
            行 = 行 + 1
            列 = 1
            p = p + 1
            行有内容 = 0
            继续
        结束

        # 数字
        若 是数字(c)
            整数 记行 = 行
            整数 记列 = 列
            整数 起 = p
            布尔 浮 = 假
            当 p < n 且 是数字(源[p]) 循环
                p = p + 1
                列 = 列 + 1
            结束
            若 p < n 且 源[p] == "." 且 p + 1 < n 且 是数字(源[p + 1])
                浮 = 真
                p = p + 1
                列 = 列 + 1
                当 p < n 且 是数字(源[p]) 循环
                    p = p + 1
                    列 = 列 + 1
                结束
            结束
            若 p < n 且 (源[p] == "e" 或 源[p] == "E")
                整数 q = p + 1
                若 q < n 且 (源[q] == "+" 或 源[q] == "-")
                    q = q + 1
                结束
                若 q < n 且 是数字(源[q])
                    浮 = 真
                    p = p + 1
                    列 = 列 + 1
                    若 p < n 且 (源[p] == "+" 或 源[p] == "-")
                        p = p + 1
                        列 = 列 + 1
                    结束
                    当 p < n 且 是数字(源[p]) 循环
                        p = p + 1
                        列 = 列 + 1
                    结束
                结束
            结束
            字符串 词 = 截取(源, 起, p - 起)
            若 浮
                追加(表, {"类型": "浮点", "值": 词, "行": 记行, "列": 记列})
            否则
                追加(表, {"类型": "整数", "值": 词, "行": 记行, "列": 记列})
            结束
            行有内容 = 1
            继续
        结束

        # 字符串
        若 c == "\""
            整数 记行 = 行
            整数 记列 = 列
            p = p + 1
            列 = 列 + 1
            字符串 内容 = ""
            当 p < n 且 源[p] != "\"" 循环
                若 源[p] == "\\" 且 p + 1 < n
                    字符串 e = 源[p + 1]
                    若 e == "n"
                        内容 = 内容 + "\n"
                    否则 若 e == "t"
                        内容 = 内容 + "\t"
                    否则 若 e == "\""
                        内容 = 内容 + "\""
                    否则 若 e == "\\"
                        内容 = 内容 + "\\"
                    否则
                        内容 = 内容 + e
                    结束
                    p = p + 2
                    列 = 列 + 2
                否则
                    内容 = 内容 + 源[p]
                    p = p + 1
                    列 = 列 + 1
                结束
            结束
            若 p < n 且 源[p] == "\""
                p = p + 1
                列 = 列 + 1
            结束
            追加(表, {"类型": "字符串", "值": 内容, "行": 记行, "列": 记列})
            行有内容 = 1
            继续
        结束

        # 运算符
        若 是操作符字符(c)
            整数 记行 = 行
            整数 记列 = 列
            字符串 词 = c
            若 c == "-" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = "->"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "*" 且 p + 1 < n 且 源[p + 1] == "*"
                词 = "**"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "/" 且 p + 1 < n 且 源[p + 1] == "/"
                词 = "//"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "=" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "=="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "!" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "!="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "<" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "<="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "<" 且 p + 1 < n 且 源[p + 1] == "<"
                词 = "<<"
                p = p + 2
                列 = 列 + 2
            否则 若 c == ">" 且 p + 1 < n 且 源[p + 1] == "="
                词 = ">="
                p = p + 2
                列 = 列 + 2
            否则 若 c == ">" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = ">>"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "." 且 p + 2 < n 且 源[p + 1] == "." 且 源[p + 2] == "."
                词 = "..."
                p = p + 3
                列 = 列 + 3
            否则
                p = p + 1
                列 = 列 + 1
            结束
            追加(表, {"类型": "运算符", "值": 词, "行": 记行, "列": 记列})
            行有内容 = 1
            继续
        结束

        # 标识符 / 关键字
        整数 记行 = 行
        整数 记列 = 列
        整数 起 = p
        当 p < n 循环
            字符串 cc = 源[p]
            若 cc == " " 或 cc == "\t" 或 cc == "\r" 或 cc == "\n"
                跳出
            结束
            若 cc == "#" 或 cc == "\""
                跳出
            结束
            若 是操作符字符(cc)
                跳出
            结束
            p = p + 1
            列 = 列 + 1
        结束
        字符串 词 = 截取(源, 起, p - 起)
        若 词 == "按位与"
            追加(表, {"类型": "运算符", "值": "&", "行": 记行, "列": 记列})
        否则 若 词 == "按位或"
            追加(表, {"类型": "运算符", "值": "|", "行": 记行, "列": 记列})
        否则 若 词 == "按位异或"
            追加(表, {"类型": "运算符", "值": "^", "行": 记行, "列": 记列})
        否则 若 词 == "按位取反"
            追加(表, {"类型": "运算符", "值": "~", "行": 记行, "列": 记列})
        否则 若 词 == "左移"
            追加(表, {"类型": "运算符", "值": "<<", "行": 记行, "列": 记列})
        否则 若 词 == "右移"
            追加(表, {"类型": "运算符", "值": ">>", "行": 记行, "列": 记列})
        否则 若 是关键字(词)
            追加(表, {"类型": "关键字", "值": 词, "行": 记行, "列": 记列})
        否则
            追加(表, {"类型": "标识符", "值": 词, "行": 记行, "列": 记列})
        结束
        行有内容 = 1
    结束

    追加(表, {"类型": "文件结束", "值": "", "行": 行, "列": 列})
    返回 表
结束
# ============================================================
# 语法分析器.co —— 自举版递归下降语法分析器
#
# 输入：词法分析器产出的 token 列表
# 输出：AST 程序节点 {"类型": "程序", "语句": [...]}
#
# 移植自 原生编译器/语法分析器.js。
# 注意：无空值类型，用 {"类型": "空值"} 作 null 哨兵节点。
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# ---------------- 模块状态 ----------------
让 g_tokens = []
让 g_pos = 0

# ---------------- 词法游标辅助 ----------------

函数 词类() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 "文件结束"
    结束
    返回 g_tokens[g_pos]["类型"]
结束

函数 词值() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 ""
    结束
    返回 g_tokens[g_pos]["值"]
结束

函数 行号() -> 整数
    若 g_pos >= 长度(g_tokens)
        返回 0
    结束
    返回 g_tokens[g_pos]["行"]
结束

函数 前进()
    g_pos = g_pos + 1
结束

函数 报错(字符串 消息)
    输出错误("语法错误 (第" + 转字符串(行号()) + "行): " + 消息 + "，得到 '" + 词值() + "'")
    断言(假, "语法分析失败")
结束

函数 期望关键字(字符串 期望)
    若 词类() != "关键字" 或 词值() != 期望
        报错("期望关键字 '" + 期望 + "'")
    结束
    前进()
结束

函数 期望运算符(字符串 期望)
    若 词类() != "运算符" 或 词值() != 期望
        报错("期望运算符 '" + 期望 + "'")
    结束
    前进()
结束

# ---------------- 谓词辅助 ----------------

函数 是类型关键字(字符串 k) -> 布尔
    返回 k == "整数" 或 k == "浮点" 或 k == "布尔" 或 k == "字符串" 或 k == "列表" 或 k == "字典"
结束

函数 是结束() -> 布尔
    返回 词类() == "关键字" 且 词值() == "结束"
结束

函数 是分支头() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "否则"
结束

函数 是语句结束() -> 布尔
    若 词类() == "换行"
        返回 真
    结束
    若 词类() == "文件结束"
        返回 真
    结束
    若 是结束()
        返回 真
    结束
    返回 是分支头()
结束

函数 是则() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "则" 或 词值() == "那么"
结束

函数 跳过换行()
    当 词类() == "换行" 循环
        前进()
    结束
结束

# ---------------- 表达式层 ----------------

函数 解析主要() -> 字典
    若 词类() == "整数"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "整数"}
        前进()
        返回 n
    结束
    若 词类() == "浮点"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "浮点"}
        前进()
        返回 n
    结束
    若 词类() == "字符串"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "字符串"}
        前进()
        返回 n
    结束
    若 词类() == "关键字" 且 词值() == "真"
        前进()
        返回 {"类型": "字面量", "值": "1", "字面类型": "布尔"}
    结束
    若 词类() == "关键字" 且 词值() == "假"
        前进()
        返回 {"类型": "字面量", "值": "0", "字面类型": "布尔"}
    结束
    若 词类() == "关键字" 且 词值() == "空"
        前进()
        返回 {"类型": "字面量", "值": "", "字面类型": "空"}
    结束
    若 词类() == "标识符"
        字典 n = {"类型": "标识符", "名字": 词值()}
        前进()
        返回 n
    结束
    若 词类() == "运算符" 且 词值() == "("
        前进()
        若 词类() == "运算符" 且 词值() == ")"
            前进()
            返回 {"类型": "元组字面量", "元素": []}
        结束
        字典 首个 = 解析或()
        若 词类() == "运算符" 且 词值() == ","
            列表 元素 = [首个]
            当 词类() == "运算符" 且 词值() == "," 循环
                前进()
                若 词类() == "运算符" 且 词值() == ")"
                    跳出
                结束
                追加(元素, 解析或())
            结束
            期望运算符(")")
            返回 {"类型": "元组字面量", "元素": 元素}
        结束
        期望运算符(")")
        返回 首个
    结束
    若 词类() == "运算符" 且 词值() == "["
        返回 解析列表字面量()
    结束
    若 词类() == "运算符" 且 词值() == "{"
        返回 解析字典字面量()
    结束
    若 词类() == "关键字" 且 词值() == "self" 或 词类() == "关键字" 且 词值() == "自己"
        字典 n = {"类型": "标识符", "名字": 词值()}
        前进()
        返回 n
    结束
    若 是结束()
        报错("多余的 '结束'")
    结束
    报错("意外的表达式记号")
    返回 {"类型": "空值"}
结束

函数 解析列表字面量() -> 字典
    前进()
    若 词类() == "运算符" 且 词值() == "]"
        前进()
        返回 {"类型": "列表字面量", "元素": [], "是否推导式": 0}
    结束
    字典 首个 = 解析或()
    列表 元素 = [首个]
    当 词类() == "运算符" 且 词值() == "," 循环
        前进()
        若 词类() == "运算符" 且 词值() == "]"
            跳出
        结束
        追加(元素, 解析或())
    结束
    期望运算符("]")
    返回 {"类型": "列表字面量", "元素": 元素, "是否推导式": 0}
结束

函数 解析字典字面量() -> 字典
    前进()
    若 词类() == "运算符" 且 词值() == "}"
        前进()
        返回 {"类型": "字典字面量", "键": [], "值": []}
    结束
    列表 键表 = []
    列表 值表 = []
    当 词类() != "文件结束" 循环
        若 词类() == "运算符" 且 词值() == "}"
            跳出
        结束
        字典 k = {"类型": "空值"}
        若 词类() == "字符串"
            k = {"类型": "字面量", "值": 词值(), "字面类型": "字符串"}
            前进()
        否则
            k = 解析或()
            若 k["类型"] == "标识符"
                k = {"类型": "字面量", "值": k["名字"], "字面类型": "字符串"}
            结束
        结束
        期望运算符(":")
        字典 v = 解析或()
        追加(键表, k)
        追加(值表, v)
        若 词类() == "运算符" 且 词值() == ","
            前进()
        结束
    结束
    期望运算符("}")
    返回 {"类型": "字典字面量", "键": 键表, "值": 值表}
结束

函数 解析后缀() -> 字典
    字典 n = 解析主要()
    整数 变 = 1
    当 变 == 1 循环
        整数 消费 = 0
        若 词类() == "运算符" 且 词值() == "("
            消费 = 1
            前进()
            列表 参数 = []
            若 非 (词类() == "运算符" 且 词值() == ")")
                当 真 循环
                    追加(参数, 解析或())
                    若 词类() == "运算符" 且 词值() == ","
                        前进()
                        继续
                    结束
                    跳出
                结束
            结束
            期望运算符(")")
            n = {"类型": "函数调用", "被调者": n, "参数": 参数}
        结束
        若 词类() == "运算符" 且 词值() == "["
            消费 = 1
            前进()
            字典 idx = 解析或()
            期望运算符("]")
            n = {"类型": "下标", "容器": n, "索引": idx}
        结束
        若 词类() == "运算符" 且 词值() == "."
            消费 = 1
            前进()
            若 词类() != "标识符"
                报错("成员访问 '.' 后需要标识符")
            结束
            字符串 成员名 = 词值()
            前进()
            n = {"类型": "下标", "容器": n, "索引": {"类型": "字面量", "值": 成员名, "字面类型": "字符串"}}
        结束
        若 消费 == 0
            变 = 0
        结束
    结束
    返回 n
结束

函数 解析一元() -> 字典
    若 词类() == "运算符" 且 (词值() == "-" 或 词值() == "+")
        字符串 op = 词值()
        前进()
        返回 {"类型": "一元", "运算符": op, "操作数": 解析一元()}
    结束
    若 词类() == "关键字" 且 词值() == "非"
        前进()
        返回 {"类型": "一元", "运算符": "非", "操作数": 解析一元()}
    结束
    若 词类() == "运算符" 且 词值() == "~"
        前进()
        返回 {"类型": "一元", "运算符": "~", "操作数": 解析一元()}
    结束
    返回 解析后缀()
结束

函数 解析幂() -> 字典
    字典 左 = 解析一元()
    若 词类() == "运算符" 且 词值() == "**"
        前进()
        字典 右 = 解析幂()
        返回 {"类型": "二元", "运算符": "**", "左": 左, "右": 右}
    结束
    返回 左
结束

函数 解析乘除模() -> 字典
    字典 左 = 解析幂()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "*" 或 词值() == "/" 或 词值() == "%" 或 词值() == "//")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析幂()}
    结束
    返回 左
结束

函数 解析加减() -> 字典
    字典 左 = 解析乘除模()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "+" 或 词值() == "-")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析乘除模()}
    结束
    返回 左
结束

函数 解析移位() -> 字典
    字典 左 = 解析加减()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<<" 或 词值() == ">>")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析加减()}
    结束
    返回 左
结束

函数 解析关系() -> 字典
    字典 左 = 解析移位()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<" 或 词值() == ">" 或 词值() == "<=" 或 词值() == ">=")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析移位()}
    结束
    返回 左
结束

函数 解析相等() -> 字典
    字典 左 = 解析关系()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "==" 或 词值() == "!=")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析关系()}
    结束
    返回 左
结束

函数 解析位与() -> 字典
    字典 左 = 解析相等()
    当 词类() == "运算符" 且 词值() == "&" 循环
        前进()
        左 = {"类型": "二元", "运算符": "&", "左": 左, "右": 解析相等()}
    结束
    返回 左
结束

函数 解析位异或() -> 字典
    字典 左 = 解析位与()
    当 词类() == "运算符" 且 词值() == "^" 循环
        前进()
        左 = {"类型": "二元", "运算符": "^", "左": 左, "右": 解析位与()}
    结束
    返回 左
结束

函数 解析位或() -> 字典
    字典 左 = 解析位异或()
    当 词类() == "运算符" 且 词值() == "|" 循环
        前进()
        左 = {"类型": "二元", "运算符": "|", "左": 左, "右": 解析位异或()}
    结束
    返回 左
结束

函数 解析且() -> 字典
    字典 左 = 解析位或()
    当 词类() == "关键字" 且 词值() == "且" 循环
        前进()
        左 = {"类型": "二元", "运算符": "且", "左": 左, "右": 解析位或()}
    结束
    返回 左
结束

函数 解析或() -> 字典
    字典 左 = 解析且()
    当 词类() == "关键字" 且 词值() == "或" 循环
        前进()
        左 = {"类型": "二元", "运算符": "或", "左": 左, "右": 解析且()}
    结束
    返回 左
结束

# ---------------- 语句层 ----------------

函数 解析变量声明() -> 字典
    字符串 标注 = ""
    字符串 头 = 词值()
    若 头 == "让" 或 头 == "变量" 或 头 == "常量"
        前进()
    结束
    若 词类() == "关键字" 且 是类型关键字(词值())
        标注 = 词值()
        前进()
    结束
    若 词类() != "标识符"
        报错("变量声明需要标识符")
    结束
    字符串 名 = 词值()
    前进()
    字典 初始化 = {"类型": "空值"}
    若 词类() == "运算符" 且 词值() == "="
        前进()
        初始化 = 解析或()
    结束
    返回 {"类型": "变量声明", "名字": 名, "类型标注": 标注, "初始化": 初始化}
结束

函数 解析返回() -> 字典
    前进()
    字典 v = {"类型": "空值"}
    若 词类() != "换行" 且 词类() != "文件结束" 且 非 是结束() 且 非 是分支头()
        v = 解析或()
    结束
    返回 {"类型": "返回", "值": v}
结束

函数 解析如果() -> 字典
    前进()
    字典 条件 = 解析或()
    若 是则()
        前进()
    结束
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    列表 则体 = 解析分支体()
    列表 否则链 = []
    当 是分支头() 循环
        字典 分支条件 = {"类型": "空值"}
        字符串 v = 词值()
        若 v == "否则"
            前进()
            若 词类() == "关键字" 且 (词值() == "如果" 或 词值() == "若")
                前进()
                分支条件 = 解析或()
            结束
        结束
        若 是则()
            前进()
        结束
        列表 分支体 = 解析分支体()
        追加(否则链, {"条件": 分支条件, "体": 分支体})
    结束
    若 块形式 == 1
        若 非 是结束()
            报错("如果 块缺少 结束")
        结束
        前进()
    否则
        若 是结束()
            前进()
        结束
    结束
    返回 {"类型": "如果", "条件": 条件, "则体": 则体, "否则链": 否则链}
结束

函数 解析分支体() -> 列表
    列表 体 = []
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    若 块形式 == 1
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 是分支头() 或 是结束()
                跳出
            结束
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
    否则
        跳过换行()
        若 非 (是分支头() 或 是结束())
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
    结束
    返回 体
结束

函数 解析当() -> 字典
    前进()
    字典 条件 = 解析或()
    期望关键字("循环")
    列表 体 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体, st)
        结束
    结束
    若 非 是结束()
        报错("当 循环缺少 结束")
    结束
    前进()
    返回 {"类型": "当", "条件": 条件, "体": 体}
结束

函数 解析对于() -> 字典
    前进()
    若 词类() == "关键字" 且 是类型关键字(词值())
        前进()
    结束
    若 词类() != "标识符"
        报错("对于 循环需要标识符")
    结束
    字符串 变量名 = 词值()
    前进()
    # for-each 形式
    若 词类() == "关键字" 且 (词值() == "在" 或 词值() == "于")
        前进()
        字典 容器节点 = 解析或()
        期望关键字("循环")
        列表 体 = []
        当 非 是结束() 且 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
        若 非 是结束()
            报错("对于 循环缺少 结束")
        结束
        前进()
        返回 {"类型": "对于", "变量": 变量名, "遍历源": 容器节点, "体": 体, "是否遍历": 1}
    结束
    # 范围形式
    期望关键字("从")
    字典 起点 = 解析或()
    期望关键字("到")
    字典 终点 = 解析或()
    字典 步长值 = {"类型": "空值"}
    若 词类() == "关键字" 且 词值() == "步长"
        前进()
        步长值 = 解析或()
    结束
    期望关键字("循环")
    列表 体 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体, st)
        结束
    结束
    若 非 是结束()
        报错("对于 循环缺少 结束")
    结束
    前进()
    返回 {"类型": "对于", "变量": 变量名, "起点": 起点, "终点": 终点, "步长": 步长值, "体": 体}
结束

函数 解析函数定义() -> 字典
    前进()
    若 词类() != "标识符"
        报错("函数定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    期望运算符("(")
    列表 参数 = []
    列表 参数类型 = []
    列表 参数默认 = []
    若 非 (词类() == "运算符" 且 词值() == ")")
        当 非 (词类() == "运算符" 且 词值() == ")") 且 词类() != "文件结束" 循环
            字符串 pt = ""
            若 词类() == "关键字" 且 是类型关键字(词值())
                pt = 词值()
                前进()
            结束
            若 词类() == "运算符" 且 词值() == "..."
                pt = "可变"
                前进()
            结束
            若 词类() != "标识符"
                报错("函数参数需要标识符")
            结束
            追加(参数, 词值())
            追加(参数类型, pt)
            前进()
            字典 默认值 = {"类型": "空值"}
            若 词类() == "运算符" 且 词值() == "="
                前进()
                默认值 = 解析或()
            结束
            追加(参数默认, 默认值)
            若 词类() == "运算符" 且 词值() == ","
                前进()
            结束
        结束
    结束
    期望运算符(")")
    字符串 返回类型 = ""
    若 词类() == "运算符" 且 词值() == "->"
        前进()
        若 词类() == "关键字" 且 是类型关键字(词值())
            返回类型 = 词值()
            前进()
        否则
            报错("函数返回类型标注无效")
        结束
    结束
    列表 体语句 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体语句, st)
        结束
    结束
    若 非 是结束()
        报错("函数定义缺少 结束")
    结束
    前进()
    字典 体 = {"类型": "程序", "语句": 体语句}
    返回 {"类型": "函数定义", "名字": 名, "参数": 参数, "参数类型": 参数类型, "参数默认": 参数默认, "返回类型": 返回类型, "体": 体}
结束

函数 解析语句() -> 字典
    若 词类() == "换行"
        前进()
        返回 {"类型": "空值"}
    结束
    若 词类() == "文件结束"
        返回 {"类型": "空值"}
    结束
    若 词类() == "关键字"
        字符串 k = 词值()
        若 k == "让" 或 k == "变量" 或 k == "常量"
            返回 解析变量声明()
        结束
        若 是类型关键字(k)
            返回 解析变量声明()
        结束
        若 k == "函数"
            返回 解析函数定义()
        结束
        若 k == "返回"
            返回 解析返回()
        结束
        若 k == "如果" 或 k == "若"
            返回 解析如果()
        结束
        若 k == "当"
            返回 解析当()
        结束
        若 k == "对于"
            返回 解析对于()
        结束
        若 k == "跳出"
            前进()
            返回 {"类型": "跳出"}
        结束
        若 k == "继续"
            前进()
            返回 {"类型": "继续"}
        结束
        若 k == "抛出"
            前进()
            返回 {"类型": "抛出", "值": 解析或()}
        结束
        若 k == "导入"
            前进()
            若 词类() != "字符串"
                报错("导入需要字符串路径")
            结束
            字符串 p = 词值()
            前进()
            返回 {"类型": "导入", "路径": p}
        结束
    结束
    字典 左 = 解析或()
    若 词类() == "运算符" 且 词值() == "="
        前进()
        字典 v = 解析或()
        返回 {"类型": "赋值", "目标": 左, "值": v}
    结束
    # 命令式无括号调用：输出 x
    若 左["类型"] == "标识符" 且 非 是语句结束()
        列表 参数 = [解析或()]
        当 词类() == "运算符" 且 词值() == "," 循环
            前进()
            追加(参数, 解析或())
        结束
        返回 {"类型": "函数调用", "被调者": 左, "参数": 参数}
    结束
    返回 左
结束

# ---------------- 顶层入口 ----------------

函数 语法分析(列表 tokens) -> 字典
    g_tokens = tokens
    g_pos = 0
    列表 语句表 = []
    当 词类() != "文件结束" 循环
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(语句表, st)
        结束
    结束
    返回 {"类型": "程序", "语句": 语句表}
结束

函数 解析源(字符串 源) -> 字典
    列表 tokens = 词法分析(源)
    返回 语法分析(tokens)
结束
# ============================================================
# 输出JSON.co —— 把 AST 字典/列表结构序列化为 JSON 字符串
#
# 规则：
#   - 字典 → {"键": 值, ...}
#   - 列表 → [值, 值, ...]
#   - 字符串 → "转义字符串"
#   - 整数 → 数字字面量
#   - 浮点 → 数字字面量
#   - {"类型": "空值"} → null
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 转义字符串为 JSON 字符串字面量内容（不含外层引号）
函数 转义JSON字符串(字符串 s) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(s)
    对于 i 从 0 到 n - 1 循环
        字符串 c = s[i]
        若 c == "\""
            结果 = 结果 + "\\\""
        否则 若 c == "\\"
            结果 = 结果 + "\\\\"
        否则 若 c == "\n"
            结果 = 结果 + "\\n"
        否则 若 c == "\t"
            结果 = 结果 + "\\t"
        否则 若 c == "\r"
            结果 = 结果 + "\\r"
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 判断是否为空值哨兵节点 {"类型": "空值"}
函数 是空值节点(v) -> 布尔
    若 类型(v) != "字典"
        返回 假
    结束
    若 包含(v, "类型")
        若 v["类型"] == "空值"
            返回 真
        结束
    结束
    返回 假
结束

# 递归序列化任意值为 JSON 字符串
函数 序列化JSON(v) -> 字符串
    # 空值哨兵 → null
    若 是空值节点(v)
        返回 "null"
    结束

    字符串 t = 类型(v)

    # 字典 → 对象
    若 t == "字典"
        列表 ks = 键(v)
        字符串 结果 = "{"
        整数 len = 长度(ks)
        对于 i 从 0 到 len - 1 循环
            字符串 k = ks[i]
            若 i > 0
                结果 = 结果 + ","
            结束
            结果 = 结果 + "\"" + 转义JSON字符串(k) + "\":" + 序列化JSON(v[k])
        结束
        结果 = 结果 + "}"
        返回 结果
    结束

    # 列表 → 数组
    若 t == "列表"
        字符串 结果 = "["
        整数 len = 长度(v)
        对于 i 从 0 到 len - 1 循环
            若 i > 0
                结果 = 结果 + ","
            结束
            结果 = 结果 + 序列化JSON(v[i])
        结束
        结果 = 结果 + "]"
        返回 结果
    结束

    # 字符串 → 带引号
    若 t == "字符串"
        返回 "\"" + 转义JSON字符串(v) + "\""
    结束

    # 整数 → 数字
    若 t == "整数"
        返回 转字符串(v)
    结束

    # 浮点 → 数字
    若 t == "浮点"
        返回 转字符串(v)
    结束

    # 其他类型（布尔等）→ 转字符串兜底
    返回 转字符串(v)
结束
# ============================================================
# 代码生成器.co —— 自举版 x86-64 (AT&T) 后端
#
# 输入：AST 字典/列表（与 语法分析器.co 产出一致）
# 输出：x86-64 AT&T 汇编字符串
#
# 设计（移植自 原生编译器/性能测试/_toolchain/代码生成器.js）：
#   * System V AMD64 ABI：rdi/rsi/rdx/rcx/r8/r9 传整型/指针，
#     xmm0-7 传浮点，rax/xmm0 返回。
#   * 栈式局部变量：每个变量一个 8 字节栈家槽，rbp 帧指针。
#   * 临时槽固定池：局部槽从 -8 起向下，临时槽从 -520 起（tempBase=64），
#     用 tempSP 栈式分配/释放；栈帧固定 1024 字节（16 字节对齐）。
#   * 类型特化：int→GPR，double→SSE2，str/list/dict/box→指针。
#   * 列表/字典元素为 Box 指针（rt_box_int / rt_unbox_int 等装箱拆箱）。
#
# 表达式约定：生成表达式(节点) 返回种类字符串，结果在
#   rax（int/str/list/dict/box/指针）或 xmm0（double）。
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# ---------------- 常量 ----------------
# 前 6 个整型/指针参数寄存器
让 ARG_INT = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
# 前 8 个浮点参数寄存器（xmm1 在算术时作临时，调用前已用完）
让 ARG_XMM = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"]
# 临时槽池基址（局部槽 0..63 之后）
让 TEMP_BASE = 64
# 帧大小（字节）：128 槽 * 8 = 1024，16 字节对齐
让 帧大小 = 1024

# ---------------- 全局输出状态 ----------------
让 g函数行 = {}        # 函数 label -> 指令行列表
让 g函数表 = {}        # coCN 函数名 -> label
让 g函数种类 = {}      # coCN 函数名 -> 返回种类（int/double/str/...），供调用点推断
让 g函数形参 = {}      # coCN 函数名 -> 形参种类列表 ["int"/"str"/...]
让 g函数默认 = {}      # coCN 函数名 -> 参数默认值节点列表（空值节点表示无默认）
让 g函数可变 = {}      # coCN 函数名 -> 1 表示含可变参数
让 g捕获表 = {}        # 闭包函数名 -> {"捕获变量名": 环境槽下标}
让 g当前捕获 = {}      # 当前正在生成的函数的捕获映射
让 g当前函数名 = ""    # 当前正在生成的函数名
让 g函数数 = 0
让 g标号数 = 0
让 g串行 = []          # .rodata 行
让 g串表 = {}          # 字符串字面量 -> label
让 g串数 = 0
让 g双表 = {}          # 浮点字面量 -> label
让 g双数 = 0

# ---------------- 当前函数状态 ----------------
让 g偏移 = {}          # 变量名 -> 栈偏移（负整数）
让 g种类 = {}          # 变量名 -> 种类字符串
让 g槽数 = 0           # 局部槽计数
让 g临时sp = 0         # 临时栈指针
让 g跳出栈 = []        # 跳出 label 栈
让 g继续栈 = []        # 继续 label 栈
让 g返回类 = "int"     # 当前函数返回种类
让 g活动 = []          # 当前活动输出列表（引用）
让 g发出辅助 = 0       # 是否已发出运行时辅助块（rt_str_sub 等）

# ---------------- 基础工具 ----------------

# 把一行指令追加到活动输出
函数 发出(字符串 l)
    追加(g活动, l)
结束

# 新唯一分支标号
函数 新标号() -> 字符串
    g标号数 = g标号数 + 1
    返回 ".L" + 转字符串(g标号数)
结束

# 把汇编字符串字面量转义（" \ \n \t）
# 注意：自举词法分析器把 \r 词法化为字母 r，故不能用 c=="\r" 判断；
# 真实 CR 字节极少，直接透传给 GNU as 即可。
函数 转义汇编串(字符串 s) -> 字符串
    字符串 r = ""
    整数 n = 长度(s)
    对于 i 从 0 到 n - 1 循环
        字符串 c = s[i]
        若 c == "\\"
            r = r + "\\\\"
        否则 若 c == "\""
            r = r + "\\\""
        否则 若 c == "\n"
            r = r + "\\n"
        否则 若 c == "\t"
            r = r + "\\t"
        否则
            r = r + c
        结束
    结束
    返回 r
结束

# 字符串常量 -> label（去重）
函数 串常量(字符串 s) -> 字符串
    若 包含(g串表, s)
        返回 g串表[s]
    结束
    字符串 lbl = ".LC" + 转字符串(g串数)
    g串数 = g串数 + 1
    g串表[s] = lbl
    追加(g串行, lbl + ":")
    追加(g串行, ".string \"" + 转义汇编串(s) + "\"")
    返回 lbl
结束

# 浮点常量 -> label（去重）
函数 双常量(字符串 d) -> 字符串
    若 包含(g双表, d)
        返回 g双表[d]
    结束
    字符串 lbl = ".LCD" + 转字符串(g双数)
    g双数 = g双数 + 1
    g双表[d] = lbl
    追加(g串行, lbl + ":")
    追加(g串行, ".double " + d)
    返回 lbl
结束

# 判断是否为空值哨兵节点 {"类型": "空值"}
函数 是空节点(v) -> 布尔
    若 类型(v) != "字典"
        返回 假
    结束
    若 包含(v, "类型")
        若 v["类型"] == "空值"
            返回 真
        结束
    结束
    返回 假
结束

# 类型标注字符串 -> 内部种类
函数 标注种类(字符串 a) -> 字符串
    若 a == "整数" 或 a == "布尔"
        返回 "int"
    结束
    若 a == "浮点"
        返回 "double"
    结束
    若 a == "字符串"
        返回 "str"
    结束
    若 a == "列表"
        返回 "list"
    结束
    若 a == "字典"
        返回 "dict"
    结束
    返回 "none"
结束

# 推断形参种类：优先类型标注；无标注时从默认值字面量推断（字符串->str，浮点->double）
函数 推断参数种类(字符串 pt, 字典 默认节点) -> 字符串
    若 pt == "可变"
        返回 "list"
    结束
    字符串 k = 标注种类(pt)
    若 k != "none"
        返回 k
    结束
    若 非 是空节点(默认节点)
        若 默认节点["类型"] == "字面量"
            字符串 lt = 默认节点["字面类型"]
            若 lt == "字符串"
                返回 "str"
            结束
            若 lt == "浮点"
                返回 "double"
            结束
        结束
    结束
    返回 "int"
结束

# ---------------- 槽位分配 ----------------

# 分配一个局部变量槽，返回偏移（负整数）
函数 分配槽(字符串 名, 字符串 k) -> 整数
    若 包含(g偏移, 名)
        返回 g偏移[名]
    结束
    整数 off = -8 * (g槽数 + 1)
    g偏移[名] = off
    g种类[名] = k
    g槽数 = g槽数 + 1
    返回 off
结束

# 读取变量的种类（未知名默认 int）
函数 变量种类(字符串 名) -> 字符串
    若 包含(g种类, 名)
        返回 g种类[名]
    结束
    返回 "int"
结束

# 新临时槽，返回偏移（负整数）
函数 新临时() -> 整数
    整数 idx = TEMP_BASE + g临时sp
    g临时sp = g临时sp + 1
    返回 -8 * (idx + 1)
结束

# 释放 n 个临时槽
函数 释放临时(整数 n)
    g临时sp = g临时sp - n
结束

# ---------------- 存值到槽 ----------------

# 按种类把 rax/xmm0 的值存到给定偏移槽
函数 存到槽(整数 off, 字符串 k)
    若 k == "double"
        发出("movsd %xmm0, " + 转字符串(off) + "(%rbp)")
    否则
        发出("mov %rax, " + 转字符串(off) + "(%rbp)")
    结束
结束

# 按种类从给定偏移槽读到 rax/xmm0
# 返回读到的种类
函数 从槽读(整数 off, 字符串 k) -> 字符串
    若 k == "double"
        发出("movsd " + 转字符串(off) + "(%rbp), %xmm0")
    否则
        发出("mov " + 转字符串(off) + "(%rbp), %rax")
    结束
    返回 k
结束

# ---------------- 装箱 ----------------

# 把当前 rax/xmm0 的值装箱，结果 rax = Box*；返回 "box"
函数 装箱(字符串 k) -> 字符串
    若 k == "box"
        返回 "box"
    结束
    若 k == "int"
        发出("mov %rax, %rdi")
        发出("call rt_box_int")
    否则 若 k == "double"
        发出("call rt_box_double")
    否则 若 k == "str"
        发出("mov %rax, %rdi")
        发出("call rt_box_str")
    否则 若 k == "list"
        发出("mov %rax, %rsi")
        发出("mov $3, %rdi")
        发出("call rt_box_ptr")
    否则 若 k == "dict"
        发出("mov %rax, %rsi")
        发出("mov $4, %rdi")
        发出("call rt_box_ptr")
    否则
        发出("mov $0, %rdi")
        发出("call rt_box_int")
    结束
    返回 "box"
结束

# ---------------- 语句 ----------------

函数 生成语句(字典 st)
    字符串 t = st["类型"]
    若 t == "变量声明"
        生成变量声明(st)
    否则 若 t == "赋值"
        生成赋值(st)
    否则 若 t == "返回"
        生成返回(st)
    否则 若 t == "如果"
        生成如果(st)
    否则 若 t == "当"
        生成当(st)
    否则 若 t == "对于"
        生成对于(st)
    否则 若 t == "跳出"
        发出("jmp " + g跳出栈[长度(g跳出栈) - 1])
    否则 若 t == "继续"
        发出("jmp " + g继续栈[长度(g继续栈) - 1])
    否则 若 t == "函数调用"
        生成表达式(st)
    否则 若 t == "函数定义"
        # 嵌套函数定义：构造闭包块并保存到同名局部槽
        生成嵌套函数定义(st)
    否则 若 t == "抛出"
        # 异常：装箱异常值，写入全局异常槽，置标志，立即从当前函数返回
        生成抛出(st)
    否则
        # 裸表达式语句
        若 t == "二元" 或 t == "一元" 或 t == "字面量" 或 t == "标识符" 或 t == "下标" 或 t == "列表字面量" 或 t == "字典字面量"
            生成表达式(st)
        结束
    结束
结束

函数 生成嵌套函数定义(字典 st)
    字符串 iname = st["名字"]
    # 为闭包块指针分配局部槽
    整数 off = 分配槽(iname, "closure")
    字典 捕集 = {}
    若 包含(g捕获表, iname)
        捕集 = g捕获表[iname]
    结束
    # 统计捕获变量数
    整数 ncap = 0
    对于 nm 在 捕集 循环
        ncap = ncap + 1
    结束
    # 分配环境块（8*ncap 字节）
    发出("mov $" + 转字符串(8 * ncap) + ", %rdi")
    发出("call rt_alloc")
    整数 env槽 = 新临时()
    发出("mov %rax, " + 转字符串(env槽) + "(%rbp)")
    # 把每个捕获的外层局部拷进环境槽
    对于 nm 在 捕集 循环
        整数 idx = 捕集[nm]
        若 包含(g偏移, nm)
            发出("mov " + 转字符串(g偏移[nm]) + "(%rbp), %rax")
            发出("mov " + 转字符串(env槽) + "(%rbp), %r10")
            发出("mov %rax, " + 转字符串(8 * idx) + "(%r10)")
        结束
    结束
    # 构造闭包块 {函数地址, 环境指针}
    发出("mov $16, %rdi")
    发出("call rt_alloc")
    发出("mov %rax, %r11")
    发出("lea " + g函数表[iname] + "(%rip), %rax")
    发出("mov %rax, (%r11)")
    发出("mov " + 转字符串(env槽) + "(%rbp), %rax")
    发出("mov %rax, 8(%r11)")
    发出("mov %r11, %rax")
    发出("mov %rax, " + 转字符串(off) + "(%rbp)")
    释放临时(1)
结束

函数 生成变量声明(字典 st)
    字符串 k = 标注种类(st["类型标注"])
    字典 初始化 = st["初始化"]
    若 非 是空节点(初始化)
        字符串 计算类 = 生成表达式(初始化)
        若 k == "none"
            k = 计算类
        结束
        整数 off = 分配槽(st["名字"], k)
        # 类型转换：int<->double
        若 k == "double" 且 计算类 != "double"
            发出("cvtsi2sd %rax, %xmm0")
        结束
        若 k != "double" 且 计算类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        存到槽(off, k)
    否则
        若 k == "none"
            k = "int"
        结束
        整数 off = 分配槽(st["名字"], k)
        若 k == "double"
            发出("movsd " + 双常量("0.0") + "(%rip), %xmm0")
            发出("movsd %xmm0, " + 转字符串(off) + "(%rbp)")
        否则
            发出("movq $0, " + 转字符串(off) + "(%rbp)")
        结束
    结束
结束

函数 生成赋值(字典 st)
    字典 目标 = st["目标"]
    若 目标["类型"] == "标识符"
        字符串 名 = 目标["名字"]
        # 闭包捕获变量：写入环境指针 r12 指向的堆块
        若 包含(g当前捕获, 名)
            生成表达式(st["值"])
            整数 idx = g当前捕获[名]
            发出("mov %rax, " + 转字符串(8 * idx) + "(%r12)")
            返回
        结束
        字符串 目标类 = 变量种类(名)
        字符串 值类 = 生成表达式(st["值"])
        # 若变量尚未分配（罕见），先分配
        若 非 包含(g偏移, 名)
            分配槽(名, 目标类)
        结束
        整数 off = g偏移[名]
        若 目标类 == "double" 且 值类 != "double"
            发出("cvtsi2sd %rax, %xmm0")
        结束
        若 目标类 != "double" 且 值类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        存到槽(off, 目标类)
    否则 若 目标["类型"] == "下标"
        生成下标赋值(目标, st["值"])
    结束
结束

函数 生成返回(字典 st)
    字典 v = st["值"]
    若 非 是空节点(v)
        字符串 k = 生成表达式(v)
        # 按函数返回类型转换
        若 g返回类 == "double" 且 k != "double"
            发出("cvtsi2sd %rax, %xmm0")
        结束
        若 g返回类 != "double" 且 k == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
    否则
        发出("mov $0, %rax")
    结束
    发出("leave")
    发出("ret")
结束

函数 生成如果(字典 st)
    字符串 否则l = 新标号()
    字符串 结束l = 新标号()
    字符串 k = 生成表达式(st["条件"])
    若 k == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("je " + 否则l)
    否则
        发出("test %rax, %rax")
        发出("jz " + 否则l)
    结束
    对于 i 从 0 到 长度(st["则体"]) - 1 循环
        生成语句(st["则体"][i])
    结束
    发出("jmp " + 结束l)
    发出(否则l + ":")
    # 否则链
    对于 j 从 0 到 长度(st["否则链"]) - 1 循环
        字典 br = st["否则链"][j]
        字典 bc = br["条件"]
        若 非 是空节点(bc)
            字符串 下一个l = 新标号()
            生成表达式(bc)
            发出("test %rax, %rax")
            发出("jz " + 下一个l)
            对于 m 从 0 到 长度(br["体"]) - 1 循环
                生成语句(br["体"][m])
            结束
            发出("jmp " + 结束l)
            发出(下一个l + ":")
        否则
            对于 m 从 0 到 长度(br["体"]) - 1 循环
                生成语句(br["体"][m])
            结束
        结束
    结束
    发出(结束l + ":")
结束

# 抛出异常：求值异常值并装箱，写入全局异常槽 g_exc_value，
# 置 g_exc_flag=1，然后 leave/ret 立即从当前函数返回（展开到调用方）。
# 调用方通过 已抛出()/取异常()/清除异常() 检查与处理（模拟 try/catch）。
函数 生成抛出(字典 st)
    字典 v = st["值"]
    若 非 是空节点(v)
        字符串 k = 生成表达式(v)
        装箱(k)
    否则
        发出("mov $0, %rdi")
        发出("call rt_box_int")
    结束
    # rax = Box*
    发出("lea g_exc_value(%rip), %r11")
    发出("mov %rax, (%r11)")
    发出("movl $1, g_exc_flag(%rip)")
    发出("leave")
    发出("ret")
结束

函数 生成当(字典 st)
    字符串 头l = 新标号()
    字符串 结束l = 新标号()
    追加(g跳出栈, 结束l)
    追加(g继续栈, 头l)
    发出(头l + ":")
    字符串 k = 生成表达式(st["条件"])
    若 k == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("je " + 结束l)
    否则
        发出("test %rax, %rax")
        发出("jz " + 结束l)
    结束
    对于 i 从 0 到 长度(st["体"]) - 1 循环
        生成语句(st["体"][i])
    结束
    发出("jmp " + 头l)
    发出(结束l + ":")
    # 弹出栈顶
    列表 新跳出 = []
    对于 i 从 0 到 长度(g跳出栈) - 2 循环
        追加(新跳出, g跳出栈[i])
    结束
    g跳出栈 = 新跳出
    列表 新继续 = []
    对于 i 从 0 到 长度(g继续栈) - 2 循环
        追加(新继续, g继续栈[i])
    结束
    g继续栈 = 新继续
结束

函数 生成对于(字典 st)
    若 st["是否遍历"] == 1
        生成遍历(st)
        返回
    结束
    字符串 头l = 新标号()
    字符串 继续l = 新标号()
    字符串 结束l = 新标号()
    # 初始化循环变量
    字符串 起类 = 生成表达式(st["起点"])
    整数 voff = 分配槽(st["变量"], "int")
    若 起类 == "double"
        发出("cvttsd2si %xmm0, %rax")
    结束
    发出("mov %rax, " + 转字符串(voff) + "(%rbp)")
    # 终点槽
    字符串 终类 = 生成表达式(st["终点"])
    整数 e槽 = 新临时()
    若 终类 == "double"
        发出("cvttsd2si %xmm0, %rax")
    结束
    发出("mov %rax, " + 转字符串(e槽) + "(%rbp)")
    # 步长槽
    字典 步长节点 = st["步长"]
    整数 p槽 = 新临时()
    若 非 是空节点(步长节点)
        字符串 p类 = 生成表达式(步长节点)
        若 p类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        发出("mov %rax, " + 转字符串(p槽) + "(%rbp)")
    否则
        发出("movq $1, " + 转字符串(p槽) + "(%rbp)")
    结束
    追加(g跳出栈, 结束l)
    追加(g继续栈, 继续l)
    发出(头l + ":")
    # 条件：步长>=0 时 var<=end；这里简化假设步长为正（测试均为正）
    发出("mov " + 转字符串(voff) + "(%rbp), %rax")
    发出("cmp " + 转字符串(e槽) + "(%rbp), %rax")
    发出("jg " + 结束l)
    对于 i 从 0 到 长度(st["体"]) - 1 循环
        生成语句(st["体"][i])
    结束
    发出(继续l + ":")
    发出("mov " + 转字符串(voff) + "(%rbp), %rax")
    发出("add " + 转字符串(p槽) + "(%rbp), %rax")
    发出("mov %rax, " + 转字符串(voff) + "(%rbp)")
    发出("jmp " + 头l)
    发出(结束l + ":")
    释放临时(2)
    # 弹出栈顶
    列表 新跳出 = []
    对于 i 从 0 到 长度(g跳出栈) - 2 循环
        追加(新跳出, g跳出栈[i])
    结束
    g跳出栈 = 新跳出
    列表 新继续 = []
    对于 i 从 0 到 长度(g继续栈) - 2 循环
        追加(新继续, g继续栈[i])
    结束
    g继续栈 = 新继续
结束

# for x in 列表
函数 生成遍历(字典 st)
    字符串 头l = 新标号()
    字符串 继续l = 新标号()
    字符串 结束l = 新标号()
    字符串 c类 = 生成表达式(st["遍历源"])
    整数 列槽 = 新临时()
    发出("mov %rax, " + 转字符串(列槽) + "(%rbp)")
    # 长度
    发出("mov %rax, %rdi")
    发出("call rt_list_len")
    整数 长槽 = 新临时()
    发出("mov %rax, " + 转字符串(长槽) + "(%rbp)")
    # 下标
    整数 标槽 = 新临时()
    发出("movq $0, " + 转字符串(标槽) + "(%rbp)")
    整数 voff = 分配槽(st["变量"], "box")
    追加(g跳出栈, 结束l)
    追加(g继续栈, 继续l)
    发出(头l + ":")
    发出("mov " + 转字符串(标槽) + "(%rbp), %rax")
    发出("cmp " + 转字符串(长槽) + "(%rbp), %rax")
    发出("jge " + 结束l)
    发出("mov " + 转字符串(列槽) + "(%rbp), %rdi")
    发出("mov " + 转字符串(标槽) + "(%rbp), %rsi")
    发出("call rt_list_get")
    发出("mov %rax, " + 转字符串(voff) + "(%rbp)")
    对于 i 从 0 到 长度(st["体"]) - 1 循环
        生成语句(st["体"][i])
    结束
    发出(继续l + ":")
    发出("addq $1, " + 转字符串(标槽) + "(%rbp)")
    发出("jmp " + 头l)
    发出(结束l + ":")
    释放临时(3)
    列表 新跳出 = []
    对于 i 从 0 到 长度(g跳出栈) - 2 循环
        追加(新跳出, g跳出栈[i])
    结束
    g跳出栈 = 新跳出
    列表 新继续 = []
    对于 i 从 0 到 长度(g继续栈) - 2 循环
        追加(新继续, g继续栈[i])
    结束
    g继续栈 = 新继续
结束

# ---------------- 表达式（返回种类，结果在 rax/xmm0） ----------------

函数 生成表达式(节点) -> 字符串
    字符串 t = 节点["类型"]
    若 t == "字面量"
        返回 生成字面量(节点)
    结束
    若 t == "标识符"
        返回 生成标识符(节点)
    结束
    若 t == "一元"
        返回 生成一元(节点)
    结束
    若 t == "二元"
        返回 生成二元(节点)
    结束
    若 t == "函数调用"
        返回 生成调用(节点)
    结束
    若 t == "下标"
        返回 生成下标(节点)
    结束
    若 t == "列表字面量"
        返回 生成列表字面量(节点)
    结束
    若 t == "字典字面量"
        返回 生成字典字面量(节点)
    结束
    # 兜底：0
    发出("mov $0, %rax")
    返回 "int"
结束

函数 生成标识符(节点) -> 字符串
    字符串 名 = 节点["名字"]
    # 闭包捕获变量：从环境指针 r12 指向的堆块读取
    若 包含(g当前捕获, 名)
        整数 idx = g当前捕获[名]
        发出("mov " + 转字符串(8 * idx) + "(%r12), %rax")
        返回 "int"
    结束
    # 局部槽优先（局部变量/形参可遮蔽同名函数）
    若 包含(g偏移, 名)
        字符串 k = 变量种类(名)
        若 k == "double"
            发出("movsd " + 转字符串(g偏移[名]) + "(%rbp), %xmm0")
        否则
            发出("mov " + 转字符串(g偏移[名]) + "(%rbp), %rax")
        结束
        返回 k
    结束
    # 无局部槽：若名字是顶层函数，构造闭包块 {函数地址, 环境=NULL}
    若 包含(g函数表, 名)
        发出("mov $16, %rdi")
        发出("call rt_alloc")
        发出("mov %rax, %r11")
        发出("lea " + g函数表[名] + "(%rip), %rax")
        发出("mov %rax, (%r11)")
        发出("movq $0, 8(%r11)")
        发出("mov %r11, %rax")
        返回 "closure"
    结束
    # 未知名：当 0
    发出("mov $0, %rax")
    返回 "int"
结束

函数 生成字面量(节点) -> 字符串
    字符串 lt = 节点["字面类型"]
    若 lt == "整数" 或 lt == "布尔"
        发出("mov $" + 节点["值"] + ", %rax")
        返回 "int"
    结束
    若 lt == "浮点"
        发出("movsd " + 双常量(节点["值"]) + "(%rip), %xmm0")
        返回 "double"
    结束
    若 lt == "字符串"
        发出("lea " + 串常量(节点["值"]) + "(%rip), %rdi")
        发出("call rt_str_lit")
        返回 "str"
    结束
    发出("mov $0, %rax")
    返回 "none"
结束

函数 生成一元(节点) -> 字符串
    字符串 k = 生成表达式(节点["操作数"])
    字符串 op = 节点["运算符"]
    若 op == "-"
        若 k == "double"
            发出("movsd " + 双常量("-0.0") + "(%rip), %xmm1")
            发出("xorpd %xmm1, %xmm0")
        否则
            发出("neg %rax")
        结束
        返回 k
    结束
    若 op == "+"
        返回 k
    结束
    若 op == "非"
        若 k != "double"
            发出("test %rax, %rax")
            发出("setz %al")
            发出("movzb %al, %eax")
        否则
            发出("xorpd %xmm1, %xmm1")
            发出("ucomisd %xmm1, %xmm0")
            发出("sete %al")
            发出("movzb %al, %eax")
        结束
        返回 "int"
    结束
    若 op == "~"
        发出("not %rax")
        返回 "int"
    结束
    返回 k
结束

# 把左右两个操作数（左在左槽，右在 rax/xmm0）提升为 double，xmm1=左 xmm0=右
函数 提升双精度(整数 左槽, 字符串 L类, 字符串 R类)
    若 R类 != "double"
        发出("cvtsi2sd %rax, %xmm0")
    结束
    若 L类 == "double"
        发出("movsd " + 转字符串(左槽) + "(%rbp), %xmm1")
    否则
        发出("mov " + 转字符串(左槽) + "(%rbp), %rax")
        发出("cvtsi2sd %rax, %xmm1")
    结束
结束

函数 生成二元(节点) -> 字符串
    字符串 op = 节点["运算符"]
    若 op == "且"
        返回 生成逻辑与(节点)
    结束
    若 op == "或"
        返回 生成逻辑或(节点)
    结束
    字符串 L类 = 生成表达式(节点["左"])
    整数 左槽 = 新临时()
    若 L类 == "double"
        发出("movsd %xmm0, " + 转字符串(左槽) + "(%rbp)")
    否则
        发出("mov %rax, " + 转字符串(左槽) + "(%rbp)")
    结束
    字符串 R类 = 生成表达式(节点["右"])

    # 字符串拼接
    若 op == "+" 且 (L类 == "str" 或 R类 == "str")
        # 先把右值存到临时槽（左值已在 左槽），避免转换左值时覆盖右值
        整数 右槽 = 新临时()
        若 R类 == "double"
            发出("movsd %xmm0, " + 转字符串(右槽) + "(%rbp)")
        否则
            发出("mov %rax, " + 转字符串(右槽) + "(%rbp)")
        结束
        # 转换左值 -> 字符串，存回 左槽
        若 L类 != "str"
            若 L类 == "double"
                发出("movsd " + 转字符串(左槽) + "(%rbp), %xmm0")
                发出("call rt_double_to_str")
            否则
                发出("mov " + 转字符串(左槽) + "(%rbp), %rdi")
                若 L类 == "box"
                    发出("call rt_box_to_str")
                否则
                    发出("call rt_int_to_str")
                结束
            结束
            发出("mov %rax, " + 转字符串(左槽) + "(%rbp)")
        结束
        # 从右槽恢复右值，必要时转换为字符串（结果在 rax）
        若 R类 != "str"
            若 R类 == "double"
                发出("movsd " + 转字符串(右槽) + "(%rbp), %xmm0")
                发出("call rt_double_to_str")
            否则
                发出("mov " + 转字符串(右槽) + "(%rbp), %rdi")
                若 R类 == "box"
                    发出("call rt_box_to_str")
                否则
                    发出("call rt_int_to_str")
                结束
            结束
        否则
            发出("mov " + 转字符串(右槽) + "(%rbp), %rax")
        结束
        # rdi = 左串, rsi = 右串
        发出("mov " + 转字符串(左槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_str_concat")
        释放临时(2)
        返回 "str"
    结束

    # 字符串相等
    若 (op == "==" 或 op == "!=") 且 (L类 == "str" 或 R类 == "str")
        发出("mov " + 转字符串(左槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_str_eq")
        若 op == "!="
            发出("xor $1, %eax")
        结束
        释放临时(1)
        返回 "int"
    结束

    # 比较运算
    若 op == "<" 或 op == ">" 或 op == "<=" 或 op == ">=" 或 op == "==" 或 op == "!="
        返回 生成比较(op, L类, R类, 左槽)
    结束

    # 浮点算术
    布尔 双算 = 假
    若 L类 == "double" 或 R类 == "double"
        若 op != "//" 且 op != "%"
            双算 = 真
        结束
    结束
    若 双算
        提升双精度(左槽, L类, R类)
        # xmm1=左, xmm0=右
        若 op == "+"
            发出("addsd %xmm0, %xmm1")
        否则 若 op == "-"
            发出("subsd %xmm0, %xmm1")
        否则 若 op == "*"
            发出("mulsd %xmm0, %xmm1")
        否则 若 op == "/"
            发出("divsd %xmm0, %xmm1")
        结束
        发出("movsd %xmm1, %xmm0")
        释放临时(1)
        返回 "double"
    结束

    # 整数算术：右在 rax，左在 左槽
    发出("mov %rax, %r10")
    发出("mov " + 转字符串(左槽) + "(%rbp), %rax")
    若 op == "+"
        发出("add %r10, %rax")
    否则 若 op == "-"
        发出("sub %r10, %rax")
    否则 若 op == "*"
        发出("imul %r10, %rax")
    否则 若 op == "//" 或 op == "/"
        发出("cqo")
        发出("idiv %r10")
    否则 若 op == "%"
        发出("cqo")
        发出("idiv %r10")
        发出("mov %rdx, %rax")
    否则 若 op == "&"
        发出("and %r10, %rax")
    否则 若 op == "|"
        发出("or %r10, %rax")
    否则 若 op == "^"
        发出("xor %r10, %rax")
    否则 若 op == "<<"
        发出("mov %r10, %rcx")
        发出("sal %cl, %rax")
    否则 若 op == ">>"
        发出("mov %r10, %rcx")
        发出("sar %cl, %rax")
    结束
    释放临时(1)
    返回 "int"
结束

# 比较：左在 左槽，右在 rax
函数 生成比较(字符串 op, 字符串 L类, 字符串 R类, 整数 左槽) -> 字符串
    若 L类 == "double" 或 R类 == "double"
        提升双精度(左槽, L类, R类)
        发出("ucomisd %xmm0, %xmm1")
    否则
        发出("mov %rax, %r10")
        发出("mov " + 转字符串(左槽) + "(%rbp), %rax")
        发出("cmp %r10, %rax")
    结束
    字符串 sc = "sete"
    若 op == "<"
        若 L类 == "double" 或 R类 == "double"
            sc = "setb"
        否则
            sc = "setl"
        结束
    否则 若 op == ">"
        若 L类 == "double" 或 R类 == "double"
            sc = "seta"
        否则
            sc = "setg"
        结束
    否则 若 op == "<="
        若 L类 == "double" 或 R类 == "double"
            sc = "setbe"
        否则
            sc = "setle"
        结束
    否则 若 op == ">="
        若 L类 == "double" 或 R类 == "double"
            sc = "setae"
        否则
            sc = "setge"
        结束
    否则 若 op == "=="
        sc = "sete"
    否则 若 op == "!="
        sc = "setne"
    结束
    发出(sc + " %al")
    发出("movzb %al, %eax")
    释放临时(1)
    返回 "int"
结束

函数 生成逻辑与(字典 node) -> 字符串
    字符串 L类 = 生成表达式(node["左"])
    字符串 假l = 新标号()
    字符串 结束l = 新标号()
    若 L类 == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("je " + 假l)
    否则
        发出("test %rax, %rax")
        发出("jz " + 假l)
    结束
    字符串 R类 = 生成表达式(node["右"])
    若 R类 == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("setne %al")
    否则
        发出("test %rax, %rax")
        发出("setne %al")
    结束
    发出("movzb %al, %eax")
    发出("jmp " + 结束l)
    发出(假l + ":")
    发出("xor %eax, %eax")
    发出(结束l + ":")
    返回 "int"
结束

函数 生成逻辑或(字典 node) -> 字符串
    字符串 L类 = 生成表达式(node["左"])
    字符串 真l = 新标号()
    字符串 结束l = 新标号()
    若 L类 == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("jne " + 真l)
    否则
        发出("test %rax, %rax")
        发出("jnz " + 真l)
    结束
    字符串 R类 = 生成表达式(node["右"])
    若 R类 == "double"
        发出("xorpd %xmm1, %xmm1")
        发出("ucomisd %xmm1, %xmm0")
        发出("setne %al")
    否则
        发出("test %rax, %rax")
        发出("setne %al")
    结束
    发出("movzb %al, %eax")
    发出("jmp " + 结束l)
    发出(真l + ":")
    发出("mov $1, %rax")
    发出(结束l + ":")
    返回 "int"
结束

# ---------------- 函数调用 ----------------

函数 生成调用(字典 node) -> 字符串
    字典 cdr = node["被调者"]
    字符串 名 = ""
    若 cdr["类型"] == "标识符"
        名 = cdr["名字"]
    结束
    # 内置：输出
    若 名 == "输出"
        生成打印(node["参数"])
        返回 "none"
    结束
    # 内置：长度
    若 名 == "长度"
        字符串 k = 生成表达式(node["参数"][0])
        若 k == "str"
            发出("mov %rax, %rdi")
            发出("call rt_str_len")
        否则 若 k == "list"
            发出("mov %rax, %rdi")
            发出("call rt_list_len")
        否则 若 k == "dict"
            发出("mov %rax, %rdi")
            发出("call rt_dict_len")
        否则 若 k == "box"
            发出("mov %rax, %rdi")
            发出("call rt_box_tag")
        否则
            发出("mov $0, %rax")
        结束
        返回 "int"
    结束
    # 内置：转字符串
    若 名 == "转字符串"
        字符串 k = 生成表达式(node["参数"][0])
        若 k == "int"
            发出("mov %rax, %rdi")
            发出("call rt_int_to_str")
        否则 若 k == "double"
            发出("call rt_double_to_str")
        否则 若 k == "box"
            发出("mov %rax, %rdi")
            发出("call rt_box_to_str")
        结束
        返回 "str"
    结束
    # 内置：追加(列表, 值)
    若 名 == "追加"
        生成表达式(node["参数"][0])
        整数 列槽 = 新临时()
        发出("mov %rax, " + 转字符串(列槽) + "(%rbp)")
        字符串 vk = 生成表达式(node["参数"][1])
        装箱(vk)
        发出("mov " + 转字符串(列槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_list_append")
        释放临时(1)
        返回 "none"
    结束
    # 内置：绝对值(x)
    若 名 == "绝对值"
        字符串 k = 生成表达式(node["参数"][0])
        若 k == "double"
            发出("movsd " + 双常量("0.0") + "(%rip), %xmm1")
            发出("ucomisd %xmm1, %xmm0")
            字符串 p = 新标号()
            发出("jae " + p)
            发出("movsd " + 双常量("-0.0") + "(%rip), %xmm1")
            发出("xorpd %xmm1, %xmm0")
            发出(p + ":")
        否则
            发出("test %rax, %rax")
            字符串 p = 新标号()
            发出("jns " + p)
            发出("neg %rax")
            发出(p + ":")
        结束
        返回 k
    结束
    # 内置：最大值(a,b) / 最小值(a,b)
    若 名 == "最大值" 或 名 == "最小值"
        返回 生成二目选择(名, node)
    结束
    # 内置：转整数(x) —— 浮点截断，box 拆箱
    若 名 == "转整数"
        字符串 k = 生成表达式(node["参数"][0])
        若 k == "double"
            发出("cvttsd2si %xmm0, %rax")
        否则 若 k == "box"
            发出("mov %rax, %rdi")
            发出("call rt_unbox_int")
        结束
        返回 "int"
    结束
    # 内置：转浮点(x) —— 整数提升为 double，box 拆箱
    若 名 == "转浮点"
        字符串 k = 生成表达式(node["参数"][0])
        若 k == "int"
            发出("cvtsi2sd %rax, %xmm0")
        否则 若 k == "box"
            发出("mov %rax, %rdi")
            发出("call rt_unbox_double")
        结束
        返回 "double"
    结束
    # 内置：随机() —— rdtsc 低 32 位
    若 名 == "随机"
        发出("rdtsc")
        返回 "int"
    结束
    # 内置：时间戳() —— rdtsc 拼成 64 位
    若 名 == "时间戳"
        发出("rdtsc")
        发出("shl $32, %rdx")
        发出("or %rdx, %rax")
        返回 "int"
    结束
    # 内置：已抛出() —— 是否存在未捕获异常（1/0）
    若 名 == "已抛出"
        发出("movl g_exc_flag(%rip), %eax")
        返回 "int"
    结束
    # 内置：取异常() —— 返回最近抛出的异常值（字符串化）
    若 名 == "取异常"
        发出("lea g_exc_value(%rip), %rdi")
        发出("mov (%rdi), %rdi")
        发出("call rt_box_to_str")
        返回 "str"
    结束
    # 内置：清除异常() —— 复位异常标志
    若 名 == "清除异常"
        发出("movl $0, g_exc_flag(%rip)")
        返回 "none"
    结束
    # 内置：字典化(box) —— 把列表/字典元素 Box 解包为底层字典指针
    若 名 == "字典化"
        字符串 dk = 生成表达式(node["参数"][0])
        发出("mov %rax, %rdi")
        发出("call rt_box_unbox_ptr")
        返回 "dict"
    结束
    # 内置：截取(s, start, len) —— 调用运行时辅助 rt_str_sub
    若 名 == "截取"
        生成表达式(node["参数"][0])
        整数 s槽 = 新临时()
        发出("mov %rax, " + 转字符串(s槽) + "(%rbp)")
        生成表达式(node["参数"][1])
        整数 st槽 = 新临时()
        发出("mov %rax, " + 转字符串(st槽) + "(%rbp)")
        生成表达式(node["参数"][2])
        整数 ln槽 = 新临时()
        发出("mov %rax, " + 转字符串(ln槽) + "(%rbp)")
        发出("mov " + 转字符串(s槽) + "(%rbp), %rdi")
        发出("mov " + 转字符串(st槽) + "(%rbp), %rsi")
        发出("mov " + 转字符串(ln槽) + "(%rbp), %rdx")
        发出("call rt_str_sub")
        释放临时(3)
        返回 "str"
    结束
    # 内置：包含(字典, 键) —— 键存在返回 1 否则 0
    若 名 == "包含"
        生成表达式(node["参数"][0])
        整数 d槽 = 新临时()
        发出("mov %rax, " + 转字符串(d槽) + "(%rbp)")
        字符串 k类 = 生成表达式(node["参数"][1])
        若 k类 != "str"
            若 k类 == "double"
                发出("call rt_double_to_str")
            否则
                发出("mov %rax, %rdi")
                发出("call rt_int_to_str")
            结束
        结束
        发出("mov " + 转字符串(d槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_dict_get")
        发出("test %rax, %rax")
        发出("setne %al")
        发出("movzb %al, %eax")
        释放临时(1)
        返回 "int"
    结束
    # ---- 判定：是否为对已知顶层函数的直接调用（未被局部槽遮蔽） ----
    整数 直接 = 0
    若 名 != "" 且 包含(g函数表, 名) 且 非 包含(g偏移, 名)
        直接 = 1
    结束
    列表 参数 = node["参数"]
    整数 A = 长度(参数)

    # ---- 可变参数：把实参装箱打包成列表，列表指针作为唯一实参传入 ----
    若 直接 == 1 且 包含(g函数可变, 名) 且 g函数可变[名] == 1
        发出("mov $0, %rdi")
        发出("call rt_list_create")
        整数 列槽 = 新临时()
        发出("mov %rax, " + 转字符串(列槽) + "(%rbp)")
        对于 i 从 0 到 A - 1 循环
            字符串 ak = 生成表达式(参数[i])
            装箱(ak)
            发出("mov " + 转字符串(列槽) + "(%rbp), %rdi")
            发出("mov %rax, %rsi")
            发出("call rt_list_append")
        结束
        发出("mov " + 转字符串(列槽) + "(%rbp), %rdi")
        发出("call " + g函数表[名])
        释放临时(1)
        返回 "int"
    结束

    # ---- 通用：实参求值到槽 ----
    列表 实参槽 = []
    列表 实参类 = []
    对于 i 从 0 到 A - 1 循环
        字符串 ak = 生成表达式(参数[i])
        整数 s = 新临时()
        若 ak == "double"
            发出("movsd %xmm0, " + 转字符串(s) + "(%rbp)")
        否则
            发出("mov %rax, " + 转字符串(s) + "(%rbp)")
        结束
        追加(实参槽, s)
        追加(实参类, ak)
    结束

    若 直接 == 1
        # ---- 直接调用：按被调函数形参表布置寄存器，缺失形参用 0 哨兵补位 ----
        字符串 lbl = g函数表[名]
        列表 形参 = g函数形参[名]
        整数 P = 长度(形参)
        整数 ireg = 0
        整数 xreg = 0
        对于 i 从 0 到 P - 1 循环
            若 i < A
                # 提供了实参：按实参类别放寄存器
                若 实参类[i] == "double"
                    发出("movsd " + 转字符串(实参槽[i]) + "(%rbp), %" + ARG_XMM[xreg])
                    xreg = xreg + 1
                否则
                    发出("mov " + 转字符串(实参槽[i]) + "(%rbp), %" + ARG_INT[ireg])
                    ireg = ireg + 1
                结束
            否则
                # 省略的形参：置 0 哨兵，函数序言检测到后用默认值
                若 形参[i] == "double"
                    发出("xorpd %" + ARG_XMM[xreg] + ", %" + ARG_XMM[xreg])
                    xreg = xreg + 1
                否则
                    发出("mov $0, %" + ARG_INT[ireg])
                    ireg = ireg + 1
                结束
            结束
        结束
        发出("call " + lbl)
        释放临时(A)
        若 包含(g函数种类, 名) 且 g函数种类[名] == "str" 则 返回 "str" 结束
        返回 "int"
    结束
    若 真 则
        # ---- 间接调用：被调者求值为闭包块 {函数地址, 环境指针}，解包后调用 ----
        生成表达式(cdr)
        发出("mov (%rax), %r11")
        发出("mov 8(%rax), %r12")
        整数 ireg = 0
        整数 xreg = 0
        对于 i 从 0 到 长度(实参槽) - 1 循环
            若 实参类[i] == "double"
                发出("movsd " + 转字符串(实参槽[i]) + "(%rbp), %" + ARG_XMM[xreg])
                xreg = xreg + 1
            否则
                发出("mov " + 转字符串(实参槽[i]) + "(%rbp), %" + ARG_INT[ireg])
                ireg = ireg + 1
            结束
        结束
        发出("call *%r11")
    结束
    释放临时(A)
    返回 "int"
结束

函数 生成打印(列表 参数)
    整数 首 = 1
    对于 i 从 0 到 长度(参数) - 1 循环
        若 首 == 0
            发出("call rt_print_space")
        结束
        首 = 0
        字符串 k = 生成表达式(参数[i])
        若 k == "double"
            发出("call rt_print_double")
        否则 若 k == "str"
            发出("mov %rax, %rdi")
            发出("call rt_print_str")
        否则 若 k == "list"
            发出("mov %rax, %rdi")
            发出("call rt_print_list")
        否则 若 k == "dict"
            发出("mov %rax, %rdi")
            发出("call rt_print_dict")
        否则 若 k == "box"
            发出("mov %rax, %rdi")
            发出("call rt_print_box")
        否则
            发出("mov %rax, %rdi")
            发出("call rt_print_int")
        结束
    结束
    发出("call rt_print_nl")
结束

# ---------------- 二目选择（最大值/最小值） ----------------

# 对两个参数做比较并选择较大/较小者。
# int 结果在 rax，double 结果在 xmm0。
函数 生成二目选择(字符串 名, 字典 node) -> 字符串
    字符串 L类 = 生成表达式(node["参数"][0])
    整数 槽A = 新临时()
    若 L类 == "double"
        发出("movsd %xmm0, " + 转字符串(槽A) + "(%rbp)")
    否则
        发出("mov %rax, " + 转字符串(槽A) + "(%rbp)")
    结束
    字符串 R类 = 生成表达式(node["参数"][1])
    # ---- double 路径 ----
    若 L类 == "double" 或 R类 == "double"
        提升双精度(槽A, L类, R类)   # xmm1=左, xmm0=右
        发出("ucomisd %xmm0, %xmm1")
        字符串 保留左 = 新标号()
        字符串 完 = 新标号()
        若 名 == "最大值"
            发出("jae " + 保留左)
        否则
            发出("jbe " + 保留左)
        结束
        # 保留右：结果已在 xmm0
        发出("jmp " + 完)
        发出(保留左 + ":")
        发出("movsd %xmm1, %xmm0")
        发出(完 + ":")
        释放临时(1)
        返回 "double"
    结束
    # ---- int 路径：rax=右，槽A=左 ----
    发出("mov %rax, %r10")
    发出("mov " + 转字符串(槽A) + "(%rbp), %rax")
    发出("cmp %r10, %rax")
    字符串 保留左 = 新标号()
    字符串 完 = 新标号()
    若 名 == "最大值"
        发出("jge " + 保留左)
    否则
        发出("jle " + 保留左)
    结束
    # 保留右
    发出("mov %r10, %rax")
    发出("jmp " + 完)
    发出(保留左 + ":")
    发出(完 + ":")
    释放临时(1)
    返回 "int"
结束

# ---------------- 下标访问 ----------------

# 容器[索引] -> 值（在 rax）
#   列表：运行时返回已拆箱的整数，种类记为 int（打印/比较都正确）
#   字典：运行时返回 Box*，种类记为 box
函数 生成下标(节点) -> 字符串
    字符串 c类 = 生成表达式(节点["容器"])
    整数 c槽 = 新临时()
    发出("mov %rax, " + 转字符串(c槽) + "(%rbp)")
    字符串 i类 = 生成表达式(节点["索引"])
    # 字符串索引：返回单字符字符串
    若 c类 == "str"
        若 i类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_str_at")
        释放临时(1)
        返回 "str"
    结束
    若 c类 == "list"
        若 i类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_list_get")
        释放临时(1)
        返回 "int"
    结束
    若 c类 == "dict"
        若 i类 != "str"
            若 i类 == "double"
                发出("call rt_double_to_str")
            否则
                发出("mov %rax, %rdi")
                发出("call rt_int_to_str")
            结束
        结束
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_dict_get")
    否则 若 c类 == "box"
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("call rt_box_unbox_ptr")
        发出("mov %rax, " + 转字符串(c槽) + "(%rbp)")
        若 i类 == "double"
            发出("cvttsd2si %xmm0, %rax")
        结束
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov %rax, %rsi")
        发出("call rt_list_get")
        释放临时(1)
        返回 "int"
    结束
    释放临时(1)
    返回 "box"
结束

# 容器[索引] = 值
函数 生成下标赋值(字典 目标, 字典 值)
    字符串 c类 = 生成表达式(目标["容器"])
    整数 c槽 = 新临时()
    发出("mov %rax, " + 转字符串(c槽) + "(%rbp)")
    字符串 i类 = 生成表达式(目标["索引"])
    整数 i槽 = 新临时()
    若 i类 == "double"
        发出("cvttsd2si %xmm0, %rax")
    结束
    发出("mov %rax, " + 转字符串(i槽) + "(%rbp)")
    字符串 vk = 生成表达式(值)
    装箱(vk)
    若 c类 == "dict"
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov " + 转字符串(i槽) + "(%rbp), %rsi")
        发出("mov %rax, %rdx")
        发出("call rt_dict_set")
    否则
        发出("mov " + 转字符串(c槽) + "(%rbp), %rdi")
        发出("mov " + 转字符串(i槽) + "(%rbp), %rsi")
        发出("mov %rax, %rdx")
        发出("call rt_list_set")
    结束
    释放临时(2)
结束

# ---------------- 列表/字典字面量 ----------------

函数 生成列表字面量(节点) -> 字符串
    发出("mov $0, %rdi")
    发出("call rt_list_create")
    整数 列槽 = 新临时()
    发出("mov %rax, " + 转字符串(列槽) + "(%rbp)")
    列表 元素 = 节点["元素"]
    对于 i 从 0 到 长度(元素) - 1 循环
        字符串 k = 生成表达式(元素[i])
        装箱(k)
        发出("mov %rax, %rsi")
        发出("mov " + 转字符串(列槽) + "(%rbp), %rdi")
        发出("call rt_list_append")
    结束
    发出("mov " + 转字符串(列槽) + "(%rbp), %rax")
    释放临时(1)
    返回 "list"
结束

函数 生成字典字面量(节点) -> 字符串
    发出("call rt_dict_create")
    整数 d槽 = 新临时()
    发出("mov %rax, " + 转字符串(d槽) + "(%rbp)")
    列表 键表 = 节点["键"]
    列表 值表 = 节点["值"]
    对于 i 从 0 到 长度(键表) - 1 循环
        生成表达式(键表[i])
        整数 k槽 = 新临时()
        发出("mov %rax, " + 转字符串(k槽) + "(%rbp)")
        字符串 vk = 生成表达式(值表[i])
        装箱(vk)
        发出("mov " + 转字符串(d槽) + "(%rbp), %rdi")
        发出("mov " + 转字符串(k槽) + "(%rbp), %rsi")
        发出("mov %rax, %rdx")
        发出("call rt_dict_set")
        释放临时(1)
    结束
    发出("mov " + 转字符串(d槽) + "(%rbp), %rax")
    释放临时(1)
    返回 "dict"
结束

# ---------------- 函数定义与主程序 ----------------

# 重置当前函数状态
函数 重置函数状态()
    g偏移 = {}
    g种类 = {}
    g槽数 = 0
    g临时sp = 0
    g跳出栈 = []
    g继续栈 = []
结束

# 生成一个用户函数
函数 生成函数(字典 st)
    重置函数状态()
    g返回类 = 标注种类(st["返回类型"])
    字符串 lbl = g函数表[st["名字"]]
    g当前函数名 = st["名字"]
    g当前捕获 = {}
    若 包含(g捕获表, st["名字"])
        g当前捕获 = g捕获表[st["名字"]]
    结束
    列表 体 = []
    g活动 = 体
    # 参数槽 + 入参搬运
    列表 参数 = st["参数"]
    列表 参型 = st["参数类型"]
    列表 参默认 = st["参数默认"]
    整数 ireg = 0
    整数 xreg = 0
    对于 i 从 0 到 长度(参数) - 1 循环
        字符串 p名 = 参数[i]
        字符串 pt = ""
        若 i < 长度(参型)
            pt = 参型[i]
        结束
        # 是否有默认值
        字典 默认节点 = {"类型": "空值"}
        若 i < 长度(参默认)
            默认节点 = 参默认[i]
        结束
        # 推断种类（无标注时从默认字面量推断）
        字符串 pk = 推断参数种类(pt, 默认节点)
        整数 off = 分配槽(p名, pk)
        若 pt == "可变"
            # 可变参数：调用方已把实参打包成列表，指针在 GPR 寄存器
            发出("mov %" + ARG_INT[ireg] + ", " + 转字符串(off) + "(%rbp)")
            ireg = ireg + 1
        否则 若 pk == "double"
            发出("movsd %" + ARG_XMM[xreg] + ", %xmm0")
            xreg = xreg + 1
            若 非 是空节点(默认节点)
                # 哨兵：0.0 表示省略，用默认值
                字符串 完标 = 新标号()
                发出("xorpd %xmm1, %xmm1")
                发出("ucomisd %xmm1, %xmm0")
                发出("jne " + 完标)
                字符串 dk = 生成表达式(默认节点)
                若 dk != "double"
                    发出("cvtsi2sd %rax, %xmm0")
                结束
                发出(完标 + ":")
            结束
            发出("movsd %xmm0, " + 转字符串(off) + "(%rbp)")
        否则
            发出("mov %" + ARG_INT[ireg] + ", %rax")
            ireg = ireg + 1
            若 非 是空节点(默认节点)
                # 哨兵：0/空指针表示省略，用默认值
                字符串 完标 = 新标号()
                发出("test %rax, %rax")
                发出("jnz " + 完标)
                生成表达式(默认节点)
                发出(完标 + ":")
            结束
            发出("mov %rax, " + 转字符串(off) + "(%rbp)")
        结束
    结束
    # OOP：把 自己/self 别名到第一个参数槽（即实例）。
    # 方法内即可用 自己.属性 形式访问实例；首参通常标注为字典。
    若 长度(参数) > 0
        字符串 p0 = 参数[0]
        g偏移["自己"] = g偏移[p0]
        g种类["自己"] = g种类[p0]
        g偏移["self"] = g偏移[p0]
        g种类["self"] = g种类[p0]
    结束
    # 函数体
    列表 语句表 = st["体"]["语句"]
    对于 i 从 0 到 长度(语句表) - 1 循环
        生成语句(语句表[i])
    结束
    # 隐式返回
    若 g返回类 == "double"
        发出("movsd " + 双常量("0.0") + "(%rip), %xmm0")
    否则
        发出("mov $0, %rax")
    结束
    发出("leave")
    发出("ret")
    # 包装成函数块
    列表 块 = []
    追加(块, lbl + ":")
    追加(块, "push %rbp")
    追加(块, "mov %rsp, %rbp")
    追加(块, "sub $" + 转字符串(帧大小) + ", %rsp")
    对于 i 从 0 到 长度(体) - 1 循环
        追加(块, 体[i])
    结束
    g函数行[lbl] = 块
结束

# 拼接列表为字符串，用分隔符
函数 拼接列表(列表 l, 字符串 sep) -> 字符串
    字符串 r = ""
    整数 n = 长度(l)
    对于 i 从 0 到 n - 1 循环
        若 i > 0
            r = r + sep
        结束
        r = r + l[i]
    结束
    返回 r
结束

# 运行时辅助块：rt_str_sub(s=rdi, start=rsi, len=rdx) -> rax=新串
# 仅依赖 rt_alloc，避免改动外部 C 运行时。
函数 追加辅助块(列表 out)
    若 g发出辅助 == 1
        返回
    结束
    g发出辅助 = 1
    追加(out, "rt_str_sub:")
    追加(out, "push %rbp")
    追加(out, "mov %rsp, %rbp")
    追加(out, "push %rbx")
    追加(out, "push %r12")
    追加(out, "push %r13")
    追加(out, "push %r14")
    追加(out, "mov %rdi, %rbx")
    追加(out, "mov %rsi, %r12")
    追加(out, "mov %rdx, %r13")
    追加(out, "lea 1(%r13), %rdi")
    追加(out, "call rt_alloc")
    追加(out, "mov %rax, %r14")
    追加(out, "mov %rbx, %rax")
    追加(out, "add %r12, %rax")
    追加(out, "test %r13, %r13")
    追加(out, "jz 1f")
    追加(out, "mov $0, %rcx")
    追加(out, "2:")
    追加(out, "mov (%rax,%rcx), %dl")
    追加(out, "mov %dl, (%r14,%rcx)")
    追加(out, "add $1, %rcx")
    追加(out, "cmp %r13, %rcx")
    追加(out, "jl 2b")
    追加(out, "1:")
    追加(out, "movb $0, (%r14,%r13)")
    追加(out, "mov %r14, %rdi")
    追加(out, "pop %r14")
    追加(out, "pop %r13")
    追加(out, "pop %r12")
    追加(out, "pop %rbx")
    追加(out, "pop %rbp")
    追加(out, "jmp rt_str_lit")
    # ---- rt_box_to_str(rdi=Box*) -> rax=char* ----
    # 按 Box 的 tag 把任意装箱值转成 C 字符串：
    #   tag0 int -> rt_int_to_str；tag1 double -> rt_double_to_str；
    #   tag2 str -> 直接返回内部串指针；其余/空 -> 空串。
    追加(out, "rt_box_to_str:")
    追加(out, "push %rbp")
    追加(out, "mov %rsp, %rbp")
    追加(out, "push %rbx")
    追加(out, "mov %rdi, %rbx")
    追加(out, "test %rbx, %rbx")
    追加(out, "jz .Lrbs_null")
    追加(out, "mov (%rbx), %rax")
    追加(out, "cmp $0, %rax")
    追加(out, "je .Lrbs_int")
    追加(out, "cmp $1, %rax")
    追加(out, "je .Lrbs_double")
    追加(out, "cmp $2, %rax")
    追加(out, "je .Lrbs_str")
    追加(out, "jmp .Lrbs_null")
    追加(out, ".Lrbs_int:")
    追加(out, "mov 8(%rbx), %rdi")
    追加(out, "call rt_int_to_str")
    追加(out, "jmp .Lrbs_done")
    追加(out, ".Lrbs_double:")
    追加(out, "movsd 8(%rbx), %xmm0")
    追加(out, "call rt_double_to_str")
    追加(out, "jmp .Lrbs_done")
    追加(out, ".Lrbs_str:")
    追加(out, "mov 8(%rbx), %rax")
    追加(out, "jmp .Lrbs_done")
    追加(out, ".Lrbs_null:")
    追加(out, "lea .Lrbs_empty(%rip), %rdi")
    追加(out, "call rt_str_lit")
    追加(out, ".Lrbs_done:")
    追加(out, "pop %rbx")
    追加(out, "pop %rbp")
    追加(out, "ret")
    追加(out, ".Lrbs_empty:")
    追加(out, ".byte 0")
结束
函数 扫描标识符(节点, 字典 表)
    若 类型(节点) == "列表"
        对于 i 从 0 到 长度(节点) - 1 循环
            扫描标识符(节点[i], 表)
        结束
        返回
    结束
    若 类型(节点) != "字典"
        返回
    结束
    若 非 包含(节点, "类型")
        返回
    结束
    字符串 t = 节点["类型"]
    若 t == "标识符"
        表[节点["名字"]] = 1
        返回
    结束
    # 递归进入各子节点字段
    若 包含(节点, "左")
        扫描标识符(节点["左"], 表)
    结束
    若 包含(节点, "右")
        扫描标识符(节点["右"], 表)
    结束
    若 包含(节点, "操作数")
        扫描标识符(节点["操作数"], 表)
    结束
    若 包含(节点, "被调者")
        扫描标识符(节点["被调者"], 表)
    结束
    若 包含(节点, "容器")
        扫描标识符(节点["容器"], 表)
    结束
    若 包含(节点, "索引")
        扫描标识符(节点["索引"], 表)
    结束
    若 包含(节点, "条件")
        扫描标识符(节点["条件"], 表)
    结束
    若 包含(节点, "值")
        扫描标识符(节点["值"], 表)
    结束
    若 包含(节点, "起点")
        扫描标识符(节点["起点"], 表)
    结束
    若 包含(节点, "终点")
        扫描标识符(节点["终点"], 表)
    结束
    若 包含(节点, "步长")
        扫描标识符(节点["步长"], 表)
    结束
    若 包含(节点, "遍历源")
        扫描标识符(节点["遍历源"], 表)
    结束
    若 包含(节点, "目标")
        扫描标识符(节点["目标"], 表)
    结束
    若 包含(节点, "初始化")
        扫描标识符(节点["初始化"], 表)
    结束
    若 包含(节点, "遍历源")
        扫描标识符(节点["遍历源"], 表)
    结束
    若 包含(节点, "则体")
        扫描标识符(节点["则体"], 表)
    结束
    若 包含(节点, "体")
        扫描标识符(节点["体"], 表)
    结束
    若 包含(节点, "参数")
        扫描标识符(节点["参数"], 表)
    结束
    若 包含(节点, "元素")
        扫描标识符(节点["元素"], 表)
    结束
    若 包含(节点, "键")
        扫描标识符(节点["键"], 表)
    结束
    若 包含(节点, "值表")
        扫描标识符(节点["值表"], 表)
    结束
    若 包含(节点, "否则链")
        扫描标识符(节点["否则链"], 表)
    结束
    若 包含(节点, "语句")
        扫描标识符(节点["语句"], 表)
    结束
结束

# 收集语句表中所有局部变量声明名（作为集合字典）
函数 收集局部名(列表 语句表) -> 字典
    字典 表 = {}
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 st["类型"] == "变量声明"
            表[st["名字"]] = 1
        结束
        若 st["类型"] == "对于"
            表[st["变量"]] = 1
        结束
        若 st["类型"] == "如果"
            # 则体 / 否则链 体 里的局部
            扫描体局部(st["则体"], 表)
            对于 j 从 0 到 长度(st["否则链"]) - 1 循环
                扫描体局部(st["否则链"][j]["体"], 表)
            结束
        结束
        若 st["类型"] == "当"
            扫描体局部(st["体"], 表)
        结束
        若 st["类型"] == "对于"
            扫描体局部(st["体"], 表)
        结束
    结束
    返回 表
结束

# 扫描一个体（程序节点或语句列表）里的局部变量名
函数 扫描体局部(体, 字典 表)
    若 类型(体) == "字典" 且 包含(体, "语句")
        体 = 体["语句"]
    结束
    若 类型(体) != "列表"
        返回
    结束
    对于 i 从 0 到 长度(体) - 1 循环
        字典 st = 体[i]
        若 st["类型"] == "变量声明"
            表[st["名字"]] = 1
        结束
        若 st["类型"] == "对于"
            表[st["变量"]] = 1
            扫描体局部(st["体"], 表)
        结束
        若 st["类型"] == "当"
            扫描体局部(st["体"], 表)
        结束
        若 st["类型"] == "如果"
            扫描体局部(st["则体"], 表)
            对于 j 从 0 到 长度(st["否则链"]) - 1 循环
                扫描体局部(st["否则链"][j]["体"], 表)
            结束
        结束
    结束
结束

# 注册单个函数定义到全局表（含形参/默认/可变元数据）
函数 注册函数(字典 st)
    字符串 lbl = "FUNC" + 转字符串(g函数数)
    g函数表[st["名字"]] = lbl
    g函数种类[st["名字"]] = 标注种类(st["返回类型"])    列表 形参 = []
    列表 参型 = st["参数类型"]
    列表 参默 = st["参数默认"]
    对于 j 从 0 到 长度(st["参数"]) - 1 循环
        字符串 pt = ""
        若 j < 长度(参型)
            pt = 参型[j]
        结束
        字典 默节点 = {"类型": "空值"}
        若 j < 长度(参默)
            默节点 = 参默[j]
        结束
        追加(形参, 推断参数种类(pt, 默节点))
    结束
    g函数形参[st["名字"]] = 形参
    g函数默认[st["名字"]] = st["参数默认"]
    整数 可变 = 0
    对于 j 从 0 到 长度(参型) - 1 循环
        若 参型[j] == "可变"
            可变 = 1
        结束
    结束
    g函数可变[st["名字"]] = 可变
    g函数数 = g函数数 + 1
结束

# 递归收集语句表中的函数定义（含嵌套函数），并计算闭包捕获变量
# 外层局部：所有外层函数的局部变量名集合（字典作集合）
函数 收集函数(列表 语句表, 字典 外层局部)
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 st["类型"] == "函数定义"
            注册函数(st)
            # 本函数自身局部 = 形参 + 体中声明的局部
            字典 自身局部 = {}
            对于 p 从 0 到 长度(st["参数"]) - 1 循环
                自身局部[st["参数"][p]] = 1
            结束
            # 自己/self 是首参别名，视为自身局部，不参与闭包捕获
            自身局部["自己"] = 1
            自身局部["self"] = 1
            字典 声明局部 = 收集局部名(st["体"]["语句"])
            对于 k 在 声明局部 循环
                自身局部[k] = 1
            结束
            # 体中引用的所有标识符
            字典 已用 = {}
            扫描标识符(st["体"], 已用)
            # 捕获 = 引用了的外层变量，且不是自身局部、不是全局函数
            字典 捕集 = {}
            整数 cidx = 0
            对于 nm 在 已用 循环
                若 包含(外层局部, nm) 且 非 包含(自身局部, nm) 且 非 包含(g函数表, nm)
                    捕集[nm] = cidx
                    cidx = cidx + 1
                结束
            结束
            若 长度(捕集) > 0
                g捕获表[st["名字"]] = 捕集
            结束
            # 递归：内层函数可见自身局部 + 外层局部
            字典 新外层 = {}
            对于 k 在 外层局部 循环
                新外层[k] = 1
            结束
            对于 k 在 自身局部 循环
                新外层[k] = 1
            结束
            收集函数(st["体"]["语句"], 新外层)
        结束
    结束
结束

# 递归生成所有函数定义（含嵌套函数）
函数 生成所有函数(列表 语句表)
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 st["类型"] == "函数定义"
            生成函数(st)
            生成所有函数(st["体"]["语句"])
        结束
    结束
结束

# 递归把函数块追加到输出列表（含嵌套函数）
函数 追加函数块(列表 语句表, 列表 输出)
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 st["类型"] == "函数定义"
            字符串 lbl = g函数表[st["名字"]]
            列表 块 = g函数行[lbl]
            对于 j 从 0 到 长度(块) - 1 循环
                追加(输出, 块[j])
            结束
            追加函数块(st["体"]["语句"], 输出)
        结束
    结束
结束

# 主入口：AST -> 汇编字符串
函数 生成汇编(字典 ast) -> 字符串
    # 重置全局
    g函数行 = {}
    g函数表 = {}
    g函数形参 = {}
    g函数默认 = {}
    g函数可变 = {}
    g函数数 = 0
    g标号数 = 0
    g串行 = []
    g串表 = {}
    g串数 = 0
    g双表 = {}
    g双数 = 0
    g发出辅助 = 0

    列表 语句表 = ast["语句"]
    # 预收集函数定义（递归收集顶层+嵌套），含形参种类/默认值/可变参数/闭包捕获元数据
    收集函数(语句表, {})
    # 生成用户函数（递归生成嵌套函数）
    生成所有函数(语句表)

    # co_main：顶层非函数语句
    重置函数状态()
    g返回类 = "int"
    列表 主体 = []
    g活动 = 主体
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 st["类型"] != "函数定义"
            生成语句(st)
        结束
    结束
    # 隐式返回 0
    发出("mov $0, %rax")
    发出("leave")
    发出("ret")

    # 组装最终输出
    列表 输出 = []
    追加(输出, ".att_syntax")
    追加(输出, ".text")
    追加辅助块(输出)
    # 用户函数块（递归发射，含嵌套函数）
    追加函数块(语句表, 输出)
    # co_main
    追加(输出, ".globl co_main")
    追加(输出, "co_main:")
    追加(输出, "push %rbp")
    追加(输出, "mov %rsp, %rbp")
    追加(输出, "sub $" + 转字符串(帧大小) + ", %rsp")
    对于 i 从 0 到 长度(主体) - 1 循环
        追加(输出, 主体[i])
    结束
    # rodata
    若 长度(g串行) > 0
        追加(输出, ".section .rodata")
        对于 i 从 0 到 长度(g串行) - 1 循环
            追加(输出, g串行[i])
        结束
    结束
    # 异常处理全局变量（.bss：可读写，零初始化）
    追加(输出, ".bss")
    追加(输出, ".align 8")
    追加(输出, "g_exc_value:")
    追加(输出, ".skip 8")
    追加(输出, "g_exc_flag:")
    追加(输出, ".skip 4")
    返回 拼接列表(输出, "\n") + "\n"
结束

# ============================================================
# 并发运行时（协程 / 通道 / 锁 / 等待组）
#
# 自举编译器新增的并发原语，全部以函数调用形式暴露（语法分析器无需改动）。
# 在解释器(eval)下运行时，本文件由 cat 拼接进测试程序，运行时即这些函数。
#
# 实现模型（用户态协作式多任务调度器）：
#   本解释器为单线程树遍历求值，`并发 f()` 只入队、`等待 h` 才同步执行，
#   没有真正的后台线程。因此这里实现一个**协作式调度器**：
#     * 协程   = 一个 0 参函数 f；启动协程(f) 把它放进全局就绪队列 g就绪。
#     * 调度   = 当某个协程/主协程即将阻塞（通道空/满、等待组未完成）时，
#                不睡眠空转，而是调用 让出调度() 执行下一个就绪协程，
#                直到阻塞条件被满足。这即“让出 CPU 给其他协程”。
#     * 通道   = 环形缓冲（字典数组，字符串键）+ 计数；发送满/接收空时让出调度。
#     * 锁     = 互斥标志（协作式单线程下用于保护临界区语义）。
#     * 等待组 = 计数器；等待时不断让出调度直到归零。
#   让出() 为宿主内置空操作，协作点由本调度器的 让出调度 提供。
# ============================================================

# ---------------- 协程调度器 ----------------
# 全局就绪队列（协程函数）与队列头指针
让 g就绪 = []
让 g就绪头 = 0

# 启动协程：把函数 f 加入就绪队列，稍后由调度器运行
# 注意：不能用 g就绪 = g就绪 + [f]——解释器对“列表+函数元素”拼接有已知 bug，
# 会导致取元素时崩溃；改用 追加 原地入队。
函数 启动协程(f)
    追加(g就绪, f)
结束

# 让出调度：当前协程即将阻塞时，取出并运行下一个就绪协程（到它自己再次让出/完成）。
# 这是协作式调度的核心：用“推进其他协程”代替空转睡眠。
函数 让出调度()
    当 g就绪头 < 长度(g就绪) 循环
        让 f = g就绪[g就绪头]
        g就绪头 = g就绪头 + 1
        f()
        # 若运行完一个就绪协程后队列为空，当前协程的阻塞条件可能已满足，返回
        如果 g就绪头 >= 长度(g就绪) 则
            跳出
        结束
    结束
结束

# ---------------- 通道 ----------------
# 创建通道：容量 为缓冲槽数；容量=0 表示无缓冲（会合语义）
函数 创建通道(整数 容量)
    返回 {"头": 0, "尾": 0, "计数": 0, "容量": 容量, "关闭": 0, "项": {}}
结束

# 发送(v) 到通道；缓冲满则阻塞让出调度，直到有接收者取走数据
函数 发送(字典 ch, v)
    当 ch["计数"] >= ch["容量"] 循环
        让出调度()
    结束
    ch["项"][转字符串(ch["尾"])] = v
    ch["尾"] = ch["尾"] + 1
    ch["计数"] = ch["计数"] + 1
结束

# 从通道接收一个值；通道空则阻塞让出调度，直到有发送者放入数据
函数 接收(字典 ch)
    当 ch["计数"] <= 0 循环
        让出调度()
    结束
    让 v = ch["项"][转字符串(ch["头"])]
    ch["头"] = ch["头"] + 1
    ch["计数"] = ch["计数"] - 1
    返回 v
结束

# 关闭通道
函数 关闭(字典 ch)
    ch["关闭"] = 1
结束

# ---------------- 锁（互斥量） ----------------
# 创建互斥锁
函数 创建锁()
    返回 {"持有": 0}
结束

# 加锁：若已被占用则让出调度，直到获得所有权
函数 加锁(字典 l)
    当 l["持有"] == 1 循环
        让出调度()
    结束
    l["持有"] = 1
结束

# 解锁：释放锁
函数 解锁(字典 l)
    l["持有"] = 0
结束

# ---------------- 等待组（WaitGroup） ----------------
# 创建等待组
函数 创建等待组()
    返回 {"计数": 0}
结束

# 增加(n) 等待组计数
函数 增加(字典 wg, 整数 n)
    wg["计数"] = wg["计数"] + n
结束

# 完成()：一个任务结束，计数减一
函数 完成(字典 wg)
    wg["计数"] = wg["计数"] - 1
结束

# 等待组等待：阻塞直到计数归零；期间不断让出调度运行其他协程
函数 等待组等待(字典 wg)
    当 wg["计数"] > 0 循环
        让出调度()
    结束
结束

# ============================================================
# 元编程运行时（泛型 / 特性 / 反射 / 宏 / 编译期计算）
#
# 全部以纯 coCN 函数实现（语法分析器无需改动），
# 与并发运行时一样，由 cat 拼接后在 eval 解释器下运行。
# ============================================================

# ---------------- 1. 泛型（工厂函数 + 字典 + 闭包方法） ----------------

# 创建泛型列表：元素类型名作为字符串传入
函数 创建泛型列表(字符串 元素类型)
    让 实例 = {"__类型__": "泛型列表", "元素类型": 元素类型, "_数据": []}

    函数 追加方法(元素)
        追加(实例["_数据"], 元素)
    结束

    函数 获取方法(整数 索引)
        返回 实例["_数据"][索引]
    结束

    函数 长度方法()
        返回 长度(实例["_数据"])
    结束

    函数 包含方法(元素)
        对于 项 在 实例["_数据"] 循环
            如果 项 == 元素 则
                返回 1
            结束
        结束
        返回 0
    结束

    实例["追加"] = 追加方法
    实例["获取"] = 获取方法
    实例["长度"] = 长度方法
    实例["包含"] = 包含方法
    返回 实例
结束

# 创建泛型字典：键类型、值类型作为字符串传入
函数 创建泛型字典(字符串 键类型, 字符串 值类型)
    让 实例 = {"__类型__": "泛型字典", "键类型": 键类型, "值类型": 值类型, "_数据": {}}

    函数 设置方法(键, 值)
        实例["_数据"][键] = 值
    结束

    函数 获取方法(键)
        返回 实例["_数据"][键]
    结束

    函数 包含方法(键)
        返回 包含(实例["_数据"], 键)
    结束

    函数 长度方法()
        返回 长度(实例["_数据"])
    结束

    实例["设置"] = 设置方法
    实例["获取"] = 获取方法
    实例["包含"] = 包含方法
    实例["长度"] = 长度方法
    返回 实例
结束

# 泛型函数：对列表中的每个元素应用变换
函数 泛型映射(列表 源, 变换函数)
    让 结果 = []
    对于 项 在 源 循环
        追加(结果, 变换函数(项))
    结束
    返回 结果
结束

# ---------------- 2. 特性（Trait / Interface） ----------------

# 定义特性：要求的方法名列表 + 默认实现字典
函数 定义特性(列表 要求方法, 字典 默认实现)
    返回 {"__类型__": "特性", "要求": 要求方法, "默认实现": 默认实现}
结束

# 检查对象是否实现了特性的所有要求方法
函数 检查特性(字典 对象, 字典 特性)
    对于 i 从 0 到 长度(特性["要求"]) - 1 循环
        字符串 方法名 = 特性["要求"][i]
        如果 非 包含(对象, 方法名) 则
            返回 0
        结束
    结束
    返回 1
结束

# 实现特性：把特性的默认实现复制到对象上，返回对象
函数 实现特性(字典 对象, 字典 特性)
    对于 方法名 在 特性["默认实现"] 循环
        对象[方法名] = 特性["默认实现"][方法名]
    结束
    返回 对象
结束

# 检查多个特性（特性组合）：对象是否实现了所有给定特性
函数 检查多特性(字典 对象, 列表 特性列表)
    对于 i 从 0 到 长度(特性列表) - 1 循环
        如果 检查特性(对象, 特性列表[i]) == 0 则
            返回 0
        结束
    结束
    返回 1
结束

# ---------------- 3. 反射（运行时自省） ----------------

# 获取对象类型名：从 __类型__ 字段读取
函数 类型名(对象)
    如果 类型(对象) == "字典" 且 包含(对象, "__类型__") 则
        返回 对象["__类型__"]
    结束
    返回 类型(对象)
结束

# 获取对象的属性列表（非方法的键）
函数 属性列表(字典 对象)
    让 结果 = []
    对于 键 在 对象 循环
        字符串 k = 键
        如果 k != "__类型__" 则
            让 值 = 对象[键]
            如果 类型(值) != "函数" 则
                追加(结果, k)
            结束
        结束
    结束
    返回 结果
结束

# 获取对象的方法列表（值为函数的键）
函数 方法列表(字典 对象)
    让 结果 = []
    对于 键 在 对象 循环
        字符串 k = 键
        如果 k != "__类型__" 则
            让 值 = 对象[键]
            如果 类型(值) == "函数" 则
                追加(结果, k)
            结束
        结束
    结束
    返回 结果
结束

# 动态调用方法：对象[方法名](参数...)
# 参数列表作为第三个参数传入，按长度分发
函数 调用方法(字典 对象, 字符串 方法名, 列表 参数)
    让 方法 = 对象[方法名]
    如果 长度(参数) == 0 则
        返回 方法()
    结束
    如果 长度(参数) == 1 则
        返回 方法(参数[0])
    结束
    如果 长度(参数) == 2 则
        返回 方法(参数[0], 参数[1])
    结束
    如果 长度(参数) == 3 则
        返回 方法(参数[0], 参数[1], 参数[2])
    结束
    返回 0
结束

# 动态设置属性：对象[键] = 值
函数 设置属性(字典 对象, 字符串 键, 值)
    对象[键] = 值
结束

# 动态获取属性：对象[键]
函数 获取属性(字典 对象, 字符串 键)
    返回 对象[键]
结束

# ---------------- 4. 宏（编译期展开） ----------------

# 宏注册表：宏名 -> 展开函数
让 g宏表 = {}

# 注册宏：名字 到 展开函数 的映射
函数 注册宏(字符串 名字, 展开函数)
    g宏表[名字] = 展开函数
结束

# 检查是否为宏调用
函数 是宏调用(节点)
    如果 类型(节点) != "字典" 则
        返回 0
    结束
    如果 非 包含(节点, "类型") 则
        返回 0
    结束
    如果 节点["类型"] != "函数调用" 则
        返回 0
    结束
    如果 节点["被调者"]["类型"] != "标识符" 则
        返回 0
    结束
    字符串 名 = 节点["被调者"]["名字"]
    如果 包含(g宏表, 名) 则
        返回 1
    结束
    返回 0
结束

# 递归展开 AST 中的所有宏调用
函数 展开宏(节点)
    如果 类型(节点) == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(节点) - 1 循环
            追加(结果, 展开宏(节点[i]))
        结束
        返回 结果
    结束
    如果 类型(节点) != "字典" 则
        返回 节点
    结束
    如果 非 包含(节点, "类型") 则
        返回 节点
    结束

    # 如果是宏调用，展开它
    如果 是宏调用(节点) == 1 则
        字符串 名 = 节点["被调者"]["名字"]
        让 展开函数 = g宏表[名]
        # 先递归展开参数中的宏
        让 新参数 = []
        对于 i 从 0 到 长度(节点["参数"]) - 1 循环
            追加(新参数, 展开宏(节点["参数"][i]))
        结束
        # 调用宏展开函数，返回新的 AST 节点
        让 展开后 = 展开函数(新参数)
        # 递归展开展开结果中的宏
        返回 展开宏(展开后)
    结束

    # 否则递归处理所有子节点
    让 新节点 = {}
    对于 键 在 节点 循环
        如果 键 == "类型" 则
            新节点[键] = 节点[键]
        否则
            新节点[键] = 展开宏(节点[键])
        结束
    结束
    返回 新节点
结束

# ---------------- 5. 编译期计算（常量求值） ----------------

# 编译期常量注册表
让 g编译期常量 = {}

# 注册编译期常量
函数 注册编译期常量(字符串 名, 值)
    g编译期常量[名] = 值
结束

# 编译期求值：对纯常量表达式求值
函数 编译期求值(节点)
    如果 类型(节点) == "整数" 或 类型(节点) == "浮点" 则
        返回 节点
    结束
    # 标识符：查找编译期常量表
    如果 类型(节点) == "字典" 且 包含(节点, "类型") 则
        如果 节点["类型"] == "标识符" 则
            字符串 名 = 节点["名字"]
            如果 包含(g编译期常量, 名) 则
                返回 g编译期常量[名]
            结束
        结束
        # 二元运算：递归求值左右，然后计算
        如果 节点["类型"] == "二元" 则
            让 左值 = 编译期求值(节点["左"])
            让 右值 = 编译期求值(节点["右"])
            字符串 op = 节点["运算符"]
            如果 op == "+" 则 返回 左值 + 右值 结束
            如果 op == "-" 则 返回 左值 - 右值 结束
            如果 op == "*" 则 返回 左值 * 右值 结束
            如果 op == "//" 则 返回 左值 // 右值 结束
            如果 op == "%" 则 返回 左值 % 右值 结束
        结束
    结束
    # 无法编译期求值，返回原节点
    返回 节点
结束

# 编译期阶乘函数（编译期执行）
函数 编译期阶乘(整数 n) -> 整数
    如果 n <= 1 则
        返回 1
    结束
    返回 n * 编译期阶乘(n - 1)
结束

# 编译期断言：检查条件，不满足则抛出错误
函数 编译期断言(条件, 字符串 消息)
    如果 条件 == 0 则
        抛出 "编译期断言失败: " + 消息
    结束
结束


# ============================================================
# 高级特性运行时（运算符重载 / 装饰器 / 属性 / 枚举 / 命名空间）
#
# 全部以纯 coCN 函数实现（语法分析器无需改动）：
#   * 运算符重载 = 特殊方法名（__加__/__乘__/__等于__/__转字符串__）+ 运行时分派
#   * 装饰器     = 接收函数返回函数的高阶函数；组合装饰器叠加多条装饰器链
#   * 属性       = getter/setter 闭包（计算属性 / 只读属性 / 写入校验）
#   * 枚举       = 字典常量集合 + 名称↔值双向映射 + 遍历
#   * 命名空间   = 嵌套字典 + 深取 / 别名 / 合并（模拟导入）
# 与并发/元编程运行时一样，由 cat 拼接后在 eval 解释器下运行。
# ============================================================

# ---------------- 1. 运算符重载 ----------------

# 运算符 -> 特殊方法名映射
函数 运算符特殊方法(字符串 运算符) -> 字符串
    如果 运算符 == "+" 则 返回 "__加__" 结束
    如果 运算符 == "-" 则 返回 "__减__" 结束
    如果 运算符 == "*" 则 返回 "__乘__" 结束
    如果 运算符 == "/" 或 运算符 == "//" 则 返回 "__除__" 结束
    如果 运算符 == "==" 则 返回 "__等于__" 结束
    如果 运算符 == "!=" 则 返回 "__不等于__" 结束
    如果 运算符 == "<" 则 返回 "__小于__" 结束
    如果 运算符 == ">" 则 返回 "__大于__" 结束
    如果 运算符 == "<=" 则 返回 "__小于等于__" 结束
    如果 运算符 == ">=" 则 返回 "__大于等于__" 结束
    返回 ""
结束

# 运算符重载分派：二元运算时检查左操作数（对象/字典）是否实现对应特殊方法，
# 有则调用该方法（左对象.特殊方法(右)），否则走默认运算。
# != 可由 __等于__ 派生取反。
函数 运算重载(左, 字符串 运算符, 右)
    如果 类型(左) == "字典" 则
        字符串 方法名 = 运算符特殊方法(运算符)
        如果 方法名 != "" 且 包含(左, 方法名) 则
            返回 左[方法名](右)
        结束
        # 派生：!= 由 __等于__ 取反
        如果 运算符 == "!=" 且 包含(左, "__等于__") 则
            让 等 = 左["__等于__"](右)
            如果 等 == 1 则 返回 0 结束
            返回 1
        结束
    结束
    # 默认运算（标量）
    如果 运算符 == "+" 则 返回 左 + 右 结束
    如果 运算符 == "-" 则 返回 左 - 右 结束
    如果 运算符 == "*" 则 返回 左 * 右 结束
    如果 运算符 == "/" 则 返回 左 / 右 结束
    如果 运算符 == "//" 则 返回 左 // 右 结束
    如果 运算符 == "==" 则 返回 左 == 右 结束
    如果 运算符 == "<" 则 返回 左 < 右 结束
    如果 运算符 == ">" 则 返回 左 > 右 结束
    返回 0
结束

# 转可读字符串：对象实现 __转字符串__ 则调用之，否则默认转字符串
函数 转可读(对象)
    如果 类型(对象) == "字典" 且 包含(对象, "__转字符串__") 则
        返回 对象["__转字符串__"]()
    结束
    返回 转字符串(对象)
结束

# ---------------- 2. 装饰器 ----------------

# 组合装饰器：装饰器列表（list[0] 为最外层）依次叠加到目标函数上。
# 语义同 Python：@外 @内 f 等价于 外(内(f))。
函数 组合装饰器(列表 装饰器列表, 目标函数)
    让 n = 长度(装饰器列表)
    如果 n == 0 则 返回 目标函数 结束
    # 反转列表（最靠近函数的装饰器先应用），用正向循环索引实现
    让 反转 = []
    对于 i 从 0 到 n - 1 循环
        追加(反转, 装饰器列表[n - 1 - i])
    结束
    让 结果 = 目标函数
    对于 j 从 0 到 n - 1 循环
        结果 = 反转[j](结果)
    结束
    返回 结果
结束

# ---------------- 3. 属性 ----------------

# 定义属性：在对象上挂载 获取_名 / 设置_名；setter 非函数时为只读属性
函数 定义属性(字典 对象, 字符串 名, getter, setter)
    对象["获取_" + 名] = getter
    如果 类型(setter) == "函数" 则
        对象["设置_" + 名] = setter
    结束
    返回 对象
结束

# ---------------- 4. 枚举 ----------------

# 创建枚举：传入 成员名->值 字典；返回枚举对象（含常量与辅助方法）
函数 创建枚举(字典 成员)
    让 实例 = {"__类型__": "枚举", "_名称列表": []}
    # 拷贝成员常量并记录名称顺序
    对于 名 在 成员 循环
        实例[名] = 成员[名]
        追加(实例["_名称列表"], 名)
    结束
    函数 获取名称方法(值)
        对于 i 从 0 到 长度(实例["_名称列表"]) - 1 循环
            字符串 nm = 实例["_名称列表"][i]
            如果 实例[nm] == 值 则 返回 nm 结束
        结束
        返回 "未知"
    结束
    函数 获取值方法(字符串 名称)
        返回 实例[名称]
    结束
    函数 名称列表方法()
        返回 实例["_名称列表"]
    结束
    函数 遍历方法(回调)
        对于 i 从 0 到 长度(实例["_名称列表"]) - 1 循环
            字符串 nm = 实例["_名称列表"][i]
            回调(nm, 实例[nm])
        结束
    结束
    实例["获取名称"] = 获取名称方法
    实例["获取值"] = 获取值方法
    实例["名称列表"] = 名称列表方法
    实例["遍历"] = 遍历方法
    返回 实例
结束

# ---------------- 5. 命名空间 ----------------

# 深取：按路径列表从嵌套命名空间逐层取值
函数 深取(字典 命名空间, 列表 路径)
    让 当前 = 命名空间
    对于 i 从 0 到 长度(路径) - 1 循环
        当前 = 当前[路径[i]]
    结束
    返回 当前
结束

# 命名空间别名：返回同一嵌套对象的引用（别名）
函数 命名空间别名(字典 对象)
    返回 对象
结束

# 合并命名空间：把多个命名空间的成员平铺到一个字典（模拟导入到当前作用域）
函数 合并命名空间(列表 命名空间列表)
    让 结果 = {}
    对于 i 从 0 到 长度(命名空间列表) - 1 循环
        对于 键 在 命名空间列表[i] 循环
            结果[键] = 命名空间列表[i][键]
        结束
    结束
    返回 结果
结束

# ============================================================
# 异步编程运行时（Promise / 迭代器 / 生成器 / 异步函数 / 异步迭代器）
#
# 全部以纯 coCN 函数实现（语法分析器无需改动），与并发/元编程/高级特性
# 运行时一样，由 cat 拼接后在 eval 解释器下运行。
#
# 模型：
#   * Promise  = 字典（状态 pending/fulfilled/rejected + 值 + 回调队列）
#                然后/捕获/最终 注册回调；落定时排空队列；then 返回新 Promise 形成链。
#   * 迭代器   = 字典 下一个() -> {"值":v,"完成":0/1}；可迭代对象提供 __迭代器__()。
#   * 生成器   = 返回迭代器对象的工厂函数（闭包保存内部状态，产出=返回一个{值,完成}）。
#   * 异步函数 = 返回 Promise 的普通函数；等待承诺(p) 阻塞取 Promise 终值。
#   * 异步迭代器 = 下一个() 返回 Promise<{值,完成}>；等待遍历每个 驱动。
#
# 命名约定：被闭包捕获的局部变量一律用独特名（实例/下一个承诺/状态），
# 避免与用户程序里的常见变量名（p/结果/x 等）撞名——本解释器的闭包按名
# 绑定槽位，同名外层变量会串槽（与 测试高级特性 的 ctx 做法一致）。
# ============================================================

# ---------------- 1. Promise（承诺） ----------------

# 新建一个 pending 承诺对象（内部用）
函数 新建承诺()
    让 实例 = {"__类型__": "承诺"}
    实例["_状态"] = "pending"
    实例["_值"] = 0
    实例["_原因"] = 0
    实例["_队列"] = []
    实例["_最终队列"] = []
    返回 实例
结束

# 调用 then 回调：cb 为函数则执行，结果采用为 下一个承诺 的兑现值；否则按“穿透”规则落定。
# 无cb拒绝=1 表示本路径是 onRejected 且无回调时要把 下一个承诺 拒绝；
# 无cb拒绝=0 表示本路径是 onFulfilled 且无回调时把 下一个承诺 兑现为原值。
函数 承诺_调用回调(下一个承诺, cb, 参数, 无cb拒绝)
    如果 类型(cb) != "函数" 则
        如果 无cb拒绝 == 1 则
            拒绝承诺(下一个承诺, 参数)
        否则
            解决承诺(下一个承诺, 参数)
        结束
        返回
    结束
    尝试
        让 r = cb(参数)
        承诺_采用值(下一个承诺, r)
    捕获 e
        拒绝承诺(下一个承诺, e)
    结束
结束

# 采用 thenable：若 r 本身是承诺，则等它落定后再落定 下一个承诺；否则直接兑现。
函数 承诺_采用值(下一个承诺, r)
    如果 类型(r) == "字典" 且 包含(r, "__类型__") 且 r["__类型__"] == "承诺" 则
        函数 采用成功(v)
            解决承诺(下一个承诺, v)
        结束
        函数 采用失败(e)
            拒绝承诺(下一个承诺, e)
        结束
        r["然后"](采用成功)
        r["捕获"](采用失败)
    否则
        解决承诺(下一个承诺, r)
    结束
结束

# 排空单条 then/捕获 记录（承诺已落定）
函数 承诺_排空记录(承诺对象, 记录)
    如果 承诺对象["_状态"] == "fulfilled" 则
        承诺_调用回调(记录["next"], 记录["onF"], 承诺对象["_值"], 0)
    否则
        承诺_调用回调(记录["next"], 记录["onR"], 承诺对象["_原因"], 1)
    结束
结束

# 排空单条 finally 记录
函数 承诺_排空最终(承诺对象, 记录)
    如果 类型(记录["fn"]) == "函数" 则
        尝试
            记录["fn"]()
        捕获 e
            拒绝承诺(记录["next"], e)
            返回
        结束
    结束
    如果 承诺对象["_状态"] == "fulfilled" 则
        解决承诺(记录["next"], 承诺对象["_值"])
    否则
        拒绝承诺(记录["next"], 承诺对象["_原因"])
    结束
结束

# 兑现承诺：状态置 fulfilled 并排空所有队列（幂等）
函数 解决承诺(承诺对象, 值)
    如果 承诺对象["_状态"] != "pending" 则
        返回
    结束
    承诺对象["_状态"] = "fulfilled"
    承诺对象["_值"] = 值
    对于 i 从 0 到 长度(承诺对象["_队列"]) - 1 循环
        承诺_排空记录(承诺对象, 承诺对象["_队列"][i])
    结束
    对于 j 从 0 到 长度(承诺对象["_最终队列"]) - 1 循环
        承诺_排空最终(承诺对象, 承诺对象["_最终队列"][j])
    结束
结束

# 拒绝承诺：状态置 rejected 并排空所有队列（幂等）
函数 拒绝承诺(承诺对象, 原因)
    如果 承诺对象["_状态"] != "pending" 则
        返回
    结束
    承诺对象["_状态"] = "rejected"
    承诺对象["_原因"] = 原因
    对于 i 从 0 到 长度(承诺对象["_队列"]) - 1 循环
        承诺_排空记录(承诺对象, 承诺对象["_队列"][i])
    结束
    对于 j 从 0 到 长度(承诺对象["_最终队列"]) - 1 循环
        承诺_排空最终(承诺对象, 承诺对象["_最终队列"][j])
    结束
结束

# 在承诺对象上挂载 然后/捕获/最终 方法，返回该对象
函数 挂承诺方法(承诺对象)
    函数 然后方法(成功回调)
        返回 承诺_然后(承诺对象, 成功回调)
    结束
    函数 捕获方法(失败回调)
        返回 承诺_捕获(承诺对象, 失败回调)
    结束
    函数 最终方法(最终回调)
        返回 承诺_最终(承诺对象, 最终回调)
    结束
    承诺对象["然后"] = 然后方法
    承诺对象["捕获"] = 捕获方法
    承诺对象["最终"] = 最终方法
    返回 承诺对象
结束

# .then(onFulfilled)：返回新承诺
函数 承诺_然后(承诺对象, onF)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "onF": onF, "onR": 0}
    追加(承诺对象["_队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空记录(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# .catch(onRejected)：返回新承诺
函数 承诺_捕获(承诺对象, onR)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "onF": 0, "onR": onR}
    追加(承诺对象["_队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空记录(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# .finally(fn)：返回新承诺，落定时以本承诺的终态落定 下一个承诺
函数 承诺_最终(承诺对象, fn)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "fn": fn}
    追加(承诺对象["_最终队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空最终(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# 创建承诺：执行器(解决, 拒绝) 同步执行；执行器内抛错自动拒绝
函数 创建承诺(执行器)
    让 实例 = 挂承诺方法(新建承诺())
    函数 解决fn(v)
        解决承诺(实例, v)
    结束
    函数 拒绝fn(e)
        拒绝承诺(实例, e)
    结束
    尝试
        执行器(解决fn, 拒绝fn)
    捕获 e
        拒绝承诺(实例, e)
    结束
    返回 实例
结束

# ---- 静态方法工厂（避免循环内闭包按名绑定串槽） ----
# 用单一上下文字典传状态，闭包只捕获一个独特名 全部上下文，避免与外层局部同名串槽。
# 全部上下文 = {"结果表":..., "计数":{n}, "总数":n, "聚合":promise, "idx":k}
函数 建全部成功回调(全部上下文)
    函数 收集成功(v)
        全部上下文["结果表"][全部上下文["idx"]] = v
        全部上下文["计数"]["n"] = 全部上下文["计数"]["n"] + 1
        如果 全部上下文["计数"]["n"] == 全部上下文["总数"] 则
            解决承诺(全部上下文["聚合"], 全部上下文["结果表"])
        结束
    结束
    返回 收集成功
结束

# 为 承诺.全部 构造失败回调
函数 建全部失败回调(聚合)
    函数 任一失败(e)
        拒绝承诺(聚合, e)
    结束
    返回 任一失败
结束

# 承诺.解决(v)：立刻兑现的承诺
函数 承诺_解决静态(v)
    让 实例 = 挂承诺方法(新建承诺())
    解决承诺(实例, v)
    返回 实例
结束

# 承诺.拒绝(e)：立刻拒绝的承诺
函数 承诺_拒绝静态(e)
    让 实例 = 挂承诺方法(新建承诺())
    拒绝承诺(实例, e)
    返回 实例
结束

# 承诺.全部([...])：全部兑现后以“值列表”兑现；任一拒绝则整体拒绝
函数 承诺_全部静态(列表 ps)
    让 聚合 = 挂承诺方法(新建承诺())
    让 n = 长度(ps)
    让 结果表 = []
    让 计数 = {"n": 0}
    对于 i 从 0 到 n - 1 循环
        追加(结果表, 0)
    结束
    如果 n == 0 则
        解决承诺(聚合, 结果表)
        返回 聚合
    结束
    对于 k 从 0 到 n - 1 循环
        让 全部上下文 = {"结果表": 结果表, "计数": 计数, "总数": n, "聚合": 聚合, "idx": k}
        ps[k]["然后"](建全部成功回调(全部上下文))
        ps[k]["捕获"](建全部失败回调(聚合))
    结束
    返回 聚合
结束

# 承诺.竞速([...])：第一个落定（兑现或拒绝）的承诺决定聚合终态
函数 承诺_竞速静态(列表 ps)
    让 聚合 = 挂承诺方法(新建承诺())
    函数 竞速成功(v)
        解决承诺(聚合, v)
    结束
    函数 竞速失败(e)
        拒绝承诺(聚合, e)
    结束
    对于 k 从 0 到 长度(ps) - 1 循环
        ps[k]["然后"](竞速成功)
        ps[k]["捕获"](竞速失败)
    结束
    返回 聚合
结束

# 承诺 静态命名空间
让 承诺 = {}
承诺["解决"] = 承诺_解决静态
承诺["拒绝"] = 承诺_拒绝静态
承诺["全部"] = 承诺_全部静态
承诺["竞速"] = 承诺_竞速静态

# ---------------- 2. 迭代器协议 ----------------

# 列表迭代器：把普通列表包装成迭代器对象
函数 创建列表迭代器(列表 数据)
    让 状态 = {"数据": 数据, "下标": 0}
    函数 下一个方法()
        如果 状态["下标"] < 长度(状态["数据"]) 则
            让 v = 状态["数据"][状态["下标"]]
            状态["下标"] = 状态["下标"] + 1
            返回 {"值": v, "完成": 0}
        结束
        返回 {"值": 0, "完成": 1}
    结束
    返回 {"下一个": 下一个方法}
结束

# 获取迭代器：
#   - 若对象有 __迭代器__  → 调用之得到迭代器
#   - 若对象本身有 下一个  → 它已是迭代器，直接返回（生成器即如此）
#   - 否则按列表/字符串包装成下标迭代器
函数 获取迭代器(可迭代)
    如果 类型(可迭代) == "字典" 且 包含(可迭代, "__迭代器__") 则
        返回 可迭代["__迭代器__"]()
    结束
    如果 类型(可迭代) == "字典" 且 包含(可迭代, "下一个") 则
        返回 可迭代
    结束
    返回 创建列表迭代器(可迭代)
结束

# 遍历每个：驱动迭代器协议，对每个值调用 回调(value)
函数 遍历每个(可迭代, 回调)
    让 it = 获取迭代器(可迭代)
    当 真 循环
        让 r = it["下一个"]()
        如果 r["完成"] == 1 则
            跳出
        结束
        回调(r["值"])
    结束
结束

# 收集：把迭代器/可迭代对象排空为列表
函数 收集(可迭代)
    让 结果 = []
    函数 收(v)
        追加(结果, v)
    结束
    遍历每个(可迭代, 收)
    返回 结果
结束

# 范围对象 [下限..上限]（含两端），实现 __迭代器__。
# 注意：本 VM 不支持三层闭包嵌套（外层→中层→内层 闭包捕获中层局部变量会串槽），
# 故迭代器对象用顶层辅助函数 创建范围迭代器 构造（两层闭包）。
函数 创建范围迭代器(下限, 上限)
    让 状态 = {"v": 下限, "峰值": 上限}
    函数 nm()
        如果 状态["v"] <= 状态["峰值"] 则
            让 val = 状态["v"]
            状态["v"] = 状态["v"] + 1
            返回 {"值": val, "完成": 0}
        结束
        返回 {"值": 0, "完成": 1}
    结束
    返回 {"下一个": nm}
结束

函数 创建范围(下限, 上限)
    让 实例 = {"下限": 下限, "上限": 上限}
    函数 迭代器方法()
        返回 创建范围迭代器(实例["下限"], 实例["上限"])
    结束
    实例["__迭代器__"] = 迭代器方法
    返回 实例
结束

# ---------------- 3. 生成器（Generator） ----------------
# 生成器 = 返回迭代器对象（{"下一个": fn}）的工厂函数，闭包保存内部状态。
# “产出 v” = 下一个方法返回 {"值": v, "完成": 0}；结束时返回 {"值":0,"完成":1}。
# 生成器委托（产出*另一个）：在状态机里先排空内层迭代器，再切到外层。

# ---------------- 4. 异步函数（async/await） ----------------

# 等待承诺(p)：阻塞直到承诺落定，返回兑现值；拒绝则抛出原因。
# 对非承诺值直接原样返回。pending 期间不断让出调度推进其他协程/回调。
# 注：coCN 保留字 `等待` 为协程等待语句，不能作函数名，故用 `等待承诺`。
函数 等待承诺(承诺对象)
    如果 类型(承诺对象) != "字典" 则
        返回 承诺对象
    结束
    如果 非 包含(承诺对象, "_状态") 则
        返回 承诺对象
    结束
    当 承诺对象["_状态"] == "pending" 循环
        让出调度()
    结束
    如果 承诺对象["_状态"] == "rejected" 则
        抛出 承诺对象["_原因"]
    结束
    返回 承诺对象["_值"]
结束

# 创建异步函数（0 参数）：把普通 0 参函数包装为“返回承诺”的异步函数。
# 函数返回值若是承诺（thenable）则自动采用，异常自动 reject。
函数 创建异步函数0(fn)
    函数 包装()
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn())
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# 创建异步函数（1 参数）
函数 创建异步函数1(fn)
    函数 包装(a)
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn(a))
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# 创建异步函数（2 参数）
函数 创建异步函数2(fn)
    函数 包装(a, b)
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn(a, b))
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# ---------------- 5. 异步迭代器（for-await-of） ----------------
# 异步迭代器：下一个() 返回 Promise<{"值":v,"完成":0/1}>。
# 等待遍历每个：驱动异步迭代器，对每个值调用 回调(value)。
函数 等待遍历每个(异步可迭代, 回调)
    让 it = 异步可迭代
    如果 类型(it) == "字典" 且 包含(it, "__异步迭代器__") 则
        it = it["__异步迭代器__"]()
    结束
    当 真 循环
        让 pr = it["下一个"]()
        让 r = 等待承诺(pr)
        如果 r["完成"] == 1 则
            跳出
        结束
        回调(r["值"])
    结束
结束

# 等待收集：把异步迭代器排空为列表（顺序收集）
函数 等待收集(异步可迭代)
    让 结果 = []
    函数 收(v)
        追加(结果, v)
    结束
    等待遍历每个(异步可迭代, 收)
    返回 结果
结束

# ============================================================
# Web 开发运行时（JSON / HTTP 服务器 / 路由 / 中间件 / 模板引擎）
#
# 全部以纯 coCN【顶层函数】实现（语法分析器无需改动）。
# 设计约束：本自举解释器对“函数内嵌套多个闭包”有已知缺陷（会挂起），
# 故采用与 并发运行时 / OOP 相同的风格——
#   * 对象 = 字典；方法 = 顶层函数，首参为接收者（字典）；
#   * 中间件链 = 显式 链上下文 字典 + 顶层 中间件执行下一个，无闭包。
#
# 模型：
#   * JSON    = 递归下降解析器 + 递归序列化器；布尔用标记字典 {"__b__":1/0}。
#   * HTTP服务器 = 字典；服务器监听/服务器使用/服务器处理请求。
#   * 路由    = 字典；路由注册(router,"GET",path,fn)；:名 取参，结尾 * 通配。
#   * 中间件  = 函数(请求,响应,链上下文)；调用 中间件执行下一个(链上下文) 继续。
#   * 模板引擎 = 递归下降渲染；{{变量}}/{{对于}}/{{如果}}/{{包含}}，自动转义。
# ============================================================

# ---------------- 1. JSON 解析 ----------------
函数 JSON跳过空白(ctx)
    让 s = ctx["文本"]
    让 n = 长度(s)
    当 ctx["pos"] < n 循环
        让 c = 截取(s, ctx["pos"], 1)
        如果 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r" 则
            ctx["pos"] = ctx["pos"] + 1
        否则
            跳出
        结束
    结束
结束

函数 JSON解析字符串(ctx) -> 字符串
    让 s = ctx["文本"]
    让 n = 长度(s)
    ctx["pos"] = ctx["pos"] + 1
    让 r = ""
    当 真 循环
        如果 ctx["pos"] >= n 则
            抛出 "JSON字符串未闭合"
        结束
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "\"" 则
            跳出
        结束
        如果 c == "\\" 则
            让 e = 截取(s, ctx["pos"], 1)
            ctx["pos"] = ctx["pos"] + 1
            如果 e == "n" 则
                r = r + "\n"
            否则 如果 e == "t" 则
                r = r + "\t"
            否则 如果 e == "r" 则
                r = r + "\r"
            否则 如果 e == "\"" 则
                r = r + "\""
            否则 如果 e == "\\" 则
                r = r + "\\"
            否则 如果 e == "/" 则
                r = r + "/"
            否则 如果 e == "u" 则
                ctx["pos"] = ctx["pos"] + 4
            结束
        否则
            r = r + c
        结束
    结束
    返回 r
结束

函数 JSON解析数字(ctx)
    让 s = ctx["文本"]
    让 n = 长度(s)
    让 起 = ctx["pos"]
    当 ctx["pos"] < n 循环
        让 c = 截取(s, ctx["pos"], 1)
        如果 c == "," 或 c == "}" 或 c == "]" 或 c == " " 或 c == "\n" 或 c == "\t" 或 c == "\r" 则
            跳出
        结束
        ctx["pos"] = ctx["pos"] + 1
    结束
    让 文本 = 截取(s, 起, ctx["pos"] - 起)
    如果 包含(文本, ".") 或 包含(文本, "e") 或 包含(文本, "E") 则
        返回 转浮点(文本)
    结束
    返回 转整数(文本)
结束

函数 JSON解析对象(ctx) -> 字典
    让 s = ctx["文本"]
    让 obj = {}
    ctx["pos"] = ctx["pos"] + 1
    JSON跳过空白(ctx)
    如果 截取(s, ctx["pos"], 1) == "}" 则
        ctx["pos"] = ctx["pos"] + 1
        返回 obj
    结束
    当 真 循环
        JSON跳过空白(ctx)
        让 key = JSON解析字符串(ctx)
        JSON跳过空白(ctx)
        ctx["pos"] = ctx["pos"] + 1
        让 val = JSON解析值(ctx)
        obj[key] = val
        JSON跳过空白(ctx)
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "}" 则
            跳出
        结束
    结束
    返回 obj
结束

函数 JSON解析数组(ctx) -> 列表
    让 s = ctx["文本"]
    让 arr = []
    ctx["pos"] = ctx["pos"] + 1
    JSON跳过空白(ctx)
    如果 截取(s, ctx["pos"], 1) == "]" 则
        ctx["pos"] = ctx["pos"] + 1
        返回 arr
    结束
    当 真 循环
        让 val = JSON解析值(ctx)
        追加(arr, val)
        JSON跳过空白(ctx)
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "]" 则
            跳出
        结束
    结束
    返回 arr
结束

函数 JSON解析值(ctx)
    JSON跳过空白(ctx)
    让 s = ctx["文本"]
    让 c = 截取(s, ctx["pos"], 1)
    如果 c == "{" 则
        返回 JSON解析对象(ctx)
    结束
    如果 c == "[" 则
        返回 JSON解析数组(ctx)
    结束
    如果 c == "\"" 则
        返回 JSON解析字符串(ctx)
    结束
    如果 c == "t" 则
        ctx["pos"] = ctx["pos"] + 4
        返回 {"__b__": 1}
    结束
    如果 c == "f" 则
        ctx["pos"] = ctx["pos"] + 5
        返回 {"__b__": 0}
    结束
    如果 c == "n" 则
        ctx["pos"] = ctx["pos"] + 4
        返回 空
    结束
    返回 JSON解析数字(ctx)
结束

函数 JSON解析(字符串 s)
    让 ctx = {"文本": s, "pos": 0}
    返回 JSON解析值(ctx)
结束

# ---------------- 2. JSON 序列化 ----------------
函数 JSON转义字符串(字符串 s) -> 字符串
    让 r = "\""
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = 截取(s, i, 1)
        如果 c == "\"" 则
            r = r + "\\\""
        否则 如果 c == "\\" 则
            r = r + "\\\\"
        否则 如果 c == "\n" 则
            r = r + "\\n"
        否则 如果 c == "\t" 则
            r = r + "\\t"
        否则 如果 c == "\r" 则
            r = r + "\\r"
        否则
            r = r + c
        结束
    结束
    返回 r + "\""
结束

函数 JSON序列化数组(列表 arr, 美化, 层) -> 字符串
    让 n = 长度(arr)
    如果 n == 0 则
        返回 "[]"
    结束
    让 r = "["
    对于 i 从 0 到 n - 1 循环
        如果 i > 0 则
            r = r + ","
        结束
        如果 美化 则
            r = r + "\n"
            对于 sp 从 0 到 层 循环
                r = r + "  "
            结束
        结束
        r = r + JSON序列化值(arr[i], 美化, 层 + 1)
    结束
    如果 美化 则
        r = r + "\n"
        对于 sp 从 0 到 层 - 1 循环
            r = r + "  "
        结束
    结束
    返回 r + "]"
结束

函数 JSON序列化对象(字典 obj, 美化, 层) -> 字符串
    让 n = 长度(obj)
    如果 n == 0 则
        返回 "{}"
    结束
    让 r = "{"
    让 首 = 1
    对于 k 在 obj 循环
        如果 非 (k == "__b__") 则
            如果 首 == 0 则
                r = r + ","
            结束
            首 = 0
            如果 美化 则
                r = r + "\n"
                对于 sp 从 0 到 层 循环
                    r = r + "  "
                结束
            结束
            r = r + JSON转义字符串(k) + ":"
            如果 美化 则
                r = r + " "
            结束
            r = r + JSON序列化值(obj[k], 美化, 层 + 1)
        结束
    结束
    如果 美化 则
        r = r + "\n"
        对于 sp 从 0 到 层 - 1 循环
            r = r + "  "
        结束
    结束
    返回 r + "}"
结束

函数 JSON序列化值(v, 美化, 层) -> 字符串
    让 t = 类型(v)
    如果 t == "字符串" 则
        返回 JSON转义字符串(v)
    结束
    如果 t == "字典" 则
        如果 包含(v, "__b__") 则
            如果 v["__b__"] == 1 则
                返回 "true"
            结束
            返回 "false"
        结束
        返回 JSON序列化对象(v, 美化, 层)
    结束
    如果 t == "列表" 则
        返回 JSON序列化数组(v, 美化, 层)
    结束
    如果 v == 空 则
        返回 "null"
    结束
    如果 t == "整数" 或 t == "浮点" 则
        返回 转字符串(v)
    结束
    返回 "null"
结束

函数 JSON序列化(v, 美化) -> 字符串
    返回 JSON序列化值(v, 美化, 0)
结束

函数 JSON验证(字符串 s) -> 整数
    尝试
        让 ctx = {"文本": s, "pos": 0}
        让 v = JSON解析值(ctx)
        JSON跳过空白(ctx)
        如果 ctx["pos"] != 长度(s) 则
            返回 0
        结束
        返回 1
    捕获 e
        返回 0
    结束
结束

# ---------------- 3. HTTP 响应对象 ----------------
函数 创建响应() -> 字典
    返回 {"状态码": 200, "头部": {}, "body": "", "已结束": 0}
结束

函数 响应设置头(字典 res, 字符串 键, 值)
    res["头部"][键] = 值
结束

函数 响应结束(字典 res, 内容)
    如果 内容 != 空 则
        res["body"] = res["body"] + 内容
    结束
    res["已结束"] = 1
结束

# ---------------- 4. 路由匹配 ----------------
函数 匹配路径(段表, 字符串 路径) -> 字典
    让 请求段 = 分割(路径, "/")
    让 参数 = {}
    让 段数 = 长度(段表)
    让 实段数 = 长度(请求段)
    让 最后段 = 段表[段数 - 1]
    如果 最后段 == "*" 则
        对于 i 从 0 到 段数 - 2 循环
            如果 i >= 实段数 则
                返回 {"匹配": 0, "参数": {}}
            结束
            让 模 = 段表[i]
            如果 长度(模) > 0 且 模[0] == ":" 则
                让 名 = 截取(模, 1, 长度(模) - 1)
                参数[名] = 请求段[i]
            否则
                如果 模 != 请求段[i] 则
                    返回 {"匹配": 0, "参数": {}}
                结束
            结束
        结束
        返回 {"匹配": 1, "参数": 参数}
    结束
    如果 段数 != 实段数 则
        返回 {"匹配": 0, "参数": {}}
    结束
    对于 j 从 0 到 段数 - 1 循环
        让 模 = 段表[j]
        让 实 = 请求段[j]
        如果 长度(模) > 0 且 模[0] == ":" 则
            让 名 = 截取(模, 1, 长度(模) - 1)
            参数[名] = 实
        否则
            如果 模 != 实 则
                返回 {"匹配": 0, "参数": {}}
            结束
        结束
    结束
    返回 {"匹配": 1, "参数": 参数}
结束

函数 创建路由器() -> 字典
    返回 {"路由表": []}
结束

函数 路由注册(字典 r, 字符串 方法, 字符串 模板, fn)
    追加(r["路由表"], {"方法": 方法, "段表": 分割(模板, "/"), "处理": fn})
结束

函数 路由处理(字典 r, 请求, 响应, 链上下文)
    让 表 = r["路由表"]
    对于 i 从 0 到 长度(表) - 1 循环
        让 路由 = 表[i]
        如果 路由["方法"] == 请求["方法"] 则
            让 结果 = 匹配路径(路由["段表"], 请求["路径"])
            如果 结果["匹配"] == 1 则
                请求["参数"] = 结果["参数"]
                路由["处理"](请求, 响应, 链上下文)
                返回
            结束
        结束
    结束
    如果 响应["已结束"] == 0 则
        响应["状态码"] = 404
        响应结束(响应, "404 Not Found")
    结束
    如果 链上下文 != 空 则
        中间件执行下一个(链上下文)
    结束
结束

# ---------------- 5. 中间件链（无闭包） ----------------
# 链上下文 = {"链":[...], "idx":0, "请求":req, "响应":res}
函数 中间件执行下一个(ctx)
    如果 ctx["idx"] >= 长度(ctx["链"]) 则
        返回
    结束
    让 条目 = ctx["链"][ctx["idx"]]
    ctx["idx"] = ctx["idx"] + 1
    如果 包含(条目, "路由") 则
        路由处理(条目["路由"], ctx["请求"], ctx["响应"], ctx)
    否则
        条目["fn"](ctx["请求"], ctx["响应"], ctx)
    结束
结束

函数 创建HTTP服务器() -> 字典
    返回 {"中间件": [], "端口": 0, "_最终处理": 0}
结束

函数 服务器使用(字典 srv, a, b)
    如果 类型(a) == "字符串" 则
        追加(srv["中间件"], {"前缀": a, "fn": b})
    否则
        追加(srv["中间件"], {"前缀": "", "fn": a})
    结束
结束

# 把路由器挂载到服务器（路由作为链中的一环）
函数 服务器路由(字典 srv, 字典 路由器)
    追加(srv["中间件"], {"前缀": "", "路由": 路由器})
结束

函数 服务器监听(字典 srv, 整数 端口, fn)
    srv["端口"] = 端口
    srv["_最终处理"] = fn
结束

函数 服务器处理请求(字典 srv, 请求) -> 字典
    让 响应 = 创建响应()
    请求["参数"] = {}
    让 链 = []
    对于 i 从 0 到 长度(srv["中间件"]) - 1 循环
        让 mw = srv["中间件"][i]
        如果 mw["前缀"] == "" 或 截取(请求["路径"], 0, 长度(mw["前缀"])) == mw["前缀"] 则
            追加(链, mw)
        结束
    结束
    如果 类型(srv["_最终处理"]) == "函数" 则
        追加(链, {"fn": srv["_最终处理"]})
    结束
    让 ctx = {"链": 链, "idx": 0, "请求": 请求, "响应": 响应}
    中间件执行下一个(ctx)
    返回 响应
结束

# ---------------- 6. 模板引擎 ----------------
函数 模板取值(数据, 路径)
    让 部分 = 分割(路径, ".")
    让 v = 空
    如果 类型(数据) == "字典" 且 包含(数据, 部分[0]) 则
        v = 数据[部分[0]]
    结束
    对于 i 从 1 到 长度(部分) - 1 循环
        如果 类型(v) == "字典" 且 包含(v, 部分[i]) 则
            v = v[部分[i]]
        否则
            v = 空
        结束
    结束
    返回 v
结束

函数 模板值转字符串(v) -> 字符串
    让 t = 类型(v)
    如果 t == "字符串" 则
        让 r = ""
        对于 i 从 0 到 长度(v) - 1 循环
            让 c = 截取(v, i, 1)
            如果 c == "&" 则
                r = r + "&amp;"
            否则 如果 c == "<" 则
                r = r + "&lt;"
            否则 如果 c == ">" 则
                r = r + "&gt;"
            否则 如果 c == "\"" 则
                r = r + "&quot;"
            否则
                r = r + c
            结束
        结束
        返回 r
    结束
    如果 v == 空 则
        返回 ""
    结束
    如果 t == "字典" 或 t == "列表" 则
        返回 JSON序列化(v, 0)
    结束
    返回 转字符串(v)
结束

函数 模板渲染段(ctx) -> 字符串
    让 源 = ctx["源"]
    让 n = 长度(源)
    让 输出 = ""
    当 ctx["pos"] < n 循环
        让 剩余 = 截取(源, ctx["pos"], n - ctx["pos"])
        让 lb = 查找(剩余, "{{")
        如果 lb < 0 则
            输出 = 输出 + 剩余
            ctx["pos"] = n
            跳出
        结束
        输出 = 输出 + 截取(剩余, 0, lb)
        ctx["pos"] = ctx["pos"] + lb
        让 从标签 = 截取(源, ctx["pos"], n - ctx["pos"])
        让 rb = 查找(从标签, "}}")
        如果 rb < 0 则
            输出 = 输出 + 从标签
            ctx["pos"] = n
            跳出
        结束
        让 内部 = 去除空白(截取(从标签, 2, rb - 2))
        ctx["pos"] = ctx["pos"] + rb + 2

        如果 内部 == "结束" 则
            ctx["停止"] = "结束"
            跳出
        结束
        如果 内部 == "否则" 则
            ctx["停止"] = "否则"
            跳出
        结束

        # 对于 项 在 列表
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "对于" 则
            让 词 = 分割(内部, " ")
            让 项名 = 词[1]
            让 列表路径 = 词[3]
            让 列表值 = 模板取值(ctx["数据"], 列表路径)
            让 体开始 = ctx["pos"]
            # 先渲染一次定位 体结束（找到 {{结束}}）
            ctx["停止"] = ""
            模板渲染段(ctx)
            让 体结束 = ctx["pos"]
            如果 类型(列表值) == "列表" 则
                对于 k 从 0 到 长度(列表值) - 1 循环
                    ctx["数据"][项名] = 列表值[k]
                    ctx["停止"] = ""
                    ctx["pos"] = 体开始
                    输出 = 输出 + 模板渲染段(ctx)
                结束
            否则
                ctx["停止"] = ""
                ctx["pos"] = 体开始
                输出 = 输出 + 模板渲染段(ctx)
            结束
            ctx["pos"] = 体结束
            继续
        结束

        # 如果 条件
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "如果" 则
            让 词 = 分割(内部, " ")
            让 条件路径 = 词[1]
            让 条件值 = 模板取值(ctx["数据"], 条件路径)
            让 条件成立 = 0
            如果 条件值 != 空 则
                如果 类型(条件值) == "整数" 则
                    条件成立 = 条件值
                否则 如果 类型(条件值) == "字典" 且 包含(条件值, "__b__") 则
                    条件成立 = 条件值["__b__"]
                否则
                    条件成立 = 1
                结束
            结束
            如果 条件成立 == 1 则
                ctx["停止"] = ""
                输出 = 输出 + 模板渲染段(ctx)
                如果 ctx["停止"] == "否则" 则
                    ctx["停止"] = ""
                    模板渲染段(ctx)
                结束
            否则
                ctx["停止"] = ""
                模板渲染段(ctx)
                如果 ctx["停止"] == "否则" 则
                    ctx["停止"] = ""
                    输出 = 输出 + 模板渲染段(ctx)
                结束
            结束
            继续
        结束

        # 包含 "file"
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "包含" 则
            让 左 = 查找(内部, "\"")
            让 文件名 = ""
            如果 左 >= 0 则
                让 右区 = 截取(内部, 左 + 1, 长度(内部) - 左 - 1)
                让 右 = 查找(右区, "\"")
                如果 右 >= 0 则
                    文件名 = 截取(内部, 左 + 1, 右)
                结束
            结束
            让 文件内容 = 读取文件(ctx["目录"] + "/" + 文件名)
            输出 = 输出 + 渲染模板字符串(文件内容, ctx["数据"], ctx["目录"])
            继续
        结束

        # 块 "name"：块内内容直接渲染
        如果 长度(内部) >= 1 且 内部[0] == "块" 则
            ctx["停止"] = ""
            输出 = 输出 + 模板渲染段(ctx)
            继续
        结束

        # 普通变量
        让 值 = 模板取值(ctx["数据"], 内部)
        输出 = 输出 + 模板值转字符串(值)
    结束
    返回 输出
结束

函数 渲染模板字符串(字符串 源, 数据, 目录) -> 字符串
    让 ctx = {"源": 源, "pos": 0, "数据": 数据, "目录": 目录, "停止": ""}
    返回 模板渲染段(ctx)
结束

函数 创建模板引擎(字符串 目录) -> 字典
    返回 {"目录": 目录}
结束
# 原生驱动.co —— AOT 编译驱动（coCN 源码 -> x86-64 汇编）
# 由 cocn.js 调用：COCN_INPUT=程序.co COCN_ASM=输出.s
让 输入路径 = 环境变量("COCN_INPUT")
让 输出路径 = 环境变量("COCN_ASM")
若 输入路径 == "" 则
    输出("原生驱动: 缺少 COCN_INPUT")
结束
让 源 = 读取文件(输入路径)
让 ast = 解析源(源)
让 汇编 = 生成汇编(ast)
写入文件(输出路径, 汇编)
