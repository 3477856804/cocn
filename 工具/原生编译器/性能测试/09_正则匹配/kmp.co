# ============================================================
# 09_正则匹配/kmp.co —— coCN 原生版本（整数列表存 ASCII 码，与 kmp.c 同序列）
# 说明：HEAD codegen 的字符串下标 s[i] 返回裸指针却被标为 box，
#       打印/比较均错，故 KMP 用整数列表表示字符序列，比较为整数 ==。
# 文本块 "ababcabcabababd" 重复 4 次；模式 "ababd"。
# ============================================================

函数 build_next(列表 pat, 列表 next, 整数 m)
    next[0] = -1
    整数 i = 0
    整数 j = -1
    当 i < m - 1 循环
        如果 j == -1 或 0 + pat[i] == 0 + pat[j] 则
            i = i + 1
            j = j + 1
            next[i] = j
        否则
            j = 0 + next[j]
        结束
    结束
结束

函数 kmp_count(列表 text, 列表 pat, 列表 next, 整数 n, 整数 m) -> 整数
    整数 i = 0
    整数 j = 0
    整数 count = 0
    当 i < n 循环
        如果 j == -1 或 0 + text[i] == 0 + pat[j] 则
            i = i + 1
            j = j + 1
            如果 j == m 则
                count = count + 1
                j = 0 + next[j]
            结束
        否则
            j = 0 + next[j]
        结束
    结束
    返回 count
结束

# 构建文本：块 "ababcabcabababd" = [97,98,97,98,99,97,98,99,97,98,97,98,97,98,100]
列表 text = []
对于 rep 从 0 到 3 循环
    追加(text, 97)
    追加(text, 98)
    追加(text, 97)
    追加(text, 98)
    追加(text, 99)
    追加(text, 97)
    追加(text, 98)
    追加(text, 99)
    追加(text, 97)
    追加(text, 98)
    追加(text, 97)
    追加(text, 98)
    追加(text, 97)
    追加(text, 98)
    追加(text, 100)
结束
整数 n = 长度(text)
列表 pat = [97, 98, 97, 98, 100]
整数 m = 长度(pat)

整数 total = 0
对于 k 从 0 到 9999 循环
    列表 next = []
    对于 t 从 0 到 m 循环
        追加(next, 0)
    结束
    build_next(pat, next, m)
    total = total + kmp_count(text, pat, next, n, m)
结束

输出 "RESULT=" + 转字符串(total)
