# 微基准/内存访问.co —— coCN 版本
# 测试：数组随机访问

导入 "标准库"
随机种子(42)

整数 SIZE = 1000000
列表 数组 = []
对于 i 从 0 到 SIZE - 1 循环
    追加(数组, 随机整数(0, 2147483647))
结束

浮点 t0 = 时间戳()
让 总和 = 0
对于 i 从 0 到 9999999 循环
    整数 idx = 随机整数(0, SIZE - 1)
    总和 = 总和 + 数组[idx]
结束
浮点 t1 = 时间戳()
输出 "sum =", 总和
输出 "TIME_COCN=" + 转字符串(t1 - t0)
