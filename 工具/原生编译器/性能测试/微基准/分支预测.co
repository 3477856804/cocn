# 微基准/分支预测.co —— coCN 版本
# 测试：随机分支对分支预测的影响

导入 "标准库"
随机种子(42)

整数 n = 1000000
列表 数据 = []
对于 i 从 0 到 n - 1 循环
    追加(数据, 随机整数(0, 99))
结束

浮点 t0 = 时间戳()
让 总和 = 0
对于 rep 从 0 到 99 循环
    对于 i 从 0 到 n - 1 循环
        如果 数据[i] >= 50 则
            总和 = 总和 + 数据[i]
        否则
            总和 = 总和 - 数据[i]
        结束
    结束
结束
浮点 t1 = 时间戳()
输出 "sum =", 总和
输出 "TIME_COCN=" + 转字符串(t1 - t0)
