# ============================================================
# 04_快速排序/qsort.co —— coCN 原生版本（与 qsort.c 同算法/同 LCG）
# 注意：原生编译器无 随机()/时间戳()，用 LCG 生成数据。
#       从列表取箱内整数必须写成 `0 + L[i]` 才能正确拆箱。
# ============================================================

函数 rnd(整数 s) -> 整数
    返回 (s * 1103515245 + 12345) & 2147483647
结束

函数 qsort(列表 L, 整数 lo, 整数 hi)
    如果 lo >= hi 则
        返回
    结束
    整数 pivot = 0 + L[(lo + hi) // 2]
    整数 i = lo
    整数 j = hi
    当 i <= j 循环
        当 0 + L[i] < pivot 循环
            i = i + 1
        结束
        当 0 + L[j] > pivot 循环
            j = j - 1
        结束
        如果 i <= j 则
            整数 t = 0 + L[i]
            L[i] = L[j]
            L[j] = t
            i = i + 1
            j = j - 1
        结束
    结束
    qsort(L, lo, j)
    qsort(L, i, hi)
结束

整数 N = 1000000
列表 L = []
整数 st = 42
对于 i 从 0 到 N - 1 循环
    st = rnd(st)
    追加(L, st)
结束

qsort(L, 0, N - 1)
输出 "RESULT=" + 转字符串(0 + L[0]) + "," + 转字符串(0 + L[N - 1])
