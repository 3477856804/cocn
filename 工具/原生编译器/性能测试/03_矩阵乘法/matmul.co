# ============================================================
# 03_矩阵乘法/matmul.co —— coCN 原生版本（扁平一维列表，与 matmul.c 一致）
# 测试：嵌套循环 + 内存访问。
# 说明：原生编译器对「列表中的浮点拆箱」与「嵌套下标 A[i][j]」均有缺陷，
#       故用整数 + 扁平数组 A[i*N+k]，与 C 完全对齐。
# ============================================================

整数 N = 200
整数 M = N * N

列表 A = []
列表 B = []
对于 t 从 0 到 M - 1 循环
    整数 i = t / N
    整数 j = t - i * N
    追加(A, (i * 7 + j * 13) % 100)
    追加(B, (i * 11 + j * 5) % 100)
结束

列表 C = []
对于 t 从 0 到 M - 1 循环
    追加(C, 0)
结束

对于 i 从 0 到 N - 1 循环
    对于 j 从 0 到 N - 1 循环
        整数 s = 0
        对于 k 从 0 到 N - 1 循环
            s = s + A[i * N + k] * B[k * N + j]
        结束
        C[i * N + j] = s
    结束
结束

输出 "RESULT=" + 转字符串(0 + C[0]) + "," + 转字符串(0 + C[M - 1])
