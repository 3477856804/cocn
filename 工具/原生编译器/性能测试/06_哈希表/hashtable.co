# ============================================================
# 06_哈希表/hashtable.co —— coCN 原生版本（与 hashtable.c 对齐，N=20000）
# 测试：字典插入+查找（字符串键）。
# 注意：运行时字典固定 16 桶不扩容，故 N=20000（链表变长，可接受）。
# ============================================================

整数 N = 20000
字典 D = {}
对于 i 从 0 到 N - 1 循环
    D["key_" + 转字符串(i)] = i * 10
结束

整数 sum = 0
对于 i 从 0 到 N - 1 循环
    sum = sum + D["key_" + 转字符串(i)]
结束

输出 "RESULT=" + 转字符串(sum)
