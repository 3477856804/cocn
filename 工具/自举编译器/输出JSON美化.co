# ============================================================
# 输出JSON美化.co —— 缩进式 JSON 序列化（用于调试）
#
# 与 输出JSON.co 的区别：
#   - 紧凑版：{"类型":"程序","语句":[...]}
#   - 美化版：多行缩进，便于人工阅读
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 递归序列化任意值为缩进式 JSON 字符串
# 参数 v: 要序列化的值
#       缩进层数
函数 序列化JSON美化(v, 整数 层) -> 字符串
    # 空值哨兵 → null
    若 是空值节点(v)
        返回 "null"
    结束

    字符串 t = 类型(v)
    字符串 缩进 = ""
    对于 i 从 0 到 层 - 1 循环
        缩进 = 缩进 + "  "
    结束
    字符串 子缩进 = 缩进 + "  "

    # 字典 → 对象
    若 t == "字典"
        列表 ks = 键(v)
        整数 len = 长度(ks)
        若 len == 0
            返回 "{}"
        结束
        字符串 结果 = "{\n"
        对于 i 从 0 到 len - 1 循环
            字符串 k = ks[i]
            结果 = 结果 + 子缩进 + "\"" + 转义JSON字符串(k) + "\": " + 序列化JSON美化(v[k], 层 + 1)
            若 i < len - 1
                结果 = 结果 + ","
            结束
            结果 = 结果 + "\n"
        结束
        结果 = 结果 + 缩进 + "}"
        返回 结果
    结束

    # 列表 → 数组
    若 t == "列表"
        整数 len = 长度(v)
        若 len == 0
            返回 "[]"
        结束
        字符串 结果 = "[\n"
        对于 i 从 0 到 len - 1 循环
            结果 = 结果 + 子缩进 + 序列化JSON美化(v[i], 层 + 1)
            若 i < len - 1
                结果 = 结果 + ","
            结束
            结果 = 结果 + "\n"
        结束
        结果 = 结果 + 缩进 + "]"
        返回 结果
    结束

    # 字符串
    若 t == "字符串"
        返回 "\"" + 转义JSON字符串(v) + "\""
    结束

    # 整数
    若 t == "整数"
        返回 转字符串(v)
    结束

    # 浮点
    若 t == "浮点"
        返回 转字符串(v)
    结束

    返回 转字符串(v)
结束
