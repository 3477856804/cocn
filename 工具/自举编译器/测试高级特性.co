# ============================================================
# 测试高级特性.co —— 装饰器 / 运算符重载 / 属性 / 枚举 / 命名空间
#
# 运行方式：
#   cat 词法分析器.co 语法分析器.co 代码生成器.co 测试高级特性.co > /tmp/t.co \
#     && node bin/cocn.js /tmp/t.co
#
# 边界说明：不修改语法分析器，高级特性以纯 coCN 运行时模拟：
#   * 运算符重载 = 特殊方法 __加__/__乘__/__等于__/__转字符串__ + 运算重载() 分派
#   * 装饰器     = 高阶函数；组合装饰器() 叠加装饰器链；带参装饰器 = 返回装饰器的工厂
#   * 属性       = getter/setter 闭包（计算属性 / 只读属性 / 写入校验）
#   * 枚举       = 创建枚举()：名称↔值双向映射 + 遍历 + 比较
#   * 命名空间   = 嵌套字典 + 深取()/命名空间别名()/合并命名空间()（模拟导入）
#
# 语法约定（与 测试元编程.co 一致）：字典字面量单行；方法先定义后挂到实例；
# 回调先命名后传入；不在字典字面量/实参处内联函数。
# ============================================================

输出("==== 高级特性测试开始 ====")

# ============================================================
# 1. 运算符重载
# ============================================================
输出("-- 1. 运算符重载 --")

# 向量工厂：闭包持有实例，方法挂特殊方法名
函数 创建向量(整数 x, 整数 y)
    让 实例 = {"__类型__": "向量", "x": x, "y": y}

    函数 加方法(其他)
        返回 创建向量(实例["x"] + 其他["x"], 实例["y"] + 其他["y"])
    结束

    函数 减方法(其他)
        返回 创建向量(实例["x"] - 其他["x"], 实例["y"] - 其他["y"])
    结束

    函数 乘方法(标量)
        返回 创建向量(实例["x"] * 标量, 实例["y"] * 标量)
    结束

    函数 等于方法(其他)
        如果 实例["x"] == 其他["x"] 且 实例["y"] == 其他["y"] 则
            返回 1
        结束
        返回 0
    结束

    函数 转字符串方法()
        返回 "(" + 转字符串(实例["x"]) + "," + 转字符串(实例["y"]) + ")"
    结束

    实例["__加__"] = 加方法
    实例["__减__"] = 减方法
    实例["__乘__"] = 乘方法
    实例["__等于__"] = 等于方法
    实例["__转字符串__"] = 转字符串方法
    返回 实例
结束

让 v1 = 创建向量(1, 2)
让 v2 = 创建向量(3, 4)

# 加法：v1 + v2 分派到 __加__
让 v3 = 运算重载(v1, "+", v2)
输出("v1+v2 = " + 转可读(v3))
断言相等(v3["x"], 4, "向量加法 x 分量")
断言相等(v3["y"], 6, "向量加法 y 分量")

# 减法
让 v4 = 运算重载(v2, "-", v1)
输出("v2-v1 = " + 转可读(v4))
断言相等(v4["x"], 2, "向量减法 x 分量")

# 标量乘法
让 v5 = 运算重载(v1, "*", 3)
输出("v1*3 = " + 转可读(v5))
断言相等(v5["x"], 3, "标量乘法 x 分量")
断言相等(v5["y"], 6, "标量乘法 y 分量")

# 相等比较
断言相等(运算重载(v1, "==", v1), 1, "向量等于自身")
断言相等(运算重载(v1, "==", v2), 0, "不同向量不等")
# != 由 __等于__ 派生
断言相等(运算重载(v1, "!=", v2), 1, "向量 != 派生")
断言相等(运算重载(v3, "!=", v1), 1, "v3 != v1 派生")

# 默认运算（标量走默认路径）
断言相等(运算重载(2, "+", 3), 5, "标量默认加法")
断言相等(运算重载(10, "*", 2), 20, "标量默认乘法")

输出("测试1 运算符重载 通过")

# ============================================================
# 2. 装饰器
# ============================================================
输出("-- 2. 装饰器 --")

# 日志装饰器：接收函数，返回包装函数
函数 日志装饰器(f)
    返回 函数(x)
        输出("  [日志]调用前: " + 转字符串(x))
        让 结果 = f(x)
        输出("  [日志]调用后: " + 转字符串(结果))
        返回 结果
    结束
结束

函数 平方(x)
    返回 x * x
结束

让 记录平方 = 日志装饰器(平方)
输出("装饰后平方(4) = " + 转字符串(记录平方(4)))
断言相等(记录平方(4), 16, "日志装饰器包装")

# 计时装饰器（无内部状态，记录进入/退出）
函数 计时装饰器(f)
    返回 函数(x)
        输出("  [计时]进入函数")
        让 r = f(x)
        输出("  [计时]退出函数")
        返回 r
    结束
结束

让 计时平方 = 计时装饰器(平方)
输出("计时装饰器(3) = " + 转字符串(计时平方(3)))

# 带参数的装饰器：工厂返回装饰器（用字典上下文捕获标签，兼容 VM 闭包）
函数 前缀装饰器(字符串 标签)
    让 ctx = {"标签": 标签}
    返回 函数(f)
        返回 函数(x)
            输出("  [" + ctx["标签"] + "]开始")
            让 r = f(x)
            输出("  [" + ctx["标签"] + "]结束")
            返回 r
        结束
    结束
结束

让 安全前缀 = 前缀装饰器("安全")
让 安全平方 = 安全前缀(平方)
输出("带参装饰器: " + 转字符串(安全平方(5)))

# 装饰器链：组合装饰器([外层, 内层], 函数)
让 d外 = 前缀装饰器("外层")
让 d内 = 前缀装饰器("内层")
让 链平方 = 组合装饰器([d外, d内], 平方)
输出("装饰器链结果 = " + 转字符串(链平方(6)))
断言相等(链平方(6), 36, "装饰器链最终结果")

输出("测试2 装饰器 通过")

# ============================================================
# 3. 属性（getter / setter / 计算属性 / 只读 / 校验）
# ============================================================
输出("-- 3. 属性 --")

函数 创建人(名字, 整数 年龄)
    让 _名字 = 名字
    让 _年龄 = 年龄

    函数 获取名字()
        返回 _名字
    结束

    函数 设置名字(新名字)
        如果 新名字 == "" 则
            输出("  [校验]名字不能为空，忽略")
            返回
        结束
        _名字 = 新名字
    结束

    函数 获取大写名字()
        返回 "[" + _名字 + "]"
    结束

    函数 获取虚岁()
        返回 _年龄 + 1
    结束

    让 实例 = {}
    实例["获取名字"] = 获取名字
    实例["设置名字"] = 设置名字
    实例["获取大写名字"] = 获取大写名字
    实例["获取虚岁"] = 获取虚岁
    返回 实例
结束

让 人 = 创建人("小明", 20)
输出("名字: " + 人["获取名字"]())
断言相等(人["获取名字"](), "小明", "getter 读取名字")

人["设置名字"]("小红")
输出("改名后: " + 人["获取名字"]())
断言相等(人["获取名字"](), "小红", "setter 修改名字")

# 计算属性
输出("带括号名字: " + 人["获取大写名字"]())
断言相等(人["获取大写名字"](), "[小红]", "计算属性括号名字")

# 只读属性
输出("虚岁(只读): " + 转字符串(人["获取虚岁"]()))
断言相等(人["获取虚岁"](), 21, "只读属性虚岁")

# 写入校验：空名字被拒绝
人["设置名字"]("")
断言相等(人["获取名字"](), "小红", "校验拒绝空名字")

输出("测试3 属性 通过")

# ============================================================
# 4. 枚举
# ============================================================
输出("-- 4. 枚举 --")

让 颜色成员 = {"红": 0, "绿": 1, "蓝": 2}
让 颜色 = 创建枚举(颜色成员)

让 方向成员 = {"北": 0, "东": 1, "南": 2, "西": 3}
让 方向 = 创建枚举(方向成员)

# 常量访问
断言相等(颜色["红"], 0, "枚举常量 红=0")
断言相等(方向["北"], 0, "枚举常量 北=0")

# 值 -> 名称
输出("颜色[1] = " + 颜色["获取名称"](1))
断言相等(颜色["获取名称"](1), "绿", "值转名称 绿")

# 名称 -> 值
输出("方向['南'] = " + 转字符串(方向["获取值"]("南")))
断言相等(方向["获取值"]("南"), 2, "名称转值 南=2")

# 枚举比较
让 当前颜色 = 颜色["蓝"]
如果 当前颜色 == 颜色["蓝"] 则
    输出("当前是蓝色")
结束
断言相等(当前颜色, 颜色["蓝"], "枚举比较")

# 枚举遍历（命名回调）
函数 打印枚举项(名称, 值)
    输出("  " + 名称 + " = " + 转字符串(值))
结束
输出("遍历颜色:")
颜色["遍历"](打印枚举项)

输出("测试4 枚举 通过")

# ============================================================
# 5. 命名空间
# ============================================================
输出("-- 5. 命名空间 --")

# 嵌套命名空间（先建子字典，再组合）
函数 二倍fn(x)
    返回 x * 2
结束
函数 平方fn(x)
    返回 x * x
结束

让 常量ns = {"π": 3.14159, "e": 2.71828}
让 函数ns = {}
函数ns["二倍"] = 二倍fn
函数ns["平方"] = 平方fn
让 数学 = {"常量": 常量ns, "函数": 函数ns}

# 嵌套访问
输出("数学.常量.π = " + 转字符串(数学["常量"]["π"]))
输出("数学.函数.二倍(21) = " + 转字符串(数学["函数"]["二倍"](21)))
断言相等(数学["函数"]["二倍"](21), 42, "命名空间函数调用")

# 深取（路径列表）
让 pi = 深取(数学, ["常量", "π"])
输出("深取 π = " + 转字符串(pi))

# 命名空间别名
让 别名 = 命名空间别名(常量ns)
输出("别名.e = " + 转字符串(别名["e"]))

# 导入：把子命名空间提到当前作用域（局部变量）
让 常量子 = 常量ns
让 函数集 = 函数ns
输出("导入后 平方(9) = " + 转字符串(函数集["平方"](9)))
断言相等(函数集["平方"](9), 81, "导入后命名空间函数")

# 合并命名空间（多命名空间平铺）
让 几何 = {"面积单位": "平方米"}
让 合并 = 合并命名空间([常量ns, 几何])
输出("合并后 π = " + 转字符串(合并["π"]) + ", 单位=" + 合并["面积单位"])

输出("测试5 命名空间 通过")

# ============================================================
# 6. 组合使用：运算符重载 + 装饰器 + 属性
# ============================================================
输出("-- 6. 组合使用 --")

# 带日志的向量加法：装饰器包裹运算符重载
函数 组合加法(a, b)
    返回 运算重载(a, "+", b)
结束
函数 加日志装饰器(f)
    返回 函数(a, b)
        输出("  [组合]向量相加")
        返回 f(a, b)
    结束
结束

让 装饰加法 = 加日志装饰器(组合加法)
让 va = 创建向量(10, 10)
让 vb = 创建向量(5, 5)
让 vc = 装饰加法(va, vb)
输出("装饰后向量和 = " + 转可读(vc))
断言相等(vc["x"], 15, "组合：装饰器包裹运算符重载")

# 属性 + 枚举组合：玩家持有方向属性
函数 创建玩家(初始方向)
    让 _方向 = 初始方向
    函数 获取方向()
        返回 方向["获取名称"](_方向)
    结束
    让 p = {}
    p["获取方向"] = 获取方向
    返回 p
结束

让 玩家 = 创建玩家(方向["东"])
输出("玩家方向(属性+枚举) = " + 玩家["获取方向"]())

输出("测试6 组合 使用 通过")

# ============================================================
输出("==== 高级特性测试全部通过 ====")
