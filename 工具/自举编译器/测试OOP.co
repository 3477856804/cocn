# ============================================================
# 测试OOP.co —— 面向对象 / 继承 / 构造函数 / 异常 / 模式匹配 / 多态
#
# 边界说明：不修改语法分析器，故 OOP 用字典模拟（编译器已为其补齐运行时）：
#   * 类    = 工厂函数 + 方法函数；方法首参为实例（字典），方法体内用 自己 访问
#   * 实例  = 字典，存放属性；"标签" 字段标识所属类（供多态分发）
#   * 继承  = 子类构造先调用父类构造（super），再扩展自己的属性；方法可覆盖
#   * 异常  = 抛出/已抛出/取异常/清除异常（全局异常槽，模拟 try/catch/finally）
#   * 模式匹配 = 编译为 if-else if 链，支持多值情况与默认分支
# ============================================================

# ---------------- 动物类（基类） ----------------
函数 动物_构造(字典 实例, 字符串 名字, 整数 年龄)
    实例["标签"] = 1
    实例["名字"] = 名字
    实例["年龄"] = 年龄
结束

函数 动物_创建(字符串 名字, 整数 年龄) -> 字典
    字典 o = {}
    动物_构造(o, 名字, 年龄)
    返回 o
结束

函数 动物_说话(字典 实例)
    输出(自己["名字"] + "在说话，今年" + 转整数(自己["年龄"]) + "岁")
结束

# ---------------- 狗类（继承动物） ----------------
函数 狗_构造(字典 实例, 字符串 名字, 整数 年龄, 字符串 品种)
    动物_构造(实例, 名字, 年龄)
    实例["标签"] = 2
    实例["品种"] = 品种
结束

函数 狗_创建(字符串 名字, 整数 年龄, 字符串 品种) -> 字典
    字典 o = {}
    狗_构造(o, 名字, 年龄, 品种)
    返回 o
结束

函数 狗_说话(字典 实例)
    输出(自己["名字"] + "汪汪叫，是一只" + 自己["品种"])
结束

函数 狗_接飞盘(字典 实例)
    输出(自己["名字"] + "接住了飞盘")
结束

# ---------------- 多态分发 ----------------
函数 调度说话(字典 实例)
    如果 转整数(自己["标签"]) == 2
        狗_说话(实例)
    否则
        动物_说话(实例)
    结束
结束

# ---------------- 模式匹配（if-else if 链） ----------------
函数 描述数字(整数 n)
    如果 n == 1
        输出("一")
    否则 若 n == 2
        输出("二")
    否则 若 n == 3 或 n == 4
        输出("三四")
    否则
        输出("其他")
    结束
结束

# ---------------- 异常示例 ----------------
函数 安全除(整数 a, 整数 b) -> 整数
    如果 b == 0
        抛出 "除数为零"
    结束
    返回 a / b
结束

# ============================================================
# 主流程
# ============================================================
输出("== 1. 类与构造函数 ==")
字典 小花 = 动物_创建("小花", 3)
动物_说话(小花)

输出("== 2. 继承与方法覆盖 ==")
字典 旺财 = 狗_创建("旺财", 5, "柯基")
动物_说话(旺财)
狗_说话(旺财)
狗_接飞盘(旺财)

输出("== 3. 模式匹配 ==")
对于 数字 从 1 到 5 循环
    描述数字(数字)
结束

输出("== 4. 异常：正常路径 ==")
让 商1 = 安全除(10, 2)
如果 已抛出()
    输出("捕获到: " + 取异常())
    清除异常()
否则
    输出("商是: " + 商1)
结束

输出("== 5. 异常：抛出并捕获 ==")
让 商2 = 安全除(10, 0)
如果 已抛出()
    输出("捕获到: " + 取异常())
    清除异常()
否则
    输出("商是: " + 商2)
结束
输出("总是执行（模拟最终块）")

输出("== 6. 多态：动物列表 ==")
让 动物园 = [小花, 旺财]
对于 箱 在 动物园 循环
    调度说话(字典化(箱))
结束
