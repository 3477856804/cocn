# bubble.co —— 冒泡排序
# 对固定整数序列排序，输出排序前后
# 自举编译器无列表支持，用固定变量模拟

让 a = 64
让 b = 34
让 c = 25
让 d = 12
让 e = 22
让 f = 11

输出 "=== 冒泡排序 ==="
输出 "排序前:"
输出 a
输出 b
输出 c
输出 d
输出 e
输出 f

# 冒泡排序：6个元素，5轮比较交换
# 第1轮（最大沉底）
如果 a > b 则
    让 t = a
    a = b
    b = t
结束
如果 b > c 则
    让 t = b
    b = c
    c = t
结束
如果 c > d 则
    让 t = c
    c = d
    d = t
结束
如果 d > e 则
    让 t = d
    d = e
    e = t
结束
如果 e > f 则
    让 t = e
    e = f
    f = t
结束

# 第2轮
如果 a > b 则
    让 t = a
    a = b
    b = t
结束
如果 b > c 则
    让 t = b
    b = c
    c = t
结束
如果 c > d 则
    让 t = c
    c = d
    d = t
结束
如果 d > e 则
    让 t = d
    d = e
    e = t
结束

# 第3轮
如果 a > b 则
    让 t = a
    a = b
    b = t
结束
如果 b > c 则
    让 t = b
    b = c
    c = t
结束
如果 c > d 则
    让 t = c
    c = d
    d = t
结束

# 第4轮
如果 a > b 则
    让 t = a
    a = b
    b = t
结束
如果 b > c 则
    让 t = b
    b = c
    c = t
结束

# 第5轮
如果 a > b 则
    让 t = a
    a = b
    b = t
结束

输出 "排序后:"
输出 a
输出 b
输出 c
输出 d
输出 e
输出 f
