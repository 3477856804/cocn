# ============================================================
# 测试.co —— 自举工具链端到端测试
#
# 验证：格式化器、文档生成器、测试框架本身。
# 由 编译工具链.sh 拼接：编译器 + 测试框架 + 格式化器 + 文档生成器 + 本文件
# ============================================================

# ---- 准备临时样本 ----
写入文件("/tmp/e2e_messy.co", "函数 加(a,b)\n返回 a+b\n结束\n\n函数 平方(x)\n返回 x*x\n结束\n")
写入文件("/tmp/e2e_lib.co", "#! 示例库\n\n#! 两数之和。\n#! @example\n#! 加(2,3)\n函数 加(整数 a,整数 b)->整数\n    返回 a+b\n结束\n")

# ---- 套件 1：格式化器 ----
套件("格式化器", 函数()
    测试("生成格式化输出", 函数()
        设置环境变量("COCN_FMT_INPUT", "/tmp/e2e_messy.co")
        设置环境变量("COCN_FMT_OUTPUT", "/tmp/e2e_messy.fmt.co")
        格式化主()
        字符串 out = 读取文件("/tmp/e2e_messy.fmt.co")
        断言为真(查找(out, "函数 加(a, b)") >= 0)
    结束)
    测试("运算符两侧空格", 函数()
        字符串 out = 读取文件("/tmp/e2e_messy.fmt.co")
        断言为真(查找(out, "返回 a + b") >= 0)
    结束)
    测试("顶层函数间空行", 函数()
        字符串 out = 读取文件("/tmp/e2e_messy.fmt.co")
        断言为真(查找(out, "结束\n\n函数") >= 0)
    结束)
结束)

# ---- 套件 2：文档生成器 ----
套件("文档生成器", 函数()
    测试("生成 Markdown", 函数()
        设置环境变量("COCN_DOC_INPUT", "/tmp/e2e_lib.co")
        设置环境变量("COCN_DOC_OUTPUT", "/tmp/e2e_lib.md")
        文档主()
        字符串 md = 读取文件("/tmp/e2e_lib.md")
        断言为真(查找(md, "## 函数") >= 0)
    结束)
    测试("提取函数条目", 函数()
        字符串 md = 读取文件("/tmp/e2e_lib.md")
        断言为真(查找(md, "### `加`") >= 0)
    结束)
    测试("提取 @example", 函数()
        字符串 md = 读取文件("/tmp/e2e_lib.md")
        断言为真(查找(md, "**示例**") >= 0)
    结束)
结束)

# ---- 套件 3：测试框架自身 ----
套件("测试框架", 函数()
    测试("断言相等", 函数()
        断言相等(1 + 1, 2)
    结束)
    测试("断言不相等", 函数()
        断言不相等(1, 2)
    结束)
    测试("断言为真", 函数()
        断言为真(3 > 2)
    结束)
    测试("断言接近(浮点)", 函数()
        断言接近(0.1 + 0.2, 0.3, 0.001)
    结束)
    测试("断言抛出", 函数()
        断言抛出(函数() 抛出 "故意" 结束)
    结束)
结束)

输出 ">>> 运行端到端测试..."
运行()
输出 ">>> 端到端测试全部通过"
