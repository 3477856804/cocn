# ============================================================
# 测试框架.co —— coCN 自举测试框架（自举工具链）
#
# 提供：
#   - 测试(名, 函数体)            注册一个测试用例
#   - 套件(名, 函数体)            定义测试套件
#   - 断言相等/不相等/为真/为假/抛出/接近
#   - 之前/之后/每个之前/每个之后 钩子
#   - 运行()                     执行全部注册的测试并打印报告
#
# 过滤：环境变量 COCN_TEST_FILTER 非空时，只运行名字包含该子串的测试。
# 自检：环境变量 COCN_TEST_SELFTEST=1 时运行内置演示用例。
# ============================================================

# ---------------- 状态 ----------------
列表 已注册测试 = []
字符串 当前套件名 = ""
整数 通过数 = 0
整数 失败数 = 0
整数 跳过数 = 0
列表 失败详情 = []

# 钩子（默认为空函数）
函数 空操作()
结束
让 全局之前 = 空操作
让 全局之后 = 空操作
让 用例之前 = 空操作
让 用例之后 = 空操作

字符串 过滤名 = 环境变量("COCN_TEST_FILTER")

# ---------------- 注册 API ----------------
函数 测试(字符串 名, 体)
    追加(已注册测试, {"名": 名, "套件": 当前套件名, "体": 体})
结束

函数 套件(字符串 名, 体)
    当前套件名 = 名
    体()
    当前套件名 = ""
结束

函数 之前(体)
    全局之前 = 体
结束
函数 之后(体)
    全局之后 = 体
结束
函数 每个之前(体)
    用例之前 = 体
结束
函数 每个之后(体)
    用例之后 = 体
结束

# ---------------- 断言 ----------------
函数 断言相等(实际, 期望)
    如果 实际 != 期望 则
        抛出 "断言相等失败: 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际)
    结束
结束

函数 断言不相等(实际, 期望)
    如果 实际 == 期望 则
        抛出 "断言不相等失败: 两者都=" + 转字符串(实际)
    结束
结束

函数 断言为真(条件)
    如果 非 条件 则
        抛出 "断言为真失败: 条件为假"
    结束
结束

函数 断言为假(条件)
    如果 条件 则
        抛出 "断言为假失败: 条件为真"
    结束
结束

# 断言 体 会抛出异常
函数 断言抛出(体)
    整数 抛了 = 0
    尝试
        体()
    捕获 e
        抛了 = 1
    结束
    如果 抛了 == 0 则
        抛出 "断言抛出失败: 函数未抛出异常"
    结束
结束

# 浮点近似比较
函数 断言接近(实际, 期望, 误差)
    浮点 差 = 转浮点(实际) - 转浮点(期望)
    如果 差 < 0 则
        差 = -差
    结束
    如果 差 > 转浮点(误差) 则
        抛出 "断言接近失败: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望) + " 误差=" + 转字符串(误差)
    结束
结束

# ---------------- 运行器 ----------------
函数 运行()
    输出 "========================================"
    输出 " coCN 测试运行器"
    输出 "========================================"

    全局之前()

    对于 i 从 0 到 长度(已注册测试) - 1 循环
        让 项 = 已注册测试[i]
        字符串 全名 = 项["套件"] + "::" + 项["名"]

        # 过滤
        整数 跑 = 1
        如果 过滤名 != "" 则
            如果 查找(全名, 过滤名) < 0 则
                跑 = 0
            结束
        结束
        如果 跑 == 0 则
            跳过数 = 跳过数 + 1
            继续
        结束

        用例之前()
        整数 ok = 1
        字符串 错误信息 = ""
        尝试
            项["体"]()
        捕获 e
            ok = 0
            错误信息 = e["消息"]
        结束
        用例之后()

        如果 ok == 1 则
            通过数 = 通过数 + 1
           输出("  [PASS] " + 全名)
        否则
            失败数 = 失败数 + 1
            输出("  [FAIL] " + 全名 + "  ->  " + 错误信息)
            追加(失败详情, 全名 + ": " + 错误信息)
        结束
    结束

    全局之后()

    # 报告
    输出 "----------------------------------------"
    输出 " 通过: " + 转字符串(通过数)
    输出 " 失败: " + 转字符串(失败数)
    输出 " 跳过: " + 转字符串(跳过数)
    输出 " 总计: " + 转字符串(长度(已注册测试))
    如果 失败数 > 0 则
        输出 "----------------------------------------"
        输出 " 失败详情:"
        对于 d 从 0 到 长度(失败详情) - 1 循环
            输出("   - " + 失败详情[d])
        结束
    结束
    如果 失败数 == 0 则
        输出 " 全部通过!"
    结束
    输出 "========================================"

    如果 失败数 > 0 则
        抛出 "测试失败: " + 转字符串(失败数) + " 个用例未通过"
    结束
结束

# ---------------- 自检演示 ----------------
如果 环境变量("COCN_TEST_SELFTEST") == "1" 则
    之前(函数() 输出 ">>> 全局之前钩子" 结束)
    之后(函数() 输出 ">>> 全局之后钩子" 结束)

    套件("算术测试", 函数()
        测试("加法", 函数() 断言相等(1 + 1, 2) 结束)
        测试("乘法", 函数() 断言相等(6 * 7, 42) 结束)
        测试("不相等", 函数() 断言不相等(1, 2) 结束)
        测试("为真", 函数() 断言为真(3 > 2) 结束)
        测试("为假", 函数() 断言为假(1 > 2) 结束)
        测试("近似", 函数() 断言接近(0.1 + 0.2, 0.3, 0.0001) 结束)
        测试("抛出", 函数()
            断言抛出(函数() 抛出 "故意出错" 结束)
        结束)
    结束)

    套件("字符串测试", 函数()
        测试("拼接", 函数() 断言相等("你好" + "世界", "你好世界") 结束)
        测试("长度", 函数() 断言相等(长度("hello"), 5) 结束)
        # 故意失败的用例，用于演示失败报告
        测试("故意失败", 函数() 断言相等(2 + 2, 5) 结束)
    结束)

    运行()
结束
