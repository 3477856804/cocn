# ============================================================
# 格式化器.co —— coCN 代码格式化器（自举工具链）
#
# 复用自举编译器的词法分析器（词法分析）。
# 规则：缩进 4 空格、关键字/运算符/逗号空格规范化、顶层块间空行、
#       行尾去空白、超长折行、保留整行注释。
#
# 环境变量：
#   COCN_FMT_INPUT   输入 .co 文件路径
#   COCN_FMT_OUTPUT  输出文件路径
#   COCN_FMT_INDENT  缩进空格数（默认 4）
#   COCN_FMT_WIDTH   最大行宽（默认 80）
# 独立运行：直接设置 COCN_FMT_INPUT/OUTPUT 即可；被 主.co 调用时调用 格式化主()。
# ============================================================

# ---------------- 小工具（顶层函数） ----------------
函数 在列表中(字符串 v, 表) -> 整数
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] == v 则
            返回 1
        结束
    结束
    返回 0
结束

让 二元运算符 = ["+", "-", "*", "/", "%", "=", "==", "!=", "<", ">", "<=", ">=", "**", "//", "->", "<<", ">>", "+=", "-=", "*=", "/="]
让 紧贴后 = ["(", "[", "."]
让 紧贴前 = [")", "]", ",", ":", ";", "(", "."]
让 开块 = ["函数", "如果", "对于", "当", "尝试", "类", "匹配", "枚举", "结构体"]
让 词类 = ["标识符", "关键字", "整数", "浮点", "字符串"]

函数 需要空格(字符串 前值, 字符串 前类, 字符串 现值, 字符串 现类) -> 整数
    如果 在列表中(现值, 紧贴前) == 1 则
        返回 0
    结束
    如果 在列表中(前值, 紧贴后) == 1 则
        返回 0
    结束
    如果 前值 == "," 则
        返回 1
    结束
    整数 前词 = 在列表中(前类, 词类)
    整数 现词 = 在列表中(现类, 词类)
    如果 前词 == 1 且 现词 == 1 则
        返回 1
    结束
    如果 在列表中(前值, 二元运算符) == 1 则
        返回 1
    结束
    如果 在列表中(现值, 二元运算符) == 1 则
        返回 1
    结束
    返回 0
结束

函数 缩进串(整数 深度, 整数 宽) -> 字符串
    字符串 s = ""
    对于 i 从 0 到 深度 * 宽 - 1 循环
        s = s + " "
    结束
    返回 s
结束

函数 拼行(列表 行tokens) -> 字符串
    字符串 s = ""
    字符串 上值 = ""
    字符串 上类 = ""
    整数 m = 长度(行tokens)
    对于 j 从 0 到 m - 1 循环
        让 tk = 行tokens[j]
        字符串 v = tk["值"]
        字符串 ty = tk["类型"]
        如果 ty == "字符串" 则
            v = "\"" + v + "\""
        结束
        如果 j == 0 则
            s = v
        否则
            如果 需要空格(上值, 上类, v, ty) == 1 则
                s = s + " " + v
            否则
                s = s + v
            结束
        结束
        上值 = v
        上类 = ty
    结束
    返回 s
结束

# ---------------- 主逻辑 ----------------
函数 格式化主()
    字符串 输入路径 = 环境变量("COCN_FMT_INPUT")
    字符串 输出路径 = 环境变量("COCN_FMT_OUTPUT")

    整数 缩进宽 = 4
    如果 环境变量("COCN_FMT_INDENT") != "" 则
        缩进宽 = 转整数(环境变量("COCN_FMT_INDENT"))
    结束
    整数 行宽 = 80
    如果 环境变量("COCN_FMT_WIDTH") != "" 则
        行宽 = 转整数(环境变量("COCN_FMT_WIDTH"))
    结束

    如果 输入路径 == "" 则
        输出 "[格式化器] 错误: 缺少 COCN_FMT_INPUT"
        抛出 "缺少 COCN_FMT_INPUT"
    结束

    字符串 源 = 读取文件(输入路径)
    列表 行表 = 分割(源, "\n")
    整数 总行数 = 长度(行表)

    字典 注释表 = {}
    对于 k 从 0 到 总行数 - 1 循环
        字符串 修剪 = 去除空白(行表[k])
        如果 长度(修剪) > 0 且 修剪[0] == "#" 则
            注释表[转字符串(k + 1)] = 修剪
        结束
    结束

    让 tokens = 词法分析(源)

    列表 逻辑行表 = []
    列表 当前行 = []
    整数 当前行源 = 0
    整数 tn = 长度(tokens)
    对于 i 从 0 到 tn - 1 循环
        让 tok = tokens[i]
        如果 tok["类型"] == "文件结束" 则
            跳出
        结束
        如果 tok["类型"] == "换行" 则
            如果 长度(当前行) > 0 则
                追加(逻辑行表, {"tokens": 当前行, "源行": 当前行源})
            结束
            当前行 = []
            当前行源 = 0
            继续
        结束
        如果 长度(当前行) == 0 则
            当前行源 = tok["行"]
        结束
        追加(当前行, tok)
    结束
    如果 长度(当前行) > 0 则
        追加(逻辑行表, {"tokens": 当前行, "源行": 当前行源})
    结束

    字符串 结果 = ""
    整数 深度 = 0
    整数 上一行为空 = 1
    整数 上一输出源行 = 0

    对于 r 从 0 到 长度(逻辑行表) - 1 循环
        让 项 = 逻辑行表[r]
        列表 行tokens = 项["tokens"]
        整数 源行 = 项["源行"]

        对于 c 从 上一输出源行 + 1 到 源行 - 1 循环
            字符串 键名 = 转字符串(c)
            如果 包含(注释表, 键名) 则
                结果 = 结果 + 缩进串(深度, 缩进宽) + 注释表[键名] + "\n"
                上一行为空 = 0
            结束
        结束

        字符串 首值 = 行tokens[0]["值"]
        整数 开数 = 0
        整数 闭数 = 0
        对于 j 从 0 到 长度(行tokens) - 1 循环
            字符串 vv = 行tokens[j]["值"]
            字符串 tv = 行tokens[j]["类型"]
            如果 tv == "关键字" 且 在列表中(vv, 开块) == 1 则
                开数 = 开数 + 1
            结束
            如果 vv == "结束" 则
                闭数 = 闭数 + 1
            结束
        结束

        如果 (首值 == "函数" 或 首值 == "类") 且 深度 == 0 且 上一行为空 == 0 则
            结果 = 结果 + "\n"
            上一行为空 = 1
        结束

        整数 本行缩进 = 深度
        如果 首值 == "结束" 则
            本行缩进 = 深度 - 1
        否则 若 首值 == "否则" 则
            本行缩进 = 深度 - 1
        结束
        如果 本行缩进 < 0 则
            本行缩进 = 0
        结束

        字符串 内容 = 拼行(行tokens)

        如果 长度(内容) > 行宽 且 长度(内容) > 0 则
            整数 切位置 = -1
            对于 j 从 0 到 长度(行tokens) - 1 循环
                如果 行tokens[j]["类型"] == "运算符" 且 在列表中(行tokens[j]["值"], 二元运算符) == 1 则
                    切位置 = j
                结束
            结束
            如果 切位置 > 0 则
                列表 前段 = []
                列表 后段 = []
                对于 j 从 0 到 长度(行tokens) - 1 循环
                    如果 j < 切位置 则
                        追加(前段, 行tokens[j])
                    否则
                        追加(后段, 行tokens[j])
                    结束
                结束
                结果 = 结果 + 缩进串(本行缩进, 缩进宽) + 拼行(前段) + "\n"
                结果 = 结果 + 缩进串(本行缩进 + 1, 缩进宽) + 拼行(后段) + "\n"
                上一行为空 = 0
                上一输出源行 = 源行
                如果 首值 == "结束" 则
                    深度 = 深度 - 1
                否则
                    深度 = 深度 + 开数 - 闭数
                结束
                继续
            结束
        结束

        结果 = 结果 + 缩进串(本行缩进, 缩进宽) + 内容 + "\n"
        上一行为空 = 0
        上一输出源行 = 源行

        如果 首值 == "结束" 则
            深度 = 深度 - 1
        否则
            深度 = 深度 + 开数 - 闭数
        结束
        如果 深度 < 0 则
            深度 = 0
        结束
    结束

    如果 输出路径 == "" 则
        输出 结果
    否则
        写入文件(输出路径, 结果)
        输出 "[格式化器] 完成: " + 输入路径 + " -> " + 输出路径
    结束
结束

# 独立运行时（未被 主.co 调用）自动执行
如果 环境变量("COCN_TC_CMD") == "" 且 环境变量("COCN_FMT_INPUT") != "" 则
    格式化主()
结束
