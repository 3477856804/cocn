# ============================================================
# 文档生成器.co —— coCN API 文档生成器（自举工具链）
#
# 读取 .co 源文件，提取文档注释（#! 或 ## 开头的整行注释），生成 Markdown。
# 环境变量：COCN_DOC_INPUT / COCN_DOC_OUTPUT
# 独立运行：直接设置环境变量；被 主.co 调用时调用 文档主()。
# ============================================================

# ---------------- 小工具（顶层函数） ----------------
函数 开头是(字符串 s, 字符串 前缀) -> 整数
    如果 长度(前缀) > 长度(s) 则
        返回 0
    结束
    返回 截取(s, 0, 长度(前缀)) == 前缀
结束

函数 去注释头(字符串 修剪) -> 字符串
    如果 开头是(修剪, "#! ") == 1 则
        返回 截取(修剪, 3, 长度(修剪) - 3)
    结束
    如果 开头是(修剪, "## ") == 1 则
        返回 截取(修剪, 3, 长度(修剪) - 3)
    结束
    如果 开头是(修剪, "#!") == 1 则
        返回 截取(修剪, 2, 长度(修剪) - 2)
    结束
    如果 开头是(修剪, "##") == 1 则
        返回 截取(修剪, 2, 长度(修剪) - 2)
    结束
    如果 开头是(修剪, "# ") == 1 则
        返回 截取(修剪, 2, 长度(修剪) - 2)
    结束
    返回 修剪
结束

函数 是文档行(字符串 修剪) -> 整数
    如果 长度(修剪) == 0 则
        返回 0
    结束
    如果 开头是(修剪, "#!") == 1 则
        返回 1
    结束
    如果 开头是(修剪, "##") == 1 则
        返回 1
    结束
    返回 0
结束

# ---------------- 主逻辑 ----------------
函数 文档主()
    字符串 输入路径 = 环境变量("COCN_DOC_INPUT")
    字符串 输出路径 = 环境变量("COCN_DOC_OUTPUT")

    如果 输入路径 == "" 则
        输出 "[文档生成器] 错误: 缺少 COCN_DOC_INPUT"
        抛出 "缺少 COCN_DOC_INPUT"
    结束

    字符串 源 = 读取文件(输入路径)
    列表 行表 = 分割(源, "\n")
    整数 总行数 = 长度(行表)

    字符串 文件名 = 输入路径
    整数 斜杠位置 = -1
    对于 k 从 0 到 长度(输入路径) - 1 循环
        如果 输入路径[k] == "/" 则
            斜杠位置 = k
        结束
    结束
    如果 斜杠位置 >= 0 则
        文件名 = 截取(输入路径, 斜杠位置 + 1, 长度(输入路径) - 斜杠位置 - 1)
    结束

    列表 函数表 = []
    列表 类表 = []
    字符串 模块文档 = ""
    列表 待文档 = []
    整数 见到代码 = 0
    整数 模块阶段结束 = 0

    对于 k 从 0 到 总行数 - 1 循环
        字符串 修剪 = 去除空白(行表[k])

        如果 长度(修剪) == 0 则
            待文档 = []
            如果 见到代码 == 0 则
                模块阶段结束 = 1
            结束
            继续
        结束

        如果 是文档行(修剪) == 1 则
            如果 见到代码 == 0 且 模块阶段结束 == 0 则
                字符串 正文 = 去注释头(修剪)
                如果 长度(模块文档) == 0 则
                    模块文档 = 正文
                否则
                    模块文档 = 模块文档 + "\n" + 正文
                结束
            否则
                追加(待文档, 去注释头(修剪))
            结束
            继续
        结束

        见到代码 = 1

        如果 开头是(修剪, "函数 ") == 1 则
            整数 p1 = 查找(修剪, "(")
            整数 p2 = 查找(修剪, ")")
            字符串 名 = ""
            字符串 参数文 = ""
            字符串 返回文 = ""
            如果 p1 > 2 则
                名 = 去除空白(截取(修剪, 3, p1 - 3))
            结束
            如果 p1 >= 0 且 p2 > p1 则
                参数文 = 截取(修剪, p1 + 1, p2 - p1 - 1)
            结束
            整数 pa = 查找(修剪, "->")
            如果 pa > p2 则
                返回文 = 去除空白(截取(修剪, pa + 2, 长度(修剪) - pa - 2))
            结束

            字符串 文档 = ""
            字符串 示例 = ""
            对于 d 从 0 到 长度(待文档) - 1 循环
                字符串 dl = 待文档[d]
                如果 查找(dl, "@example") >= 0 则
                    对于 e 从 d + 1 到 长度(待文档) - 1 循环
                        如果 长度(示例) == 0 则
                            示例 = 待文档[e]
                        否则
                            示例 = 示例 + "\n" + 待文档[e]
                        结束
                    结束
                    跳出
                结束
                如果 长度(文档) == 0 则
                    文档 = dl
                否则
                    文档 = 文档 + "\n" + dl
                结束
            结束

            追加(函数表, {"名": 名, "签名": 修剪, "文档": 文档, "参数": 参数文, "返回": 返回文, "示例": 示例})
            待文档 = []
            继续
        结束

        如果 开头是(修剪, "类 ") == 1 则
            字符串 类名 = 去除空白(截取(修剪, 2, 长度(修剪) - 2))
            字符串 文档 = 连接(待文档, "\n")
            追加(类表, {"名": 类名, "文档": 文档})
            待文档 = []
            继续
        结束

        待文档 = []
    结束

    字符串 md = "# 模块 " + 文件名 + "\n\n"
    如果 长度(模块文档) > 0 则
        md = md + "> " + 替换(模块文档, "\n", "\n> ") + "\n\n"
    结束

    列表 名表 = []
    对于 i 从 0 到 长度(函数表) - 1 循环
        追加(名表, 函数表[i]["名"])
    结束
    列表 排序列表 = 排序(名表)

    md = md + "## 目录\n\n"
    md = md + "- 函数（" + 转字符串(长度(函数表)) + " 个）\n"
    对于 i 从 0 到 长度(排序列表) - 1 循环
        md = md + "  - `" + 排序列表[i] + "`\n"
    结束
    md = md + "- 类（" + 转字符串(长度(类表)) + " 个）\n\n"

    md = md + "## 函数\n\n"
    对于 i 从 0 到 长度(函数表) - 1 循环
        让 f = 函数表[i]
        md = md + "### `" + f["名"] + "`\n\n"
        md = md + "```co\n" + f["签名"] + "\n```\n\n"
        如果 长度(f["文档"]) > 0 则
            md = md + f["文档"] + "\n\n"
        结束
        md = md + "- **参数**: "
        如果 长度(f["参数"]) > 0 则
            md = md + f["参数"]
        否则
            md = md + "（无）"
        结束
        md = md + "\n"
        md = md + "- **返回**: "
        如果 长度(f["返回"]) > 0 则
            md = md + f["返回"]
        否则
            md = md + "（未标注）"
        结束
        md = md + "\n"
        如果 长度(f["示例"]) > 0 则
            md = md + "\n**示例**:\n\n```co\n" + f["示例"] + "\n```\n"
        结束
        md = md + "\n"
    结束

    如果 长度(类表) > 0 则
        md = md + "## 类\n\n"
        对于 i 从 0 到 长度(类表) - 1 循环
            让 c = 类表[i]
            md = md + "### `类 " + c["名"] + "`\n\n"
            如果 长度(c["文档"]) > 0 则
                md = md + c["文档"] + "\n\n"
            结束
        结束
    结束

    md = md + "---\n"
    md = md + "*本文件由 coCN 自举文档生成器自动生成。*\n"

    如果 输出路径 == "" 则
        输出 md
    否则
        写入文件(输出路径, md)
        输出 "[文档生成器] 完成: " + 输入路径 + " -> " + 输出路径
        输出 "[文档生成器] 函数数=" + 转字符串(长度(函数表)) + " 类数=" + 转字符串(长度(类表))
    结束
结束

# 独立运行时自动执行
如果 环境变量("COCN_TC_CMD") == "" 且 环境变量("COCN_DOC_INPUT") != "" 则
    文档主()
结束
