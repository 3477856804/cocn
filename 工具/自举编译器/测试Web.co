# ============================================================
# 测试Web.co —— JSON / HTTP 服务器 / 路由 / 中间件 / 模板引擎
#
# 运行方式（由 代码生成器.co 提供 Web 运行时）：
#   cat 词法分析器.co 语法分析器.co 代码生成器.co 测试Web.co > /tmp/t.co \
#     && node bin/cocn.js /tmp/t.co
#
# 说明：宿主字典上限 256 键，根环境已被编译器占用近满，
# 故全部测试逻辑收敛进一个函数内（局部变量不污染根环境）。
# Web API 采用与 OOP 一致的显式接收者风格（顶层函数）。
# ============================================================

函数 处理首页3(请求, 响应)
    响应["状态码"] = 200
    响应设置头(响应, "Content-Type", "text/plain")
    响应结束(响应, "Hello, " + 请求["路径"])
结束

函数 路由首页4(请求, 响应, 链上下文)
    响应结束(响应, "首页")
结束
函数 路由用户4(请求, 响应, 链上下文)
    响应结束(响应, "用户:" + 请求["参数"]["id"])
结束
函数 路由创建用户4(请求, 响应, 链上下文)
    响应["状态码"] = 201
    响应结束(响应, "创建用户")
结束
函数 路由文件4(请求, 响应, 链上下文)
    响应结束(响应, "文件区")
结束

函数 最终OK5(请求, 响应, 链上下文)
    响应结束(响应, "OK")
结束

函数 管理后台5(请求, 响应, 链上下文)
    响应结束(响应, "管理后台")
结束

# 中间件（顶层函数，避免嵌套闭包缺陷）
让 日志记录 = []
函数 日志中间件(请求, 响应, 链上下文)
    追加(日志记录, 请求["方法"] + " " + 请求["路径"])
    中间件执行下一个(链上下文)
结束
函数 认证中间件(请求, 响应, 链上下文)
    让 token = 请求["头部"]["Authorization"]
    如果 token == "secret" 则
        中间件执行下一个(链上下文)
    否则
        响应["状态码"] = 401
        响应结束(响应, "未授权")
    结束
结束

函数 测试主()
    输出("==== Web 开发特性测试开始 ====")

    # ---------------- 1. JSON 解析 ----------------
    输出("---- 1. JSON 解析 ----")

    让 j1 = JSON解析("{\"名字\":\"小明\",\"年龄\":25,\"爱好\":[\"读书\",\"游泳\"]}")
    断言相等(j1["名字"], "小明", "JSON解析 对象.名字")
    断言相等(j1["年龄"], 25, "JSON解析 对象.年龄")
    断言相等(j1["爱好"][0], "读书", "JSON解析 数组[0]")
    断言相等(j1["爱好"][1], "游泳", "JSON解析 数组[1]")
    输出("测试1.1 对象解析 通过")

    让 j2 = JSON解析("{\"地址\":{\"城市\":\"北京\",\"街道\":\"长安街\"},\"编号\":100}")
    断言相等(j2["地址"]["城市"], "北京", "JSON解析 嵌套.城市")
    断言相等(j2["编号"], 100, "JSON解析 嵌套.编号")
    输出("测试1.2 嵌套对象 通过")

    让 j3 = JSON解析("{\"文本\":\"a\\tb\\nc\\\"d\\\\e\"}")
    断言相等(j3["文本"], "a\tb\nc\"d\\e", "JSON解析 转义字符")
    输出("测试1.3 转义字符串 通过")

    让 j4 = JSON解析("{\"活跃\":true,\"删除\":false,\"备注\":null}")
    断言相等(j4["活跃"]["__b__"], 1, "JSON解析 true 标记")
    断言相等(j4["删除"]["__b__"], 0, "JSON解析 false 标记")
    断言相等(j4["备注"], 空, "JSON解析 null")
    输出("测试1.4 布尔与空 通过")

    让 j5 = JSON解析("[1,2,3]")
    断言相等(长度(j5), 3, "JSON解析 顶层数组长度")
    断言相等(j5[2], 3, "JSON解析 顶层数组[2]")
    输出("测试1.5 顶层数组 通过")

    让 j6 = JSON解析("{\"价格\":12.5}")
    断言相等(j6["价格"], 12.5, "JSON解析 浮点")
    输出("测试1.6 浮点 通过")

    断言相等(JSON验证("{\"a\":1}"), 1, "JSON验证 合法")
    断言相等(JSON验证("{bad}"), 0, "JSON验证 非法")
    输出("测试1.7 JSON验证 通过")

    # ---------------- 2. JSON 序列化 ----------------
    输出("---- 2. JSON 序列化 ----")

    让 d1 = {"名字": "小红", "年龄": 30}
    让 s1 = JSON序列化(d1, 0)
    输出("  紧凑: " + s1)
    断言相等(包含(s1, "\"名字\":\"小红\""), 1, "JSON序列化 对象含名字")
    断言相等(包含(s1, "\"年龄\":30"), 1, "JSON序列化 对象含年龄")
    输出("测试2.1 对象序列化 通过")

    让 d2 = {"名字": "小红", "地址": {"城市": "北京"}, "标签": ["a", "b"]}
    让 s2 = JSON序列化(d2, 0)
    输出("  嵌套: " + s2)
    断言相等(包含(s2, "\"城市\":\"北京\""), 1, "JSON序列化 嵌套城市")
    输出("测试2.2 嵌套序列化 通过")

    让 d3 = {"名字": "小红", "年龄": 30}
    让 s3 = JSON序列化(d3, 真)
    输出("  美化:\n" + s3)
    断言相等(包含(s3, "\n"), 1, "JSON序列化 美化含换行")
    输出("测试2.3 美化序列化 通过")

    让 d4 = {"名字": "小明", "年龄": 25, "爱好": ["读书", "游泳"], "地址": {"城市": "西安"}}
    让 s4 = JSON序列化(d4, 0)
    让 j4b = JSON解析(s4)
    断言相等(j4b["名字"], "小明", "回环 名字")
    断言相等(j4b["地址"]["城市"], "西安", "回环 城市")
    断言相等(j4b["爱好"][1], "游泳", "回环 爱好[1]")
    输出("测试2.4 序列化回环 通过")

    # ---------------- 3. HTTP 服务器 ----------------
    输出("---- 3. HTTP 服务器 ----")

    让 srv3 = 创建HTTP服务器()
    服务器监听(srv3, 8080, 处理首页3)

    让 req3 = {"方法": "GET", "路径": "/", "头部": {}, "体": ""}
    让 res3 = 服务器处理请求(srv3, req3)
    断言相等(res3["状态码"], 200, "HTTP 状态码200")
    断言相等(res3["body"], "Hello, /", "HTTP 响应体")
    断言相等(res3["头部"]["Content-Type"], "text/plain", "HTTP 响应头")
    输出("测试3.1 基本请求处理 通过")

    # ---------------- 4. 路由 ----------------
    输出("---- 4. 路由 ----")

    让 路由4 = 创建路由器()
    路由注册(路由4, "GET", "/", 路由首页4)
    路由注册(路由4, "GET", "/用户/:id", 路由用户4)
    路由注册(路由4, "POST", "/用户", 路由创建用户4)
    路由注册(路由4, "GET", "/文件/*", 路由文件4)

    让 srv4 = 创建HTTP服务器()
    服务器路由(srv4, 路由4)

    让 r4a = 服务器处理请求(srv4, {"方法": "GET", "路径": "/", "头部": {}, "体": ""})
    断言相等(r4a["body"], "首页", "路由 首页")
    输出("测试4.1 首页路由 通过")

    让 r4b = 服务器处理请求(srv4, {"方法": "GET", "路径": "/用户/123", "头部": {}, "体": ""})
    断言相等(r4b["body"], "用户:123", "路由 路径参数")
    输出("测试4.2 路径参数 通过")

    让 r4c = 服务器处理请求(srv4, {"方法": "POST", "路径": "/用户", "头部": {}, "体": ""})
    断言相等(r4c["状态码"], 201, "路由 POST 状态码")
    断言相等(r4c["body"], "创建用户", "路由 POST 体")
    输出("测试4.3 POST 路由 通过")

    让 r4d = 服务器处理请求(srv4, {"方法": "GET", "路径": "/文件/a/b/c", "头部": {}, "体": ""})
    断言相等(r4d["body"], "文件区", "路由 通配符")
    输出("测试4.4 通配符 通过")

    让 r4e = 服务器处理请求(srv4, {"方法": "GET", "路径": "/不存在", "头部": {}, "体": ""})
    断言相等(r4e["状态码"], 404, "路由 404状态码")
    输出("测试4.5 404 通过")

    # ---------------- 5. 中间件 ----------------
    输出("---- 5. 中间件 ----")

    让 srv5 = 创建HTTP服务器()
    服务器使用(srv5, 日志中间件)
    服务器监听(srv5, 0, 最终OK5)

    让 r5 = 服务器处理请求(srv5, {"方法": "GET", "路径": "/中间件", "头部": {}, "体": ""})
    断言相等(r5["body"], "OK", "中间件 最终响应")
    断言相等(长度(日志记录), 1, "中间件 日志记录数")
    断言相等(日志记录[0], "GET /中间件", "中间件 日志内容")
    输出("测试5.1 全局中间件 通过")

    让 srv5b = 创建HTTP服务器()
    服务器使用(srv5b, "/管理", 认证中间件)
    服务器监听(srv5b, 0, 管理后台5)

    让 r5b = 服务器处理请求(srv5b, {"方法": "GET", "路径": "/管理/面板", "头部": {}, "体": ""})
    断言相等(r5b["状态码"], 401, "认证中间件 未授权401")
    输出("测试5.2 认证失败 通过")

    让 r5c = 服务器处理请求(srv5b, {"方法": "GET", "路径": "/管理/面板", "头部": {"Authorization": "secret"}, "体": ""})
    断言相等(r5c["body"], "管理后台", "认证中间件 通过")
    输出("测试5.3 认证成功 通过")

    # ---------------- 6. 模板引擎 ----------------
    输出("---- 6. 模板引擎 ----")

    让 t6 = "<h1>{{标题}}</h1><ul>{{对于 项 在 列表}}<li>{{项.名字}}-{{项.价格}}</li>{{结束}}</ul>"
    让 out6 = 渲染模板字符串(t6, {"标题": "商品列表", "列表": [{"名字": "苹果", "价格": 5}, {"名字": "香蕉", "价格": 3}]}, "")
    输出("  渲染: " + out6)
    断言相等(包含(out6, "<h1>商品列表</h1>"), 1, "模板 变量替换")
    断言相等(包含(out6, "<li>苹果-5</li>"), 1, "模板 循环苹果")
    断言相等(包含(out6, "<li>香蕉-3</li>"), 1, "模板 循环香蕉")
    输出("测试6.1 变量+循环 通过")

    让 t6b = "{{如果 登录}}<p>欢迎你</p>{{否则}}<p>请登录</p>{{结束}}"
    让 out6a = 渲染模板字符串(t6b, {"登录": {"__b__": 1}}, "")
    断言相等(包含(out6a, "欢迎你"), 1, "模板 条件真")
    让 out6b = 渲染模板字符串(t6b, {"登录": {"__b__": 0}}, "")
    断言相等(包含(out6b, "请登录"), 1, "模板 条件假")
    输出("测试6.2 条件渲染 通过")

    让 out6c = 渲染模板字符串("<div>{{内容}}</div>", {"内容": "<script>alert(1)</script>"}, "")
    断言相等(包含(out6c, "&lt;script&gt;"), 1, "模板 HTML转义")
    输出("测试6.3 HTML转义 通过")

    输出("==== Web 开发特性测试全部通过 ====")
结束

测试主()
