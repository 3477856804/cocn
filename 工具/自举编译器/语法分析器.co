# ============================================================
# 语法分析器.co —— 自举版递归下降语法分析器
#
# 输入：词法分析器产出的 token 列表
# 输出：AST 程序节点 {"类型": "程序", "语句": [...]}
#
# 移植自 原生编译器/语法分析器.js。
# 注意：无空值类型，用 {"类型": "空值"} 作 null 哨兵节点。
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# ---------------- 模块状态 ----------------
让 g_tokens = []
让 g_pos = 0

# ---------------- 词法游标辅助 ----------------

函数 词类() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 "文件结束"
    结束
    返回 g_tokens[g_pos]["类型"]
结束

函数 词值() -> 字符串
    若 g_pos >= 长度(g_tokens)
        返回 ""
    结束
    返回 g_tokens[g_pos]["值"]
结束

函数 行号() -> 整数
    若 g_pos >= 长度(g_tokens)
        返回 0
    结束
    返回 g_tokens[g_pos]["行"]
结束

函数 前进()
    g_pos = g_pos + 1
结束

函数 报错(字符串 消息)
    输出错误("语法错误 (第" + 转字符串(行号()) + "行): " + 消息 + "，得到 '" + 词值() + "'")
    断言(假, "语法分析失败")
结束

函数 期望关键字(字符串 期望)
    若 词类() != "关键字" 或 词值() != 期望
        报错("期望关键字 '" + 期望 + "'")
    结束
    前进()
结束

函数 期望运算符(字符串 期望)
    若 词类() != "运算符" 或 词值() != 期望
        报错("期望运算符 '" + 期望 + "'")
    结束
    前进()
结束

# ---------------- 谓词辅助 ----------------

函数 是类型关键字(字符串 k) -> 布尔
    返回 k == "整数" 或 k == "浮点" 或 k == "布尔" 或 k == "字符串" 或 k == "列表" 或 k == "字典"
结束

函数 是结束() -> 布尔
    返回 词类() == "关键字" 且 词值() == "结束"
结束

函数 是分支头() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "否则"
结束

函数 是语句结束() -> 布尔
    若 词类() == "换行"
        返回 真
    结束
    若 词类() == "文件结束"
        返回 真
    结束
    若 是结束()
        返回 真
    结束
    返回 是分支头()
结束

函数 是则() -> 布尔
    若 词类() != "关键字"
        返回 假
    结束
    返回 词值() == "则" 或 词值() == "那么"
结束

函数 跳过换行()
    当 词类() == "换行" 循环
        前进()
    结束
结束

# ---------------- 表达式层 ----------------

函数 解析主要() -> 字典
    若 词类() == "整数"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "整数"}
        前进()
        返回 n
    结束
    若 词类() == "浮点"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "浮点"}
        前进()
        返回 n
    结束
    若 词类() == "字符串"
        字典 n = {"类型": "字面量", "值": 词值(), "字面类型": "字符串"}
        前进()
        返回 n
    结束
    若 词类() == "关键字" 且 词值() == "真"
        前进()
        返回 {"类型": "字面量", "值": "1", "字面类型": "布尔"}
    结束
    若 词类() == "关键字" 且 词值() == "假"
        前进()
        返回 {"类型": "字面量", "值": "0", "字面类型": "布尔"}
    结束
    若 词类() == "关键字" 且 词值() == "空"
        前进()
        返回 {"类型": "字面量", "值": "", "字面类型": "空"}
    结束
    若 词类() == "标识符"
        字典 n = {"类型": "标识符", "名字": 词值()}
        前进()
        返回 n
    结束
    若 词类() == "运算符" 且 词值() == "("
        前进()
        若 词类() == "运算符" 且 词值() == ")"
            前进()
            返回 {"类型": "元组字面量", "元素": []}
        结束
        字典 首个 = 解析或()
        若 词类() == "运算符" 且 词值() == ","
            列表 元素 = [首个]
            当 词类() == "运算符" 且 词值() == "," 循环
                前进()
                若 词类() == "运算符" 且 词值() == ")"
                    跳出
                结束
                追加(元素, 解析或())
            结束
            期望运算符(")")
            返回 {"类型": "元组字面量", "元素": 元素}
        结束
        期望运算符(")")
        返回 首个
    结束
    若 词类() == "运算符" 且 词值() == "["
        返回 解析列表字面量()
    结束
    若 词类() == "运算符" 且 词值() == "{"
        返回 解析字典字面量()
    结束
    若 词类() == "关键字" 且 词值() == "self" 或 词类() == "关键字" 且 词值() == "自己"
        字典 n = {"类型": "标识符", "名字": 词值()}
        前进()
        返回 n
    结束
    若 是结束()
        报错("多余的 '结束'")
    结束
    报错("意外的表达式记号")
    返回 {"类型": "空值"}
结束

函数 解析列表字面量() -> 字典
    前进()
    若 词类() == "运算符" 且 词值() == "]"
        前进()
        返回 {"类型": "列表字面量", "元素": [], "是否推导式": 0}
    结束
    字典 首个 = 解析或()
    列表 元素 = [首个]
    当 词类() == "运算符" 且 词值() == "," 循环
        前进()
        若 词类() == "运算符" 且 词值() == "]"
            跳出
        结束
        追加(元素, 解析或())
    结束
    期望运算符("]")
    返回 {"类型": "列表字面量", "元素": 元素, "是否推导式": 0}
结束

函数 解析字典字面量() -> 字典
    前进()
    若 词类() == "运算符" 且 词值() == "}"
        前进()
        返回 {"类型": "字典字面量", "键": [], "值": []}
    结束
    列表 键表 = []
    列表 值表 = []
    当 词类() != "文件结束" 循环
        若 词类() == "运算符" 且 词值() == "}"
            跳出
        结束
        字典 k = {"类型": "空值"}
        若 词类() == "字符串"
            k = {"类型": "字面量", "值": 词值(), "字面类型": "字符串"}
            前进()
        否则
            k = 解析或()
            若 k["类型"] == "标识符"
                k = {"类型": "字面量", "值": k["名字"], "字面类型": "字符串"}
            结束
        结束
        期望运算符(":")
        字典 v = 解析或()
        追加(键表, k)
        追加(值表, v)
        若 词类() == "运算符" 且 词值() == ","
            前进()
        结束
    结束
    期望运算符("}")
    返回 {"类型": "字典字面量", "键": 键表, "值": 值表}
结束

函数 解析后缀() -> 字典
    字典 n = 解析主要()
    整数 变 = 1
    当 变 == 1 循环
        整数 消费 = 0
        若 词类() == "运算符" 且 词值() == "("
            消费 = 1
            前进()
            列表 参数 = []
            若 非 (词类() == "运算符" 且 词值() == ")")
                当 真 循环
                    追加(参数, 解析或())
                    若 词类() == "运算符" 且 词值() == ","
                        前进()
                        继续
                    结束
                    跳出
                结束
            结束
            期望运算符(")")
            n = {"类型": "函数调用", "被调者": n, "参数": 参数}
        结束
        若 词类() == "运算符" 且 词值() == "["
            消费 = 1
            前进()
            字典 idx = 解析或()
            期望运算符("]")
            n = {"类型": "下标", "容器": n, "索引": idx}
        结束
        若 词类() == "运算符" 且 词值() == "."
            消费 = 1
            前进()
            若 词类() != "标识符"
                报错("成员访问 '.' 后需要标识符")
            结束
            字符串 成员名 = 词值()
            前进()
            n = {"类型": "下标", "容器": n, "索引": {"类型": "字面量", "值": 成员名, "字面类型": "字符串"}}
        结束
        若 消费 == 0
            变 = 0
        结束
    结束
    返回 n
结束

函数 解析一元() -> 字典
    若 词类() == "运算符" 且 (词值() == "-" 或 词值() == "+")
        字符串 op = 词值()
        前进()
        返回 {"类型": "一元", "运算符": op, "操作数": 解析一元()}
    结束
    若 词类() == "关键字" 且 词值() == "非"
        前进()
        返回 {"类型": "一元", "运算符": "非", "操作数": 解析一元()}
    结束
    若 词类() == "运算符" 且 词值() == "~"
        前进()
        返回 {"类型": "一元", "运算符": "~", "操作数": 解析一元()}
    结束
    返回 解析后缀()
结束

函数 解析幂() -> 字典
    字典 左 = 解析一元()
    若 词类() == "运算符" 且 词值() == "**"
        前进()
        字典 右 = 解析幂()
        返回 {"类型": "二元", "运算符": "**", "左": 左, "右": 右}
    结束
    返回 左
结束

函数 解析乘除模() -> 字典
    字典 左 = 解析幂()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "*" 或 词值() == "/" 或 词值() == "%" 或 词值() == "//")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析幂()}
    结束
    返回 左
结束

函数 解析加减() -> 字典
    字典 左 = 解析乘除模()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "+" 或 词值() == "-")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析乘除模()}
    结束
    返回 左
结束

函数 解析移位() -> 字典
    字典 左 = 解析加减()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<<" 或 词值() == ">>")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析加减()}
    结束
    返回 左
结束

函数 解析关系() -> 字典
    字典 左 = 解析移位()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "<" 或 词值() == ">" 或 词值() == "<=" 或 词值() == ">=")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析移位()}
    结束
    返回 左
结束

函数 解析相等() -> 字典
    字典 左 = 解析关系()
    当 真 循环
        字符串 op = ""
        若 词类() == "运算符" 且 (词值() == "==" 或 词值() == "!=")
            op = 词值()
        结束
        若 op == ""
            跳出
        结束
        前进()
        左 = {"类型": "二元", "运算符": op, "左": 左, "右": 解析关系()}
    结束
    返回 左
结束

函数 解析位与() -> 字典
    字典 左 = 解析相等()
    当 词类() == "运算符" 且 词值() == "&" 循环
        前进()
        左 = {"类型": "二元", "运算符": "&", "左": 左, "右": 解析相等()}
    结束
    返回 左
结束

函数 解析位异或() -> 字典
    字典 左 = 解析位与()
    当 词类() == "运算符" 且 词值() == "^" 循环
        前进()
        左 = {"类型": "二元", "运算符": "^", "左": 左, "右": 解析位与()}
    结束
    返回 左
结束

函数 解析位或() -> 字典
    字典 左 = 解析位异或()
    当 词类() == "运算符" 且 词值() == "|" 循环
        前进()
        左 = {"类型": "二元", "运算符": "|", "左": 左, "右": 解析位异或()}
    结束
    返回 左
结束

函数 解析且() -> 字典
    字典 左 = 解析位或()
    当 词类() == "关键字" 且 词值() == "且" 循环
        前进()
        左 = {"类型": "二元", "运算符": "且", "左": 左, "右": 解析位或()}
    结束
    返回 左
结束

函数 解析或() -> 字典
    字典 左 = 解析且()
    当 词类() == "关键字" 且 词值() == "或" 循环
        前进()
        左 = {"类型": "二元", "运算符": "或", "左": 左, "右": 解析且()}
    结束
    返回 左
结束

# ---------------- 语句层 ----------------

函数 解析变量声明() -> 字典
    字符串 标注 = ""
    字符串 头 = 词值()
    若 头 == "让" 或 头 == "变量" 或 头 == "常量"
        前进()
    结束
    若 词类() == "关键字" 且 是类型关键字(词值())
        标注 = 词值()
        前进()
    结束
    若 词类() != "标识符"
        报错("变量声明需要标识符")
    结束
    字符串 名 = 词值()
    前进()
    字典 初始化 = {"类型": "空值"}
    若 词类() == "运算符" 且 词值() == "="
        前进()
        初始化 = 解析或()
    结束
    返回 {"类型": "变量声明", "名字": 名, "类型标注": 标注, "初始化": 初始化}
结束

函数 解析返回() -> 字典
    前进()
    字典 v = {"类型": "空值"}
    若 词类() != "换行" 且 词类() != "文件结束" 且 非 是结束() 且 非 是分支头()
        v = 解析或()
    结束
    返回 {"类型": "返回", "值": v}
结束

函数 解析如果() -> 字典
    前进()
    字典 条件 = 解析或()
    若 是则()
        前进()
    结束
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    列表 则体 = 解析分支体()
    列表 否则链 = []
    当 是分支头() 循环
        字典 分支条件 = {"类型": "空值"}
        字符串 v = 词值()
        若 v == "否则"
            前进()
            若 词类() == "关键字" 且 (词值() == "如果" 或 词值() == "若")
                前进()
                分支条件 = 解析或()
            结束
        结束
        若 是则()
            前进()
        结束
        列表 分支体 = 解析分支体()
        追加(否则链, {"条件": 分支条件, "体": 分支体})
    结束
    若 块形式 == 1
        若 非 是结束()
            报错("如果 块缺少 结束")
        结束
        前进()
    否则
        若 是结束()
            前进()
        结束
    结束
    返回 {"类型": "如果", "条件": 条件, "则体": 则体, "否则链": 否则链}
结束

函数 解析分支体() -> 列表
    列表 体 = []
    整数 块形式 = 0
    若 词类() == "换行"
        块形式 = 1
    结束
    若 块形式 == 1
        当 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            若 是分支头() 或 是结束()
                跳出
            结束
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
    否则
        跳过换行()
        若 非 (是分支头() 或 是结束())
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
    结束
    返回 体
结束

函数 解析当() -> 字典
    前进()
    字典 条件 = 解析或()
    期望关键字("循环")
    列表 体 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体, st)
        结束
    结束
    若 非 是结束()
        报错("当 循环缺少 结束")
    结束
    前进()
    返回 {"类型": "当", "条件": 条件, "体": 体}
结束

函数 解析对于() -> 字典
    前进()
    若 词类() == "关键字" 且 是类型关键字(词值())
        前进()
    结束
    若 词类() != "标识符"
        报错("对于 循环需要标识符")
    结束
    字符串 变量名 = 词值()
    前进()
    # for-each 形式
    若 词类() == "关键字" 且 (词值() == "在" 或 词值() == "于")
        前进()
        字典 容器节点 = 解析或()
        期望关键字("循环")
        列表 体 = []
        当 非 是结束() 且 词类() != "文件结束" 循环
            若 词类() == "换行"
                前进()
                继续
            结束
            字典 st = 解析语句()
            若 st["类型"] != "空值"
                追加(体, st)
            结束
        结束
        若 非 是结束()
            报错("对于 循环缺少 结束")
        结束
        前进()
        返回 {"类型": "对于", "变量": 变量名, "遍历源": 容器节点, "体": 体, "是否遍历": 1}
    结束
    # 范围形式
    期望关键字("从")
    字典 起点 = 解析或()
    期望关键字("到")
    字典 终点 = 解析或()
    字典 步长值 = {"类型": "空值"}
    若 词类() == "关键字" 且 词值() == "步长"
        前进()
        步长值 = 解析或()
    结束
    期望关键字("循环")
    列表 体 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体, st)
        结束
    结束
    若 非 是结束()
        报错("对于 循环缺少 结束")
    结束
    前进()
    返回 {"类型": "对于", "变量": 变量名, "起点": 起点, "终点": 终点, "步长": 步长值, "体": 体}
结束

函数 解析函数定义() -> 字典
    前进()
    若 词类() != "标识符"
        报错("函数定义需要名字")
    结束
    字符串 名 = 词值()
    前进()
    期望运算符("(")
    列表 参数 = []
    列表 参数类型 = []
    列表 参数默认 = []
    若 非 (词类() == "运算符" 且 词值() == ")")
        当 非 (词类() == "运算符" 且 词值() == ")") 且 词类() != "文件结束" 循环
            字符串 pt = ""
            若 词类() == "关键字" 且 是类型关键字(词值())
                pt = 词值()
                前进()
            结束
            若 词类() == "运算符" 且 词值() == "..."
                pt = "可变"
                前进()
            结束
            若 词类() != "标识符"
                报错("函数参数需要标识符")
            结束
            追加(参数, 词值())
            追加(参数类型, pt)
            前进()
            字典 默认值 = {"类型": "空值"}
            若 词类() == "运算符" 且 词值() == "="
                前进()
                默认值 = 解析或()
            结束
            追加(参数默认, 默认值)
            若 词类() == "运算符" 且 词值() == ","
                前进()
            结束
        结束
    结束
    期望运算符(")")
    字符串 返回类型 = ""
    若 词类() == "运算符" 且 词值() == "->"
        前进()
        若 词类() == "关键字" 且 是类型关键字(词值())
            返回类型 = 词值()
            前进()
        否则
            报错("函数返回类型标注无效")
        结束
    结束
    列表 体语句 = []
    当 非 是结束() 且 词类() != "文件结束" 循环
        若 词类() == "换行"
            前进()
            继续
        结束
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(体语句, st)
        结束
    结束
    若 非 是结束()
        报错("函数定义缺少 结束")
    结束
    前进()
    字典 体 = {"类型": "程序", "语句": 体语句}
    返回 {"类型": "函数定义", "名字": 名, "参数": 参数, "参数类型": 参数类型, "参数默认": 参数默认, "返回类型": 返回类型, "体": 体}
结束

函数 解析语句() -> 字典
    若 词类() == "换行"
        前进()
        返回 {"类型": "空值"}
    结束
    若 词类() == "文件结束"
        返回 {"类型": "空值"}
    结束
    若 词类() == "关键字"
        字符串 k = 词值()
        若 k == "让" 或 k == "变量" 或 k == "常量"
            返回 解析变量声明()
        结束
        若 是类型关键字(k)
            返回 解析变量声明()
        结束
        若 k == "函数"
            返回 解析函数定义()
        结束
        若 k == "返回"
            返回 解析返回()
        结束
        若 k == "如果" 或 k == "若"
            返回 解析如果()
        结束
        若 k == "当"
            返回 解析当()
        结束
        若 k == "对于"
            返回 解析对于()
        结束
        若 k == "跳出"
            前进()
            返回 {"类型": "跳出"}
        结束
        若 k == "继续"
            前进()
            返回 {"类型": "继续"}
        结束
        若 k == "抛出"
            前进()
            返回 {"类型": "抛出", "值": 解析或()}
        结束
        若 k == "导入"
            前进()
            若 词类() != "字符串"
                报错("导入需要字符串路径")
            结束
            字符串 p = 词值()
            前进()
            返回 {"类型": "导入", "路径": p}
        结束
    结束
    字典 左 = 解析或()
    若 词类() == "运算符" 且 词值() == "="
        前进()
        字典 v = 解析或()
        返回 {"类型": "赋值", "目标": 左, "值": v}
    结束
    # 命令式无括号调用：输出 x
    若 左["类型"] == "标识符" 且 非 是语句结束()
        列表 参数 = [解析或()]
        当 词类() == "运算符" 且 词值() == "," 循环
            前进()
            追加(参数, 解析或())
        结束
        返回 {"类型": "函数调用", "被调者": 左, "参数": 参数}
    结束
    返回 左
结束

# ---------------- 顶层入口 ----------------

函数 语法分析(列表 tokens) -> 字典
    g_tokens = tokens
    g_pos = 0
    列表 语句表 = []
    当 词类() != "文件结束" 循环
        字典 st = 解析语句()
        若 st["类型"] != "空值"
            追加(语句表, st)
        结束
    结束
    返回 {"类型": "程序", "语句": 语句表}
结束

函数 解析源(字符串 源) -> 字典
    列表 tokens = 词法分析(源)
    返回 语法分析(tokens)
结束
