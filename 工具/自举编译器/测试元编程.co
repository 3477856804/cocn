# ============================================================
# 测试元编程.co —— 泛型 / 特性 / 反射 / 宏 / 编译期计算 测试
#
# 运行方式：
#   cat 词法分析器.co 语法分析器.co 代码生成器.co 测试元编程.co > /tmp/t.co \
#     && node bin/cocn.js /tmp/t.co
# ============================================================

输出("==== 元编程特性测试开始 ====")

# ---------------- 测试1：泛型列表 ----------------
输出("-- 测试1：泛型列表 --")

让 整数列表 = 创建泛型列表("整数")
整数列表["追加"](10)
整数列表["追加"](20)
整数列表["追加"](30)

断言相等(整数列表["长度"](), 3, "泛型列表长度(应为3)")
断言相等(整数列表["获取"](0), 10, "泛型列表获取[0](应为10)")
断言相等(整数列表["获取"](2), 30, "泛型列表获取[2](应为30)")

让 字符串列表 = 创建泛型列表("字符串")
字符串列表["追加"]("你好")
字符串列表["追加"]("世界")
断言相等(字符串列表["长度"](), 2, "字符串列表长度(应为2)")

输出("测试1 泛型列表 通过")

# ---------------- 测试2：泛型字典 ----------------
输出("-- 测试2：泛型字典 --")

让 泛数 = 创建泛型字典("字符串", "整数")
泛数["设置"]("甲", 100)
泛数["设置"]("乙", 200)
断言相等(泛数["长度"](), 2, "泛型字典长度(应为2)")
断言相等(泛数["获取"]("甲"), 100, "泛型字典获取甲(应为100)")
断言相等(泛数["包含"]("乙"), 1, "泛型字典包含乙(应为1)")

输出("测试2 泛型字典 通过")

# ---------------- 测试3：特性（可打印） ----------------
输出("-- 测试3：特性 --")

# 定义可打印特性
让 可打印 = 定义特性(["转字符串"], {})

# 创建一个对象工厂
函数 创建书(字符串 标题, 整数 页数)
    让 实例 = {"__类型__": "书", "标题": 标题, "页数": 页数}

    函数 转字符串方法()
        返回 实例["标题"] + "(" + 转字符串(实例["页数"]) + "页)"
    结束

    实例["转字符串"] = 转字符串方法
    返回 实例
结束

让 我的书 = 创建书("元编程入门", 200)

# 检查是否实现了特性
断言相等(检查特性(我的书, 可打印), 1, "书实现了可打印特性")

# 使用特性方法
让 描述 = 我的书["转字符串"]()
输出("书的描述: " + 描述)

输出("测试3 特性 通过")

# ---------------- 测试4：反射 ----------------
输出("-- 测试4：反射 --")

# 创建测试对象
函数 创建动物(字符串 名字, 整数 年龄)
    让 实例 = {"__类型__": "动物", "名字": 名字, "年龄": 年龄}

    函数 说话方法()
        返回 实例["名字"] + "叫了一声"
    结束

    函数 进食方法()
        返回 实例["名字"] + "在吃饭"
    结束

    实例["说话"] = 说话方法
    实例["进食"] = 进食方法
    返回 实例
结束

让 小狗 = 创建动物("旺财", 3)

# 4.1 获取类型名
让 t名 = 类型名(小狗)
断言相等(t名, "动物", "类型名应为动物")
输出("类型名: " + t名)

# 4.2 获取属性列表
让 属性 = 属性列表(小狗)
输出("属性数量: " + 转字符串(长度(属性)))

# 4.3 获取方法列表
让 方法 = 方法列表(小狗)
输出("方法数量: " + 转字符串(长度(方法)))

# 4.4 动态调用方法
让 叫声 = 调用方法(小狗, "说话", [])
输出("动态调用说话: " + 叫声)
断言相等(叫声, "旺财叫了一声", "动态调用说话方法")

# 4.5 动态设置属性
设置属性(小狗, "年龄", 4)
断言相等(小狗["年龄"], 4, "动态设置年龄为4")

# 4.6 动态获取属性
让 获取的名字 = 获取属性(小狗, "名字")
断言相等(获取的名字, "旺财", "动态获取名字")

输出("测试4 反射 通过")

# ---------------- 测试5：宏 ----------------
输出("-- 测试5：宏 --")

# 定义一个简单的宏展开函数
# 宏_除非(条件, 语句) → 如果 非 条件 则 语句
函数 除非宏展开(列表 参数)
    字典 操作数 = 参数[0]
    字典 一元节点 = {"类型": "一元", "运算符": "非", "操作数": 操作数}
    列表 体 = [参数[1]]
    返回 {"类型": "如果", "条件": 一元节点, "则体": 体, "否则链": []}
结束

# 注册宏
注册宏("除非", 除非宏展开)

# 验证宏已注册
断言相等(包含(g宏表, "除非"), 1, "宏'除非'已注册")

# 测试宏展开函数本身（直接调用展开函数）
字典 测试节点 = {"类型": "字面量", "字面类型": "整数", "值": "0"}
列表 测试参数 = [测试节点, {"类型": "表达式语句"}]
字典 结果节点 = 除非宏展开(测试参数)
断言相等(结果节点["类型"], "如果", "宏展开结果应为如果语句")
断言相等(结果节点["条件"]["运算符"], "非", "宏展开条件应为非运算")

输出("测试5 宏 通过")

# ---------------- 测试6：编译期计算 ----------------
输出("-- 测试6：编译期计算 --")

# 编译期常量
注册编译期常量("最大数", 100)
断言相等(包含(g编译期常量, "最大数"), 1, "编译期常量已注册")

# 编译期阶乘
让 阶乘结果 = 编译期阶乘(10)
断言相等(阶乘结果, 3628800, "编译期阶乘(10)=3628800")
输出("编译期阶乘(10) = " + 转字符串(阶乘结果))

# 编译期断言
编译期断言(1 + 1 == 2, "1+1应等于2")
编译期断言(10 > 5, "10应大于5")
输出("编译期断言全部通过")

# 编译期求值函数
注册编译期常量("基数", 10)
字典 左节点 = {"类型": "标识符", "名字": "基数"}
字典 右节点 = {"类型": "字面量", "字面类型": "整数", "值": "5"}
字典 节点 = {"类型": "二元", "运算符": "*", "左": 左节点, "右": 右节点}
让 求值结果 = 编译期求值(节点)
输出("编译期求值基数*5 = " + 转字符串(求值结果))

输出("测试6 编译期计算 通过")

# ---------------- 测试7：特性组合 ----------------
输出("-- 测试7：特性组合 --")

# 定义两个特性
让 可命名 = 定义特性(["获取名字"], {})
让 可计数 = 定义特性(["计数"], {})

# 创建一个同时实现两个特性的对象
函数 创建计数器(字符串 名, 整数 初始值)
    让 实例 = {"__类型__": "计数器", "名称": 名, "_值": 初始值}

    函数 获取名字方法()
        返回 实例["名称"]
    结束

    函数 计数方法()
        返回 实例["_值"]
    结束

    函数 递增方法()
        实例["_值"] = 实例["_值"] + 1
    结束

    实例["获取名字"] = 获取名字方法
    实例["计数"] = 计数方法
    实例["递增"] = 递增方法
    返回 实例
结束

让 计数器 = 创建计数器("访问计数器", 0)

# 单独检查每个特性
断言相等(检查特性(计数器, 可命名), 1, "实现了可命名特性")
断言相等(检查特性(计数器, 可计数), 1, "实现了可计数特性")

# 组合检查
让 特性列表 = [可命名, 可计数]
断言相等(检查多特性(计数器, 特性列表), 1, "同时实现两个特性")

# 使用两个特性的方法
输出("名称: " + 计数器["获取名字"]())
计数器["递增"]()
计数器["递增"]()
断言相等(计数器["计数"](), 2, "递增两次后计数为2")

输出("测试7 特性组合 通过")

# ---------------- 总结 ----------------
输出("==== 元编程特性测试全部通过 ====")
