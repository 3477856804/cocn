# ============================================================
# 词法分析器.co —— 自举版词法分析器（用 coCN 自身实现）
#
# 输入：coCN 源码字符串
# 输出：token 列表，每个 token 是字典：
#   {"类型": ..., "值": ..., "行": 整数, "列": 整数}
# 类型："整数" | "浮点" | "字符串" | "标识符" | "关键字" | "运算符" | "换行" | "文件结束"
#
# 移植自 原生编译器/词法分析器.js，语义保持一致。
# 注意：本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# ---------------- 字符分类辅助 ----------------

# 是否为十进制数字字符
函数 是数字(字符串 c) -> 布尔
    返回 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9"
结束

# 是否为运算符字符
函数 是操作符字符(字符串 c) -> 布尔
    返回 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" 或 c == "!" 或 c == "<" 或 c == ">" 或 c == "(" 或 c == ")" 或 c == "[" 或 c == "]" 或 c == "{" 或 c == "}" 或 c == "," 或 c == ":" 或 c == "&" 或 c == "|" 或 c == "^" 或 c == "~" 或 c == "."
结束

# 是否为关键字
函数 是关键字(字符串 词) -> 布尔
    返回 词 == "让" 或 词 == "整数" 或 词 == "浮点" 或 词 == "布尔" 或 词 == "字符串" 或 词 == "列表" 或 词 == "字典" 或 词 == "变量" 或 词 == "常量" 或 词 == "函数" 或 词 == "返回" 或 词 == "如果" 或 词 == "否则" 或 词 == "若" 或 词 == "当" 或 词 == "对于" 或 词 == "从" 或 词 == "到" 或 词 == "步长" 或 词 == "循环" 或 词 == "结束" 或 词 == "跳出" 或 词 == "继续" 或 词 == "真" 或 词 == "假" 或 词 == "且" 或 词 == "或" 或 词 == "非" 或 词 == "导入" 或 词 == "匹配" 或 词 == "是" 或 词 == "默认" 或 词 == "于" 或 词 == "在" 或 词 == "那么" 或 词 == "尝试" 或 词 == "捕获" 或 词 == "最终" 或 词 == "抛出" 或 词 == "并发" 或 词 == "等待" 或 词 == "则" 或 词 == "枚举" 或 词 == "结构体" 或 词 == "作为" 或 词 == "类" 或 词 == "继承" 或 词 == "继承自" 或 词 == "self" 或 词 == "自己" 或 词 == "super" 或 词 == "空"
结束

# ---------------- 词法分析主函数 ----------------

函数 词法分析(字符串 源) -> 列表
    列表 表 = []
    整数 n = 长度(源)
    整数 p = 0
    整数 行 = 1
    整数 列 = 1
    整数 行有内容 = 0

    当 p < n 循环
        字符串 c = 源[p]

        # 空白
        若 c == " " 或 c == "\t" 或 c == "\r"
            p = p + 1
            列 = 列 + 1
            继续
        结束

        # 注释
        若 c == "#"
            当 p < n 且 源[p] != "\n" 循环
                p = p + 1
                列 = 列 + 1
            结束
            继续
        结束

        # 换行
        若 c == "\n"
            若 行有内容 == 1
                追加(表, {"类型": "换行", "值": "\n", "行": 行, "列": 列})
            结束
            行 = 行 + 1
            列 = 1
            p = p + 1
            行有内容 = 0
            继续
        结束

        # 数字
        若 是数字(c)
            整数 记行 = 行
            整数 记列 = 列
            整数 起 = p
            布尔 浮 = 假
            当 p < n 且 是数字(源[p]) 循环
                p = p + 1
                列 = 列 + 1
            结束
            若 p < n 且 源[p] == "." 且 p + 1 < n 且 是数字(源[p + 1])
                浮 = 真
                p = p + 1
                列 = 列 + 1
                当 p < n 且 是数字(源[p]) 循环
                    p = p + 1
                    列 = 列 + 1
                结束
            结束
            若 p < n 且 (源[p] == "e" 或 源[p] == "E")
                整数 q = p + 1
                若 q < n 且 (源[q] == "+" 或 源[q] == "-")
                    q = q + 1
                结束
                若 q < n 且 是数字(源[q])
                    浮 = 真
                    p = p + 1
                    列 = 列 + 1
                    若 p < n 且 (源[p] == "+" 或 源[p] == "-")
                        p = p + 1
                        列 = 列 + 1
                    结束
                    当 p < n 且 是数字(源[p]) 循环
                        p = p + 1
                        列 = 列 + 1
                    结束
                结束
            结束
            字符串 词 = 截取(源, 起, p - 起)
            若 浮
                追加(表, {"类型": "浮点", "值": 词, "行": 记行, "列": 记列})
            否则
                追加(表, {"类型": "整数", "值": 词, "行": 记行, "列": 记列})
            结束
            行有内容 = 1
            继续
        结束

        # 字符串
        若 c == "\""
            整数 记行 = 行
            整数 记列 = 列
            p = p + 1
            列 = 列 + 1
            字符串 内容 = ""
            当 p < n 且 源[p] != "\"" 循环
                若 源[p] == "\\" 且 p + 1 < n
                    字符串 e = 源[p + 1]
                    若 e == "n"
                        内容 = 内容 + "\n"
                    否则 若 e == "t"
                        内容 = 内容 + "\t"
                    否则 若 e == "\""
                        内容 = 内容 + "\""
                    否则 若 e == "\\"
                        内容 = 内容 + "\\"
                    否则
                        内容 = 内容 + e
                    结束
                    p = p + 2
                    列 = 列 + 2
                否则
                    内容 = 内容 + 源[p]
                    p = p + 1
                    列 = 列 + 1
                结束
            结束
            若 p < n 且 源[p] == "\""
                p = p + 1
                列 = 列 + 1
            结束
            追加(表, {"类型": "字符串", "值": 内容, "行": 记行, "列": 记列})
            行有内容 = 1
            继续
        结束

        # 运算符
        若 是操作符字符(c)
            整数 记行 = 行
            整数 记列 = 列
            字符串 词 = c
            若 c == "-" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = "->"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "*" 且 p + 1 < n 且 源[p + 1] == "*"
                词 = "**"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "/" 且 p + 1 < n 且 源[p + 1] == "/"
                词 = "//"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "=" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "=="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "!" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "!="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "<" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "<="
                p = p + 2
                列 = 列 + 2
            否则 若 c == "<" 且 p + 1 < n 且 源[p + 1] == "<"
                词 = "<<"
                p = p + 2
                列 = 列 + 2
            否则 若 c == ">" 且 p + 1 < n 且 源[p + 1] == "="
                词 = ">="
                p = p + 2
                列 = 列 + 2
            否则 若 c == ">" 且 p + 1 < n 且 源[p + 1] == ">"
                词 = ">>"
                p = p + 2
                列 = 列 + 2
            否则 若 c == "." 且 p + 2 < n 且 源[p + 1] == "." 且 源[p + 2] == "."
                词 = "..."
                p = p + 3
                列 = 列 + 3
            否则
                p = p + 1
                列 = 列 + 1
            结束
            追加(表, {"类型": "运算符", "值": 词, "行": 记行, "列": 记列})
            行有内容 = 1
            继续
        结束

        # 标识符 / 关键字
        整数 记行 = 行
        整数 记列 = 列
        整数 起 = p
        当 p < n 循环
            字符串 cc = 源[p]
            若 cc == " " 或 cc == "\t" 或 cc == "\r" 或 cc == "\n"
                跳出
            结束
            若 cc == "#" 或 cc == "\""
                跳出
            结束
            若 是操作符字符(cc)
                跳出
            结束
            p = p + 1
            列 = 列 + 1
        结束
        字符串 词 = 截取(源, 起, p - 起)
        若 词 == "按位与"
            追加(表, {"类型": "运算符", "值": "&", "行": 记行, "列": 记列})
        否则 若 词 == "按位或"
            追加(表, {"类型": "运算符", "值": "|", "行": 记行, "列": 记列})
        否则 若 词 == "按位异或"
            追加(表, {"类型": "运算符", "值": "^", "行": 记行, "列": 记列})
        否则 若 词 == "按位取反"
            追加(表, {"类型": "运算符", "值": "~", "行": 记行, "列": 记列})
        否则 若 词 == "左移"
            追加(表, {"类型": "运算符", "值": "<<", "行": 记行, "列": 记列})
        否则 若 词 == "右移"
            追加(表, {"类型": "运算符", "值": ">>", "行": 记行, "列": 记列})
        否则 若 是关键字(词)
            追加(表, {"类型": "关键字", "值": 词, "行": 记行, "列": 记列})
        否则
            追加(表, {"类型": "标识符", "值": 词, "行": 记行, "列": 记列})
        结束
        行有内容 = 1
    结束

    追加(表, {"类型": "文件结束", "值": "", "行": 行, "列": 列})
    返回 表
结束
