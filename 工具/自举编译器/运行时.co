# ---------- 补充字符串工具 ----------

# 字符串反转(串) -> 字符串
# 返回反转后的新字符串
函数 字符串反转(字符串 串) -> 字符串
    字符串 结果 = ""
    对于 i 从 长度(串) - 1 到 0 步长 -1 循环
        结果 = 结果 + 截取(串, i, 1)
    结束
    返回 结果
结束

# 字符串重复(串, 次数) -> 字符串
# 将字符串重复指定次数
函数 字符串重复(字符串 串, 整数 次数) -> 字符串
    字符串 结果 = ""
    对于 i 从 0 到 次数 - 1 循环
        结果 = 结果 + 串
    结束
    返回 结果
结束

# 字符串统计单词数(串) -> 整数
# 统计字符串中的单词数（按空格分隔）
函数 字符串统计单词数(字符串 串) -> 整数
    字符串 修剪后 = 去除空白(串)
    如果 长度(修剪后) == 0 则
        返回 0
    结束
    列表 单词列表 = 分割(修剪后, " ")
    返回 长度(单词列表)
结束

# 字符串包含前缀(串, 前缀) -> 布尔
# 判断字符串是否以前缀开头
函数 字符串包含前缀(字符串 串, 字符串 前缀) -> 布尔
    整数 前缀长 = 长度(前缀)
    如果 前缀长 > 长度(串) 则
        返回 假
    结束
    返回 截取(串, 0, 前缀长) == 前缀
结束

# 字符串包含后缀(串, 后缀) -> 布尔
# 判断字符串是否以后缀结尾
函数 字符串包含后缀(字符串 串, 字符串 后缀) -> 布尔
    整数 后缀长 = 长度(后缀)
    整数 串长 = 长度(串)
    如果 后缀长 > 串长 则
        返回 假
    结束
    返回 截取(串, 串长 - 后缀长, 后缀长) == 后缀
结束

# 字符串替换所有(串, 旧, 新) -> 字符串
# 替换字符串中所有匹配的子串
函数 字符串替换所有(字符串 串, 字符串 旧, 字符串 新) -> 字符串
    返回 替换(串, 旧, 新)
结束


# ---------- 补充列表工具 ----------

# 列表最大值(列表)
# 返回列表中的最大值
函数 列表最大值(列表 列表值)
    如果 长度(列表值) == 0 则
        返回 0
    结束
    让 最大值 = 列表值[0]
    对于 i 从 1 到 长度(列表值) - 1 循环
        如果 列表值[i] > 最大值 则
            最大值 = 列表值[i]
        结束
    结束
    返回 最大值
结束

# 列表最小值(列表)
# 返回列表中的最小值
函数 列表最小值(列表 列表值)
    如果 长度(列表值) == 0 则
        返回 0
    结束
    让 最小值 = 列表值[0]
    对于 i 从 1 到 长度(列表值) - 1 循环
        如果 列表值[i] < 最小值 则
            最小值 = 列表值[i]
        结束
    结束
    返回 最小值
结束

# 列表范围(列表)
# 返回列表中最大值与最小值的差
函数 列表范围(列表 列表值)
    返回 列表最大值(列表值) - 列表最小值(列表值)
结束

# 列表计数(列表, 元素) -> 整数
# 统计元素在列表中出现的次数
函数 列表计数(列表 列表值, 元素) -> 整数
    整数 次数 = 0
    对于 i 从 0 到 长度(列表值) - 1 循环
        如果 列表值[i] == 元素 则
            次数 = 次数 + 1
        结束
    结束
    返回 次数
结束

# 列表索引(列表, 元素) -> 整数
# 查找元素在列表中首次出现的索引
函数 列表索引(列表 列表值, 元素) -> 整数
    对于 i 从 0 到 长度(列表值) - 1 循环
        如果 列表值[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 列表逆序切片(列表, 起始, 结束) -> 列表
# 逆序切片列表
函数 列表逆序切片(列表 列表值, 整数 起始, 整数 末) -> 列表
    列表 结果 = []
    对于 i 从 末 - 1 到 起始 步长 -1 循环
        追加(结果, 列表值[i])
    结束
    返回 结果
结束


# ---------- 补充字典工具 ----------

# 字典键列表排序(字典) -> 列表
# 返回排序后的键列表
函数 字典键列表排序(字典 字典值) -> 列表
    列表 键列表 = 键(字典值)
    返回 排序(键列表)
结束

# 字典值列表排序(字典) -> 列表
# 返回排序后的值列表
函数 字典值列表排序(字典 字典值) -> 列表
    列表 值列表 = 值列表(字典值)
    返回 排序(值列表)
结束

# 字典取最大值键(字典)
# 返回值最大的键
函数 字典取最大值键(字典 字典值)
    列表 键s = 键(字典值)
    如果 长度(键s) == 0 则
        返回 ""
    结束
    字符串 最大键 = 键s[0]
    对于 i 从 1 到 长度(键s) - 1 循环
        如果 字典值[键s[i]] > 字典值[最大键] 则
            最大键 = 键s[i]
        结束
    结束
    返回 最大键
结束

# 字典取最小值键(字典)
# 返回值最小的键
函数 字典取最小值键(字典 字典值)
    列表 键s = 键(字典值)
    如果 长度(键s) == 0 则
        返回 ""
    结束
    字符串 最小键 = 键s[0]
    对于 i 从 1 到 长度(键s) - 1 循环
        如果 字典值[键s[i]] < 字典值[最小键] 则
            最小键 = 键s[i]
        结束
    结束
    返回 最小键
结束


# ---------- 补充数学工具 ----------

# 计算百分比(部分, 总数) -> 浮点
# 计算部分占总数的百分比
函数 计算百分比(浮点 部分, 浮点 总数) -> 浮点
    如果 总数 == 0 则
        返回 0.0
    结束
    返回 部分 / 总数 * 100.0
结束

# 计算利息(本金, 利率, 年数) -> 浮点
# 简单利息计算
函数 计算利息(浮点 本金, 浮点 年利率, 整数 年数) -> 浮点
    返回 本金 * 年利率 * 年数
结束

# 计算复利(本金, 年利率, 整数 年数) -> 浮点
# 复利计算（每年复利一次）
函数 计算复利(浮点 本金, 浮点 年利率, 整数 年数) -> 浮点
    浮点 倍率 = 1.0 + 年利率
    返回 本金 * 计算幂(倍率, 年数)
结束

# 计算摄氏度转华氏度(摄氏度) -> 浮点
# 温度转换
函数 摄氏转华氏(浮点 摄氏度) -> 浮点
    返回 摄氏度 * 9.0 / 5.0 + 32.0
结束

# 计算华氏度转摄氏度(华氏度) -> 浮点
# 温度转换
函数 华氏转摄氏(浮点 华氏度) -> 浮点
    返回 (华氏度 - 32.0) * 5.0 / 9.0
结束

# 计算英里转公里(英里) -> 浮点
# 长度转换
函数 英里转公里(浮点 英里) -> 浮点
    返回 英里 * 1.60934
结束

# 计算公里转英里(公里) -> 浮点
# 长度转换
函数 公里转英里(浮点 公里) -> 浮点
    返回 公里 / 1.60934
结束


