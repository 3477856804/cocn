函数 集合大小(字典 集合) -> 整数
    返回 长度(键(集合))
结束

# 集合清空(集合)
# 清空集合
函数 集合清空(字典 集合)
    字典清空(集合)
结束

# 集合并集(甲, 乙) -> 字典
# 两个集合的并集
函数 集合并集(字典 甲, 字典 乙) -> 字典
    字典 结果 = 字典拷贝(甲)
    列表 乙键s = 键(乙)
    对于 i 从 0 到 长度(乙键s) - 1 循环
        结果[乙键s[i]] = 真
    结束
    返回 结果
结束

# 集合交集(甲, 乙) -> 字典
# 两个集合的交集
函数 集合交集(字典 甲, 字典 乙) -> 字典
    字典 结果 = {}
    列表 甲键s = 键(甲)
    对于 i 从 0 到 长度(甲键s) - 1 循环
        如果 包含(乙, 甲键s[i]) 则
            结果[甲键s[i]] = 真
        结束
    结束
    返回 结果
结束

# 集合差集(甲, 乙) -> 字典
# 甲 - 乙
函数 集合差集(字典 甲, 字典 乙) -> 字典
    字典 结果 = {}
    列表 甲键s = 键(甲)
    对于 i 从 0 到 长度(甲键s) - 1 循环
        如果 非 包含(乙, 甲键s[i]) 则
            结果[甲键s[i]] = 真
        结束
    结束
    返回 结果
结束

# 集合转列表(集合) -> 列表
# 集合转列表
函数 集合转列表(字典 集合) -> 列表
    返回 键(集合)
结束


