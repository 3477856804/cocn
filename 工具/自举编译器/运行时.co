# ============================================================
# 运行时.co —— 自举编译器运行时库（纯 coCN 实现）
#
# 用途：为 .co 自举编译器提供运行时支持，在 coCN 解释器下运行。
#       本运行时库是自举编译器的重要组成部分，用于在编译过程中
#       提供内存管理、字符串处理、列表操作、字典操作、打印输出、
#       文件操作、系统调用、数学计算和常用数据结构等基础功能。
#
# 模块清单：
#   模块一：内存管理（模拟）—— 模拟堆分配器接口
#   模块二：字符串操作 —— 字符串处理常用函数
#   模块三：列表操作 —— 列表常用操作封装
#   模块四：字典操作 —— 字典常用操作封装
#   模块五：打印输出 —— 格式化打印输出
#   模块六：文件操作 —— 文件读写与目录操作
#   模块七：系统调用封装 —— Shell命令与环境变量
#   模块八：数学函数 —— 常用数学计算
#   模块九：数据结构 —— 栈/队列/集合/链表
#
# 设计原则：
#   1. 纯 coCN 实现，不依赖外部库
#   2. 仅依赖宿主解释器提供的内置函数
#   3. 所有函数均为全局函数，可直接调用
#   4. 错误处理以返回空值/默认值为主，避免崩溃
#   5. 接口设计参考C标准库和Python标准库，保持一致性
#
# 注意事项：
#   - coCN 无空值概念，用空字符串或空列表作为哨兵
#   - 字典键必须是字符串类型
#   - 对于循环只支持递增方向
#   - 执行命令返回标准输出字符串
#   - 字典大小上限约256个键
# ============================================================


# ============================================================
# 模块一：内存管理（模拟）
#
# 由于 coCN 是高级语言，不需要手动管理内存。
# 本模块用字典模拟一个简单的内存分配器接口，
# 供编译过程中需要模拟堆操作的场景使用。
#
# 内存池结构（字典）：
#   {"容量": 总字节数,
#    "已用": 已分配总字节数,
#    "已分配块": {偏移字符串: 大小},   # 已分配的块，键是偏移量的字符串形式
#    "空闲块列表": [[偏移, 大小], ...]}  # 空闲块，按地址排序
#
# 分配策略：
#   - 首次适配：从头开始找第一个能容纳的空闲块
#   - 最佳适配：找最小的能容纳的空闲块
#
# 使用示例：
#   字典 池 = 创建内存池(1024)
#   整数 ptr = 分配内存(池, 100)
#   释放内存(池, ptr)
#   整数 new_ptr = 重分配内存(池, ptr, 200)
# ============================================================

# 创建内存池(总大小) -> 字典
# 创建一个指定容量的模拟内存池
函数 创建内存池(整数 总大小) -> 字典
    返回 {"容量": 总大小, "已用": 0, "已分配块": {}, "空闲块列表": [[0, 总大小]]}
结束

# 从空闲列表移除指定索引的块（内部辅助）
函数 _移除空闲块(列表 空闲, 整数 索引)
    整数 最后 = 长度(空闲) - 1
    对于 i 从 索引 到 最后 - 1 循环
        空闲[i] = 空闲[i + 1]
    结束
    弹出(空闲)
结束

# 分配内存(池, 大小) -> 整数
# 首次适配策略：找到第一个能容纳的空闲块
# 返回分配到的起始偏移，失败返回 -1
函数 分配内存(字典 池, 整数 大小) -> 整数
    列表 空闲 = 池["空闲块列表"]
    整数 n = 长度(空闲)
    对于 i 从 0 到 n - 1 循环
        整数 偏移 = 空闲[i][0]
        整数 块大小 = 空闲[i][1]
        如果 块大小 >= 大小 则
            # 分配这块
            池["已分配块"][转字符串(偏移)] = 大小
            池["已用"] = 池["已用"] + 大小
            # 更新空闲块
            如果 块大小 == 大小 则
                # 整块用完，从空闲列表移除
                _移除空闲块(空闲, i)
            否则
                # 剩余部分留在空闲列表
                空闲[i] = [偏移 + 大小, 块大小 - 大小]
            结束
            返回 偏移
        结束
    结束
    返回 -1
结束

# 释放内存(池, 偏移)
# 释放指定偏移的内存块，并与相邻空闲块合并
函数 释放内存(字典 池, 整数 偏移)
    字符串 键 = 转字符串(偏移)
    如果 非 包含(池["已分配块"], 键) 则
        返回
    结束
    整数 大小 = 池["已分配块"][键]
    删除键(池["已分配块"], 键)
    池["已用"] = 池["已用"] - 大小
    # 加入空闲列表
    列表 空闲 = 池["空闲块列表"]
    追加(空闲, [偏移, 大小])
    # 按偏移排序（简单冒泡）
    整数 空闲数 = 长度(空闲)
    对于 i 从 0 到 空闲数 - 2 循环
        对于 j 从 0 到 空闲数 - i - 2 循环
            如果 空闲[j][0] > 空闲[j + 1][0] 则
                列表 临时 = 空闲[j]
                空闲[j] = 空闲[j + 1]
                空闲[j + 1] = 临时
            结束
        结束
    结束
    # 合并相邻空闲块
    列表 合并后 = []
    对于 i 从 0 到 长度(空闲) - 1 循环
        如果 长度(合并后) > 0 则
            列表 最后块 = 合并后[长度(合并后) - 1]
            如果 最后块[0] + 最后块[1] == 空闲[i][0] 则
                最后块[1] = 最后块[1] + 空闲[i][1]
                继续
            结束
        结束
        追加(合并后, 空闲[i])
    结束
    池["空闲块列表"] = 合并后
结束

# 重分配内存(池, 旧偏移, 新大小) -> 整数
# 扩展或收缩已分配块；不够时分配新块并返回新偏移
函数 重分配内存(字典 池, 整数 旧偏移, 整数 新大小) -> 整数
    如果 旧偏移 == -1 则
        返回 分配内存(池, 新大小)
    结束
    字符串 键 = 转字符串(旧偏移)
    如果 非 包含(池["已分配块"], 键) 则
        返回 分配内存(池, 新大小)
    结束
    整数 旧大小 = 池["已分配块"][键]
    如果 新大小 <= 旧大小 则
        # 缩小
        池["已分配块"][键] = 新大小
        池["已用"] = 池["已用"] - (旧大小 - 新大小)
        # 剩余部分放回空闲
        列表 空闲 = 池["空闲块列表"]
        追加(空闲, [旧偏移 + 新大小, 旧大小 - 新大小])
        返回 旧偏移
    结束
    # 扩大：尝试找后面的空闲块是否够
    列表 空闲 = 池["空闲块列表"]
    整数 需要 = 新大小 - 旧大小
    对于 i 从 0 到 长度(空闲) - 1 循环
        如果 空闲[i][0] == 旧偏移 + 旧大小 且 空闲[i][1] >= 需要 则
            # 后面的空闲块够大
            池["已分配块"][键] = 新大小
            池["已用"] = 池["已用"] + 需要
            如果 空闲[i][1] == 需要 则
                _移除空闲块(空闲, i)
            否则
                空闲[i] = [空闲[i][0] + 需要, 空闲[i][1] - 需要]
            结束
            返回 旧偏移
        结束
    结束
    # 不够，分配新块
    整数 新偏移 = 分配内存(池, 新大小)
    如果 新偏移 != -1 则
        释放内存(池, 旧偏移)
    结束
    返回 新偏移
结束

# 最佳适配分配(池, 大小) -> 整数
# 在所有能容纳的空闲块中，找最小的那个
函数 最佳适配分配(字典 池, 整数 大小) -> 整数
    列表 空闲 = 池["空闲块列表"]
    整数 最佳索引 = -1
    整数 最佳大小 = 0
    对于 i 从 0 到 长度(空闲) - 1 循环
        整数 块大小 = 空闲[i][1]
        如果 块大小 >= 大小 则
            如果 最佳索引 == -1 或 块大小 < 最佳大小 则
                最佳索引 = i
                最佳大小 = 块大小
            结束
        结束
    结束
    如果 最佳索引 == -1 则
        返回 -1
    结束
    整数 偏移 = 空闲[最佳索引][0]
    池["已分配块"][转字符串(偏移)] = 大小
    池["已用"] = 池["已用"] + 大小
    如果 最佳大小 == 大小 则
        _移除空闲块(空闲, 最佳索引)
    否则
        空闲[最佳索引] = [偏移 + 大小, 最佳大小 - 大小]
    结束
    返回 偏移
结束

# 内存池统计(池) -> 字典
# 返回统计信息
函数 内存池统计(字典 池) -> 字典
    整数 空闲数 = 长度(池["空闲块列表"])
    整数 已分配数 = 长度(键(池["已分配块"]))
    返回 {"总容量": 池["容量"], "已用": 池["已用"], "空闲块数": 空闲数, "已分配块数": 已分配数}
结束

# 内存池释放全部(池)
# 清空内存池，所有分配的块都标记为空闲
函数 内存池释放全部(字典 池)
    池["已分配块"] = {}
    池["已用"] = 0
    池["空闲块列表"] = [[0, 池["容量"]]]
结束


# ============================================================
# 模块二：字符串操作
# ============================================================

# 字符串长度(串) -> 整数
# 返回字符串的字符数
函数 字符串长度(字符串 串) -> 整数
    返回 长度(串)
结束

# 字符串拼接(甲, 乙) -> 字符串
# 拼接两个字符串
函数 字符串拼接(字符串 甲, 字符串 乙) -> 字符串
    返回 甲 + 乙
结束

# 子字符串(串, 起始, 长度值) -> 字符串
# 从指定位置取指定长度的子串
函数 子字符串(字符串 串, 整数 起始, 整数 长度值) -> 字符串
    如果 起始 < 0 则
        起始 = 0
    结束
    整数 串长 = 长度(串)
    如果 起始 >= 串长 则
        返回 ""
    结束
    如果 起始 + 长度值 > 串长 则
        长度值 = 串长 - 起始
    结束
    返回 截取(串, 起始, 长度值)
结束

# 查找子串(串, 子串) -> 整数
# 查找子串在串中的位置，找不到返回 -1
函数 查找子串(字符串 串, 字符串 子串) -> 整数
    返回 查找(串, 子串)
结束

# 替换子串(串, 旧, 新) -> 字符串
# 替换串中所有匹配的子串
函数 替换子串(字符串 串, 字符串 旧, 字符串 新) -> 字符串
    返回 替换(串, 旧, 新)
结束

# 分割字符串(串, 分隔符) -> 列表
# 分割字符串为列表
函数 分割字符串(字符串 串, 字符串 分隔符) -> 列表
    返回 分割(串, 分隔符)
结束

# 连接字符串(列表, 分隔符) -> 字符串
# 将列表中的字符串用分隔符连接起来
函数 连接字符串(列表 列表值, 字符串 分隔符) -> 字符串
    返回 连接(列表值, 分隔符)
结束

# 转大写(串) -> 字符串
# 将字符串转为大写
函数 字符串转大写(字符串 串) -> 字符串
    返回 大写(串)
结束

# 转小写(串) -> 字符串
# 将字符串转为小写
函数 字符串转小写(字符串 串) -> 字符串
    返回 小写(串)
结束

# 去空白(串) -> 字符串
# 去掉字符串首尾的空白字符
函数 去首尾空白(字符串 串) -> 字符串
    返回 去除空白(串)
结束

# 字符串比较(甲, 乙) -> 整数
# 比较两个字符串，甲<乙返回-1，甲==乙返回0，甲>乙返回1
函数 字符串比较(字符串 甲, 字符串 乙) -> 整数
    如果 甲 == 乙 则
        返回 0
    结束
    整数 甲长 = 长度(甲)
    整数 乙长 = 长度(乙)
    整数 最短 = 甲长
    如果 乙长 < 最短 则
        最短 = 乙长
    结束
    对于 i 从 0 到 最短 - 1 循环
        整数 甲码 = 转ASCII(甲[i])
        整数 乙码 = 转ASCII(乙[i])
        如果 甲码 < 乙码 则
            返回 -1
        结束
        如果 甲码 > 乙码 则
            返回 1
        结束
    结束
    如果 甲长 < 乙长 则
        返回 -1
    结束
    返回 1
结束

# 字符串包含前缀(串, 前缀) -> 布尔
# 判断串是否以指定前缀开头
函数 字符串包含前缀(字符串 串, 字符串 前缀) -> 布尔
    整数 前缀长 = 长度(前缀)
    如果 前缀长 > 长度(串) 则
        返回 假
    结束
    返回 截取(串, 0, 前缀长) == 前缀
结束

# 字符串包含后缀(串, 后缀) -> 布尔
# 判断串是否以指定后缀结尾
函数 字符串包含后缀(字符串 串, 字符串 后缀) -> 布尔
    整数 后缀长 = 长度(后缀)
    整数 串长 = 长度(串)
    如果 后缀长 > 串长 则
        返回 假
    结束
    返回 截取(串, 串长 - 后缀长, 后缀长) == 后缀
结束

# 重复字符串(串, 次数) -> 字符串
# 将串重复指定次数
函数 重复字符串(字符串 串, 整数 次数) -> 字符串
    字符串 结果 = ""
    对于 i 从 0 到 次数 - 1 循环
        结果 = 结果 + 串
    结束
    返回 结果
结束

# 字符串倒序(串) -> 字符串
# 反转字符串
函数 字符串倒序(字符串 串) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(串)
    对于 i 从 0 到 n - 1 循环
        字符串 c = 截取(串, i, 1)
        结果 = c + 结果
    结束
    返回 结果
结束

# 统计子串出现次数(串, 子串) -> 整数
# 统计子串在串中出现的次数
函数 统计子串次数(字符串 串, 字符串 子串) -> 整数
    整数 次数 = 0
    整数 位置 = 0
    整数 串长 = 长度(串)
    整数 子串长 = 长度(子串)
    当 位置 <= 串长 - 子串长 循环
        如果 截取(串, 位置, 子串长) == 子串 则
            次数 = 次数 + 1
            位置 = 位置 + 子串长
        否则
            位置 = 位置 + 1
        结束
    结束
    返回 次数
结束

# 字符是否为数字(c) -> 布尔
# 判断字符是否为数字
函数 字符是数字(字符串 c) -> 布尔
    整数 码 = 转ASCII(c)
    返回 码 >= 48 且 码 <= 57
结束

# 字符是否为字母(c) -> 布尔
# 判断字符是否为英文字母
函数 字符是字母(字符串 c) -> 布尔
    整数 码 = 转ASCII(c)
    返回 (码 >= 65 且 码 <= 90) 或 (码 >= 97 且 码 <= 122)
结束

# 字符是否为空白(c) -> 布尔
# 判断字符是否为空白
函数 字符是空白(字符串 c) -> 布尔
    返回 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r"
结束


# ============================================================
# 模块三：列表操作
# ============================================================

# 创建列表() -> 列表
# 返回空列表
函数 创建列表() -> 列表
    返回 []
结束

# 列表追加(列表, 元素)
# 在列表尾部添加元素
函数 列表追加(列表 列表值, 元素)
    追加(列表值, 元素)
结束

# 列表获取(列表, 索引)
# 按索引获取元素
函数 列表获取(列表 列表值, 整数 索引)
    返回 列表值[索引]
结束

# 列表设置(列表, 索引, 值)
# 按索引设置元素
函数 列表设置(列表 列表值, 整数 索引, 值)
    列表值[索引] = 值
结束

# 列表长度(列表) -> 整数
# 返回列表元素个数
函数 列表长度(列表 列表值) -> 整数
    返回 长度(列表值)
结束

# 列表弹出(列表)
# 移除并返回列表最后一个元素
函数 列表弹出(列表 列表值)
    返回 弹出(列表值)
结束

# 列表插入(列表, 索引, 值)
# 在指定位置插入元素
函数 列表插入(列表 列表值, 整数 索引, 值)
    插入(列表值, 索引, 值)
结束

# 列表删除索引(列表, 索引)
# 删除指定位置的元素（通过移动元素实现）
函数 列表删除索引(列表 列表值, 整数 索引)
    整数 n = 长度(列表值)
    如果 索引 < 0 或 索引 >= n 则
        返回
    结束
    # 后面的元素往前移
    对于 i 从 索引 到 n - 2 循环
        列表值[i] = 列表值[i + 1]
    结束
    # 弹出最后一个重复的元素
    弹出(列表值)
结束

# 列表包含(列表, 元素) -> 布尔
# 判断列表是否包含某元素
函数 列表包含(列表 列表值, 元素) -> 布尔
    返回 包含(列表值, 元素)
结束

# 快速排序(列表) -> 列表
# 对列表进行排序（升序），返回新列表
# 基于内置排序实现
函数 快速排序(列表 列表值) -> 列表
    返回 排序(列表值)
结束

# 列表反转(列表) -> 列表
# 返回反转后的新列表
函数 列表反转(列表 列表值) -> 列表
    列表 结果 = []
    整数 n = 长度(列表值)
    对于 i 从 0 到 n - 1 循环
        插入(结果, 0, 列表值[i])
    结束
    返回 结果
结束

# 列表切片(列表, 起始, 结束) -> 列表
# 取列表的子列表 [起始, 结束)
函数 列表切片(列表 列表值, 整数 起始, 整数 末) -> 列表
    返回 切片(列表值, 起始, 末)
结束

# 列表去重(列表) -> 列表
# 去除列表中的重复元素，保持顺序
函数 列表去重(列表 列表值) -> 列表
    字典 seen = {}
    列表 结果 = []
    对于 i 从 0 到 长度(列表值) - 1 循环
        字符串 键 = 转字符串(列表值[i])
        如果 非 包含(seen, 键) 则
            seen[键] = 1
            追加(结果, 列表值[i])
        结束
    结束
    返回 结果
结束

# 列表拼接(甲, 乙) -> 列表
# 拼接两个列表
函数 列表拼接(列表 甲, 列表 乙) -> 列表
    返回 甲 + 乙
结束

# 列表查找索引(列表, 元素) -> 整数
# 查找元素在列表中的索引，找不到返回 -1
函数 列表查找索引(列表 列表值, 元素) -> 整数
    对于 i 从 0 到 长度(列表值) - 1 循环
        如果 列表值[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 列表计数(列表, 元素) -> 整数
# 统计元素在列表中出现的次数
函数 列表计数(列表 列表值, 元素) -> 整数
    整数 次数 = 0
    对于 i 从 0 到 长度(列表值) - 1 循环
        如果 列表值[i] == 元素 则
            次数 = 次数 + 1
        结束
    结束
    返回 次数
结束

# 列表最大值(列表)
# 返回列表中的最大值
函数 列表最大值(列表 列表值)
    如果 长度(列表值) == 0 则
        返回 0
    结束
    返回 最大值(列表值)
结束

# 列表最小值(列表)
# 返回列表中的最小值
函数 列表最小值(列表 列表值)
    如果 长度(列表值) == 0 则
        返回 0
    结束
    返回 最小值(列表值)
结束

# 列表求和(列表) -> 整数
# 求列表中所有元素的和
函数 列表求和(列表 列表值) -> 整数
    整数 总和 = 0
    对于 i 从 0 到 长度(列表值) - 1 循环
        总和 = 总和 + 列表值[i]
    结束
    返回 总和
结束

# 列表清空(列表)
# 清空列表所有元素
函数 列表清空(列表 列表值)
    当 长度(列表值) > 0 循环
        弹出(列表值)
    结束
结束


