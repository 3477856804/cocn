# 格式化字符串(模板, 参数列表) -> 字符串
# 简单格式化：模板中的 {0}, {1}, ... 替换为对应参数
函数 格式化字符串(字符串 模板, 列表 参数列表) -> 字符串
    字符串 结果 = 模板
    对于 i 从 0 到 长度(参数列表) - 1 循环
        字符串 占位符 = "{" + 转字符串(i) + "}"
        结果 = 替换(结果, 占位符, 转字符串(参数列表[i]))
    结束
    返回 结果
结束

# 打印格式化(模板, 参数列表)
# 格式化并输出
函数 打印格式化(字符串 模板, 列表 参数列表)
    输出(格式化字符串(模板, 参数列表))
结束

# 打印列表(列表)
# 打印列表内容，格式 [1, 2, 3]
函数 打印列表(列表 列表值)
    字符串 s = "["
    对于 i 从 0 到 长度(列表值) - 1 循环
        如果 i > 0 则
            s = s + ", "
        结束
        s = s + 转字符串(列表值[i])
    结束
    s = s + "]"
    输出(s)
结束

# 打印字典(字典)
# 打印字典内容，格式 {"a": 1, "b": 2}
函数 打印字典(字典 字典值)
    列表 键s = 键(字典值)
    字符串 s = "{"
    对于 i 从 0 到 长度(键s) - 1 循环
        如果 i > 0 则
            s = s + ", "
        结束
        s = s + "\"" + 键s[i] + "\": " + 转字符串(字典值[键s[i]])
    结束
    s = s + "}"
    输出(s)
结束

