# ---------- 队列（用列表实现，带头尾指针） ----------

# 创建队列() -> 字典
# 创建空队列
函数 创建队列() -> 字典
    返回 {"数据": [], "头": 0}
结束

# 入队(队列, 元素)
# 入队
函数 入队(字典 队列, 元素)
    追加(队列["数据"], 元素)
结束

# 出队(队列)
# 出队，返回队首元素
函数 出队(字典 队列)
    如果 队列["头"] >= 长度(队列["数据"]) 则
        返回 ""
    结束
    让 出队元素 = 队列["数据"][队列["头"]]
    队列["头"] = 队列["头"] + 1
    # 定期清理前面的已出队元素
    如果 队列["头"] > 100 则
        列表 新数据 = []
        对于 i 从 队列["头"] 到 长度(队列["数据"]) - 1 循环
            追加(新数据, 队列["数据"][i])
        结束
        队列["数据"] = 新数据
        队列["头"] = 0
    结束
    返回 出队元素
结束

# 队首(队列)
# 查看队首元素，不出队
函数 队首(字典 队列)
    如果 队列["头"] >= 长度(队列["数据"]) 则
        返回 ""
    结束
    返回 队列["数据"][队列["头"]]
结束

# 队列空(队列) -> 布尔
# 判断队列是否为空
函数 队列空(字典 队列) -> 布尔
    返回 队列["头"] >= 长度(队列["数据"])
结束

# 队列大小(队列) -> 整数
# 返回队列中元素个数
函数 队列大小(字典 队列) -> 整数
    返回 长度(队列["数据"]) - 队列["头"]
结束


