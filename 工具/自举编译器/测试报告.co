# ============================================================
# 测试报告.co —— 生成 AST 解析的简要报告（调试辅助）
#
# 功能：
#   - 输入源码字符串
#   - 输出 token 统计 + AST 节点数 + 顶层语句列表
#   - 用于快速验证解析结果是否符合预期
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 生成完整解析报告
函数 生成解析报告(字符串 源) -> 字符串
    列表 tokens = 词法分析(源)
    字典 ast = 语法分析(tokens)
    列表 stmts = ast["语句"]

    字符串 报告 = ""
    报告 = 报告 + "========== 解析报告 ==========\n"
    报告 = 报告 + "源码长度: " + 转字符串(长度(源)) + " 字符\n"
    报告 = 报告 + "Token 数: " + 转字符串(长度(tokens)) + "\n"
    报告 = 报告 + "顶层语句数: " + 转字符串(长度(stmts)) + "\n"
    报告 = 报告 + "AST 节点总数: " + 转字符串(统计节点数(ast)) + "\n"
    报告 = 报告 + "------------------------------\n"

    对于 i 从 0 到 长度(stmts) - 1 循环
        字符串 t = stmts[i]["类型"]
        字符串 行描述 = "  [" + 转字符串(i) + "] " + t
        若 t == "变量声明"
            行描述 = 行描述 + " 名字=" + stmts[i]["名字"]
        结束
        若 t == "函数定义"
            行描述 = 行描述 + " 名字=" + stmts[i]["名字"] + " 参数数=" + 转字符串(长度(stmts[i]["参数"]))
        结束
        若 t == "如果"
            行描述 = 行描述 + " (条件分支)"
        结束
        若 t == "当"
            行描述 = 行描述 + " (循环)"
        结束
        若 t == "对于"
            行描述 = 行描述 + " (循环)"
        结束
        若 t == "返回"
            行描述 = 行描述 + " (返回语句)"
        结束
        若 t == "函数调用"
            行描述 = 行描述 + " 调用"
        结束
        报告 = 报告 + 行描述 + "\n"
    结束

    报告 = 报告 + "==============================\n"
    返回 报告
结束

# 打印解析报告到 stdout
函数 打印解析报告(字符串 源)
    输出 生成解析报告(源)
结束
