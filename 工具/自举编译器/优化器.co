# ============================================================
# 优化器.co —— 自举版 SSA 优化器与寄存器分配器（纯 coCN 实现）
#
# 流水线：
#   三地址码 IR → 构建 CFG → 支配树/支配边界 → SSA 转换
#     → 6 个优化 pass → SSA 销毁 → 活跃性分析 →
#     图着色寄存器分配 → 指令调度 → 窥孔优化
#
# 移植自 工具/原生编译器/优化器/ 下的 JS 实现，语义保持一致。
#
# IR 数据结构约定（全部用字典 + 列表）：
#   函数 = {"名字": str, "参数": [str], "块": [块]}
#   块   = {"id": int, "指令": [指令], "终结": 终结,
#           "前驱": [int], "后继": [int]}
#   指令 = {"op": ..., "dest": str, ...}   （见各构造器）
#   终结 = {"种类": "跳转"/"分支"/"返回"/"不可达", ...}
#
# 集合约定：用字典模拟（键 = 元素，值 = 1）。
#   - 块 id 集合的键一律 转字符串(id)
#   - 变量名集合的键就是变量名字符串
# 图约定：字典套字典（邻接表）。
# 无空值：用 "" 表示“无 dest / 无条件值”，用 -1 表示“无块 id”。
# ============================================================


# ============================================================
# 第 0 节：集合 / 字典小工具
# ============================================================

# 集合添加：s[e] = 1
函数 集加(字典 s, 键)
    s[键] = 1
结束

# 集合删除：删除字典键
# （本运行环境字典删键用 删除）
函数 集删(字典 s, 键)
    删除键(s, 键)
结束

# 集合是否包含
函数 集有(字典 s, 键) -> 布尔
    返回 包含(s, 键)
结束

# 集合大小
函数 集长(字典 s) -> 整数
    返回 长度(s)
结束

# 把 src 的所有键并入 dst（dst 原地修改）
函数 集并(字典 dst, 字典 src)
    对于 k 于 键(src) 循环
        dst[k] = 1
    结束
结束

# 判断两个集合是否相等（键集合相同）
函数 集等(字典 a, 字典 b) -> 布尔
    如果 长度(a) != 长度(b)
        返回 假
    结束
    对于 k 于 键(a) 循环
        如果 非 包含(b, k)
            返回 假
        结束
    结束
    返回 真
结束

# 浅复制字典（值为标量 / 小结构）
函数 浅复制(字典 src) -> 字典
    字典 out = {}
    对于 k 于 键(src) 循环
        out[k] = src[k]
    结束
    返回 out
结束

# 把一个列表复制一份
函数 复制列表(列表 src) -> 列表
    列表 out = []
    对于 i 从 0 到 长度(src) - 1 循环
        追加(out, src[i])
    结束
    返回 out
结束

# 判断列表里是否含某元素
函数 表含(列表 表, 元素) -> 布尔
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] == 元素
            返回 真
        结束
    结束
    返回 假
结束

# 求元素在列表中的下标，找不到返回 -1
函数 找下标(列表 表, 元素) -> 整数
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] == 元素
            返回 i
        结束
    结束
    返回 -1
结束


# ============================================================
# 第 1 节：IR 构造器
# ============================================================

# dest = 字面量
函数 常量指令(字符串 dest, 值) -> 字典
    返回 {"op": "const", "dest": dest, "值": 值}
结束

# dest = src
函数 移动指令(字符串 dest, 字符串 src) -> 字典
    返回 {"op": "mov", "dest": dest, "src": src}
结束

# dest = left OP right（op: add/sub/mul/div/mod/lt/le/eq/ne/gt/ge/and/or）
函数 二元指令(字符串 op, 字符串 dest, 字符串 left, 字符串 right) -> 字典
    返回 {"op": op, "dest": dest, "左": left, "右": right}
结束

# dest = OP src（op: neg/not）
函数 一元指令(字符串 op, 字符串 dest, 字符串 src) -> 字典
    返回 {"op": op, "dest": dest, "src": src}
结束

# dest = name(args)
函数 调用指令(字符串 dest, 字符串 name, 列表 args) -> 字典
    返回 {"op": "call", "dest": dest, "名": name, "实参": args}
结束

# dest = phi(来自块[k] ::= 实参[k])
函数 费指令(字符串 dest, 列表 来自块, 列表 实参) -> 字典
    返回 {"op": "phi", "dest": dest, "来自块": 来自块, "实参": 实参}
结束

# ---- 终结符 ----

# goto target
函数 跳转终结(整数 目标) -> 字典
    返回 {"种类": "跳转", "目标": 目标}
结束

# if cond goto 成块 else goto 败块
# 终结字典用字符串键 "是"/"否"（字符串键不触发保留字）
函数 分支终结(字符串 cond, 整数 成块, 整数 败块) -> 字典
    返回 {"种类": "分支", "条件": cond, "是": 成块, "否": 败块}
结束

# ret value（value 为 "" 表示无返回值）
函数 返回终结(字符串 值) -> 字典
    返回 {"种类": "返回", "值": 值}
结束

# unreachable
函数 不可达终结() -> 字典
    返回 {"种类": "不可达"}
结束

# ---- 基本块 / 函数 ----

函数 新建块(整数 id) -> 字典
    返回 {"id": id, "指令": [], "终结": 不可达终结(), "前驱": [], "后继": []}
结束

函数 新建函数(字符串 名字, 列表 参数) -> 字典
    列表 块表 = []
    追加(块表, 新建块(0))
    返回 {"名字": 名字, "参数": 复制列表(参数), "块": 块表}
结束

# 在函数末尾追加一个新块，返回该块
函数 新增块(字典 fn) -> 字典
    字典 b = 新建块(长度(fn["块"]))
    追加(fn["块"], b)
    返回 b
结束


# ============================================================
# 第 2 节：构建 CFG（根据终结符填充 前驱 / 后继）
# ============================================================
函数 建CFG(字典 fn)
    列表 块表 = fn["块"]
    对于 i 从 0 到 长度(块表) - 1 循环
        块表[i]["前驱"] = []
        块表[i]["后继"] = []
    结束
    对于 i 从 0 到 长度(块表) - 1 循环
        字典 blk = 块表[i]
        字典 t = blk["终结"]
        如果 t["种类"] == "跳转"
            追加(blk["后继"], t["目标"])
        否则 如果 t["种类"] == "分支"
            追加(blk["后继"], t["是"])
            追加(blk["后继"], t["否"])
        结束
    结束
    对于 i 从 0 到 长度(块表) - 1 循环
        字典 blk = 块表[i]
        对于 j 从 0 到 长度(blk["后继"]) - 1 循环
            整数 s = blk["后继"][j]
            追加(块表[s]["前驱"], blk["id"])
        结束
    结束
结束


# ============================================================
# 第 3 节：指令操作数工具
# ============================================================

# 一条指令读取的所有变量名（use 集合）
# 注意：phi 的 use 不在此处理（在活跃性里单独按边处理）
函数 指令用(字典 ins) -> 列表
    列表 u = []
    字符串 op = ins["op"]
    如果 op == "const" 或 op == "phi"
        # const 无 use；phi 的操作数按边归属，块级分析时不算 use
    否则 如果 op == "mov" 或 op == "neg" 或 op == "not"
        追加(u, ins["src"])
    否则 如果 op == "call"
        对于 i 从 0 到 长度(ins["实参"]) - 1 循环
            追加(u, ins["实参"][i])
        结束
    否则 如果 op == "load"
        追加(u, ins["base"])
    否则 如果 op == "store"
        追加(u, ins["base"])
        追加(u, ins["src"])
    否则
        追加(u, ins["左"])
        追加(u, ins["右"])
    结束
    返回 u
结束

# 一条指令定义（写入）的变量名；无定义返回 ""
函数 指令定义(字典 ins) -> 字符串
    返回 ins["dest"]
结束

# 终结符读取的变量名
函数 终结用(字典 t) -> 列表
    列表 u = []
    如果 t["种类"] == "分支"
        追加(u, t["条件"])
    否则 如果 t["种类"] == "返回" 且 t["值"] != ""
        追加(u, t["值"])
    结束
    返回 u
结束

# 是否有副作用（不能被 DCE 删除）
函数 有副作用(字典 ins) -> 布尔
    字符串 op = ins["op"]
    返回 op == "call" 或 op == "store"
结束

# 是否为二元运算
函数 是二元(字符串 op) -> 布尔
    返回 op == "add" 或 op == "sub" 或 op == "mul" 或 op == "div" 或 op == "mod" 或 op == "lt" 或 op == "le" 或 op == "eq" 或 op == "ne" 或 op == "gt" 或 op == "ge" 或 op == "and" 或 op == "or"
结束

# 是否为一元运算
函数 是一元(字符串 op) -> 布尔
    返回 op == "neg" 或 op == "not"
结束

# ============================================================
# 第 4 节：逆后序遍历 (RPO)
# ============================================================
# 迭代 DFS：先访问所有后继，再把块压栈（后序），最后逆序得到 RPO。
函数 逆后序(字典 fn) -> 列表
    列表 块表 = fn["块"]
    整数 n = 长度(块表)
    字典 访问 = {}
    列表 后序 = []
    # 对每个未访问块启动 DFS（处理不可达块）
    整数 起点 = 0
    当 起点 < n 循环
        如果 集有(访问, 转字符串(起点))
            起点 = 起点 + 1
            继续
        结束
        # 显式栈：元素是 [块id, 下一个后继下标]
        集加(访问, 转字符串(起点))
        列表 栈 = [[起点, 0]]
        当 长度(栈) > 0 循环
            列表 顶 = 栈[长度(栈) - 1]
            整数 b = 顶[0]
            列表 苏 = 块表[b]["后继"]
            如果 顶[1] < 长度(苏)
                整数 s = 苏[顶[1]]
                顶[1] = 顶[1] + 1
                如果 非 集有(访问, 转字符串(s))
                    集加(访问, 转字符串(s))
                    追加(栈, [s, 0])
                结束
            否则
                追加(后序, b)
                弹出(栈)
            结束
        结束
        起点 = 起点 + 1
    结束
    # 后序逆序 = 逆后序
    列表 rpo = []
    对于 i 从 长度(后序) - 1 到 0 步长 -1 循环
        追加(rpo, 后序[i])
    结束
    返回 rpo
结束


# ============================================================
# 第 5 节：支配树与支配边界
#   Cooper-Harvey-Kennedy 简单迭代支配者算法
#   返回 {"idom":[int], "dom子":[list], "支配边界":[set], "入口":int}
# ============================================================

# 支配交集：沿支配树把更深的手指上跳直到相遇
函数 _支配交集(整数 b1, 整数 b2, 列表 idom, 列表 rpo号) -> 整数
    当 b1 != b2 循环
        当 rpo号[b1] > rpo号[b2] 循环
            b1 = idom[b1]
        结束
        当 rpo号[b2] > rpo号[b1] 循环
            b2 = idom[b2]
        结束
    结束
    返回 b1
结束

函数 算支配(字典 fn) -> 字典
    列表 块表 = fn["块"]
    整数 n = 长度(块表)
    如果 n == 0
        返回 {"idom": [], "dom子": [], "支配边界": [], "入口": 0}
    结束
    列表 rpo = 逆后序(fn)
    # rpo号[块id] = 它在 rpo 中的序号
    列表 rpo号 = []
    对于 i 从 0 到 n - 1 循环
        追加(rpo号, -1)
    结束
    对于 i 从 0 到 长度(rpo) - 1 循环
        rpo号[rpo[i]] = i
    结束
    整数 入口 = rpo[0]
    # idom[b] = 直接支配者；-1 表示尚未处理
    列表 idom = []
    对于 i 从 0 到 n - 1 循环
        追加(idom, -1)
    结束
    idom[入口] = 入口

    # 迭代到不动点
    布尔 变化 = 真
    当 变化 循环
        变化 = 假
        对于 i 从 1 到 长度(rpo) - 1 循环
            整数 b = rpo[i]
            整数 新idom = -1
            对于 j 从 0 到 长度(块表[b]["前驱"]) - 1 循环
                整数 p = 块表[b]["前驱"][j]
                如果 idom[p] == -1
                    继续
                结束
                如果 新idom == -1
                    新idom = p
                否则
                    新idom = _支配交集(p, 新idom, idom, rpo号)
                结束
            结束
            如果 新idom != -1 且 idom[b] != 新idom
                idom[b] = 新idom
                变化 = 真
            结束
        结束
    结束

    # 构造支配树子节点表
    列表 dom子 = []
    对于 i 从 0 到 n - 1 循环
        追加(dom子, [])
    结束
    对于 b 从 0 到 n - 1 循环
        如果 b != 入口 且 idom[b] != -1
            追加(dom子[idom[b]], b)
        结束
    结束

    # 计算支配边界 DF(b)
    列表 支配边界 = []
    对于 i 从 0 到 n - 1 循环
        追加(支配边界, {})
    结束
    对于 b 从 0 到 n - 1 循环
        字典 blk = 块表[b]
        如果 长度(blk["前驱"]) < 2
            继续
        结束
        对于 j 从 0 到 长度(blk["前驱"]) - 1 循环
            整数 p = blk["前驱"][j]
            整数 runner = p
            当 runner != -1 且 runner != idom[b] 且 idom[runner] != -1 循环
                集加(支配边界[runner], 转字符串(b))
                runner = idom[runner]
            结束
        结束
    结束

    返回 {"idom": idom, "dom子": dom子, "支配边界": 支配边界, "入口": 入口}
结束

# 判断 a 是否支配 b（含相等）
函数 支配(列表 idom, 整数 a, 整数 b) -> 布尔
    整数 cur = b
    当 cur != -1 循环
        如果 cur == a
            返回 真
        结束
        如果 idom[cur] == cur
            跳出
        结束
        cur = idom[cur]
    结束
    返回 假
结束


# ============================================================
# 第 6 节：SSA 转换
# ============================================================

# 去掉 SSA 版本后缀："x#3" -> "x"。仅当 # 后全是数字才剥。
函数 剥SSA名(字符串 nm) -> 字符串
    # 找最后一个 #
    整数 idx = -1
    对于 i 从 长度(nm) - 1 到 0 步长 -1 循环
        如果 nm[i] == "#"
            idx = i
            跳出
        结束
    结束
    如果 idx <= 0
        返回 nm
    结束
    # 检查 idx+1 到末尾是否全数字
    布尔 全数字 = 真
    对于 i 从 idx + 1 到 长度(nm) - 1 循环
        字符串 c = nm[i]
        如果 非 (c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9")
            全数字 = 假
        结束
    结束
    如果 全数字
        返回 截取(nm, 0, idx)
    结束
    返回 nm
结束

# ---- 版本栈操作（状态字典：计数/栈） ----
函数 推版本(字符串 v, 字典 状态) -> 字符串
    字典 计数 = 状态["计数"]
    字典 栈 = 状态["栈"]
    整数 c = 1
    如果 包含(计数, v)
        c = 计数[v] + 1
    结束
    计数[v] = c
    字符串 新名 = v + "#" + 转字符串(c)
    如果 非 包含(栈, v)
        栈[v] = []
    结束
    追加(栈[v], 新名)
    返回 新名
结束

函数 窥版本(字符串 v, 字典 状态) -> 字符串
    字典 栈 = 状态["栈"]
    如果 非 包含(栈, v)
        返回 v
    结束
    列表 s = 栈[v]
    如果 长度(s) == 0
        返回 v
    结束
    返回 s[长度(s) - 1]
结束

函数 弹版本(字符串 v, 字典 状态)
    字典 栈 = 状态["栈"]
    如果 包含(栈, v)
        列表 s = 栈[v]
        如果 长度(s) > 0
            弹出(s)
        结束
    结束
结束

# 重命名一条普通指令的所有 use
函数 重命名用(字典 ins, 字典 状态)
    字符串 op = ins["op"]
    如果 op == "const" 或 op == "phi"
        # const 无 use；phi 的 use 在块首单独按边处理
    否则 如果 op == "mov" 或 op == "neg" 或 op == "not"
        ins["src"] = 窥版本(ins["src"], 状态)
    否则 如果 op == "call"
        对于 i 从 0 到 长度(ins["实参"]) - 1 循环
            ins["实参"][i] = 窥版本(ins["实参"][i], 状态)
        结束
    否则 如果 op == "load"
        ins["base"] = 窥版本(ins["base"], 状态)
    否则 如果 op == "store"
        ins["base"] = 窥版本(ins["base"], 状态)
        ins["src"] = 窥版本(ins["src"], 状态)
    否则
        ins["左"] = 窥版本(ins["左"], 状态)
        ins["右"] = 窥版本(ins["右"], 状态)
    结束
结束

# 重命名终结符的 use
函数 重命名终结用(字典 t, 字典 状态)
    如果 t["种类"] == "分支"
        t["条件"] = 窥版本(t["条件"], 状态)
    否则 如果 t["种类"] == "返回" 且 t["值"] != ""
        t["值"] = 窥版本(t["值"], 状态)
    结束
结束

# 重命名一个块（沿支配树递归）
函数 重命名块(整数 bid, 字典 状态)
    字典 fn = 状态["fn"]
    列表 块表 = fn["块"]
    字典 dom = 状态["dom"]
    字典 blk = 块表[bid]
    列表 本块定义 = []   # 本块新定义的原名，退出时弹栈

    # 1) 先处理 phi：它们定义新版本（dest 此时还是原名）
    对于 i 从 0 到 长度(blk["指令"]) - 1 循环
        字典 ins = blk["指令"][i]
        如果 ins["op"] != "phi"
            继续
        结束
        字符串 v = ins["dest"]
        ins["dest"] = 推版本(v, 状态)
        追加(本块定义, v)
    结束

    # 2) 普通指令：先重命名 use，再重命名 dest
    对于 i 从 0 到 长度(blk["指令"]) - 1 循环
        字典 ins = blk["指令"][i]
        如果 ins["op"] == "phi"
            继续
        结束
        重命名用(ins, 状态)
        字符串 d = 指令定义(ins)
        如果 d != ""
            ins["dest"] = 推版本(d, 状态)
            追加(本块定义, d)
        结束
    结束

    # 3) 终结符 use
    重命名终结用(blk["终结"], 状态)

    # 4) 把当前版本回填到每个后继块的 phi
    对于 j 从 0 到 长度(blk["后继"]) - 1 循环
        整数 s = blk["后继"][j]
        字典 succ = 块表[s]
        整数 pidx = 找下标(succ["前驱"], bid)
        如果 pidx == -1
            继续
        结束
        对于 k 从 0 到 长度(succ["指令"]) - 1 循环
            字典 ins = succ["指令"][k]
            如果 ins["op"] != "phi"
                继续
            结束
            字符串 原名 = 剥SSA名(ins["dest"])
            字符串 当前 = 窥版本(原名, 状态)
            # 保证 来自块/实参 长度 >= pidx+1
            当 长度(ins["来自块"]) <= pidx 循环
                追加(ins["来自块"], -1)
                追加(ins["实参"], "")
            结束
            ins["来自块"][pidx] = bid
            ins["实参"][pidx] = 当前
        结束
    结束

    # 5) 递归支配树子节点
    对于 j 从 0 到 长度(dom["dom子"][bid]) - 1 循环
        重命名块(dom["dom子"][bid][j], 状态)
    结束

    # 6) 退出：弹掉本块定义
    对于 j 从 0 到 长度(本块定义) - 1 循环
        弹版本(本块定义[j], 状态)
    结束
结束

# 把函数转为 SSA（原地）
函数 转SSA(字典 fn) -> 字典
    字典 dom = 算支配(fn)
    整数 n = 长度(fn["块"])

    # 1) 收集每个变量在哪些块被定义：def块[v] = set(str(bid))
    字典 def块 = {}
    # 参数视为在入口块定义
    对于 i 从 0 到 长度(fn["参数"]) - 1 循环
        字符串 p = fn["参数"][i]
        如果 非 包含(def块, p)
            def块[p] = {}
        结束
        集加(def块[p], 转字符串(dom["入口"]))
    结束
    对于 b 从 0 到 n - 1 循环
        字典 blk = fn["块"][b]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字符串 d = 指令定义(blk["指令"][i])
            如果 d != ""
                如果 非 包含(def块, d)
                    def块[d] = {}
                结束
                集加(def块[d], 转字符串(b))
            结束
        结束
    结束

    # 2) phi 插入
    # 已插phi[b] = set(v)：块 b 是否已为 v 插过 phi
    列表 已插phi = []
    对于 i 从 0 到 n - 1 循环
        追加(已插phi, {})
    结束
    对于 v 于 键(def块) 循环
        # worklist = 该变量的所有定义块
        列表 工作表 = []
        对于 s 于 键(def块[v]) 循环
            追加(工作表, 转整数(s))
        结束
        当 长度(工作表) > 0 循环
            整数 x = 弹出(工作表)
            # 遍历 x 的支配边界
            对于 y 于 键(dom["支配边界"][x]) 循环
                整数 yid = 转整数(y)
                如果 非 集有(已插phi[yid], v)
                    # 在块 y 首插入 phi: v = phi(,)
                    字典 ph = 费指令(v, [], [])
                    # 插到指令列表开头
                    列表 新指令 = [ph]
                    对于 q 从 0 到 长度(fn["块"][yid]["指令"]) - 1 循环
                        追加(新指令, fn["块"][yid]["指令"][q])
                    结束
                    fn["块"][yid]["指令"] = 新指令
                    集加(已插phi[yid], v)
                    # y 现在也定义了 v，若之前没定义过则加入 worklist
                    如果 非 集有(def块[v], 转字符串(yid))
                        集加(def块[v], 转字符串(yid))
                        追加(工作表, yid)
                    结束
                结束
            结束
        结束
    结束

    # 3) 重命名
    字典 状态 = {"fn": fn, "dom": dom, "计数": {}, "栈": {}}
    # 参数在入口块先压栈
    对于 i 从 0 到 长度(fn["参数"]) - 1 循环
        推版本(fn["参数"][i], 状态)
    结束
    重命名块(dom["入口"], 状态)

    fn["是SSA"] = 真
    fn["dom"] = dom
    返回 fn
结束

# SSA 销毁：把 phi 展开为前驱块末尾的 mov，然后删除所有 phi
函数 销SSA(字典 fn) -> 字典
    对于 b 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][b]
        列表 新指令 = []
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            如果 ins["op"] != "phi"
                继续
            结束
            # 对每条 phi，在前驱块末尾插 mov
            对于 k 从 0 到 长度(ins["来自块"]) - 1 循环
                整数 pid = ins["来自块"][k]
                字符串 arg = ins["实参"][k]
                如果 pid == -1 或 arg == ""
                    继续
                结束
                追加(fn["块"][pid]["指令"], 移动指令(ins["dest"], arg))
            结束
        结束
        # 删除本块的 phi
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            如果 blk["指令"][i]["op"] != "phi"
                追加(新指令, blk["指令"][i])
            结束
        结束
        blk["指令"] = 新指令
    结束
    fn["是SSA"] = 假
    返回 fn
结束


# ============================================================
# 第 7 节：常量折叠工具
# ============================================================

# 把布尔转成 IR 字面值（真->1，假->0）；其他原样
函数 字面值(值)
    如果 类型(值) == "布尔"
        如果 值
            返回 1
        结束
        返回 0
    结束
    返回 值
结束

# 二元常量折叠；无法折叠返回 ""
函数 折叠二元(字符串 op, l, r)
    如果 op == "add"
        返回 l + r
    结束
    如果 op == "sub"
        返回 l - r
    结束
    如果 op == "mul"
        返回 l * r
    结束
    如果 op == "div"
        如果 r == 0
            返回 ""
        结束
        返回 截断(l / r)
    结束
    如果 op == "mod"
        如果 r == 0
            返回 ""
        结束
        返回 l % r
    结束
    如果 op == "lt"
        返回 l < r
    结束
    如果 op == "le"
        返回 l <= r
    结束
    如果 op == "eq"
        返回 l == r
    结束
    如果 op == "ne"
        返回 l != r
    结束
    如果 op == "gt"
        返回 l > r
    结束
    如果 op == "ge"
        返回 l >= r
    结束
    如果 op == "and"
        返回 l 且 r
    结束
    如果 op == "or"
        返回 l 或 r
    结束
    返回 ""
结束

# 一元常量折叠；无法折叠返回 ""
函数 折叠一元(字符串 op, v)
    如果 op == "neg"
        返回 -v
    结束
    如果 op == "not"
        返回 非 v
    结束
    返回 ""
结束


# ============================================================
# 第 8 节：Pass 1 —— 常量传播与常量折叠
# ============================================================
# 在单块内跟踪 var->字面值，编译期算出常量表达式；
# 条件为常量的分支改成无条件跳转。
# 已知: 入口处已知常量表（var->字面量），原地更新，返回出口快照。

函数 化简块(字典 fn, 整数 bid, 字典 已知) -> 字典
    字典 blk = fn["块"][bid]
    字典 出 = 浅复制(已知)
    对于 i 从 0 到 长度(blk["指令"]) - 1 循环
        字典 ins = blk["指令"][i]
        字符串 op = ins["op"]
        字符串 d = 指令定义(ins)

        如果 op == "const"
            出[ins["dest"]] = ins["值"]
        否则 如果 op == "mov"
            # x = y：若 y 已知常量，折叠成 const x
            如果 包含(出, ins["src"])
                blk["指令"][i] = 常量指令(ins["dest"], 出[ins["src"]])
                出[ins["dest"]] = 出[ins["src"]]
            否则
                如果 d != ""
                    删除键(出, d)
                结束
            结束
        否则 如果 op == "call" 或 op == "load" 或 op == "store"
            如果 d != ""
                删除键(出, d)
            结束
        否则 如果 op == "phi"
            # phi 的实参若都是同一非变量字面值则折叠，否则放弃
            布尔 全一致 = 真
            字符串 首值 = ""
            对于 k 从 0 到 长度(ins["实参"]) - 1 循环
                字符串 a = ins["实参"][k]
                字符串 v = a
                如果 包含(出, a)
                    v = 出[a]
                结束
                如果 k == 0
                    首值 = v
                否则
                    如果 v != 首值
                        全一致 = 假
                    结束
                结束
            结束
            如果 全一致 且 长度(ins["实参"]) > 0 且 非 是否变量名(首值)
                blk["指令"][i] = 常量指令(ins["dest"], 首值)
                出[ins["dest"]] = 首值
            否则
                如果 d != ""
                    删除键(出, d)
                结束
            结束
        否则 如果 是一元(op)
            如果 包含(出, ins["src"])
                字典 r = 折叠一元(op, 出[ins["src"]])
                如果 类型(r) != "字符串" 或 r != ""
                    blk["指令"][i] = 常量指令(ins["dest"], 字面值(r))
                    出[ins["dest"]] = 字面值(r)
                否则
                    删除键(出, d)
                结束
            否则
                删除键(出, d)
            结束
        否则
            # 二元
            如果 包含(出, ins["左"]) 且 包含(出, ins["右"])
                字典 r = 折叠二元(op, 出[ins["左"]], 出[ins["右"]])
                如果 类型(r) != "字符串" 或 r != ""
                    blk["指令"][i] = 常量指令(ins["dest"], 字面值(r))
                    出[ins["dest"]] = 字面值(r)
                否则
                    删除键(出, d)
                结束
            否则
                删除键(出, d)
            结束
        结束
    结束

    # 终结符：条件为常量 -> 改无条件跳转
    字典 t = blk["终结"]
    如果 t["种类"] == "分支" 且 包含(出, t["条件"])
        布尔 条件为真 = 字面值(出[t["条件"]]) != 0
        整数 目标 = t["是"]
        如果 非 条件为真
            目标 = t["否"]
        结束
        blk["终结"] = 跳转终结(目标)
    结束
    返回 出
结束

# 判断一个值看起来是否是变量名（未折叠的符号）
# 这里约定：字面值是整数/布尔；字符串一律视为变量名。
函数 是否变量名(值) -> 布尔
    返回 类型(值) == "字符串"
结束

# 函数级常量传播（前向数据流，迭代到不动点）
函数 常量传播(字典 fn) -> 字典
    整数 n = 长度(fn["块"])
    列表 入口已知 = []
    对于 i 从 0 到 n - 1 循环
        追加(入口已知, {})
    结束
    入口已知[0] = {}
    整数 守卫 = 0
    布尔 变化 = 真
    当 变化 且 守卫 < 100 循环
        变化 = 假
        守卫 = 守卫 + 1
        对于 b 从 0 到 n - 1 循环
            字典 blk = fn["块"][b]
            如果 长度(blk["指令"]) == 0 且 blk["终结"]["种类"] == "不可达"
                继续
            结束
            字典 后 = 化简块(fn, b, 入口已知[b])
            # 传播到后继：两个前驱都知道同一常量才传播；冲突 -> 未知
            对于 j 从 0 到 长度(blk["后继"]) - 1 循环
                整数 s = blk["后继"][j]
                字典 sk = 入口已知[s]
                对于 k 于 键(后) 循环
                    如果 非 包含(sk, k)
                        sk[k] = 后[k]
                        变化 = 真
                    否则
                        如果 sk[k] != 后[k]
                            sk[k] = "?"   # 冲突哨兵 -> 未知
                        结束
                    结束
                结束
            结束
        结束
    结束
    返回 fn
结束


# ============================================================
# 第 9 节：活跃性分析（逆向数据流）与可达性
# ============================================================

# 块级活跃变量分析，正确处理 SSA phi：
#   liveOut(b) = ∪_{后继s} (liveIn(s) - s的phi定义) ∪ {phi来自b边的实参}
#   liveIn(b)  = use(b) ∪ (liveOut(b) - def(b))
# 返回 {"进": [set], "出": [set]}
函数 活跃性(字典 fn) -> 字典
    整数 n = 长度(fn["块"])
    列表 进 = []
    列表 出 = []
    对于 i 从 0 到 n - 1 循环
        追加(进, {})
        追加(出, {})
    结束
    整数 守卫 = 0
    布尔 变化 = 真
    当 变化 且 守卫 < 200 循环
        变化 = 假
        守卫 = 守卫 + 1
        # 反向遍历
        对于 b 从 n - 1 到 0 步长 -1 循环
            字典 blk = fn["块"][b]

            # ---- liveOut ----
            字典 新出 = {}
            对于 j 从 0 到 长度(blk["后继"]) - 1 循环
                整数 s = blk["后继"][j]
                字典 succ = fn["块"][s]
                # liveIn[s] 去掉 s 中 phi 定义的变量
                对于 v 于 键(进[s]) 循环
                    布尔 是phi定义 = 假
                    对于 k 从 0 到 长度(succ["指令"]) - 1 循环
                        字典 ins = succ["指令"][k]
                        如果 ins["op"] == "phi" 且 ins["dest"] == v
                            是phi定义 = 真
                        结束
                    结束
                    如果 非 是phi定义
                        集加(新出, v)
                    结束
                结束
                # phi 中来自 b 这条边的实参
                整数 eidx = 找下标(succ["前驱"], b)
                如果 eidx != -1
                    对于 k 从 0 到 长度(succ["指令"]) - 1 循环
                        字典 ins = succ["指令"][k]
                        如果 ins["op"] != "phi"
                            继续
                        结束
                        如果 eidx < 长度(ins["实参"])
                            字符串 a = ins["实参"][eidx]
                            如果 a != ""
                                集加(新出, a)
                            结束
                        结束
                    结束
                结束
            结束

            # ---- liveIn = use ∪ (liveOut - def) ----
            字典 新进 = 浅复制(新出)
            # 终结符 use
            对于 j 从 0 到 长度(终结用(blk["终结"])) - 1 循环
                集加(新进, 终结用(blk["终结"])[j])
            结束
            # 反向扫指令
            对于 i 从 长度(blk["指令"]) - 1 到 0 步长 -1 循环
                字典 ins = blk["指令"][i]
                字符串 d = 指令定义(ins)
                如果 d != ""
                    删除键(新进, d)
                结束
                # phi 的 use 已在 liveOut 处理
                如果 ins["op"] != "phi"
                    对于 k 从 0 到 长度(指令用(ins)) - 1 循环
                        集加(新进, 指令用(ins)[k])
                    结束
                结束
            结束
            # 入口块：参数视为 liveIn
            如果 b == 0
                对于 k 从 0 到 长度(fn["参数"]) - 1 循环
                    集加(新进, fn["参数"][k])
                结束
            结束

            如果 非 集等(新出, 出[b])
                出[b] = 新出
                变化 = 真
            结束
            如果 非 集等(新进, 进[b])
                进[b] = 新进
                变化 = 真
            结束
        结束
    结束
    返回 {"进": 进, "出": 出}
结束

# 可达块分析：从入口 BFS，返回 set(str(bid))
函数 可达集(字典 fn) -> 字典
    字典 见 = {}
    列表 队 = [0]
    集加(见, "0")
    当 长度(队) > 0 循环
        整数 b = 弹出(队)
        对于 j 从 0 到 长度(fn["块"][b]["后继"]) - 1 循环
            整数 s = fn["块"][b]["后继"][j]
            如果 非 集有(见, 转字符串(s))
                集加(见, 转字符串(s))
                追加(队, s)
            结束
        结束
    结束
    返回 见
结束


# ============================================================
# 第 10 节：Pass 2 —— 死代码消除 (DCE)
# ============================================================
函数 死代码消除(字典 fn) -> 字典
    整数 外 = 0
    布尔 总变化 = 真
    当 总变化 且 外 < 30 循环
        总变化 = 假
        建CFG(fn)
        字典 lv = 活跃性(fn)

        对于 i 从 0 到 长度(fn["块"]) - 1 循环
            字典 blk = fn["块"][i]
            字典 活 = 浅复制(lv["出"][blk["id"]])
            # 加终结符 use
            对于 k 从 0 到 长度(终结用(blk["终结"])) - 1 循环
                集加(活, 终结用(blk["终结"])[k])
            结束
            列表 保留 = []
            # 反向遍历
            对于 j 从 长度(blk["指令"]) - 1 到 0 步长 -1 循环
                字典 ins = blk["指令"][j]
                字符串 d = 指令定义(ins)
                布尔 副作用 = 有副作用(ins)
                布尔 活? = 假
                如果 副作用
                    活? = 真
                否则
                    如果 d != "" 且 集有(活, d)
                        活? = 真
                    结束
                结束
                # phi 不能在这里删（SSA 结构需要）
                如果 ins["op"] == "phi"
                    活? = 真
                结束
                如果 活?
                    # 插到保留列表前面
                    列表 新 = [ins]
                    对于 q 从 0 到 长度(保留) - 1 循环
                        追加(新, 保留[q])
                    结束
                    保留 = 新
                    # 杀 def
                    如果 d != ""
                        删除键(活, d)
                    结束
                    # 加 use
                    对于 k 从 0 到 长度(指令用(ins)) - 1 循环
                        集加(活, 指令用(ins)[k])
                    结束
                结束
            结束
            如果 长度(保留) != 长度(blk["指令"])
                总变化 = 真
            结束
            blk["指令"] = 保留
        结束

        # 不可达块删除
        字典 见 = 可达集(fn)
        对于 b 从 0 到 长度(fn["块"]) - 1 循环
            如果 非 集有(见, 转字符串(b))
                fn["块"][b]["指令"] = []
                fn["块"][b]["终结"] = 不可达终结()
                总变化 = 真
            结束
        结束
        如果 总变化
            建CFG(fn)
        结束
        外 = 外 + 1
    结束
    返回 fn
结束


# ============================================================
# 第 11 节：Pass 3 —— 公共子表达式消除 (CSE)
# ============================================================

# 表达式指纹：op(left,right)；交换律规范化操作数顺序
函数 表达式指纹(字典 ins) -> 字符串
    字符串 op = ins["op"]
    如果 是二元(op)
        如果 op == "add" 或 op == "mul" 或 op == "and" 或 op == "or" 或 op == "eq" 或 op == "ne"
            字符串 l = ins["左"]
            字符串 r = ins["右"]
            如果 l <= r
                返回 op + "(" + l + "," + r + ")"
            结束
            返回 op + "(" + r + "," + l + ")"
        结束
        返回 op + "(" + ins["左"] + "," + ins["右"] + ")"
    结束
    如果 op == "neg" 或 op == "not"
        返回 op + "(" + ins["src"] + ")"
    结束
    返回 ""
结束

# 局部 CSE：同一块内重复计算替换为 mov
函数 公共子表达式消除(字典 fn) -> 字典
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        字典 可用 = {}   # 指纹 -> 结果变量名
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            如果 ins["op"] == "phi"
                继续
            结束
            字符串 指纹 = 表达式指纹(ins)
            如果 指纹 != "" 且 包含(可用, 指纹)
                字符串 已有 = 可用[指纹]
                如果 已有 != ins["dest"]
                    blk["指令"][i] = 移动指令(ins["dest"], 已有)
                结束
                继续
            结束
            # 本指令定义的变量失效：清掉用到它的表达式
            字符串 d = 指令定义(ins)
            如果 d != ""
                字典 新可用 = {}
                对于 k 于 键(可用) 循环
                    如果 非 包含(k, "(" + d) 且 非 包含(k, "," + d + ")")
                        新可用[k] = 可用[k]
                    结束
                结束
                可用 = 新可用
            结束
            # 有副作用：保守清空
            如果 有副作用(ins)
                可用 = {}
            结束
            如果 指纹 != ""
                可用[指纹] = ins["dest"]
            结束
        结束
    结束
    返回 fn
结束


# ============================================================
# 第 12 节：Pass 4 —— 复制传播
# ============================================================
# SSA 下每个 dest 唯一定义。建立 dest->src 别名图，求传递闭包，
# 把所有 use 替换为最终代表元。
函数 复制传播(字典 fn) -> 字典
    字典 别名 = {}
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            如果 ins["op"] == "mov"
                别名[ins["dest"]] = ins["src"]
            结束
        结束
    结束

    # 传递闭包（带环保护）
    函数 解析(字符串 v) -> 字符串
        字典 见过 = {}
        当 包含(别名, v) 且 非 集有(见过, v) 循环
            集加(见过, v)
            v = 别名[v]
        结束
        返回 v
    结束

    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            字符串 op = ins["op"]
            如果 op == "mov"
                # 复制本身不动
                如果 别名[ins["dest"]] == ins["src"]
                    继续
                结束
                ins["src"] = 解析(ins["src"])
            否则 如果 op == "neg" 或 op == "not"
                ins["src"] = 解析(ins["src"])
            否则 如果 op == "call"
                对于 k 从 0 到 长度(ins["实参"]) - 1 循环
                    ins["实参"][k] = 解析(ins["实参"][k])
                结束
            否则 如果 op == "phi"
                对于 k 从 0 到 长度(ins["实参"]) - 1 循环
                    ins["实参"][k] = 解析(ins["实参"][k])
                结束
            否则 如果 op == "const"
                # 常量值不变
            否则
                ins["左"] = 解析(ins["左"])
                ins["右"] = 解析(ins["右"])
            结束
        结束
        # 终结符
        字典 t = blk["终结"]
        如果 t["种类"] == "分支"
            t["条件"] = 解析(t["条件"])
        否则 如果 t["种类"] == "返回" 且 t["值"] != ""
            t["值"] = 解析(t["值"])
        结束
    结束
    返回 fn
结束


# ============================================================
# 第 13 节：Pass 5 & 6 —— 循环识别 / 不变量外提 / 强度削减
# ============================================================

# 收集函数里所有定义过的变量名集合
函数 全部定义(字典 fn) -> 字典
    字典 s = {}
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字符串 d = 指令定义(blk["指令"][i])
            如果 d != ""
                集加(s, d)
            结束
        结束
    结束
    返回 s
结束

# 计算循环体：从 tail 沿前驱反向收集所有能到达 header 的块
函数 算循环体(字典 fn, 整数 header, 整数 tail) -> 字典
    字典 体 = {}
    集加(体, 转字符串(header))
    列表 栈 = [tail]
    当 长度(栈) > 0 循环
        整数 b = 弹出(栈)
        如果 集有(体, 转字符串(b))
            继续
        结束
        集加(体, 转字符串(b))
        对于 j 从 0 到 长度(fn["块"][b]["前驱"]) - 1 循环
            追加(栈, fn["块"][b]["前驱"][j])
        结束
    结束
    返回 体
结束

# 找自然循环：回边 b->h 且 h 支配 b
函数 找自然循环(字典 fn, 字典 dom) -> 列表
    列表 循环表 = []
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        整数 b = fn["块"][bi]["id"]
        对于 j 从 0 到 长度(fn["块"][b]["后继"]) - 1 循环
            整数 h = fn["块"][b]["后继"][j]
            # h 支配 b  => 回边 b->h
            如果 支配(dom["idom"], h, b)
                字典 体 = 算循环体(fn, h, b)
                追加(循环表, {"头": h, "尾": b, "体": 体})
            结束
        结束
    结束
    返回 循环表
结束

# 判断一条指令是否循环不变量（操作数都在循环外定义）
函数 是循环不变量(字典 ins, 字典 体外定义) -> 布尔
    字符串 op = ins["op"]
    如果 op == "call" 或 op == "store" 或 op == "load"
        返回 假
    结束
    如果 op == "const"
        返回 真
    结束
    如果 op == "mov" 或 op == "neg" 或 op == "not"
        返回 集有(体外定义, ins["src"])
    结束
    如果 是二元(op)
        返回 集有(体外定义, ins["左"]) 且 集有(体外定义, ins["右"])
    结束
    返回 假
结束

# 循环不变量外提：把循环体内不变表达式提到前置块
函数 外提不变量(字典 fn, 字典 环) -> 字典
    整数 头 = 环["头"]
    字典 体 = 环["体"]
    # 收集循环体内定义的变量
    字典 体内 = {}
    对于 s 于 键(体) 循环
        整数 bid = 转整数(s)
        对于 i 从 0 到 长度(fn["块"][bid]["指令"]) - 1 循环
            字符串 d = 指令定义(fn["块"][bid]["指令"][i])
            如果 d != ""
                集加(体内, d)
            结束
        结束
    结束
    # 循环外定义 = 全部定义 - 体内定义
    字典 体外 = {}
    字典 全部 = 全部定义(fn)
    对于 v 于 键(全部) 循环
        如果 非 集有(体内, v)
            集加(体外, v)
        结束
    结束
    # 参数视为循环外
    对于 k 从 0 到 长度(fn["参数"]) - 1 循环
        集加(体外, fn["参数"][k])
    结束

    # 找前置块：header 的唯一不在循环体内的前驱
    列表 前置候选 = []
    对于 j 从 0 到 长度(fn["块"][头]["前驱"]) - 1 循环
        整数 p = fn["块"][头]["前驱"][j]
        如果 非 集有(体, 转字符串(p))
            追加(前置候选, p)
        结束
    结束
    如果 长度(前置候选) != 1
        返回 fn   # 没有唯一前置块，跳过
    结束
    整数 前置 = 前置候选[0]

    # 迭代外提
    布尔 变化 = 真
    当 变化 循环
        变化 = 假
        对于 s 于 键(体) 循环
            整数 bid = 转整数(s)
            字典 blk = fn["块"][bid]
            列表 剩余 = []
            对于 i 从 0 到 长度(blk["指令"]) - 1 循环
                字典 ins = blk["指令"][i]
                如果 ins["op"] == "phi"
                    继续
                结束
                如果 是循环不变量(ins, 体外)
                    # 外提到前置块末尾
                    追加(fn["块"][前置]["指令"], ins)
                    变化 = 真
                    字符串 d = 指令定义(ins)
                    如果 d != ""
                        集加(体外, d)
                        删除键(体内, d)
                    结束
                否则
                    追加(剩余, ins)
                结束
            结束
            blk["指令"] = 剩余
        结束
    结束
    返回 fn
结束

# 判断字符串是否为整数字面量
函数 是整数字面量(字符串 s) -> 布尔
    如果 长度(s) == 0
        返回 假
    结束
    对于 i 从 0 到 长度(s) - 1 循环
        字符串 c = s[i]
        如果 非 (c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9" 或 c == "-")
            返回 假
        结束
    结束
    返回 真
结束

# 强度削减：循环里找 i = i + step, 且 t = i * k；
# 把 t 改为 t = t + step*k（在 header 用 phi 初始化）。
函数 强度削减(字典 fn, 字典 环) -> 字典
    整数 头 = 环["头"]
    整数 尾 = 环["尾"]
    字典 体 = 环["体"]
    字典 头块 = fn["块"][头]
    # 找前置块
    整数 前置 = -1
    对于 j 从 0 到 长度(头块["前驱"]) - 1 循环
        整数 p = 头块["前驱"][j]
        如果 非 集有(体, 转字符串(p))
            前置 = p
        结束
    结束
    如果 前置 == -1
        返回 fn
    结束

    # 遍历 header 的 phi，找归纳变量 i
    对于 pi 从 0 到 长度(头块["指令"]) - 1 循环
        字典 phi = 头块["指令"][pi]
        如果 phi["op"] != "phi"
            继续
        结束
        字符串 iv = phi["dest"]
        # 在循环体找 iv = iv + c
        整数 step = 0
        布尔 有步 = 假
        对于 s 于 键(体) 循环
            整数 bid = 转整数(s)
            对于 i 从 0 到 长度(fn["块"][bid]["指令"]) - 1 循环
                字典 ins = fn["块"][bid]["指令"][i]
                如果 ins["op"] == "add" 且 (ins["左"] == iv 或 ins["右"] == iv)
                    字符串 另 = ins["右"]
                    如果 ins["左"] == iv
                        另 = ins["右"]
                    否则
                        另 = ins["左"]
                    结束
                    如果 是整数字面量(另)
                        step = 转整数(另)
                        有步 = 真
                    结束
                结束
            结束
        结束
        如果 非 有步 或 step == 0
            继续
        结束
        # 在循环体找 t = iv * k
        对于 s 于 键(体) 循环
            整数 bid = 转整数(s)
            对于 i 从 0 到 长度(fn["块"][bid]["指令"]) - 1 循环
                字典 ins = fn["块"][bid]["指令"][i]
                如果 ins["op"] == "mul" 且 (ins["左"] == iv 或 ins["右"] == iv)
                    字符串 k = ins["右"]
                    如果 ins["左"] == iv
                        k = ins["右"]
                    否则
                        k = ins["左"]
                    结束
                    如果 非 是整数字面量(k)
                        继续
                    结束
                    整数 kk = 转整数(k)
                    字符串 t = ins["dest"]
                    字符串 sr名 = "sr#" + t
                    字符串 next名 = sr名 + "#next"
                    # 前置块：t_init = 0
                    追加(fn["块"][前置]["指令"], 常量指令(sr名, 0))
                    # header：phi sr_t = (t_init, next)
                    追加(头块["指令"], 费指令(sr名, [前置, 尾], [sr名, next名]))
                    # 尾块：const step*k ; next = sr_t + step*k
                    字符串 增量名 = next名 + "#k"
                    追加(fn["块"][尾]["指令"], 常量指令(增量名, step * kk))
                    追加(fn["块"][尾]["指令"], 二元指令("add", next名, sr名, 增量名))
                    # 删除原 mul
                    列表 剩余 = []
                    对于 q 从 0 到 长度(fn["块"][bid]["指令"]) - 1 循环
                        如果 fn["块"][bid]["指令"][q] != ins
                            追加(剩余, fn["块"][bid]["指令"][q])
                        结束
                    结束
                    fn["块"][bid]["指令"] = 剩余
                结束
            结束
        结束
    结束
    返回 fn
结束

# 循环优化入口
函数 循环优化(字典 fn) -> 字典
    建CFG(fn)
    字典 dom = 算支配(fn)
    列表 循环表 = 找自然循环(fn, dom)
    对于 i 从 0 到 长度(循环表) - 1 循环
        外提不变量(fn, 循环表[i])
    结束
    # 外提后重新建 CFG / 支配，再做强度削减
    建CFG(fn)
    字典 dom2 = 算支配(fn)
    列表 循环表2 = 找自然循环(fn, dom2)
    对于 i 从 0 到 长度(循环表2) - 1 循环
        强度削减(fn, 循环表2[i])
    结束
    建CFG(fn)
    返回 fn
结束


# ============================================================
# 第 14 节：寄存器分配 —— 活跃区间 + 干涉图 + Chaitin-Briggs 着色
# ============================================================

# x86-64 可分配整数寄存器（排除 rsp/rbp）
函数 整数寄存器表() -> 列表
    返回 ["rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11", "rbx", "r12", "r13", "r14"]
结束

# x86-64 可分配浮点寄存器
函数 浮点寄存器表() -> 列表
    返回 ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14"]
结束

# 计算每个变量的活跃区间 [开始, 结束]（按全局指令序号）
# 返回区间列表，每项 {"v":名, "开始":int, "结束":int}
函数 算活跃区间(字典 fn) -> 列表
    字典 区间 = {}   # v -> {"v":, "开始":, "结束":}
    整数 号 = 0
    # 参数从 0 开始活跃
    对于 i 从 0 到 长度(fn["参数"]) - 1 循环
        字符串 p = fn["参数"][i]
        区间[p] = {"v": p, "开始": 0, "结束": 0}
    结束
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            字符串 d = 指令定义(ins)
            如果 d != ""
                如果 非 包含(区间, d)
                    区间[d] = {"v": d, "开始": 号, "结束": 号}
                结束
                如果 号 < 区间[d]["开始"]
                    区间[d]["开始"] = 号
                结束
            结束
            对于 k 从 0 到 长度(指令用(ins)) - 1 循环
                字符串 u = 指令用(ins)[k]
                如果 非 包含(区间, u)
                    区间[u] = {"v": u, "开始": 号, "结束": 号}
                结束
                区间[u]["结束"] = 号
            结束
            号 = 号 + 1
        结束
        # 终结符 use 记到块尾
        对于 k 从 0 到 长度(终结用(blk["终结"])) - 1 循环
            字符串 u = 终结用(blk["终结"])[k]
            如果 非 包含(区间, u)
                区间[u] = {"v": u, "开始": 号, "结束": 号}
            结束
            区间[u]["结束"] = 号
        结束
    结束
    列表 表 = []
    对于 v 于 键(区间) 循环
        追加(表, 区间[v])
    结束
    返回 表
结束

# 两区间是否干涉（半开重叠）
函数 区间干涉(字典 a, 字典 b) -> 布尔
    如果 a["v"] == b["v"]
        返回 假
    结束
    返回 a["开始"] <= b["结束"] 且 b["开始"] <= a["结束"]
结束

# Chaitin-Briggs 图着色
# 区间: 区间列表；k: 可用寄存器数；移动: [[dst,src],...]
# 返回 {"颜色": dict(v->int), "溢出": set(v), "邻接": dict(v->set(v))}
函数 图着色(列表 区间, 整数 k, 列表 移动) -> 字典
    字典 邻接 = {}
    对于 i 从 0 到 长度(区间) - 1 循环
        邻接[区间[i]["v"]] = {}
    结束
    # 建边
    对于 i 从 0 到 长度(区间) - 1 循环
        对于 j 从 i + 1 到 长度(区间) - 1 循环
            如果 区间干涉(区间[i], 区间[j])
                集加(邻接[区间[i]["v"]], 区间[j]["v"])
                集加(邻接[区间[j]["v"]], 区间[i]["v"])
            结束
        结束
    结束
    # 合并候选
    字典 合并 = {}
    对于 i 从 0 到 长度(移动) - 1 循环
        字符串 dst = 移动[i][0]
        字符串 src = 移动[i][1]
        如果 包含(邻接, dst) 且 包含(邻接, src) 且 非 集有(邻接[dst], src)
            合并[dst] = src
        结束
    结束

    字典 已删 = {}
    列表 栈 = []

    # 简化阶段
    布尔 变化 = 真
    当 变化 循环
        变化 = 假
        # 1) 合并：未删的 mov 对直接合并
        对于 a 于 键(合并) 循环
            字符串 b = 合并[a]
            如果 非 集有(已删, a) 且 非 集有(已删, b)
                集加(已删, a)
                追加(栈, a)
                变化 = 真
            结束
        结束
        # 2) 度数 < k 的节点压栈
        对于 i 从 0 到 长度(区间) - 1 循环
            字符串 v = 区间[i]["v"]
            如果 集有(已删, v)
                继续
            结束
            如果 长度(邻接[v]) < k
                集加(已删, v)
                追加(栈, v)
                变化 = 真
            结束
        结束
        # 3) 还有度数>=k 的：选一个溢出候选（这里选度数最大者）
        如果 非 变化
            字典 候选 = {}
            对于 i 从 0 到 长度(区间) - 1 循环
                字符串 v = 区间[i]["v"]
                如果 非 集有(已删, v)
                    候选[v] = 1
                结束
            结束
            如果 长度(候选) > 0
                # 选度数最大
                字符串 最优 = ""
                整数 最优度 = -1
                对于 v 于 键(候选) 循环
                    整数 d = 长度(邻接[v])
                    如果 d > 最优度
                        最优度 = d
                        最优 = v
                    结束
                结束
                集加(已删, 最优)
                追加(栈, 最优)
                变化 = 真
            结束
        结束
    结束

    # 选择阶段：弹出栈，着色
    字典 颜色 = {}
    字典 溢出 = {}
    当 长度(栈) > 0 循环
        字符串 v = 弹出(栈)
        字典 已用 = {}
        对于 n 于 键(邻接[v]) 循环
            如果 包含(颜色, n)
                集加(已用, 转字符串(颜色[n]))
            结束
        结束
        整数 c = 0
        当 集有(已用, 转字符串(c)) 循环
            c = c + 1
        结束
        如果 c < k
            颜色[v] = c
        否则
            集加(溢出, v)
        结束
        # 合并目标：若 v 被合并进某个已着色者，继承其颜色
        如果 包含(合并, v) 且 包含(颜色, 合并[v])
            颜色[v] = 颜色[合并[v]]
            删除键(溢出, v)
        结束
    结束
    返回 {"颜色": 颜色, "溢出": 溢出, "邻接": 邻接}
结束

# 函数级寄存器分配入口
# 返回 {"映射": dict(v->寄存器名), "溢出": [v], "颜色":dict(v->int),
#        "整数寄存器":[...], "浮点寄存器":[...]}
函数 分配寄存器(字典 fn, 整数 整数数, 整数 浮点数) -> 字典
    建CFG(fn)
    列表 区间 = 算活跃区间(fn)
    # 收集 mov 指令
    列表 移动 = []
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            如果 blk["指令"][i]["op"] == "mov"
                追加(移动, [blk["指令"][i]["dest"], blk["指令"][i]["src"]])
            结束
        结束
    结束
    字典 着色 = 图着色(区间, 整数数, 移动)
    列表 寄存器 = 整数寄存器表()
    字典 映射 = {}
    对于 v 于 键(着色["颜色"]) 循环
        整数 c = 着色["颜色"][v]
        如果 c < 长度(寄存器)
            映射[v] = 寄存器[c]
        否则
            映射[v] = "栈_" + v
        结束
    结束
    列表 溢出表 = []
    对于 v 于 键(着色["溢出"]) 循环
        映射[v] = "栈_" + v
        追加(溢出表, v)
    结束
    返回 {"映射": 映射, "溢出": 溢出表, "颜色": 着色["颜色"], "整数寄存器": 寄存器, "浮点寄存器": 浮点寄存器表()}
结束


# ============================================================
# 第 15 节：窥孔优化
# ============================================================
#  - 冗余 mov 消除：mov x, x 删除
#  - const x, 0：标记 useXor（后端用 xor x,x）
#  - 连续 mov 链折叠：mov x,y 且前一条 mov y,z -> mov x,z
#  - mov x,y 且前一条 const y=c -> const x=c
函数 窥孔优化(字典 fn) -> 字典
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        列表 出 = []
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            字典 ins = blk["指令"][i]
            # mov x, x 冗余删除
            如果 ins["op"] == "mov" 且 ins["dest"] == ins["src"]
                继续
            结束
            # const 0 标记可用 xor
            如果 ins["op"] == "const" 且 (ins["值"] == 0)
                ins["用异或"] = 真
            结束
            # mov 链折叠
            如果 ins["op"] == "mov" 且 长度(出) > 0
                字典 前 = 出[长度(出) - 1]
                如果 前["op"] == "mov" 且 前["dest"] == ins["src"]
                    ins["src"] = 前["src"]
                否则 如果 前["op"] == "const" 且 前["dest"] == ins["src"]
                    字典 折 = 常量指令(ins["dest"], 前["值"])
                    追加(出, 折)
                    继续
                结束
            结束
            追加(出, ins)
        结束
        blk["指令"] = 出
    结束
    返回 fn
结束


# ============================================================
# 第 16 节：基本块内指令调度（列表调度）
# ============================================================
# 保持 phi 在块首；对块体按数据依赖 + 关键路径高度重排。
函数 调度块(字典 blk)
    列表 菲 = []
    列表 体 = []
    对于 i 从 0 到 长度(blk["指令"]) - 1 循环
        如果 blk["指令"][i]["op"] == "phi"
            追加(菲, blk["指令"][i])
        否则
            追加(体, blk["指令"][i])
        结束
    结束
    如果 长度(体) <= 1
        blk["指令"] = 菲 + 体
        返回
    结束
    # defPos: 定义的变量 -> 在体中的下标
    字典 def位 = {}
    对于 i 从 0 到 长度(体) - 1 循环
        字符串 d = 指令定义(体[i])
        如果 d != ""
            def位[d] = i
        结束
    结束
    # 依赖表：依赖[i] = set(j)，体[i] 依赖体[j]
    列表 依赖 = []
    列表 被依赖 = []
    对于 i 从 0 到 长度(体) - 1 循环
        追加(依赖, {})
        追加(被依赖, {})
    结束
    对于 i 从 0 到 长度(体) - 1 循环
        对于 k 从 0 到 长度(指令用(体[i])) - 1 循环
            字符串 u = 指令用(体[i])[k]
            如果 包含(def位, u)
                整数 j = def位[u]
                如果 j != i
                    集加(依赖[i], 转字符串(j))
                    集加(被依赖[j], 转字符串(i))
                结束
            结束
        结束
    结束
    # 反向高度：关键路径长度
    列表 高度 = []
    对于 i 从 0 到 长度(体) - 1 循环
        追加(高度, 0)
    结束
    对于 i 从 长度(体) - 1 到 0 步长 -1 循环
        整数 最大 = 0
        对于 d 于 键(被依赖[i]) 循环
            如果 高度[转整数(d)] > 最大
                最大 = 高度[转整数(d)]
            结束
        结束
        高度[i] = 最大 + 1
    结束
    # 列表调度
    列表 已排 = []
    字典 已排见 = {}
    列表 余依赖 = []
    对于 i 从 0 到 长度(体) - 1 循环
        字典 拷贝 = {}
        对于 k 于 键(依赖[i]) 循环
            拷贝[k] = 1
        结束
        追加(余依赖, 拷贝)
    结束
    当 长度(已排) < 长度(体) 循环
        整数 最优选 = -1
        整数 最高 = -1
        对于 i 从 0 到 长度(体) - 1 循环
            如果 集有(已排见, 转字符串(i))
                继续
            结束
            如果 长度(余依赖[i]) == 0
                如果 高度[i] > 最高
                    最高 = 高度[i]
                    最优选 = i
                结束
            结束
        结束
        如果 最优选 == -1
            # 有环（不应出现），按原顺序补
            对于 i 从 0 到 长度(体) - 1 循环
                如果 非 集有(已排见, 转字符串(i))
                    最优选 = i
                    跳出
                结束
            结束
        结束
        追加(已排, 体[最优选])
        集加(已排见, 转字符串(最优选))
        # 从依赖它的指令的余依赖里删除
        对于 d 于 键(被依赖[最优选]) 循环
            删除键(余依赖[转整数(d)], 转字符串(最优选))
        结束
    结束
    # 拼回：phi + 调度后体
    列表 结果 = []
    对于 i 从 0 到 长度(菲) - 1 循环
        追加(结果, 菲[i])
    结束
    对于 i 从 0 到 长度(已排) - 1 循环
        追加(结果, 已排[i])
    结束
    blk["指令"] = 结果
结束

# 函数级调度
函数 调度函数(字典 fn)
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        调度块(fn["块"][bi])
    结束
结束


# ============================================================
# 第 17 节：打印辅助与优化流水线入口
# ============================================================

# 一条指令转可读字符串
函数 指令文本(字典 ins) -> 字符串
    字符串 op = ins["op"]
    如果 op == "const"
        返回 "  " + ins["dest"] + " = " + 转字符串(ins["值"])
    结束
    如果 op == "mov"
        返回 "  " + ins["dest"] + " = " + ins["src"]
    结束
    如果 op == "phi"
        字符串 参 = ""
        对于 k 从 0 到 长度(ins["实参"]) - 1 循环
            如果 k > 0
                参 = 参 + ", "
            结束
            参 = 参 + ins["实参"][k]
        结束
        返回 "  " + ins["dest"] + " = phi(" + 参 + ")"
    结束
    如果 op == "call"
        返回 "  " + ins["dest"] + " = call " + ins["名"]
    结束
    如果 op == "neg" 或 op == "not"
        返回 "  " + ins["dest"] + " = " + op + " " + ins["src"]
    结束
    返回 "  " + ins["dest"] + " = " + ins["左"] + " " + op + " " + ins["右"]
结束

# 打印整个函数（调试用）
函数 打印函数(字典 fn)
    输出 "===== 函数 " + fn["名字"] + " ====="
    对于 bi 从 0 到 长度(fn["块"]) - 1 循环
        字典 blk = fn["块"][bi]
        输出 "L" + 转字符串(blk["id"]) + ":"
        对于 i 从 0 到 长度(blk["指令"]) - 1 循环
            输出 指令文本(blk["指令"][i])
        结束
        字典 t = blk["终结"]
        如果 t["种类"] == "跳转"
           输出 "  -> L" + 转字符串(t["目标"])
        否则 如果 t["种类"] == "分支"
            输出 "  if " + t["条件"] + " L" + 转字符串(t["是"]) + " else L" + 转字符串(t["否"])
        否则 如果 t["种类"] == "返回"
            输出 "  ret " + t["值"]
        否则
            输出 "  unreachable"
        结束
    结束
结束

# 完整优化流水线（对单个函数）：
#   CFG -> SSA -> 常量传播 -> DCE -> CSE -> 复制传播 -> DCE ->
#   循环优化 -> 销SSA -> 寄存器分配 -> 调度 -> 窥孔
# 返回 {"fn":fn, "分配":分配结果}
函数 优化函数(字典 fn) -> 字典
    建CFG(fn)
    转SSA(fn)
    常量传播(fn)
    死代码消除(fn)
    公共子表达式消除(fn)
    复制传播(fn)
    死代码消除(fn)
    循环优化(fn)
    销SSA(fn)
    字典 分配 = 分配寄存器(fn, 13, 15)
    调度函数(fn)
    窥孔优化(fn)
    返回 {"fn": fn, "分配": 分配}
结束
