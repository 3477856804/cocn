# ============================================================
# 测试机器码.co —— 直接机器码生成端到端测试
#
# 流程（每个用例）：
#   1. 解析 coCN 源码（词法 + 语法）
#   2. 编译到 ELF64 字节表
#   3. 字节表 -> hex 文本 -> 写入 /tmp/t.hex
#   4. shell: xxd -r -p 还原为 ELF，chmod +x
#   5. 运行 ELF，捕获 stdout
#   6. 与期望输出比对，打印 通过/失败
#
# 拼接顺序：词法分析器.co + 语法分析器.co + elf.co + 机器码生成器.co + 本文件
# ============================================================

让 HEX表 = "0123456789abcdef"

# 字节表 -> hex 字符串
函数 字节转hex(列表 字节) -> 字符串
    字符串 s = ""
    对于 i 从 0 到 长度(字节) - 1 循环
        整数 b = 字节[i] & 255
        s = s + HEX表[b >> 4] + HEX表[b & 15]
    结束
    返回 s
结束

# 跑一个测试：源码字符串 -> 返回 ELF 的 stdout
函数 跑用例(字符串 源码, 字符串 标签) -> 字符串
    字典 ast = 解析源(源码)
    列表 elf = 编译到ELF(ast)
    字符串 十六 = 字节转hex(elf)
    写入文件("/tmp/tc_" + 标签 + ".hex", 十六)
    执行命令("xxd -r -p /tmp/tc_" + 标签 + ".hex > /tmp/tc_" + 标签 + ".elf && chmod +x /tmp/tc_" + 标签 + ".elf")
    字符串 out = 执行命令("/tmp/tc_" + 标签 + ".elf")
    返回 out
结束

# ---------------- 测试用例源码 ----------------

# 用例1：Hello World
让 源1 = "输出 \"Hello, World!\"\n"

# 用例2：算术 3 + 4*2 = 11
让 源2 = "让 a = 3\n让 b = 4\n输出 a + b * 2\n"

# 用例3：循环累加 1..10 = 55
让 源3 = "让 s = 0\n对于 i 从 1 到 10 循环\n    s = s + i\n结束\n输出 s\n"

# 用例4：斐波那契 fib(10) = 55
让 源4 = "函数 fib(整数 n) -> 整数\n    如果 n < 2 则\n        返回 n\n    结束\n    返回 fib(n - 1) + fib(n - 2)\n结束\n输出 fib(10)\n"

# 用例5：阶乘 fac(5) = 120
让 源5 = "函数 fac(整数 n) -> 整数\n    如果 n <= 1 则\n        返回 1\n    结束\n    返回 n * fac(n - 1)\n结束\n输出 fac(5)\n"

# ---------------- 执行 ----------------
输出("=== 直接机器码生成测试 ===")

字符串 o1 = 跑用例(源1, "t1")
输出("[1] Hello: [" + o1 + "] 期望 [Hello, World!]")

字符串 o2 = 跑用例(源2, "t2")
输出("[2] 算术: [" + o2 + "] 期望 [11]")

字符串 o3 = 跑用例(源3, "t3")
输出("[3] 循环累加: [" + o3 + "] 期望 [55]")

字符串 o4 = 跑用例(源4, "t4")
输出("[4] 斐波那契: [" + o4 + "] 期望 [55]")

字符串 o5 = 跑用例(源5, "t5")
输出("[5] 阶乘: [" + o5 + "] 期望 [120]")

输出("=== 测试完成 ===")
