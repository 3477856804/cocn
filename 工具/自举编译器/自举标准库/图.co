# ============================================================
# 图.co —— 自举标准库：图算法库
# 包含：邻接表表示、BFS、DFS、Dijkstra、Floyd-Warshall、
#       Prim最小生成树、拓扑排序
# ============================================================

# 注意：字典键必须是字符串，图节点ID在字典中以字符串形式存储

# ---------------- 图的表示（邻接表） ----------------
函数 图新建() -> 字典
    返回 {}
结束

函数 图加节点(字典 图, 整数 节点)
    字符串 键 = 转字符串(节点)
    如果 包含(图, 键) == 0 则
        图[键] = []
    结束
结束

函数 图加边(字典 图, 整数 起点, 整数 终点, 整数 权重)
    图加节点(图, 起点)
    图加节点(图, 终点)
    字符串 键 = 转字符串(起点)
    追加(图[键], [终点, 权重])
结束

# ---------------- BFS 广度优先搜索 ----------------
函数 BFS(字典 图, 整数 起点) -> 列表
    列表 访问顺序 = []
    字典 已访问 = {}
    列表 队列 = [起点]
    已访问[转字符串(起点)] = 1
    当 长度(队列) > 0 循环
        整数 节点 = 队列[0]
        # 出队
        列表 新队列 = []
        对于 i 从 1 到 长度(队列) - 1 循环
            追加(新队列, 队列[i])
        结束
        队列 = 新队列
        追加(访问顺序, 节点)
        # 遍历邻居
        字符串 节点键 = 转字符串(节点)
        如果 包含(图, 节点键) 则
            列表 邻居表 = 图[节点键]
            对于 i 从 0 到 长度(邻居表) - 1 循环
                整数 邻居 = 邻居表[i][0]
                字符串 邻居键 = 转字符串(邻居)
                如果 包含(已访问, 邻居键) == 0 则
                    已访问[邻居键] = 1
                    追加(队列, 邻居)
                结束
            结束
        结束
    结束
    返回 访问顺序
结束

# ---------------- DFS 深度优先搜索 ----------------
函数 DFS递归(字典 图, 整数 节点, 字典 已访问, 列表 结果)
    已访问[转字符串(节点)] = 1
    追加(结果, 节点)
    字符串 节点键 = 转字符串(节点)
    如果 包含(图, 节点键) 则
        列表 邻居表 = 图[节点键]
        对于 i 从 0 到 长度(邻居表) - 1 循环
            整数 邻居 = 邻居表[i][0]
            如果 包含(已访问, 转字符串(邻居)) == 0 则
                DFS递归(图, 邻居, 已访问, 结果)
            结束
        结束
    结束
结束

函数 DFS(字典 图, 整数 起点) -> 列表
    字典 已访问 = {}
    列表 结果 = []
    DFS递归(图, 起点, 已访问, 结果)
    返回 结果
结束

# ---------------- Dijkstra 最短路径 ----------------
函数 迪杰斯特拉(字典 图, 整数 起点, 整数 节点数) -> 列表
    列表 距离 = []
    对于 i 从 0 到 节点数 - 1 循环
        追加(距离, 999999)
    结束
    距离[起点] = 0
    字典 已确定 = {}

    对于 迭代 从 0 到 节点数 - 1 循环
        整数 最近 = -1
        整数 最小距离 = 999999
        对于 i 从 0 到 节点数 - 1 循环
            如果 包含(已确定, 转字符串(i)) == 0 且 距离[i] < 最小距离 则
                最小距离 = 距离[i]
                最近 = i
            结束
        结束
        如果 最近 == -1 则
            跳出
        结束
        已确定[转字符串(最近)] = 1
        # 松弛邻居
        字符串 最近键 = 转字符串(最近)
        如果 包含(图, 最近键) 则
            列表 邻居表 = 图[最近键]
            对于 i 从 0 到 长度(邻居表) - 1 循环
                整数 邻居 = 邻居表[i][0]
                整数 权重 = 邻居表[i][1]
                如果 距离[最近] + 权重 < 距离[邻居] 则
                    距离[邻居] = 距离[最近] + 权重
                结束
            结束
        结束
    结束
    返回 距离
结束

# ---------------- Floyd-Warshall 全源最短路径 ----------------
函数 弗洛伊德(列表 邻接矩阵, 整数 n) -> 列表
    列表 距离 = []
    对于 i 从 0 到 n - 1 循环
        列表 行 = []
        对于 j 从 0 到 n - 1 循环
            追加(行, 邻接矩阵[i][j])
        结束
        追加(距离, 行)
    结束
    对于 k 从 0 到 n - 1 循环
        对于 i 从 0 到 n - 1 循环
            对于 j 从 0 到 n - 1 循环
                如果 距离[i][k] + 距离[k][j] < 距离[i][j] 则
                    距离[i][j] = 距离[i][k] + 距离[k][j]
                结束
            结束
        结束
    结束
    返回 距离
结束

# ---------------- Prim 最小生成树 ----------------
函数 普里姆(列表 邻接矩阵, 整数 n) -> 整数
    列表 键 = []
    列表 包含在MST = []
    对于 i 从 0 到 n - 1 循环
        追加(键, 999999)
        追加(包含在MST, 0)
    结束
    键[0] = 0
    整数 总权重 = 0

    对于 计数 从 0 到 n - 1 循环
        整数 u = -1
        整数 最小 = 999999
        对于 i 从 0 到 n - 1 循环
            如果 包含在MST[i] == 0 且 键[i] < 最小 则
                最小 = 键[i]
                u = i
            结束
        结束
        如果 u == -1 则
            跳出
        结束
        包含在MST[u] = 1
        总权重 = 总权重 + 键[u]
        对于 v 从 0 到 n - 1 循环
            如果 邻接矩阵[u][v] > 0 且 包含在MST[v] == 0 且 邻接矩阵[u][v] < 键[v] 则
                键[v] = 邻接矩阵[u][v]
            结束
        结束
    结束
    返回 总权重
结束

# ---------------- 拓扑排序（Kahn算法） ----------------
函数 拓扑排序(字典 图, 整数 节点数) -> 列表
    列表 入度 = []
    对于 i 从 0 到 节点数 - 1 循环
        追加(入度, 0)
    结束
    # 计算入度
    对于 节点键 在 图 循环
        列表 邻居表 = 图[节点键]
        对于 i 从 0 到 长度(邻居表) - 1 循环
            整数 邻居 = 邻居表[i][0]
            入度[邻居] = 入度[邻居] + 1
        结束
    结束
    # 入度为0的入队
    列表 队列 = []
    对于 i 从 0 到 节点数 - 1 循环
        如果 入度[i] == 0 则
            追加(队列, i)
        结束
    结束
    列表 结果 = []
    当 长度(队列) > 0 循环
        整数 u = 队列[0]
        列表 新队列 = []
        对于 i 从 1 到 长度(队列) - 1 循环
            追加(新队列, 队列[i])
        结束
        队列 = 新队列
        追加(结果, u)
        字符串 u键 = 转字符串(u)
        如果 包含(图, u键) 则
            列表 邻居表 = 图[u键]
            对于 i 从 0 到 长度(邻居表) - 1 循环
                整数 v = 邻居表[i][0]
                入度[v] = 入度[v] - 1
                如果 入度[v] == 0 则
                    追加(队列, v)
                结束
            结束
        结束
    结束
    返回 结果
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 图算法库测试 ===")

# 构建测试图
字典 图1 = 图新建()
图加边(图1, 0, 1, 1)
图加边(图1, 0, 3, 1)
图加边(图1, 1, 2, 1)
图加边(图1, 1, 4, 1)
图加边(图1, 2, 5, 1)
图加边(图1, 3, 4, 1)
图加边(图1, 4, 5, 1)

输出("BFS(0) =", BFS(图1, 0))
输出("DFS(0) =", DFS(图1, 0))

# Dijkstra测试
字典 图2 = 图新建()
图加边(图2, 0, 1, 4)
图加边(图2, 0, 3, 3)
图加边(图2, 1, 2, 2)
图加边(图2, 1, 4, 1)
图加边(图2, 2, 5, 5)
图加边(图2, 3, 4, 1)
图加边(图2, 4, 5, 3)
输出("迪杰斯特拉(0) =", 迪杰斯特拉(图2, 0, 6))

# Floyd-Warshall测试
列表 矩阵 = [[0, 4, 999999, 3, 999999, 999999], [4, 0, 2, 999999, 1, 999999], [999999, 2, 0, 999999, 999999, 5], [3, 999999, 999999, 0, 1, 999999], [999999, 1, 999999, 1, 0, 3], [999999, 999999, 5, 999999, 3, 0]]
列表 fw结果 = 弗洛伊德(矩阵, 6)
输出("弗洛伊德 0->5 =", fw结果[0][5])

# Prim测试
列表 树矩阵 = [[0, 2, 0, 6, 0], [2, 0, 3, 8, 5], [0, 3, 0, 0, 7], [6, 8, 0, 0, 9], [0, 5, 7, 9, 0]]
输出("普里姆MST总权重 =", 普里姆(树矩阵, 5))

# 拓扑排序测试（DAG）
字典 图3 = 图新建()
图加边(图3, 5, 2, 1)
图加边(图3, 5, 0, 1)
图加边(图3, 4, 0, 1)
图加边(图3, 4, 1, 1)
图加边(图3, 2, 3, 1)
图加边(图3, 3, 1, 1)
输出("拓扑排序 =", 拓扑排序(图3, 6))

输出("=== 图算法库测试完成 ===")
