输出("=== 动态规划库测试 ===")

# 斐波那契
输出("斐波那契(10) =", 斐波那契(10))
输出("斐波那契(20) =", 斐波那契(20))

# 0-1背包
列表 重量 = [2, 3, 4, 5]
列表 价值 = [3, 4, 5, 6]
输出("背包01(容量8) =", 背包01(重量, 价值, 8))

# 最长公共子序列
输出("LCS(\"ABCBDAB\", \"BDCABA\") =", 最长公共子序列("ABCBDAB", "BDCABA"))

# 最长递增子序列
输出("LIS([10,9,2,5,3,7,101,18]) =", 最长递增子序列([10, 9, 2, 5, 3, 7, 101, 18]))

# 编辑距离
输出("编辑距离(\"kitten\", \"sitting\") =", 编辑距离("kitten", "sitting"))

# 硬币找零
输出("硬币找零([1,3,4], 6) =", 硬币找零([1, 3, 4], 6))

# 矩阵链乘法
输出("矩阵链乘法([10,30,5,60]) =", 矩阵链乘法([10, 30, 5, 60]))

输出("=== 动态规划库测试完成 ===")
