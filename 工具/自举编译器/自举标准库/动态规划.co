# ============================================================
# 动态规划.co —— 自举标准库：动态规划算法库
# 包含：斐波那契、背包问题、最长公共子序列、最长递增子序列、
#       编辑距离、矩阵链乘法、硬币找零
# ============================================================

# ---------------- 斐波那契（自底向上DP） ----------------
函数 斐波那契(整数 n) -> 整数
    如果 n <= 0 则
        返回 0
    结束
    如果 n <= 2 则
        返回 1
    结束
    列表 dp = [0, 1, 1]
    对于 i 从 3 到 n 循环
        追加(dp, dp[i - 1] + dp[i - 2])
    结束
    返回 dp[n]
结束

# ---------------- 0-1背包问题 ----------------
# weights: 重量列表, values: 价值列表, 容量: 背包容量
# 返回最大价值
函数 背包01(列表 重量, 列表 价值, 整数 容量) -> 整数
    整数 n = 长度(重量)
    # dp[i][w] = 前i个物品，容量w时的最大价值
    列表 dp = []
    对于 i 从 0 到 n 循环
        列表 行 = []
        对于 w 从 0 到 容量 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    对于 i 从 1 到 n 循环
        对于 w 从 1 到 容量 循环
            如果 重量[i - 1] <= w 则
                整数 选 = dp[i - 1][w - 重量[i - 1]] + 价值[i - 1]
                整数 不选 = dp[i - 1][w]
                如果 选 > 不选 则
                    dp[i][w] = 选
                否则
                    dp[i][w] = 不选
                结束
            否则
                dp[i][w] = dp[i - 1][w]
            结束
        结束
    结束
    返回 dp[n][容量]
结束

# ---------------- 最长公共子序列 (LCS) ----------------
函数 最长公共子序列(字符串 s1, 字符串 s2) -> 整数
    整数 m = 长度(s1)
    整数 n = 长度(s2)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 s1[i - 1] == s2[j - 1] 则
                dp[i][j] = dp[i - 1][j - 1] + 1
            否则
                如果 dp[i - 1][j] > dp[i][j - 1] 则
                    dp[i][j] = dp[i - 1][j]
                否则
                    dp[i][j] = dp[i][j - 1]
                结束
            结束
        结束
    结束
    返回 dp[m][n]
结束

# ---------------- 最长递增子序列 (LIS) ----------------
函数 最长递增子序列(列表 xs) -> 整数
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0
    结束
    列表 dp = []
    对于 i 从 0 到 n - 1 循环
        追加(dp, 1)
    结束
    对于 i 从 1 到 n - 1 循环
        对于 j 从 0 到 i - 1 循环
            如果 xs[j] < xs[i] 且 dp[j] + 1 > dp[i] 则
                dp[i] = dp[j] + 1
            结束
        结束
    结束
    # 找最大值
    整数 最大 = dp[0]
    对于 i 从 1 到 n - 1 循环
        如果 dp[i] > 最大 则
            最大 = dp[i]
        结束
    结束
    返回 最大
结束

# ---------------- 编辑距离（Levenshtein） ----------------
函数 编辑距离(字符串 s1, 字符串 s2) -> 整数
    整数 m = 长度(s1)
    整数 n = 长度(s2)
    列表 dp = []
    对于 i 从 0 到 m 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    # 初始化
    对于 i 从 0 到 m 循环
        dp[i][0] = i
    结束
    对于 j 从 0 到 n 循环
        dp[0][j] = j
    结束
    # DP
    对于 i 从 1 到 m 循环
        对于 j 从 1 到 n 循环
            如果 s1[i - 1] == s2[j - 1] 则
                dp[i][j] = dp[i - 1][j - 1]
            否则
                整数 删除 = dp[i - 1][j] + 1
                整数 插入 = dp[i][j - 1] + 1
                整数 替换 = dp[i - 1][j - 1] + 1
                整数 最小 = 删除
                如果 插入 < 最小 则
                    最小 = 插入
                结束
                如果 替换 < 最小 则
                    最小 = 替换
                结束
                dp[i][j] = 最小
            结束
        结束
    结束
    返回 dp[m][n]
结束

# ---------------- 硬币找零 ----------------
# 返回最少硬币数，无法找零返回 -1
函数 硬币找零(列表 硬币面额, 整数 金额) -> 整数
    列表 dp = []
    对于 i 从 0 到 金额 循环
        追加(dp, 999999)
    结束
    dp[0] = 0
    对于 i 从 1 到 金额 循环
        对于 j 从 0 到 长度(硬币面额) - 1 循环
            整数 硬币 = 硬币面额[j]
            如果 硬币 <= i 且 dp[i - 硬币] + 1 < dp[i] 则
                dp[i] = dp[i - 硬币] + 1
            结束
        结束
    结束
    如果 dp[金额] >= 999999 则
        返回 -1
    结束
    返回 dp[金额]
结束

# ---------------- 矩阵链乘法 ----------------
# 返回最少乘法次数
函数 矩阵链乘法(列表 维度) -> 整数
    整数 n = 长度(维度) - 1
    列表 dp = []
    对于 i 从 0 到 n 循环
        列表 行 = []
        对于 j 从 0 到 n 循环
            追加(行, 0)
        结束
        追加(dp, 行)
    结束
    # 长度从2到n
    对于 长度 从 2 到 n 循环
        对于 i 从 0 到 n - 长度 循环
            整数 j = i + 长度 - 1
            dp[i][j] = 999999
            对于 k 从 i 到 j - 1 循环
                整数 代价 = dp[i][k] + dp[k + 1][j] + 维度[i] * 维度[k + 1] * 维度[j + 1]
                如果 代价 < dp[i][j] 则
                    dp[i][j] = 代价
                结束
            结束
        结束
    结束
    返回 dp[0][n - 1]
结束

