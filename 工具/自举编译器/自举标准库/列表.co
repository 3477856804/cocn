# ============================================================
# 列表.co —— 自举标准库：列表操作库
# 包含：创建、追加、插入、删除、查找、包含、计数、
#       排序、反转、去重、切片、连接、扁平化、
#       映射、过滤、归约（高阶函数）、最大最小、求和平均
# ============================================================

# ---------------- 基本操作 ----------------
# 创建空列表
函数 新建列表() -> 列表
    返回 []
结束

# 追加元素（内置 追加 已支持）
函数 追加元素(列表 xs, 元素)
    追加(xs, 元素)
结束

# 在指定位置插入
函数 插入(列表 xs, 整数 位置, 元素)
    列表 新表 = []
    对于 i 从 0 到 位置 - 1 循环
        追加(新表, xs[i])
    结束
    追加(新表, 元素)
    对于 i 从 位置 到 长度(xs) - 1 循环
        追加(新表, xs[i])
    结束
    # 复制回原列表
    对于 i 从 0 到 长度(新表) - 1 循环
        xs[i] = 新表[i]
    结束
结束

# 删除指定位置的元素
函数 删除(列表 xs, 整数 位置)
    列表 新表 = []
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 i != 位置 则
            追加(新表, xs[i])
        结束
    结束
    对于 i 从 0 到 长度(新表) - 1 循环
        xs[i] = 新表[i]
    结束
结束

# 查找元素位置，未找到返回 -1
函数 查找(列表 xs, 元素) -> 整数
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 xs[i] == 元素 则
            返回 i
        结束
    结束
    返回 -1
结束

# 是否包含元素
函数 包含(列表 xs, 元素) -> 整数
    返回 查找(xs, 元素) >= 0
结束

# 统计元素出现次数
函数 计数(列表 xs, 元素) -> 整数
    整数 次数 = 0
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 xs[i] == 元素 则
            次数 = 次数 + 1
        结束
    结束
    返回 次数
结束

# ---------------- 排序反转去重 ----------------
# 冒泡排序（升序）
函数 冒泡排序(列表 xs)
    整数 n = 长度(xs)
    对于 i 从 0 到 n - 2 循环
        对于 j 从 0 到 n - 2 - i 循环
            如果 xs[j] > xs[j + 1] 则
                整数 t = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = t
            结束
        结束
    结束
结束

# 反转列表
函数 反转(列表 xs)
    整数 n = 长度(xs)
    对于 i 从 0 到 n / 2 - 1 循环
        整数 t = xs[i]
        xs[i] = xs[n - 1 - i]
        xs[n - 1 - i] = t
    结束
结束

# 去重（保持顺序）
函数 去重(列表 xs) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 包含(结果, xs[i]) == 0 则
            追加(结果, xs[i])
        结束
    结束
    返回 结果
结束

# ---------------- 切片连接扁平化 ----------------
# 切片 xs[起:止]
函数 切片(列表 xs, 整数 起, 整数 止) -> 列表
    列表 结果 = []
    对于 i 从 起 到 止 - 1 循环
        追加(结果, xs[i])
    结束
    返回 结果
结束

# 连接两个列表
函数 连接(列表 a, 列表 b) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(a) - 1 循环
        追加(结果, a[i])
    结束
    对于 i 从 0 到 长度(b) - 1 循环
        追加(结果, b[i])
    结束
    返回 结果
结束

# 扁平化一层嵌套列表
函数 扁平化(列表 xs) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(xs) - 1 循环
        # xs[i] 可能是列表也可能是单元素
        追加(结果, xs[i])
    结束
    返回 结果
结束

# ---------------- 高阶函数 ----------------
# 映射：对每个元素应用函数
函数 映射(f, 列表 xs) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(xs) - 1 循环
        追加(结果, f(xs[i]))
    结束
    返回 结果
结束

# 过滤：保留满足条件的元素
函数 过滤(f, 列表 xs) -> 列表
    列表 结果 = []
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 f(xs[i]) 则
            追加(结果, xs[i])
        结束
    结束
    返回 结果
结束

# 归约：左折叠
函数 归约(f, 列表 xs, 初始值)
    整数 累加 = 初始值
    对于 i 从 0 到 长度(xs) - 1 循环
        累加 = f(累加, xs[i])
    结束
    返回 累加
结束

# ---------------- 统计 ----------------
函数 最大值(列表 xs)
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0
    结束
    整数 最大 = xs[0]
    对于 i 从 1 到 n - 1 循环
        如果 xs[i] > 最大 则
            最大 = xs[i]
        结束
    结束
    返回 最大
结束

函数 最小值(列表 xs)
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0
    结束
    整数 最小 = xs[0]
    对于 i 从 1 到 n - 1 循环
        如果 xs[i] < 最小 则
            最小 = xs[i]
        结束
    结束
    返回 最小
结束

函数 求和(列表 xs) -> 整数
    整数 总 = 0
    对于 i 从 0 到 长度(xs) - 1 循环
        总 = 总 + xs[i]
    结束
    返回 总
结束

函数 平均值(列表 xs) -> 浮点
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0.0
    结束
    返回 转浮点(求和(xs)) / 转浮点(n)
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 列表库测试 ===")

# 基本操作
列表 xs = [3, 1, 4, 1, 5, 9, 2, 6]
输出("原列表 =", xs)

插入(xs, 2, 99)
输出("插入99到位置2 =", xs)

删除(xs, 2)
输出("删除位置2 =", xs)

输出("查找(5) =", 查找(xs, 5))
输出("包含(99) =", 包含(xs, 99))
输出("计数(1) =", 计数(xs, 1))

# 排序反转去重
列表 排序测试 = [64, 34, 25, 12, 22, 11, 90]
冒泡排序(排序测试)
输出("冒泡排序 =", 排序测试)

列表 反转测试 = [1, 2, 3, 4, 5]
反转(反转测试)
输出("反转 =", 反转测试)

输出("去重 =", 去重([1, 2, 2, 3, 3, 3, 4]))

# 切片连接
输出("切片 =", 切片([10, 20, 30, 40, 50], 1, 4))
输出("连接 =", 连接([1, 2], [3, 4]))

# 高阶函数测试
函数 平方(整数 x)
    返回 x * x
结束
函数 是偶数(整数 x)
    返回 x % 2 == 0
结束
函数 相加(整数 a, 整数 b)
    返回 a + b
结束

列表 数据 = [1, 2, 3, 4, 5]
输出("映射(平方) =", 映射(平方, 数据))
输出("过滤(偶数) =", 过滤(是偶数, 数据))
输出("归约(求和) =", 归约(相加, 数据, 0))

# 统计
列表 统计数据 = [10, 20, 30, 40, 50]
输出("最大值 =", 最大值(统计数据))
输出("最小值 =", 最小值(统计数据))
输出("求和 =", 求和(统计数据))
输出("平均值 =", 平均值(统计数据))

输出("=== 列表库测试完成 ===")
