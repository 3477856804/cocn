# ============================================================
# 数据结构.co —— 自举标准库：数据结构库
# 包含：栈、队列、优先队列、链表、二叉搜索树、哈希表、集合、Trie
# ============================================================

# ---------------- 栈 ----------------
# 用列表实现栈
函数 栈新建() -> 列表
    返回 []
结束

函数 栈压入(列表 栈, 元素)
    追加(栈, 元素)
结束

函数 栈弹出(列表 栈)
    整数 n = 长度(栈)
    如果 n == 0 则
        返回 "空"
    结束
    元素 = 栈[n - 1]
    # 删除最后一个元素（通过重建列表）
    列表 新栈 = []
    对于 i 从 0 到 n - 2 循环
        追加(新栈, 栈[i])
    结束
    对于 i 从 0 到 长度(新栈) - 1 循环
        栈[i] = 新栈[i]
    结束
    返回 元素
结束

函数 栈顶(列表 栈)
    整数 n = 长度(栈)
    如果 n == 0 则
        返回 "空"
    结束
    返回 栈[n - 1]
结束

函数 栈空(列表 栈) -> 整数
    返回 长度(栈) == 0
结束

# ---------------- 队列 ----------------
函数 队列新建() -> 列表
    返回 []
结束

函数 入队(列表 队列, 元素)
    追加(队列, 元素)
结束

函数 出队(列表 队列)
    整数 n = 长度(队列)
    如果 n == 0 则
        返回 "空"
    结束
    元素 = 队列[0]
    # 删除第一个元素
    列表 新队列 = []
    对于 i 从 1 到 n - 1 循环
        追加(新队列, 队列[i])
    结束
    对于 i 从 0 到 长度(新队列) - 1 循环
        队列[i] = 新队列[i]
    结束
    返回 元素
结束

函数 队列空(列表 队列) -> 整数
    返回 长度(队列) == 0
结束

# ---------------- 优先队列（简单实现） ----------------
函数 优先队列新建() -> 列表
    返回 []
结束

函数 优先队列插入(列表 pq, 元素, 整数 优先级)
    # 存储为 [元素, 优先级] 对
    列表 项 = [元素, 优先级]
    追加(pq, 项)
结束

函数 优先队列弹出最小(列表 pq)
    整数 n = 长度(pq)
    如果 n == 0 则
        返回 "空"
    结束
    整数 最小索引 = 0
    对于 i 从 1 到 n - 1 循环
        如果 pq[i][1] < pq[最小索引][1] 则
            最小索引 = i
        结束
    结束
    元素 = pq[最小索引][0]
    # 移除该项
    列表 新pq = []
    对于 i 从 0 到 n - 1 循环
        如果 i != 最小索引 则
            追加(新pq, pq[i])
        结束
    结束
    对于 i 从 0 到 长度(新pq) - 1 循环
        pq[i] = 新pq[i]
    结束
    返回 元素
结束

# ---------------- 链表（用字典模拟节点） ----------------
函数 链表新建() -> 字典
    返回 {"头": "空", "大小": 0}
结束

函数 链表追加(字典 链表, 值)
    字典 节点 = {"值": 值, "下一个": "空"}
    如果 链表["头"] == "空" 则
        链表["头"] = 节点
    否则
        字典 当前 = 链表["头"]
        当 当前["下一个"] != "空" 循环
            当前 = 当前["下一个"]
        结束
        当前["下一个"] = 节点
    结束
    链表["大小"] = 链表["大小"] + 1
结束

函数 链表转列表(字典 链表) -> 列表
    列表 结果 = []
    字典 当前 = 链表["头"]
    当 当前 != "空" 循环
        追加(结果, 当前["值"])
        当前 = 当前["下一个"]
    结束
    返回 结果
结束

# ---------------- 二叉搜索树 ----------------
函数 树新建(值) -> 字典
    返回 {"值": 值, "左": "空", "右": "空"}
结束

函数 树插入(字典 节点, 值)
    如果 值 < 节点["值"] 则
        如果 节点["左"] == "空" 则
            节点["左"] = 树新建(值)
        否则
            树插入(节点["左"], 值)
        结束
    否则
        如果 节点["右"] == "空" 则
            节点["右"] = 树新建(值)
        否则
            树插入(节点["右"], 值)
        结束
    结束
结束

函数 树查找(字典 节点, 值) -> 整数
    如果 节点 == "空" 则
        返回 0
    结束
    如果 值 == 节点["值"] 则
        返回 1
    结束
    如果 值 < 节点["值"] 则
        返回 树查找(节点["左"], 值)
    结束
    返回 树查找(节点["右"], 值)
结束

函数 树中序遍历(字典 节点, 列表 结果)
    如果 节点 == "空" 则
        返回
    结束
    树中序遍历(节点["左"], 结果)
    追加(结果, 节点["值"])
    树中序遍历(节点["右"], 结果)
结束

# ---------------- 哈希表（用字典） ----------------
函数 哈希表新建() -> 字典
    返回 {}
结束

函数 哈希表设置(字典 ht, 键, 值)
    ht[键] = 值
结束

函数 哈希表获取(字典 ht, 键)
    返回 ht[键]
结束

函数 哈希表包含(字典 ht, 键) -> 整数
    返回 包含(ht, 键)
结束

# ---------------- 集合 ----------------
函数 集合新建() -> 列表
    返回 []
结束

函数 集合添加(列表 集合, 元素)
    整数 存在 = 0
    对于 i 从 0 到 长度(集合) - 1 循环
        如果 集合[i] == 元素 则
            存在 = 1
        结束
    结束
    如果 存在 == 0 则
        追加(集合, 元素)
    结束
结束

函数 集合包含(列表 集合, 元素) -> 整数
    对于 i 从 0 到 长度(集合) - 1 循环
        如果 集合[i] == 元素 则
            返回 1
        结束
    结束
    返回 0
结束

函数 集合大小(列表 集合) -> 整数
    返回 长度(集合)
结束

# ---------------- Trie ----------------
函数 特里树新建() -> 字典
    字典 节点 = {}
    节点["子节点"] = {}
    节点["是结尾"] = 0
    返回 节点
结束

函数 特里树插入(字典 根, 字符串 单词)
    字典 当前 = 根
    对于 i 从 0 到 长度(单词) - 1 循环
        字符串 c = 单词[i]
        如果 包含(当前["子节点"], c) == 0 则
            当前["子节点"][c] = 特里树新建()
        结束
        当前 = 当前["子节点"][c]
    结束
    当前["是结尾"] = 1
结束

函数 特里树查找(字典 根, 字符串 单词) -> 整数
    字典 当前 = 根
    对于 i 从 0 到 长度(单词) - 1 循环
        字符串 c = 单词[i]
        如果 包含(当前["子节点"], c) == 0 则
            返回 0
        结束
        当前 = 当前["子节点"][c]
    结束
    返回 当前["是结尾"]
结束

