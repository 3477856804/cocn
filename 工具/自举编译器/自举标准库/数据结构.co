输出("查找(apple) =", 特里树查找(trie, "apple"))
输出("查找(ap) =", 特里树查找(trie, "ap"))
输出("查找(banana) =", 特里树查找(trie, "banana"))
输出("查找(orange) =", 特里树查找(trie, "orange"))

输出("=== 数据结构库测试完成 ===")
