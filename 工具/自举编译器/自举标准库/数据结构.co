入队(队列1, "a")
入队(队列1, "b")
入队(队列1, "c")
输出("出队 =", 出队(队列1))
输出("出队 =", 出队(队列1))
输出("队列空 =", 队列空(队列1))

# 优先队列测试
输出("--- 优先队列 ---")
列表 pq = 优先队列新建()
优先队列插入(pq, "任务A", 3)
优先队列插入(pq, "任务B", 1)
优先队列插入(pq, "任务C", 2)
输出("弹出最小 =", 优先队列弹出最小(pq))
输出("弹出最小 =", 优先队列弹出最小(pq))

# 链表测试
输出("--- 链表 ---")
字典 链表1 = 链表新建()
链表追加(链表1, 1)
链表追加(链表1, 2)
链表追加(链表1, 3)
输出("链表转列表 =", 链表转列表(链表1))

# 二叉搜索树测试
输出("--- 二叉搜索树 ---")
字典 树 = 树新建(5)
树插入(树, 3)
树插入(树, 7)
树插入(树, 1)
树插入(树, 9)
列表 中序结果 = []
树中序遍历(树, 中序结果)
输出("中序遍历 =", 中序结果)
输出("查找(7) =", 树查找(树, 7))
输出("查找(10) =", 树查找(树, 10))

# 哈希表测试
输出("--- 哈希表 ---")
字典 ht = 哈希表新建()
哈希表设置(ht, "名字", "小明")
哈希表设置(ht, "年龄", 20)
输出("获取(名字) =", 哈希表获取(ht, "名字"))
输出("包含(年龄) =", 哈希表包含(ht, "年龄"))

# 集合测试
输出("--- 集合 ---")
列表 集合1 = 集合新建()
集合添加(集合1, 1)
集合添加(集合1, 2)
集合添加(集合1, 2)
集合添加(集合1, 3)
输出("集合 =", 集合1)
输出("大小 =", 集合大小(集合1))
输出("包含(2) =", 集合包含(集合1, 2))
