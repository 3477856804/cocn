栈压入(栈1, 20)
栈压入(栈1, 30)
输出("栈顶 =", 栈顶(栈1))
输出("弹出 =", 栈弹出(栈1))
输出("弹出 =", 栈弹出(栈1))
输出("栈空 =", 栈空(栈1))

# 队列测试
输出("--- 队列 ---")
