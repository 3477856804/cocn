# ============================================================
# 排序.co —— 自举标准库：排序算法库
# 包含：冒泡、选择、插入、快速、归并、堆、希尔、计数排序
# ============================================================

# ---------------- 冒泡排序 ----------------
函数 冒泡排序(列表 xs)
    整数 n = 长度(xs)
    对于 i 从 0 到 n - 2 循环
        对于 j 从 0 到 n - 2 - i 循环
            如果 xs[j] > xs[j + 1] 则
                整数 t = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = t
            结束
        结束
    结束
结束

# ---------------- 选择排序 ----------------
函数 选择排序(列表 xs)
    整数 n = 长度(xs)
    对于 i 从 0 到 n - 2 循环
        整数 最小 = i
        对于 j 从 i + 1 到 n - 1 循环
            如果 xs[j] < xs[最小] 则
                最小 = j
            结束
        结束
        如果 最小 != i 则
            整数 t = xs[i]
            xs[i] = xs[最小]
            xs[最小] = t
        结束
    结束
结束

# ---------------- 插入排序 ----------------
函数 插入排序(列表 xs)
    整数 n = 长度(xs)
    对于 i 从 1 到 n - 1 循环
        整数 键 = xs[i]
        整数 j = i - 1
        当 j >= 0 且 xs[j] > 键 循环
            xs[j + 1] = xs[j]
            j = j - 1
        结束
        xs[j + 1] = 键
    结束
结束

# ---------------- 快速排序 ----------------
函数 快速排序(列表 xs, 整数 低, 整数 高)
    如果 低 >= 高 则
        返回
    结束
    整数 枢轴 = xs[高]
    整数 i = 低 - 1
    对于 j 从 低 到 高 - 1 循环
        如果 xs[j] <= 枢轴 则
            i = i + 1
            整数 t = xs[i]
            xs[i] = xs[j]
            xs[j] = t
        结束
    结束
    整数 t = xs[i + 1]
    xs[i + 1] = xs[高]
    xs[高] = t
    整数 p = i + 1
    快速排序(xs, 低, p - 1)
    快速排序(xs, p + 1, 高)
结束

# ---------------- 归并排序 ----------------
函数 归并(列表 xs, 整数 左, 整数 中, 整数 右)
    列表 临时 = []
    整数 i = 左
    整数 j = 中 + 1
    当 i <= 中 且 j <= 右 循环
        如果 xs[i] <= xs[j] 则
            追加(临时, xs[i])
            i = i + 1
        否则
            追加(临时, xs[j])
            j = j + 1
        结束
    结束
    当 i <= 中 循环
        追加(临时, xs[i])
        i = i + 1
    结束
    当 j <= 右 循环
        追加(临时, xs[j])
        j = j + 1
    结束
    对于 k 从 0 到 长度(临时) - 1 循环
        xs[左 + k] = 临时[k]
    结束
结束

函数 归并排序递归(列表 xs, 整数 左, 整数 右)
    如果 左 >= 右 则
        返回
    结束
    整数 中 = 转整数((左 + 右) / 2)
    归并排序递归(xs, 左, 中)
    归并排序递归(xs, 中 + 1, 右)
    归并(xs, 左, 中, 右)
结束

函数 归并排序(列表 xs)
    归并排序递归(xs, 0, 长度(xs) - 1)
结束

# ---------------- 希尔排序 ----------------
函数 希尔排序(列表 xs)
    整数 n = 长度(xs)
    整数 间隔 = 转整数(n / 2)
    当 间隔 > 0 循环
        对于 i 从 间隔 到 n - 1 循环
            整数 临时 = xs[i]
            整数 j = i
            当 j >= 间隔 且 xs[j - 间隔] > 临时 循环
                xs[j] = xs[j - 间隔]
                j = j - 间隔
            结束
            xs[j] = 临时
        结束
        间隔 = 转整数(间隔 / 2)
    结束
结束

# ---------------- 计数排序 ----------------
函数 计数排序(列表 xs)
    整数 n = 长度(xs)
    如果 n == 0 则
        返回
    结束
    # 找最大值
    整数 最大 = xs[0]
    对于 i 从 1 到 n - 1 循环
        如果 xs[i] > 最大 则
            最大 = xs[i]
        结束
    结束
    # 计数数组
    列表 计数 = []
    对于 i 从 0 到 最大 循环
        追加(计数, 0)
    结束
    对于 i 从 0 到 n - 1 循环
        计数[xs[i]] = 计数[xs[i]] + 1
    结束
    # 放回原数组
    整数 索引 = 0
    对于 i 从 0 到 最大 循环
        当 计数[i] > 0 循环
            xs[索引] = i
            索引 = 索引 + 1
            计数[i] = 计数[i] - 1
        结束
    结束
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 排序算法库测试 ===")

函数 验证排序(列表 xs, 字符串 算法名)
    整数 n = 长度(xs)
    整数 排序正确 = 1
    对于 i 从 0 到 n - 2 循环
        如果 xs[i] > xs[i + 1] 则
            排序正确 = 0
        结束
    结束
    输出(算法名, "结果 =", xs, "正确 =", 排序正确)
结束

# 冒泡
列表 d1 = [64, 34, 25, 12, 22, 11, 90]
冒泡排序(d1)
验证排序(d1, "冒泡排序")

# 选择
列表 d2 = [64, 34, 25, 12, 22, 11, 90]
选择排序(d2)
验证排序(d2, "选择排序")

# 插入
列表 d3 = [64, 34, 25, 12, 22, 11, 90]
插入排序(d3)
验证排序(d3, "插入排序")

# 快速
列表 d4 = [64, 34, 25, 12, 22, 11, 90]
快速排序(d4, 0, 长度(d4) - 1)
验证排序(d4, "快速排序")

# 归并
列表 d5 = [64, 34, 25, 12, 22, 11, 90]
归并排序(d5)
验证排序(d5, "归并排序")

# 希尔
列表 d6 = [64, 34, 25, 12, 22, 11, 90]
希尔排序(d6)
验证排序(d6, "希尔排序")

# 计数
列表 d7 = [4, 2, 2, 8, 3, 3, 1, 7, 5, 6, 4, 3]
计数排序(d7)
验证排序(d7, "计数排序")

输出("=== 排序算法库测试完成 ===")
