# ============================================================
# 工具.co —— 自举标准库：工具函数库
# 包含：计时、断言、测试框架、格式化输出、类型检查
# ============================================================

# ---------------- 类型检查 ----------------
# 判断是否为整数（简化：通过值是否为浮点判断）
函数 是整数(值) -> 整数
    # coCN中整数和浮点都是数字，这里用类型名称判断
    # 简化实现：检查是否等于其整数形式
    返回 值 == 转整数(值)
结束

函数 是字符串(值) -> 整数
    # 通过长度函数判断是否为字符串
    # 简化：用包含函数测试
    如果 长度(转字符串(值)) > 0 则
        # 进一步判断：如果原值是字符串，转字符串后会带引号？
        # 简化实现：尝试字符串操作
        返回 0  # 默认非字符串
    结束
    返回 0
结束

函数 是列表(值) -> 整数
    # 简化：列表可以取长度且能索引
    返回 0
结束

函数 是字典(值) -> 整数
    返回 0
结束

函数 类型名(值) -> 字符串
    返回 转字符串(值)
结束

# ---------------- 断言与测试框架 ----------------
让 测试通过数 = 0
让 测试失败数 = 0
让 当前测试套件 = ""

函数 测试套件(字符串 名称)
    当前测试套件 = 名称
    输出("--- " + 名称 + " ---")
结束

# 断言相等
函数 断言相等(实际, 期望, 字符串 测试名)
    如果 实际 == 期望 则
        测试通过数 = 测试通过数 + 1
        输出("  [PASS] " + 测试名)
    否则
        测试失败数 = 测试失败数 + 1
        输出("  [FAIL] " + 测试名 + " 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际))
    结束
结束

# 断言为真
函数 断言真(条件, 字符串 测试名)
    如果 条件 则
        测试通过数 = 测试通过数 + 1
        输出("  [PASS] " + 测试名)
    否则
        测试失败数 = 测试失败数 + 1
        输出("  [FAIL] " + 测试名)
    结束
结束

# 断言不为空
函数 断言非空(值, 字符串 测试名)
    如果 值 != "空" 且 值 != 0 则
        测试通过数 = 测试通过数 + 1
        输出("  [PASS] " + 测试名)
    否则
        测试失败数 = 测试失败数 + 1
        输出("  [FAIL] " + 测试名)
    结束
结束

# 打印测试总结
函数 测试总结()
    输出("=============================")
    输出("测试通过: " + 转字符串(测试通过数))
    输出("测试失败: " + 转字符串(测试失败数))
    输出("总计: " + 转字符串(测试通过数 + 测试失败数))
    如果 测试失败数 == 0 则
        输出("全部通过!")
    否则
        输出("有失败用例!")
    结束
    输出("=============================")
结束

# ---------------- 计时函数 ----------------
函数 开始计时() -> 整数
    返回 时间戳()
结束

函数 结束计时(整数 开始时间) -> 整数
    返回 时间戳() - 开始时间
结束

# ---------------- 格式化输出 ----------------
# 打印分隔线
函数 分隔线(字符串 字符, 整数 长度)
    字符串 线 = ""
    对于 i 从 0 到 长度 - 1 循环
        线 = 线 + 字符
    结束
    输出(线)
结束

# 打印标题（带分隔线）
函数 打印标题(字符串 标题)
    分隔线("=", 40)
    输出(标题)
    分隔线("-", 40)
结束

# 进度条（简化版）
函数 进度条(整数 当前, 整数 总计)
    整数 百分比 = 转整数(转浮点(当前) / 转浮点(总计) * 100.0)
    字符串 条 = "["
    整数 填充数 = 转整数(转浮点(百分比) / 100.0 * 20.0)
    对于 i 从 0 到 19 循环
        如果 i < 填充数 则
            条 = 条 + "#"
        否则
            条 = 条 + " "
        结束
    结束
    条 = 条 + "] " + 转字符串(百分比) + "%"
    输出(条)
结束

# ---------------- 数学工具 ----------------
函数 取绝对值(整数 x) -> 整数
    如果 x < 0 则
        返回 -x
    结束
    返回 x
结束

函数 取最大值(整数 a, 整数 b) -> 整数
    如果 a > b 则
        返回 a
    结束
    返回 b
结束

函数 取最小值(整数 a, 整数 b) -> 整数
    如果 a < b 则
        返回 a
    结束
    返回 b
结束

# 范围生成器
函数 范围(整数 起, 整数 止) -> 列表
    列表 结果 = []
    对于 i 从 起 到 止 - 1 循环
        追加(结果, i)
    结束
    返回 结果
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 工具库测试 ===")

# 测试框架演示
测试套件("基础断言测试")
断言相等(1 + 1, 2, "1+1=2")
断言相等(10 * 5, 50, "10*5=50")
断言真(3 > 2, "3>2为真")
断言真(5 < 3, "5<3为真（故意失败）")

测试套件("字符串测试")
断言相等("你好" + "世界", "你好世界", "字符串拼接")
断言相等(长度("hello"), 5, "字符串长度")

测试套件("列表测试")
断言相等(长度([1, 2, 3]), 3, "列表长度")
断言相等(10 + 20, 30, "加法")

# 计时测试
输出("--- 计时测试 ---")
整数 计时开始 = 开始计时()
# 做一点计算
整数 累计 = 0
对于 i 从 1 到 100 循环
    累计 = 累计 + i
结束
整数 耗时 = 结束计时(计时开始)
输出("1到100累加 =", 累计)
输出("耗时(毫秒) =", 耗时)

# 格式化输出
输出("--- 格式化输出 ---")
分隔线("*", 30)
打印标题("工具库演示")
进度条(3, 10)
进度条(7, 10)
进度条(10, 10)

# 数学工具
输出("--- 数学工具 ---")
断言相等(取绝对值(-5), 5, "绝对值(-5)")
断言相等(取最大值(3, 7), 7, "max(3,7)")
断言相等(取最小值(3, 7), 3, "min(3,7)")
断言相等(范围(0, 5), [0, 1, 2, 3, 4], "范围(0,5)")

# 测试总结
测试总结()

输出("=== 工具库测试完成 ===")
