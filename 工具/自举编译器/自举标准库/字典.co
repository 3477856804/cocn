# ============================================================
# 字典.co —— 自举标准库：字典操作库
# 包含：创建、设置、获取、删除、包含、长度、键列表、值列表、
#       合并、拷贝、清空、遍历、映射、过滤
# ============================================================

# ---------------- 基本操作 ----------------
# 创建空字典
函数 新建字典() -> 字典
    返回 {}
结束

# 设置键值对
函数 设置(字典 d, 键, 值)
    d[键] = 值
结束

# 获取值（带默认值）
函数 获取(字典 d, 键, 默认值)
    如果 包含(d, 键) 则
        返回 d[键]
    结束
    返回 默认值
结束

# 删除键
函数 删除键(字典 d, 键)
    # coCN字典删除：设为空值标记
    d[键] = "空"
结束

# 是否包含键（内置 包含 已支持）
函数 包含键(字典 d, 键) -> 整数
    返回 包含(d, 键)
结束

# 字典长度
函数 字典长度(字典 d) -> 整数
    返回 长度(键列表(d))
结束

# ---------------- 键值列表 ----------------
# 获取所有键
函数 键列表(字典 d) -> 列表
    列表 键 = []
    # 遍历字典 - 通过迭代
    对于 k 在 d 循环
        追加(键, k)
    结束
    返回 键
结束

# 获取所有值
函数 值列表(字典 d) -> 列表
    列表 值 = []
    对于 k 在 d 循环
        追加(值, d[k])
    结束
    返回 值
结束

# ---------------- 合并拷贝清空 ----------------
# 合并两个字典（b覆盖a的同键）
函数 合并(字典 a, 字典 b) -> 字典
    字典 结果 = {}
    对于 k 在 a 循环
        结果[k] = a[k]
    结束
    对于 k 在 b 循环
        结果[k] = b[k]
    结束
    返回 结果
结束

# 拷贝字典
函数 拷贝(字典 d) -> 字典
    字典 结果 = {}
    对于 k 在 d 循环
        结果[k] = d[k]
    结束
    返回 结果
结束

# 清空字典
函数 清空(字典 d)
    对于 k 在 d 循环
        删除键(d, k)
    结束
结束

# ---------------- 遍历高阶 ----------------
# 映射：对所有值应用函数，返回新字典
函数 字典映射(f, 字典 d) -> 字典
    字典 结果 = {}
    对于 k 在 d 循环
        结果[k] = f(d[k])
    结束
    返回 结果
结束

# 过滤：保留满足条件的键值对
函数 字典过滤(f, 字典 d) -> 字典
    字典 结果 = {}
    对于 k 在 d 循环
        如果 f(k, d[k]) 则
            结果[k] = d[k]
        结束
    结束
    返回 结果
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 字典库测试 ===")

# 基本操作
字典 d = {}
设置(d, "名字", "小明")
设置(d, "年龄", 20)
设置(d, "城市", "北京")
输出("字典 =", d)

输出("获取(名字) =", 获取(d, "名字", "未知"))
输出("获取(不存在) =", 获取(d, "不存在", "默认"))
输出("包含键(年龄) =", 包含键(d, "年龄"))
输出("包含键(xxx) =", 包含键(d, "xxx"))
输出("字典长度 =", 字典长度(d))

# 键值列表
输出("键列表 =", 键列表(d))
输出("值列表 =", 值列表(d))

# 合并拷贝
字典 d2 = {"职业": "工程师", "年龄": 25}
输出("合并 =", 合并(d, d2))
输出("拷贝 =", 拷贝(d))

# 高阶函数
函数 翻倍(整数 v)
    返回 v * 2
结束
函数 值大于18(键, 值)
    返回 值 > 18
结束

字典 数字字典 = {"语文": 90, "数学": 85, "英语": 95}
输出("字典映射(翻倍) =", 字典映射(翻倍, 数字字典))
输出("字典过滤(>18) =", 字典过滤(值大于18, 数字字典))

输出("=== 字典库测试完成 ===")
