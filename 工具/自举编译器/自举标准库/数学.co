# ============================================================
# 数学.co —— 自举标准库：数学函数库
# 包含：常数、三角、指数对数、数论、统计、随机工具
# ============================================================

# ---------------- 常数 ----------------
让 PI = 3.141592653589793
让 E = 2.718281828459045

# ---------------- 三角函数（泰勒展开） ----------------
# 正弦(x) 使用泰勒级数
函数 正弦(浮点 x) -> 浮点
    # 归一化到 [-π, π]
    当 x > PI 循环
        x = x - 2 * PI
    结束
    当 x < -PI 循环
        x = x + 2 * PI
    结束
    # 泰勒展开：x - x³/3! + x⁵/5! - x⁷/7! + x⁹/9!
    浮点 x2 = x * x
    浮点 x3 = x2 * x
    浮点 x5 = x3 * x2
    浮点 x7 = x5 * x2
    浮点 x9 = x7 * x2
    返回 x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0
结束

# 余弦(x) = 正弦(x + π/2)
函数 余弦(浮点 x) -> 浮点
    返回 正弦(x + PI / 2.0)
结束

# 正切(x) = 正弦(x) / 余弦(x)
函数 正切(浮点 x) -> 浮点
    浮点 c = 余弦(x)
    返回 正弦(x) / c
结束

# ---------------- 指数对数 ----------------
# 指数函数(x) 泰勒展开
函数 指数函数(浮点 x) -> 浮点
    浮点 结果 = 1.0
    浮点 项 = 1.0
    对于 i 从 1 到 20 循环
        项 = 项 * x / 转浮点(i)
        结果 = 结果 + 项
    结束
    返回 结果
结束

# 自然对数(x) 使用牛顿迭代法
函数 自然对数(浮点 x) -> 浮点
    如果 x <= 0.0 则
        返回 0.0
    结束
    # 初始猜测
    浮点 y = 1.0
    对于 i 从 0 到 30 循环
        浮点 ey = 指数函数(y)
        y = y + (x - ey) / ey
    结束
    返回 y
结束

# 幂(base, exp) = 指数函数(exp * 自然对数(base))
函数 幂(浮点 底, 浮点 指数) -> 浮点
    返回 指数函数(指数 * 自然对数(底))
结束

# sqrt(x) 牛顿迭代
函数 平方根(浮点 x) -> 浮点
    如果 x < 0.0 则
        返回 0.0
    结束
    如果 x == 0.0 则
        返回 0.0
    结束
    浮点 g = x / 2.0
    对于 i 从 0 到 50 循环
        g = (g + x / g) / 2.0
    结束
    返回 g
结束

# ---------------- 数论 ----------------
# 最大公约数（欧几里得算法）
函数 最大公约数(整数 a, 整数 b) -> 整数
    当 b != 0 循环
        整数 t = b
        b = a % b
        a = t
    结束
    返回 绝对值(a)
结束

# 最小公倍数
函数 最小公倍数(整数 a, 整数 b) -> 整数
    返回 绝对值(a * b) / 最大公约数(a, b)
结束

# 素数判断
函数 素数判断(整数 n) -> 整数
    如果 n < 2 则
        返回 0
    结束
    如果 n == 2 则
        返回 1
    结束
    如果 n % 2 == 0 则
        返回 0
    结束
    整数 i = 3
    当 i * i <= n 循环
        如果 n % i == 0 则
            返回 0
        结束
        i = i + 2
    结束
    返回 1
结束

# 质因数分解
函数 质因数分解(整数 n) -> 列表
    列表 因子 = []
    整数 d = 2
    当 d * d <= n 循环
        当 n % d == 0 循环
            追加(因子, d)
            n = n / d
        结束
        d = d + 1
    结束
    如果 n > 1 则
        追加(因子, n)
    结束
    返回 因子
结束

# ---------------- 统计 ----------------
# 平均值
函数 平均值(列表 xs) -> 浮点
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0.0
    结束
    浮点 总和 = 0.0
    对于 i 从 0 到 n - 1 循环
        总和 = 总和 + 转浮点(xs[i])
    结束
    返回 总和 / 转浮点(n)
结束

# 中位数
函数 中位数(列表 xs) -> 浮点
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0.0
    结束
    # 复制并排序（简单冒泡）
    列表 排序后 = []
    对于 i 从 0 到 n - 1 循环
        追加(排序后, xs[i])
    结束
    对于 i 从 0 到 n - 2 循环
        对于 j 从 0 到 n - 2 - i 循环
            如果 排序后[j] > 排序后[j + 1] 则
                整数 t = 排序后[j]
                排序后[j] = 排序后[j + 1]
                排序后[j + 1] = t
            结束
        结束
    结束
    如果 n % 2 == 1 则
        整数 mid = 转整数(n / 2)
        返回 转浮点(排序后[mid])
    结束
    整数 mid1 = 转整数(n / 2) - 1
    整数 mid2 = 转整数(n / 2)
    浮点 v1 = 转浮点(排序后[mid1])
    浮点 v2 = 转浮点(排序后[mid2])
    返回 (v1 + v2) / 2.0
结束

# 方差
函数 方差(列表 xs) -> 浮点
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 0.0
    结束
    浮点 m = 平均值(xs)
    浮点 总和 = 0.0
    对于 i 从 0 到 n - 1 循环
        浮点 d = 转浮点(xs[i]) - m
        总和 = 总和 + d * d
    结束
    返回 总和 / 转浮点(n)
结束

# 标准差
函数 标准差(列表 xs) -> 浮点
    返回 平方根(方差(xs))
结束

# ---------------- 随机工具 ----------------
# 简单LCG伪随机数生成器（基于时间戳种子）
让 随机种子 = 转整数(时间戳()) % 100000

函数 下一步随机() -> 浮点
    随机种子 = (随机种子 * 1103515245 + 12345) % 2147483648
    返回 转浮点(随机种子) / 2147483648.0
结束

# 随机范围 [最小, 最大)
函数 随机范围(整数 最小, 整数 最大) -> 整数
    整数 范围 = 最大 - 最小
    浮点 rv = 下一步随机()
    浮点 rf = 转浮点(范围)
    浮点 r = rv * rf
    返回 最小 + 转整数(r)
结束

# 洗牌（Fisher-Yates）
函数 洗牌(列表 xs)
    整数 n = 长度(xs)
    整数 i = n - 1
    当 i >= 1 循环
        整数 范围 = i + 1
        浮点 rv = 下一步随机()
        浮点 rf = 转浮点(范围)
        浮点 r = rv * rf
        整数 j = 转整数(r)
        整数 t = xs[i]
        xs[i] = xs[j]
        xs[j] = t
        i = i - 1
    结束
结束

