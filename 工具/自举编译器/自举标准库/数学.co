输出("正弦(0) =", 正弦(0.0))
输出("正弦(PI/2) =", 正弦(PI / 2.0))
输出("余弦(0) =", 余弦(0.0))
输出("余弦(PI) =", 余弦(PI))

# 指数对数测试
输出("指数函数(0) =", 指数函数(0.0))
输出("指数函数(1) =", 指数函数(1.0))
输出("自然对数(1) =", 自然对数(1.0))
输出("平方根(16) =", 平方根(16.0))
输出("幂(2, 3) =", 幂(2.0, 3.0))

# 数论测试
输出("最大公约数(12, 18) =", 最大公约数(12, 18))
输出("最小公倍数(4, 6) =", 最小公倍数(4, 6))
输出("素数判断(7) =", 素数判断(7))
输出("素数判断(10) =", 素数判断(10))
输出("质因数分解(60) =", 质因数分解(60))

# 统计测试
列表 数据 = [1, 2, 3, 4, 5]
输出("平均值 =", 平均值(数据))
输出("中位数 =", 中位数(数据))
输出("方差 =", 方差(数据))
输出("标准差 =", 标准差(数据))

# 随机测试
输出("随机范围(1, 100) =", 随机范围(1, 100))
列表 洗牌测试 = [1, 2, 3, 4, 5]
洗牌(洗牌测试)
输出("洗牌([1,2,3,4,5]) =", 洗牌测试)

输出("=== 数学库测试完成 ===")
