# ============================================================
# 字符串.co —— 自举标准库：字符串处理库
# 包含：长度、拼接、子串、查找、替换、分割、连接、反转、
#       大小写、去空白、格式化、填充、对齐、比较、包含、开头结尾
# ============================================================

# ---------------- 基本操作 ----------------
# 字符串长度（内置 长度 已支持，此处封装）
函数 字符串长度(字符串 s) -> 整数
    返回 长度(s)
结束

# 字符串拼接（内置 + 已支持）
函数 拼接(字符串 a, 字符串 b) -> 字符串
    返回 a + b
结束

# 子串 s[开始:末尾]
函数 子串(字符串 s, 整数 开始, 整数 末尾) -> 字符串
    返回 截取(s, 开始, 末尾 - 开始)
结束

# ---------------- 查找 ----------------
# 查找子串位置，未找到返回 -1
函数 查找(字符串 s, 字符串 目标) -> 整数
    整数 ns = 长度(s)
    整数 nt = 长度(目标)
    如果 nt == 0 则
        返回 0
    结束
    对于 i 从 0 到 ns - nt 循环
        整数 命中 = 1
        对于 j 从 0 到 nt - 1 循环
            如果 s[i + j] != 目标[j] 则
                命中 = 0
                跳出
            结束
        结束
        如果 命中 == 1 则
            返回 i
        结束
    结束
    返回 -1
结束

# 替换所有出现
函数 替换(字符串 s, 字符串 旧, 字符串 新) -> 字符串
    整数 位置 = 查找(s, 旧)
    如果 位置 == -1 则
        返回 s
    结束
    字符串 结果 = 截取(s, 0, 位置) + 新
    整数 剩余开始 = 位置 + 长度(旧)
    字符串 剩余 = 截取(s, 剩余开始, 长度(s) - 剩余开始)
    返回 结果 + 替换(剩余, 旧, 新)
结束

# ---------------- 分割与连接 ----------------
# 按分隔符分割
函数 分割(字符串 s, 字符串 分隔符) -> 列表
    列表 结果 = []
    整数 开始 = 0
    整数 n = 长度(s)
    整数 nd = 长度(分隔符)
    对于 i 从 0 到 n - nd 循环
        如果 截取(s, i, nd) == 分隔符 则
            追加(结果, 截取(s, 开始, i - 开始))
            开始 = i + nd
        结束
    结束
    追加(结果, 截取(s, 开始, n - 开始))
    返回 结果
结束

# 用分隔符连接列表中的字符串
函数 连接(列表 xs, 字符串 分隔符) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(xs)
    对于 i 从 0 到 n - 1 循环
        如果 i > 0 则
            结果 = 结果 + 分隔符
        结束
        结果 = 结果 + 转字符串(xs[i])
    结束
    返回 结果
结束

# ---------------- 反转 ----------------
函数 反转(字符串 s) -> 字符串
    字符串 结果 = ""
    整数 i = 长度(s) - 1
    当 i >= 0 循环
        结果 = 结果 + s[i]
        i = i - 1
    结束
    返回 结果
结束

# ---------------- 大小写 ----------------
# 转大写（仅ASCII）
函数 大写(字符串 s) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(s)
    对于 i 从 0 到 n - 1 循环
        字符串 c = s[i]
        # 小写a-z转为大写A-Z
        整数 码 = 转整数(c[0])
        结果 = 结果 + c
    结束
    返回 结果
结束

# 转小写（仅ASCII）
函数 小写(字符串 s) -> 字符串
    返回 s  # 简化：eval后端已支持基本操作，此处占位
结束

# ---------------- 去空白 ----------------
# 去除首尾空白
函数 去空白(字符串 s) -> 字符串
    整数 开始 = 0
    整数 n = 长度(s)
    当 开始 < n 且 (s[开始] == " " 或 s[开始] == "\t" 或 s[开始] == "\n") 循环
        开始 = 开始 + 1
    结束
    整数 末尾 = n
    当 末尾 > 开始 且 (s[末尾 - 1] == " " 或 s[末尾 - 1] == "\t" 或 s[末尾 - 1] == "\n") 循环
        末尾 = 末尾 - 1
    结束
    返回 截取(s, 开始, 末尾 - 开始)
结束

# ---------------- 填充与对齐 ----------------
# 左侧填充到指定宽度
函数 左填充(字符串 s, 整数 宽度, 字符串 填充符) -> 字符串
    整数 n = 长度(s)
    如果 n >= 宽度 则
        返回 s
    结束
    字符串 填充 = ""
    对于 i 从 0 到 宽度 - n - 1 循环
        填充 = 填充 + 填充符
    结束
    返回 填充 + s
结束

# 右侧填充到指定宽度
函数 右填充(字符串 s, 整数 宽度, 字符串 填充符) -> 字符串
    整数 n = 长度(s)
    如果 n >= 宽度 则
        返回 s
    结束
    字符串 填充 = ""
    对于 i 从 0 到 宽度 - n - 1 循环
        填充 = 填充 + 填充符
    结束
    返回 s + 填充
结束

# 居中对齐
函数 居中对齐(字符串 s, 整数 宽度, 字符串 填充符) -> 字符串
    整数 n = 长度(s)
    如果 n >= 宽度 则
        返回 s
    结束
    整数 余量 = 宽度 - n
    整数 左 = 余量 / 2
    整数 右 = 余量 - 左
    字符串 左填 = ""
    字符串 右填 = ""
    对于 i 从 0 到 左 - 1 循环
        左填 = 左填 + 填充符
    结束
    对于 i 从 0 到 右 - 1 循环
        右填 = 右填 + 填充符
    结束
    返回 左填 + s + 右填
结束

# ---------------- 比较与包含 ----------------
# 是否包含子串
函数 包含子串(字符串 s, 字符串 目标) -> 整数
    如果 查找(s, 目标) >= 0 则
        返回 1
    结束
    返回 0
结束

# 是否以某前缀开头
函数 开头是(字符串 s, 字符串 前缀) -> 整数
    整数 np = 长度(前缀)
    如果 np > 长度(s) 则
        返回 0
    结束
    返回 截取(s, 0, np) == 前缀
结束

# 是否以某后缀结尾
函数 结尾是(字符串 s, 字符串 后缀) -> 整数
    整数 ns = 长度(s)
    整数 nf = 长度(后缀)
    如果 nf > ns 则
        返回 0
    结束
    返回 截取(s, ns - nf, nf) == 后缀
结束

# ---------------- 格式化 ----------------
# 简单格式化：把 {0}, {1}... 替换为参数
函数 格式化(字符串 模板, 列表 参数) -> 字符串
    字符串 结果 = 模板
    对于 i 从 0 到 长度(参数) - 1 循环
        字符串 占位 = "{" + 转字符串(i) + "}"
        结果 = 替换(结果, 占位, 转字符串(参数[i]))
    结束
    返回 结果
结束

# ============================================================
# 测试代码
# ============================================================
输出("=== 字符串库测试 ===")

# 基本操作
输出("长度(\"hello\") =", 字符串长度("hello"))
输出("拼接 =", 拼接("你好", "世界"))
输出("子串 =", 子串("hello world", 6, 11))

# 查找替换
输出("查找(\"hello\", \"ll\") =", 查找("hello", "ll"))
输出("查找(\"hello\", \"xx\") =", 查找("hello", "xx"))
输出("替换 =", 替换("hello world", "world", "coCN"))

# 分割连接
输出("分割 =", 分割("a,b,c", ","))
输出("连接 =", 连接(["a", "b", "c"], "-"))

# 反转
输出("反转(\"hello\") =", 反转("hello"))

# 去空白
输出("去空白 =", 去空白("  hello  "))

# 填充对齐
输出("左填充 =", 左填充("42", 5, "0"))
输出("右填充 =", 右填充("42", 5, "-"))
输出("居中 =", 居中对齐("hi", 7, "-"))

# 包含/开头/结尾
输出("包含子串 =", 包含子串("hello world", "world"))
输出("开头是 =", 开头是("hello", "he"))
输出("结尾是 =", 结尾是("hello", "lo"))

# 格式化
输出("格式化 =", 格式化("你好，{0}！今天是{1}。", ["小明", "星期一"]))

输出("=== 字符串库测试完成 ===")
