# ============================================================
# 搜索.co —— 自举标准库：搜索算法库
# 包含：线性搜索、二分查找、插值查找、跳跃查找、指数查找
# ============================================================

# ---------------- 线性搜索 ----------------
# 返回目标索引，未找到返回 -1
函数 线性搜索(列表 xs, 目标) -> 整数
    对于 i 从 0 到 长度(xs) - 1 循环
        如果 xs[i] == 目标 则
            返回 i
        结束
    结束
    返回 -1
结束

# ---------------- 二分查找（有序数组） ----------------
函数 二分查找(列表 xs, 目标) -> 整数
    整数 左 = 0
    整数 右 = 长度(xs) - 1
    当 左 <= 右 循环
        整数 中 = 转整数((左 + 右) / 2)
        如果 xs[中] == 目标 则
            返回 中
        结束
        如果 xs[中] < 目标 则
            左 = 中 + 1
        否则
            右 = 中 - 1
        结束
    结束
    返回 -1
结束

# ---------------- 插值查找 ----------------
函数 插值查找(列表 xs, 目标) -> 整数
    整数 左 = 0
    整数 右 = 长度(xs) - 1
    当 左 <= 右 且 目标 >= xs[左] 且 目标 <= xs[右] 循环
        如果 左 == 右 则
            如果 xs[左] == 目标 则
                返回 左
            结束
            返回 -1
        结束
        # 插值公式
        整数 范围 = xs[右] - xs[左]
        如果 范围 == 0 则
            返回 -1
        结束
        整数 位置 = 左 + 转整数((转浮点(目标 - xs[左]) / 转浮点(范围)) * 转浮点(右 - 左))
        如果 xs[位置] == 目标 则
            返回 位置
        结束
        如果 xs[位置] < 目标 则
            左 = 位置 + 1
        否则
            右 = 位置 - 1
        结束
    结束
    返回 -1
结束

# ---------------- 跳跃查找 ----------------
函数 跳跃查找(列表 xs, 目标) -> 整数
    整数 n = 长度(xs)
    整数 间距 = 转整数(开平方(n))
    # 找块
    整数 前 = 0
    整数 下一个 = 间距
    当 下一个 < n 且 xs[下一个 - 1] <= 目标 循环
        前 = 下一个
        下一个 = 下一个 + 间距
        如果 下一个 > n 则
            下一个 = n
        结束
    结束
    # 线性搜索该块
    对于 i 从 前 到 下一个 - 1 循环
        如果 xs[i] == 目标 则
            返回 i
        结束
    结束
    返回 -1
结束

# 辅助：平方根（简化版）
函数 开平方(整数 n) -> 整数
    如果 n <= 0 则
        返回 0
    结束
    整数 g = 1
    当 g * g <= n 循环
        g = g + 1
    结束
    返回 g - 1
结束

# ---------------- 指数查找 ----------------
函数 指数查找(列表 xs, 目标) -> 整数
    整数 n = 长度(xs)
    如果 n == 0 则
        返回 -1
    结束
    如果 xs[0] == 目标 则
        返回 0
    结束
    # 找范围
    整数 界 = 1
    当 界 < n 且 xs[界] <= 目标 循环
        界 = 界 * 2
    结束
    # 二分查找该范围
    整数 左 = 转整数(界 / 2)
    整数 右 = 界
    如果 右 >= n 则
        右 = n - 1
    结束
    当 左 <= 右 循环
        整数 中 = 转整数((左 + 右) / 2)
        如果 xs[中] == 目标 则
            返回 中
        结束
        如果 xs[中] < 目标 则
            左 = 中 + 1
        否则
            右 = 中 - 1
        结束
    结束
    返回 -1
结束

