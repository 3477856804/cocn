# ============================================================
# elf.co —— ELF64 可执行文件生成器（纯 coCN 实现）
#
# 布局：
#   [ELF 头 64 字节][程序头 56 字节][代码 + 数据段]
#   基地址 0x400000 (4194304)，单 PT_LOAD 段（可读可执行）
#
# 本模块不使用导入，由 拼接.sh 拼接后与 机器码生成器.co 一起运行。
#
# 对外接口：
#   构建ELF64(列表 代码数据, 整数 入口偏移) -> 列表（完整 ELF 字节表）
#   基地址            （= 4194304）
#   ELF头大小         （= 64）
#   程序头大小        （= 56）
# ============================================================

# ---------------- 常量 ----------------
让 基地址 = 4194304
让 ELF头大小 = 64
让 程序头大小 = 56

# ---------------- 小端追加工具 ----------------

# 追加一个 8 位字节
函数 追加8(列表 字节, 整数 v)
    追加(字节, v & 255)
结束

# 追加一个 16 位小端整数
函数 追加16(列表 字节, 整数 v)
    追加(字节, v & 255)
    追加(字节, (v >> 8) & 255)
结束

# 追加一个 32 位小端整数
函数 追加32(列表 字节, 整数 v)
    追加(字节, v & 255)
    追加(字节, (v >> 8) & 255)
    追加(字节, (v >> 16) & 255)
    追加(字节, (v >> 24) & 255)
结束

# 追加一个 64 位小端整数（循环逐字节，兼容负数/大值）
函数 追加64(列表 字节, 整数 v)
    对于 i 从 0 到 7 循环
        追加(字节, v & 255)
        v = v >> 8
    结束
结束

# ============================================================
# 构建 ELF64
#   代码数据：紧跟程序头之后的字节列表（机器码 + 只读数据）
#   入口偏移：入口点相对代码段起始处的偏移（字节）
# 返回：完整 ELF 字节列表
# ============================================================
函数 构建ELF64(列表 代码数据, 整数 入口偏移) -> 列表
    整数 总长 = ELF头大小 + 程序头大小 + 长度(代码数据)
    列表 字节 = []

    # ---------- e_ident[16] ----------
    追加(字节, 127)   # 0x7F
    追加(字节, 69)    # 'E'
    追加(字节, 76)    # 'L'
    追加(字节, 70)    # 'F'
    追加(字节, 2)     # EI_CLASS = ELFCLASS64
    追加(字节, 1)     # EI_DATA  = 小端
    追加(字节, 1)     # EI_VERSION = EV_CURRENT
    # e_ident[7..15] 共 9 字节填 0
    对于 i 从 0 到 8 循环
        追加(字节, 0)
    结束

    # ---------- ELF 头其余字段 ----------
    追加16(字节, 2)                 # e_type = ET_EXEC
    追加16(字节, 62)                # e_machine = EM_X86_64
    追加32(字节, 1)                 # e_version
    追加64(字节, 基地址 + ELF头大小 + 程序头大小 + 入口偏移)  # e_entry
    追加64(字节, ELF头大小)         # e_phoff = 64
    追加64(字节, 0)                 # e_shoff = 0
    追加32(字节, 0)                 # e_flags = 0
    追加16(字节, ELF头大小)         # e_ehsize = 64
    追加16(字节, 程序头大小)         # e_phentsize = 56
    追加16(字节, 1)                 # e_phnum = 1
    追加16(字节, 0)                 # e_shentsize
    追加16(字节, 0)                 # e_shnum
    追加16(字节, 0)                 # e_shstrndx

    # ---------- 程序头 (56 字节) ----------
    追加32(字节, 1)                 # p_type = PT_LOAD
    追加32(字节, 5)                 # p_flags = PF_R | PF_X
    追加64(字节, 0)                 # p_offset = 0
    追加64(字节, 基地址)             # p_vaddr
    追加64(字节, 基地址)             # p_paddr
    追加64(字节, 总长)               # p_filesz
    追加64(字节, 总长)               # p_memsz
    追加64(字节, 4096)               # p_align = 0x1000

    # ---------- 代码 + 数据段 ----------
    对于 i 从 0 到 长度(代码数据) - 1 循环
        追加(字节, 代码数据[i] & 255)
    结束

    返回 字节
结束
