# ============================================================
# 测试优化器.co —— 自举优化器与寄存器分配器的测试
#
# 运行方式（与 优化器.co 拼接后由 coCN 解释器执行）：
#   cat 优化器.co 测试优化器.co | node bin/cocn.js
#   或：COCN_BACKEND=eval node bin/cocn.js <(cat 优化器.co 测试优化器.co)
# ============================================================

输出 "=========================================="
输出 "  优化器 / 寄存器分配器 测试"
输出 "=========================================="


# ============================================================
# 测试 1：常量折叠 —— 1 + 2*3 应折叠为 7
# ============================================================
函数 测试常量折叠()
    # b0: t1=1; t2=2; t3=3; t4=t2*t3; t5=t1+t4; return t5
    字典 fn = 新建函数("常量折叠", [])
    字典 b0 = fn["块"][0]
    追加(b0["指令"], 常量指令("t1", 1))
    追加(b0["指令"], 常量指令("t2", 2))
    追加(b0["指令"], 常量指令("t3", 3))
    追加(b0["指令"], 二元指令("mul", "t4", "t2", "t3"))
    追加(b0["指令"], 二元指令("add", "t5", "t1", "t4"))
    b0["终结"] = 返回终结("t5")
    建CFG(fn)

    常量传播(fn)

    # 找 t5 的最终指令
    字典 找到 = {}
    对于 i 从 0 到 长度(b0["指令"]) - 1 循环
        如果 b0["指令"][i]["dest"] == "t5"
            找到 = b0["指令"][i]
        结束
    结束
    断言(长度(键(找到)) > 0, "常量折叠：未找到 t5 指令")
    断言相等(找到["op"], "const", "常量折叠：t5 应被折叠成 const")
    断言相等(找到["值"], 7, "常量折叠：1+2*3 应等于 7")
    输出 "[通过] 测试1 常量折叠：t5 = const 7"
结束

测试常量折叠()


# ============================================================
# 测试 2：SSA 转换 —— 菱形控制流应在汇合块插入 phi
# ============================================================
函数 测试SSA菱形()
    # b0: x=1; if a goto b1 else b2
    # b1: x=2; goto b3
    # b2: goto b3
    # b3: y=x; return y
    字典 fn = 新建函数("菱形", ["a"])
    字典 b0 = fn["块"][0]
    字典 b1 = 新增块(fn)
    字典 b2 = 新增块(fn)
    字典 b3 = 新增块(fn)
    追加(b0["指令"], 常量指令("x", 1))
    b0["终结"] = 分支终结("a", 1, 2)
    追加(b1["指令"], 常量指令("x", 2))
    b1["终结"] = 跳转终结(3)
    b2["终结"] = 跳转终结(3)
    追加(b3["指令"], 移动指令("y", "x"))
    b3["终结"] = 返回终结("y")
    建CFG(fn)
    转SSA(fn)

    # 汇合块 b3 第一条必须是 phi
    字典 首 = b3["指令"][0]
    断言相等(首["op"], "phi", "SSA：汇合块块首应为 phi")
    断言相等(长度(首["实参"]), 2, "SSA：phi 应有 2 个实参")
    # 两个实参应来自不同版本（b1 的 x=2 与 b2 的 x=1）
    断言(首["实参"][0] != 首["实参"][1], "SSA：phi 两个实参应是不同版本")
    输出 "[通过] 测试2 SSA 菱形：b3 = phi(" + 首["实参"][0] + ", " + 首["实参"][1] + ")"
结束

测试SSA菱形()


# ============================================================
# 测试 3：支配树 —— 菱形的支配边界
# ============================================================
函数 测试支配边界()
    字典 fn = 新建函数("dom", ["a"])
    字典 b0 = fn["块"][0]
    字典 b1 = 新增块(fn)
    字典 b2 = 新增块(fn)
    字典 b3 = 新增块(fn)
    b0["终结"] = 分支终结("a", 1, 2)
    b1["终结"] = 跳转终结(3)
    b2["终结"] = 跳转终结(3)
    b3["终结"] = 返回终结("")
    建CFG(fn)
    字典 dom = 算支配(fn)
    # b1、b2 的支配边界都应是 b3
    断言(集有(dom["支配边界"][1], "3"), "支配边界：b1 的 DF 应含 b3")
    断言(集有(dom["支配边界"][2], "3"), "支配边界：b2 的 DF 应含 b3")
    输出 "[通过] 测试3 支配边界：DF(b1)=DF(b2)={b3}"
结束

测试支配边界()


# ============================================================
# 测试 4：寄存器分配（图着色）—— 三角形干涉图
# ============================================================
函数 测试寄存器分配()
    # 三个两两干涉的区间（三角形），k=3 应分到 3 种不同颜色
    列表 区间 = [{"v": "x", "开始": 0, "结束": 5}, {"v": "y", "开始": 1, "结束": 4}, {"v": "z", "开始": 2, "结束": 3}]
    字典 着色 = 图着色(区间, 3, [])
    字典 c = 着色["颜色"]
    断言(包含(c, "x") 且 包含(c, "y") 且 包含(c, "z"), "寄存器分配：x/y/z 都应着色")
    断言(c["x"] != c["y"], "寄存器分配：干涉的 x 与 y 颜色不同")
    断言(c["y"] != c["z"], "寄存器分配：干涉的 y 与 z 颜色不同")
    断言(c["x"] != c["z"], "寄存器分配：干涉的 x 与 z 颜色不同")
    输出 "[通过] 测试4 图着色：x=" + 转字符串(c["x"]) + " y=" + 转字符串(c["y"]) + " z=" + 转字符串(c["z"])
结束

测试寄存器分配()


# ============================================================
# 测试 5：寄存器溢出 —— k=2 装不下三角形，应溢出 1 个
# ============================================================
函数 测试寄存器溢出()
    列表 区间 = [{"v": "x", "开始": 0, "结束": 5}, {"v": "y", "开始": 1, "结束": 4}, {"v": "z", "开始": 2, "结束": 3}]
    字典 着色 = 图着色(区间, 2, [])
    断言(长度(着色["溢出"]) == 1, "寄存器溢出：2 个寄存器装 3 个干涉变量应溢出 1 个")
    输出 "[通过] 测试5 寄存器溢出：溢出变量数 = 1"
结束

测试寄存器溢出()


# ============================================================
# 测试 6：循环不变量外提
# ============================================================
函数 测试不变量外提()
    # b0: a=5; i=0; goto b1
    # b1: t=a*2; c=i+1; if c<10 goto b2 else b3
    # b2: i=c; goto b1
    # b3: return t
    字典 fn = 新建函数("循环", ["a"])
    字典 b0 = fn["块"][0]
    字典 b1 = 新增块(fn)
    字典 b2 = 新增块(fn)
    字典 b3 = 新增块(fn)
    追加(b0["指令"], 常量指令("i", 0))
    b0["终结"] = 跳转终结(1)
    追加(b1["指令"], 二元指令("mul", "t", "a", "a"))
    追加(b1["指令"], 二元指令("add", "c", "i", "i"))
    b1["终结"] = 分支终结("c", 2, 3)
    追加(b2["指令"], 移动指令("i", "c"))
    b2["终结"] = 跳转终结(1)
    b3["终结"] = 返回终结("t")
    建CFG(fn)

    字典 dom = 算支配(fn)
    列表 循环表 = 找自然循环(fn, dom)
    断言(长度(循环表) >= 1, "循环识别：应找到至少一个自然循环")
    外提不变量(fn, 循环表[0])

    # t = a*a 是循环不变量，应被外提到前置块 b0
    布尔 t在外 = 假
    对于 i 从 0 到 长度(b0["指令"]) - 1 循环
        如果 b0["指令"][i]["dest"] == "t"
            t在外 = 真
        结束
    结束
    断言(t在外, "循环不变量外提：t=a*a 应被外提到前置块")
    输出 "[通过] 测试6 循环不变量外提：t=a*a 已提到前置块"
结束

测试不变量外提()


# ============================================================
# 测试 7：死代码消除 —— 无用赋值应被删除
# ============================================================
函数 测试死代码()
    # b0: a=1; b=2; c=a+b; d=99(死); return c
    字典 fn = 新建函数("dce", [])
    字典 b0 = fn["块"][0]
    追加(b0["指令"], 常量指令("a", 1))
    追加(b0["指令"], 常量指令("b", 2))
    追加(b0["指令"], 二元指令("add", "c", "a", "b"))
    追加(b0["指令"], 常量指令("d", 99))
    b0["终结"] = 返回终结("c")
    建CFG(fn)
    死代码消除(fn)
    # d 未被使用，应被删
    布尔 还见d = 假
    对于 i 从 0 到 长度(b0["指令"]) - 1 循环
        如果 b0["指令"][i]["dest"] == "d"
            还见d = 真
        结束
    结束
    断言(非 还见d, "DCE：无用赋值 d=99 应被删除")
    输出 "[通过] 测试7 死代码消除：d=99 已删除"
结束

测试死代码()


# ============================================================
# 测试 8：公共子表达式消除
# ============================================================
函数 测试CSE()
    # b0: a=1; b=2; c=a+b; d=a+b; return c+d
    字典 fn = 新建函数("cse", [])
    字典 b0 = fn["块"][0]
    追加(b0["指令"], 常量指令("a", 1))
    追加(b0["指令"], 常量指令("b", 2))
    追加(b0["指令"], 二元指令("add", "c", "a", "b"))
    追加(b0["指令"], 二元指令("add", "d", "a", "b"))
    追加(b0["指令"], 二元指令("add", "e", "c", "d"))
    b0["终结"] = 返回终结("e")
    建CFG(fn)
    公共子表达式消除(fn)
    # 第二条 add d=a+b 应被替换为 mov d, c
    字典 找到 = {}
    对于 i 从 0 到 长度(b0["指令"]) - 1 循环
        如果 b0["指令"][i]["dest"] == "d"
            找到 = b0["指令"][i]
        结束
    结束
    断言(找到["op"] == "mov", "CSE：重复的 d=a+b 应替换为 mov")
    输出 "[通过] 测试8 CSE：d = mov c"
结束

测试CSE()


# ============================================================
# 测试 9：完整流水线端到端
# ============================================================
函数 测试流水线()
    字典 fn = 新建函数("main", ["x"])
    字典 b0 = fn["块"][0]
    追加(b0["指令"], 常量指令("one", 1))
    追加(b0["指令"], 二元指令("add", "y", "x", "one"))
    b0["终结"] = 返回终结("y")
    字典 结果 = 优化函数(fn)
    字典 分配 = 结果["分配"]
    # x 与 y 应分到具体寄存器（名字以 r 开头）
    断言(包含(分配["映射"], "x#1"), "流水线：参数 x 应有寄存器分配")
    输出 "[通过] 测试9 完整流水线：函数已优化并分配寄存器"
结束

测试流水线()


输出 "=========================================="
输出 "  全部测试通过！"
输出 "=========================================="
