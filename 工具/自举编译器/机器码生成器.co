# ============================================================
# 机器码生成器.co —— AST -> x86-64 机器码 -> ELF64 字节表
#
# 完全跳过汇编器与 gcc，直接编码机器指令。
# System V AMD64 ABI，栈帧基于 rbp。
# 内置运行时（print_str / print_int / print_nl）纯机器码实现，
# 通过 Linux syscall（write=1, exit=60）输出。
#
# 本文件不使用导入，由 拼接 词法分析器.co + 语法分析器.co + elf.co 后运行。
# 对外入口：
#   编译到字节表(ast) -> 列表（代码+数据 字节表）
#   编译到ELF(ast)    -> 列表（完整 ELF 字节表）
# ============================================================

# ---------------- 寄存器编码 ----------------
# rax=0 rcx=1 rdx=2 rbx=3 rsp=4 rbp=5 rsi=6 rdi=7 r8..r15=8..15
# 调用约定整数寄存器顺序：rdi rsi rdx rcx r8 r9
让 ARG_RDI = 7
让 ARG_RSI = 6
让 ARG_RDX = 2
让 ARG_RCX = 1
让 ARG_R8 = 8
让 ARG_R9 = 9
# 参数寄存器表
让 参数寄存器 = [7, 6, 2, 1, 8, 9]

让 R_RAX = 0
让 R_RCX = 1
让 R_RDX = 2
让 R_RBX = 3
让 R_RSP = 4
让 R_RBP = 5
让 R_RSI = 6
让 R_RDI = 7
让 R_R10 = 10
让 R_R12 = 12
让 R_R13 = 13

# ============================================================
# Emitter —— 字节发射器（全局 G_em）
# ============================================================
让 G_em = {"字节": [], "标签位置": {}, "修复": [], "序号": 0}

函数 发射位置() -> 整数
    返回 长度(G_em["字节"])
结束

函数 出字节(整数 v)
    追加(G_em["字节"], v & 255)
结束

函数 出字节表(列表 arr)
    对于 i 从 0 到 长度(arr) - 1 循环
        追加(G_em["字节"], arr[i] & 255)
    结束
结束

函数 出32(整数 n)
    出字节(n & 255)
    出字节((n >> 8) & 255)
    出字节((n >> 16) & 255)
    出字节((n >> 24) & 255)
结束

函数 出64(整数 n)
    对于 i 从 0 到 7 循环
        出字节(n & 255)
        n = n >> 8
    结束
结束

函数 打标签(字符串 名)
    G_em["标签位置"][名] = 发射位置()
结束

函数 新标签(字符串 前缀) -> 字符串
    G_em["序号"] = G_em["序号"] + 1
    返回 前缀 + "_" + 转字符串(G_em["序号"])
结束

函数 占位相对32(字符串 名)
    追加(G_em["修复"], {"位置": 发射位置(), "标签": 名, "类型": "rel32"})
    出32(0)
结束

函数 占位数据64(字符串 名)
    追加(G_em["修复"], {"位置": 发射位置(), "标签": 名, "类型": "abs64"})
    出64(0)
结束

# 修复所有标签引用
函数 修复标签(整数 codeSize, 字典 数据标签偏移)
    对于 i 从 0 到 长度(G_em["修复"]) - 1 循环
        字典 f = G_em["修复"][i]
        字符串 lbl = f["标签"]
        整数 pos = f["位置"]
        整数 target = 0
        如果 f["类型"] == "abs64" 则
            target = 数据标签偏移[lbl]
        否则 若 f["类型"] == "abscode64" 则
            target = G_em["标签位置"][lbl]
        否则
            target = G_em["标签位置"][lbl]
        结束
        如果 f["类型"] == "rel32" 则
            整数 rel = target - (pos + 4)
            G_em["字节"][pos] = rel & 255
            G_em["字节"][pos + 1] = (rel >> 8) & 255
            G_em["字节"][pos + 2] = (rel >> 16) & 255
            G_em["字节"][pos + 3] = (rel >> 24) & 255
        否则
            整数 absv = 基地址 + ELF头大小 + 程序头大小 + codeSize + target
            如果 f["类型"] == "abscode64" 则
                absv = 基地址 + ELF头大小 + 程序头大小 + target
            结束
            对于 k 从 0 到 7 循环
                G_em["字节"][pos + k] = absv & 255
                absv = absv >> 8
            结束
        结束
    结束
结束

# ============================================================
# 指令编码辅助
# ============================================================

# 寄存器是否为 r8..r15
函数 位8(整数 r) -> 整数
    如果 r >= 8 则
        返回 1
    结束
    返回 0
结束

# REX 前缀：0x40 | W*8 | R*4 | X*2 | B*1
函数 REX(整数 W, 整数 R_, 整数 X, 整数 B) -> 整数
    整数 v = 64
    如果 W != 0 则 v = v + 8 结束
    如果 R_ != 0 则 v = v + 4 结束
    如果 X != 0 则 v = v + 2 结束
    如果 B != 0 则 v = v + 1 结束
    返回 v
结束

# ModR/M 字节
函数 ModRM(整数 mod, 整数 reg, 整数 rm) -> 整数
    返回 (((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)) & 255
结束

# disp 是否在 int8 范围
函数 适配disp8(整数 d) -> 整数
    如果 d >= -128 且 d <= 127 则
        返回 1
    结束
    返回 0
结束

# mov r64, r64
函数 移动RR(整数 d, 整数 s)
    出字节(REX(1, 位8(d), 0, 位8(s)))
    出字节(139)   # 0x8B
    出字节(ModRM(3, d & 7, s & 7))
结束

# mov r64, imm64
函数 移动立即64(整数 r, 整数 imm)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(184 + (r & 7))   # 0xB8 + r
    出64(imm)
结束

# mov r64, [rbp + disp]
函数 移动RMem(整数 r, 整数 disp)
    如果 适配disp8(disp) == 1 则
        出字节(REX(1, 位8(r), 0, 0))
        出字节(139)
        出字节(ModRM(1, r & 7, R_RBP & 7))
        出字节(disp & 255)
    否则
        出字节(REX(1, 位8(r), 0, 0))
        出字节(139)
        出字节(ModRM(2, r & 7, R_RBP & 7))
        出32(disp)
    结束
结束

# mov [rbp + disp], r64
函数 移动MemR(整数 disp, 整数 r)
    如果 适配disp8(disp) == 1 则
        出字节(REX(1, 位8(r), 0, 0))
        出字节(137)   # 0x89
        出字节(ModRM(1, r & 7, R_RBP & 7))
        出字节(disp & 255)
    否则
        出字节(REX(1, 位8(r), 0, 0))
        出字节(137)
        出字节(ModRM(2, r & 7, R_RBP & 7))
        出32(disp)
    结束
结束

# push r64
函数 压栈(整数 r)
    出字节(REX(0, 0, 0, 位8(r)))
    出字节(80 + (r & 7))   # 0x50
结束

# pop r64
函数 弹栈(整数 r)
    出字节(REX(0, 0, 0, 位8(r)))
    出字节(88 + (r & 7))   # 0x58
结束

# add r64, r64  (d += s)
函数 加RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(1)
    出字节(ModRM(3, s & 7, d & 7))
结束

# sub r64, r64  (d -= s)
函数 减RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(41)   # 0x29
    出字节(ModRM(3, s & 7, d & 7))
结束

# imul r64, r64  (d *= s)
函数 乘RR(整数 d, 整数 s)
    出字节(REX(1, 位8(d), 0, 位8(s)))
    出字节表([15, 175])   # 0F AF
    出字节(ModRM(3, d & 7, s & 7))
结束

# idiv r64  (rdx:rax / r)
函数 整除(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(247)   # F7
    出字节(ModRM(3, 7, r & 7))
结束

# cqo
函数 符号扩展()
    出字节表([72, 153])
结束

# neg r64
函数 取负(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(247)
    出字节(ModRM(3, 3, r & 7))
结束

# cmp r64, r64  (d - s)
函数 比较RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(57)   # 0x39
    出字节(ModRM(3, s & 7, d & 7))
结束

# test r64, r64
函数 测试RR(整数 a, 整数 b)
    出字节(REX(1, 位8(b), 0, 位8(a)))
    出字节(133)   # 0x85
    出字节(ModRM(3, b & 7, a & 7))
结束

# xor r64, r64
函数 异或RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(49)   # 0x31
    出字节(ModRM(3, s & 7, d & 7))
结束

# and r64, r64
函数 与RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(33)   # 0x21
    出字节(ModRM(3, s & 7, d & 7))
结束

# or r64, r64
函数 或RR(整数 d, 整数 s)
    出字节(REX(1, 位8(s), 0, 位8(d)))
    出字节(9)    # 0x09
    出字节(ModRM(3, s & 7, d & 7))
结束

# sal r64, cl
函数 左移CL(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(211)  # D3
    出字节(ModRM(3, 4, r & 7))
结束

# sal r64, imm8
函数 左移立即(整数 r, 整数 imm)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(193)  # C1 /4
    出字节(ModRM(3, 4, r & 7))
    出字节(imm & 255)
结束

# sar r64, cl
函数 右移CL(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(211)
    出字节(ModRM(3, 7, r & 7))
结束

# inc r64
函数 自增(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(255)  # FF
    出字节(ModRM(3, 0, r & 7))
结束

# syscall
函数 系统调用()
    出字节表([15, 5])
结束

# rdtsc  -> RDX:RAX（时间戳/伪随机源）
函数 读时间戳()
    出字节表([15, 49])
结束

# ret
函数 返回指令()
    出字节(195)  # C3
结束

# leave
函数 栈帧结束()
    出字节(201)  # C9
结束

# jmp rel32
函数 跳转(字符串 lbl)
    出字节(233)  # E9
    占位相对32(lbl)
结束

# jcc rel32
函数 条件跳转(整数 cc, 字符串 lbl)
    出字节表([15, cc])
    占位相对32(lbl)
结束

# call rel32
函数 调用(字符串 lbl)
    出字节(232)  # E8
    占位相对32(lbl)
结束

# call r64  (间接调用，FF /2)
函数 调用寄存器(整数 r)
    出字节(REX(1, 0, 0, 位8(r)))
    出字节(255)   # FF
    出字节(ModRM(3, 2, r & 7))
结束

# setcc al
函数 置位CC(整数 cc)
    出字节表([15, cc, 192])
结束

# movzx eax, al
函数 零扩展AX()
    出字节表([15, 182, 192])   # 0F B6 C0
结束

# sub rsp, N
函数 减栈(整数 n)
    如果 n <= 127 则
        出字节表([72, 131, 236, n & 255])
    否则
        出字节表([72, 129, 236])
        出32(n)
    结束
结束

# add rsp, N
函数 加栈(整数 n)
    出字节表([72, 131, 196, n & 255])
结束

# ============================================================
# FuncCtx —— 函数上下文（字典）
# ============================================================
函数 新建上下文() -> 字典
    返回 {"槽": {}, "槽数": 0, "临时SP": 0, "返回类型": "none", "跳出栈": [], "继续栈": []}
结束

# 分配栈槽变量，返回 rbp 负偏移
函数 分配变量(字典 ctx, 字符串 名, 字符串 k) -> 整数
    整数 off = -8 * (ctx["槽数"] + 1)
    ctx["槽"][名] = {"偏移": off, "种类": k}
    ctx["槽数"] = ctx["槽数"] + 1
    返回 off
结束

# 取变量槽信息
函数 取槽(字典 ctx, 字符串 名) -> 字典
    返回 ctx["槽"][名]
结束

# 新临时槽（临时区从 rbp-8*(64+1) 起）
函数 新临时(字典 ctx) -> 整数
    整数 idx = 64 + ctx["临时SP"]
    ctx["临时SP"] = ctx["临时SP"] + 1
    返回 -8 * (idx + 1)
结束

函数 释放临时(字典 ctx, 整数 n)
    ctx["临时SP"] = ctx["临时SP"] - n
结束

# 栈帧总大小（对齐 16）
函数 栈大小(字典 ctx) -> 整数
    整数 eff = ctx["槽数"]
    整数 t = 64 + 48
    如果 t > eff 则
        eff = t
    结束
    整数 n = eff * 8
    n = (n + 15) & (-16)
    返回 n
结束

# ============================================================
# 生成器全局状态
# ============================================================
让 G_ast = {"语句": []}
让 G_函数标签 = {}
让 G_函数返回 = {}
让 G_函数形参数 = {}
让 G_字符串标签 = {}
让 G_只读表 = []

# 类型标注 -> 种类
函数 类型标注(字符串 a) -> 字符串
    如果 a == "整数" 或 a == "布尔" 则
        返回 "int"
    结束
    返回 "int"
结束

# 判断空值哨兵节点
函数 是空值(节点) -> 整数
    如果 类型(节点) != "字典" 则
        返回 0
    结束
    如果 包含(节点, "类型") 且 节点["类型"] == "空值" 则
        返回 1
    结束
    返回 0
结束

# ============================================================
# 数据段
# ============================================================
函数 字符串常量(字符串 s) -> 字符串
    如果 包含(G_字符串标签, s) 则
        返回 G_字符串标签[s]
    结束
    字符串 lbl = "DSTR_" + 转字符串(长度(G_只读表))
    G_字符串标签[s] = lbl
    列表 字节 = []
    对于 i 从 0 到 长度(s) - 1 循环
        追加(字节, 转ASCII(s[i]) & 255)
    结束
    追加(字节, 0)
    追加(G_只读表, {"标签": lbl, "字节": 字节})
    返回 lbl
结束

函数 构建数据() -> 字典
    列表 字节 = []
    字典 标签偏移 = {}
    整数 off = 0
    对于 i 从 0 到 长度(G_只读表) - 1 循环
        标签偏移[G_只读表[i]["标签"]] = off
        列表 db = G_只读表[i]["字节"]
        对于 j 从 0 到 长度(db) - 1 循环
            追加(字节, db[j])
        结束
        off = off + 长度(db)
    结束
    当 off % 8 != 0 循环
        追加(字节, 0)
        off = off + 1
    结束
    返回 {"字节": 字节, "标签偏移": 标签偏移}
结束

# ============================================================
# 内置运行时（纯机器码）
# ============================================================
函数 生成打印串()
    打标签("rt_print_str")
    压栈(R_RBX)
    移动RR(R_RBX, R_RDI)        # rbx = str
    异或RR(R_RCX, R_RCX)         # rcx = len = 0
    字符串 环标 = 新标签("ps_lp")
    字符串 完标 = 新标签("ps_dn")
    打标签(环标)
    出字节表([72, 15, 182, 4, 11])   # movzx rax, byte [rbx+rcx]
    测试RR(R_RAX, R_RAX)
    条件跳转(132, 完标)          # jz
    自增(R_RCX)
    跳转(环标)
    打标签(完标)
    移动立即64(R_RDI, 1)
    移动RR(R_RSI, R_RBX)
    移动RR(R_RDX, R_RCX)
    移动立即64(R_RAX, 1)
    系统调用()
    弹栈(R_RBX)
    返回指令()
结束

函数 生成打印整()
    打标签("rt_print_int")
    压栈(R_RBP)
    移动RR(R_RBP, R_RSP)
    压栈(R_RBX)
    压栈(R_R12)
    压栈(R_R13)
    移动RR(R_RBX, R_RDI)         # rbx = value
    减栈(32)                      # 32 字节缓冲区

    # 处理 0
    测试RR(R_RBX, R_RBX)
    字符串 非零 = 新标签("pi_nz")
    字符串 完0 = 新标签("pi_d0")
    条件跳转(133, 非零)          # jnz
    # 输出 "0"
    出字节表([198, 68, 36, 0, 48])   # mov byte [rsp], '0'
    移动立即64(R_RDI, 1)
    移动RR(R_RSI, R_RSP)
    移动立即64(R_RDX, 1)
    移动立即64(R_RAX, 1)
    系统调用()
    跳转(完0)

    打标签(非零)
    # 处理负数
    测试RR(R_RBX, R_RBX)
    字符串 正数 = 新标签("pi_pos")
    条件跳转(137, 正数)          # jns
    取负(R_RBX)
    出字节表([198, 68, 36, 0, 45])   # mov byte [rsp], '-'
    移动立即64(R_RDI, 1)
    移动RR(R_RSI, R_RSP)
    移动立即64(R_RDX, 1)
    移动立即64(R_RAX, 1)
    系统调用()
    打标签(正数)

    # 转换：从 rsp+31 往前填
    异或RR(R_R13, R_R13)         # r13 = 位数
    字符串 转循环 = 新标签("pi_cl")
    字符串 转完 = 新标签("pi_cd")
    打标签(转循环)
    测试RR(R_RBX, R_RBX)
    条件跳转(132, 转完)          # jz

    移动RR(R_RAX, R_RBX)
    符号扩展()
    移动立即64(R_R10, 10)
    整除(R_R10)                  # rax=quot, rdx=rem
    移动RR(R_RBX, R_RAX)

    移动立即64(R_RAX, 48)
    加RR(R_RDX, R_RAX)           # rdx = rem + '0'

    # 存到 [rsp + 31 - r13]
    移动RR(R_RAX, R_RSP)
    移动立即64(R_RCX, 31)
    加RR(R_RAX, R_RCX)
    减RR(R_RAX, R_R13)
    出字节表([136, 16])          # mov [rax], dl
    自增(R_R13)
    跳转(转循环)
    打标签(转完)

    # 输出
    移动RR(R_RSI, R_RSP)
    移动立即64(R_RCX, 32)
    加RR(R_RSI, R_RCX)
    减RR(R_RSI, R_R13)
    移动RR(R_RDX, R_R13)
    移动立即64(R_RDI, 1)
    移动立即64(R_RAX, 1)
    系统调用()

    打标签(完0)
    加栈(32)
    弹栈(R_R13)
    弹栈(R_R12)
    弹栈(R_RBX)
    弹栈(R_RBP)
    返回指令()
结束

函数 生成打印换行()
    打标签("rt_print_nl")
    压栈(R_RAX)
    压栈(R_RDI)
    压栈(R_RSI)
    压栈(R_RDX)
    压栈(R_RCX)
    减栈(16)
    出字节表([198, 4, 36, 10])   # mov byte [rsp], '\n'
    移动立即64(R_RDI, 1)
    移动RR(R_RSI, R_RSP)
    移动立即64(R_RDX, 1)
    移动立即64(R_RAX, 1)
    系统调用()
    加栈(16)
    弹栈(R_RCX)
    弹栈(R_RDX)
    弹栈(R_RSI)
    弹栈(R_RDI)
    弹栈(R_RAX)
    返回指令()
结束

# ============================================================
# 语句 / 表达式代码生成（前向声明辅助在下方）
# ============================================================

# ---- 表达式：返回种类字符串 ----
函数 生成表达式(字典 node, 字典 ctx) -> 字符串
    字符串 类型 = node["类型"]
    如果 类型 == "字面量" 则
        返回 生成字面量(node, ctx)
    结束
    如果 类型 == "标识符" 则
        # 函数作值：名字是全局函数但未被局部槽遮蔽 -> 加载其代码标签绝对地址
        如果 非 包含(ctx["槽"], node["名字"]) 且 包含(G_函数标签, node["名字"]) 则
            移动立即64(R_RAX, 0)
            整数 fp = 发射位置() - 8
            追加(G_em["修复"], {"位置": fp, "标签": G_函数标签[node["名字"]], "类型": "abscode64"})
            返回 "func"
        结束
        字典 s = 取槽(ctx, node["名字"])
        移动RMem(R_RAX, s["偏移"])
        返回 s["种类"]
    结束
    如果 类型 == "一元" 则
        返回 生成一元(node, ctx)
    结束
    如果 类型 == "二元" 则
        返回 生成二元(node, ctx)
    结束
    如果 类型 == "函数调用" 则
        返回 生成调用(node, ctx)
    结束
    返回 "none"
结束

函数 生成字面量(字典 node, 字典 ctx) -> 字符串
    字符串 lt = node["字面类型"]
    如果 lt == "整数" 或 lt == "布尔" 则
        移动立即64(R_RAX, 转整数(node["值"]))
        返回 "int"
    结束
    如果 lt == "字符串" 则
        字符串 lbl = 字符串常量(node["值"])
        移动立即64(R_RAX, 0)
        整数 fp = 发射位置() - 8
        追加(G_em["修复"], {"位置": fp, "标签": lbl, "类型": "abs64"})
        返回 "str"
    结束
    移动立即64(R_RAX, 0)
    返回 "none"
结束

函数 生成一元(字典 node, 字典 ctx) -> 字符串
    字符串 k = 生成表达式(node["操作数"], ctx)
    字符串 op = node["运算符"]
    如果 op == "-" 则
        取负(R_RAX)
        返回 "int"
    结束
    如果 op == "+" 则
        返回 k
    结束
    如果 op == "非" 则
        测试RR(R_RAX, R_RAX)
        置位CC(148)             # sete al
        零扩展AX()
        返回 "int"
    结束
    返回 k
结束

# 比较：rax=右, 左值在槽 slotL
函数 生成比较(字符串 op, 整数 slotL, 字典 ctx) -> 字符串
    移动RR(R_R10, R_RAX)        # r10 = right
    移动RMem(R_RAX, slotL)      # rax = left
    比较RR(R_RAX, R_R10)
    整数 cc = 0
    如果 op == "<" 则 cc = 156 结束     # setl
    如果 op == ">" 则 cc = 159 结束     # setg
    如果 op == "<=" 则 cc = 158 结束    # setle
    如果 op == ">=" 则 cc = 157 结束    # setge
    如果 op == "==" 则 cc = 148 结束    # sete
    如果 op == "!=" 则 cc = 149 结束    # setne
    置位CC(cc)
    零扩展AX()
    释放临时(ctx, 1)
    返回 "int"
结束

函数 生成二元(字典 node, 字典 ctx) -> 字符串
    字符串 op = node["运算符"]
    如果 op == "且" 则
        返回 生成与短路(node, ctx)
    结束
    如果 op == "或" 则
        返回 生成或短路(node, ctx)
    结束

    # 左值存临时槽
    生成表达式(node["左"], ctx)
    整数 槽L = 新临时(ctx)
    移动MemR(槽L, R_RAX)
    # 右值在 rax
    生成表达式(node["右"], ctx)

    # 比较
    如果 op == "<" 或 op == ">" 或 op == "<=" 或 op == ">=" 或 op == "==" 或 op == "!=" 则
        返回 生成比较(op, 槽L, ctx)
    结束

    移动RR(R_R10, R_RAX)        # r10 = right
    移动RMem(R_RAX, 槽L)        # rax = left
    如果 op == "+" 则
        加RR(R_RAX, R_R10)
    否则 若 op == "-" 则
        减RR(R_RAX, R_R10)
    否则 若 op == "*" 则
        乘RR(R_RAX, R_R10)
    否则 若 op == "//" 或 op == "/" 或 op == "%" 则
        符号扩展()
        整除(R_R10)
        如果 op == "%" 则
            移动RR(R_RAX, R_RDX)
        结束
    否则 若 op == "&" 则
        与RR(R_RAX, R_R10)
    否则 若 op == "|" 则
        或RR(R_RAX, R_R10)
    否则 若 op == "^" 则
        异或RR(R_RAX, R_R10)
    否则 若 op == "<<" 则
        移动RR(R_RCX, R_R10)
        左移CL(R_RAX)
    否则 若 op == ">>" 则
        移动RR(R_RCX, R_R10)
        右移CL(R_RAX)
    结束
    释放临时(ctx, 1)
    返回 "int"
结束

函数 生成与短路(字典 node, 字典 ctx) -> 字符串
    生成表达式(node["左"], ctx)
    字符串 假标 = 新标签("and_f")
    字符串 尾标 = 新标签("and_e")
    测试RR(R_RAX, R_RAX)
    条件跳转(132, 假标)          # jz
    生成表达式(node["右"], ctx)
    测试RR(R_RAX, R_RAX)
    置位CC(149)                 # setne
    零扩展AX()
    跳转(尾标)
    打标签(假标)
    异或RR(R_RAX, R_RAX)
    打标签(尾标)
    返回 "int"
结束

函数 生成或短路(字典 node, 字典 ctx) -> 字符串
    生成表达式(node["左"], ctx)
    字符串 真标 = 新标签("or_t")
    字符串 尾标2 = 新标签("or_e")
    测试RR(R_RAX, R_RAX)
    条件跳转(133, 真标)          # jnz
    生成表达式(node["右"], ctx)
    测试RR(R_RAX, R_RAX)
    置位CC(149)
    零扩展AX()
    跳转(尾标2)
    打标签(真标)
    移动立即64(R_RAX, 1)
    打标签(尾标2)
    返回 "int"
结束

# ---- 函数调用 ----
函数 生成打印(列表 参数, 字典 ctx)
    整数 首个 = 1
    对于 i 从 0 到 长度(参数) - 1 循环
        如果 首个 == 0 则
            调用("rt_print_space")
        结束
        首个 = 0
        字符串 k = 生成表达式(参数[i], ctx)
        移动RR(R_RDI, R_RAX)
        如果 k == "str" 则
            调用("rt_print_str")
        否则
            调用("rt_print_int")
        结束
    结束
    调用("rt_print_nl")
结束

函数 生成调用(字典 node, 字典 ctx) -> 字符串
    字典 被调 = node["被调者"]
    字符串 名字 = ""
    如果 被调["类型"] == "标识符" 则
        名字 = 被调["名字"]
    结束
    如果 名字 == "输出" 则
        生成打印(node["参数"], ctx)
        返回 "none"
    结束
    # 内置：绝对值(x) —— 整数取绝对值
    如果 名字 == "绝对值" 则
        生成表达式(node["参数"][0], ctx)
        测试RR(R_RAX, R_RAX)
        字符串 非负 = 新标签("abs_p")
        条件跳转(137, 非负)          # jns
        取负(R_RAX)
        打标签(非负)
        返回 "int"
    结束
    # 内置：最大值(a,b) / 最小值(a,b) —— 整数比较选择
    如果 名字 == "最大值" 或 名字 == "最小值" 则
        生成表达式(node["参数"][0], ctx)
        整数 槽A = 新临时(ctx)
        移动MemR(槽A, R_RAX)
        生成表达式(node["参数"][1], ctx)
        移动RR(R_R10, R_RAX)        # r10 = b
        移动RMem(R_RAX, 槽A)        # rax = a
        比较RR(R_RAX, R_R10)
        字符串 保留左 = 新标签("sel_l")
        字符串 完 = 新标签("sel_e")
        如果 名字 == "最大值" 则
            条件跳转(141, 保留左)    # jge a>=b 保留 a
        否则
            条件跳转(142, 保留左)    # jle a<=b 保留 a
        结束
        移动RR(R_RAX, R_R10)        # 保留 b
        跳转(完)
        打标签(保留左)
        打标签(完)
        释放临时(ctx, 1)
        返回 "int"
    结束
    # 内置：转整数(x) —— 纯整数后端，恒等
    如果 名字 == "转整数" 则
        生成表达式(node["参数"][0], ctx)
        返回 "int"
    结束
    # 异常相关存根：本后端无全局异常槽/字典，按整数语义尽力返回
    如果 名字 == "已抛出" 则
        移动立即64(R_RAX, 0)
        返回 "int"
    结束
    如果 名字 == "清除异常" 则
        移动立即64(R_RAX, 0)
        返回 "int"
    结束
    如果 名字 == "取异常" 则
        移动立即64(R_RAX, 0)
        返回 "int"
    结束
    如果 名字 == "字典化" 则
        生成表达式(node["参数"][0], ctx)
        返回 "int"
    结束
    # 内置：转浮点(x) —— 纯整数后端无 SSE，恒等返回整数
    如果 名字 == "转浮点" 则
        生成表达式(node["参数"][0], ctx)
        返回 "int"
    结束
    # 内置：随机() —— rdtsc 低 32 位
    如果 名字 == "随机" 则
        读时间戳()
        返回 "int"
    结束
    # 内置：时间戳() —— rdtsc 拼成 64 位
    如果 名字 == "时间戳" 则
        读时间戳()
        左移立即(R_RDX, 32)
        加RR(R_RAX, R_RDX)
        返回 "int"
    结束
    # ---- 间接调用：被调者求值为函数地址，call *rax ----
    若 非 包含(G_函数标签, 名字) 且 名字 != "" 或 被调["类型"] != "标识符" 则
        生成表达式(被调, ctx)
        整数 fn槽 = 新临时(ctx)
        移动MemR(fn槽, R_RAX)
        列表 参数槽2 = []
        对于 i 从 0 到 长度(node["参数"]) - 1 循环
            字符串 k = 生成表达式(node["参数"][i], ctx)
            整数 s = 新临时(ctx)
            移动MemR(s, R_RAX)
            追加(参数槽2, {"种类": k, "槽": s})
        结束
        对于 i 从 0 到 长度(参数槽2) - 1 循环
            移动RMem(参数寄存器[i], 参数槽2[i]["槽"])
        结束
        移动RMem(R_RAX, fn槽)
        调用寄存器(R_RAX)
        释放临时(ctx, 长度(参数槽2) + 1)
        返回 "int"
    结束
    字符串 lbl = G_函数标签[名字]

    # 实参求值存槽
    列表 参数槽 = []
    对于 i 从 0 到 长度(node["参数"]) - 1 循环
        字符串 k = 生成表达式(node["参数"][i], ctx)
        整数 s = 新临时(ctx)
        移动MemR(s, R_RAX)
        追加(参数槽, {"种类": k, "槽": s})
    结束
    # 默认参数：实参不足时补 0 哨兵
    若 包含(G_函数形参数, 名字)
        整数 需数 = G_函数形参数[名字]
        对于 j 从 长度(参数槽) 到 需数 - 1 循环
            整数 s = 新临时(ctx)
            移动立即64(R_RAX, 0)
            移动MemR(s, R_RAX)
            追加(参数槽, {"种类": "int", "槽": s})
        结束
    结束
    # 传参到寄存器
    对于 i 从 0 到 长度(参数槽) - 1 循环
        移动RMem(参数寄存器[i], 参数槽[i]["槽"])
    结束
    调用(lbl)
    释放临时(ctx, 长度(参数槽))
    如果 包含(G_函数返回, lbl) 则
        返回 G_函数返回[lbl]
    结束
    返回 "int"
结束

# ---- 语句 ----
函数 生成语句(字典 st, 字典 ctx)
    字符串 类型 = st["类型"]
    如果 类型 == "变量声明" 则
        生成变量声明(st, ctx)
        返回
    结束
    如果 类型 == "赋值" 则
        生成赋值(st, ctx)
        返回
    结束
    如果 类型 == "返回" 则
        生成返回(st, ctx)
        返回
    结束
    如果 类型 == "如果" 则
        生成如果(st, ctx)
        返回
    结束
    如果 类型 == "当" 则
        生成当(st, ctx)
        返回
    结束
    如果 类型 == "对于" 则
        生成对于(st, ctx)
        返回
    结束
    如果 类型 == "跳出" 则
        整数 n = 长度(ctx["跳出栈"]) - 1
        跳转(ctx["跳出栈"][n])
        返回
    结束
    如果 类型 == "继续" 则
        整数 n = 长度(ctx["继续栈"]) - 1
        跳转(ctx["继续栈"][n])
        返回
    结束
    # 抛出异常（尽力而为）：本后端无字典/全局异常槽，展开当前函数返回
    如果 类型 == "抛出" 则
        如果 是空值(st["值"]) == 0 则
            生成表达式(st["值"], ctx)
        结束
        栈帧结束()
        返回指令()
        返回
    结束
    如果 类型 == "函数调用" 则
        生成调用(st, ctx)
        返回
    结束
    # 表达式语句
    如果 类型 == "二元" 或 类型 == "一元" 或 类型 == "字面量" 或 类型 == "标识符" 则
        生成表达式(st, ctx)
        返回
    结束
结束

函数 存到槽(整数 off, 字符串 fromK, 字符串 toK)
    移动MemR(off, R_RAX)
结束

函数 生成变量声明(字典 st, 字典 ctx)
    如果 是空值(st["初始化"]) == 0 则
        字符串 k = 生成表达式(st["初始化"], ctx)
        整数 off = 分配变量(ctx, st["名字"], k)
        存到槽(off, k, k)
    否则
        整数 off = 分配变量(ctx, st["名字"], "int")
        移动立即64(R_RAX, 0)
        移动MemR(off, R_RAX)
    结束
结束

函数 生成赋值(字典 st, 字典 ctx)
    如果 st["目标"]["类型"] == "标识符" 则
        字典 s = 取槽(ctx, st["目标"]["名字"])
        生成表达式(st["值"], ctx)
        存到槽(s["偏移"], s["种类"], s["种类"])
    结束
结束

函数 生成返回(字典 st, 字典 ctx)
    如果 是空值(st["值"]) == 0 则
        生成表达式(st["值"], ctx)
    否则
        移动立即64(R_RAX, 0)
    结束
    栈帧结束()
    返回指令()
结束

函数 生成如果(字典 st, 字典 ctx)
    字符串 否则L = 新标签("if_else")
    字符串 尾L = 新标签("if_end")
    生成表达式(st["条件"], ctx)
    测试RR(R_RAX, R_RAX)
    条件跳转(132, 否则L)          # jz
    对于 i 从 0 到 长度(st["则体"]) - 1 循环
        生成语句(st["则体"][i], ctx)
    结束
    跳转(尾L)
    打标签(否则L)
    对于 i 从 0 到 长度(st["否则链"]) - 1 循环
        字典 br = st["否则链"][i]
        如果 是空值(br["条件"]) == 0 则
            字符串 下 = 新标签("elif")
            生成表达式(br["条件"], ctx)
            测试RR(R_RAX, R_RAX)
            条件跳转(132, 下)
            对于 j 从 0 到 长度(br["体"]) - 1 循环
                生成语句(br["体"][j], ctx)
            结束
            跳转(尾L)
            打标签(下)
        否则
            对于 j 从 0 到 长度(br["体"]) - 1 循环
                生成语句(br["体"][j], ctx)
            结束
        结束
    结束
    打标签(尾L)
结束

函数 生成当(字典 st, 字典 ctx)
    字符串 头 = 新标签("wh_hd")
    字符串 尾 = 新标签("wh_ed")
    追加(ctx["跳出栈"], 尾)
    追加(ctx["继续栈"], 头)
    打标签(头)
    生成表达式(st["条件"], ctx)
    测试RR(R_RAX, R_RAX)
    条件跳转(132, 尾)
    对于 i 从 0 到 长度(st["体"]) - 1 循环
        生成语句(st["体"][i], ctx)
    结束
    跳转(头)
    打标签(尾)
    释放栈顶(ctx, "跳出栈")
    释放栈顶(ctx, "继续栈")
结束

函数 释放栈顶(字典 ctx, 字符串 名)
    # coCN 列表无 pop，用截断标记：直接删最后一项
    列表 lst = ctx[名]
    整数 n = 长度(lst)
    如果 n > 0 则
        列表 新 = []
        对于 i 从 0 到 n - 2 循环
            追加(新, lst[i])
        结束
        ctx[名] = 新
    结束
结束

函数 生成对于(字典 st, 字典 ctx)
    # 范围形式
    字符串 头 = 新标签("for_hd")
    字符串 继续L = 新标签("for_ct")
    字符串 尾 = 新标签("for_ed")
    字符串 负 = 新标签("for_ng")
    字符串 体L = 新标签("for_bd")

    # 初始化
    生成表达式(st["起点"], ctx)
    整数 vOff = 分配变量(ctx, st["变量"], "int")
    存到槽(vOff, "int", "int")
    生成表达式(st["终点"], ctx)
    整数 e槽 = 新临时(ctx)
    移动MemR(e槽, R_RAX)
    # 步长
    整数 步槽 = 0
    如果 是空值(st["步长"]) == 0 则
        生成表达式(st["步长"], ctx)
        步槽 = 新临时(ctx)
        移动MemR(步槽, R_RAX)
    否则
        步槽 = 新临时(ctx)
        移动立即64(R_RAX, 1)
        移动MemR(步槽, R_RAX)
    结束

    追加(ctx["跳出栈"], 尾)
    追加(ctx["继续栈"], 继续L)

    打标签(头)
    # 步长符号
    移动RMem(R_RAX, 步槽)
    测试RR(R_RAX, R_RAX)
    条件跳转(136, 负)           # js
    # 正步长: var > end ?
    移动RMem(R_RAX, vOff)
    移动RMem(R_R10, e槽)
    比较RR(R_RAX, R_R10)
    条件跳转(143, 尾)           # jg
    跳转(体L)
    打标签(负)
    移动RMem(R_RAX, vOff)
    移动RMem(R_R10, e槽)
    比较RR(R_RAX, R_R10)
    条件跳转(140, 尾)           # jl

    打标签(体L)
    对于 i 从 0 到 长度(st["体"]) - 1 循环
        生成语句(st["体"][i], ctx)
    结束

    打标签(继续L)
    移动RMem(R_RAX, vOff)
    移动RMem(R_R10, 步槽)
    加RR(R_RAX, R_R10)
    移动MemR(vOff, R_RAX)
    跳转(头)

    打标签(尾)
    释放栈顶(ctx, "跳出栈")
    释放栈顶(ctx, "继续栈")
    释放临时(ctx, 2)
结束

# ============================================================
# 函数 / 程序骨架
# ============================================================
函数 生成起始()
    打标签("_start")
    调用("co_main")
    移动RR(R_RDI, R_RAX)
    移动立即64(R_RAX, 60)
    系统调用()
结束

函数 生成函数(字典 st)
    字符串 lbl = G_函数标签[st["名字"]]
    字典 ctx = 新建上下文()
    ctx["返回类型"] = "int"

    打标签(lbl)
    压栈(R_RBP)
    移动RR(R_RBP, R_RSP)
    整数 subPos = 发射位置()
    出字节表([72, 129, 236, 0, 0, 0, 0])   # sub rsp, N 占位

    # 参数存栈槽
    整数 ireg = 0
    列表 参数 = st["参数"]
    列表 默认表 = []
    如果 包含(st, "参数默认") 则
        默认表 = st["参数默认"]
    结束
    对于 i 从 0 到 长度(参数) - 1 循环
        整数 off = 分配变量(ctx, 参数[i], "int")
        移动MemR(off, 参数寄存器[ireg])
        # 默认参数：传入 0 哨兵则求值默认表达式
        如果 i < 长度(默认表) 且 类型(默认表[i]) == "字典" 且 包含(默认表[i], "类型") 则
            移动RMem(R_RAX, off)
            测试RR(R_RAX, R_RAX)
            字符串 defskip = 新标签("defok")
            条件跳转(133, defskip)        # jnz：非 0 则跳过默认
            生成表达式(默认表[i], ctx)
            移动MemR(off, R_RAX)
            打标签(defskip)
        结束
        ireg = ireg + 1
    结束

    列表 体语句 = st["体"]["语句"]
    对于 i 从 0 到 长度(体语句) - 1 循环
        生成语句(体语句[i], ctx)
    结束

    # 隐式返回
    移动立即64(R_RAX, 0)
    栈帧结束()
    返回指令()

    # 回填 sub rsp, N
    整数 N = 栈大小(ctx)
    G_em["字节"][subPos + 3] = N & 255
    G_em["字节"][subPos + 4] = (N >> 8) & 255
    G_em["字节"][subPos + 5] = (N >> 16) & 255
    G_em["字节"][subPos + 6] = (N >> 24) & 255

    G_函数返回[lbl] = "int"
结束

函数 生成主()
    字典 ctx = 新建上下文()
    ctx["返回类型"] = "none"
    打标签("co_main")

    压栈(R_RBP)
    移动RR(R_RBP, R_RSP)
    整数 subPos = 发射位置()
    出字节表([72, 129, 236, 0, 0, 0, 0])

    # 顶层语句（非函数定义）
    列表 语句表 = G_ast["语句"]
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        如果 st["类型"] != "函数定义" 则
            生成语句(st, ctx)
        结束
    结束

    移动立即64(R_RAX, 0)
    栈帧结束()
    返回指令()

    整数 N = 栈大小(ctx)
    G_em["字节"][subPos + 3] = N & 255
    G_em["字节"][subPos + 4] = (N >> 8) & 255
    G_em["字节"][subPos + 5] = (N >> 16) & 255
    G_em["字节"][subPos + 6] = (N >> 24) & 255
结束

# ============================================================
# 主入口
# ============================================================
函数 重置生成器(字典 ast)
    G_em = {"字节": [], "标签位置": {}, "修复": [], "序号": 0}
    G_ast = ast
    G_函数标签 = {}
    G_函数返回 = {}
    G_字符串标签 = {}
    G_只读表 = []
结束

# 编译 AST -> 完整 ELF 字节表
函数 编译到ELF(字典 ast) -> 列表
    重置生成器(ast)

    # 预收集函数
    列表 语句表 = ast["语句"]
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        如果 st["类型"] == "函数定义" 则
            字符串 lbl = "F" + 转字符串(i) + "_" + st["名字"]
            G_函数标签[st["名字"]] = lbl
            G_函数形参数[st["名字"]] = 长度(st["参数"])
        结束
    结束

    生成起始()
    生成打印串()
    生成打印整()
    生成打印换行()

    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        如果 st["类型"] == "函数定义" 则
            生成函数(st)
        结束
    结束

    生成主()

    # 数据段
    字典 数据 = 构建数据()
    整数 codeSize = 发射位置()
    修复标签(codeSize, 数据["标签偏移"])

    # 合并代码 + 数据
    列表 合并 = []
    对于 i 从 0 到 长度(G_em["字节"]) - 1 循环
        追加(合并, G_em["字节"][i])
    结束
    对于 i 从 0 到 长度(数据["字节"]) - 1 循环
        追加(合并, 数据["字节"][i])
    结束

    返回 构建ELF64(合并, 0)
结束

# ============================================================
# 并发运行时（协程 / 通道 / 锁 / 等待组）—— 与 代码生成器.co 保持一致
#
# 单线程协作式多任务调度器：协程入就绪队列，阻塞时 让出调度 推进其他协程。
# ============================================================

让 g就绪 = []
让 g就绪头 = 0

# 启动协程：把函数 f 加入就绪队列，稍后由调度器运行
# 注意：不能用 g就绪 = g就绪 + [f]——解释器对“列表+函数元素”拼接有已知 bug，改用 追加。
函数 启动协程(f)
    追加(g就绪, f)
结束

# 让出调度：当前协程即将阻塞时，取出并运行下一个就绪协程
函数 让出调度()
    当 g就绪头 < 长度(g就绪) 循环
        让 f = g就绪[g就绪头]
        g就绪头 = g就绪头 + 1
        f()
        如果 g就绪头 >= 长度(g就绪) 则
            跳出
        结束
    结束
结束

# 创建通道：容量 为缓冲槽数
函数 创建通道(整数 容量)
    返回 {"头": 0, "尾": 0, "计数": 0, "容量": 容量, "关闭": 0, "项": {}}
结束

# 发送(v) 到通道；缓冲满则阻塞让出调度
函数 发送(字典 ch, v)
    当 ch["计数"] >= ch["容量"] 循环
        让出调度()
    结束
    ch["项"][转字符串(ch["尾"])] = v
    ch["尾"] = ch["尾"] + 1
    ch["计数"] = ch["计数"] + 1
结束

# 从通道接收；空则阻塞让出调度
函数 接收(字典 ch)
    当 ch["计数"] <= 0 循环
        让出调度()
    结束
    让 v = ch["项"][转字符串(ch["头"])]
    ch["头"] = ch["头"] + 1
    ch["计数"] = ch["计数"] - 1
    返回 v
结束

# 关闭通道
函数 关闭(字典 ch)
    ch["关闭"] = 1
结束

# 创建互斥锁
函数 创建锁()
    返回 {"持有": 0}
结束

# 加锁
函数 加锁(字典 l)
    当 l["持有"] == 1 循环
        让出调度()
    结束
    l["持有"] = 1
结束

# 解锁
函数 解锁(字典 l)
    l["持有"] = 0
结束

# 创建等待组
函数 创建等待组()
    返回 {"计数": 0}
结束

# 增加等待组计数
函数 增加(字典 wg, 整数 n)
    wg["计数"] = wg["计数"] + n
结束

# 完成：计数减一
函数 完成(字典 wg)
    wg["计数"] = wg["计数"] - 1
结束

# 等待组等待：阻塞直到计数归零，期间让出调度
函数 等待组等待(字典 wg)
    当 wg["计数"] > 0 循环
        让出调度()
    结束
结束

# ============================================================
# 元编程运行时（泛型 / 特性 / 反射 / 宏 / 编译期计算）
# —— 与 代码生成器.co 保持一致，纯 coCN 实现，eval 下运行
# ============================================================

# ---------------- 1. 泛型 ----------------

# 创建泛型列表
函数 创建泛型列表(字符串 元素类型)
    让 实例 = {"__类型__": "泛型列表", "元素类型": 元素类型, "_数据": []}

    函数 追加方法(元素)
        追加(实例["_数据"], 元素)
    结束

    函数 获取方法(整数 索引)
        返回 实例["_数据"][索引]
    结束

    函数 长度方法()
        返回 长度(实例["_数据"])
    结束

    实例["追加"] = 追加方法
    实例["获取"] = 获取方法
    实例["长度"] = 长度方法
    返回 实例
结束

# 创建泛型字典
函数 创建泛型字典(字符串 键类型, 字符串 值类型)
    让 实例 = {"__类型__": "泛型字典", "键类型": 键类型, "值类型": 值类型, "_数据": {}}

    函数 设置方法(键, 值)
        实例["_数据"][键] = 值
    结束

    函数 获取方法(键)
        返回 实例["_数据"][键]
    结束

    函数 包含方法(键)
        返回 包含(实例["_数据"], 键)
    结束

    函数 长度方法()
        返回 长度(实例["_数据"])
    结束

    实例["设置"] = 设置方法
    实例["获取"] = 获取方法
    实例["包含"] = 包含方法
    实例["长度"] = 长度方法
    返回 实例
结束

# 泛型映射
函数 泛型映射(列表 源, 变换函数)
    让 结果 = []
    对于 项 在 源 循环
        追加(结果, 变换函数(项))
    结束
    返回 结果
结束

# ---------------- 2. 特性 ----------------

# 定义特性
函数 定义特性(列表 要求方法, 字典 默认实现)
    返回 {"__类型__": "特性", "要求": 要求方法, "默认实现": 默认实现}
结束

# 检查对象是否实现特性
函数 检查特性(字典 对象, 字典 特性)
    对于 i 从 0 到 长度(特性["要求"]) - 1 循环
        字符串 方法名 = 特性["要求"][i]
        如果 非 包含(对象, 方法名) 则
            返回 0
        结束
    结束
    返回 1
结束

# 实现特性：复制默认实现到对象
函数 实现特性(字典 对象, 字典 特性)
    对于 方法名 在 特性["默认实现"] 循环
        对象[方法名] = 特性["默认实现"][方法名]
    结束
    返回 对象
结束

# 检查多个特性
函数 检查多特性(字典 对象, 列表 特性列表)
    对于 i 从 0 到 长度(特性列表) - 1 循环
        如果 检查特性(对象, 特性列表[i]) == 0 则
            返回 0
        结束
    结束
    返回 1
结束

# ---------------- 3. 反射 ----------------

# 获取类型名
函数 类型名(对象)
    如果 类型(对象) == "字典" 且 包含(对象, "__类型__") 则
        返回 对象["__类型__"]
    结束
    返回 类型(对象)
结束

# 获取属性列表（非方法的键）
函数 属性列表(字典 对象)
    让 结果 = []
    对于 键 在 对象 循环
        字符串 k = 键
        如果 k != "__类型__" 则
            让 值 = 对象[键]
            如果 类型(值) != "函数" 则
                追加(结果, k)
            结束
        结束
    结束
    返回 结果
结束

# 获取方法列表（值为函数的键）
函数 方法列表(字典 对象)
    让 结果 = []
    对于 键 在 对象 循环
        字符串 k = 键
        如果 k != "__类型__" 则
            让 值 = 对象[键]
            如果 类型(值) == "函数" 则
                追加(结果, k)
            结束
        结束
    结束
    返回 结果
结束

# 动态调用方法
函数 调用方法(字典 对象, 字符串 方法名, 列表 参数)
    让 方法 = 对象[方法名]
    如果 长度(参数) == 0 则
        返回 方法()
    结束
    如果 长度(参数) == 1 则
        返回 方法(参数[0])
    结束
    如果 长度(参数) == 2 则
        返回 方法(参数[0], 参数[1])
    结束
    返回 0
结束

# 动态设置属性
函数 设置属性(字典 对象, 字符串 键, 值)
    对象[键] = 值
结束

# 动态获取属性
函数 获取属性(字典 对象, 字符串 键)
    返回 对象[键]
结束

# ---------------- 4. 宏 ----------------

让 g宏表 = {}

函数 注册宏(字符串 名字, 展开函数)
    g宏表[名字] = 展开函数
结束

函数 是宏调用(节点)
    如果 类型(节点) != "字典" 则
        返回 0
    结束
    如果 非 包含(节点, "类型") 则
        返回 0
    结束
    如果 节点["类型"] != "函数调用" 则
        返回 0
    结束
    如果 节点["被调者"]["类型"] != "标识符" 则
        返回 0
    结束
    字符串 名 = 节点["被调者"]["名字"]
    如果 包含(g宏表, 名) 则
        返回 1
    结束
    返回 0
结束

函数 展开宏(节点)
    如果 类型(节点) == "列表" 则
        让 结果 = []
        对于 i 从 0 到 长度(节点) - 1 循环
            追加(结果, 展开宏(节点[i]))
        结束
        返回 结果
    结束
    如果 类型(节点) != "字典" 则
        返回 节点
    结束
    如果 非 包含(节点, "类型") 则
        返回 节点
    结束
    如果 是宏调用(节点) == 1 则
        字符串 名 = 节点["被调者"]["名字"]
        让 展开函数 = g宏表[名]
        让 新参数 = []
        对于 i 从 0 到 长度(节点["参数"]) - 1 循环
            追加(新参数, 展开宏(节点["参数"][i]))
        结束
        让 展开后 = 展开函数(新参数)
        返回 展开宏(展开后)
    结束
    让 新节点 = {}
    对于 键 在 节点 循环
        如果 键 == "类型" 则
            新节点[键] = 节点[键]
        否则
            新节点[键] = 展开宏(节点[键])
        结束
    结束
    返回 新节点
结束

# ---------------- 5. 编译期计算 ----------------

让 g编译期常量 = {}

函数 注册编译期常量(字符串 名, 值)
    g编译期常量[名] = 值
结束

函数 编译期求值(节点)
    如果 类型(节点) == "整数" 或 类型(节点) == "浮点" 则
        返回 节点
    结束
    如果 类型(节点) == "字典" 且 包含(节点, "类型") 则
        如果 节点["类型"] == "标识符" 则
            字符串 名 = 节点["名字"]
            如果 包含(g编译期常量, 名) 则
                返回 g编译期常量[名]
            结束
        结束
        如果 节点["类型"] == "二元" 则
            让 左值 = 编译期求值(节点["左"])
            让 右值 = 编译期求值(节点["右"])
            字符串 op = 节点["运算符"]
            如果 op == "+" 则 返回 左值 + 右值 结束
            如果 op == "-" 则 返回 左值 - 右值 结束
            如果 op == "*" 则 返回 左值 * 右值 结束
            如果 op == "//" 则 返回 左值 // 右值 结束
        结束
    结束
    返回 节点
结束

函数 编译期阶乘(整数 n) -> 整数
    如果 n <= 1 则
        返回 1
    结束
    返回 n * 编译期阶乘(n - 1)
结束

函数 编译期断言(条件, 字符串 消息)
    如果 条件 == 0 则
        抛出 "编译期断言失败: " + 消息
    结束
结束

# ============================================================
# 高级特性运行时（运算符重载 / 装饰器 / 属性 / 枚举 / 命名空间）
#
# 全部以纯 coCN 函数实现（语法分析器无需改动）：
#   * 运算符重载 = 特殊方法名（__加__/__乘__/__等于__/__转字符串__）+ 运行时分派
#   * 装饰器     = 接收函数返回函数的高阶函数；组合装饰器叠加多条装饰器链
#   * 属性       = getter/setter 闭包（计算属性 / 只读属性 / 写入校验）
#   * 枚举       = 字典常量集合 + 名称↔值双向映射 + 遍历
#   * 命名空间   = 嵌套字典 + 深取 / 别名 / 合并（模拟导入）
# 与并发/元编程运行时一样，由 cat 拼接后在 eval 解释器下运行。
# ============================================================

# ---------------- 1. 运算符重载 ----------------

# 运算符 -> 特殊方法名映射
函数 运算符特殊方法(字符串 运算符) -> 字符串
    如果 运算符 == "+" 则 返回 "__加__" 结束
    如果 运算符 == "-" 则 返回 "__减__" 结束
    如果 运算符 == "*" 则 返回 "__乘__" 结束
    如果 运算符 == "/" 或 运算符 == "//" 则 返回 "__除__" 结束
    如果 运算符 == "==" 则 返回 "__等于__" 结束
    如果 运算符 == "!=" 则 返回 "__不等于__" 结束
    如果 运算符 == "<" 则 返回 "__小于__" 结束
    如果 运算符 == ">" 则 返回 "__大于__" 结束
    如果 运算符 == "<=" 则 返回 "__小于等于__" 结束
    如果 运算符 == ">=" 则 返回 "__大于等于__" 结束
    返回 ""
结束

# 运算符重载分派：二元运算时检查左操作数（对象/字典）是否实现对应特殊方法，
# 有则调用该方法（左对象.特殊方法(右)），否则走默认运算。
# != 可由 __等于__ 派生取反。
函数 运算重载(左, 字符串 运算符, 右)
    如果 类型(左) == "字典" 则
        字符串 方法名 = 运算符特殊方法(运算符)
        如果 方法名 != "" 且 包含(左, 方法名) 则
            返回 左[方法名](右)
        结束
        # 派生：!= 由 __等于__ 取反
        如果 运算符 == "!=" 且 包含(左, "__等于__") 则
            让 等 = 左["__等于__"](右)
            如果 等 == 1 则 返回 0 结束
            返回 1
        结束
    结束
    # 默认运算（标量）
    如果 运算符 == "+" 则 返回 左 + 右 结束
    如果 运算符 == "-" 则 返回 左 - 右 结束
    如果 运算符 == "*" 则 返回 左 * 右 结束
    如果 运算符 == "/" 则 返回 左 / 右 结束
    如果 运算符 == "//" 则 返回 左 // 右 结束
    如果 运算符 == "==" 则 返回 左 == 右 结束
    如果 运算符 == "<" 则 返回 左 < 右 结束
    如果 运算符 == ">" 则 返回 左 > 右 结束
    返回 0
结束

# 转可读字符串：对象实现 __转字符串__ 则调用之，否则默认转字符串
函数 转可读(对象)
    如果 类型(对象) == "字典" 且 包含(对象, "__转字符串__") 则
        返回 对象["__转字符串__"]()
    结束
    返回 转字符串(对象)
结束

# ---------------- 2. 装饰器 ----------------

# 组合装饰器：装饰器列表（list[0] 为最外层）依次叠加到目标函数上。
# 语义同 Python：@外 @内 f 等价于 外(内(f))。
函数 组合装饰器(列表 装饰器列表, 目标函数)
    让 n = 长度(装饰器列表)
    如果 n == 0 则 返回 目标函数 结束
    # 反转列表（最靠近函数的装饰器先应用），用正向循环索引实现
    让 反转 = []
    对于 i 从 0 到 n - 1 循环
        追加(反转, 装饰器列表[n - 1 - i])
    结束
    让 结果 = 目标函数
    对于 j 从 0 到 n - 1 循环
        结果 = 反转[j](结果)
    结束
    返回 结果
结束

# ---------------- 3. 属性 ----------------

# 定义属性：在对象上挂载 获取_名 / 设置_名；setter 非函数时为只读属性
函数 定义属性(字典 对象, 字符串 名, getter, setter)
    对象["获取_" + 名] = getter
    如果 类型(setter) == "函数" 则
        对象["设置_" + 名] = setter
    结束
    返回 对象
结束

# ---------------- 4. 枚举 ----------------

# 创建枚举：传入 成员名->值 字典；返回枚举对象（含常量与辅助方法）
函数 创建枚举(字典 成员)
    让 实例 = {"__类型__": "枚举", "_名称列表": []}
    # 拷贝成员常量并记录名称顺序
    对于 名 在 成员 循环
        实例[名] = 成员[名]
        追加(实例["_名称列表"], 名)
    结束
    函数 获取名称方法(值)
        对于 i 从 0 到 长度(实例["_名称列表"]) - 1 循环
            字符串 nm = 实例["_名称列表"][i]
            如果 实例[nm] == 值 则 返回 nm 结束
        结束
        返回 "未知"
    结束
    函数 获取值方法(字符串 名称)
        返回 实例[名称]
    结束
    函数 名称列表方法()
        返回 实例["_名称列表"]
    结束
    函数 遍历方法(回调)
        对于 i 从 0 到 长度(实例["_名称列表"]) - 1 循环
            字符串 nm = 实例["_名称列表"][i]
            回调(nm, 实例[nm])
        结束
    结束
    实例["获取名称"] = 获取名称方法
    实例["获取值"] = 获取值方法
    实例["名称列表"] = 名称列表方法
    实例["遍历"] = 遍历方法
    返回 实例
结束

# ---------------- 5. 命名空间 ----------------

# 深取：按路径列表从嵌套命名空间逐层取值
函数 深取(字典 命名空间, 列表 路径)
    让 当前 = 命名空间
    对于 i 从 0 到 长度(路径) - 1 循环
        当前 = 当前[路径[i]]
    结束
    返回 当前
结束

# 命名空间别名：返回同一嵌套对象的引用（别名）
函数 命名空间别名(字典 对象)
    返回 对象
结束

# 合并命名空间：把多个命名空间的成员平铺到一个字典（模拟导入到当前作用域）
函数 合并命名空间(列表 命名空间列表)
    让 结果 = {}
    对于 i 从 0 到 长度(命名空间列表) - 1 循环
        对于 键 在 命名空间列表[i] 循环
            结果[键] = 命名空间列表[i][键]
        结束
    结束
    返回 结果
结束

# ============================================================
# 异步编程运行时（Promise / 迭代器 / 生成器 / 异步函数 / 异步迭代器）
#
# 全部以纯 coCN 函数实现（语法分析器无需改动），与并发/元编程/高级特性
# 运行时一样，由 cat 拼接后在 eval 解释器下运行。
#
# 模型：
#   * Promise  = 字典（状态 pending/fulfilled/rejected + 值 + 回调队列）
#                然后/捕获/最终 注册回调；落定时排空队列；then 返回新 Promise 形成链。
#   * 迭代器   = 字典 下一个() -> {"值":v,"完成":0/1}；可迭代对象提供 __迭代器__()。
#   * 生成器   = 返回迭代器对象的工厂函数（闭包保存内部状态，产出=返回一个{值,完成}）。
#   * 异步函数 = 返回 Promise 的普通函数；等待承诺(p) 阻塞取 Promise 终值。
#   * 异步迭代器 = 下一个() 返回 Promise<{值,完成}>；等待遍历每个 驱动。
#
# 命名约定：被闭包捕获的局部变量一律用独特名（实例/下一个承诺/状态），
# 避免与用户程序里的常见变量名（p/结果/x 等）撞名——本解释器的闭包按名
# 绑定槽位，同名外层变量会串槽（与 测试高级特性 的 ctx 做法一致）。
# ============================================================

# ---------------- 1. Promise（承诺） ----------------

# 新建一个 pending 承诺对象（内部用）
函数 新建承诺()
    让 实例 = {"__类型__": "承诺"}
    实例["_状态"] = "pending"
    实例["_值"] = 0
    实例["_原因"] = 0
    实例["_队列"] = []
    实例["_最终队列"] = []
    返回 实例
结束

# 调用 then 回调：cb 为函数则执行，结果采用为 下一个承诺 的兑现值；否则按“穿透”规则落定。
# 无cb拒绝=1 表示本路径是 onRejected 且无回调时要把 下一个承诺 拒绝；
# 无cb拒绝=0 表示本路径是 onFulfilled 且无回调时把 下一个承诺 兑现为原值。
函数 承诺_调用回调(下一个承诺, cb, 参数, 无cb拒绝)
    如果 类型(cb) != "函数" 则
        如果 无cb拒绝 == 1 则
            拒绝承诺(下一个承诺, 参数)
        否则
            解决承诺(下一个承诺, 参数)
        结束
        返回
    结束
    尝试
        让 r = cb(参数)
        承诺_采用值(下一个承诺, r)
    捕获 e
        拒绝承诺(下一个承诺, e)
    结束
结束

# 采用 thenable：若 r 本身是承诺，则等它落定后再落定 下一个承诺；否则直接兑现。
函数 承诺_采用值(下一个承诺, r)
    如果 类型(r) == "字典" 且 包含(r, "__类型__") 且 r["__类型__"] == "承诺" 则
        函数 采用成功(v)
            解决承诺(下一个承诺, v)
        结束
        函数 采用失败(e)
            拒绝承诺(下一个承诺, e)
        结束
        r["然后"](采用成功)
        r["捕获"](采用失败)
    否则
        解决承诺(下一个承诺, r)
    结束
结束

# 排空单条 then/捕获 记录（承诺已落定）
函数 承诺_排空记录(承诺对象, 记录)
    如果 承诺对象["_状态"] == "fulfilled" 则
        承诺_调用回调(记录["next"], 记录["onF"], 承诺对象["_值"], 0)
    否则
        承诺_调用回调(记录["next"], 记录["onR"], 承诺对象["_原因"], 1)
    结束
结束

# 排空单条 finally 记录
函数 承诺_排空最终(承诺对象, 记录)
    如果 类型(记录["fn"]) == "函数" 则
        尝试
            记录["fn"]()
        捕获 e
            拒绝承诺(记录["next"], e)
            返回
        结束
    结束
    如果 承诺对象["_状态"] == "fulfilled" 则
        解决承诺(记录["next"], 承诺对象["_值"])
    否则
        拒绝承诺(记录["next"], 承诺对象["_原因"])
    结束
结束

# 兑现承诺：状态置 fulfilled 并排空所有队列（幂等）
函数 解决承诺(承诺对象, 值)
    如果 承诺对象["_状态"] != "pending" 则
        返回
    结束
    承诺对象["_状态"] = "fulfilled"
    承诺对象["_值"] = 值
    对于 i 从 0 到 长度(承诺对象["_队列"]) - 1 循环
        承诺_排空记录(承诺对象, 承诺对象["_队列"][i])
    结束
    对于 j 从 0 到 长度(承诺对象["_最终队列"]) - 1 循环
        承诺_排空最终(承诺对象, 承诺对象["_最终队列"][j])
    结束
结束

# 拒绝承诺：状态置 rejected 并排空所有队列（幂等）
函数 拒绝承诺(承诺对象, 原因)
    如果 承诺对象["_状态"] != "pending" 则
        返回
    结束
    承诺对象["_状态"] = "rejected"
    承诺对象["_原因"] = 原因
    对于 i 从 0 到 长度(承诺对象["_队列"]) - 1 循环
        承诺_排空记录(承诺对象, 承诺对象["_队列"][i])
    结束
    对于 j 从 0 到 长度(承诺对象["_最终队列"]) - 1 循环
        承诺_排空最终(承诺对象, 承诺对象["_最终队列"][j])
    结束
结束

# 在承诺对象上挂载 然后/捕获/最终 方法，返回该对象
函数 挂承诺方法(承诺对象)
    函数 然后方法(成功回调)
        返回 承诺_然后(承诺对象, 成功回调)
    结束
    函数 捕获方法(失败回调)
        返回 承诺_捕获(承诺对象, 失败回调)
    结束
    函数 最终方法(最终回调)
        返回 承诺_最终(承诺对象, 最终回调)
    结束
    承诺对象["然后"] = 然后方法
    承诺对象["捕获"] = 捕获方法
    承诺对象["最终"] = 最终方法
    返回 承诺对象
结束

# .then(onFulfilled)：返回新承诺
函数 承诺_然后(承诺对象, onF)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "onF": onF, "onR": 0}
    追加(承诺对象["_队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空记录(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# .catch(onRejected)：返回新承诺
函数 承诺_捕获(承诺对象, onR)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "onF": 0, "onR": onR}
    追加(承诺对象["_队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空记录(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# .finally(fn)：返回新承诺，落定时以本承诺的终态落定 下一个承诺
函数 承诺_最终(承诺对象, fn)
    让 下一个承诺 = 挂承诺方法(新建承诺())
    让 记录 = {"next": 下一个承诺, "fn": fn}
    追加(承诺对象["_最终队列"], 记录)
    如果 承诺对象["_状态"] != "pending" 则
        承诺_排空最终(承诺对象, 记录)
    结束
    返回 下一个承诺
结束

# 创建承诺：执行器(解决, 拒绝) 同步执行；执行器内抛错自动拒绝
函数 创建承诺(执行器)
    让 实例 = 挂承诺方法(新建承诺())
    函数 解决fn(v)
        解决承诺(实例, v)
    结束
    函数 拒绝fn(e)
        拒绝承诺(实例, e)
    结束
    尝试
        执行器(解决fn, 拒绝fn)
    捕获 e
        拒绝承诺(实例, e)
    结束
    返回 实例
结束

# ---- 静态方法工厂（避免循环内闭包按名绑定串槽） ----
# 用单一上下文字典传状态，闭包只捕获一个独特名 全部上下文，避免与外层局部同名串槽。
# 全部上下文 = {"结果表":..., "计数":{n}, "总数":n, "聚合":promise, "idx":k}
函数 建全部成功回调(全部上下文)
    函数 收集成功(v)
        全部上下文["结果表"][全部上下文["idx"]] = v
        全部上下文["计数"]["n"] = 全部上下文["计数"]["n"] + 1
        如果 全部上下文["计数"]["n"] == 全部上下文["总数"] 则
            解决承诺(全部上下文["聚合"], 全部上下文["结果表"])
        结束
    结束
    返回 收集成功
结束

# 为 承诺.全部 构造失败回调
函数 建全部失败回调(聚合)
    函数 任一失败(e)
        拒绝承诺(聚合, e)
    结束
    返回 任一失败
结束

# 承诺.解决(v)：立刻兑现的承诺
函数 承诺_解决静态(v)
    让 实例 = 挂承诺方法(新建承诺())
    解决承诺(实例, v)
    返回 实例
结束

# 承诺.拒绝(e)：立刻拒绝的承诺
函数 承诺_拒绝静态(e)
    让 实例 = 挂承诺方法(新建承诺())
    拒绝承诺(实例, e)
    返回 实例
结束

# 承诺.全部([...])：全部兑现后以“值列表”兑现；任一拒绝则整体拒绝
函数 承诺_全部静态(列表 ps)
    让 聚合 = 挂承诺方法(新建承诺())
    让 n = 长度(ps)
    让 结果表 = []
    让 计数 = {"n": 0}
    对于 i 从 0 到 n - 1 循环
        追加(结果表, 0)
    结束
    如果 n == 0 则
        解决承诺(聚合, 结果表)
        返回 聚合
    结束
    对于 k 从 0 到 n - 1 循环
        让 全部上下文 = {"结果表": 结果表, "计数": 计数, "总数": n, "聚合": 聚合, "idx": k}
        ps[k]["然后"](建全部成功回调(全部上下文))
        ps[k]["捕获"](建全部失败回调(聚合))
    结束
    返回 聚合
结束

# 承诺.竞速([...])：第一个落定（兑现或拒绝）的承诺决定聚合终态
函数 承诺_竞速静态(列表 ps)
    让 聚合 = 挂承诺方法(新建承诺())
    函数 竞速成功(v)
        解决承诺(聚合, v)
    结束
    函数 竞速失败(e)
        拒绝承诺(聚合, e)
    结束
    对于 k 从 0 到 长度(ps) - 1 循环
        ps[k]["然后"](竞速成功)
        ps[k]["捕获"](竞速失败)
    结束
    返回 聚合
结束

# 承诺 静态命名空间
让 承诺 = {}
承诺["解决"] = 承诺_解决静态
承诺["拒绝"] = 承诺_拒绝静态
承诺["全部"] = 承诺_全部静态
承诺["竞速"] = 承诺_竞速静态

# ---------------- 2. 迭代器协议 ----------------

# 列表迭代器：把普通列表包装成迭代器对象
函数 创建列表迭代器(列表 数据)
    让 状态 = {"数据": 数据, "下标": 0}
    函数 下一个方法()
        如果 状态["下标"] < 长度(状态["数据"]) 则
            让 v = 状态["数据"][状态["下标"]]
            状态["下标"] = 状态["下标"] + 1
            返回 {"值": v, "完成": 0}
        结束
        返回 {"值": 0, "完成": 1}
    结束
    返回 {"下一个": 下一个方法}
结束

# 获取迭代器：
#   - 若对象有 __迭代器__  → 调用之得到迭代器
#   - 若对象本身有 下一个  → 它已是迭代器，直接返回（生成器即如此）
#   - 否则按列表/字符串包装成下标迭代器
函数 获取迭代器(可迭代)
    如果 类型(可迭代) == "字典" 且 包含(可迭代, "__迭代器__") 则
        返回 可迭代["__迭代器__"]()
    结束
    如果 类型(可迭代) == "字典" 且 包含(可迭代, "下一个") 则
        返回 可迭代
    结束
    返回 创建列表迭代器(可迭代)
结束

# 遍历每个：驱动迭代器协议，对每个值调用 回调(value)
函数 遍历每个(可迭代, 回调)
    让 it = 获取迭代器(可迭代)
    当 真 循环
        让 r = it["下一个"]()
        如果 r["完成"] == 1 则
            跳出
        结束
        回调(r["值"])
    结束
结束

# 收集：把迭代器/可迭代对象排空为列表
函数 收集(可迭代)
    让 结果 = []
    函数 收(v)
        追加(结果, v)
    结束
    遍历每个(可迭代, 收)
    返回 结果
结束

# 范围对象 [下限..上限]（含两端），实现 __迭代器__。
# 注意：本 VM 不支持三层闭包嵌套（外层→中层→内层 闭包捕获中层局部变量会串槽），
# 故迭代器对象用顶层辅助函数 创建范围迭代器 构造（两层闭包）。
函数 创建范围迭代器(下限, 上限)
    让 状态 = {"v": 下限, "峰值": 上限}
    函数 nm()
        如果 状态["v"] <= 状态["峰值"] 则
            让 val = 状态["v"]
            状态["v"] = 状态["v"] + 1
            返回 {"值": val, "完成": 0}
        结束
        返回 {"值": 0, "完成": 1}
    结束
    返回 {"下一个": nm}
结束

函数 创建范围(下限, 上限)
    让 实例 = {"下限": 下限, "上限": 上限}
    函数 迭代器方法()
        返回 创建范围迭代器(实例["下限"], 实例["上限"])
    结束
    实例["__迭代器__"] = 迭代器方法
    返回 实例
结束

# ---------------- 3. 生成器（Generator） ----------------
# 生成器 = 返回迭代器对象（{"下一个": fn}）的工厂函数，闭包保存内部状态。
# “产出 v” = 下一个方法返回 {"值": v, "完成": 0}；结束时返回 {"值":0,"完成":1}。
# 生成器委托（产出*另一个）：在状态机里先排空内层迭代器，再切到外层。

# ---------------- 4. 异步函数（async/await） ----------------

# 等待承诺(p)：阻塞直到承诺落定，返回兑现值；拒绝则抛出原因。
# 对非承诺值直接原样返回。pending 期间不断让出调度推进其他协程/回调。
# 注：coCN 保留字 `等待` 为协程等待语句，不能作函数名，故用 `等待承诺`。
函数 等待承诺(承诺对象)
    如果 类型(承诺对象) != "字典" 则
        返回 承诺对象
    结束
    如果 非 包含(承诺对象, "_状态") 则
        返回 承诺对象
    结束
    当 承诺对象["_状态"] == "pending" 循环
        让出调度()
    结束
    如果 承诺对象["_状态"] == "rejected" 则
        抛出 承诺对象["_原因"]
    结束
    返回 承诺对象["_值"]
结束

# 创建异步函数（0 参数）：把普通 0 参函数包装为“返回承诺”的异步函数。
# 函数返回值若是承诺（thenable）则自动采用，异常自动 reject。
函数 创建异步函数0(fn)
    函数 包装()
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn())
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# 创建异步函数（1 参数）
函数 创建异步函数1(fn)
    函数 包装(a)
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn(a))
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# 创建异步函数（2 参数）
函数 创建异步函数2(fn)
    函数 包装(a, b)
        让 实例 = 挂承诺方法(新建承诺())
        尝试
            承诺_采用值(实例, fn(a, b))
        捕获 e
            拒绝承诺(实例, e)
        结束
        返回 实例
    结束
    返回 包装
结束

# ---------------- 5. 异步迭代器（for-await-of） ----------------
# 异步迭代器：下一个() 返回 Promise<{"值":v,"完成":0/1}>。
# 等待遍历每个：驱动异步迭代器，对每个值调用 回调(value)。
函数 等待遍历每个(异步可迭代, 回调)
    让 it = 异步可迭代
    如果 类型(it) == "字典" 且 包含(it, "__异步迭代器__") 则
        it = it["__异步迭代器__"]()
    结束
    当 真 循环
        让 pr = it["下一个"]()
        让 r = 等待承诺(pr)
        如果 r["完成"] == 1 则
            跳出
        结束
        回调(r["值"])
    结束
结束

# 等待收集：把异步迭代器排空为列表（顺序收集）
函数 等待收集(异步可迭代)
    让 结果 = []
    函数 收(v)
        追加(结果, v)
    结束
    等待遍历每个(异步可迭代, 收)
    返回 结果
结束

# ============================================================
# Web 开发运行时（JSON / HTTP 服务器 / 路由 / 中间件 / 模板引擎）
#
# 全部以纯 coCN【顶层函数】实现（语法分析器无需改动）。
# 设计约束：本自举解释器对“函数内嵌套多个闭包”有已知缺陷（会挂起），
# 故采用与 并发运行时 / OOP 相同的风格——
#   * 对象 = 字典；方法 = 顶层函数，首参为接收者（字典）；
#   * 中间件链 = 显式 链上下文 字典 + 顶层 中间件执行下一个，无闭包。
#
# 模型：
#   * JSON    = 递归下降解析器 + 递归序列化器；布尔用标记字典 {"__b__":1/0}。
#   * HTTP服务器 = 字典；服务器监听/服务器使用/服务器处理请求。
#   * 路由    = 字典；路由注册(router,"GET",path,fn)；:名 取参，结尾 * 通配。
#   * 中间件  = 函数(请求,响应,链上下文)；调用 中间件执行下一个(链上下文) 继续。
#   * 模板引擎 = 递归下降渲染；{{变量}}/{{对于}}/{{如果}}/{{包含}}，自动转义。
# ============================================================

# ---------------- 1. JSON 解析 ----------------
函数 JSON跳过空白(ctx)
    让 s = ctx["文本"]
    让 n = 长度(s)
    当 ctx["pos"] < n 循环
        让 c = 截取(s, ctx["pos"], 1)
        如果 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r" 则
            ctx["pos"] = ctx["pos"] + 1
        否则
            跳出
        结束
    结束
结束

函数 JSON解析字符串(ctx) -> 字符串
    让 s = ctx["文本"]
    让 n = 长度(s)
    ctx["pos"] = ctx["pos"] + 1
    让 r = ""
    当 真 循环
        如果 ctx["pos"] >= n 则
            抛出 "JSON字符串未闭合"
        结束
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "\"" 则
            跳出
        结束
        如果 c == "\\" 则
            让 e = 截取(s, ctx["pos"], 1)
            ctx["pos"] = ctx["pos"] + 1
            如果 e == "n" 则
                r = r + "\n"
            否则 如果 e == "t" 则
                r = r + "\t"
            否则 如果 e == "r" 则
                r = r + "\r"
            否则 如果 e == "\"" 则
                r = r + "\""
            否则 如果 e == "\\" 则
                r = r + "\\"
            否则 如果 e == "/" 则
                r = r + "/"
            否则 如果 e == "u" 则
                ctx["pos"] = ctx["pos"] + 4
            结束
        否则
            r = r + c
        结束
    结束
    返回 r
结束

函数 JSON解析数字(ctx)
    让 s = ctx["文本"]
    让 n = 长度(s)
    让 起 = ctx["pos"]
    当 ctx["pos"] < n 循环
        让 c = 截取(s, ctx["pos"], 1)
        如果 c == "," 或 c == "}" 或 c == "]" 或 c == " " 或 c == "\n" 或 c == "\t" 或 c == "\r" 则
            跳出
        结束
        ctx["pos"] = ctx["pos"] + 1
    结束
    让 文本 = 截取(s, 起, ctx["pos"] - 起)
    如果 包含(文本, ".") 或 包含(文本, "e") 或 包含(文本, "E") 则
        返回 转浮点(文本)
    结束
    返回 转整数(文本)
结束

函数 JSON解析对象(ctx) -> 字典
    让 s = ctx["文本"]
    让 obj = {}
    ctx["pos"] = ctx["pos"] + 1
    JSON跳过空白(ctx)
    如果 截取(s, ctx["pos"], 1) == "}" 则
        ctx["pos"] = ctx["pos"] + 1
        返回 obj
    结束
    当 真 循环
        JSON跳过空白(ctx)
        让 key = JSON解析字符串(ctx)
        JSON跳过空白(ctx)
        ctx["pos"] = ctx["pos"] + 1
        让 val = JSON解析值(ctx)
        obj[key] = val
        JSON跳过空白(ctx)
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "}" 则
            跳出
        结束
    结束
    返回 obj
结束

函数 JSON解析数组(ctx) -> 列表
    让 s = ctx["文本"]
    让 arr = []
    ctx["pos"] = ctx["pos"] + 1
    JSON跳过空白(ctx)
    如果 截取(s, ctx["pos"], 1) == "]" 则
        ctx["pos"] = ctx["pos"] + 1
        返回 arr
    结束
    当 真 循环
        让 val = JSON解析值(ctx)
        追加(arr, val)
        JSON跳过空白(ctx)
        让 c = 截取(s, ctx["pos"], 1)
        ctx["pos"] = ctx["pos"] + 1
        如果 c == "]" 则
            跳出
        结束
    结束
    返回 arr
结束

函数 JSON解析值(ctx)
    JSON跳过空白(ctx)
    让 s = ctx["文本"]
    让 c = 截取(s, ctx["pos"], 1)
    如果 c == "{" 则
        返回 JSON解析对象(ctx)
    结束
    如果 c == "[" 则
        返回 JSON解析数组(ctx)
    结束
    如果 c == "\"" 则
        返回 JSON解析字符串(ctx)
    结束
    如果 c == "t" 则
        ctx["pos"] = ctx["pos"] + 4
        返回 {"__b__": 1}
    结束
    如果 c == "f" 则
        ctx["pos"] = ctx["pos"] + 5
        返回 {"__b__": 0}
    结束
    如果 c == "n" 则
        ctx["pos"] = ctx["pos"] + 4
        返回 空
    结束
    返回 JSON解析数字(ctx)
结束

函数 JSON解析(字符串 s)
    让 ctx = {"文本": s, "pos": 0}
    返回 JSON解析值(ctx)
结束

# ---------------- 2. JSON 序列化 ----------------
函数 JSON转义字符串(字符串 s) -> 字符串
    让 r = "\""
    对于 i 从 0 到 长度(s) - 1 循环
        让 c = 截取(s, i, 1)
        如果 c == "\"" 则
            r = r + "\\\""
        否则 如果 c == "\\" 则
            r = r + "\\\\"
        否则 如果 c == "\n" 则
            r = r + "\\n"
        否则 如果 c == "\t" 则
            r = r + "\\t"
        否则 如果 c == "\r" 则
            r = r + "\\r"
        否则
            r = r + c
        结束
    结束
    返回 r + "\""
结束

函数 JSON序列化数组(列表 arr, 美化, 层) -> 字符串
    让 n = 长度(arr)
    如果 n == 0 则
        返回 "[]"
    结束
    让 r = "["
    对于 i 从 0 到 n - 1 循环
        如果 i > 0 则
            r = r + ","
        结束
        如果 美化 则
            r = r + "\n"
            对于 sp 从 0 到 层 循环
                r = r + "  "
            结束
        结束
        r = r + JSON序列化值(arr[i], 美化, 层 + 1)
    结束
    如果 美化 则
        r = r + "\n"
        对于 sp 从 0 到 层 - 1 循环
            r = r + "  "
        结束
    结束
    返回 r + "]"
结束

函数 JSON序列化对象(字典 obj, 美化, 层) -> 字符串
    让 n = 长度(obj)
    如果 n == 0 则
        返回 "{}"
    结束
    让 r = "{"
    让 首 = 1
    对于 k 在 obj 循环
        如果 非 (k == "__b__") 则
            如果 首 == 0 则
                r = r + ","
            结束
            首 = 0
            如果 美化 则
                r = r + "\n"
                对于 sp 从 0 到 层 循环
                    r = r + "  "
                结束
            结束
            r = r + JSON转义字符串(k) + ":"
            如果 美化 则
                r = r + " "
            结束
            r = r + JSON序列化值(obj[k], 美化, 层 + 1)
        结束
    结束
    如果 美化 则
        r = r + "\n"
        对于 sp 从 0 到 层 - 1 循环
            r = r + "  "
        结束
    结束
    返回 r + "}"
结束

函数 JSON序列化值(v, 美化, 层) -> 字符串
    让 t = 类型(v)
    如果 t == "字符串" 则
        返回 JSON转义字符串(v)
    结束
    如果 t == "字典" 则
        如果 包含(v, "__b__") 则
            如果 v["__b__"] == 1 则
                返回 "true"
            结束
            返回 "false"
        结束
        返回 JSON序列化对象(v, 美化, 层)
    结束
    如果 t == "列表" 则
        返回 JSON序列化数组(v, 美化, 层)
    结束
    如果 v == 空 则
        返回 "null"
    结束
    如果 t == "整数" 或 t == "浮点" 则
        返回 转字符串(v)
    结束
    返回 "null"
结束

函数 JSON序列化(v, 美化) -> 字符串
    返回 JSON序列化值(v, 美化, 0)
结束

函数 JSON验证(字符串 s) -> 整数
    尝试
        让 ctx = {"文本": s, "pos": 0}
        让 v = JSON解析值(ctx)
        JSON跳过空白(ctx)
        如果 ctx["pos"] != 长度(s) 则
            返回 0
        结束
        返回 1
    捕获 e
        返回 0
    结束
结束

# ---------------- 3. HTTP 响应对象 ----------------
函数 创建响应() -> 字典
    返回 {"状态码": 200, "头部": {}, "body": "", "已结束": 0}
结束

函数 响应设置头(字典 res, 字符串 键, 值)
    res["头部"][键] = 值
结束

函数 响应结束(字典 res, 内容)
    如果 内容 != 空 则
        res["body"] = res["body"] + 内容
    结束
    res["已结束"] = 1
结束

# ---------------- 4. 路由匹配 ----------------
函数 匹配路径(段表, 字符串 路径) -> 字典
    让 请求段 = 分割(路径, "/")
    让 参数 = {}
    让 段数 = 长度(段表)
    让 实段数 = 长度(请求段)
    让 最后段 = 段表[段数 - 1]
    如果 最后段 == "*" 则
        对于 i 从 0 到 段数 - 2 循环
            如果 i >= 实段数 则
                返回 {"匹配": 0, "参数": {}}
            结束
            让 模 = 段表[i]
            如果 长度(模) > 0 且 模[0] == ":" 则
                让 名 = 截取(模, 1, 长度(模) - 1)
                参数[名] = 请求段[i]
            否则
                如果 模 != 请求段[i] 则
                    返回 {"匹配": 0, "参数": {}}
                结束
            结束
        结束
        返回 {"匹配": 1, "参数": 参数}
    结束
    如果 段数 != 实段数 则
        返回 {"匹配": 0, "参数": {}}
    结束
    对于 j 从 0 到 段数 - 1 循环
        让 模 = 段表[j]
        让 实 = 请求段[j]
        如果 长度(模) > 0 且 模[0] == ":" 则
            让 名 = 截取(模, 1, 长度(模) - 1)
            参数[名] = 实
        否则
            如果 模 != 实 则
                返回 {"匹配": 0, "参数": {}}
            结束
        结束
    结束
    返回 {"匹配": 1, "参数": 参数}
结束

函数 创建路由器() -> 字典
    返回 {"路由表": []}
结束

函数 路由注册(字典 r, 字符串 方法, 字符串 模板, fn)
    追加(r["路由表"], {"方法": 方法, "段表": 分割(模板, "/"), "处理": fn})
结束

函数 路由处理(字典 r, 请求, 响应, 链上下文)
    让 表 = r["路由表"]
    对于 i 从 0 到 长度(表) - 1 循环
        让 路由 = 表[i]
        如果 路由["方法"] == 请求["方法"] 则
            让 结果 = 匹配路径(路由["段表"], 请求["路径"])
            如果 结果["匹配"] == 1 则
                请求["参数"] = 结果["参数"]
                路由["处理"](请求, 响应, 链上下文)
                返回
            结束
        结束
    结束
    如果 响应["已结束"] == 0 则
        响应["状态码"] = 404
        响应结束(响应, "404 Not Found")
    结束
    如果 链上下文 != 空 则
        中间件执行下一个(链上下文)
    结束
结束

# ---------------- 5. 中间件链（无闭包） ----------------
# 链上下文 = {"链":[...], "idx":0, "请求":req, "响应":res}
函数 中间件执行下一个(ctx)
    如果 ctx["idx"] >= 长度(ctx["链"]) 则
        返回
    结束
    让 条目 = ctx["链"][ctx["idx"]]
    ctx["idx"] = ctx["idx"] + 1
    如果 包含(条目, "路由") 则
        路由处理(条目["路由"], ctx["请求"], ctx["响应"], ctx)
    否则
        条目["fn"](ctx["请求"], ctx["响应"], ctx)
    结束
结束

函数 创建HTTP服务器() -> 字典
    返回 {"中间件": [], "端口": 0, "_最终处理": 0}
结束

函数 服务器使用(字典 srv, a, b)
    如果 类型(a) == "字符串" 则
        追加(srv["中间件"], {"前缀": a, "fn": b})
    否则
        追加(srv["中间件"], {"前缀": "", "fn": a})
    结束
结束

# 把路由器挂载到服务器（路由作为链中的一环）
函数 服务器路由(字典 srv, 字典 路由器)
    追加(srv["中间件"], {"前缀": "", "路由": 路由器})
结束

函数 服务器监听(字典 srv, 整数 端口, fn)
    srv["端口"] = 端口
    srv["_最终处理"] = fn
结束

函数 服务器处理请求(字典 srv, 请求) -> 字典
    让 响应 = 创建响应()
    请求["参数"] = {}
    让 链 = []
    对于 i 从 0 到 长度(srv["中间件"]) - 1 循环
        让 mw = srv["中间件"][i]
        如果 mw["前缀"] == "" 或 截取(请求["路径"], 0, 长度(mw["前缀"])) == mw["前缀"] 则
            追加(链, mw)
        结束
    结束
    如果 类型(srv["_最终处理"]) == "函数" 则
        追加(链, {"fn": srv["_最终处理"]})
    结束
    让 ctx = {"链": 链, "idx": 0, "请求": 请求, "响应": 响应}
    中间件执行下一个(ctx)
    返回 响应
结束

# ---------------- 6. 模板引擎 ----------------
函数 模板取值(数据, 路径)
    让 部分 = 分割(路径, ".")
    让 v = 空
    如果 类型(数据) == "字典" 且 包含(数据, 部分[0]) 则
        v = 数据[部分[0]]
    结束
    对于 i 从 1 到 长度(部分) - 1 循环
        如果 类型(v) == "字典" 且 包含(v, 部分[i]) 则
            v = v[部分[i]]
        否则
            v = 空
        结束
    结束
    返回 v
结束

函数 模板值转字符串(v) -> 字符串
    让 t = 类型(v)
    如果 t == "字符串" 则
        让 r = ""
        对于 i 从 0 到 长度(v) - 1 循环
            让 c = 截取(v, i, 1)
            如果 c == "&" 则
                r = r + "&amp;"
            否则 如果 c == "<" 则
                r = r + "&lt;"
            否则 如果 c == ">" 则
                r = r + "&gt;"
            否则 如果 c == "\"" 则
                r = r + "&quot;"
            否则
                r = r + c
            结束
        结束
        返回 r
    结束
    如果 v == 空 则
        返回 ""
    结束
    如果 t == "字典" 或 t == "列表" 则
        返回 JSON序列化(v, 0)
    结束
    返回 转字符串(v)
结束

函数 模板渲染段(ctx) -> 字符串
    让 源 = ctx["源"]
    让 n = 长度(源)
    让 输出 = ""
    当 ctx["pos"] < n 循环
        让 剩余 = 截取(源, ctx["pos"], n - ctx["pos"])
        让 lb = 查找(剩余, "{{")
        如果 lb < 0 则
            输出 = 输出 + 剩余
            ctx["pos"] = n
            跳出
        结束
        输出 = 输出 + 截取(剩余, 0, lb)
        ctx["pos"] = ctx["pos"] + lb
        让 从标签 = 截取(源, ctx["pos"], n - ctx["pos"])
        让 rb = 查找(从标签, "}}")
        如果 rb < 0 则
            输出 = 输出 + 从标签
            ctx["pos"] = n
            跳出
        结束
        让 内部 = 去除空白(截取(从标签, 2, rb - 2))
        ctx["pos"] = ctx["pos"] + rb + 2

        如果 内部 == "结束" 则
            ctx["停止"] = "结束"
            跳出
        结束
        如果 内部 == "否则" 则
            ctx["停止"] = "否则"
            跳出
        结束

        # 对于 项 在 列表
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "对于" 则
            让 词 = 分割(内部, " ")
            让 项名 = 词[1]
            让 列表路径 = 词[3]
            让 列表值 = 模板取值(ctx["数据"], 列表路径)
            让 体开始 = ctx["pos"]
            # 先渲染一次定位 体结束（找到 {{结束}}）
            ctx["停止"] = ""
            模板渲染段(ctx)
            让 体结束 = ctx["pos"]
            如果 类型(列表值) == "列表" 则
                对于 k 从 0 到 长度(列表值) - 1 循环
                    ctx["数据"][项名] = 列表值[k]
                    ctx["停止"] = ""
                    ctx["pos"] = 体开始
                    输出 = 输出 + 模板渲染段(ctx)
                结束
            否则
                ctx["停止"] = ""
                ctx["pos"] = 体开始
                输出 = 输出 + 模板渲染段(ctx)
            结束
            ctx["pos"] = 体结束
            继续
        结束

        # 如果 条件
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "如果" 则
            让 词 = 分割(内部, " ")
            让 条件路径 = 词[1]
            让 条件值 = 模板取值(ctx["数据"], 条件路径)
            让 条件成立 = 0
            如果 条件值 != 空 则
                如果 类型(条件值) == "整数" 则
                    条件成立 = 条件值
                否则 如果 类型(条件值) == "字典" 且 包含(条件值, "__b__") 则
                    条件成立 = 条件值["__b__"]
                否则
                    条件成立 = 1
                结束
            结束
            如果 条件成立 == 1 则
                ctx["停止"] = ""
                输出 = 输出 + 模板渲染段(ctx)
                如果 ctx["停止"] == "否则" 则
                    ctx["停止"] = ""
                    模板渲染段(ctx)
                结束
            否则
                ctx["停止"] = ""
                模板渲染段(ctx)
                如果 ctx["停止"] == "否则" 则
                    ctx["停止"] = ""
                    输出 = 输出 + 模板渲染段(ctx)
                结束
            结束
            继续
        结束

        # 包含 "file"
        如果 长度(内部) >= 2 且 截取(内部, 0, 2) == "包含" 则
            让 左 = 查找(内部, "\"")
            让 文件名 = ""
            如果 左 >= 0 则
                让 右区 = 截取(内部, 左 + 1, 长度(内部) - 左 - 1)
                让 右 = 查找(右区, "\"")
                如果 右 >= 0 则
                    文件名 = 截取(内部, 左 + 1, 右)
                结束
            结束
            让 文件内容 = 读取文件(ctx["目录"] + "/" + 文件名)
            输出 = 输出 + 渲染模板字符串(文件内容, ctx["数据"], ctx["目录"])
            继续
        结束

        # 块 "name"：块内内容直接渲染
        如果 长度(内部) >= 1 且 内部[0] == "块" 则
            ctx["停止"] = ""
            输出 = 输出 + 模板渲染段(ctx)
            继续
        结束

        # 普通变量
        让 值 = 模板取值(ctx["数据"], 内部)
        输出 = 输出 + 模板值转字符串(值)
    结束
    返回 输出
结束

函数 渲染模板字符串(字符串 源, 数据, 目录) -> 字符串
    让 ctx = {"源": 源, "pos": 0, "数据": 数据, "目录": 目录, "停止": ""}
    返回 模板渲染段(ctx)
结束

函数 创建模板引擎(字符串 目录) -> 字典
    返回 {"目录": 目录}
结束
