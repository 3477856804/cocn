# ============================================================
# 测试并发.co —— 协程 / 通道 / 锁 / 等待组 端到端测试
#
# 运行方式（由 代码生成器.co 提供并发运行时）：
#   cat 词法分析器.co 语法分析器.co 代码生成器.co 测试并发.co > /tmp/t.co \
#     && node bin/cocn.js /tmp/t.co
#
# 全部用例自校验（断言相等），任何失败都会退出码 1。
# 运行模型：单线程协作式调度——协程入就绪队列，阻塞时让出调度运行其他协程。
# ============================================================

输出("==== 并发特性测试开始 ====")

# ---- 测试1：协程创建（启动3个协程，收集结果求和） ----
让 wg1 = 创建等待组()
让 收集1 = {"总": 0}
函数 建任务1(整数 id)
    函数 工作()
        收集1["总"] = 收集1["总"] + id * 100
        完成(wg1)
    结束
    返回 工作
结束
增加(wg1, 3)
启动协程(建任务1(1))
启动协程(建任务1(2))
启动协程(建任务1(3))
等待组等待(wg1)
断言相等(收集1["总"], 600, "测试1 协程创建: 3协程返回值求和(应为600)")
输出("测试1 协程创建 通过")

# ---- 测试2：通道通信（生产者-消费者，缓冲通道） ----
让 ch2 = 创建通道(10)
函数 生产者()
    对于 i 从 0 到 9 循环
        发送(ch2, i)
    结束
结束
启动协程(生产者)
让 和2 = 0
对于 i 从 0 到 9 循环
    让 v = 接收(ch2)
    和2 = 和2 + v
结束
断言相等(和2, 45, "测试2 通道: 生产者0..9之和(应为45)")
输出("测试2 通道通信 通过")

# ---- 测试3：锁同步（4 协程共享计数器，加锁保护） ----
让 m3 = 创建锁()
让 cnt3 = {"v": 0}
让 wg3 = 创建等待组()
函数 加N()
    对于 i 从 0 到 249 循环
        加锁(m3)
        cnt3["v"] = cnt3["v"] + 1
        解锁(m3)
    结束
    完成(wg3)
结束
增加(wg3, 4)
启动协程(加N)
启动协程(加N)
启动协程(加N)
启动协程(加N)
等待组等待(wg3)
断言相等(cnt3["v"], 1000, "测试3 锁: 4协程x250自增(应为1000)")
输出("测试3 锁同步 通过")

# ---- 测试4：等待组（等待所有协程完成） ----
让 wg4 = 创建等待组()
让 数4 = {"完成": 0}
函数 干活()
    数4["完成"] = 数4["完成"] + 1
    完成(wg4)
结束
增加(wg4, 3)
启动协程(干活)
启动协程(干活)
启动协程(干活)
等待组等待(wg4)
断言相等(数4["完成"], 3, "测试4 等待组: 全部完成(应为3)")
输出("测试4 等待组 通过")

# ---- 测试5：通道缓冲（有缓冲通道，无接收者也不阻塞） ----
让 ch5 = 创建通道(5)
发送(ch5, 10)
发送(ch5, 20)
发送(ch5, 30)
# 缓冲未满，三次发送都已完成；现在依次取出
让 a5 = 接收(ch5)
让 b5 = 接收(ch5)
让 c5 = 接收(ch5)
断言相等(a5 + b5 + c5, 60, "测试5 缓冲通道: 10+20+30(应为60)")
输出("测试5 通道缓冲 通过")

# ---- 测试6：协程让出（协作式调度，两个协程各自计数） ----
让 wg6 = 创建等待组()
让 数6 = {"甲": 0, "乙": 0}
函数 甲()
    对于 i 从 0 到 4 循环
        数6["甲"] = 数6["甲"] + 1
        让出()
    结束
    完成(wg6)
结束
函数 乙()
    对于 i 从 0 到 4 循环
        数6["乙"] = 数6["乙"] + 1
        让出()
    结束
    完成(wg6)
结束
增加(wg6, 2)
启动协程(甲)
启动协程(乙)
等待组等待(wg6)
断言相等(数6["甲"], 5, "测试6 让出: 甲计数(应为5)")
断言相等(数6["乙"], 5, "测试6 让出: 乙计数(应为5)")
输出("测试6 协程让出 通过")

输出("==== 并发特性测试全部通过 ====")
