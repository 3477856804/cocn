# ============================================================
# 求值.co —— 简化版求值器（用 coCN 自身实现）
#
# 输入：AST 字典 + 环境字典
# 输出：求值结果
#
# 支持：变量环境、算术求值、函数调用、控制流
# 简化：用字典表示环境，递归实现求值
# ============================================================

# 求值表达式节点
函数 求值(字典 节点, 字典 环境) -> 字典
    字符串 t = 节点["类型"]

    # 整数字面量
    若 t == "整数"
        返回 {"值": 节点["值"], "是否返回": 假}
    结束

    # 字符串字面量
    若 t == "字符串"
        返回 {"值": 节点["值"], "是否返回": 假}
    结束

    # 变量引用
    若 t == "标识符"
        字符串 名 = 节点["名"]
        若 包含(环境, 名)
            返回 {"值": 环境[名], "是否返回": 假}
        结束
        输出错误("运行时错误：未定义变量 '" + 名 + "'")
        退出(1)
        返回 {"值": 0, "是否返回": 假}
    结束

    # 二元运算
    若 t == "二元"
        字典 左 = 求值(节点["左"], 环境)
        字典 右 = 求值(节点["右"], 环境)
        字符串 op = 节点["运算符"]
        整数 lv = 左["值"]
        整数 rv = 右["值"]

        若 op == "+"
            返回 {"值": lv + rv, "是否返回": 假}
        结束
        若 op == "-"
            返回 {"值": lv - rv, "是否返回": 假}
        结束
        若 op == "*"
            返回 {"值": lv * rv, "是否返回": 假}
        结束
        若 op == "/"
            返回 {"值": lv / rv, "是否返回": 假}
        结束
        若 op == "%"
            返回 {"值": lv % rv, "是否返回": 假}
        结束
        若 op == "=="
            若 lv == rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        若 op == "!="
            若 lv != rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        若 op == "<"
            若 lv < rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        若 op == ">"
            若 lv > rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        若 op == "<="
            若 lv <= rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        若 op == ">="
            若 lv >= rv
                返回 {"值": 1, "是否返回": 假}
            否则
                返回 {"值": 0, "是否返回": 假}
            结束
        结束
        输出错误("运行时错误：未知运算符 '" + op + "'")
        退出(1)
        返回 {"值": 0, "是否返回": 假}
    结束

    # 函数调用
    若 t == "调用"
        字符串 名 = 节点["名"]
        若 包含(环境, 名)
            字典 函数对象 = 环境[名]
            # 求值实参
            列表 实参值 = []
            对于 i 从 0 到 长度(节点["参数"]) - 1 循环
                字典 av = 求值(节点["参数"][i], 环境)
                追加(实参值, av["值"])
            结束
            # 创建新环境
            字典 新环境 = {}
            # 绑定参数
            对于 i 从 0 到 长度(函数对象["参数"]) - 1 循环
                若 i < 长度(实参值)
                    新环境[函数对象["参数"][i]] = 实参值[i]
                否则
                    新环境[函数对象["参数"][i]] = 0
                结束
            结束
            # 继承定义环境的变量（简化：只继承全局，不做完整闭包链）
            # 简化版：把当前环境的变量复制到新环境
            列表 ks = 键(环境)
            对于 i 从 0 到 长度(ks) - 1 循环
                字符串 k = ks[i]
                若 不是参数名(函数对象["参数"], k)
                    若 不是函数本身(环境, 名, k)
                        新环境[k] = 环境[k]
                    结束
                结束
            结束
            # 求值函数体
            字典 结果 = 求值语句列表(函数对象["体"], 新环境)
            返回 {"值": 结果["值"], "是否返回": 假}
        结束
        输出错误("运行时错误：未定义函数 '" + 名 + "'")
        退出(1)
        返回 {"值": 0, "是否返回": 假}
    结束

    输出错误("运行时错误：未知表达式类型 '" + t + "'")
    退出(1)
    返回 {"值": 0, "是否返回": 假}
结束

# 检查名字是否是参数名
函数 不是参数名(列表 参数, 字符串 名) -> 布尔
    对于 i 从 0 到 长度(参数) - 1 循环
        若 参数[i] == 名
            返回 假
        结束
    结束
    返回 真
结束

# 检查是否是函数本身（避免递归引用问题）
函数 不是函数本身(字典 环境, 字符串 函数名, 字符串 键名) -> 布尔
    # 简化：总是返回真，允许递归
    返回 真
结束

# 求值单条语句
函数 求值语句(字典 语句, 字典 环境) -> 字典
    字符串 t = 语句["类型"]

    # 变量声明
    若 t == "变量声明"
        字典 v = 求值(语句["值"], 环境)
        环境[语句["名"]] = v["值"]
        返回 {"值": 0, "是否返回": 假}
    结束

    # 赋值
    若 t == "赋值"
        字典 v = 求值(语句["值"], 环境)
        环境[语句["名"]] = v["值"]
        返回 {"值": 0, "是否返回": 假}
    结束

    # 如果语句
    若 t == "如果"
        字典 条件 = 求值(语句["条件"], 环境)
        若 条件["值"] != 0
            返回 求值语句列表(语句["体"], 环境)
        否则
            返回 求值语句列表(语句["否则体"], 环境)
        结束
    结束

    # 当循环
    若 t == "当"
        字典 结果 = {"值": 0, "是否返回": 假}
        当 真 循环
            字典 条件 = 求值(语句["条件"], 环境)
            若 条件["值"] == 0
                跳出
            结束
            结果 = 求值语句列表(语句["体"], 环境)
            若 结果["是否返回"]
                返回 结果
            结束
        结束
        返回 {"值": 0, "是否返回": 假}
    结束

    # 函数定义
    若 t == "函数定义"
        字典 函数值 = {"类型": "函数值", "参数": 语句["参数"], "体": 语句["体"]}
        环境[语句["名"]] = 函数值
        返回 {"值": 0, "是否返回": 假}
    结束

    # 返回语句
    若 t == "返回"
        字典 v = 求值(语句["值"], 环境)
        返回 {"值": v["值"], "是否返回": 真}
    结束

    # 输出语句
    若 t == "输出"
        对于 i 从 0 到 长度(语句["参数"]) - 1 循环
            字典 v = 求值(语句["参数"][i], 环境)
            若 i > 0
                输出(" ")
            结束
            输出(转字符串(v["值"]))
        结束
        输出("")
        返回 {"值": 0, "是否返回": 假}
    结束

    # 表达式语句（函数调用）
    若 t == "表达式语句"
        返回 求值(语句["值"], 环境)
    结束

    输出错误("运行时错误：未知语句类型 '" + t + "'")
    退出(1)
    返回 {"值": 0, "是否返回": 假}
结束

# 求值语句列表
函数 求值语句列表(列表 语句列表, 字典 环境) -> 字典
    字典 结果 = {"值": 0, "是否返回": 假}
    对于 i 从 0 到 长度(语句列表) - 1 循环
        结果 = 求值语句(语句列表[i], 环境)
        若 结果["是否返回"]
            返回 结果
        结束
    结束
    返回 结果
结束

# 运行整个程序
函数 运行程序(字典 ast) -> 字典
    字典 全局环境 = {}
    返回 求值语句列表(ast["体"], 全局环境)
结束
