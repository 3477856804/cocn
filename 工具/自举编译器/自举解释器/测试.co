# ============================================================
# 测试.co —— 简化解释器测试程序
#
# 用简化解释器解析并求值多个测试程序，验证输出正确。
# 本文件与 词法.co 语法.co 求值.co 拼接后运行。
# 注意：测试程序使用简化语法（无类型注解）
# ============================================================

输出("========================================")
输出("  简化解释器自举测试")
输出("========================================")
输出("")

# ---------------- 测试 1：变量与算术 ----------------
输出("【测试 1】变量声明与算术表达式")
让 程序1 = "让 x = 5\n让 y = 10\n输出(x + y)\n"
输出("程序: 让 x = 5; 让 y = 10; 输出(x + y)")
输出("实际输出:")
字典 ast1 = 解析源(程序1)
运行程序(ast1)
输出("期望: 15")
输出("")

# ---------------- 测试 2：函数调用 ----------------
输出("【测试 2】函数定义与调用")
让 程序2 = "函数 加(a, b)\n    返回 a + b\n结束\n输出(加(3, 4))\n"
输出("程序: 函数 加(a,b) = a+b; 输出(加(3,4))")
输出("实际输出:")
字典 ast2 = 解析源(程序2)
运行程序(ast2)
输出("期望: 7")
输出("")

# ---------------- 测试 3：如果语句 ----------------
输出("【测试 3】如果/否则")
让 程序3 = "让 n = 5\n如果 n > 3 则\n    输出(n)\n否则\n    输出(0)\n结束\n"
输出("程序: n=5; if n>3 then 输出(n) else 输出(0)")
输出("实际输出:")
字典 ast3 = 解析源(程序3)
运行程序(ast3)
输出("期望: 5")
输出("")

# ---------------- 测试 4：当循环 ----------------
输出("【测试 4】当循环累加")
让 程序4 = "让 s = 0\n让 i = 1\n当 i <= 5 循环\n    s = s + i\n    i = i + 1\n结束\n输出(s)\n"
输出("程序: 累加 1..5")
输出("实际输出:")
字典 ast4 = 解析源(程序4)
运行程序(ast4)
输出("期望: 15")
输出("")

# ---------------- 测试 5：递归函数（斐波那契） ----------------
输出("【测试 5】递归函数 fib(6)")
让 程序5 = "函数 fib(n)\n    如果 n < 2 则\n        返回 n\n    结束\n    返回 fib(n - 1) + fib(n - 2)\n结束\n输出(fib(6))\n"
输出("程序: fib(6) = 8")
输出("实际输出:")
字典 ast5 = 解析源(程序5)
运行程序(ast5)
输出("期望: 8")
输出("")

输出("========================================")
输出("  所有测试完成")
输出("========================================")
