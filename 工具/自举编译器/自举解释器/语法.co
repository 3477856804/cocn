# ============================================================
# 语法.co —— 简化版语法分析器（用 coCN 自身实现）
#
# 输入：token 列表
# 输出：AST 字典（嵌套字典表示）
#
# 支持：变量声明、赋值、算术表达式、if/else、while、函数定义/调用、返回、输出
# 简化：不支持类/闭包/异常等高级特性
# ============================================================

# 跳过换行 token
函数 跳过换行(列表 tokens, 字典 状态)
    当 状态["位置"] < 长度(tokens) 且 tokens[状态["位置"]]["类型"] == "换行" 循环
        状态["位置"] = 状态["位置"] + 1
    结束
结束

# 查看当前 token 的类型
函数 当前类型(列表 tokens, 字典 状态) -> 字符串
    返回 tokens[状态["位置"]]["类型"]
结束

# 查看当前 token 的值
函数 当前值(列表 tokens, 字典 状态) -> 字符串
    返回 tokens[状态["位置"]]["值"]
结束

# 消耗当前 token 并前进
函数 消耗(列表 tokens, 字典 状态) -> 字典
    字典 t = tokens[状态["位置"]]
    状态["位置"] = 状态["位置"] + 1
    返回 t
结束

# 期望当前 token 是指定类型和值，消耗之
函数 期望(列表 tokens, 字典 状态, 字符串 类型, 字符串 值)
    若 tokens[状态["位置"]]["类型"] != 类型 或 tokens[状态["位置"]]["值"] != 值
        输出错误("语法错误：期望 " + 类型 + " '" + 值 + "'，遇到 '" + tokens[状态["位置"]]["值"] + "'")
        退出(1)
    结束
    状态["位置"] = 状态["位置"] + 1
结束

# ---------------- 表达式解析 ----------------

# 解析因子：整数、字符串、标识符、括号表达式、函数调用
函数 解析因子(列表 tokens, 字典 状态) -> 字典
    字符串 t = 当前类型(tokens, 状态)

    若 t == "整数"
        字典 tok = 消耗(tokens, 状态)
        返回 {"类型": "整数", "值": 转整数(tok["值"])}
    结束

    若 t == "字符串"
        字典 tok = 消耗(tokens, 状态)
        返回 {"类型": "字符串", "值": tok["值"]}
    结束

    若 t == "标识符"
        字典 tok = 消耗(tokens, 状态)
        # 检查是否是函数调用：后面跟着 (
        若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == "("
            消耗(tokens, 状态)  # 吃掉 (
            列表 参数 = []
            # 解析参数列表
            若 当前类型(tokens, 状态) != "运算符" 或 当前值(tokens, 状态) != ")"
                当 真 循环
                    字典 arg = 解析表达式(tokens, 状态)
                    追加(参数, arg)
                    若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == ","
                        消耗(tokens, 状态)
                        继续
                    否则
                        跳出
                    结束
                结束
            结束
            期望(tokens, 状态, "运算符", ")")
            返回 {"类型": "调用", "名": tok["值"], "参数": 参数}
        结束
        返回 {"类型": "标识符", "名": tok["值"]}
    结束

    若 t == "运算符" 且 当前值(tokens, 状态) == "("
        消耗(tokens, 状态)  # 吃 (
        字典 e = 解析表达式(tokens, 状态)
        期望(tokens, 状态, "运算符", ")")
        返回 e
    结束

    输出错误("语法错误：意外的 token '" + tokens[状态["位置"]]["值"] + "'")
    退出(1)
    返回 {"类型": "空"}
结束

# 解析项：* / %
函数 解析项(列表 tokens, 字典 状态) -> 字典
    字典 左 = 解析因子(tokens, 状态)
    当 当前类型(tokens, 状态) == "运算符" 且 (当前值(tokens, 状态) == "*" 或 当前值(tokens, 状态) == "/" 或 当前值(tokens, 状态) == "%") 循环
        字符串 op = 当前值(tokens, 状态)
        消耗(tokens, 状态)
        字典 右 = 解析因子(tokens, 状态)
        左 = {"类型": "二元", "左": 左, "运算符": op, "右": 右}
    结束
    返回 左
结束

# 解析表达式：+ -
函数 解析表达式(列表 tokens, 字典 状态) -> 字典
    字典 左 = 解析项(tokens, 状态)
    当 当前类型(tokens, 状态) == "运算符" 且 (当前值(tokens, 状态) == "+" 或 当前值(tokens, 状态) == "-") 循环
        字符串 op = 当前值(tokens, 状态)
        消耗(tokens, 状态)
        字典 右 = 解析项(tokens, 状态)
        左 = {"类型": "二元", "左": 左, "运算符": op, "右": 右}
    结束
    返回 左
结束

# 解析比较表达式：== != < > <= >=
函数 解析比较(列表 tokens, 字典 状态) -> 字典
    字典 左 = 解析表达式(tokens, 状态)
    当 当前类型(tokens, 状态) == "运算符" 且 (当前值(tokens, 状态) == "==" 或 当前值(tokens, 状态) == "!=" 或 当前值(tokens, 状态) == "<" 或 当前值(tokens, 状态) == ">" 或 当前值(tokens, 状态) == "<=" 或 当前值(tokens, 状态) == ">=") 循环
        字符串 op = 当前值(tokens, 状态)
        消耗(tokens, 状态)
        字典 右 = 解析表达式(tokens, 状态)
        左 = {"类型": "二元", "左": 左, "运算符": op, "右": 右}
    结束
    返回 左
结束

# ---------------- 语句解析 ----------------

# 解析语句体（直到遇到 结束 或 否则 或 文件结束）
函数 解析语句体(列表 tokens, 字典 状态) -> 列表
    列表 体 = []
    跳过换行(tokens, 状态)
    当 当前类型(tokens, 状态) != "文件结束" 且 不是结束关键字(tokens, 状态) 循环
        字典 stmt = 解析语句(tokens, 状态)
        追加(体, stmt)
        跳过换行(tokens, 状态)
    结束
    返回 体
结束

# 判断当前 token 是否是语句体结束关键字（结束/否则）
函数 不是结束关键字(列表 tokens, 字典 状态) -> 布尔
    若 当前类型(tokens, 状态) != "关键字"
        返回 真
    结束
    字符串 v = 当前值(tokens, 状态)
    返回 v != "结束" 且 v != "否则"
结束

# 解析单条语句
函数 解析语句(列表 tokens, 字典 状态) -> 字典
    字符串 t = 当前类型(tokens, 状态)
    字符串 v = 当前值(tokens, 状态)

    # 变量声明：让 x = expr
    若 t == "关键字" 且 v == "让"
        消耗(tokens, 状态)  # 吃 让
        字典 名tok = 消耗(tokens, 状态)  # 吃 变量名
        期望(tokens, 状态, "运算符", "=")
        字典 值 = 解析比较(tokens, 状态)
        返回 {"类型": "变量声明", "名": 名tok["值"], "值": 值}
    结束

    # 如果语句：如果 cond 则 ... 否则 ... 结束
    若 t == "关键字" 且 v == "如果"
        消耗(tokens, 状态)  # 吃 如果
        字典 条件 = 解析比较(tokens, 状态)
        # 吃 则
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "则"
            消耗(tokens, 状态)
        结束
        列表 体 = 解析语句体(tokens, 状态)
        列表 否则体 = []
        # 否则分支
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "否则"
            消耗(tokens, 状态)  # 吃 否则
            跳过换行(tokens, 状态)
            否则体 = 解析语句体(tokens, 状态)
        结束
        # 吃 结束
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "结束"
            消耗(tokens, 状态)
        结束
        返回 {"类型": "如果", "条件": 条件, "体": 体, "否则体": 否则体}
    结束

    # 当循环：当 cond 循环 ... 结束
    若 t == "关键字" 且 v == "当"
        消耗(tokens, 状态)  # 吃 当
        字典 条件 = 解析比较(tokens, 状态)
        # 吃 循环
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "循环"
            消耗(tokens, 状态)
        结束
        列表 体 = 解析语句体(tokens, 状态)
        # 吃 结束
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "结束"
            消耗(tokens, 状态)
        结束
        返回 {"类型": "当", "条件": 条件, "体": 体}
    结束

    # 函数定义：函数 名(参数) ... 结束
    若 t == "关键字" 且 v == "函数"
        消耗(tokens, 状态)  # 吃 函数
        字典 名tok = 消耗(tokens, 状态)  # 吃 函数名
        期望(tokens, 状态, "运算符", "(")
        列表 参数 = []
        若 当前类型(tokens, 状态) != "运算符" 或 当前值(tokens, 状态) != ")"
            当 真 循环
                字典 ptok = 消耗(tokens, 状态)
                追加(参数, ptok["值"])
                若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == ","
                    消耗(tokens, 状态)
                    继续
                否则
                    跳出
                结束
            结束
        结束
        期望(tokens, 状态, "运算符", ")")
        列表 体 = 解析语句体(tokens, 状态)
        # 吃 结束
        若 当前类型(tokens, 状态) == "关键字" 且 当前值(tokens, 状态) == "结束"
            消耗(tokens, 状态)
        结束
        返回 {"类型": "函数定义", "名": 名tok["值"], "参数": 参数, "体": 体}
    结束

    # 返回语句：返回 expr
    若 t == "关键字" 且 v == "返回"
        消耗(tokens, 状态)  # 吃 返回
        字典 值 = 解析比较(tokens, 状态)
        返回 {"类型": "返回", "值": 值}
    结束

    # 输出语句：输出(expr)
    若 t == "关键字" 且 v == "输出"
        消耗(tokens, 状态)  # 吃 输出
        列表 参数 = []
        # 支持 输出(expr) 或 输出 expr
        若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == "("
            消耗(tokens, 状态)  # 吃 (
            若 当前类型(tokens, 状态) != "运算符" 或 当前值(tokens, 状态) != ")"
                当 真 循环
                    字典 arg = 解析比较(tokens, 状态)
                    追加(参数, arg)
                    若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == ","
                        消耗(tokens, 状态)
                        继续
                    否则
                        跳出
                    结束
                结束
            结束
            期望(tokens, 状态, "运算符", ")")
        否则
            字典 arg = 解析比较(tokens, 状态)
            追加(参数, arg)
        结束
        返回 {"类型": "输出", "参数": 参数}
    结束

    # 赋值语句：x = expr  或  表达式语句（函数调用）
    若 t == "标识符"
        字典 名tok = 消耗(tokens, 状态)
        # 检查是否是赋值
        若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == "="
            消耗(tokens, 状态)  # 吃 =
            字典 值 = 解析比较(tokens, 状态)
            返回 {"类型": "赋值", "名": 名tok["值"], "值": 值}
        结束
        # 否则是函数调用表达式语句（我们已经在解析因子里处理了调用）
        # 这里需要回溯：把名tok放回去，当作表达式解析
        # 简化处理：直接构造调用节点
        # 实际上我们已经吃了标识符，检查后面是否有 (
        若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == "("
            消耗(tokens, 状态)  # 吃 (
            列表 参数 = []
            若 当前类型(tokens, 状态) != "运算符" 或 当前值(tokens, 状态) != ")"
                当 真 循环
                    字典 arg = 解析比较(tokens, 状态)
                    追加(参数, arg)
                    若 当前类型(tokens, 状态) == "运算符" 且 当前值(tokens, 状态) == ","
                        消耗(tokens, 状态)
                        继续
                    否则
                        跳出
                    结束
                结束
            结束
            期望(tokens, 状态, "运算符", ")")
            返回 {"类型": "调用", "名": 名tok["值"], "参数": 参数}
        结束
        # 普通表达式语句（不常见，但支持）
        返回 {"类型": "表达式语句", "值": {"类型": "标识符", "名": 名tok["值"]}}
    结束

    输出错误("语法错误：未知语句 '" + v + "'")
    退出(1)
    返回 {"类型": "空"}
结束

# 解析整个程序
函数 解析源(字符串 源) -> 字典
    列表 tokens = 词法分析(源)
    字典 状态 = {"位置": 0}
    列表 体 = []
    跳过换行(tokens, 状态)
    当 状态["位置"] < 长度(tokens) 且 tokens[状态["位置"]]["类型"] != "文件结束" 循环
        字典 stmt = 解析语句(tokens, 状态)
        追加(体, stmt)
        跳过换行(tokens, 状态)
    结束
    返回 {"类型": "程序", "体": 体}
结束
