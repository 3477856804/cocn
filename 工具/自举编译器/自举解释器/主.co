# ============================================================
# 主.co —— 简化解释器主入口
#
# 用法：
#   COCN_INPUT=输入.co COCN_BACKEND=eval node bin/cocn.js 合并文件.co
#
# 流程：
#   1. 从 COCN_INPUT 读取源文件路径
#   2. 读取源码
#   3. 词法分析 → 语法分析 → 求值
#   4. 输出结果
# ============================================================

# 读取输入文件路径
让 输入路径 = 环境变量("COCN_INPUT")

如果 输入路径 == "" 则
    输出错误("用法：COCN_INPUT=输入.co 运行本程序")
    退出(1)
结束

# 读取源码
让 源 = 读取文件(输入路径)

输出("=== 简化解释器启动 ===")
输出("输入文件: " + 输入路径)
输出("源码长度: " + 转字符串(长度(源)) + " 字符")
输出("")

# 词法分析
输出("--- 词法分析 ---")
列表 tokens = 词法分析(源)
输出("生成 " + 转字符串(长度(tokens)) + " 个 token")
输出("")

# 语法分析
输出("--- 语法分析 ---")
字典 ast = 解析源(源)
输出("解析完成，顶层语句数: " + 转字符串(长度(ast["体"])))
输出("")

# 求值
输出("--- 运行结果 ---")
字典 结果 = 运行程序(ast)
输出("")
输出("=== 程序结束，返回值: " + 转字符串(结果["值"]) + " ===")
