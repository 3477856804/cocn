# ============================================================
# 词法.co —— 简化版词法分析器（用 coCN 自身实现）
#
# 输入：源码字符串
# 输出：token 列表，每个 token 是字典：
#   {"类型": "整数"|"标识符"|"关键字"|"运算符"|"字符串"|"换行"|"文件结束", "值": ...}
#
# 支持：标识符、整数、字符串、运算符、关键字
# 简化：不处理复杂转义、注释从简
# ============================================================

# 判断是否为数字字符
函数 是数字(字符串 c) -> 布尔
    返回 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9"
结束

# 判断是否为操作符字符
函数 是操作符字符(字符串 c) -> 布尔
    返回 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" 或 c == "!" 或 c == "<" 或 c == ">" 或 c == "(" 或 c == ")" 或 c == "{" 或 c == "}" 或 c == "," 或 c == ";" 或 c == "[" 或 c == "]"
结束

# 判断是否为关键字
函数 是关键字(字符串 词) -> 布尔
    返回 词 == "让" 或 词 == "如果" 或 词 == "否则" 或 词 == "当" 或 词 == "循环" 或 词 == "结束" 或 词 == "函数" 或 词 == "返回" 或 词 == "输出" 或 词 == "则" 或 词 == "真" 或 词 == "假" 或 词 == "空"
结束

# 词法分析主函数
函数 词法分析(字符串 源) -> 列表
    列表 表 = []
    整数 n = 长度(源)
    整数 p = 0
    整数 行有内容 = 0

    当 p < n 循环
        字符串 c = 源[p]

        # 跳过空白
        若 c == " " 或 c == "\t" 或 c == "\r"
            p = p + 1
            继续
        结束

        # 注释：跳到行尾
        若 c == "#"
            当 p < n 且 源[p] != "\n" 循环
                p = p + 1
            结束
            继续
        结束

        # 换行
        若 c == "\n"
            若 行有内容 == 1
                追加(表, {"类型": "换行", "值": "\n"})
                行有内容 = 0
            结束
            p = p + 1
            继续
        结束

        # 数字
        若 是数字(c)
            整数 起 = p
            当 p < n 且 是数字(源[p]) 循环
                p = p + 1
            结束
            字符串 词 = 截取(源, 起, p - 起)
            追加(表, {"类型": "整数", "值": 词})
            行有内容 = 1
            继续
        结束

        # 字符串（双引号，不处理转义）
        若 c == "\""
            p = p + 1
            字符串 内容 = ""
            当 p < n 且 源[p] != "\"" 循环
                内容 = 内容 + 源[p]
                p = p + 1
            结束
            若 p < n
                p = p + 1
            结束
            追加(表, {"类型": "字符串", "值": 内容})
            行有内容 = 1
            继续
        结束

        # 运算符
        若 是操作符字符(c)
            字符串 词 = c
            # 双字符运算符
            若 c == "=" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "=="
                p = p + 2
            否则 若 c == "!" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "!="
                p = p + 2
            否则 若 c == "<" 且 p + 1 < n 且 源[p + 1] == "="
                词 = "<="
                p = p + 2
            否则 若 c == ">" 且 p + 1 < n 且 源[p + 1] == "="
                词 = ">="
                p = p + 2
            否则
                p = p + 1
            结束
            追加(表, {"类型": "运算符", "值": 词})
            行有内容 = 1
            继续
        结束

        # 标识符 / 关键字
        整数 起 = p
        当 p < n 循环
            字符串 cc = 源[p]
            若 cc == " " 或 cc == "\t" 或 cc == "\r" 或 cc == "\n"
                跳出
            结束
            若 cc == "#" 或 cc == "\""
                跳出
            结束
            若 是操作符字符(cc)
                跳出
            结束
            p = p + 1
        结束
        字符串 词 = 截取(源, 起, p - 起)
        若 是关键字(词)
            追加(表, {"类型": "关键字", "值": 词})
        否则
            追加(表, {"类型": "标识符", "值": 词})
        结束
        行有内容 = 1
    结束

    追加(表, {"类型": "文件结束", "值": ""})
    返回 表
结束
