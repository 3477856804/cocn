# ============================================================
# 测试类型系统.co —— 类型系统自举版测试
#
# 运行方式：与 类型系统.co 拼接后用 node bin/cocn.js 运行
# ============================================================

让 g_通过数 = 0
让 g_失败数 = 0

函数 断言(布尔 条件, 字符串 消息)
    若 条件
        输出 "  ✓ 通过: " + 消息
        g_通过数 = g_通过数 + 1
    否则
        输出 "  ✗ 失败: " + 消息
        g_失败数 = g_失败数 + 1
    结束
结束

# ============================================================
# 测试 1：基本类型推断
# ============================================================
函数 测试1_基本类型推断()
    输出 "测试1: 基本类型推断"
    字典 lit5 = {"类型": "字面量", "值": "5", "字面类型": "整数"}
    字典 litpi = {"类型": "字面量", "值": "3.14", "字面类型": "浮点"}
    字典 decx = {"类型": "变量声明", "名字": "x", "类型标注": "", "初始化": lit5}
    字典 decy = {"类型": "变量声明", "名字": "y", "类型标注": "", "初始化": litpi}
    字典 程序 = {"类型": "程序", "语句": [decx, decy]}
    字典 结果 = 类型推断分析(程序)
    字典 全局 = 结果["全局"]
    字符串 xt = "未定义"
    若 包含(全局, "x")
        xt = 全局["x"]
    结束
    字符串 yt = "未定义"
    若 包含(全局, "y")
        yt = 全局["y"]
    结束
    断言(xt == "整数", "x=5 推断为整数（实际: " + xt + "）")
    断言(yt == "浮点", "y=3.14 推断为浮点（实际: " + yt + "）")
结束

# ============================================================
# 测试 2：类型漂移
# ============================================================
函数 测试2_类型漂移()
    输出 "测试2: 类型漂移"
    字典 lit5 = {"类型": "字面量", "值": "5", "字面类型": "整数"}
    字典 litstr = {"类型": "字面量", "值": "hello", "字面类型": "字符串"}
    字典 decx = {"类型": "变量声明", "名字": "x", "类型标注": "", "初始化": lit5}
    字典 asgx = {"类型": "赋值", "目标": {"类型": "标识符", "名字": "x"}, "值": litstr}
    字典 程序 = {"类型": "程序", "语句": [decx, asgx]}
    字典 结果 = 类型推断分析(程序)
    字典 全局 = 结果["全局"]
    字符串 xt = "未定义"
    若 包含(全局, "x")
        xt = 全局["x"]
    结束
    断言(xt == "动态", "x=5 后赋值字符串 → x升级为动态（实际: " + xt + "）")
结束

# ============================================================
# 测试 3：函数特化
# ============================================================
函数 测试3_函数特化()
    输出 "测试3: 函数特化"
    字典 a_id = {"类型": "标识符", "名字": "a"}
    字典 b_id = {"类型": "标识符", "名字": "b"}
    字典 addbody = {"类型": "二元", "运算符": "+", "左": a_id, "右": b_id}
    字典 ret = {"类型": "返回", "值": addbody}
    字典 体 = {"类型": "程序", "语句": [ret]}
    字典 加函数 = {"类型": "函数定义", "名字": "加", "参数": ["a", "b"], "参数类型": ["", ""], "返回类型": "", "体": 体}
    字典 lit1 = {"类型": "字面量", "值": "1", "字面类型": "整数"}
    字典 lit2 = {"类型": "字面量", "值": "2", "字面类型": "整数"}
    字典 lit15 = {"类型": "字面量", "值": "1.5", "字面类型": "浮点"}
    字典 lit25 = {"类型": "字面量", "值": "2.5", "字面类型": "浮点"}
    字典 callint = {"类型": "函数调用", "被调者": {"类型": "标识符", "名字": "加"}, "参数": [lit1, lit2]}
    字典 callfloat = {"类型": "函数调用", "被调者": {"类型": "标识符", "名字": "加"}, "参数": [lit15, lit25]}
    字典 decu = {"类型": "变量声明", "名字": "u", "类型标注": "", "初始化": callint}
    字典 decv = {"类型": "变量声明", "名字": "v", "类型标注": "", "初始化": callfloat}
    字典 程序 = {"类型": "程序", "语句": [加函数, decu, decv]}
    字典 推断 = 类型推断分析(程序)
    字典 特化 = 执行函数特化(程序, 推断)
    字典 特化表 = 特化["特化函数表"]
    整数 特化数 = 长度(键(特化表))
    断言(特化数 == 2, "加(a,b) 被(int,int)和(float,float)调用 → 生成2个特化版本（实际: " + 转字符串(特化数) + "）")
    列表 名表 = 键(特化表)
    布尔 见整数 = 假
    布尔 见浮点 = 假
    对于 i 从 0 到 长度(名表) - 1 循环
        若 包含(名表[i], "整数")
            见整数 = 真
        结束
        若 包含(名表[i], "浮点")
            见浮点 = 真
        结束
    结束
    断言(见整数, "特化版本包含整数特化")
    断言(见浮点, "特化版本包含浮点特化")
结束

# ============================================================
# 测试 4：内联
# ============================================================
函数 测试4_内联()
    输出 "测试4: 激进内联"
    字典 x_id = {"类型": "标识符", "名字": "x"}
    字典 mulbody = {"类型": "二元", "运算符": "*", "左": x_id, "右": x_id}
    字典 ret = {"类型": "返回", "值": mulbody}
    字典 体 = {"类型": "程序", "语句": [ret]}
    字典 平方函数 = {"类型": "函数定义", "名字": "平方", "参数": ["x"], "参数类型": [""], "返回类型": "", "体": 体}
    字典 lit5 = {"类型": "字面量", "值": "5", "字面类型": "整数"}
    字典 call = {"类型": "函数调用", "被调者": {"类型": "标识符", "名字": "平方"}, "参数": [lit5]}
    字典 decr = {"类型": "变量声明", "名字": "r", "类型标注": "", "初始化": call}
    字典 程序 = {"类型": "程序", "语句": [平方函数, decr]}
    字典 推断 = 类型推断分析(程序)
    字典 内联结果 = 执行内联(程序)
    整数 内联数 = 内联结果["内联次数"]
    断言(内联数 >= 1, "小函数 平方(x) 被内联（内联次数: " + 转字符串(内联数) + "）")
结束

# ============================================================
# 测试 5：逃逸分析 + 标量替换
# ============================================================
函数 测试5_逃逸分析()
    输出 "测试5: 逃逸分析与标量替换"
    字典 lit1 = {"类型": "字面量", "值": "1", "字面类型": "整数"}
    字典 lit2 = {"类型": "字面量", "值": "2", "字面类型": "整数"}
    字典 keyx = {"类型": "字面量", "值": "x", "字面类型": "字符串"}
    字典 keyy = {"类型": "字面量", "值": "y", "字面类型": "字符串"}
    字典 dictlit = {"类型": "字典字面量", "键": [keyx, keyy], "值": [lit1, lit2]}
    字典 decp = {"类型": "变量声明", "名字": "p", "类型标注": "", "初始化": dictlit}
    字典 p_id = {"类型": "标识符", "名字": "p"}
    字典 subx = {"类型": "下标", "容器": p_id, "索引": keyx}
    字典 deca = {"类型": "变量声明", "名字": "a", "类型标注": "", "初始化": subx}
    字典 a_id = {"类型": "标识符", "名字": "a"}
    字典 ret = {"类型": "返回", "值": a_id}
    字典 体 = {"类型": "程序", "语句": [decp, deca, ret]}
    字典 函数节点 = {"类型": "函数定义", "名字": "制造点", "参数": [], "参数类型": [], "返回类型": "", "体": 体}
    字典 程序 = {"类型": "程序", "语句": [函数节点]}
    字典 推断 = 类型推断分析(程序)
    字典 逃逸结果 = 执行逃逸分析(程序)
    整数 可替换数 = 逃逸结果["可标量替换数"]
    断言(可替换数 >= 1, "不逃逸的字典 p 被标量替换（可替换数: " + 转字符串(可替换数) + "）")
    字典 替换表 = 逃逸结果["标量替换表"]
    布尔 见p = 假
    列表 名表 = 键(替换表)
    对于 i 从 0 到 长度(名表) - 1 循环
        若 名表[i] == "p"
            见p = 真
        结束
    结束
    断言(见p, "标量替换表包含变量 p")
结束

# ============================================================
# 测试 6：循环收敛
# ============================================================
函数 测试6_循环收敛()
    输出 "测试6: 循环累加变量类型收敛"
    字典 lit0 = {"类型": "字面量", "值": "0", "字面类型": "整数"}
    字典 lit1 = {"类型": "字面量", "值": "1", "字面类型": "整数"}
    字典 n_id = {"类型": "标识符", "名字": "n"}
    字典 sum_id = {"类型": "标识符", "名字": "总和"}
    字典 i_id = {"类型": "标识符", "名字": "i"}
    字典 add = {"类型": "二元", "运算符": "+", "左": sum_id, "右": i_id}
    字典 assn = {"类型": "赋值", "目标": sum_id, "值": add}
    字典 fornode = {"类型": "对于", "变量": "i", "起点": lit1, "终点": n_id, "步长": {"类型": "空值"}, "体": [assn], "是否遍历": 0}
    字典 decsum = {"类型": "变量声明", "名字": "总和", "类型标注": "", "初始化": lit0}
    字典 ret = {"类型": "返回", "值": sum_id}
    字典 体 = {"类型": "程序", "语句": [decsum, fornode, ret]}
    字典 函数节点 = {"类型": "函数定义", "名字": "求和", "参数": ["n"], "参数类型": ["整数"], "返回类型": "", "体": 体}
    字典 程序 = {"类型": "程序", "语句": [函数节点]}
    字典 推断 = 类型推断分析(程序)
    字符串 ret = "未定义"
    若 包含(推断["返回类型"], "求和")
        ret = 推断["返回类型"]["求和"]
    结束
    断言(ret == "整数", "循环累加 总和 返回类型收敛为整数（实际: " + ret + "）")
结束

# ============================================================
# 测试 7：LUB 与子类型（单元测试）
# ============================================================
函数 测试7_LUB与子类型()
    输出 "测试7: LUB 与子类型规则"
    断言(类型LUB("整数", "整数") == "整数", "整数+整数=整数")
    断言(类型LUB("整数", "浮点") == "浮点", "整数+浮点=浮点")
    断言(类型LUB("浮点", "整数") == "浮点", "浮点+整数=浮点")
    断言(类型LUB("整数", "字符串") == "动态", "整数+字符串=动态")
    断言(类型LUB("动态", "整数") == "动态", "动态+整数=动态")
    断言(类型LUB("未定义", "整数") == "整数", "未定义+整数=整数")
    断言(是子类型("整数", "动态"), "整数<:动态")
    断言(是子类型("整数", "浮点"), "整数<:浮点（隐式加宽）")
    断言(是子类型("未定义", "整数"), "未定义<:一切")
    断言(二元结果("+", "整数", "整数") == "整数", "整数+整数→整数")
    断言(二元结果("+", "整数", "浮点") == "浮点", "整数+浮点→浮点")
    断言(二元结果("+", "字符串", "字符串") == "字符串", "字符串+字符串→字符串")
    断言(二元结果("==", "整数", "整数") == "布尔", "整数==整数→布尔")
结束

# ============================================================
# 主入口
# ============================================================
输出 "=========================================="
输出 "类型系统自举版测试"
输出 "=========================================="
测试1_基本类型推断()
测试2_类型漂移()
测试3_函数特化()
测试4_内联()
测试5_逃逸分析()
测试6_循环收敛()
测试7_LUB与子类型()
输出 "=========================================="
输出 "测试结果: 通过 " + 转字符串(g_通过数) + " / 失败 " + 转字符串(g_失败数)
若 g_失败数 == 0
    输出 "全部通过 ✓"
否则
    输出 "存在失败用例 ✗"
结束
