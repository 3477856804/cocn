# ============================================================
# 词法调试.co —— 把 token 列表打印为可读格式（调试用）
#
# 用法：在主程序中调用 打印Tokens(tokens)
# 输出示例：
#   [0] 关键字  '让'      (行1,列1)
#   [1] 标识符  'x'       (行1,列3)
#   [2] 运算符  '='       (行1,列5)
#   [3] 整数    '5'       (行1,列7)
#   [4] 换行    '\n'      (行1,列8)
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 把单个 token 格式化为一行字符串
函数 格式化Token(字典 t, 整数 序号) -> 字符串
    字符串 类型 = t["类型"]
    字符串 值 = t["值"]
    整数 行 = t["行"]
    整数 列 = t["列"]
    # 特殊显示换行和空字符串
    若 类型 == "换行"
        值 = "\\n"
    结束
    若 类型 == "文件结束"
        值 = "EOF"
    结束
    返回 "[" + 转字符串(序号) + "] " + 类型 + "  '" + 值 + "'  (行" + 转字符串(行) + ",列" + 转字符串(列) + ")"
结束

# 打印整个 token 列表到 stdout
函数 打印Tokens(列表 tokens)
    输出 "=== Token 列表 (共 " + 转字符串(长度(tokens)) + " 个) ==="
    对于 i 从 0 到 长度(tokens) - 1 循环
        输出 格式化Token(tokens[i], i)
    结束
    输出 "=== Token 列表结束 ==="
结束

# 按类型统计 token 数量
函数 统计Token类型(列表 tokens) -> 字典
    字典 统计 = {}
    对于 i 从 0 到 长度(tokens) - 1 循环
        字符串 类型 = tokens[i]["类型"]
        若 包含(统计, 类型)
            统计[类型] = 统计[类型] + 1
        否则
            统计[类型] = 1
        结束
    结束
    返回 统计
结束

# 打印 token 类型统计
函数 打印Token统计(列表 tokens)
    字典 统计 = 统计Token类型(tokens)
    输出 "=== Token 类型统计 ==="
    列表 ks = 键(统计)
    对于 i 从 0 到 长度(ks) - 1 循环
        输出 "  " + ks[i] + ": " + 转字符串(统计[ks[i]])
    结束
    输出 "=== 统计结束 ==="
结束
