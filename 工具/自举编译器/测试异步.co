# ============================================================
# 测试异步.co —— Promise / 迭代器 / 生成器 / 异步函数 / 异步迭代器
#
# 运行方式：
#   cat 词法分析器.co 语法分析器.co 代码生成器.co 测试异步.co > /tmp/t.co \
#     && node bin/cocn.js /tmp/t.co
#
# 边界说明：不修改语法分析器，异步特性以纯 coCN 运行时模拟：
#   * Promise   = 字典（状态+值+回调队列）；创建承诺/然后/捕获/最终/链式
#   * 静态方法  = 承诺.全部 / 承诺.竞速 / 承诺.解决 / 承诺.拒绝
#   * 迭代器    = 下一个()->{值,完成}；__迭代器__ 协议；遍历每个/收集；创建范围
#   * 生成器    = 返回迭代器对象的工厂（闭包状态机）；支持委托与 for-of
#   * 异步函数  = 创建异步函数0/1/2 包装；等待承诺(p) 取终值；并行=承诺.全部
#   * 异步迭代器= 下一个() 返回 Promise<{值,完成}>；等待收集
#
# 结果值统一收拢到字典 R，减少全局顶层绑定数（解释器全局字典上限 256 键）。
# ============================================================

输出("==== 异步编程特性测试开始 ====")
让 R = {}

# ============================================================
# 1. Promise：创建 / 然后 / 捕获 / 链式调用
# ============================================================
输出("-- 1. Promise 创建/然后/捕获/链式 --")

函数 执行器基本(解决, 拒绝)
    解决(42)
结束
函数 回调拿到值(v)
    R["拿到"] = v
结束
函数 回调乘2(v)
    返回 v * 10
结束
函数 回调第二(w)
    R["链2"] = w
结束
函数 执行器拒绝(解决, 拒绝)
    拒绝("出错了")
结束
函数 回调捕获(e)
    R["捕获"] = e
结束
函数 回调穿透(e)
    R["穿透"] = e + "_透"
结束
函数 execF(解决, 拒绝)
    解决(7)
结束
函数 回调finally()
    R["fn"] = 1
结束

让 p1 = 创建承诺(执行器基本)
断言相等(p1["_状态"], "fulfilled", "1.1 执行器内解决后状态=fulfilled")
p1["然后"](回调拿到值)
断言相等(R["拿到"], 42, "1.1 then 回调拿到解决值")
p1["然后"](回调乘2)["然后"](回调第二)
断言相等(R["链2"], 420, "1.2 链式：第二个 then 收到第一个 then 的返回值")

让 pe = 创建承诺(执行器拒绝)
pe["捕获"](回调捕获)
断言相等(R["捕获"], "出错了", "1.3 catch 收到拒绝原因")
pe["然后"](回调乘2)["捕获"](回调穿透)
断言相等(R["穿透"], "出错了_透", "1.4 拒绝穿透到后续 catch")

让 pf = 创建承诺(execF)
pf["最终"](回调finally)
断言相等(R["fn"], 1, "1.5 finally 执行一次")
输出("测试1 Promise 基础 通过")

# ============================================================
# 2. Promise 静态方法：全部 / 竞速 / 解决 / 拒绝
# ============================================================
输出("-- 2. Promise 静态方法 --")

函数 回调全部(v)
    R["全部和"] = v[0] + v[1] + v[2]
结束
函数 exec慢(解决, 拒绝)
    R["慢解决"] = 解决
结束
函数 exec快(解决, 拒绝)
    解决("快")
结束
函数 回调竞速(v)
    R["胜者"] = v
结束

让 已解决 = 承诺["解决"](123)
断言相等(已解决["_状态"], "fulfilled", "2.1 承诺.解决 立刻兑现")
让 已拒绝 = 承诺["拒绝"]("bad")
断言相等(已拒绝["_状态"], "rejected", "2.1 承诺.拒绝 立刻拒绝")

让 pa = 承诺["解决"](10)
让 pb = 承诺["解决"](20)
让 pc = 承诺["解决"](30)
承诺["全部"]([pa, pb, pc])["然后"](回调全部)
断言相等(R["全部和"], 60, "2.2 承诺.全部 收集 10+20+30")

让 p慢 = 创建承诺(exec慢)
让 p快 = 创建承诺(exec快)
承诺["竞速"]([p慢, p快])["然后"](回调竞速)
断言相等(R["胜者"], "快", "2.3 竞速选先兑现者")

让 空全部 = 承诺["全部"]([])
断言相等(空全部["_状态"], "fulfilled", "2.4 空列表全部立刻兑现")
输出("测试2 Promise 静态方法 通过")

# ============================================================
# 3. 迭代器：自定义迭代器 / for-of 遍历 / 列表迭代
# ============================================================
输出("-- 3. 迭代器协议 --")

函数 累加(v)
    R["lst和"] = R["lst和"] + v
结束

R["lst和"] = 0
遍历每个([10, 20, 30], 累加)
断言相等(R["lst和"], 60, "3.1 遍历每个 累加列表 10+20+30")

让 rng收集 = 收集(创建范围(1, 5))
断言相等(长度(rng收集), 5, "3.2 范围 1..5 共 5 个")
断言相等(rng收集[0], 1, "3.2 范围首项=1")
断言相等(rng收集[4], 5, "3.2 范围末项=5")

R["求和3"] = 0
对于 x 在 rng收集 循环
    R["求和3"] = R["求和3"] + x
结束
断言相等(R["求和3"], 15, "3.3 for-of 遍历 1..5 之和=15")

让 手动it = 创建范围(1, 5)["__迭代器__"]()
让 s1 = 手动it["下一个"]()
断言相等(s1["值"], 1, "3.4 手动下一个 首个值=1")
断言相等(s1["完成"], 0, "3.4 手动下一个 未完成")
手动it["下一个"]()
手动it["下一个"]()
手动it["下一个"]()
手动it["下一个"]()
让 s最后 = 手动it["下一个"]()
断言相等(s最后["完成"], 1, "3.4 手动下一个 第6次完成")
输出("测试3 迭代器 通过")

# ============================================================
# 4. 生成器：简单生成器 / 生成器委托 / for-of 遍历生成器
# ============================================================
输出("-- 4. 生成器 --")

函数 计数到(最大值)
    让 状态 = {"当前": 1, "上限": 最大值}
    函数 nm()
        如果 状态["当前"] <= 状态["上限"] 则
            让 v = 状态["当前"]
            状态["当前"] = 状态["当前"] + 1
            返回 {"值": v, "完成": 0}
        结束
        返回 {"值": 0, "完成": 1}
    结束
    返回 {"下一个": nm}
结束
函数 委托生成器()
    让 it1 = 创建范围(1, 3)["__迭代器__"]()
    让 it2 = 创建范围(10, 12)["__迭代器__"]()
    让 状态 = {"阶段": 0, "it1": it1, "it2": it2}
    函数 nm()
        如果 状态["阶段"] == 0 则
            让 r = 状态["it1"]["下一个"]()
            如果 r["完成"] == 1 则
                状态["阶段"] = 1
            否则
                返回 r
            结束
        结束
        返回 状态["it2"]["下一个"]()
    结束
    返回 {"下一个": nm}
结束

让 g1 = 计数到(5)
让 gfirst = g1["下一个"]()
断言相等(gfirst["值"], 1, "4.1 生成器首值=1")
让 g收集 = 收集(计数到(5))
断言相等(长度(g收集), 5, "4.1 生成器计数到5共5个")

R["g和"] = 0
对于 x 在 收集(计数到(4)) 循环
    R["g和"] = R["g和"] + x
结束
断言相等(R["g和"], 10, "4.2 for-of 遍历生成器 1+2+3+4=10")

让 d收集 = 收集(委托生成器())
断言相等(长度(d收集), 6, "4.3 委托生成器共 6 项")
断言相等(d收集[0], 1, "4.3 委托首项=1")
断言相等(d收集[3], 10, "4.3 委托第4项=10")
断言相等(d收集[5], 12, "4.3 委托末项=12")
输出("测试4 生成器 通过")

# ============================================================
# 5. 异步函数：async/await / 并行等待
# ============================================================
输出("-- 5. 异步函数 --")

函数 同步取数()
    返回 42
结束
函数 返回承诺()
    返回 承诺["解决"](99)
结束
函数 加倍(x)
    返回 x * 2
结束
函数 取a()
    返回 100
结束
函数 取b()
    返回 200
结束
函数 会抛错()
    抛出 "异步出错"
结束

让 异步取数 = 创建异步函数0(同步取数)
让 ap = 异步取数()
断言相等(ap["_状态"], "fulfilled", "5.1 异步函数返回已兑现承诺")
断言相等(等待承诺(ap), 42, "5.1 等待承诺 取到 42")

让 异步包装 = 创建异步函数0(返回承诺)
断言相等(等待承诺(异步包装()), 99, "5.2 thenable 自动采用")

让 异步加倍 = 创建异步函数1(加倍)
断言相等(等待承诺(异步加倍(21)), 42, "5.3 1参异步函数")

让 异步a = 创建异步函数0(取a)
让 异步b = 创建异步函数0(取b)
让 并行结果 = 等待承诺(承诺["全部"]([异步a(), 异步b()]))
断言相等(并行结果[0] + 并行结果[1], 300, "5.4 并行等待 100+200")

让 异步错 = 创建异步函数0(会抛错)
断言相等(异步错()["_状态"], "rejected", "5.5 异步函数抛错自动 reject")
输出("测试5 异步函数 通过")

# ============================================================
# 6. 异步迭代器：异步生成器 / for-await-of
# ============================================================
输出("-- 6. 异步迭代器 --")

函数 异步计数(最大值)
    让 状态 = {"当前": 1, "上限": 最大值}
    函数 nm()
        如果 状态["当前"] <= 状态["上限"] 则
            让 v = 状态["当前"]
            状态["当前"] = 状态["当前"] + 1
            返回 承诺["解决"]({"值": v, "完成": 0})
        结束
        返回 承诺["解决"]({"值": 0, "完成": 1})
    结束
    返回 {"下一个": nm}
结束

让 a收集 = 等待收集(异步计数(5))
断言相等(长度(a收集), 5, "6.1 异步生成器共 5 项")
断言相等(a收集[0], 1, "6.1 异步首项=1")
断言相等(a收集[4], 5, "6.1 异步末项=5")

R["a和"] = 0
对于 x 在 a收集 循环
    R["a和"] = R["a和"] + x
结束
断言相等(R["a和"], 15, "6.2 异步迭代 1..5 求和=15")
输出("测试6 异步迭代器 通过")

# ============================================================
输出("==== 异步编程特性测试全部通过 ====")
