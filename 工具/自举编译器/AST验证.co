# ============================================================
# AST验证.co —— 验证 AST 结构的合法性（调试与质量保证）
#
# 功能：
#   - 检查 AST 根节点类型是否为 "程序"
#   - 递归检查每个节点的必需字段是否存在
#   - 统计节点总数、各类型节点数量
#   - 输出验证报告
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 全局错误计数
让 验证错误数 = 0

# 记录一个验证错误
函数 记录验证错误(字符串 消息)
    验证错误数 = 验证错误数 + 1
    输出错误("AST验证错误: " + 消息)
结束

# 检查字典是否包含某个键
函数 字典包含键(字典 d, 字符串 k) -> 布尔
    返回 包含(d, k)
结束

# 递归验证表达式节点
函数 验证表达式(字典 node, 字符串 上下文)
    若 是空值节点(node)
        记录验证错误(上下文 + ": 意外的空值节点")
        返回
    结束
    字符串 t = node["类型"]

    若 t == "字面量"
        若 非 字典包含键(node, "值")
            记录验证错误(上下文 + "/字面量: 缺少 '值' 字段")
        结束
        若 非 字典包含键(node, "字面类型")
            记录验证错误(上下文 + "/字面量: 缺少 '字面类型' 字段")
        结束
        返回
    结束

    若 t == "标识符"
        若 非 字典包含键(node, "名字")
            记录验证错误(上下文 + "/标识符: 缺少 '名字' 字段")
        结束
        返回
    结束

    若 t == "二元"
        若 非 字典包含键(node, "运算符")
            记录验证错误(上下文 + "/二元: 缺少 '运算符' 字段")
        结束
        验证表达式(node["左"], 上下文 + "/二元/左")
        验证表达式(node["右"], 上下文 + "/二元/右")
        返回
    结束

    若 t == "一元"
        若 非 字典包含键(node, "运算符")
            记录验证错误(上下文 + "/一元: 缺少 '运算符' 字段")
        结束
        验证表达式(node["操作数"], 上下文 + "/一元/操作数")
        返回
    结束

    若 t == "函数调用"
        验证表达式(node["被调者"], 上下文 + "/函数调用/被调者")
        返回
    结束

    若 t == "下标"
        验证表达式(node["容器"], 上下文 + "/下标/容器")
        验证表达式(node["索引"], 上下文 + "/下标/索引")
        返回
    结束

    若 t == "列表字面量"
        返回
    结束

    若 t == "字典字面量"
        返回
    结束

    若 t == "元组字面量"
        返回
    结束

    # 未知类型不算致命错误，可能是新特性
结束

# 递归验证语句节点
函数 验证语句(字典 node, 整数 序号)
    字符串 ctx = "语句[" + 转字符串(序号) + "]"
    若 是空值节点(node)
        记录验证错误(ctx + ": 空语句节点")
        返回
    结束
    字符串 t = node["类型"]

    若 t == "变量声明"
        若 非 字典包含键(node, "名字")
            记录验证错误(ctx + "/变量声明: 缺少 '名字'")
        结束
        若 非 是空值节点(node["初始化"])
            验证表达式(node["初始化"], ctx + "/变量声明/初始化")
        结束
        返回
    结束

    若 t == "赋值"
        验证表达式(node["目标"], ctx + "/赋值/目标")
        验证表达式(node["值"], ctx + "/赋值/值")
        返回
    结束

    若 t == "如果"
        验证表达式(node["条件"], ctx + "/如果/条件")
        返回
    结束

    若 t == "当"
        验证表达式(node["条件"], ctx + "/当/条件")
        返回
    结束

    若 t == "对于"
        返回
    结束

    若 t == "函数定义"
        若 非 字典包含键(node, "名字")
            记录验证错误(ctx + "/函数定义: 缺少 '名字'")
        结束
        返回
    结束

    若 t == "返回"
        若 非 是空值节点(node["值"])
            验证表达式(node["值"], ctx + "/返回/值")
        结束
        返回
    结束

    若 t == "跳出" 或 t == "继续"
        返回
    结束

    若 t == "导入"
        返回
    结束

    若 t == "函数调用"
        验证表达式(node["被调者"], ctx + "/函数调用/被调者")
        返回
    结束

    # 其他语句类型静默通过
结束

# 统计 AST 中节点总数（递归）
函数 统计节点数(v) -> 整数
    字符串 t = 类型(v)
    若 t == "字典"
        整数 计数 = 1
        列表 ks = 键(v)
        对于 i 从 0 到 长度(ks) - 1 循环
            计数 = 计数 + 统计节点数(v[ks[i]])
        结束
        返回 计数
    结束
    若 t == "列表"
        整数 计数 = 0
        对于 i 从 0 到 长度(v) - 1 循环
            计数 = 计数 + 统计节点数(v[i])
        结束
        返回 计数
    结束
    返回 1
结束

# 完整验证入口
函数 验证AST(字典 ast)
    验证错误数 = 0

    若 非 字典包含键(ast, "类型")
        记录验证错误("AST 根节点缺少 '类型' 字段")
        返回
    结束

    若 ast["类型"] != "程序"
        记录验证错误("AST 根节点类型应为 '程序'，实际为 '" + ast["类型"] + "'")
        返回
    结束

    列表 stmts = ast["语句"]
    输出 "AST 验证: 共 " + 转字符串(长度(stmts)) + " 条顶层语句"

    对于 i 从 0 到 长度(stmts) - 1 循环
        验证语句(stmts[i], i)
    结束

    整数 节点总数 = 统计节点数(ast)
    输出 "AST 验证: 共 " + 转字符串(节点总数) + " 个节点"

    若 验证错误数 == 0
        输出 "AST 验证: 通过 ✓"
    否则
        输出 "AST 验证: 发现 " + 转字符串(验证错误数) + " 个错误 ✗"
    结束
结束
