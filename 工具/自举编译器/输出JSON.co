# ============================================================
# 输出JSON.co —— 把 AST 字典/列表结构序列化为 JSON 字符串
#
# 规则：
#   - 字典 → {"键": 值, ...}
#   - 列表 → [值, 值, ...]
#   - 字符串 → "转义字符串"
#   - 整数 → 数字字面量
#   - 浮点 → 数字字面量
#   - {"类型": "空值"} → null
#
# 本文件不使用导入，由 编译.sh 拼接后运行。
# ============================================================

# 转义字符串为 JSON 字符串字面量内容（不含外层引号）
函数 转义JSON字符串(字符串 s) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(s)
    对于 i 从 0 到 n - 1 循环
        字符串 c = s[i]
        若 c == "\""
            结果 = 结果 + "\\\""
        否则 若 c == "\\"
            结果 = 结果 + "\\\\"
        否则 若 c == "\n"
            结果 = 结果 + "\\n"
        否则 若 c == "\t"
            结果 = 结果 + "\\t"
        否则 若 c == "\r"
            结果 = 结果 + "\\r"
        否则
            结果 = 结果 + c
        结束
    结束
    返回 结果
结束

# 判断是否为空值哨兵节点 {"类型": "空值"}
函数 是空值节点(v) -> 布尔
    若 类型(v) != "字典"
        返回 假
    结束
    若 包含(v, "类型")
        若 v["类型"] == "空值"
            返回 真
        结束
    结束
    返回 假
结束

# 递归序列化任意值为 JSON 字符串
函数 序列化JSON(v) -> 字符串
    # 空值哨兵 → null
    若 是空值节点(v)
        返回 "null"
    结束

    字符串 t = 类型(v)

    # 字典 → 对象
    若 t == "字典"
        列表 ks = 键(v)
        字符串 结果 = "{"
        整数 len = 长度(ks)
        对于 i 从 0 到 len - 1 循环
            字符串 k = ks[i]
            若 i > 0
                结果 = 结果 + ","
            结束
            结果 = 结果 + "\"" + 转义JSON字符串(k) + "\":" + 序列化JSON(v[k])
        结束
        结果 = 结果 + "}"
        返回 结果
    结束

    # 列表 → 数组
    若 t == "列表"
        字符串 结果 = "["
        整数 len = 长度(v)
        对于 i 从 0 到 len - 1 循环
            若 i > 0
                结果 = 结果 + ","
            结束
            结果 = 结果 + 序列化JSON(v[i])
        结束
        结果 = 结果 + "]"
        返回 结果
    结束

    # 字符串 → 带引号
    若 t == "字符串"
        返回 "\"" + 转义JSON字符串(v) + "\""
    结束

    # 整数 → 数字
    若 t == "整数"
        返回 转字符串(v)
    结束

    # 浮点 → 数字
    若 t == "浮点"
        返回 转字符串(v)
    结束

    # 其他类型（布尔等）→ 转字符串兜底
    返回 转字符串(v)
结束
