# ============================================================
# 测试扩展语法.co —— 自举编译器新增语法/内置函数端到端测试
#
# 通过 代码生成器.co (AT&T) 后端编译，链接 临时.o 后运行。
# 运行方式见 跑测试代码生成.sh：
#   coCN生成汇编 -> gcc汇编链接 -> 运行 -> 比对
# ============================================================

# ---- 1. 字符串拼接 ----
输出("hello" + " " + "world")

# ---- 2. 字符串长度 ----
输出(长度("hello"))

# ---- 3. 绝对值 ----
输出(绝对值(-5))

# ---- 4. 最大值 / 最小值 ----
输出(最大值(3, 7))
输出(最小值(3, 7))

# ---- 5. 跳出（break）：i==5 时跳出，只输出 0..4 ----
对于 i 从 0 到 10 循环
    若 i == 5 则
        跳出
    结束
    输出(i)
结束

# ---- 6. 继续（continue）：跳过偶数，只输出奇数 ----
对于 i 从 0 到 10 循环
    若 i % 2 == 0 则
        继续
    结束
    输出(i)
结束

# ---- 7. 转整数 / 转浮点 ----
输出(转整数(3.7))
输出(转浮点(5))

# ---- 8. for-each 遍历列表元素 ----
让 xs = [10, 20, 30]
对于 x 在 xs 循环
    输出(x)
结束

# ---- 9. 字符串索引 s[i] ----
让 s = "abcde"
输出(s[0])
输出(s[2])

# ---- 10. 字符串子串 截取 ----
输出(截取("hello", 0, 3))

# ---- 11. 字符串相等 ----
输出("abc" == "abc")
输出("abc" == "abd")

# ---- 12. 包含(字典, 键) ----
让 d = {"a": 1, "b": 2}
输出(包含(d, "a"))
输出(包含(d, "z"))

# ---- 13. 随机 / 时间戳（非零即可） ----
输出(随机())
输出(时间戳())
