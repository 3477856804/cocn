# ============================================================
# 类型系统.co —— 自举版类型推断与类型特化引擎
#
# 用纯 coCN 实现：
#   1. 类型格（Type Lattice）：未定义 / 整数 / 浮点 / 字符串 / 布尔 / 列表 / 字典 / 函数 / 动态
#   2. 类型环境：作用域链（字典 + 父指针）
#   3. 类型推断：数据流分析 + 定点迭代
#   4. 函数特化：按调用点参数类型组合生成静态特化版本
#   5. 调用图与激进内联：小函数内联、常量折叠
#   6. 逃逸分析：不逃逸对象标量替换
#   7. 边界检查消除：循环内可证安全的下标访问
#
# 类型一律用字符串表示：
#   "未定义" bot   底部，尚无信息
#   "整数"         64 位整型
#   "浮点"         双精度
#   "字符串"       UTF-8 字符串
#   "布尔"         真/假
#   "列表<元素>"   列表，元素类型在尖括号内
#   "字典<键,值>"  字典
#   "函数"         函数值
#   "动态" dyn     顶部，放弃推断
#
# 本文件不使用导入，由调用方在同一次运行中拼接；也可独立运行测试入口。
# ============================================================


# ============================================================
# 第一部分：类型格
# ============================================================

# 字面量类型关键字 -> 静态类型字符串
函数 字面量到类型(字符串 字面类型) -> 字符串
    若 字面类型 == "整数"
        返回 "整数"
    结束
    若 字面类型 == "浮点"
        返回 "浮点"
    结束
    若 字面类型 == "字符串"
        返回 "字符串"
    结束
    若 字面类型 == "布尔"
        返回 "布尔"
    结束
    返回 "动态"
结束

# 类型相等（字符串相等；列表/字典类型按完整字符串比较）
函数 类型相等(字符串 a, 字符串 b) -> 布尔
    返回 a == b
结束

# 判断类型是否为"数值"（整数或浮点）
函数 是数值(字符串 t) -> 布尔
    返回 t == "整数" 或 t == "浮点"
结束

# 判断类型是否为列表类型（形如 列表<...>）
函数 是列表类型(字符串 t) -> 布尔
    # 前缀 "列表<" 且以 ">" 结尾
    整数 n = 长度(t)
    若 n < 4
        返回 假
    结束
    返回 t[0] == "列" 且 t[1] == "表" 且 t[2] == "<" 且 t[n - 1] == ">"
结束

# 判断类型是否为字典类型（形如 字典<...,...>）
函数 是字典类型(字符串 t) -> 布尔
    整数 n = 长度(t)
    若 n < 4
        返回 假
    结束
    返回 t[0] == "字" 且 t[1] == "典" 且 t[2] == "<" 且 t[n - 1] == ">"
结束

# 提取列表类型的元素类型：列表<整数> -> 整数
函数 列表元素类型(字符串 t) -> 字符串
    若 非 是列表类型(t)
        返回 "动态"
    结束
    整数 n = 长度(t)
    # 去掉 "列表<" 前缀（3 字符）和 ">" 后缀（1 字符）
    返回 切片(t, 3, n - 1)
结束

# 提取字典类型的键类型：字典<字符串,整数> -> 字符串
函数 字典键类型(字符串 t) -> 字符串
    若 非 是字典类型(t)
        返回 "字符串"
    结束
    整数 n = 长度(t)
    字符串 内 = 切片(t, 3, n - 1)
    # 找第一个逗号
    整数 逗号 = -1
    整数 m = 长度(内)
    对于 i 从 0 到 m - 1 循环
        若 内[i] == ","
            逗号 = i
            跳出
        结束
    结束
    若 逗号 < 0
        返回 "字符串"
    结束
    返回 切片(内, 0, 逗号)
结束

# 提取字典类型的值类型：字典<字符串,整数> -> 整数
函数 字典值类型(字符串 t) -> 字符串
    若 非 是字典类型(t)
        返回 "动态"
    结束
    整数 n = 长度(t)
    字符串 内 = 切片(t, 3, n - 1)
    整数 逗号 = -1
    整数 m = 长度(内)
    对于 i 从 0 到 m - 1 循环
        若 内[i] == ","
            逗号 = i
            跳出
        结束
    结束
    若 逗号 < 0
        返回 "动态"
    结束
    返回 切片(内, 逗号 + 1, m)
结束

# 构造列表类型字符串
函数 构造列表类型(字符串 元素) -> 字符串
    返回 "列表<" + 元素 + ">"
结束

# 构造字典类型字符串
函数 构造字典类型(字符串 键, 字符串 值) -> 字符串
    返回 "字典<" + 键 + "," + 值 + ">"
结束

# ------------------------------------------------------------
# 最小上界 LUB：合并两个类型
#   整数 + 整数   -> 整数
#   整数 + 浮点   -> 浮点
#   浮点 + 整数   -> 浮点
#   列表<整数> + 列表<浮点> -> 列表<浮点>
#   整数 + 字符串 -> 动态
#   任意 + 动态   -> 动态
#   未定义 + X    -> X
# ------------------------------------------------------------
函数 类型LUB(字符串 a, 字符串 b) -> 字符串
    # 未定义吸收
    若 a == "未定义"
        返回 b
    结束
    若 b == "未定义"
        返回 a
    结束
    # 动态是顶部
    若 a == "动态" 或 b == "动态"
        返回 "动态"
    结束
    # 相同
    若 a == b
        返回 a
    结束
    # 数值提升：整数 + 浮点 -> 浮点
    若 a == "整数" 且 b == "浮点"
        返回 "浮点"
    结束
    若 a == "浮点" 且 b == "整数"
        返回 "浮点"
    结束
    # 列表：元素类型取 LUB
    若 是列表类型(a) 且 是列表类型(b)
        字符串 ea = 列表元素类型(a)
        字符串 eb = 列表元素类型(b)
        返回 构造列表类型(类型LUB(ea, eb))
    结束
    # 字典：键值分别取 LUB
    若 是字典类型(a) 且 是字典类型(b)
        字符串 ka = 字典键类型(a)
        字符串 va = 字典值类型(a)
        字符串 kb = 字典键类型(b)
        字符串 vb = 字典值类型(b)
        返回 构造字典类型(类型LUB(ka, kb), 类型LUB(va, vb))
    结束
    # 其他不相干类型 -> 动态
    返回 "动态"
结束

# 子类型判断：a 是否为 b 的子类型
#   整数 <: 动态；整数 <: 浮点（隐式加宽）；X <: X
函数 是子类型(字符串 a, 字符串 b) -> 布尔
    若 a == "未定义"
        返回 真
    结束
    若 b == "动态"
        返回 真
    结束
    若 a == b
        返回 真
    结束
    # 整数 <: 浮点
    若 a == "整数" 且 b == "浮点"
        返回 真
    结束
    返回 假
结束

# ------------------------------------------------------------
# 二元运算符结果类型
#   任一操作数未定义 -> 未定义（保持格底，等待更多信息）
#   任一操作数动态   -> 动态
#   比较运算         -> 布尔
#   字符串 + 字符串   -> 字符串（拼接）
#   数值 op 数值     -> LUB
#   其他             -> 动态
# ------------------------------------------------------------
函数 二元结果(字符串 op, 字符串 lt, 字符串 rt) -> 字符串
    若 lt == "未定义" 或 rt == "未定义"
        返回 "未定义"
    结束
    若 lt == "动态" 或 rt == "动态"
        返回 "动态"
    结束
    # 比较运算
    若 op == "==" 或 op == "!=" 或 op == "<" 或 op == "<=" 或 op == ">" 或 op == ">="
        返回 "布尔"
    结束
    若 op == "且" 或 op == "或"
        返回 "布尔"
    结束
    # 加法
    若 op == "+"
        # 字符串拼接
        若 lt == "字符串" 或 rt == "字符串"
            返回 "字符串"
        结束
        # 列表拼接
        若 是列表类型(lt) 且 是列表类型(rt)
            返回 构造列表类型(类型LUB(列表元素类型(lt), 列表元素类型(rt)))
        结束
        # 数值
        若 是数值(lt) 且 是数值(rt)
            返回 类型LUB(lt, rt)
        结束
        返回 "动态"
    结束
    # 其他算术运算
    若 op == "-" 或 op == "*" 或 op == "/" 或 op == "%" 或 op == "**"
        若 是数值(lt) 且 是数值(rt)
            返回 类型LUB(lt, rt)
        结束
        返回 "动态"
    结束
    返回 "动态"
结束

# 一元运算结果类型
函数 一元结果(字符串 op, 字符串 操作数类型) -> 字符串
    若 op == "非"
        返回 "布尔"
    结束
    若 op == "-"
        若 操作数类型 == "整数" 或 操作数类型 == "浮点"
            返回 操作数类型
        结束
        若 操作数类型 == "未定义"
            返回 "未定义"
        结束
        返回 "动态"
    结束
    返回 "动态"
结束

# 下标访问结果类型：list[i] -> 元素；dict[k] -> 值；str[i] -> 字符串
函数 下标结果(字符串 容器类型, 字符串 索引类型) -> 字符串
    若 容器类型 == "动态"
        返回 "动态"
    结束
    若 容器类型 == "未定义"
        返回 "未定义"
    结束
    若 是列表类型(容器类型)
        返回 列表元素类型(容器类型)
    结束
    若 容器类型 == "字符串"
        返回 "字符串"
    结束
    若 是字典类型(容器类型)
        返回 字典值类型(容器类型)
    结束
    返回 "动态"
结束


# ============================================================
# 第二部分：类型环境（作用域链）
# ============================================================
# 环境用字典表示：
#   env["表"]  = {变量名: 类型字符串}
#   env["父"]  = 父环境字典（根环境时为空字典 {}）
#
# coCN 字典是引用语义，所以直接 mutating 传入的 env 即可。

# 新建环境（父可为空字典）
函数 新建环境(字典 父) -> 字典
    字典 e = {"表": {}, "父": 父}
    返回 e
结束

# 在当前层定义变量（遮蔽外层同名变量）
函数 环境定义(字典 env, 字符串 名, 字符串 类型)
    env["表"][名] = 类型
结束

# 沿作用域链查找变量类型；找不到返回 "未定义"
函数 环境查找(字典 env, 字符串 名) -> 字符串
    字典 cur = env
    当 长度(键(cur)) > 0 循环
        字典 表 = cur["表"]
        若 包含(表, 名)
            返回 表[名]
        结束
        字典 父 = cur["父"]
        若 长度(键(父)) == 0
            跳出
        结束
        cur = 父
    结束
    返回 "未定义"
结束

# 判断变量是否在本层或外层已定义
函数 环境已定义(字典 env, 字符串 名) -> 布尔
    字典 cur = env
    当 长度(键(cur)) > 0 循环
        字典 表 = cur["表"]
        若 包含(表, 名)
            返回 真
        结束
        字典 父 = cur["父"]
        若 长度(键(父)) == 0
            跳出
        结束
        cur = 父
    结束
    返回 假
结束

# 赋值：沿作用域链找到定义点，取 LUB 更新类型
# 返回更新后的类型
函数 环境赋值(字典 env, 字符串 名, 字符串 新类型) -> 字符串
    字典 cur = env
    当 长度(键(cur)) > 0 循环
        字典 表 = cur["表"]
        若 包含(表, 名)
            字符串 旧 = 表[名]
            字符串 合并 = 类型LUB(旧, 新类型)
            表[名] = 合并
            返回 合并
        结束
        字典 父 = cur["父"]
        若 长度(键(父)) == 0
            跳出
        结束
        cur = 父
    结束
    # 未找到：隐式全局，定义在当前层
    env["表"][名] = 新类型
    返回 新类型
结束

# 打平环境：从最外层向内层铺，内层覆盖外层
# 返回一个新字典：变量名 -> 类型
函数 环境打平(字典 env) -> 字典
    # 先收集链上所有层
    列表 链 = []
    字典 cur = env
    当 长度(键(cur)) > 0 循环
        追加(链, cur)
        字典 父 = cur["父"]
        若 长度(键(父)) == 0
            跳出
        结束
        cur = 父
    结束
    # 链是从内到外，倒序遍历让内层覆盖外层
    字典 结果 = {}
    整数 len = 长度(链)
    对于 i 从 len - 1 到 0 循环
        字典 层 = 链[i]
        字典 表 = 层["表"]
        列表 ks = 键(表)
        对于 j 从 0 到 长度(ks) - 1 循环
            结果[ks[j]] = 表[ks[j]]
        结束
    结束
    返回 结果
结束

# 两个打平视图是否相等
函数 视图相等(字典 a, 字典 b) -> 布尔
    列表 ka = 键(a)
    列表 kb = 键(b)
    若 长度(ka) != 长度(kb)
        返回 假
    结束
    对于 i 从 0 到 长度(ka) - 1 循环
        字符串 k = ka[i]
        若 非 包含(b, k)
            返回 假
        结束
        若 a[k] != b[k]
            返回 假
        结束
    结束
    返回 真
结束


# ============================================================
# 第三部分：类型推断引擎（全局状态 + 递归函数）
# ============================================================

# ---- 全局状态 ----
让 g_函数表 = {}            # 函数名 -> 函数定义节点
让 g_签名 = {}              # 函数名 -> {"参数": [类型字符串], "返回": 类型字符串}
让 g_返回类型 = {}          # 函数名 -> 返回类型字符串
让 g_调用点 = []            # [{"节点": 调用节点, "函数名": str, "实参类型": [str]}]
让 g_全局 = {}              # 顶层变量类型
让 g_变了 = 假              # 定点迭代变化标记
让 g_最大迭代 = 30

# 标注节点的类型（就地写入 _类型 字段）
函数 标注类型(字典 node, 字符串 t)
    node["_类型"] = t
结束

# 读取节点标注的类型
函数 读标注类型(字典 node) -> 字符串
    若 包含(node, "_类型")
        返回 node["_类型"]
    结束
    返回 "未定义"
结束

# 收集顶层函数：遍历程序语句，把函数定义登记进 g_函数表
函数 收集顶层函数(字典 程序节点)
    g_函数表 = {}
    列表 stmts = 程序节点["语句"]
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 包含(st, "类型")
            若 st["类型"] == "函数定义"
                g_函数表[st["名字"]] = st
            结束
        结束
    结束
结束

# 把 coCN 类型标注关键字转成类型字符串
函数 标注到类型(字符串 标注) -> 字符串
    若 标注 == "整数"
        返回 "整数"
    结束
    若 标注 == "浮点"
        返回 "浮点"
    结束
    若 标注 == "字符串"
        返回 "字符串"
    结束
    若 标注 == "布尔"
        返回 "布尔"
    结束
    返回 "动态"
结束

# ---- 分析语句与分析表达式为互相递归，定义见下方 ----

# 分析语句列表，返回最后一条表达式语句的类型
函数 分析语句列表(列表 语句表, 字典 env) -> 字符串
    字符串 末类型 = "未定义"
    对于 i 从 0 到 长度(语句表) - 1 循环
        字典 st = 语句表[i]
        若 包含(st, "类型")
            字符串 t = 分析语句(st, env)
            若 t != ""
                末类型 = t
            结束
        结束
    结束
    返回 末类型
结束

# 对赋值目标赋值
函数 对目标赋值(字典 目标, 字符串 v, 字典 env)
    若 非 包含(目标, "类型")
        返回
    结束
    若 目标["类型"] == "标识符"
        环境赋值(env, 目标["名字"], v)
        标注类型(目标, v)
        返回
    结束
    若 目标["类型"] == "下标"
        分析表达式(目标["容器"], env)
        分析表达式(目标["索引"], env)
        返回
    结束
结束

# 分析如果语句：分支汇合 LUB
函数 分析如果(字典 st, 字典 env)
    分析表达式(st["条件"], env)
    字典 之前 = 环境打平(env)

    # 收集各分支结束后的视图
    列表 分支视图 = []
    # then 分支
    字典 thenEnv = 新建环境(env["父"])
    列表 thenStmts = st["则体"]
    分析语句列表(thenStmts, thenEnv)
    追加(分支视图, 环境打平(thenEnv))

    # 否则链
    列表 链 = st["否则链"]
    对于 i 从 0 到 长度(链) - 1 循环
        字典 br = 链[i]
        字典 条件节点 = br["条件"]
        若 包含(条件节点, "类型")
            若 条件节点["类型"] != "空值"
                分析表达式(条件节点, env)
            结束
        结束
        字典 brEnv = 新建环境(env["父"])
        分析语句列表(br["体"], brEnv)
        追加(分支视图, 环境打平(brEnv))
    结束

    # 没有最终 else 时，控制流也可能跳过整个如果 -> 并入之前
    追加(分支视图, 之前)

    # 逐变量 LUB 合并回 env
    # 先收集所有变量名
    字典 所有变量 = {}
    对于 i 从 0 到 长度(分支视图) - 1 循环
        字典 v = 分支视图[i]
        列表 ks = 键(v)
        对于 j 从 0 到 长度(ks) - 1 循环
            所有变量[ks[j]] = 1
        结束
    结束
    列表 名表 = 键(所有变量)
    对于 i 从 0 到 长度(名表) - 1 循环
        字符串 k = 名表[i]
        字符串 t = "未定义"
        对于 j 从 0 到 长度(分支视图) - 1 循环
            字典 v = 分支视图[j]
            若 包含(v, k)
                t = 类型LUB(t, v[k])
            结束
        结束
        环境赋值(env, k, t)
    结束
结束

# 分析当循环：迭代到收敛
函数 分析当(字典 st, 字典 env)
    对于 迭代 从 0 到 9 循环
        字典 之前 = 环境打平(env)
        分析表达式(st["条件"], env)
        分析语句列表(st["体"], env)
        字典 之后 = 环境打平(env)
        若 视图相等(之前, 之后)
            跳出
        结束
    结束
结束

# 分析对于循环（范围形式：对于 i 从 a 到 b）
函数 分析对于(字典 st, 字典 env)
    # 范围形式
    字符串 起点类型 = 分析表达式(st["起点"], env)
    字符串 终点类型 = 分析表达式(st["终点"], env)
    字符串 循环变量类型 = 类型LUB(起点类型, 终点类型)
    若 循环变量类型 == "未定义"
        循环变量类型 = "整数"
    结束
    环境定义(env, st["变量"], 循环变量类型)
    若 包含(st, "步长")
        字典 步长节点 = st["步长"]
        若 包含(步长节点, "类型")
            若 步长节点["类型"] != "空值"
                分析表达式(步长节点, env)
            结束
        结束
    结束
    # 迭代到收敛
    对于 迭代 从 0 到 7 循环
        字典 之前 = 环境打平(env)
        分析语句列表(st["体"], env)
        字典 之后 = 环境打平(env)
        若 视图相等(之前, 之后)
            跳出
        结束
    结束
结束

# 分析函数调用：累积实参类型到形参
函数 分析调用(字典 node, 字典 env) -> 字符串
    # 解析被调者名字
    字典 被调者 = node["被调者"]
    字符串 函数名 = ""
    若 包含(被调者, "类型")
        若 被调者["类型"] == "标识符"
            函数名 = 被调者["名字"]
        结束
    结束

    # 实参类型
    列表 实参 = []
    列表 参数节点 = node["参数"]
    对于 i 从 0 到 长度(参数节点) - 1 循环
        追加(实参, 分析表达式(参数节点[i], env))
    结束

    若 函数名 != ""
        若 包含(g_函数表, 函数名)
            # 累积到形参类型 LUB
            字典 旧签名 = {"参数": [], "返回": "未定义"}
            若 包含(g_签名, 函数名)
                旧签名 = g_签名[函数名]
            结束
            列表 旧参 = 旧签名["参数"]
            列表 新参 = []
            对于 i 从 0 到 长度(旧参) - 1 循环
                追加(新参, 旧参[i])
            结束
            # 补齐
            当 长度(新参) < 长度(实参) 循环
                追加(新参, "未定义")
            结束
            # 逐参数取 LUB
            布尔 变了 = 假
            对于 i 从 0 到 长度(新参) - 1 循环
                字符串 旧t = 新参[i]
                字符串 新t = 旧t
                若 i < 长度(实参)
                    新t = 类型LUB(旧t, 实参[i])
                结束
                若 新t != 旧t
                    变了 = 真
                结束
                新参[i] = 新t
            结束
            若 变了
                g_签名[函数名] = {"参数": 新参, "返回": 旧签名["返回"]}
                g_变了 = 真
            结束
            # 记录调用点
            追加(g_调用点, {"节点": node, "函数名": 函数名, "实参类型": 实参})
            # 返回值取已知返回类型
            字符串 ret = "未定义"
            若 包含(g_返回类型, 函数名)
                ret = g_返回类型[函数名]
            结束
            返回 ret
        结束
    结束
    # 未知函数 / 内建函数 -> 动态
    返回 "动态"
结束

# 分析单个函数体，更新其签名与返回类型
函数 分析一个函数(字符串 名字, 字典 fn)
    字典 env = 新建环境({})
    列表 形参 = fn["参数"]
    列表 形参类型 = []
    # 取累积的形参类型
    字典 旧签名 = {"参数": [], "返回": "未定义"}
    若 包含(g_签名, 名字)
        旧签名 = g_签名[名字]
    结束
    对于 i 从 0 到 长度(形参) - 1 循环
        字符串 t = "未定义"
        列表 旧参 = 旧签名["参数"]
        若 i < 长度(旧参)
            t = 旧参[i]
        结束
        # 若有类型标注，优先用标注
        列表 参数类型表 = fn["参数类型"]
        若 i < 长度(参数类型表)
            字符串 标注 = 参数类型表[i]
            若 标注 != ""
                t = 标注到类型(标注)
            结束
        结束
        追加(形参类型, t)
        环境定义(env, 形参[i], t)
    结束

    # 分析函数体
    字典 体 = fn["体"]
    列表 体语句 = 体["语句"]
    字符串 返回值 = 分析语句列表(体语句, env)

    # 返回类型累积 LUB
    字符串 旧返回 = "未定义"
    若 包含(g_返回类型, 名字)
        旧返回 = g_返回类型[名字]
    结束
    字符串 新返回 = 类型LUB(旧返回, 返回值)
    若 新返回 != 旧返回
        g_返回类型[名字] = 新返回
        g_变了 = 真
    结束
    # 更新签名
    字典 新签名 = {"参数": 形参类型, "返回": 新返回}
    字典 已存在签名 = {"参数": [], "返回": "未定义"}
    若 包含(g_签名, 名字)
        已存在签名 = g_签名[名字]
    结束
    布尔 签名变了 = 假
    若 长度(已存在签名["参数"]) != 长度(新签名["参数"])
        签名变了 = 真
    否则
        对于 i 从 0 到 长度(新签名["参数"]) - 1 循环
            若 新签名["参数"][i] != 已存在签名["参数"][i]
                签名变了 = 真
                跳出
            结束
        结束
    结束
    若 新签名["返回"] != 已存在签名["返回"]
        签名变了 = 真
    结束
    若 签名变了
        g_签名[名字] = 新签名
        g_变了 = 真
    结束
结束

# 分析顶层程序体
函数 分析顶层(字典 程序节点)
    字典 env = 新建环境({})
    # 顶层函数本身在环境中可见
    列表 名表 = 键(g_函数表)
    对于 i 从 0 到 长度(名表) - 1 循环
        环境定义(env, 名表[i], "函数")
    结束
    列表 stmts = 程序节点["语句"]
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 包含(st, "类型")
            若 st["类型"] != "函数定义"
                分析语句(st, env)
            结束
        结束
    结束
    # 导出全局变量
    g_全局 = 环境打平(env)
结束

# 类型推断主入口：跑定点迭代直到收敛
函数 类型推断分析(字典 程序节点) -> 字典
    g_函数表 = {}
    g_签名 = {}
    g_返回类型 = {}
    g_调用点 = []
    g_全局 = {}
    收集顶层函数(程序节点)

    整数 n = 0
    当 n < g_最大迭代 循环
        g_变了 = 假
        g_调用点 = []
        列表 名表 = 键(g_函数表)
        对于 i 从 0 到 长度(名表) - 1 循环
            分析一个函数(名表[i], g_函数表[名表[i]])
        结束
        分析顶层(程序节点)
        n = n + 1
        若 非 g_变了
            跳出
        结束
    结束
    返回 {"签名": g_签名, "返回类型": g_返回类型, "调用点": g_调用点, "全局": g_全局, "迭代次数": n}
结束

# ---- 分析语句分发 ----
函数 分析语句(字典 st, 字典 env) -> 字符串
    字符串 t = st["类型"]

    # 变量声明
    若 t == "变量声明"
        字符串 类型 = "未定义"
        字典 初始化 = st["初始化"]
        若 包含(初始化, "类型")
            若 初始化["类型"] != "空值"
                类型 = 分析表达式(初始化, env)
            结束
        结束
        # 类型标注
        字符串 标注 = st["类型标注"]
        若 标注 != ""
            类型 = 类型LUB(类型, 标注到类型(标注))
        结束
        环境定义(env, st["名字"], 类型)
        标注类型(st, 类型)
        返回 ""
    结束

    # 赋值
    若 t == "赋值"
        字符串 v = 分析表达式(st["值"], env)
        对目标赋值(st["目标"], v, env)
        标注类型(st, v)
        返回 v
    结束

    # 如果
    若 t == "如果"
        分析如果(st, env)
        返回 ""
    结束

    # 当循环
    若 t == "当"
        分析当(st, env)
        返回 ""
    结束

    # 对于循环
    若 t == "对于"
        分析对于(st, env)
        返回 ""
    结束

    # 返回
    若 t == "返回"
        字典 v = st["值"]
        字符串 rt = "动态"
        若 包含(v, "类型")
            若 v["类型"] != "空值"
                rt = 分析表达式(v, env)
            结束
        否则
            rt = "动态"
        结束
        标注类型(st, rt)
        返回 rt
    结束

    # 跳出 / 继续
    若 t == "跳出" 或 t == "继续"
        返回 ""
    结束

    # 函数定义（嵌套函数：登记进函数表，延迟分析）
    若 t == "函数定义"
        字符串 名 = st["名字"]
        若 非 包含(g_函数表, 名)
            g_函数表[名] = st
        结束
        环境定义(env, 名, "函数")
        返回 ""
    结束

    # 表达式语句
    返回 分析表达式(st, env)
结束

# ---- 分析表达式分发 ----
函数 分析表达式(字典 node, 字典 env) -> 字符串
    若 非 包含(node, "类型")
        返回 "未定义"
    结束
    字符串 t = node["类型"]

    # 空值哨兵
    若 t == "空值"
        返回 "动态"
    结束

    # 字面量
    若 t == "字面量"
        字符串 lt = 字面量到类型(node["字面类型"])
        标注类型(node, lt)
        返回 lt
    结束

    # 标识符
    若 t == "标识符"
        字符串 vt = 环境查找(env, node["名字"])
        标注类型(node, vt)
        返回 vt
    结束

    # 二元
    若 t == "二元"
        字符串 l = 分析表达式(node["左"], env)
        字符串 r = 分析表达式(node["右"], env)
        字符串 rt = 二元结果(node["运算符"], l, r)
        标注类型(node, rt)
        返回 rt
    结束

    # 一元
    若 t == "一元"
        字符串 o = 分析表达式(node["操作数"], env)
        字符串 rt = 一元结果(node["运算符"], o)
        标注类型(node, rt)
        返回 rt
    结束

    # 函数调用
    若 t == "函数调用"
        字符串 rt = 分析调用(node, env)
        标注类型(node, rt)
        返回 rt
    结束

    # 下标
    若 t == "下标"
        字符串 c = 分析表达式(node["容器"], env)
        分析表达式(node["索引"], env)
        字符串 rt = 下标结果(c, "")
        标注类型(node, rt)
        返回 rt
    结束

    # 列表字面量
    若 t == "列表字面量"
        列表 元素节点 = node["元素"]
        字符串 合并 = "未定义"
        对于 i 从 0 到 长度(元素节点) - 1 循环
            字符串 et = 分析表达式(元素节点[i], env)
            合并 = 类型LUB(合并, et)
        结束
        字符串 rt = 构造列表类型(合并)
        标注类型(node, rt)
        返回 rt
    结束

    # 字典字面量
    若 t == "字典字面量"
        列表 键节点 = node["键"]
        列表 值节点 = node["值"]
        字符串 k = "字符串"
        字符串 v = "未定义"
        对于 i 从 0 到 长度(键节点) - 1 循环
            字符串 vt = 分析表达式(值节点[i], env)
            v = 类型LUB(v, vt)
        结束
        字符串 rt = 构造字典类型(k, v)
        标注类型(node, rt)
        返回 rt
    结束

    # 元组字面量
    若 t == "元组字面量"
        列表 元素节点 = node["元素"]
        对于 i 从 0 到 长度(元素节点) - 1 循环
            分析表达式(元素节点[i], env)
        结束
        字符串 rt = 构造列表类型("动态")
        标注类型(node, rt)
        返回 rt
    结束

    返回 "动态"
结束


# ============================================================
# 第四部分：函数特化引擎
# ============================================================
# 为每种调用点参数类型组合生成一份特化函数拷贝。
# 特化函数表：特化名 -> 函数定义节点

让 g_特化函数表 = {}       # 特化名 -> 函数节点
让 g_调用映射 = []         # [{"特化名": str}]

# 类型短名（用于特化函数命名后缀）
函数 类型短名(字符串 t) -> 字符串
    若 t == "整数"
        返回 "整数"
    结束
    若 t == "浮点"
        返回 "浮点"
    结束
    若 t == "字符串"
        返回 "字符串"
    结束
    若 t == "布尔"
        返回 "布尔"
    结束
    若 t == "动态"
        返回 "动态"
    结束
    若 t == "未定义"
        返回 "未定型"
    结束
    若 是列表类型(t)
        返回 "列表_" + 类型短名(列表元素类型(t))
    结束
    若 是字典类型(t)
        返回 "字典_" + 类型短名(字典键类型(t)) + "_" + 类型短名(字典值类型(t))
    结束
    返回 "其他"
结束

# 类型组合键：[类型...] -> "整数|浮点"
函数 类型组合键(列表 类型表) -> 字符串
    字符串 s = ""
    对于 i 从 0 到 长度(类型表) - 1 循环
        若 i > 0
            s = s + "|"
        结束
        s = s + 类型表[i]
    结束
    返回 s
结束

# 深拷贝一个字典/列表结构（简单递归克隆）
函数 深拷贝(v) -> 字典
    字符串 tv = 类型(v)
    若 tv == "字典"
        字典 结果 = {}
        列表 ks = 键(v)
        对于 i 从 0 到 长度(ks) - 1 循环
            结果[ks[i]] = 深拷贝(v[ks[i]])
        结束
        返回 结果
    结束
    若 tv == "列表"
        列表 结果 = []
        对于 i 从 0 到 长度(v) - 1 循环
            追加(结果, 深拷贝(v[i]))
        结束
        返回 结果
    结束
    # 标量原样返回
    返回 v
结束

# 生成一个特化版本
函数 生成特化版本(字典 原节点, 字符串 函数名, 列表 实参类型) -> 字符串
    # 构造后缀
    字符串 后缀 = ""
    对于 i 从 0 到 长度(实参类型) - 1 循环
        若 i > 0
            后缀 = 后缀 + "_"
        结束
        后缀 = 后缀 + 类型短名(实参类型[i])
    结束
    字符串 特化名 = 函数名 + "__特化_" + 后缀

    # 克隆原函数体
    字典 拷贝 = 深拷贝(原节点)
    拷贝["名字"] = 特化名
    拷贝["是否特化"] = 1
    拷贝["特化自"] = 函数名
    # 形参类型记录
    列表 形参类型记录 = []
    对于 i 从 0 到 长度(实参类型) - 1 循环
        追加(形参类型记录, 实参类型[i])
    结束
    拷贝["特化参数类型"] = 形参类型记录

    # 用具体形参类型重推函数体：构造迷你程序跑一遍推断
    字典 迷你程序 = {"类型": "程序", "语句": [拷贝]}
    # 保存全局状态
    字典 旧函数表 = g_函数表
    字典 旧签名 = g_签名
    字典 旧返回类型 = g_返回类型
    列表 旧调用点 = g_调用点
    # 重置
    g_函数表 = {}
    g_签名 = {}
    g_返回类型 = {}
    g_调用点 = []
    收集顶层函数(迷你程序)
    # 预置形参类型
    g_签名[特化名] = {"参数": 形参类型记录, "返回": "未定义"}
    g_变了 = 假
    收集顶层函数(迷你程序)
    分析一个函数(特化名, 拷贝)
    # 跑一轮让返回类型收敛
    分析一个函数(特化名, 拷贝)
    字符串 精确返回 = "未定义"
    若 包含(g_返回类型, 特化名)
        精确返回 = g_返回类型[特化名]
    结束
    拷贝["_返回类型"] = 精确返回
    # 恢复全局状态
    g_函数表 = 旧函数表
    g_签名 = 旧签名
    g_返回类型 = 旧返回类型
    g_调用点 = 旧调用点

    g_特化函数表[特化名] = 拷贝
    返回 特化名
结束

# 特化主入口
函数 执行函数特化(字典 程序节点, 字典 推断结果) -> 字典
    g_特化函数表 = {}
    g_调用映射 = []

    # 按函数名分组收集调用点
    字典 按函数 = {}
    列表 调用点表 = 推断结果["调用点"]
    对于 i 从 0 到 长度(调用点表) - 1 循环
        字典 cs = 调用点表[i]
        字符串 名 = cs["函数名"]
        若 非 包含(按函数, 名)
            按函数[名] = []
        结束
        追加(按函数[名], cs)
    结束

    # 对每个有调用点的函数按类型组合特化
    列表 函数名表 = 键(按函数)
    对于 i 从 0 到 长度(函数名表) - 1 循环
        字符串 函数名 = 函数名表[i]
        若 非 包含(g_函数表, 函数名)
            继续
        结束
        字典 原节点 = g_函数表[函数名]
        # 按实参类型元组分组
        字典 组 = {}
        列表 调用列表 = 按函数[函数名]
        对于 j 从 0 到 长度(调用列表) - 1 循环
            字典 cs = 调用列表[j]
            字符串 key = 类型组合键(cs["实参类型"])
            若 非 包含(组, key)
                组[key] = {"实参类型": cs["实参类型"], "调用点": []}
            结束
            追加(组[key]["调用点"], cs["节点"])
        结束
        # 每组生成特化版本
        列表 组键 = 键(组)
        对于 j 从 0 到 长度(组键) - 1 循环
            字典 g = 组[组键[j]]
            字符串 特化名 = 生成特化版本(原节点, 函数名, g["实参类型"])
            # 改写调用点
            列表 调用点列表 = g["调用点"]
            对于 k 从 0 到 长度(调用点列表) - 1 循环
                字典 callNode = 调用点列表[k]
                callNode["被调者"] = {"类型": "标识符", "名字": 特化名}
                追加(g_调用映射, {"特化名": 特化名})
            结束
        结束
    结束

    # 把特化函数追加进程序语句
    列表 特化名表 = 键(g_特化函数表)
    对于 i 从 0 到 长度(特化名表) - 1 循环
        追加(程序节点["语句"], g_特化函数表[特化名表[i]])
    结束

    返回 {"特化函数表": g_特化函数表, "调用映射": g_调用映射}
结束


# ============================================================
# 第五部分：调用图构建
# ============================================================

让 g_调用图边 = {}          # 调用者名 -> [被调者名]
让 g_调用点图 = {}          # 被调者名 -> [调用节点]
让 g_调用图函数表 = {}      # 函数名 -> 函数节点

# 在一个节点内递归收集函数调用（不下降进嵌套函数定义体）
函数 收集调用递归(字典 node, 字符串 调用者)
    若 非 包含(node, "类型")
        # 可能是列表
        若 类型(node) == "列表"
            对于 i 从 0 到 长度(node) - 1 循环
                收集调用递归(node[i], 调用者)
            结束
        结束
        返回
    结束
    字符串 t = node["类型"]
    若 t == "函数定义" 或 t == "函数字面量"
        返回
    结束
    若 t == "函数调用"
        字典 被调者 = node["被调者"]
        若 包含(被调者, "类型")
            若 被调者["类型"] == "标识符"
                字符串 被调 = 被调者["名字"]
                若 非 包含(g_调用图边, 调用者)
                    g_调用图边[调用者] = []
                结束
                追加(g_调用图边[调用者], 被调)
                若 非 包含(g_调用点图, 被调)
                    g_调用点图[被调] = []
                结束
                追加(g_调用点图[被调], node)
            结束
        结束
    结束
    # 遍历所有字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        字符串 k = ks[i]
        若 k == "类型" 或 k == "_类型" 或 k == "_返回类型"
            继续
        结束
        收集调用递归(node[k], 调用者)
    结束
结束

# 构建调用图
函数 构建调用图(字典 程序节点) -> 字典
    g_调用图边 = {}
    g_调用点图 = {}
    g_调用图函数表 = {}
    列表 stmts = 程序节点["语句"]
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 包含(st, "类型")
            若 st["类型"] == "函数定义"
                g_调用图函数表[st["名字"]] = st
                g_调用图边[st["名字"]] = []
            结束
        结束
    结束
    # 遍历每个函数体
    列表 名表 = 键(g_调用图函数表)
    对于 i 从 0 到 长度(名表) - 1 循环
        字典 fn = g_调用图函数表[名表[i]]
        收集调用递归(fn["体"], 名表[i])
    结束
    # 顶层当作 <main>
    g_调用图边["<main>"] = []
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 包含(st, "类型")
            若 st["类型"] != "函数定义"
                收集调用递归(st, "<main>")
            结束
        结束
    结束
    返回 g_调用图边
结束

# 某函数被多少个调用点调用
函数 被调次数(字符串 函数名) -> 整数
    若 包含(g_调用点图, 函数名)
        返回 长度(g_调用点图[函数名])
    结束
    返回 0
结束

# 某函数是否递归（DFS 检查是否能回到自己）
函数 是否递归(字符串 函数名) -> 布尔
    字典 访问 = {}
    列表 栈 = [函数名]
    当 长度(栈) > 0 循环
        字符串 cur = 栈[长度(栈) - 1]
        # 弹出
        列表 新栈 = []
        对于 i 从 0 到 长度(栈) - 2 循环
            追加(新栈, 栈[i])
        结束
        栈 = 新栈
        若 包含(g_调用图边, cur)
            列表 被调集 = g_调用图边[cur]
            对于 i 从 0 到 长度(被调集) - 1 循环
                字符串 被调 = 被调集[i]
                若 被调 == 函数名
                    返回 真
                结束
                若 非 包含(访问, 被调)
                    访问[被调] = 1
                    追加(栈, 被调)
                结束
            结束
        结束
    结束
    返回 假
结束

# 统计函数体节点数（规模）
函数 统计节点数v(v) -> 整数
    若 类型(v) == "字典"
        整数 计数 = 1
        列表 ks = 键(v)
        对于 i 从 0 到 长度(ks) - 1 循环
            计数 = 计数 + 统计节点数v(v[ks[i]])
        结束
        返回 计数
    结束
    若 类型(v) == "列表"
        整数 计数 = 0
        对于 i 从 0 到 长度(v) - 1 循环
            计数 = 计数 + 统计节点数v(v[i])
        结束
        返回 计数
    结束
    返回 1
结束

# 函数规模
函数 函数规模(字符串 函数名) -> 整数
    若 包含(g_调用图函数表, 函数名)
        返回 统计节点数v(g_调用图函数表[函数名])
    结束
    返回 0
结束


# ============================================================
# 第六部分：激进内联
# ============================================================
# 决策：
#   - 小函数（<15 节点）：总是内联
#   - 中等函数（15~50 节点）：调用点 <3 处则内联
#   - 大函数（>50 节点）：不内联
#   - 递归函数：不内联
# 内联实现：单 return 表达式函数，把实参替换形参后直接落位。

让 g_内联次数 = 0
让 g_内联缓存 = []

# 判断是否值得内联
函数 值得内联(字符串 函数名) -> 布尔
    若 非 包含(g_调用图函数表, 函数名)
        返回 假
    结束
    整数 规模 = 函数规模(函数名)
    若 规模 > 50
        返回 假
    结束
    若 是否递归(函数名)
        返回 假
    结束
    若 规模 <= 15
        返回 真
    结束
    # 中等函数：调用点少则内联
    返回 被调次数(函数名) < 3
结束

# 替换表达式中的标识符（按替换表）
函数 替换标识符(字典 node, 字典 替换表) -> 字典
    字符串 tv = 类型(node)
    若 tv == "列表"
        列表 结果 = []
        对于 i 从 0 到 长度(node) - 1 循环
            追加(结果, 替换标识符(node[i], 替换表))
        结束
        # 列表不能直接当字典返回，这里包一层；调用方需注意
        字典 包 = {"_列表": 结果}
        返回 包
    结束
    若 tv != "字典"
        # 标量返回包
        字典 包 = {"_标量": node}
        返回 包
    结束
    若 包含(node, "类型")
        若 node["类型"] == "标识符"
            字符串 名 = node["名字"]
            若 包含(替换表, 名)
                返回 深拷贝(替换表[名])
            结束
        结束
    结束
    # 递归替换字段
    字典 结果 = {}
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        字符串 k = ks[i]
        字典 r = 替换标识符(node[k], 替换表)
        若 包含(r, "_列表")
            结果[k] = r["_列表"]
        否则 若 包含(r, "_标量")
            结果[k] = r["_标量"]
        否则
            结果[k] = r
        结束
    结束
    返回 结果
结束

# 尝试内联一个调用点。返回 1 表示成功。
函数 尝试内联一处(字典 callNode, 字典 fn) -> 整数
    列表 形参 = fn["参数"]
    列表 实参 = callNode["参数"]
    若 长度(形参) != 长度(实参)
        返回 0
    结束
    # 函数体必须是「单 return EXPR」
    字典 体 = fn["体"]
    列表 体语句 = 体["语句"]
    若 长度(体语句) != 1
        返回 0
    结束
    字典 首语句 = 体语句[0]
    若 首语句["类型"] != "返回"
        返回 0
    结束
    字典 retExpr = 首语句["值"]
    若 非 包含(retExpr, "类型")
        返回 0
    结束

    # 构造替换表：形参名 -> 实参表达式克隆
    字典 替换表 = {}
    对于 i 从 0 到 长度(形参) - 1 循环
        替换表[形参[i]] = 深拷贝(实参[i])
    结束
    # 替换
    字典 内联后 = 替换标识符(retExpr, 替换表)
    # 把 callNode 改造成内联结果（展开字段）
    # 清除旧字段
    列表 ks = 键(callNode)
    对于 i 从 0 到 长度(ks) - 1 循环
        删除键(callNode, ks[i])
    结束
    列表 nks = 键(内联后)
    对于 i 从 0 到 长度(nks) - 1 循环
        callNode[nks[i]] = 内联后[nks[i]]
    结束
    返回 1
结束

# 内联主入口
函数 执行内联(字典 程序节点) -> 字典
    g_内联次数 = 0
    g_内联缓存 = []
    对于 轮 从 0 到 5 循环
        构建调用图(程序节点)
        整数 本轮 = 0
        列表 名表 = 键(g_调用图函数表)
        对于 i 从 0 到 长度(名表) - 1 循环
            字符串 名 = 名表[i]
            若 非 值得内联(名)
                继续
            结束
            若 非 包含(g_调用点图, 名)
                继续
            结束
            列表 调用点列表 = g_调用点图[名]
            字典 fn = g_调用图函数表[名]
            对于 j 从 0 到 长度(调用点列表) - 1 循环
                字典 callNode = 调用点列表[j]
                整数 成功 = 尝试内联一处(callNode, fn)
                若 成功 == 1
                    本轮 = 本轮 + 1
                结束
            结束
        结束
        g_内联次数 = g_内联次数 + 本轮
        若 本轮 == 0
            跳出
        结束
    结束

    # 常量折叠：遍历 AST，折叠字面量二元运算
    执行常量折叠(程序节点)

    # 标记未内联的调用点为内联缓存
    标记内联缓存(程序节点)
    返回 {"内联次数": g_内联次数, "内联缓存": g_内联缓存}
结束

# 常量折叠递归
函数 折叠递归(字典 node) -> 整数
    若 类型(node) != "字典"
        返回 0
    结束
    整数 改了 = 0
    若 包含(node, "类型")
        若 node["类型"] == "二元"
            字典 左 = node["左"]
            字典 右 = node["右"]
            若 包含(左, "类型")
                若 左["类型"] == "字面量"
                    若 包含(右, "类型")
                        若 右["类型"] == "字面量"
                            字典 r = 折叠二元(node["运算符"], 左, 右)
                            若 包含(r, "类型")
                                列表 ks = 键(node)
                                对于 i 从 0 到 长度(ks) - 1 循环
                                    删除键(node, ks[i])
                                结束
                                列表 nks = 键(r)
                                对于 i 从 0 到 长度(nks) - 1 循环
                                    node[nks[i]] = r[nks[i]]
                                结束
                                改了 = 1
                            结束
                        结束
                    结束
                结束
            结束
        结束
    结束
    # 递归字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型" 或 ks[i] == "_类型"
            继续
        结束
        整数 子 = 折叠递归(node[ks[i]])
        若 子 == 1
            改了 = 1
        结束
    结束
    返回 改了
结束

# 常量折叠主入口（多轮直到稳定）
函数 执行常量折叠(字典 程序节点)
    对于 轮 从 0 到 4 循环
        整数 改了 = 折叠递归(程序节点)
        若 改了 == 0
            跳出
        结束
    结束
结束

# 对两个字面量求值（仅整数折叠，浮点保留运行时）
函数 折叠二元(字符串 op, 字典 l, 字典 r) -> 字典
    字符串 lt = l["字面类型"]
    字符串 rt = r["字面类型"]
    # 仅整数折叠
    若 lt != "整数"
        返回 {"类型": "空值"}
    结束
    若 rt != "整数"
        返回 {"类型": "空值"}
    结束
    整数 a = 转整数(l["值"])
    整数 b = 转整数(r["值"])
    整数 v = 0
    若 op == "+"
        v = a + b
    否则 若 op == "-"
        v = a - b
    否则 若 op == "*"
        v = a * b
    否则 若 op == "%"
        v = a - (b * (a / b))
    否则
        返回 {"类型": "空值"}
    结束
    返回 {"类型": "字面量", "值": 转字符串(v), "字面类型": "整数"}
结束

# 标记内联缓存点递归
函数 标记缓存递归(字典 node)
    若 类型(node) != "字典"
        返回
    结束
    若 包含(node, "类型")
        若 node["类型"] == "函数调用"
            字典 被调者 = node["被调者"]
            若 包含(被调者, "类型")
                若 被调者["类型"] == "标识符"
                    字符串 名 = 被调者["名字"]
                    若 包含(g_调用图函数表, 名)
                        node["_内联缓存"] = 1
                        追加(g_内联缓存, {"目标函数": 名})
                    结束
                结束
            结束
        结束
    结束
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型" 或 ks[i] == "_类型"
            继续
        结束
        标记缓存递归(node[ks[i]])
    结束
结束

# 标记内联缓存入口
函数 标记内联缓存(字典 程序节点)
    标记缓存递归(程序节点)
结束


# ============================================================
# 第七部分：逃逸分析与标量替换
# ============================================================
# 分析每个字典/列表分配点是否逃逸出函数。
# 不逃逸的字典 -> 标量替换：p.x 改写为 p$x。

让 g_分配点 = []           # [{"节点", "变量名", "字段", "是否逃逸", "原因"}]
让 g_标量替换表 = {}       # 变量名 -> [字段名]

# 判断表达式是否引用了变量 名
函数 引用变量(字典 node, 字符串 名) -> 布尔
    若 类型(node) != "字典"
        返回 假
    结束
    若 非 包含(node, "类型")
        返回 假
    结束
    若 node["类型"] == "标识符"
        返回 node["名字"] == 名
    结束
    若 node["类型"] == "下标"
        返回 引用变量(node["容器"], 名)
    结束
    # 递归所有字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型"
            继续
        结束
        若 引用变量(node[ks[i]], 名)
            返回 真
        结束
    结束
    返回 假
结束

# 判定某变量是否逃逸（遍历函数体）
函数 判定逃逸(字典 body, 字符串 变量名, 字典 rec)
    布尔 逃逸 = 假
    字符串 原因 = ""
    # 递归遍历
    字典 状态 = {"逃逸": 0, "原因": ""}
    逃逸遍历(body, 变量名, 状态)
    rec["是否逃逸"] = 状态["逃逸"]
    rec["原因"] = 状态["原因"]
结束

# 逃逸遍历递归
函数 逃逸遍历(字典 node, 字符串 变量名, 字典 状态)
    若 状态["逃逸"] == 1
        返回
    结束
    若 类型(node) != "字典"
        返回
    结束
    若 非 包含(node, "类型")
        返回
    结束
    字符串 t = node["类型"]
    # 被 return
    若 t == "返回"
        字典 v = node["值"]
        若 包含(v, "类型")
            若 v["类型"] != "空值"
                若 引用变量(v, 变量名)
                    状态["逃逸"] = 1
                    状态["原因"] = "被函数返回"
                    返回
                结束
            结束
        结束
    结束
    # 作为实参传给其他函数
    若 t == "函数调用"
        列表 参数 = node["参数"]
        对于 i 从 0 到 长度(参数) - 1 循环
            若 引用变量(参数[i], 变量名)
                状态["逃逸"] = 1
                状态["原因"] = "作为实参传给其他函数"
                返回
            结束
        结束
    结束
    # 赋值给另一变量
    若 t == "赋值"
        字典 目标 = node["目标"]
        字典 值 = node["值"]
        若 包含(目标, "类型")
            若 目标["类型"] == "标识符"
                若 引用变量(值, 变量名)
                    若 目标["名字"] != 变量名
                        状态["逃逸"] = 1
                        状态["原因"] = "被赋值给另一变量"
                        返回
                    结束
                结束
            结束
            # 存入容器/字段
            若 目标["类型"] == "下标"
                若 引用变量(值, 变量名)
                    状态["逃逸"] = 1
                    状态["原因"] = "被存入容器/对象字段"
                    返回
                结束
            结束
        结束
    结束
    # 递归字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型"
            继续
        结束
        逃逸遍历(node[ks[i]], 变量名, 状态)
        若 状态["逃逸"] == 1
            返回
        结束
    结束
结束

# 从字典字面量提取字段
函数 提取字段(字典 init) -> 字典
    字典 字段 = {}
    若 非 包含(init, "类型")
        返回 字段
    结束
    若 init["类型"] == "字典字面量"
        列表 键表 = init["键"]
        列表 值表 = init["值"]
        对于 i 从 0 到 长度(键表) - 1 循环
            字典 k = 键表[i]
            字符串 字段名 = "f" + 转字符串(i)
            若 包含(k, "类型")
                若 k["类型"] == "字面量"
                    字段名 = k["值"]
                结束
            结束
            字符串 vt = "动态"
            若 包含(值表[i], "_类型")
                vt = 值表[i]["_类型"]
            结束
            字段[字段名] = vt
        结束
    结束
    返回 字段
结束

# 标量替换：把 p.x 下标访问改写为标识符 p$x
函数 标量替换遍历(字典 node, 字符串 变量名, 字典 字段)
    若 类型(node) != "字典"
        返回
    结束
    若 非 包含(node, "类型")
        返回
    结束
    若 node["类型"] == "下标"
        字典 容器 = node["容器"]
        字典 索引 = node["索引"]
        若 包含(容器, "类型")
            若 容器["类型"] == "标识符"
                若 容器["名字"] == 变量名
                    若 包含(索引, "类型")
                        若 索引["类型"] == "字面量"
                            字符串 字段名 = 索引["值"]
                            若 包含(字段, 字段名)
                                # p.x -> 标识符 p$x
                                node["类型"] = "标识符"
                                node["名字"] = 变量名 + "$" + 字段名
                                # 删除多余字段
                                若 包含(node, "容器")
                                    删除键(node, "容器")
                                结束
                                若 包含(node, "索引")
                                    删除键(node, "索引")
                                结束
                                node["_标量字段"] = 字段名
                            结束
                        结束
                    结束
                结束
            结束
        结束
    结束
    # 递归字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型"
            继续
        结束
        标量替换遍历(node[ks[i]], 变量名, 字段)
    结束
结束

# 逃逸分析主入口
函数 执行逃逸分析(字典 程序节点) -> 字典
    g_分配点 = []
    g_标量替换表 = {}

    # 收集所有函数
    字典 函数表 = {}
    列表 stmts = 程序节点["语句"]
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 包含(st, "类型")
            若 st["类型"] == "函数定义"
                函数表[st["名字"]] = st
            结束
        结束
    结束

    # 逐函数分析
    列表 名表 = 键(函数表)
    对于 i 从 0 到 长度(名表) - 1 循环
        分析函数逃逸(函数表[名表[i]])
    结束
    # 顶层也分析
    字典 主节点 = {"体": 程序节点, "名字": "<main>"}
    分析函数逃逸(主节点)

    整数 逃逸数 = 0
    整数 可替换数 = 0
    对于 i 从 0 到 长度(g_分配点) - 1 循环
        字典 a = g_分配点[i]
        若 a["是否逃逸"] == 1
            逃逸数 = 逃逸数 + 1
        否则
            若 长度(键(a["字段"])) > 0
                可替换数 = 可替换数 + 1
            结束
        结束
    结束
    返回 {"分配点": g_分配点, "标量替换表": g_标量替换表, "逃逸总数": 逃逸数, "可标量替换数": 可替换数}
结束

# 分析单个函数的逃逸
函数 分析函数逃逸(字典 fn)
    字典 body = fn["体"]
    若 非 包含(body, "语句")
        返回
    结束
    列表 stmts = body["语句"]

    # 1) 找出本函数内所有字典字面量分配并绑定到变量
    字典 本地对象 = {}
    对于 i 从 0 到 长度(stmts) - 1 循环
        字典 st = stmts[i]
        若 非 包含(st, "类型")
            继续
        结束
        若 st["类型"] != "变量声明"
            继续
        结束
        字典 init = st["初始化"]
        若 非 包含(init, "类型")
            继续
        结束
        若 init["类型"] == "空值"
            继续
        结束
        若 init["类型"] == "字典字面量"
            字典 字段 = 提取字段(init)
            字典 rec = {"节点": st, "变量名": st["名字"], "字段": 字段, "是否逃逸": 0, "原因": ""}
            本地对象[st["名字"]] = rec
            追加(g_分配点, rec)
        结束
    结束

    若 长度(键(本地对象)) == 0
        返回
    结束

    # 2) 判定每个本地对象是否逃逸
    列表 名表 = 键(本地对象)
    对于 i 从 0 到 长度(名表) - 1 循环
        字典 rec = 本地对象[名表[i]]
        判定逃逸(body, 名表[i], rec)
    结束

    # 3) 不逃逸的字典 -> 标量替换
    对于 i 从 0 到 长度(名表) - 1 循环
        字符串 变量名 = 名表[i]
        字典 rec = 本地对象[变量名]
        若 rec["是否逃逸"] == 0
            若 长度(键(rec["字段"])) > 0
                标量替换遍历(body, 变量名, rec["字段"])
                # 记录字段名列表
                列表 字段名表 = 键(rec["字段"])
                g_标量替换表[变量名] = 字段名表
            结束
        结束
    结束
结束


# ============================================================
# 第八部分：边界检查消除
# ============================================================
# 分析循环中的数组/列表访问。
# 若下标是循环变量 i，且循环范围是 0..长度(list)-1，则该访问安全。

让 g_消除数 = 0

# 检查一个下标节点是否在已知安全循环变量集合中
函数 边界消除遍历(字典 node, 字典 安全变量集)
    若 类型(node) != "字典"
        返回
    结束
    若 非 包含(node, "类型")
        返回
    结束
    字符串 t = node["类型"]

    # 进入对于循环：注册循环变量
    若 t == "对于"
        字符串 循环变量 = node["变量"]
        字典 新集 = {}
        列表 ks = 键(安全变量集)
        对于 i 从 0 到 长度(ks) - 1 循环
            新集[ks[i]] = 安全变量集[ks[i]]
        结束
        新集[循环变量] = 1
        列表 体语句 = node["体"]
        对于 i 从 0 到 长度(体语句) - 1 循环
            边界消除遍历(体语句[i], 新集)
        结束
        返回
    结束

    # 下标访问：若索引是安全变量，标注 _边界安全
    若 t == "下标"
        字典 索引 = node["索引"]
        若 包含(索引, "类型")
            若 索引["类型"] == "标识符"
                若 包含(安全变量集, 索引["名字"])
                    node["_边界安全"] = 1
                    g_消除数 = g_消除数 + 1
                结束
            结束
        结束
    结束

    # 递归字段
    列表 ks = 键(node)
    对于 i 从 0 到 长度(ks) - 1 循环
        若 ks[i] == "类型"
            继续
        结束
        边界消除遍历(node[ks[i]], 安全变量集)
    结束
结束

# 边界检查消除主入口
函数 执行边界检查消除(字典 程序节点) -> 字典
    g_消除数 = 0
    字典 空集 = {}
    边界消除遍历(程序节点, 空集)
    返回 {"消除数": g_消除数}
结束


# ============================================================
# 第九部分：完整流水线入口
# ============================================================
# 串联：类型推断 -> 函数特化 -> 调用图 -> 内联 -> 逃逸分析 -> 边界检查消除

函数 跑完整类型流水线(字典 程序节点) -> 字典
    字典 推断 = 类型推断分析(程序节点)
    字典 特化 = 执行函数特化(程序节点, 推断)
    字典 内联结果 = 执行内联(程序节点)
    字典 逃逸 = 执行逃逸分析(程序节点)
    字典 边界 = 执行边界检查消除(程序节点)
    字典 结果 = {"推断": 推断, "特化": 特化, "内联": 内联结果, "逃逸": 逃逸, "边界": 边界}
    返回 结果
结束
