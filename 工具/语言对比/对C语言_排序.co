# 对 C 对比 · coCN 版：2000 元倒序列表冒泡排序，期望输出 1 / 2000 / 2001000。
# 与对C语言_排序.c 同题：C 版的 n 来自命令行参数，coCN 版用字面量。
整数 N = 2000
列表 a = []
整数 i = 0
当 i < N 循环
    追加(a, N - i)
    i = i + 1
结束
整数 pass = 0
当 pass < N 循环
    整数 j = 0
    当 j < N - 1 - pass 循环
        如果 a[j] > a[j + 1] 则
            整数 t = a[j]
            a[j] = a[j + 1]
            a[j + 1] = t
        结束
        j = j + 1
    结束
    pass = pass + 1
结束
输出 a[0]
输出 a[N - 1]
整数 和 = 0
整数 k = 0
当 k < N 循环
    和 = 和 + a[k]
    k = k + 1
结束
输出 和
