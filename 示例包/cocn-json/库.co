# ============================================================
# cocn-json —— JSON 解析与序列化（对标 Rust 的 serde_json）
# 复用标准库 JSON解析 / JSON序列化，并补充 jq 式路径取值。
# ============================================================
导入 "标准库"

# 解析 JSON 文本为 coCN 值（字典/列表/字符串/数字/布尔/空值）
函数 解析(文本)
    返回 JSON解析(文本)
结束

# 序列化 coCN 值为 JSON 文本
函数 序列化(值)
    返回 JSON序列化(值)
结束

# jq 式路径取值：取(数据, "user.list[0].name")
# 支持点号导航与 [索引]；索引须为整数。
函数 取(数据, 路径)
    列表 段 = 分割(路径, ".")
    变量 当前 = 数据
    对于 i 从 0 到 长度(段) - 1 循环
        字符串 段名 = 段[i]
        如果 包含(段名, "[") 则
            整数 左 = 查找(段名, "[")
            字符串 键 = 截取(段名, 0, 左)
            整数 右 = 查找(段名, "]")
            整数 索引 = 转整数(截取(段名, 左 + 1, 右))
            如果 键 != "" 则 当前 = 当前[键] 结束
            当前 = 当前[索引]
        否则
            当前 = 当前[段名]
        结束
    结束
    返回 当前
结束

# 判断路径是否可达（取回的值非未定义/非空值）
函数 有键(数据, 路径)
    变量 v = 取(数据, 路径)
    返回 类型(v) != "未定义" 且 类型(v) != "空"
结束
