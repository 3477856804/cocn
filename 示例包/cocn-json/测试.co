# cocn-json 测试：解析 / 序列化 / jq 路径取值
导入 "标准库"
导入 "库"

测试用例("解析对象", 函数()
    字典 d = 解析("{\"a\":1,\"b\":[10,20]}")
    断言相等(d["a"], 1, "解析对象.a")
结束)

测试用例("jq 路径取值 数组索引", 函数()
    字典 d = 解析("{\"a\":[10,20]}")
    断言相等(取(d, "a[1]"), 20, "jq 数组索引")
结束)

测试用例("jq 路径取值 嵌套对象", 函数()
    字典 d = 解析("{\"user\":{\"name\":\"小明\"}}")
    断言相等(取(d, "user.name"), "小明", "jq 嵌套对象")
结束)

测试用例("序列化往返", 函数()
    字典 d = 解析("{\"x\":1}")
    断言相等(取(解析(序列化(d)), "x"), 1, "序列化后仍能解析")
结束)

测试用例("有键 存在与缺失", 函数()
    字典 d = 解析("{\"ok\":true}")
    断言相等(有键(d, "ok"), 真, "有键 命中")
    断言相等(有键(d, "no"), 假, "有键 缺失")
结束)

运行所有测试()
