# cocn-log 测试
# 注意：时刻一律注入固定值，保证三通道输出逐字节一致（门禁要求）。
导入 "标准库"
导入 "库"

测试用例("补零", 函数()
    断言相等(补零("7", 3), "007", "左补零到3位")
    断言相等(补零("123", 3), "123", "已够宽原样")
结束)

测试用例("时间戳 格式", 函数()
    字符串 s = 时间戳()
    断言相等(长度(s), 19, "YYYY-MM-DD HH:MM:SS 共19字符")
    # 截取(文本, 起点, 长度)：第5、8位是 '-'，第11位是 ' '
    断言相等(截取(s, 4, 1), "-", "第5位分隔")
    断言相等(截取(s, 7, 1), "-", "第8位分隔")
    断言相等(截取(s, 10, 1), " ", "第11位空格")
结束)

测试用例("格式化 纯函数", 函数()
    断言相等(格式化("INFO", "启动", "2026-01-01 00:00:00"), "[INFO] 2026-01-01 00:00:00 启动", "固定时刻格式化")
结束)

测试用例("各级别 注入固定时刻", 函数()
    信息("启动", "2026-01-01 00:00:00")
    警告("内存偏高", "2026-01-01 00:00:01")
    错误("连接失败", "2026-01-01 00:00:02")
    调试("调试信息", "2026-01-01 00:00:03")
    断言相等(真, 真, "四级别均能输出且输出确定")
结束)

运行所有测试()
