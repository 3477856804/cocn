# ============================================================
# cocn-log —— 结构化日志（对标 Rust 的 log / env_logger，入门档）
# 复用标准库 日期部分/时间部分 与内置 输出/转整数/现在。
# 注意：现在() 返回浮点，日期部分/时间部分 需要整数时间戳，故先 转整数。
# 设计：格式化（纯函数、可注入时刻）与 输出（副作用）分离 ——
#   这样测试可注入固定时刻，保证三通道输出逐字节一致（门禁要求）。
# ============================================================
导入 "标准库"

# 把整数补前导零到 宽 位
函数 补零(文本, 宽)
    当 长度(文本) < 宽 循环
        文本 = "0" + 文本
    结束
    返回 文本
结束

# 当前本地时间戳字符串 YYYY-MM-DD HH:MM:SS
函数 时间戳()
    整数 秒 = 转整数(现在())
    列表 d = 日期部分(秒)
    列表 t = 时间部分(秒)
    字符串 日 = 补零(转字符串(d[0]), 4) + "-" + 补零(转字符串(d[1]), 2) + "-" + 补零(转字符串(d[2]), 2)
    字符串 时 = 补零(转字符串(t[0]), 2) + ":" + 补零(转字符串(t[1]), 2) + ":" + 补零(转字符串(t[2]), 2)
    返回 日 + " " + 时
结束

# 纯格式化：把 级别/消息/时刻 拼成日志行（不产生副作用，便于测试）
函数 格式化(级别, 消息, 时刻)
    返回 "[" + 级别 + "] " + 时刻 + " " + 消息
结束

# 通用日志：时刻为空则取当前时间戳，输出格式化后的行
函数 日志(级别, 消息, 时刻)
    如果 时刻 == 空 则 时刻 = 时间戳() 结束
    输出(格式化(级别, 消息, 时刻))
结束

# 各级别便捷函数（时刻可注入，缺省用当前时间）
函数 信息(消息, 时刻) 返回 日志("INFO", 消息, 时刻) 结束
函数 警告(消息, 时刻) 返回 日志("WARN", 消息, 时刻) 结束
函数 错误(消息, 时刻) 返回 日志("ERROR", 消息, 时刻) 结束
函数 调试(消息, 时刻) 返回 日志("DEBUG", 消息, 时刻) 结束
