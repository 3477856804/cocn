# cocn-math 测试
导入 "标准库"
导入 "库"

测试用例("符号", 函数()
    断言相等(符号(5), 1, "正数为 1")
    断言相等(符号(-3), -1, "负数为 -1")
    断言相等(符号(0), 0, "零为 0")
    断言相等(符号(0.001), 1, "小正数为 1")
结束)

测试用例("四舍五入", 函数()
    断言相等(四舍五入(2.4), 2, "舍")
    断言相等(四舍五入(2.5), 3, "入")
    断言相等(四舍五入(2.6), 3, "入")
    断言相等(四舍五入(-1.5), -2, "负数远离零点")
    断言相等(四舍五入(-0.4), 0, "小负数归零")
    断言相等(四舍五入(7), 7, "整数不变")
结束)

测试用例("向上取整", 函数()
    断言相等(向上取整(2.0), 2, "整数不变")
    断言相等(向上取整(2.1), 3, "向上")
    断言相等(向上取整(-0.5), 0, "负小数向上")
    断言相等(向上取整(5), 5, "整数不变")
结束)

测试用例("幂 快速幂", 函数()
    断言相等(幂(2, 10), 1024, "2^10")
    断言相等(幂(3, 0), 1, "零次幂")
    断言相等(幂(0, 0), 1, "0^0 约定为 1")
    断言相等(幂(2, -1), 0, "负指数整数域返回 0")
    断言相等(幂(7, 3), 343, "7^3")
    断言相等(幂(-2, 3), -8, "负底奇次幂")
结束)

测试用例("自然指数", 函数()
    断言接近(自然指数(0), 1.0, 0.0001, "e^0=1")
    断言接近(自然指数(1), 2.718281828, 0.0001, "e^1≈2.71828")
    断言接近(自然指数(-1), 0.367879441, 0.0001, "e^-1≈0.36788")
    断言接近(自然指数(2), 7.389056099, 0.0001, "e^2≈7.38906")
结束)

测试用例("自然对数", 函数()
    断言接近(自然对数(1), 0.0, 0.0001, "ln1=0")
    断言接近(自然对数(2.718281828459045), 1.0, 0.0001, "ln(e)=1")
    断言接近(自然对数(10), 2.302585093, 0.0001, "ln10≈2.30259")
    断言接近(自然对数(100), 4.605170186, 0.0001, "ln100≈4.60517")
    断言相等(自然对数(0), 空, "0 无对数")
    断言相等(自然对数(-5), 空, "负数无对数")
结束)

测试用例("对数底 与 常用对数", 函数()
    断言接近(对数底(8, 2), 3.0, 0.0001, "log2(8)=3")
    断言接近(对数底(1000, 10), 3.0, 0.0001, "log10(1000)=3")
    断言接近(常用对数(100), 2.0, 0.0001, "log10(100)=2")
    断言接近(常用对数(1), 0.0, 0.0001, "log10(1)=0")
    断言相等(对数底(10, 1), 空, "底为 1 无定义")
结束)

测试用例("角度弧度互转", 函数()
    断言接近(弧度(180), 3.141592654, 0.0001, "180 度 = π")
    断言接近(弧度(90), 1.570796327, 0.0001, "90 度 = π/2")
    断言接近(角度(3.141592654), 180.0, 0.0001, "π 弧度 = 180 度")
    断言接近(角度(1.570796327), 90.0, 0.0001, "π/2 弧度 = 90 度")
结束)

测试用例("斜边 与 线性插值", 函数()
    断言接近(斜边(3, 4), 5.0, 0.0001, "3-4-5 直角三角形")
    断言接近(斜边(0, 0), 0.0, 0.0001, "零向量")
    断言接近(线性插值(0, 10, 0.5), 5.0, 0.0001, "中点")
    断言接近(线性插值(0, 10, 0), 0.0, 0.0001, "端点甲")
    断言接近(线性插值(0, 10, 1), 10.0, 0.0001, "端点乙")
    断言接近(线性插值(10, 0, 0.25), 7.5, 0.0001, "反向四分之一")
结束)

测试用例("众数", 函数()
    断言相等(众数([1, 2, 2, 3]), ["2"], "唯一众数")
    断言相等(众数([1, 1, 2, 2, 3]), ["1", "2"], "双众数")
    断言相等(众数(["甲", "乙", "甲"]), ["甲"], "字符串众数")
    断言相等(众数([]), [], "空表返回空列表")
结束)

测试用例("极差 与 分位数", 函数()
    断言相等(极差([1, 5, 3]), 4, "最大值减最小值")
    断言相等(极差([7]), 0, "单元素极差 0")
    断言相等(极差([]), 0, "空表极差 0")
    断言接近(分位数([1, 2, 3, 4], 0.5), 2.5, 0.0001, "中位数位置")
    断言接近(分位数([1, 2, 3, 4], 0), 1.0, 0.0001, "最小值分位")
    断言接近(分位数([1, 2, 3, 4], 1), 4.0, 0.0001, "最大值分位")
    断言接近(分位数([1, 2, 3, 4], 0.25), 1.75, 0.0001, "下四分位")
    断言相等(分位数([], 0.5), 空, "空表返回空")
结束)

测试用例("变异系数", 函数()
    # [2,4,4,4,5,5,7,9]：均值 5，总体标准差 2，变异系数 0.4
    断言接近(变异系数([2, 4, 4, 4, 5, 5, 7, 9]), 0.4, 0.0001, "总体口径")
    断言相等(变异系数([5, 5, 5]), 0, "无波动为 0")
    断言相等(变异系数([0, 0, 0]), 空, "均值为 0 无定义")
结束)

测试用例("数值排序", 函数()
    断言相等(数值排序([3, 1, 2]), [1, 2, 3], "升序")
    断言相等(数值排序([2.5, 1.5, 3.5]), [1.5, 2.5, 3.5], "浮点升序")
    断言相等(数值排序([]), [], "空表")
    断言相等(数值排序([1]), [1], "单元素")
结束)

测试用例("向量运算", 函数()
    断言接近(点积([1, 2, 3], [4, 5, 6]), 32.0, 0.0001, "1*4+2*5+3*6")
    断言接近(点积([1, 2], [3, 4, 5]), 11.0, 0.0001, "按较短长度")
    断言接近(模长([3, 4]), 5.0, 0.0001, "3-4-5 范数")
    断言接近(模长([0, 0]), 0.0, 0.0001, "零向量范数")
    断言相等(数乘([1, 2, 3], 2), [2, 4, 6], "标量乘")
    断言相等(向量加([1, 2], [3, 4]), [4, 6], "逐项加")
    断言相等(向量减([5, 5], [1, 2]), [4, 3], "逐项减")
    列表 u = 单位向量([3, 4])
    断言接近(u[0], 0.6, 0.0001, "单位向量 x")
    断言接近(u[1], 0.8, 0.0001, "单位向量 y")
    断言相等(单位向量([0, 0]), [0, 0], "零向量原样返回")
结束)

测试用例("组合数 与 排列数", 函数()
    断言相等(组合数(5, 2), 10, "C(5,2)")
    断言相等(组合数(6, 3), 20, "C(6,3)")
    断言相等(组合数(5, 0), 1, "C(5,0)")
    断言相等(组合数(5, 5), 1, "C(5,5)")
    断言相等(组合数(5, 7), 0, "k 越界")
    断言相等(组合数(10, 4), 210, "C(10,4)")
    断言相等(排列数(5, 2), 20, "A(5,2)")
    断言相等(排列数(5, 5), 120, "A(5,5)")
    断言相等(排列数(5, 0), 1, "A(5,0)")
    断言相等(排列数(3, 5), 0, "k 越界")
结束)

测试用例("范围", 函数()
    断言相等(范围(1, 4), [1, 2, 3], "左闭右开")
    断言相等(范围(0, 0), [], "空范围")
    断言相等(范围(-2, 1), [-2, -1, 0], "含负数")
    断言相等(长度(范围(0, 100)), 100, "百元素")
结束)

运行所有测试()
