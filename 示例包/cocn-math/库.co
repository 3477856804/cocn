# ============================================================
# cocn-math —— 数学增强（对标 Rust 的 num-traits + statrs 常用部分）
#
# 标准库已有：阶乘/斐波那契/是素数/最大公约/最小公倍/平均值/中位数/
# 方差/标准差/夹取/安全比值/素数表；内置已有：绝对值/平方根/向下取整/
# 正弦/余弦/正切/最大值/最小值。本包只做增强，不重复实现。
#
# 坑位记录：
#   1) coCN 的整数除法会自动转浮点（5/2=2.5），涉及整除的算法
#      （快速幂、组合数）必须显式 向下取整 或最后 转整数。
#   2) 参数名不能与函数名冲突（如 扩展名/底 冲突会遮蔽函数）。
#   3) 浮点结果不要用 断言相等，用标准库 断言接近。
# ============================================================
导入 "标准库"

# ---------------- 舍入与符号 ----------------

# 符号(x)：正数 1、负数 -1、零 0
函数 符号(x)
    如果 x > 0 则
        返回 1
    结束
    如果 x < 0 则
        返回 -1
    结束
    返回 0
结束

# 四舍五入(x)：远离零点对称（-1.5 → -2，符合数学惯例）
函数 四舍五入(x)
    如果 x >= 0 则
        返回 向下取整(x + 0.5)
    结束
    返回 -向下取整(-x + 0.5)
结束

# 向上取整(x)：不小于 x 的最小整数
函数 向上取整(x)
    浮点 下 = 向下取整(x)
    如果 下 == x 则
        返回 下
    结束
    返回 下 + 1
结束

# ---------------- 幂与对数 ----------------

# 幂(底, 指)：非负整数指数的快速幂；负指数返回 0（整数域无小数幂）
函数 幂(底, 指)
    如果 指 < 0 则
        返回 0
    结束
    整数 结果 = 1
    整数 基数 = 底
    整数 e = 指
    当 e > 0 循环
        如果 e % 2 == 1 则
            结果 = 结果 * 基数
        结束
        基数 = 基数 * 基数
        # 整数除法会转浮点，必须显式向下取整保持整数
        e = 向下取整(e / 2)
    结束
    返回 结果
结束

# 自然指数(x)：e^x 泰勒级数（|x| <= 20 内精度足够）
函数 自然指数(x)
    浮点 z = x
    如果 z < 0 则
        z = -z
    结束
    浮点 项 = 1.0
    浮点 合计 = 1.0
    整数 n = 1
    当 n <= 30 循环
        项 = 项 * z / n
        合计 = 合计 + 项
        n = n + 1
    结束
    如果 x < 0 则
        返回 1.0 / 合计
    结束
    返回 合计
结束

# 自然对数(x)：二分法配 自然指数 求解；x <= 0 无定义返回 空
函数 自然对数(x)
    如果 x <= 0 则
        返回 空
    结束
    浮点 下 = -50.0
    浮点 上 = 50.0
    整数 i = 0
    当 i < 200 循环
        浮点 中 = (下 + 上) / 2
        如果 自然指数(中) < x 则
            下 = 中
        否则
            上 = 中
        结束
        i = i + 1
    结束
    返回 (下 + 上) / 2
结束

# 对数底(x, 底)：换底公式；底 <= 0 或 x <= 0 返回 空
函数 对数底(x, 底)
    如果 x <= 0 或 底 <= 0 或 底 == 1 则
        返回 空
    结束
    返回 自然对数(x) / 自然对数(底)
结束

# 常用对数(x)：以 10 为底
函数 常用对数(x)
    返回 对数底(x, 10)
结束

# ---------------- 角度与几何 ----------------

# 弧度(度)：角度转弧度
函数 弧度(度)
    返回 度 * 3.141592653589793 / 180.0
结束

# 角度(弧度值)：弧度转角度（参数名避开内置 正弦/余弦 等）
函数 角度(弧度值)
    返回 弧度值 * 180.0 / 3.141592653589793
结束

# 斜边(甲, 乙)：直角三角形斜边长（勾股定理）
函数 斜边(甲, 乙)
    返回 平方根(甲 * 甲 + 乙 * 乙)
结束

# 线性插值(甲, 乙, t)：甲 + (乙-甲)*t，t 越界即外推
函数 线性插值(甲, 乙, t)
    返回 甲 + (乙 - 甲) * t
结束

# ---------------- 统计增强 ----------------

# 众数(表)：出现次数最多的元素列表（可能多个）；空表返回 []
# 注意：频次 以 转字符串 为键，数字 1 与文本 "1" 视为同一元素
函数 众数(表)
    字典 次 = 频次(表)
    列表 键列表 = 键(次)
    如果 长度(键列表) == 0 则
        返回 []
    结束
    整数 最大 = 0
    整数 i = 0
    当 i < 长度(键列表) 循环
        如果 次[键列表[i]] > 最大 则
            最大 = 次[键列表[i]]
        结束
        i = i + 1
    结束
    列表 结果 = []
    i = 0
    当 i < 长度(键列表) 循环
        如果 次[键列表[i]] == 最大 则
            追加(结果, 键列表[i])
        结束
        i = i + 1
    结束
    返回 结果
结束

# 极差(表)：最大值减最小值；空表返回 0
函数 极差(表)
    如果 长度(表) == 0 则
        返回 0
    结束
    返回 最大值(表) - 最小值(表)
结束

# 分位数(表, q)：q ∈ [0,1]，线性插值；空表返回 空
函数 分位数(表, q)
    如果 长度(表) == 0 则
        返回 空
    结束
    列表 s = 数值排序(表)
    浮点 位置 = q * (长度(s) - 1)
    整数 下 = 向下取整(位置)
    如果 下 >= 长度(s) - 1 则
        返回 s[长度(s) - 1]
    结束
    浮点 零头 = 位置 - 下
    返回 s[下] + 零头 * (s[下 + 1] - s[下])
结束

# 变异系数(表)：标准差 / 平均值（相对离散度）；平均为 0 返回 空
函数 变异系数(表)
    浮点 均 = 平均值(表)
    如果 均 == 0 则
        返回 空
    结束
    返回 标准差(表) / 均
结束

# 数值排序(表)：数值升序（包内自包含，临时变量不加类型标注，
# 避免标准库排序曾用 `整数 临时` 导致字符串元素崩溃的同类问题）
函数 数值排序(表)
    列表 结果 = 切片(表, 0, 长度(表))
    整数 n = 长度(结果)
    整数 i = 0
    当 i < n - 1 循环
        整数 j = 0
        当 j < n - i - 1 循环
            如果 结果[j] > 结果[j + 1] 则
                让 临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
            j = j + 1
        结束
        i = i + 1
    结束
    返回 结果
结束

# ---------------- 向量 ----------------

# 点积(甲, 乙)：按较短长度求点积
函数 点积(甲, 乙)
    浮点 合计 = 0.0
    整数 i = 0
    当 i < 长度(甲) 且 i < 长度(乙) 循环
        合计 = 合计 + 甲[i] * 乙[i]
        i = i + 1
    结束
    返回 合计
结束

# 模长(甲)：向量欧几里得范数
函数 模长(甲)
    返回 平方根(点积(甲, 甲))
结束

# 数乘(甲, k)：标量乘法，返回新向量
函数 数乘(甲, k)
    列表 结果 = []
    整数 i = 0
    当 i < 长度(甲) 循环
        追加(结果, 甲[i] * k)
        i = i + 1
    结束
    返回 结果
结束

# 向量加(甲, 乙) / 向量减(甲, 乙)：按较短长度逐项运算
函数 向量加(甲, 乙)
    列表 结果 = []
    整数 i = 0
    当 i < 长度(甲) 且 i < 长度(乙) 循环
        追加(结果, 甲[i] + 乙[i])
        i = i + 1
    结束
    返回 结果
结束

函数 向量减(甲, 乙)
    列表 结果 = []
    整数 i = 0
    当 i < 长度(甲) 且 i < 长度(乙) 循环
        追加(结果, 甲[i] - 乙[i])
        i = i + 1
    结束
    返回 结果
结束

# 单位向量(甲)：方向不变、长度为 1；零向量原样返回
函数 单位向量(甲)
    浮点 m = 模长(甲)
    如果 m == 0 则
        返回 甲
    结束
    返回 数乘(甲, 1.0 / m)
结束

# ---------------- 组合数学 ----------------

# 组合数(n, k)：C(n,k)，乘法公式逐步整除；k 越界返回 0
函数 组合数(n, k)
    如果 k < 0 或 k > n 则
        返回 0
    结束
    如果 k > n - k 则
        k = n - k
    结束
    整数 结果 = 1
    整数 i = 0
    当 i < k 循环
        结果 = 结果 * (n - i)
        # 数学上每步都整除；整数除法转浮点，最后统一转回整数
        结果 = 向下取整(结果 / (i + 1))
        i = i + 1
    结束
    返回 结果
结束

# 排列数(n, k)：A(n,k) = n!/(n-k)!；k 越界返回 0
函数 排列数(n, k)
    如果 k < 0 或 k > n 则
        返回 0
    结束
    返回 转整数(阶乘(n) / 阶乘(n - k))
结束

# ---------------- 序列 ----------------

# 范围(起, 止)：[起, 止) 的整数列表（对标 Rust 的 (起..止).collect()）
函数 范围(起, 止)
    列表 结果 = []
    整数 i = 起
    当 i < 止 循环
        追加(结果, i)
        i = i + 1
    结束
    返回 结果
结束
