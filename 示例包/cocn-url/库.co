# ============================================================
# cocn-url —— URL 解析与构建（对标 Rust 的 url，纯本地无网络）
# 复用标准库 字符串函数；不依赖任何网络能力。
# ============================================================
导入 "标准库"

# 解析 URL 为各字段字典
函数 解析(地址)
    字典 r = {"scheme":"", "host":"", "port":"", "path":"", "query":"", "fragment":""}
    如果 包含(地址, "#") 则
        整数 h = 查找(地址, "#")
        r["fragment"] = 截取(地址, h + 1, 长度(地址))
        地址 = 截取(地址, 0, h)
    结束
    如果 包含(地址, "://") 则
        整数 s = 查找(地址, "://")
        r["scheme"] = 截取(地址, 0, s)
        地址 = 截取(地址, s + 3, 长度(地址))
    结束
    如果 包含(地址, "?") 则
        整数 q = 查找(地址, "?")
        r["query"] = 截取(地址, q + 1, 长度(地址))
        地址 = 截取(地址, 0, q)
    结束
    如果 包含(地址, "/") 则
        整数 p = 查找(地址, "/")
        r["path"] = 截取(地址, p, 长度(地址))
        地址 = 截取(地址, 0, p)
    否则
        r["path"] = "/"
    结束
    如果 包含(地址, ":") 则
        整数 c = 查找(地址, ":")
        r["port"] = 截取(地址, c + 1, 长度(地址))
        r["host"] = 截取(地址, 0, c)
    否则
        r["host"] = 地址
    结束
    返回 r
结束

# 解析查询串为 键->值 字典
函数 查询(地址)
    字典 r = {}
    如果 非 包含(地址, "?") 则 返回 r 结束
    整数 q = 查找(地址, "?")
    字符串 qs = 截取(地址, q + 1, 长度(地址))
    如果 包含(qs, "#") 则 qs = 截取(qs, 0, 查找(qs, "#")) 结束
    列表 对 = 分割(qs, "&")
    对于 i 从 0 到 长度(对) - 1 循环
        如果 包含(对[i], "=") 则
            整数 e = 查找(对[i], "=")
            r[截取(对[i], 0, e)] = 截取(对[i], e + 1, 长度(对[i]))
        结束
    结束
    返回 r
结束

# 由字段构建 URL
函数 构建(部分)
    字符串 u = ""
    如果 部分["scheme"] != "" 则 u = u + 部分["scheme"] + "://" 结束
    u = u + 部分["host"]
    如果 部分["port"] != "" 则 u = u + ":" + 部分["port"] 结束
    如果 部分["path"] != "" 则 u = u + 部分["path"] 否则 u = u + "/" 结束
    如果 部分["query"] != "" 则 u = u + "?" + 部分["query"] 结束
    如果 部分["fragment"] != "" 则 u = u + "#" + 部分["fragment"] 结束
    返回 u
结束
