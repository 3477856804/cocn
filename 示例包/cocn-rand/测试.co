# cocn-rand 测试
导入 "标准库"
导入 "库"

测试用例("整数 落在闭区间", 函数()
    对于 i 从 0 到 49 循环
        整数 x = 取整数(1, 6)
        断言相等(x >= 1 且 x <= 6, 真, "整数范围")
    结束
结束)

测试用例("布尔 类型", 函数()
    断言相等(类型(取布尔()), "布尔", "布尔类型")
结束)

测试用例("uuid 格式", 函数()
    字符串 u = uuid()
    断言相等(长度(u), 36, "uuid 长度")
    断言相等(计数子串(u, "-"), 4, "uuid 连字符数")
结束)

测试用例("抽样 长度", 函数()
    列表 s = 抽样([1, 2, 3, 4, 5], 3)
    断言相等(长度(s), 3, "抽样长度")
结束)

测试用例("洗牌 长度不变", 函数()
    列表 原 = [1, 2, 3, 4, 5]
    断言相等(取整数(1, 6) >= 1 且 取整数(1, 6) <= 6, 真, "取整数范围")
    断言相等(长度(洗牌(原)), 5, "洗牌长度")
结束)

运行所有测试()
