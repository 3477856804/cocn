# cocn-test 测试
# 注意：不调用 基准（输出含真实耗时，三通道无法逐字节一致）；
# 计时 只断言非负。另：多行匿名函数不作第一个参数内联传递（解析器
# 不支持），统一先赋值给变量再传入。
导入 "标准库"
导入 "库"

测试用例("计时 返回非负", 函数()
    让 任务 = 函数()
        让 s = 0
        整数 i = 0
        当 i < 1000 循环
            s = s + i
            i = i + 1
        结束
    结束
    整数 ms = 计时(任务)
    断言为真(ms >= 0, "耗时非负")
    断言为真(是整数(ms), "耗时是整数")
结束)

测试用例("重复 按次数执行", 函数()
    整数 计数 = 0
    让 加一 = 函数()
        计数 = 计数 + 1
    结束
    整数 n = 重复(5, 加一)
    断言相等(n, 5, "返回执行次数")
    断言相等(计数, 5, "闭包计数一致")
    断言相等(重复(0, 加一), 0, "零次不执行")
    断言相等(重复(-3, 加一), 0, "负次数按零处理")
结束)

测试用例("属性 通过路径", 函数()
    让 生成 = 函数(i)
        返回 i * 2
    结束
    让 谓词 = 函数(x)
        返回 x % 2 == 0
    结束
    断言相等(属性("偶数翻倍仍为偶数", 生成, 谓词, 50), 真, "50 例全部通过")
结束)

测试用例("属性 失败路径报告反例", 函数()
    让 生成 = 函数(i)
        返回 i - 25
    结束
    让 谓词 = 函数(x)
        返回 x > 0
    结束
    断言相等(属性("并非全为正", 生成, 谓词, 100), 假, "存在反例返回假")
结束)

测试用例("属性 零次按一次处理", 函数()
    让 生成 = 函数(i)
        返回 i
    结束
    让 谓词 = 函数(x)
        返回 真
    结束
    断言相等(属性("恒真", 生成, 谓词, 0), 真, "至少执行一次")
结束)

测试用例("分组测试 前缀注册", 函数()
    断言为真(真, "分组用例已在顶层注册，由 运行所有测试 统一执行")
结束)

测试用例("跳过 打印信息", 函数()
    跳过("本环境不支持网络")
    断言为真(真, "跳过后继续")
结束)

测试用例("断言快照 结构比对", 函数()
    断言快照([1, 2, 3], "[1, 2, 3]", "列表文本一致")
    断言快照(构造列表(), "[1, 2]", "函数返回值列表")
结束)

函数 构造列表()
    返回 [1, 2]
结束

# 分组用例在顶层注册：测试运行过程中再注册会被 运行所有测试 的快照漏掉
让 用例一 = 函数()
    断言相等(1 + 1, 2, "基础算术")
结束
让 用例二 = 函数()
    断言相等(2 + 2, 4, "基础算术")
结束
分组测试("算术", "一加一", 用例一)
分组测试("算术", "二加二", 用例二)

运行所有测试()
