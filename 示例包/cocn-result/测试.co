# cocn-result 测试
# 覆盖结果/选项的构造、判定、取值、映射、链式、文本化与异常收口。
# 注意：多行匿名函数不做第一个参数内联传递，先赋值给变量再传入。

导入 "标准库"
导入 "库"

测试用例("成功 与 失败 结构", 函数()
    让 好 = 成功(42)
    断言相等(是结果(好), 真, "成功是结果")
    断言相等(好["类型"], "结果", "类型字段")
    断言相等(好["成功"], 真, "成功标记")
    断言相等(好["值"], 42, "值字段")
    断言相等(好["错误"], 空, "成功时错误为空")

    让 坏 = 失败("坏了")
    断言相等(是结果(坏), 真, "失败也是结果")
    断言相等(坏["成功"], 假, "失败标记")
    断言相等(坏["值"], 空, "失败时值为空")
    断言相等(坏["错误"], "坏了", "错误字段")
结束)

测试用例("是结果 对任意输入安全", 函数()
    断言相等(是结果(1), 假, "整数不是结果")
    断言相等(是结果("x"), 假, "字符串不是结果")
    断言相等(是结果([]), 假, "列表不是结果")
    断言相等(是结果({}), 假, "空字典不是结果")
    断言相等(是结果({"类型": "别的"}), 假, "其他类型不是结果")
    断言相等(是结果(成功(1)), 真, "成功结果是结果")
结束)

测试用例("是成功 与 是失败", 函数()
    断言相等(是成功(成功(1)), 真, "成功")
    断言相等(是成功(失败("e")), 假, "失败不是成功")
    断言相等(是失败(失败("e")), 真, "失败")
    断言相等(是失败(成功(1)), 假, "成功不是失败")
    断言相等(是成功(123), 假, "非结果不是成功")
    断言相等(是失败(123), 假, "非结果不是失败")
结束)

测试用例("取值 与 取错误", 函数()
    断言相等(取值(成功("甲"), "缺省"), "甲", "成功取值")
    断言相等(取值(失败("e"), "缺省"), "缺省", "失败取缺省")
    断言相等(取值(123, "缺省"), "缺省", "非结果取缺省")

    断言相等(取错误(失败("e"), "无"), "e", "失败取错误")
    断言相等(取错误(成功(1), "无"), "无", "成功取缺省")
    断言相等(取错误(123, "无"), "无", "非结果取缺省")
结束)

测试用例("结果错误消息", 函数()
    断言相等(结果错误消息(失败("直接错误")), "直接错误", "字符串错误")
    断言相等(结果错误消息(失败({"类型": "业务错误", "消息": "余额不足"})), "余额不足", "字典错误取消息")
    断言相等(结果错误消息(成功(1)), "", "成功无错误消息")
    断言相等(结果错误消息(123), "", "非结果无错误消息")
结束)

测试用例("映射结果", 函数()
    让 加倍 = 函数(x)
        返回 x * 2
    结束
    让 好 = 映射结果(成功(21), 加倍)
    断言相等(是成功(好), 真, "成功映射后仍成功")
    断言相等(取值(好, 0), 42, "值被转换")

    让 坏 = 映射结果(失败("原错误"), 加倍)
    断言相等(是失败(坏), 真, "失败透传")
    断言相等(取错误(坏, ""), "原错误", "错误原样保留")

    让 非结果 = 映射结果(123, 加倍)
    断言相等(是失败(非结果), 真, "非结果转为失败")
结束)

测试用例("映射错误", 函数()
    让 加前缀 = 函数(e)
        返回 "错误: " + e
    结束
    让 坏 = 映射错误(失败("磁盘满"), 加前缀)
    断言相等(是失败(坏), 真, "失败映射后仍失败")
    断言相等(取错误(坏, ""), "错误: 磁盘满", "错误被转换")

    让 好 = 映射错误(成功(7), 加前缀)
    断言相等(是成功(好), 真, "成功透传")
    断言相等(取值(好, 0), 7, "值原样保留")
结束)

测试用例("链式结果 成功与失败", 函数()
    让 正数校验 = 函数(x)
        如果 x > 0 则
            返回 成功(x)
        结束
        返回 失败("非正数")
    结束

    让 好 = 链式结果(成功(5), 正数校验)
    断言相等(是成功(好), 真, "正数通过")
    断言相等(取值(好, 0), 5, "值保留")

    让 坏 = 链式结果(成功(-1), 正数校验)
    断言相等(是失败(坏), 真, "负数失败")
    断言相等(取错误(坏, ""), "非正数", "失败原因")

    让 已失败 = 链式结果(失败("上游错误"), 正数校验)
    断言相等(取错误(已失败, ""), "上游错误", "失败短路")
结束)

函数 触发链式形状错误()
    让 坏回调 = 函数(x)
        返回 x
    结束
    链式结果(成功(1), 坏回调)
结束

测试用例("链式结果 拒绝非结果回调", 函数()
    断言抛出(触发链式形状错误, "回调必须返回结果")
结束)

测试用例("结果转文本", 函数()
    断言相等(结果转文本(成功("甲")), "成功(甲)", "成功文本")
    断言相等(结果转文本(失败("乙")), "失败(乙)", "失败文本")
    断言相等(结果转文本(123), "非结果(123)", "非结果文本")
结束)

测试用例("尝试执行 成功路径", 函数()
    让 任务 = 函数()
        返回 7
    结束
    让 结果值 = 尝试执行(任务)
    断言相等(是成功(结果值), 真, "正常返回成功")
    断言相等(取值(结果值, 0), 7, "取到返回值")
结束)

测试用例("尝试执行 捕获抛出", 函数()
    让 任务 = 函数()
        抛出 "boom"
    结束
    让 结果值 = 尝试执行(任务)
    断言相等(是失败(结果值), 真, "抛出转失败")
    断言相等(结果错误消息(结果值), "boom", "错误消息")

    让 字典任务 = 函数()
        抛出 {"类型": "业务错误", "消息": "余额不足"}
    结束
    让 字典结果 = 尝试执行(字典任务)
    断言相等(是失败(字典结果), 真, "字典异常转失败")
    断言相等(结果错误消息(字典结果), "余额不足", "字典异常消息")
结束)

测试用例("选项有 与 选项无 结构", 函数()
    让 有 = 选项有(9)
    断言相等(是选项(有), 真, "有值是选项")
    断言相等(有["类型"], "选项", "类型字段")
    断言相等(有["有"], 真, "有标记")
    断言相等(有["值"], 9, "值字段")

    让 无 = 选项无()
    断言相等(是选项(无), 真, "无值是选项")
    断言相等(无["有"], 假, "无标记")
    断言相等(无["值"], 空, "无值字段为空")
结束)

测试用例("是选项 对任意输入安全", 函数()
    断言相等(是选项(1), 假, "整数不是选项")
    断言相等(是选项("x"), 假, "字符串不是选项")
    断言相等(是选项({}), 假, "空字典不是选项")
    断言相等(是选项({"类型": "结果", "成功": 真}), 假, "结果不是选项")
    断言相等(是选项(选项有(1)), 真, "有值是选项")
结束)

测试用例("是选项有 与 是选项无", 函数()
    断言相等(是选项有(选项有(1)), 真, "有值")
    断言相等(是选项有(选项无()), 假, "无值不是有值")
    断言相等(是选项无(选项无()), 真, "无值")
    断言相等(是选项无(选项有(1)), 假, "有值不是无值")
    断言相等(是选项有(123), 假, "非选项不是有值")
    断言相等(是选项无(123), 假, "非选项不是无值")
结束)

测试用例("选项取值 与 选项从空", 函数()
    断言相等(选项取值(选项有("甲"), "缺省"), "甲", "有值取值")
    断言相等(选项取值(选项无(), "缺省"), "缺省", "无值取缺省")
    断言相等(选项取值(123, "缺省"), "缺省", "非选项取缺省")

    断言相等(是选项无(选项从空(空)), 真, "空映射为无")
    断言相等(是选项有(选项从空(0)), 真, "零映射为有值")
    断言相等(选项取值(选项从空("x"), ""), "x", "非空映射为有值")
结束)

测试用例("选项映射", 函数()
    让 加倍 = 函数(x)
        返回 x * 2
    结束
    让 有 = 选项映射(选项有(21), 加倍)
    断言相等(是选项有(有), 真, "有值映射后仍有值")
    断言相等(选项取值(有, 0), 42, "值被转换")

    让 无 = 选项映射(选项无(), 加倍)
    断言相等(是选项无(无), 真, "无值透传")
结束)

测试用例("选项链 成功与失败", 函数()
    让 正数选项 = 函数(x)
        如果 x > 0 则
            返回 选项有(x)
        结束
        返回 选项无()
    结束

    让 好 = 选项链(选项有(5), 正数选项)
    断言相等(是选项有(好), 真, "正数通过")
    断言相等(选项取值(好, 0), 5, "值保留")

    让 坏 = 选项链(选项有(-1), 正数选项)
    断言相等(是选项无(坏), 真, "负数转无")

    让 已无 = 选项链(选项无(), 正数选项)
    断言相等(是选项无(已无), 真, "无值短路")
结束)

函数 触发选项形状错误()
    让 坏回调 = 函数(x)
        返回 x
    结束
    选项链(选项有(1), 坏回调)
结束

测试用例("选项链 拒绝非选项回调", 函数()
    断言抛出(触发选项形状错误, "回调必须返回选项")
结束)

测试用例("选项转文本", 函数()
    断言相等(选项转文本(选项有("甲")), "有(甲)", "有值文本")
    断言相等(选项转文本(选项无()), "无", "无值文本")
    断言相等(选项转文本(123), "非选项(123)", "非选项文本")
结束)

运行所有测试()
