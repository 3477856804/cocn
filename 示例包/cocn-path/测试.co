# cocn-path 测试：路径语义用「已知答案」断言，跨平台行为固定
导入 "标准库"
导入 "库"

测试用例("组件分解", 函数()
    断言相等(路径组件("a/b/c"), ["a", "b", "c"], "三段")
    断言相等(路径组件("/a/b"), ["a", "b"], "前导斜杠不算组件")
    断言相等(路径组件("a//b"), ["a", "b"], "连续斜杠压掉")
    断言相等(路径组件(""), [], "空路径无组件")
    断言相等(路径组件("a/./b"), ["a", ".", "b"], "保留 .")
    断言相等(路径组件("a/../b"), ["a", "..", "b"], "保留 ..")
结束)

测试用例("根目录识别", 函数()
    断言相等(路径根目录("/a/b"), "/", "POSIX 根")
    断言相等(路径根目录("a/b"), "", "相对路径无根")
    断言相等(路径根目录("/"), "/", "根自身")
    断言相等(路径根目录("C:/x"), "C:", "Windows 盘符")
    断言相等(路径根目录(""), "", "空串无根")
结束)

测试用例("规范化消解点号", 函数()
    断言相等(路径规范化("/a/./b"), "/a/b", "去掉 .")
    断言相等(路径规范化("/a/b/../c"), "/a/c", "消解 ..")
    断言相等(路径规范化("a/b/.."), "a", "尾部 .. 消解到父")
    断言相等(路径规范化("/a//b"), "/a/b", "压掉重复斜杠")
    断言相等(路径规范化(""), ".", "空路径归一为 .")
    断言相等(路径规范化("."), ".", "单点")
    断言相等(路径规范化("/"), "/", "根保持")
    断言相等(路径规范化("a/../../b"), "../b", "越过根的 .. 保留")
    断言相等(路径规范化("/a/.."), "/", "归到根")
结束)

测试用例("路径拼接", 函数()
    断言相等(路径连接("a", "b"), "a/b", "普通拼接")
    断言相等(路径连接("a/", "b"), "a/b", "尾斜杠不重复加")
    断言相等(路径连接("", "b"), "b", "空基准")
    断言相等(路径连接("a", ""), "a", "空部件")
    断言相等(路径连接("a", "/b"), "/b", "绝对路径覆盖基准")
结束)

测试用例("文件名与目录", 函数()
    断言相等(路径文件名("/a/b.txt"), "b.txt", "取末段")
    断言相等(路径文件名("a/b/"), "b", "尾斜杠先去掉")
    断言相等(路径文件名("a.txt"), "a.txt", "单段")
    断言相等(路径文件名(""), "", "空路径")
    断言相等(路径父目录("/a/b.txt"), "/a", "取父目录")
    断言相等(路径父目录("a.txt"), "", "无父目录")
    断言相等(路径父目录("/a"), "/", "根的父是根")
    断言相等(路径父目录("/a/b/"), "/a", "尾斜杠先去掉")
结束)

测试用例("扩展名处理", 函数()
    断言相等(路径扩展名("a.txt"), ".txt", "普通扩展名")
    断言相等(路径扩展名("a.tar.gz"), ".gz", "只取最后一段")
    断言相等(路径扩展名("a"), "", "无扩展名")
    断言相等(路径扩展名(".txt"), "", "点开头视为无扩展名")
    断言相等(路径去扩展名("a.tar.gz"), "a.tar", "去最后一段扩展名")
    断言相等(路径去扩展名("a"), "a", "无扩展名不变")
    断言相等(路径换扩展名("a.txt", ".md"), "a.md", "替换扩展名")
    断言相等(路径换扩展名("a.txt", "md"), "a.md", "不带点自动补点")
    断言相等(路径换扩展名("/x/y/a.txt", ".md"), "/x/y/a.md", "带目录")
    断言相等(路径换扩展名("a", ".md"), "a.md", "原本无扩展名")
结束)

测试用例("拆解一次性取齐", 函数()
    字典 d = 路径拆解("/a/b.tar.gz")
    断言相等(d["根"], "/", "根")
    断言相等(d["文件名"], "b.tar.gz", "文件名")
    断言相等(d["扩展名"], ".gz", "扩展名")
    断言相等(d["无扩展名文件名"], "b.tar", "干名")
    断言相等(d["目录"], "/a", "目录")
结束)

测试用例("绝对与相对", 函数()
    断言相等(路径是绝对("/a"), 真, "POSIX 绝对")
    断言相等(路径是绝对("a"), 假, "相对")
    断言相等(路径是绝对("C:\\x"), 真, "Windows 绝对")
    断言相等(路径是相对("a/b"), 真, "相对判定")
    断言相等(路径是相对("/a"), 假, "绝对不是相对")
    断言相等(路径绝对化("/base", "x"), "/base/x", "相对转绝对")
    断言相等(路径绝对化("/base", "/x"), "/x", "已是绝对")
    断言相等(路径绝对化("/base", "../x"), "/x", "含 .. 也归一")
结束)

测试用例("相对化", 函数()
    断言相等(路径相对化("/a/b", "/a/b/c"), "c", "同父")
    断言相等(路径相对化("/a", "/a/b/c"), "b/c", "多段")
    断言相等(路径相对化("/a/b/c", "/a"), "../..", "回退两级")
    断言相等(路径相对化("/a", "/a"), "", "同路径为空")
    断言相等(路径相对化("/a/b", "/a/c"), "../c", "分歧路径")
结束)

测试用例("子路径判定按组件边界", 函数()
    断言相等(路径是子路径("/a", "/a/b"), 真, "真子路径")
    断言相等(路径是子路径("/a", "/a"), 假, "自身不算子")
    断言相等(路径是子路径("/a", "/ab"), 假, "字符串前缀不算")
    断言相等(路径是子路径("/a/b", "/a/b/c/d"), 真, "深层")
    断言相等(路径是子路径("/a", "/b/c"), 假, "无包含关系")
结束)

测试用例("共同前缀", 函数()
    断言相等(路径有共同前缀("/a/b", "/a/c"), 真, "同根")
    断言相等(路径有共同前缀("/a", "/b"), 假, "不同根")
    断言相等(路径有共同前缀("/a", "/a"), 真, "自身")
    断言相等(路径共同前缀("/a/b/c", "/a/b/d"), "a/b", "共享两段")
    断言相等(路径共同前缀("/a/b", "/a/c"), "a", "共享一段")
    断言相等(路径共同前缀("/a", "/b"), "", "无共享")
结束)

测试用例("通配符匹配", 函数()
    断言相等(路径匹配通配("*.txt", "a.txt"), 真, "后缀通配")
    断言相等(路径匹配通配("*.txt", "a.md"), 假, "不匹配")
    断言相等(路径匹配通配("a?c", "abc"), 真, "单字符通配")
    断言相等(路径匹配通配("a?c", "ac"), 假, "长度不符")
    断言相等(路径匹配通配("a/*/c", "a/b/c"), 真, "中间通配")
    断言相等(路径匹配通配("*", "任意"), 真, "全通配")
    断言相等(路径匹配通配("*.txt", ""), 假, "空串不匹配")
    断言相等(路径匹配通配("", ""), 真, "双空匹配")
    断言相等(路径匹配任意(["*.md", "*.txt"], "a.txt"), 真, "多模式命中其一")
    断言相等(路径匹配任意(["*.md", "*.rst"], "a.txt"), 假, "多模式全不中")
结束)

运行所有测试()
