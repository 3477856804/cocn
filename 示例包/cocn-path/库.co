# ============================================================
# cocn-path —— 路径处理工具集（对标 Rust 的 path 模块，纯本地无 IO）
#
# 与标准库 库/文件系统.co 的分工：
#   标准库 路径拼接/文件名/目录名/扩展名 是「简单切分」版本：
#   只按最后一个 "/" 切，不处理 "."、".."、重复分隔符、尾分隔符。
#   本包做的是 Rust path 的那一层：规范化、绝对化/相对化、
#   组件分解、扩展名替换、父子关系判定。
#
# 踩坑记录（写这个包时实测确认的，写错了三通道会分歧）：
#   1) 截取(s, 起, 止) 在【标准库】里是「起止下标、开区间」：
#      截取("abcdef", 1, 3) == "bc"。但在【宿主 C】里是「起点+长度」：
#      截取("abcdef", 1, 3) == "bcd"。标准库 库/文件系统.co 的
#      路径文件名() 用的是宿主语义（长度），本包一律用【长度】语义，
#      并在每个用到的地方写清注释，避免混用。
#   2) 查找(s, 子) 只支持 2 参，第三参（起始下标）被忽略；
#      需要从后往前找用 从后查找(s, 子)。
#   3) 长度() 对字符串返回的是【字符数】（UTF-8 码点），
#      不是字节数；中文路径按字符算，索引也按字符。
#   4) 整数除法自动转浮点：i / 2 得 1.5，要整数除用 向下取整(i / 2)。
#   5) 字典缺键返回 空（null），不是空串；判空用 == 空。
#   6) 列表下标越界会抛异常，遍历前务必用 长度() 卡边界。
# ============================================================
导入 "标准库"

# ============================================================
# 内部工具
# ============================================================

# 判断是不是路径分隔符（POSIX 的 / 与 Windows 的 \）
函数 路径是分隔符(字符串 c) -> 布尔
    返回 c == "/" 或 c == "\\"
结束

# 去掉结尾的所有分隔符（保留根目录 "/"）
函数 路径去尾分隔符(字符串 路径) -> 字符串
    整数 n = 长度(路径)
    当 n > 0 且 路径是分隔符(截取(路径, n - 1, 1)) 循环
        n = n - 1
    结束
    如果 n == 0 返回 ""
    返回 截取(路径, 0, n)
结束

# ============================================================
# 组件分解
# ============================================================

# 路径组件(路径) -> 列表：把路径拆成非空组件
# "a/b/../c" -> ["a", "b", "..", "c"]；".." 与 "." 保留（不预先消解）
函数 路径组件(字符串 路径) -> 列表
    列表 结果 = []
    列表 原始 = 分割(路径, "/")
    对于 i 从 0 到 长度(原始) - 1 循环
        字符串 段 = 原始[i]
        如果 段 == "" 则
            继续
        结束
        如果 段 == "." 则
            追加(结果, 段)
            继续
        结束
        追加(结果, 段)
    结束
    返回 结果
结束

# 路径根目录(路径) -> 字符串：取根前缀（"/" 或 "" 或 "C:"）
函数 路径根目录(字符串 路径) -> 字符串
    如果 路径 == "" 返回 ""
    如果 路径 == "/" 返回 "/"
    如果 开头是(路径, "/") 返回 "/"
    如果 长度(路径) >= 2 且 截取(路径, 1, 1) == ":" 则
        返回 截取(路径, 0, 2)
    结束
    返回 ""
结束

# ============================================================
# 规范化
# ============================================================

# 路径规范化(路径) -> 字符串：消解 "." 与 ".."，压掉重复分隔符
# "/a/./b/../c" -> "/a/c"；"a/b/.." -> "a"；"" -> "."
函数 路径规范化(字符串 路径) -> 字符串
    如果 路径 == "" 返回 "."
    字符串 根 = 路径根目录(路径)
    列表 段 = 路径组件(路径)
    列表 栈 = []
    对于 i 从 0 到 长度(段) - 1 循环
        字符串 c = 段[i]
        如果 c == "." 则
            继续
        结束
        如果 c == ".." 则
            如果 长度(栈) > 0 且 栈[长度(栈) - 1] != ".." 则
                弹出(栈)
                继续
            结束
            如果 根 != "" 则
                继续
            结束
        结束
        追加(栈, c)
    结束
    如果 长度(栈) == 0 则
        如果 根 != "" 返回 根
        返回 "."
    结束
    返回 根 + 连接(栈, "/")
结束

# ============================================================
# 拼接与拆分
# ============================================================

# 路径连接(甲, 乙) -> 字符串：拼路径（乙 为绝对路径时直接返回乙）
函数 路径连接(字符串 甲, 字符串 乙) -> 字符串
    如果 甲 == "" 返回 乙
    如果 乙 == "" 返回 甲
    如果 路径是绝对(乙) 则
        返回 乙
    结束
    如果 结尾是(甲, "/") 或 结尾是(甲, "\\") 则
        返回 甲 + 乙
    结束
    返回 甲 + "/" + 乙
结束

# 路径拆解(路径) -> 字典：一次性取齐 Rust Path 的各个组成部分
# 返回键：根/目录/文件名/扩展名/无扩展名文件名
函数 路径拆解(字符串 路径) -> 字典
    字典 r = {}
    字符串 p = 路径
    r["根"] = 路径根目录(p)
    字符串 名 = 路径文件名(p)
    r["文件名"] = 名
    字符串 扩 = 路径扩展名(p)
    r["扩展名"] = 扩
    r["无扩展名文件名"] = 路径去扩展名(名)
    r["目录"] = 路径父目录(p)
    返回 r
结束

# 路径父目录(路径) -> 字符串：取父目录（Rust Path::parent）
# "/a/b.txt" -> "/a"；"a.txt" -> ""；"/a" -> "/"
函数 路径父目录(字符串 路径) -> 字符串
    字符串 p = 路径去尾分隔符(路径)
    如果 p == "" 返回 ""
    整数 i = 长度(p) - 1
    当 i >= 0 且 非 路径是分隔符(截取(p, i, 1)) 循环
        i = i - 1
    结束
    如果 i < 0 则
        返回 ""
    结束
    如果 i == 0 则
        返回 路径根目录(p)
    结束
    返回 截取(p, 0, i)
结束

# 路径文件名(路径) -> 字符串：取最后一段（Rust Path::file_name）
函数 路径文件名(字符串 路径) -> 字符串
    字符串 p = 路径去尾分隔符(路径)
    如果 p == "" 返回 ""
    整数 i = 长度(p) - 1
    当 i >= 0 且 非 路径是分隔符(截取(p, i, 1)) 循环
        i = i - 1
    结束
    返回 截取(p, i + 1, 长度(p) - i - 1)
结束

# 路径扩展名(路径) -> 字符串：取扩展名（含点，Rust Path::extension）
# "a.tar.gz" -> ".gz"（只取最后一段扩展名）
函数 路径扩展名(字符串 路径) -> 字符串
    字符串 名 = 路径文件名(路径)
    如果 名 == "" 返回 ""
    整数 i = 长度(名) - 1
    当 i >= 0 且 截取(名, i, 1) != "." 循环
        i = i - 1
    结束
    如果 i < 0 返回 ""
    如果 i == 0 则
        返回 ""
    结束
    返回 截取(名, i, 长度(名) - i)
结束

# 路径去扩展名(路径) -> 字符串：去掉扩展名（Rust Path::file_stem）
函数 路径去扩展名(字符串 路径) -> 字符串
    字符串 名 = 路径文件名(路径)
    字符串 扩 = 路径扩展名(路径)
    如果 扩 == "" 返回 名
    返回 截取(名, 0, 长度(名) - 长度(扩))
结束

# 路径换扩展名(路径, 新扩展) -> 字符串：替换扩展名（Rust Path::with_extension）
# 新扩展可带点也可不带；带点按原样，不带点补 "."
函数 路径换扩展名(字符串 路径, 字符串 新扩展) -> 字符串
    字符串 目录 = 路径父目录(路径)
    字符串 名 = 路径文件名(路径)
    字符串 干 = 路径去扩展名(名)
    字符串 扩 = 新扩展
    如果 扩 != "" 且 非 开头是(扩, ".") 则
        扩 = "." + 扩
    结束
    返回 路径连接(目录, 干 + 扩)
结束

# ============================================================
# 绝对 / 相对 判定
# ============================================================

# 路径是绝对(路径) -> 布尔：POSIX 以 / 开头；Windows 以盘符或 \ 开头
函数 路径是绝对(字符串 路径) -> 布尔
    如果 路径 == "" 返回 假
    如果 开头是(路径, "/") 返回 真
    如果 开头是(路径, "\\") 返回 真
    如果 长度(路径) >= 2 且 截取(路径, 1, 1) == ":" 返回 真
    返回 假
结束

# 路径是相对(路径) -> 布尔
函数 路径是相对(字符串 路径) -> 布尔
    返回 路径是绝对(路径) == 假
结束

# 路径绝对化(基准, 路径) -> 字符串：以基准为根把相对路径转绝对
函数 路径绝对化(字符串 基准, 字符串 路径) -> 字符串
    如果 路径是绝对(路径) 则
        返回 路径规范化(路径)
    结束
    返回 路径规范化(路径连接(基准, 路径))
结束

# 路径相对化(基准, 目标) -> 字符串：算目标相对基准的路径（Rust path::diff_paths）
# 无法相对化时返回空串
函数 路径相对化(字符串 基准, 字符串 目标) -> 字符串
    字符串 b = 路径规范化(基准)
    字符串 t = 路径规范化(目标)
    列表 基准段 = 路径组件(b)
    列表 目标段 = 路径组件(t)
    整数 公共 = 0
    当 公共 < 长度(基准段) 且 公共 < 长度(目标段) 且 基准段[公共] == 目标段[公共] 循环
        公共 = 公共 + 1
    结束
    列表 上 = []
    整数 i = 公共
    当 i < 长度(基准段) 循环
        追加(上, "..")
        i = i + 1
    结束
    列表 下 = []
    整数 j = 公共
    当 j < 长度(目标段) 循环
        追加(下, 目标段[j])
        j = j + 1
    结束
    如果 长度(上) == 0 且 长度(下) == 0 则
        返回 ""
    结束
    返回 连接(上 + 下, "/")
结束

# ============================================================
# 关系判定
# ============================================================

# 路径是子路径(父, 子) -> 布尔：子是否在父之下（按组件边界比较）
# "/a/b" 是 "/a" 的子路径；"/ab" 不是 "/a" 的子路径
函数 路径是子路径(字符串 父, 字符串 子) -> 布尔
    列表 p = 路径组件(路径规范化(父))
    列表 c = 路径组件(路径规范化(子))
    如果 长度(c) <= 长度(p) 返回 假
    整数 i = 0
    当 i < 长度(p) 循环
        如果 p[i] != c[i] 则
            返回 假
        结束
        i = i + 1
    结束
    返回 真
结束

# 路径共同前缀(甲, 乙) -> 字符串：两路径共享的非根组件前缀
# "/a/b/c" 与 "/a/b/d" -> "a/b"；"/a" 与 "/b" -> ""（无共享组件）
函数 路径共同前缀(字符串 甲, 字符串 乙) -> 字符串
    列表 a = 路径组件(路径规范化(甲))
    列表 b = 路径组件(路径规范化(乙))
    列表 共有 = []
    整数 i = 0
    当 i < 长度(a) 且 i < 长度(b) 循环
        如果 a[i] != b[i] 则
            跳出
        结束
        追加(共有, a[i])
        i = i + 1
    结束
    如果 长度(共有) == 0 返回 ""
    返回 连接(共有, "/")
结束

# 路径有共同前缀(甲, 乙) -> 布尔：两路径是否共享至少一个组件
# "/a/b" 与 "/a/c" -> 真；"/a" 与 "/b" -> 假
函数 路径有共同前缀(字符串 甲, 字符串 乙) -> 布尔
    返回 路径共同前缀(甲, 乙) != ""
结束

# ============================================================
# 路径模式（glob 风格最小集）
# ============================================================

# 路径匹配通配(模式, 路径) -> 布尔：支持 * 与 ?，* 匹配任意长（含分隔符）
# "*.txt" 匹配 "a.txt"；"a/*/c" 匹配 "a/b/c"
函数 路径匹配通配(字符串 模式, 字符串 路径) -> 布尔
    返回 通配匹配(模式, 路径)
结束

# 内部：递归式通配匹配
函数 通配匹配(字符串 模式, 字符串 串) -> 布尔
    整数 n = 长度(模式)
    整数 m = 长度(串)
    如果 n == 0 则
        返回 m == 0
    结束
    字符串 首 = 截取(模式, 0, 1)
    如果 首 == "*" 则
        整数 i = 0
        当 i <= m 循环
            如果 通配匹配(截取(模式, 1, n - 1), 截取(串, i, m - i)) 则
                返回 真
            结束
            i = i + 1
        结束
        返回 假
    结束
    如果 m == 0 则
        返回 假
    结束
    如果 首 == "?" 则
        返回 通配匹配(截取(模式, 1, n - 1), 截取(串, 1, m - 1))
    结束
    如果 首 != 截取(串, 0, 1) 则
        返回 假
    结束
    返回 通配匹配(截取(模式, 1, n - 1), 截取(串, 1, m - 1))
结束

# 路径匹配任意(列表 模式, 字符串 路径) -> 布尔：任一模式命中即真
函数 路径匹配任意(列表 模式, 字符串 路径) -> 布尔
    对于 i 从 0 到 长度(模式) - 1 循环
        如果 路径匹配通配(模式[i], 路径) 则
            返回 真
        结束
    结束
    返回 假
结束
