# cocn-path 演示入口：cocn run 示例包/cocn-path
导入 "标准库"
导入 "库"

输出("=== cocn-path 演示 ===")
输出("路径连接: " + 路径连接("/a/b", "c.txt"))
输出("路径规范化: " + 路径规范化("/a/./b/../c"))
输出("路径组件: " + 转字符串(路径组件("/a/b/c.txt")))
输出("路径文件名: " + 路径文件名("/a/b/c.txt"))
输出("路径扩展名: " + 路径扩展名("/a/b/c.tar.gz"))
输出("路径换扩展名: " + 路径换扩展名("/a/b/c.txt", ".md"))
输出("路径父目录: " + 路径父目录("/a/b/c.txt"))
输出("路径相对化: " + 路径相对化("/a/b", "/a/c/d"))
输出("路径是子路径: " + 转字符串(路径是子路径("/a", "/a/b/c")))
输出("路径匹配通配: " + 转字符串(路径匹配通配("*.txt", "readme.txt")))
