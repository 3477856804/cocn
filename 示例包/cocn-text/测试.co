# cocn-text 测试
导入 "标准库"
导入 "库"

测试用例("截断 不超长", 函数()
    断言相等(截断("你好世界", 10, "…"), "你好世界", "短于上限原样返回")
结束)

测试用例("截断 超长加省略号", 函数()
    断言相等(截断("你好世界", 2, "…"), "你好…", "超长截断并加后缀")
结束)

测试用例("填充左", 函数()
    断言相等(填充左("7", 3, "0"), "007", "左补零")
结束)

测试用例("填充右", 函数()
    断言相等(填充右("ab", 4, "*"), "ab**", "右补星")
结束)

测试用例("反转", 函数()
    断言相等(反转("abc"), "cba", "反转字符串（内置）")
结束)

测试用例("去重空白", 函数()
    断言相等(去重空白("  a   b  c "), "a b c", "折叠多余空白")
结束)

测试用例("分词", 函数()
    断言相等(分词("  a   b  c "), ["a", "b", "c"], "分词")
结束)

测试用例("计数", 函数()
    断言相等(计数("ababa", "aba"), 1, "非重叠计数")
    断言相等(计数("aaaa", "aa"), 2, "重叠按非重叠推进")
结束)

运行所有测试()
