# ============================================================
# cocn-text —— 文本/字符串处理（对标 Rust 的 itertools 常用字符串工具）
# 复用标准库 截取/分割/替换/反转字符串/大写/小写 与内置 查找/长度/包含。
# 注意：不要包装 包含 —— 它是内置函数，标准库多处内部调用，重定义会无限递归。
# ============================================================
导入 "标准库"

# 截断：超过 长 则保留前 长 字符并追加 后缀（默认 …）
函数 截断(文本, 长, 后缀)
    如果 后缀 == 空 则 后缀 = "…" 结束
    如果 长度(文本) <= 长 则 返回 文本 结束
    返回 截取(文本, 0, 长) + 后缀
结束

# 左填充到 宽（默认用空格）
函数 填充左(文本, 宽, 符)
    如果 符 == 空 则 符 = " " 结束
    当 长度(文本) < 宽 循环
        文本 = 符 + 文本
    结束
    返回 文本
结束

# 右填充到 宽（默认用空格）
函数 填充右(文本, 宽, 符)
    如果 符 == 空 则 符 = " " 结束
    当 长度(文本) < 宽 循环
        文本 = 文本 + 符
    结束
    返回 文本
结束

# 反转字符串：直接用内置 反转（注意：不要包装 反转 —— 标准库 反转字符串
# 内部调用内置 反转，重定义 反转 会与 反转字符串 形成无限递归）。
# 包直接暴露内置 反转 即可：导入 "cocn-text" 后调用 反转(文本)。

# 折叠多余空白：连续空格/首尾空白压成单个空格分隔的词序列
函数 去重空白(文本)
    字符串 r = ""
    布尔 词开始 = 真
    对于 i 从 0 到 长度(文本) - 1 循环
        字符串 c = 截取(文本, i, 1)
        如果 c != " " 则
            r = r + c
            词开始 = 假
        否则
            如果 非 词开始 则
                r = r + " "
                词开始 = 真
            结束
        结束
    结束
    # 去掉尾部可能残留的单个空格（输入以空白结尾时）
    当 长度(r) > 0 且 截取(r, 长度(r) - 1, 1) == " " 循环
        r = 截取(r, 0, 长度(r) - 1)
    结束
    返回 r
结束

# 按空白分词（基于 去重空白，不含空串）
函数 分词(文本)
    返回 分割(去重空白(文本), " ")
结束

# 统计子串出现次数（非重叠推进）
# 注意：内置 查找 仅支持 2 参（无起始下标），故手动以 截取+长度 滑动窗口推进。
函数 计数(文本, 子)
    整数 n = 0
    整数 位置 = 0
    整数 步 = 长度(子)
    当 位置 <= 长度(文本) - 步 循环
        如果 截取(文本, 位置, 步) == 子 则
            n = n + 1
            位置 = 位置 + 步
        否则
            位置 = 位置 + 1
        结束
    结束
    返回 n
结束
