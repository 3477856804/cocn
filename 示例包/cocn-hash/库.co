# ============================================================
# cocn-hash —— 哈希工具集（对标 Rust 的 fnv + crc32fast + murmur3）
#
# 标准库已有：简单哈希（DJB2）/ FNV哈希 / CRC32（位于 库/加密）。
# 本包只做增强：提供【精确 32 位取模】的经典非加密哈希，避免
# h * prime 超过 2^53 后双精度舍入导致的结果漂移；并补充
# MurmurHash3、Adler-32、SDBM、Java 哈希与十六进制输出。
#
# 坑位记录：
#   1) coCN 的整数乘法在超过 2^53 后会丢低位，不能直接
#      (h * 16777619) & 0xFFFFFFFF；本包用 16 位拆分乘低 32 位。
#   2) 位运算优先级低于函数调用/输出语句，表达式统一加括号。
#   3) 字符串一律先 字节列表(文本) 取 UTF-8 字节，不能逐字符 转ASCII。
#   4) 这些是【非加密】哈希，不可用于密码/签名；密码请用专用算法。
# ============================================================
导入 "标准库"

# ---------------- 32 位精确算术 ----------------

# 乘低32(a, b)：返回 (a * b) mod 2^32，全程不丢精度
函数 乘低32(整数 a, 整数 b)
    整数 甲 = a & 4294967295
    整数 乙 = b & 4294967295
    整数 甲低 = 甲 & 65535
    整数 甲高 = (甲 >> 16) & 65535
    整数 乙低 = 乙 & 65535
    整数 乙高 = (乙 >> 16) & 65535
    整数 低积 = 甲低 * 乙低
    整数 交叉 = (甲低 * 乙高 + 甲高 * 乙低) & 65535
    返回 (低积 + (交叉 << 16)) & 4294967295
结束

# 循环左移32(值, 位数)：32 位循环左移
函数 循环左移32(整数 值, 整数 位数)
    整数 v = 值 & 4294967295
    整数 r = 位数 % 32
    如果 r == 0 则
        返回 v
    结束
    返回 ((v << r) | (v >> (32 - r))) & 4294967295
结束

# 转32位十六进制(值)：转成 8 位小写十六进制（左侧补零）
函数 转32位十六进制(整数 值)
    字符串 h = 十六进制(值 & 4294967295)
    字符串 数字 = 截取(h, 2, 长度(h) - 2)
    当 长度(数字) < 8 循环
        数字 = "0" + 数字
    结束
    返回 数字
结束

# ---------------- FNV ----------------

# FNV1a32(文本)：FNV-1a 32 位哈希
函数 FNV1a32(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 2166136261
    对于 i 从 0 到 长度(字节) - 1 循环
        h = h ^ 字节[i]
        h = 乘低32(h, 16777619)
    结束
    返回 h
结束

# FNV1a32十六进制(文本)：FNV-1a 32 位哈希的 8 位十六进制
函数 FNV1a32十六进制(字符串 文本)
    返回 转32位十六进制(FNV1a32(文本))
结束

# FNV1_32(文本)：FNV-1 32 位哈希（先乘后异或）
函数 FNV1_32(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 2166136261
    对于 i 从 0 到 长度(字节) - 1 循环
        h = 乘低32(h, 16777619)
        h = h ^ 字节[i]
    结束
    返回 h
结束

# ---------------- 经典字符串哈希 ----------------

# DJB2哈希(文本)：h = h * 33 + byte
函数 DJB2哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 5381
    对于 i 从 0 到 长度(字节) - 1 循环
        h = (h * 33 + 字节[i]) & 4294967295
    结束
    返回 h
结束

# DJB2异或哈希(文本)：h = h * 33 ^ byte
函数 DJB2异或哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 5381
    对于 i 从 0 到 长度(字节) - 1 循环
        h = ((h * 33) ^ 字节[i]) & 4294967295
    结束
    返回 h
结束

# SDBM哈希(文本)：h = byte + (h << 6) + (h << 16) - h
函数 SDBM哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 0
    对于 i 从 0 到 长度(字节) - 1 循环
        h = (字节[i] + (h << 6) + (h << 16) - h) & 4294967295
    结束
    返回 h
结束

# Java哈希(文本)：h = h * 31 + byte（Java String.hashCode 同款）
函数 Java哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 h = 0
    对于 i 从 0 到 长度(字节) - 1 循环
        h = (h * 31 + 字节[i]) & 4294967295
    结束
    返回 h
结束

# ---------------- 校验和 ----------------

# CRC32哈希(文本)：CRC-32/ISO-HDLC（多项式 0xEDB88320）
函数 CRC32哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 crc = 4294967295
    对于 i 从 0 到 长度(字节) - 1 循环
        crc = crc ^ 字节[i]
        对于 j 从 0 到 7 循环
            如果 (crc & 1) == 1 则
                crc = ((crc >> 1) ^ 3988292384) & 4294967295
            否则
                crc = crc >> 1
            结束
        结束
    结束
    返回 (crc ^ 4294967295) & 4294967295
结束

# CRC32十六进制(文本)：CRC32 的 8 位十六进制
函数 CRC32十六进制(字符串 文本)
    返回 转32位十六进制(CRC32哈希(文本))
结束

# Adler32哈希(文本)：Adler-32 校验和
函数 Adler32哈希(字符串 文本)
    列表 字节 = 字节列表(文本)
    整数 a = 1
    整数 b = 0
    对于 i 从 0 到 长度(字节) - 1 循环
        a = (a + 字节[i]) % 65521
        b = (b + a) % 65521
    结束
    返回 (b << 16) | a
结束

# ---------------- MurmurHash3 ----------------

# Murmur3哈希(文本)：MurmurHash3 x86 32 位，种子 0
函数 Murmur3哈希(字符串 文本)
    返回 Murmur3哈希种子(文本, 0)
结束

# Murmur3哈希种子(文本, 种子)：MurmurHash3 x86 32 位
函数 Murmur3哈希种子(字符串 文本, 整数 种子)
    列表 字节 = 字节列表(文本)
    整数 n = 长度(字节)
    整数 h = 种子 & 4294967295
    整数 i = 0
    当 i + 4 <= n 循环
        整数 k = 字节[i] | (字节[i + 1] << 8) | (字节[i + 2] << 16) | (字节[i + 3] << 24)
        k = 乘低32(k, 3432918353)
        k = 循环左移32(k, 15)
        k = 乘低32(k, 461845907)
        h = h ^ k
        h = 循环左移32(h, 13)
        h = (乘低32(h, 5) + 3864292196) & 4294967295
        i = i + 4
    结束
    整数 k = 0
    整数 剩余 = n - i
    如果 剩余 == 3 则
        k = k ^ (字节[i + 2] << 16)
    结束
    如果 剩余 >= 2 则
        k = k ^ (字节[i + 1] << 8)
    结束
    如果 剩余 >= 1 则
        k = k ^ 字节[i]
        k = 乘低32(k, 3432918353)
        k = 循环左移32(k, 15)
        k = 乘低32(k, 461845907)
        h = h ^ k
    结束
    h = h ^ n
    h = h ^ (h >> 16)
    h = 乘低32(h, 2246822507)
    h = h ^ (h >> 13)
    h = 乘低32(h, 3266489909)
    h = h ^ (h >> 16)
    返回 h & 4294967295
结束

# ---------------- 便捷入口 ----------------

# 稳定哈希(文本)：生态内约定用 FNV-1a 32 位作为稳定整数哈希
函数 稳定哈希(字符串 文本)
    返回 FNV1a32(文本)
结束

# 哈希十六进制(文本)：稳定哈希的 8 位十六进制
函数 哈希十六进制(字符串 文本)
    返回 FNV1a32十六进制(文本)
结束

# 文件哈希(路径)：文本文件的 FNV-1a 32 位哈希；文件不存在返回 -1
# 注意：按文本读取，二进制文件请先自行转成字节文本再哈希。
函数 文件哈希(字符串 路径)
    如果 文件存在(路径) != 1 则
        返回 -1
    结束
    返回 FNV1a32(读文件(路径))
结束

# 文件哈希十六进制(路径)：文本文件 FNV-1a 的 8 位十六进制；不存在返回空串
函数 文件哈希十六进制(字符串 路径)
    如果 文件存在(路径) != 1 则
        返回 ""
    结束
    返回 FNV1a32十六进制(读文件(路径))
结束
