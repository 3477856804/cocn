# cocn-hash 测试：已知答案（known-answer）+ 32 位精确取模
导入 "标准库"
导入 "库"

测试用例("FNV-1a 32 已知答案", 函数()
    断言相等(FNV1a32("hello"), 1335831723, "hello")
    断言相等(FNV1a32(""), 2166136261, "空串为 offset basis")
    断言相等(FNV1a32("你好"), 2257816995, "UTF-8 多字节")
结束)

测试用例("FNV-1a 十六进制补零", 函数()
    断言相等(FNV1a32十六进制("hello"), "4f9f2cab", "8 位小写")
    断言相等(FNV1a32十六进制(""), "811c9dc5", "空串")
结束)

测试用例("FNV-1 32 已知答案", 函数()
    断言相等(FNV1_32("hello"), 3069866343, "先乘后异或")
结束)

测试用例("DJB2 两个变体", 函数()
    断言相等(DJB2哈希("hello"), 261238937, "相加变体")
    断言相等(DJB2异或哈希("hello"), 178056679, "异或变体")
结束)

测试用例("SDBM 已知答案", 函数()
    断言相等(SDBM哈希("hello"), 684824882, "hello")
结束)

测试用例("Java 哈希已知答案", 函数()
    断言相等(Java哈希("hello"), 99162322, "String.hashCode 同款")
    断言相等(Java哈希(""), 0, "空串为 0")
结束)

测试用例("CRC32 已知答案", 函数()
    断言相等(CRC32哈希("hello"), 907060870, "hello")
    断言相等(CRC32哈希(""), 0, "空串为 0")
    断言相等(CRC32哈希("你好"), 1352841281, "UTF-8 多字节")
    断言相等(CRC32十六进制("The quick brown fox jumps over the lazy dog"), "414fa339", "经典句子")
结束)

测试用例("Adler-32 已知答案", 函数()
    断言相等(Adler32哈希("hello"), 103547413, "hello")
    断言相等(Adler32哈希(""), 1, "空串为 1")
结束)

测试用例("MurmurHash3 已知答案", 函数()
    断言相等(Murmur3哈希("hello"), 613153351, "种子 0")
    断言相等(Murmur3哈希种子("hello", 42), 3806057185, "种子 42")
    断言相等(Murmur3哈希(""), 0, "空串")
结束)

测试用例("32 位精确乘法与循环移位", 函数()
    断言相等(乘低32(4294967295, 4294967295), 1, "(-1)*(-1)=1")
    断言相等(乘低32(16777619, 2166136261), 84696351, "低 32 位已知答案")
    断言相等(循环左移32(2147483649, 1), 3, "最高位回到最低位")
    断言相等(循环左移32(1, 32), 1, "移 32 位等于不移")
结束)

测试用例("十六进制格式化", 函数()
    断言相等(转32位十六进制(255), "000000ff", "补零")
    断言相等(转32位十六进制(4294967295), "ffffffff", "全 1")
结束)

测试用例("便捷入口", 函数()
    断言相等(稳定哈希("hello"), FNV1a32("hello"), "稳定哈希 = FNV-1a")
    断言相等(哈希十六进制("hello"), "4f9f2cab", "稳定哈希十六进制")
结束)

测试用例("文件哈希 缺失文件保护", 函数()
    断言相等(文件哈希("__cocn_hash_missing__"), -1, "缺失返回 -1")
    断言相等(文件哈希十六进制("__cocn_hash_missing__"), "", "缺失返回空串")
结束)

测试用例("文件哈希 读取自身", 函数()
    字符串 路径 = 环境变量("PWD") + "/测试.co"
    断言相等(长度(文件哈希十六进制(路径)), 8, "8 位十六进制")
结束)

运行所有测试()
