# cocn-datetime 测试
导入 "标准库"
导入 "库"

测试用例("相差天", 函数()
    断言相等(相差天("2024-01-02", "2024-01-01"), 1, "差一天")
    断言相等(相差天("2024-01-01", "2024-01-02"), -1, "负差")
结束)

测试用例("闰年", 函数()
    断言相等(闰年(2024), 真, "2024 闰年")
    断言相等(闰年(2023), 假, "2023 平年")
    断言相等(闰年(2000), 真, "2000 闰年")
    断言相等(闰年(1900), 假, "1900 非闰年")
结束)

测试用例("月天数", 函数()
    断言相等(月天数(2024, 2), 29, "闰年二月")
    断言相等(月天数(2023, 2), 28, "平年二月")
    断言相等(月天数(2023, 12), 31, "十二月")
结束)

测试用例("年月日", 函数()
    列表 t = 年月日("2024-03-15")
    断言相等(t[0], 2024, "年")
    断言相等(t[1], 3, "月")
    断言相等(t[2], 15, "日")
结束)

运行所有测试()
