# cocn-encoding 测试：已知答案（known-answer）+ 往返性质
导入 "标准库"
导入 "库"

测试用例("Base64 已知答案", 函数()
    断言相等(Base64编码(""), "", "空串")
    断言相等(Base64编码("f"), "Zg==", "1 字节补两个等号")
    断言相等(Base64编码("fo"), "Zm8=", "2 字节补一个等号")
    断言相等(Base64编码("foo"), "Zm9v", "3 字节整除")
    断言相等(Base64编码("foob"), "Zm9vYg==", "4 字节")
    断言相等(Base64编码("hello"), "aGVsbG8=", "RFC4648 例子")
    断言相等(Base64编码("你好"), "5L2g5aW9", "UTF-8 多字节")
结束)

测试用例("Base64 解码往返", 函数()
    断言相等(Base64解码("aGVsbG8="), "hello", "hello")
    断言相等(Base64解码("Zm9vYmFy"), "foobar", "foobar")
    断言相等(Base64解码("5L2g5aW9"), "你好", "中文")
    断言相等(Base64解码(Base64编码("abc")), "abc", "往返")
    断言相等(Base64解码(Base64编码("中文abc")), "中文abc", "混合往返")
结束)

测试用例("Base64 URL 安全变体", 函数()
    列表 原始字节 = [251, 255, 190]
    断言相等(Base64编码(字节转文本(原始字节)), "+/++", "标准表含 + 与 /")
    断言相等(Base64网址编码(字节转文本(原始字节)), "-_--", "URL 表换成 - 与 _")
    断言相等(Base64解码(Base64网址编码("中文abc")), "中文abc", "URL 变体可解码")
    断言相等(Base64是合法("aGVsbG8="), 真, "合法")
    断言相等(Base64是合法("aGVsbG8"), 假, "长度非 4 倍数")
    断言相等(Base64是合法("aGVs*G8="), 假, "含非法字符")
    断言相等(Base64是合法(""), 真, "空串视为合法")
结束)

测试用例("十六进制已知答案", 函数()
    断言相等(Hex编码(""), "", "空串")
    断言相等(Hex编码("hello"), "68656c6c6f", "hello")
    断言相等(Hex大写编码("hello"), "68656C6C6F", "大写")
    断言相等(Hex编码("你好"), "e4bda0e5a5bd", "UTF-8 多字节")
    断言相等(Hex解码("68656c6c6f"), "hello", "解码")
    断言相等(Hex解码("68656C6C6F"), "hello", "解码大小写皆可")
    断言相等(Hex解码(Hex编码("中文 abc")), "中文 abc", "往返")
结束)

测试用例("百分号编码", 函数()
    断言相等(URL编码("hello"), "hello", "字母不转义")
    断言相等(URL编码("a b"), "a%20b", "空格转 %20")
    断言相等(URL编码("a/b"), "a%2Fb", "斜杠转义")
    断言相等(URL编码("a-b_c.d~e"), "a-b_c.d~e", "免转义集原样")
    断言相等(URL解码("a%20b"), "a b", "解码")
    断言相等(URL解码("a+b"), "a b", "加号解为空格")
    断言相等(URL解码(URL编码("中文 x/y")), "中文 x/y", "往返")
结束)

测试用例("CSV 基本解析", 函数()
    列表 表 = CSV解析("a,b,c\n1,2,3")
    断言相等(长度(表), 2, "两行")
    断言相等(表[0], ["a", "b", "c"], "表头")
    断言相等(表[1], ["1", "2", "3"], "数据行")
    断言相等(CSV解析(""), [], "空文本无行")
    断言相等(CSV解析("单个"), [["单个"]], "单列单行")
结束)

测试用例("CSV 引号转义（RFC4180）", 函数()
    列表 表 = CSV解析("\"a,b\",c")
    断言相等(表[0], ["a,b", "c"], "引号内逗号不切列")
    列表 表2 = CSV解析("\"他说\"\"好\"\"\",x")
    断言相等(表2[0], ["他说\"好\"", "x"], "双引号转义为单引号")
    列表 表3 = CSV解析("\"第一行\n第二行\",y")
    断言相等(表3[0], ["第一行\n第二行", "y"], "引号内换行属于字段")
结束)

测试用例("CSV 序列化与往返", 函数()
    断言相等(CSV序列化([["a", "b"], ["1", "2"]]), "a,b\n1,2", "普通表格")
    断言相等(CSV序列化([["a,b", "c"]]), "\"a,b\",c", "含逗号加引号")
    断言相等(CSV序列化([["他说\"好\""]]), "\"他说\"\"好\"\"\"", "引号翻倍")
    断言相等(CSV解析(CSV序列化([["x,y", "z\"w\""]])), [["x,y", "z\"w\""]], "复杂字段往返")
结束)

测试用例("游程编码", 函数()
    断言相等(RLE压缩(""), "", "空串")
    断言相等(RLE压缩("aabbbc"), "2a3b1c", "经典例子")
    断言相等(RLE解压("2a3b1c"), "aabbbc", "解压")
    断言相等(RLE解压(RLE压缩("aaabbbbcc")), "aaabbbbcc", "往返")
    断言相等(RLE压缩("abc"), "1a1b1c", "无重复也计数")
结束)

运行所有测试()
