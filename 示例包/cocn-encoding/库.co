# ============================================================
# cocn-encoding —— 编码套件（对标 Rust 的 base64 + hex + percent-encoding + csv）
#
# 定位：标准库 库/编码.co 提供了 Base64/Hex/URL/CSV/RLE 的基础实现，
# 但需要 导入 "库/编码" 才能用，且 CSV 解析是「按行按逗号朴素切分」，
# 不支持 RFC4180 的引号转义与字段内换行。本包补齐这些短板，
# 提供一个开箱即用、语义明确的稳定 API。
#
# 与 库/编码.co 的关系：
#   - 本包函数名与 库/编码.co 相同（Base64编码 / Hex编码 / URL编码 /
#     CSV解析 / CSV序列化 / RLE压缩 ...）。两者不冲突，因为标准库
#     **不导出** 库/编码.co 的函数，必须显式 导入 "库/编码" 才会可见；
#     而本包通过 导入 "库" 合并进来。若同时导入两者，后导入者覆盖前者。
#   - 差异：本包的 CSV 支持 RFC4180 引号转义与字段内换行；
#     Base64 多一个 URL 安全变体；URL 编码的十六进制用大写（RFC3986 惯例）。
#
# 纯 coCN 实现，无网络、无 IO。
#
# 踩坑记录（写这个包时实测确认）：
#   1) 截取 在【标准库】里是「起止下标、开区间」，在【宿主】里是「起点+长度」。
#      本包统一用【长度】语义（与 库/编码.co 一致），并在每处写明注释。
#   2) 查找 只支持 2 参；要从后往前找用 从后查找。
#   3) 长度() 对字符串返回字符数（UTF-8 码点），不是字节数。
#   4) 整数除法自动转浮点：i / 2 得 1.5，要整数除用 向下取整(i / 2)。
#   5) 列表拼接用宿主内置 连接(列表, 分隔符)；标准库不导出 连接列表。
#   6) 字典缺键返回 空（null），判空用 == 空。
#   7) 字符与码互转用宿主内置 字符码(字符) / 码转字符(码)；
#      转整数() 不能直接吃字母（会报类型错误）。
#   8) 单行「如果 条件 返回 X」的 body 会延伸到下一条语句——
#      后面紧跟另一条 return 时会被吞掉，必须写成多行 if。
#   9) 声明类型要与实际返回值一致（整数 x = 截取(...) 会报类型错误）。
# ============================================================
导入 "标准库"

# ============================================================
# Base64
# ============================================================

让 B64标准表 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
让 B64网址表 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

# Base64编码(原文) -> 字符串：标准 Base64（带 = 补齐）
函数 Base64编码(字符串 原文) -> 字符串
    返回 Base64按表编码(原文, B64标准表)
结束

# Base64网址编码(原文) -> 字符串：URL 安全 Base64（+ -> -，/ -> _）
函数 Base64网址编码(字符串 原文) -> 字符串
    返回 Base64按表编码(原文, B64网址表)
结束

# 内部：按给定字母表做 Base64 编码
函数 Base64按表编码(字符串 原文, 字符串 表) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    整数 n = 长度(字节)
    整数 i = 0
    当 i + 2 < n 循环
        整数 b0 = 字节[i]
        整数 b1 = 字节[i + 1]
        整数 b2 = 字节[i + 2]
        结果 = 结果 + 截取(表, b0 >> 2, 1)
        结果 = 结果 + 截取(表, ((b0 & 3) << 4) | (b1 >> 4), 1)
        结果 = 结果 + 截取(表, ((b1 & 15) << 2) | (b2 >> 6), 1)
        结果 = 结果 + 截取(表, b2 & 63, 1)
        i = i + 3
    结束
    如果 i < n 则
        整数 b0 = 字节[i]
        如果 i + 1 == n 则
            结果 = 结果 + 截取(表, b0 >> 2, 1)
            结果 = 结果 + 截取(表, (b0 & 3) << 4, 1)
            结果 = 结果 + "=="
        否则
            整数 b1 = 字节[i + 1]
            结果 = 结果 + 截取(表, b0 >> 2, 1)
            结果 = 结果 + 截取(表, ((b0 & 3) << 4) | (b1 >> 4), 1)
            结果 = 结果 + 截取(表, (b1 & 15) << 2, 1)
            结果 = 结果 + "="
        结束
    结束
    返回 结果
结束

# Base64解码(串) -> 字符串：解码（自动识别标准表与 URL 安全表）
# 非法字符一律跳过；无法解码出内容时返回空串
函数 Base64解码(字符串 串) -> 字符串
    列表 字节 = []
    整数 n = 长度(串)
    整数 i = 0
    当 i + 3 < n 循环
        整数 v0 = 字符值(串, i)
        整数 v1 = 字符值(串, i + 1)
        字符串 v2c = 截取(串, i + 2, 1)
        字符串 v3c = 截取(串, i + 3, 1)
        如果 v0 < 0 或 v1 < 0 则
            i = i + 4
            继续
        结束
        追加(字节, (v0 << 2) | (v1 >> 4))
        如果 v2c != "=" 则
            整数 v2 = 字符值(串, i + 2)
            如果 v2 >= 0 则
                追加(字节, ((v1 & 15) << 4) | (v2 >> 2))
                如果 v3c != "=" 则
                    整数 v3 = 字符值(串, i + 3)
                    如果 v3 >= 0 则
                        追加(字节, ((v2 & 3) << 6) | v3)
                    结束
                结束
            结束
        结束
        i = i + 4
    结束
    返回 字节转文本(字节)
结束

# 内部：取 Base64 字符的 6 位值；非法字符返回 -1
# 注意：单行「如果 … 返回 …」的 body 会延伸到下一条语句，
# 所以这里必须用多行写法把两条 return 分开，否则第二条会被吞进 if 里。
函数 字符值(字符串 串, 整数 位置) -> 整数
    字符串 c = 截取(串, 位置, 1)
    整数 p = 查找(B64标准表, c)
    如果 p >= 0 则
        返回 p
    结束
    返回 查找(B64网址表, c)
结束

# Base64是合法(串) -> 布尔：只含合法字符且长度为 4 的倍数
函数 Base64是合法(字符串 串) -> 布尔
    整数 n = 长度(串)
    如果 n == 0 返回 真
    如果 n % 4 != 0 返回 假
    对于 i 从 0 到 n - 1 循环
        字符串 c = 截取(串, i, 1)
        如果 c == "=" 则
            继续
        结束
        如果 查找(B64标准表, c) < 0 且 查找(B64网址表, c) < 0 则
            返回 假
        结束
    结束
    返回 真
结束

# ============================================================
# 十六进制
# ============================================================

# Hex编码(原文) -> 字符串：小写十六进制
函数 Hex编码(字符串 原文) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    对于 i 从 0 到 长度(字节) - 1 循环
        整数 b = 字节[i]
        结果 = 结果 + Hex位(b >> 4) + Hex位(b & 15)
    结束
    返回 结果
结束

# Hex大写编码(原文) -> 字符串：大写十六进制
函数 Hex大写编码(字符串 原文) -> 字符串
    返回 大写(Hex编码(原文))
结束

# 内部：4 位十六进制字符
函数 Hex位(整数 值) -> 字符串
    字符串 表 = "0123456789abcdef"
    返回 截取(表, 值, 1)
结束

# Hex解码(串) -> 字符串：解码十六进制（忽略大小写）
函数 Hex解码(字符串 串) -> 字符串
    列表 字节 = []
    整数 n = 长度(串)
    整数 i = 0
    当 i + 1 < n 循环
        整数 高 = 十六进制字符值(截取(串, i, 1))
        整数 低 = 十六进制字符值(截取(串, i + 1, 1))
        如果 高 < 0 或 低 < 0 则
            继续
        结束
        追加(字节, (高 << 4) | 低)
        i = i + 2
    结束
    返回 字节转文本(字节)
结束

# 十六进制字符值(c) -> 整数：字符的十六进制值（大小写皆可），非法返回 -1
# 用 字符码 做算术：转整数() 不能直接吃字母（会报类型错误）。
函数 十六进制字符值(字符串 c) -> 整数
    整数 码 = 字符码(c)
    如果 码 >= 48 且 码 <= 57 则
        返回 码 - 48
    结束
    如果 码 >= 97 且 码 <= 102 则
        返回 码 - 87
    结束
    如果 码 >= 65 且 码 <= 70 则
        返回 码 - 55
    结束
    返回 -1
结束

# ============================================================
# 百分号编码（RFC 3986）
# ============================================================

# URL编码(原文) -> 字符串：百分号编码（字母数字与 -_.~ 不转义）
# 十六进制用【大写】，符合 RFC3986 惯例（%2F 而非 %2f）。
函数 URL编码(字符串 原文) -> 字符串
    列表 字节 = 字节列表(原文)
    字符串 结果 = ""
    对于 i 从 0 到 长度(字节) - 1 循环
        整数 b = 字节[i]
        如果 是URL安全字节(b) 则
            结果 = 结果 + 码转字符(b)
        否则
            结果 = 结果 + "%" + Hex位大写(b >> 4) + Hex位大写(b & 15)
        结束
    结束
    返回 结果
结束

# 内部：大写十六进制字符
函数 Hex位大写(整数 值) -> 字符串
    字符串 表 = "0123456789ABCDEF"
    返回 截取(表, 值, 1)
结束

# URL解码(串) -> 字符串：百分号解码（+ 解为空格）
函数 URL解码(字符串 串) -> 字符串
    列表 字节 = []
    整数 n = 长度(串)
    整数 i = 0
    当 i < n 循环
        字符串 c = 截取(串, i, 1)
        如果 c == "+" 则
            追加(字节, 32)
            i = i + 1
            继续
        结束
        如果 c == "%" 且 i + 2 < n 则
            整数 高 = 十六进制字符值(截取(串, i + 1, 1))
            整数 低 = 十六进制字符值(截取(串, i + 2, 1))
            如果 高 >= 0 且 低 >= 0 则
                追加(字节, (高 << 4) | 低)
                i = i + 3
                继续
            结束
        结束
        追加(字节, 转ASCII(c))
        i = i + 1
    结束
    返回 字节转文本(字节)
结束

# 内部：字节是否属于 URL 免转义集
函数 是URL安全字节(整数 b) -> 布尔
    如果 b >= 65 且 b <= 90 则 返回 真 结束
    如果 b >= 97 且 b <= 122 则 返回 真 结束
    如果 b >= 48 且 b <= 57 则 返回 真 结束
    如果 b == 45 或 b == 46 或 b == 95 或 b == 126 则 返回 真 结束
    返回 假
结束
# ============================================================
# CSV（RFC 4180：支持引号转义、字段内逗号与换行）
# ============================================================

# CSV解析(文本) -> 列表：解析为行列表（每行是列列表）
# 支持：双引号包裹的字段、"" 转义的双引号、字段内逗号与换行
函数 CSV解析(字符串 文本) -> 列表
    返回 CSV解析为文本(文本)
结束

# CSV解析为文本(文本) -> 列表：CSV 文本 -> [[列,...],...]
函数 CSV解析为文本(字符串 文本) -> 列表
    列表 行 = []
    列表 当前行 = []
    字符串 字段 = ""
    布尔 在引号内 = 假
    整数 n = 长度(文本)
    整数 i = 0
    当 i < n 循环
        字符串 c = 截取(文本, i, 1)
        如果 在引号内 则
            如果 c == "\"" 则
                如果 i + 1 < n 且 截取(文本, i + 1, 1) == "\"" 则
                    字段 = 字段 + "\""
                    i = i + 1
                否则
                    在引号内 = 假
                结束
            否则
                字段 = 字段 + c
            结束
        否则
            如果 c == "\"" 则
                在引号内 = 真
            否则 如果 c == "," 则
                追加(当前行, 字段)
                字段 = ""
            否则 如果 c == "\n" 则
                追加(当前行, 字段)
                字段 = ""
                追加(行, 当前行)
                当前行 = []
            否则 如果 c == "\r" 则
                继续
            否则
                字段 = 字段 + c
            结束
        结束
        i = i + 1
    结束
    如果 字段 != "" 或 长度(当前行) > 0 则
        追加(当前行, 字段)
        追加(行, 当前行)
    结束
    返回 行
结束

# CSV序列化(表格) -> 字符串：[[列,...],...] -> CSV 文本
# 需要转义的字段（含逗号/引号/换行）用双引号包裹，内部引号写成两个引号
函数 CSV序列化(列表 表格) -> 字符串
    列表 行串 = []
    对于 i 从 0 到 长度(表格) - 1 循环
        列表 列 = 表格[i]
        列表 处理后 = []
        对于 j 从 0 到 长度(列) - 1 循环
            追加(处理后, CSV字段(列[j]))
        结束
        追加(行串, 连接(处理后, ","))
    结束
    返回 连接(行串, "\n")
结束

# 内部：单个字段的 CSV 转义
# RFC4180：含逗号/引号/换行的字段用双引号包裹，字段内引号写成两个引号；
# 字段内换行原样保留（解析时引号内的换行属于字段内容）。
函数 CSV字段(字符串 值) -> 字符串
    如果 非 (包含(值, ",") 或 包含(值, "\"") 或 包含(值, "\n")) 则
        返回 值
    结束
    返回 "\"" + 全替换(值, "\"", "\"\"") + "\""
结束

# 全替换(原文, 旧, 新) -> 字符串：把原文里所有「旧」换成「新」
# 标准库不导出 替换全部（那在 库/字符串.co），本包自带实现。
函数 全替换(字符串 原文, 字符串 旧, 字符串 新) -> 字符串
    如果 旧 == "" 返回 原文
    字符串 结果 = ""
    整数 i = 0
    当 i < 长度(原文) 循环
        如果 i + 长度(旧) <= 长度(原文) 且 截取(原文, i, 长度(旧)) == 旧 则
            结果 = 结果 + 新
            i = i + 长度(旧)
        否则
            结果 = 结果 + 截取(原文, i, 1)
            i = i + 1
        结束
    结束
    返回 结果
结束

# ============================================================
# 游程编码（RLE）
# ============================================================

# RLE压缩(原文) -> 字符串：游程编码（"aabbbc" -> "2a3b1c"）
函数 RLE压缩(字符串 原文) -> 字符串
    如果 长度(原文) == 0 返回 ""
    字符串 结果 = ""
    整数 计数 = 1
    字符串 当前 = 截取(原文, 0, 1)
    对于 i 从 1 到 长度(原文) - 1 循环
        字符串 c = 截取(原文, i, 1)
        如果 c == 当前 则
            计数 = 计数 + 1
        否则
            结果 = 结果 + 转字符串(计数) + 当前
            当前 = c
            计数 = 1
        结束
    结束
    返回 结果 + 转字符串(计数) + 当前
结束

# RLE解压(串) -> 字符串：游程解码
函数 RLE解压(字符串 串) -> 字符串
    字符串 结果 = ""
    整数 n = 长度(串)
    整数 i = 0
    当 i < n 循环
        字符串 数字 = ""
        当 i < n 且 截取(串, i, 1) >= "0" 且 截取(串, i, 1) <= "9" 循环
            数字 = 数字 + 截取(串, i, 1)
            i = i + 1
        结束
        如果 i >= n 则
            跳出
        结束
        字符串 c = 截取(串, i, 1)
        整数 次数 = 1
        如果 数字 != "" 则
            次数 = 转整数(数字)
        结束
        对于 k 从 0 到 次数 - 1 循环
            结果 = 结果 + c
        结束
        i = i + 1
    结束
    返回 结果
结束
