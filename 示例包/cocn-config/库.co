# ============================================================
# cocn-config —— 配置文件读写与嵌套取值（对标 Rust 的 config crate）
# 复用标准库 JSON解析/JSON序列化 与内置 读文件/写文件。
# 说明：本包自包含（直接走标准库 JSON），可无缝与 cocn-json 组合使用。
# ============================================================
导入 "标准库"

# 读配置：读文件 -> JSON解析 为 coCN 值
函数 读配置(路径)
    返回 JSON解析(读文件(路径))
结束

# 写配置：序列化 -> 写文件
函数 写配置(路径, 值)
    写文件(路径, JSON序列化(值))
结束

# 嵌套取值：取(配置, "a.b.c")，路径不可达时返回 缺省
函数 取配置(配置, 路径, 缺省)
    列表 段 = 分割(路径, ".")
    变量 当前 = 配置
    对于 i 从 0 到 长度(段) - 1 循环
        如果 类型(当前) != "字典" 或 非 包含(当前, 段[i]) 则 返回 缺省 结束
        当前 = 当前[段[i]]
    结束
    返回 当前
结束

# 深度合并：把 源 的键递归合并进 目标（源优先），返回新字典
函数 合并配置(目标, 源)
    字典 r = {}
    列表 键表 = 键(目标)
    对于 i 从 0 到 长度(键表) - 1 循环
        r[键表[i]] = 目标[键表[i]]
    结束
    列表 源键 = 键(源)
    对于 j 从 0 到 长度(源键) - 1 循环
        字符串 k = 源键[j]
        如果 类型(源[k]) == "字典" 且 类型(r[k]) == "字典" 则
            r[k] = 合并配置(r[k], 源[k])
        否则
            r[k] = 源[k]
        结束
    结束
    返回 r
结束
