# cocn-config 测试
导入 "标准库"
导入 "库"

# 临时根：优先 TMPDIR，缺省 /tmp。
让 临时根 = 环境变量("TMPDIR")
如果 临时根 == "" 或 临时根 == 空 则
    临时根 = "/tmp"
结束
字符串 配置路径 = 临时根 + "/cfg_test.json"

测试用例("读配置/写配置 往返", 函数()
    写配置(配置路径, {"name": "coCN", "port": 8080})
    字典 c = 读配置(配置路径)
    断言相等(c["name"], "coCN", "读回 name")
    断言相等(c["port"], 8080, "读回 port")
结束)

测试用例("取配置 嵌套", 函数()
    字典 c = {"db": {"host": "localhost", "port": 5432}, "debug": 真}
    断言相等(取配置(c, "db.host", ""), "localhost", "嵌套取 host")
    断言相等(取配置(c, "db.port", 0), 5432, "嵌套取 port")
    断言相等(取配置(c, "db.missing", "缺省"), "缺省", "缺失返回缺省")
    断言相等(取配置(c, "nope", 假), 假, "顶层缺失返回缺省")
结束)

测试用例("合并配置 深度", 函数()
    字典 基础 = {"a": 1, "b": {"x": 1, "y": 2}}
    字典 覆盖 = {"b": {"y": 20, "z": 3}, "c": 9}
    字典 m = 合并配置(基础, 覆盖)
    断言相等(m["a"], 1, "保留基础值")
    断言相等(m["b"]["x"], 1, "嵌套保留")
    断言相等(m["b"]["y"], 20, "嵌套被覆盖")
    断言相等(m["b"]["z"], 3, "嵌套新增")
    断言相等(m["c"], 9, "顶层新增")
结束)

运行所有测试()
