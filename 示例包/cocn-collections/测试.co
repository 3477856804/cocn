# cocn-collections 测试
导入 "标准库"
导入 "库"

函数 偶(元素) 返回 元素 % 2 == 0 结束

测试用例("集合并集", 函数()
    字典 a = 新建集合()
    字典 b = 新建集合()
    集合添加(a, 1); 集合添加(a, 2)
    集合添加(b, 2); 集合添加(b, 3)
    字典 u = 并集(a, b)
    断言相等(大小(u), 3, "并集大小3")
    断言相等(集合包含(u, 2), 真, "含2")
结束)

测试用例("集合交集", 函数()
    字典 a = 新建集合()
    字典 b = 新建集合()
    集合添加(a, 1); 集合添加(a, 2)
    集合添加(b, 2); 集合添加(b, 3)
    断言相等(集合包含(交集(a, b), 2), 真, "交集含2")
    断言相等(集合包含(交集(a, b), 1), 假, "交集不含1")
结束)

测试用例("集合运算接受列表", 函数()
    字典 u = 并集([1, 2, 3], [3, 4])
    断言相等(大小(u), 4, "列表并集大小4")
    断言相等(大小(交集([1, 2, 3], [2, 3, 4])), 2, "列表交集大小2")
    断言相等(大小(差集([1, 2, 3], [2])), 2, "列表差集大小2")
    断言相等(大小([1, 2, 3]), 3, "列表大小")
    断言相等(长度(转列表(并集([1, 2], [2, 3]))), 3, "转列表")
    断言相等(长度(并集([1, 1, 2], [2])), 2, "列表去重")
结束)

测试用例("笛卡尔积", 函数()
    列表 p = 积([1, 2], ["a", "b"])
    断言相等(长度(p), 4, "积长度4")
结束)

测试用例("分组", 函数()
    字典 g = 分组([1, 2, 3, 4], 偶)
    断言相等(集合包含(g, "真"), 真, "有偶数组")
    断言相等(长度(g["真"]), 2, "偶数2个")
    断言相等(长度(g["假"]), 2, "奇数2个")
结束)

运行所有测试()
