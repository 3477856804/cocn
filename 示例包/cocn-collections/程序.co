# cocn-collections 演示入口：cocn run 示例包/cocn-collections
导入 "标准库"
导入 "库"

输出("=== cocn-collections 演示 ===")
输出("并集: " + 转字符串(转列表(并集([1, 2, 3], [3, 4]))))
输出("交集: " + 转字符串(转列表(交集([1, 2, 3], [2, 3, 4]))))
输出("差集: " + 转字符串(转列表(差集([1, 2, 3], [2]))))
输出("大小: " + 转字符串(大小([1, 2, 3])))
输出("频次: " + 转字符串(频次统计(["a", "b", "a"])))
输出("分组: " + 转字符串(分组([1, 2, 3, 4], 函数(x) 返回 x % 2 结束)))
