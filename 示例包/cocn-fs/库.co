# ============================================================
# cocn-fs —— 文件系统工具（对标 Rust 的 std::fs + walkdir 常用部分）
#
# 底层复用内置：读文件/写文件/追加文件/删除文件/文件存在/创建目录/
# 列出目录/重命名/文件大小/文件修改时间/执行命令/退出码。
# 复用标准库：路径拼接/文件名/扩展名/目录名/冒泡排序/连接。
#
# 设计原则（重要，踩过的坑）：
#   1) 宿主级错误（如 读文件 一个不存在的路径）会直接终止进程，
#      「尝试/捕获」拦不住。因此本包所有函数都坚持「先检查、后操作」，
#      失败时返回 空/假/[] 等可预期值，绝不把宿主错误抛给调用方。
#   2) 内置 目录存在 不可靠：它内部是 执行命令("ls -d 路径")，
#      而 执行命令 会把 stderr 合并进返回值，导致不存在的路径也判真。
#      本包用 执行命令("test -d '路径'") + 退出码()==0 做目录判定——
#      test 不产生任何输出，退出码不受 stderr 污染影响（实测可靠）。
#   3) 文件存在 走宿主实现，可靠；删除文件 对非空目录会失败但不崩溃。
# ============================================================
导入 "标准库"

# ---------- 判定层 ----------

# 是目录(路径)：可靠判定（test -d + 退出码）
函数 是目录(路径)
    执行命令("test -d '" + 路径 + "'")
    返回 退出码() == 0
结束

# 是文件(路径)：存在且不是目录
函数 是文件(路径)
    如果 文件存在(路径) == 0 则
        返回 假
    结束
    返回 是目录(路径) == 假
结束

# 排序(表)：字符串列表字典序排序（包内自包含：标准库 冒泡排序 曾用
# `整数 临时` 交换元素，对字符串列表会报类型错误；此处不依赖它）
函数 排序(表)
    列表 结果 = 切片(表, 0, 长度(表))
    整数 n = 长度(结果)
    整数 i = 0
    当 i < n - 1 循环
        整数 j = 0
        当 j < n - i - 1 循环
            如果 结果[j] > 结果[j + 1] 则
                让 临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
            结束
            j = j + 1
        结束
        i = i + 1
    结束
    返回 结果
结束

# ---------- 读 ----------

# 读文本(路径)：文件不存在时返回 空
函数 读文本(路径)
    如果 是文件(路径) == 假 则
        返回 空
    结束
    返回 读文件(路径)
结束

# 行读取(路径)：按行读取，不存在返回 []（空列表）
函数 行读取(路径)
    如果 是文件(路径) == 假 则
        返回 []
    结束
    返回 读取行(路径)
结束

# ---------- 写 ----------

# 确保父目录(路径)：为 路径 创建父目录（递归、幂等），返回是否就绪
函数 确保父目录(路径)
    字符串 父 = 目录名(路径)
    如果 父 == "" 或 父 == "." 或 父 == "/" 则
        返回 真
    结束
    如果 是目录(父) == 假 则
        创建目录(父)
    结束
    返回 是目录(父)
结束

# 写文本(路径, 内容)：自动确保父目录后写入，返回是否成功
函数 写文本(路径, 内容)
    如果 确保父目录(路径) == 假 则
        返回 假
    结束
    写文件(路径, 内容)
    返回 是文件(路径)
结束

# 追加文本(路径, 内容)：文件不存在则先创建，返回是否成功
函数 追加文本(路径, 内容)
    如果 是文件(路径) == 假 则
        返回 写文本(路径, 内容)
    结束
    追加文件(路径, 内容)
    返回 真
结束

# 行写入(路径, 行列表)：每行一条写入（行间补换行、末行不补），返回是否成功
函数 行写入(路径, 行列表)
    字符串 文本 = ""
    整数 i = 0
    当 i < 长度(行列表) 循环
        文本 = 文本 + 行列表[i]
        如果 i < 长度(行列表) - 1 则
            文本 = 文本 + "\n"
        结束
        i = i + 1
    结束
    返回 写文本(路径, 文本)
结束

# ---------- 目录 ----------

# 确保目录(路径)：不存在则创建（递归），返回是否就绪
函数 确保目录(路径)
    如果 是目录(路径) 则
        返回 真
    结束
    创建目录(路径)
    返回 是目录(路径)
结束

# 递归列出(目录)：递归收集所有条目；目录带 "/" 后缀，按名字排序
# 注意：coCN 没有默认参数，公开入口只收 1 参，递归细节走私有函数。
函数 递归列出(目录)
    返回 递归列出从(目录, "")
结束

# 递归列出从(目录, 前缀)：带相对前缀的递归实现
函数 递归列出从(目录, 前缀)
    如果 是目录(目录) == 假 则
        返回 []
    结束
    列表 结果 = []
    列表 项列表 = 列出目录(目录)
    # 先排序保证跨平台输出稳定（列出目录 的顺序由文件系统决定）
    项列表 = 排序(项列表)
    整数 i = 0
    当 i < 长度(项列表) 循环
        字符串 项 = 项列表[i]
        字符串 全路径 = 路径拼接([目录, 项])
        字符串 显示 = 前缀 + 项
        如果 是目录(全路径) 则
            追加(结果, 显示 + "/")
            列表 子 = 递归列出从(全路径, 显示 + "/")
            整数 j = 0
            当 j < 长度(子) 循环
                追加(结果, 子[j])
                j = j + 1
            结束
        否则
            追加(结果, 显示)
        结束
        i = i + 1
    结束
    返回 结果
结束

# 仅文件(目录)：只递归收集文件（不含目录条目）
函数 仅文件(目录)
    列表 全部 = 递归列出(目录)
    列表 结果 = []
    整数 i = 0
    当 i < 长度(全部) 循环
        字符串 项 = 全部[i]
        如果 长度(项) > 0 且 截取(项, 长度(项) - 1, 1) != "/" 则
            追加(结果, 项)
        结束
        i = i + 1
    结束
    返回 结果
结束

# 找文件(目录, 后缀)：按后缀过滤（可带点也可不带点，如 "co" 或 ".co"）
# 注意：参数名不能用 扩展名——那是标准库函数名，会把它遮蔽掉。
函数 找文件(目录, 后缀)
    如果 长度(后缀) > 0 且 截取(后缀, 0, 1) != "." 则
        后缀 = "." + 后缀
    结束
    列表 文件列表 = 仅文件(目录)
    列表 结果 = []
    整数 i = 0
    当 i < 长度(文件列表) 循环
        # 统一小写比较，.CO 与 .co 视为同名（Windows 习惯）
        字符串 实际 = 小写(扩展名(文件列表[i]))
        字符串 目标 = 小写(后缀)
        如果 实际 == 目标 则
            追加(结果, 文件列表[i])
        结束
        i = i + 1
    结束
    返回 结果
结束

# 目录树(目录)：生成多行文本树（目录带 / 后缀，树形缩进）
函数 目录树(目录)
    如果 是目录(目录) == 假 则
        返回 ""
    结束
    列表 行 = []
    列表 全部 = 递归列出(目录)
    整数 i = 0
    当 i < 长度(全部) 循环
        字符串 项 = 全部[i]
        # 用 "/" 的个数换算缩进深度
        整数 深度 = 0
        整数 j = 0
        当 j < 长度(项) 循环
            如果 截取(项, j, 1) == "/" 则
                深度 = 深度 + 1
            结束
            j = j + 1
        结束
        字符串 缩进 = ""
        整数 k = 0
        当 k < 深度 循环
            缩进 = 缩进 + "  "
            k = k + 1
        结束
        追加(行, 缩进 + 文件名(项))
        i = i + 1
    结束
    返回 连接(行, "\n")
结束

# ---------- 复制 / 移动 / 删除 ----------

# 复制(源, 目标)：文件复制（自动建父目录），返回是否成功
函数 复制(源, 目标)
    如果 是文件(源) == 假 则
        返回 假
    结束
    如果 确保父目录(目标) == 假 则
        返回 假
    结束
    写文件(目标, 读文件(源))
    返回 是文件(目标)
结束

# 移动(源, 目标)：优先重命名（同设备快路径），失败回退复制+删除
函数 移动(源, 目标)
    如果 是文件(源) == 假 则
        返回 假
    结束
    如果 确保父目录(目标) == 假 则
        返回 假
    结束
    如果 重命名(源, 目标) == 0 则
        返回 真
    结束
    # 跨设备：复制后删源
    如果 复制(源, 目标) == 假 则
        返回 假
    结束
    删除文件(源)
    返回 是文件(源) == 假
结束

# 删除(路径)：删除文件或空目录，返回是否成功
函数 删除(路径)
    如果 是文件(路径) 则
        删除文件(路径)
        返回 是文件(路径) == 假
    结束
    如果 是目录(路径) 则
        删除文件(路径)
        返回 是目录(路径) == 假
    结束
    返回 假
结束

# ---------- 信息 ----------

# 信息(路径)：汇总字典 {路径, 名字, 扩展名, 存在, 是目录, 大小, 修改时间}
函数 信息(路径)
    字典 d = {}
    d["路径"] = 路径
    d["名字"] = 文件名(路径)
    d["扩展名"] = 扩展名(路径)
    d["存在"] = 是文件(路径)
    如果 d["存在"] 则
        d["是目录"] = 假
        d["大小"] = 文件大小(路径)
        d["修改时间"] = 文件修改时间(路径)
    否则
        d["是目录"] = 是目录(路径)
        d["大小"] = 0
        d["修改时间"] = 0
    结束
    返回 d
结束

# 可读大小(字节数)：把字节数格式化为 "1.5 KB" 形式（1024 进制）
函数 可读大小(字节数)
    列表 单位 = ["B", "KB", "MB", "GB", "TB"]
    浮点 v = 字节数
    整数 i = 0
    当 v >= 1024 且 i < 长度(单位) - 1 循环
        v = v / 1024
        i = i + 1
    结束
    如果 i == 0 则
        返回 转字符串(转整数(v)) + " " + 单位[i]
    结束
    # 保留一位小数：乘10四舍五入再除10（整数除法自动转浮点，15/10=1.5）
    整数 舍入 = 向下取整(v * 10 + 0.5)
    返回 转字符串(舍入 / 10) + " " + 单位[i]
结束

# 临时目录()：优先 TMPDIR（Android/Termux 的 /tmp 通常不可写），否则 /tmp
函数 临时目录()
    让 t = 环境变量("TMPDIR")
    如果 t == "" 或 t == 空 则
        返回 "/tmp"
    结束
    返回 t
结束

# 临时文件(前缀)：基于时钟与随机数生成唯一临时路径（不创建文件）
# 注意：空串要用 长度()==0 判断——`空` 是 null，与 "" 不相等。
函数 临时文件(前缀)
    如果 长度(前缀) == 0 则
        前缀 = "cocn"
    结束
    # 时钟毫秒 是整数，随机整数 保证同一毫秒内也不重复
    字符串 名 = 前缀 + "-" + 转字符串(时钟毫秒()) + "-" + 转字符串(随机整数(100000, 999999))
    返回 路径拼接([临时目录(), 名])
结束
