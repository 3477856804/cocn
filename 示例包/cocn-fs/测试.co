# cocn-fs 测试
# 测试根优先 TMPDIR（缺省 /tmp），测试末尾自行清理。
导入 "标准库"
导入 "库"

# 临时根：优先 TMPDIR，缺省 /tmp。测试全部基于此根，便于在 Termux/Android 上运行。
让 临时根 = 环境变量("TMPDIR")
如果 临时根 == "" 或 临时根 == 空 则
    临时根 = "/tmp"
结束
字符串 测试根 = 临时根 + "/cocn-fs-test"

函数 清理()
    # 删除 对非空目录无效：先删所有文件，再按深度倒序删目录
    列表 文件列表 = 仅文件(测试根)
    整数 i = 0
    当 i < 长度(文件列表) 循环
        删除(路径拼接([测试根, 文件列表[i]]))
        i = i + 1
    结束
    列表 全部 = 递归列出(测试根)
    i = 长度(全部) - 1
    当 i >= 0 循环
        字符串 项 = 全部[i]
        如果 截取(项, 长度(项) - 1, 1) == "/" 则
            删除(路径拼接([测试根, 项]))
        结束
        i = i - 1
    结束
    删除(测试根)
结束

函数 备料()
    清理()
    确保目录(测试根)
结束

测试用例("是目录 与 是文件 判定", 函数()
    备料()
    写文本(测试根 + "/f.txt", "f")
    确保目录(测试根 + "/d")
    断言相等(是目录(测试根 + "/d"), 真, "目录判定为真")
    断言相等(是文件(测试根 + "/f.txt"), 真, "文件判定为真")
    断言相等(是目录(测试根 + "/f.txt"), 假, "文件不是目录")
    断言相等(是文件(测试根 + "/d"), 假, "目录不是文件")
    断言相等(是目录(测试根 + "/无"), 假, "不存在判定为假")
    断言相等(是文件(测试根 + "/无"), 假, "不存在判定为假")
结束)

测试用例("写文本 与 读文本 往返", 函数()
    备料()
    断言相等(写文本(测试根 + "/a.txt", "你好"), 真, "写入成功")
    断言相等(读文本(测试根 + "/a.txt"), "你好", "读回一致")
结束)

测试用例("读文本 不存在返回空", 函数()
    备料()
    断言相等(读文本(测试根 + "/无.txt"), 空, "不存在返回空")
    断言相等(行读取(测试根 + "/无.txt"), [], "行读取不存在返回空列表")
结束)

测试用例("写文本 自动创建父目录", 函数()
    备料()
    断言相等(写文本(测试根 + "/甲/乙/c.txt", "深"), 真, "深层写入成功")
    断言相等(读文本(测试根 + "/甲/乙/c.txt"), "深", "深层读回一致")
结束)

测试用例("行写入 与 行读取 往返", 函数()
    备料()
    断言相等(行写入(测试根 + "/lines.txt", ["一", "二", "三"]), 真, "行写入成功")
    断言相等(行读取(测试根 + "/lines.txt"), ["一", "二", "三"], "行读回一致")
结束)

测试用例("追加文本", 函数()
    备料()
    写文本(测试根 + "/app.txt", "甲")
    断言相等(追加文本(测试根 + "/app.txt", "乙"), 真, "追加成功")
    断言相等(读文本(测试根 + "/app.txt"), "甲乙", "内容拼接")
    追加文本(测试根 + "/new.txt", "新")
    断言相等(读文本(测试根 + "/new.txt"), "新", "不存在则创建")
结束)

测试用例("确保目录 递归幂等", 函数()
    备料()
    断言相等(确保目录(测试根 + "/子/深"), 真, "递归创建")
    断言相等(确保目录(测试根 + "/子/深"), 真, "重复创建仍成功")
结束)

测试用例("递归列出 目录带斜杠后缀", 函数()
    备料()
    写文本(测试根 + "/b.co", "b")
    写文本(测试根 + "/a.co", "a")
    写文本(测试根 + "/子/d.co", "d")
    断言相等(递归列出(测试根), ["a.co", "b.co", "子/", "子/d.co"], "按名字排序、目录带后缀")
    断言相等(递归列出(测试根 + "/不存在"), [], "不存在目录返回空列表")
结束)

测试用例("仅文件 与 找文件", 函数()
    备料()
    写文本(测试根 + "/x.co", "x")
    写文本(测试根 + "/y.md", "y")
    写文本(测试根 + "/子/z.co", "z")
    断言相等(仅文件(测试根), ["x.co", "y.md", "子/z.co"], "递归只含文件")
    断言相等(找文件(测试根, "co"), ["x.co", "子/z.co"], "扩展名不带点也能匹配")
    断言相等(找文件(测试根, ".md"), ["y.md"], "扩展名带点同样匹配")
    断言相等(找文件(测试根, "rs"), [], "无匹配返回空")
结束)

测试用例("目录树 树形缩进", 函数()
    备料()
    写文本(测试根 + "/顶.co", "t")
    写文本(测试根 + "/子/nested.co", "n")
    断言相等(目录树(测试根), "  子\n  nested.co\n顶.co", "按字典序两级缩进")
    断言相等(目录树(测试根 + "/不存在"), "", "不存在目录返回空串")
结束)

测试用例("复制 与 移动", 函数()
    备料()
    写文本(测试根 + "/src.txt", "内容")
    断言相等(复制(测试根 + "/src.txt", 测试根 + "/目标/copy.txt"), 真, "复制并建父目录")
    断言相等(读文本(测试根 + "/目标/copy.txt"), "内容", "复制内容一致")
    断言相等(复制(测试根 + "/无.txt", 测试根 + "/x.txt"), 假, "源不存在返回假")
    断言相等(移动(测试根 + "/src.txt", 测试根 + "/moved.txt"), 真, "移动成功")
    断言相等(读文本(测试根 + "/moved.txt"), "内容", "移动后内容保留")
    断言相等(是文件(测试根 + "/src.txt"), 假, "移动后源已不存在")
结束)

测试用例("删除 文件与空目录", 函数()
    备料()
    写文本(测试根 + "/del.txt", "d")
    确保目录(测试根 + "/空目录")
    断言相等(删除(测试根 + "/del.txt"), 真, "删文件")
    断言相等(删除(测试根 + "/空目录"), 真, "删空目录")
    断言相等(删除(测试根 + "/无.txt"), 假, "删不存在返回假")
结束)

测试用例("信息 汇总字典", 函数()
    备料()
    写文本(测试根 + "/i.co", "12345")
    字典 d = 信息(测试根 + "/i.co")
    断言相等(d["名字"], "i.co", "名字")
    断言相等(d["扩展名"], ".co", "扩展名含点")
    断言相等(d["存在"], 真, "存在为真")
    断言相等(d["是目录"], 假, "不是目录")
    断言相等(d["大小"], 5, "大小 5 字节")
    断言相等(d["修改时间"] > 0, 真, "修改时间为正")
    字典 d2 = 信息(测试根 + "/无.co")
    断言相等(d2["存在"], 假, "不存在路径存在为假")
    断言相等(d2["是目录"], 假, "不存在路径不是目录")
结束)

测试用例("可读大小 1024 进制", 函数()
    断言相等(可读大小(512), "512 B", "字节原样")
    断言相等(可读大小(1024), "1 KB", "整 KB")
    断言相等(可读大小(1536), "1.5 KB", "一位小数")
    断言相等(可读大小(1048576), "1 MB", "整 MB")
结束)

测试用例("临时文件 前缀唯一", 函数()
    字符串 p1 = 临时文件("demo")
    字符串 p2 = 临时文件("demo")
    断言相等(开头是(p1, 临时根 + "/demo"), 真, "位于临时目录且带前缀")
    断言相等(p1 == p2, 假, "两次生成不相同")
    断言相等(开头是(临时文件(""), 临时根 + "/cocn-"), 真, "空前缀用默认 cocn")
结束)

清理()
运行所有测试()
清理()
