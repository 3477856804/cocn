导入 "库"

输出("=== cocn-chinese 演示 ===")
输出("金额 123456 分 = " + 金额大写分(123456))
输出("金额 100000 分 = " + 金额大写分(100000))
输出("序号 12 = " + 中文序号(12))
输出("数字 2024 = " + 数字转汉字(2024))
输出("读回 = " + 转字符串(汉字转数字("二千零二十四")))
输出("全角转半角 = " + 全角转半角("ｃｏＣＮ ０.０.２"))
输出("标点 = " + 中文标点转英文("你好，世界！"))
让 句 = 切句("第一句。第二句！第三句？")
输出("句子数 = " + 转字符串(长度(句)))
对于 i 从 0 到 长度(句) - 1 循环
    输出("  " + 中文序号(i + 1) + "：" + 句[i])
结束
