测试用例("金额大写分", 函数()
    断言相等(金额大写分(123456), "壹仟贰佰叁拾肆元伍角陆分")
    断言相等(金额大写分(100000), "壹仟元整")
    断言相等(金额大写分(0), "零元整")
    断言相等(金额大写分(-500), "负伍元整")
结束)

测试用例("中文序号", 函数()
    断言相等(中文序号(1), "第一")
    断言相等(中文序号(12), "第十二")
结束)

测试用例("切句", 函数()
    断言相等(长度(切句("第一句。第二句！第三句？")), 3)
    断言相等(切句("只有一句")[0], "只有一句")
结束)

