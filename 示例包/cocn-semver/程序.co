# cocn-semver 演示入口：cocn run 示例包/cocn-semver
导入 "标准库"
导入 "库"

输出("=== cocn-semver 演示 ===")
输出("解析: " + 转字符串(解析版本("1.2.3-alpha.1")))
输出("是有效版本: " + 转字符串(是有效版本("1.2.3")))
输出("主版本: " + 转字符串(取主版本("2.3.4")))
输出("比较: " + 转字符串(比较版本("1.2.3", "1.10.0")))
输出("满足插入符: " + 转字符串(满足插入符("1.2.3", "^1.2.0")))
输出("满足波浪号: " + 转字符串(满足波浪号("1.2.3", "~1.2.0")))
