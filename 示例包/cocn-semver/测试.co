# cocn-semver 测试：SemVer 2.0.0 已知规则 + Cargo 风格范围
导入 "标准库"
导入 "库"

测试用例("解析完整版本", 函数()
    字典 v = 解析版本("v1.2.3-beta.1+build.5")
    断言相等(v["主"], 1, "主")
    断言相等(v["次"], 2, "次")
    断言相等(v["修订"], 3, "修订")
    断言相等(v["预发布"], "beta.1", "预发布")
    断言相等(v["构建"], "build.5", "构建")
    断言相等(v["有效"], 1, "有效")
结束)

测试用例("解析缺省段与非法版本", 函数()
    字典 a = 解析版本("1.2")
    断言相等(a["主"], 1, "主")
    断言相等(a["次"], 2, "次")
    断言相等(a["修订"], 0, "缺省修订")
    断言相等(是有效版本("1.2"), 真, "两段合法")
    断言相等(是有效版本("1.2.3.4"), 假, "四段非法")
    断言相等(是有效版本("1.a.3"), 假, "非数字段非法")
结束)

测试用例("取字段与规范化", 函数()
    断言相等(取主版本("3.4.5"), 3, "主版本")
    断言相等(取次版本("3.4.5"), 4, "次版本")
    断言相等(取修订("3.4.5"), 5, "修订")
    断言相等(是预发布("1.0.0-rc.1"), 真, "有预发布")
    断言相等(是预发布("1.0.0"), 假, "无预发布")
    断言相等(规范化版本("v1.2"), "1.2.0", "补全三段")
    断言相等(规范化版本("1.2.3-rc.1+build"), "1.2.3-rc.1+build", "保留后缀")
结束)

测试用例("数值段比较", 函数()
    断言相等(版本比较("1.2.3", "1.2.4"), -1, "修订")
    断言相等(版本比较("1.2.3", "1.3.0"), -1, "次")
    断言相等(版本比较("2.0.0", "1.9.9"), 1, "主")
    断言相等(版本比较("1.2.3", "1.2.3"), 0, "相等")
    断言相等(版本大于("2.0.0", "1.9.9"), 真, "大于")
    断言相等(版本小于("1.0.0", "1.0.1"), 真, "小于")
    断言相等(版本等于("1.0.0+a", "1.0.0+b"), 真, "构建元数据不参与比较")
结束)

测试用例("预发布比较规则", 函数()
    断言相等(版本比较("1.0.0-alpha", "1.0.0"), -1, "预发布小于正式版")
    断言相等(版本比较("1.0.0-alpha", "1.0.0-alpha.1"), -1, "段少者更小")
    断言相等(版本比较("1.0.0-alpha.1", "1.0.0-alpha.beta"), -1, "数字小于字母")
    断言相等(版本比较("1.0.0-beta.2", "1.0.0-beta.11"), -1, "数字段按数值")
    断言相等(版本比较("1.0.0-beta.11", "1.0.0-rc.1"), -1, "字母字典序")
结束)

测试用例("插入符范围", 函数()
    断言相等(满足范围("1.2.3", "^1.2.3"), 真, "下界包含")
    断言相等(满足范围("1.9.9", "^1.2.3"), 真, "同主版本")
    断言相等(满足范围("1.2.2", "^1.2.3"), 假, "低于下界")
    断言相等(满足范围("2.0.0", "^1.2.3"), 假, "主版本变化")
    断言相等(满足范围("0.2.9", "^0.2.3"), 真, "0.x 同次")
    断言相等(满足范围("0.3.0", "^0.2.3"), 假, "0.x 次版本变化")
    断言相等(满足范围("0.0.3", "^0.0.3"), 真, "0.0.x 精确")
    断言相等(满足范围("0.0.4", "^0.0.3"), 假, "0.0.x 修订变化")
结束)

测试用例("波浪号范围", 函数()
    断言相等(满足范围("1.2.9", "~1.2.3"), 真, "同次版本")
    断言相等(满足范围("1.3.0", "~1.2.3"), 假, "次版本变化")
    断言相等(满足范围("1.9.9", "~1"), 真, "只写主版本")
    断言相等(满足范围("2.0.0", "~1"), 假, "主版本变化")
    断言相等(满足范围("0.2.9", "~0.2.3"), 真, "0.x 同次")
    断言相等(满足范围("0.3.0", "~0.2.3"), 假, "0.x 次版本变化")
结束)

测试用例("通配符与裸版本", 函数()
    断言相等(满足范围("1.9.9", "1.x"), 真, "1.x")
    断言相等(满足范围("2.0.0", "1.x"), 假, "1.x 不匹配 2")
    断言相等(满足范围("1.2.9", "1.2.x"), 真, "1.2.x")
    断言相等(满足范围("1.3.0", "1.2.x"), 假, "1.2.x 不匹配 1.3")
    断言相等(满足范围("9.9.9", "*"), 真, "* 匹配任意")
    断言相等(满足范围("1.2.9", "1.2"), 真, "裸 1.2 视作 1.2.x")
    断言相等(满足范围("1.3.0", "1.2"), 假, "裸 1.2 不匹配 1.3")
结束)

测试用例("比较符与 AND", 函数()
    断言相等(满足范围("1.5.0", ">=1.0.0 <2.0.0"), 真, "区间内")
    断言相等(满足范围("2.0.0", ">=1.0.0 <2.0.0"), 假, "上界排除")
    断言相等(满足范围("1.0.1", ">1.0.0"), 真, "严格大于")
    断言相等(满足范围("1.0.0", ">1.0.0"), 假, "不满足严格大于")
    断言相等(满足范围("1.0.0", "<=1.0.0"), 真, "小于等于")
    断言相等(满足范围("1.0.1", "<=1.0.0"), 假, "超过上界")
    断言相等(满足范围("1.2.3", "=1.2.3"), 真, "精确等于")
结束)

测试用例("OR 并集", 函数()
    字符串 范围 = "^1.0.0 || ^2.0.0"
    断言相等(满足范围("1.5.0", 范围), 真, "第一分支")
    断言相等(满足范围("2.3.4", 范围), 真, "第二分支")
    断言相等(满足范围("3.0.0", 范围), 假, "都不匹配")
结束)

测试用例("预发布参与范围", 函数()
    断言相等(满足范围("1.0.0-alpha", "^1.0.0"), 假, "低于正式版下界")
    断言相等(满足范围("1.0.0-beta", "^1.0.0-alpha"), 真, "预发布区间内")
结束)

测试用例("排序与最值", 函数()
    列表 原始 = ["1.10.0", "1.2.0", "2.0.0-beta", "1.2.0-alpha"]
    列表 排序后 = 排序版本(原始)
    断言相等(排序后[0], "1.2.0-alpha", "最小")
    断言相等(排序后[1], "1.2.0", "次小")
    断言相等(排序后[2], "1.10.0", "1.10 > 1.2")
    断言相等(排序后[3], "2.0.0-beta", "预发布 2.0 仍大于 1.10")
    断言相等(最新版本(原始), "2.0.0-beta", "最新")
    断言相等(最旧版本(原始), "1.2.0-alpha", "最旧")
结束)

运行所有测试()
