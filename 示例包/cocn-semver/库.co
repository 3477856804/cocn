# ============================================================
# cocn-semver —— 语义化版本（SemVer 2.0.0）
#
# 对标 Rust 生态的 semver crate / Cargo 版本约束，提供：
#   - 解析：主.次.修订[-预发布][+构建]
#   - 比较：数字段按数值，预发布按 SemVer 规则
#   - 范围：^ 插入符 / ~ 波浪号 / 通配符 / >= <= > < = / 空格 AND / || OR
#
# 坑位记录：
#   1) 参数名不能与类型关键字同名，列表参数统一叫 版本列表。
#   2) 分割("   ") 会产生空串，遍历范围条件时必须跳过空串。
#   3) 交换/临时变量不要写类型标注，避免字符串被误声明成整数。
#   4) 本包不实现 npm 的预发布豁免：预发布版本按普通版本参与比较。
# ============================================================
导入 "标准库"

# ---------------- 字符串小工具 ----------------

# 是数字串(s)：全部字符都是 0-9 且非空
函数 是数字串(字符串 s)
    如果 长度(s) == 0 则
        返回 假
    结束
    对于 i 从 0 到 长度(s) - 1 循环
        字符串 c = 截取(s, i, 1)
        如果 c < "0" 或 c > "9" 则
            返回 假
        结束
    结束
    返回 真
结束

# 去前导v(s)：允许 "v1.2.3" 写法
函数 去前导v(字符串 s)
    如果 长度(s) > 0 且 截取(s, 0, 1) == "v" 则
        返回 截取(s, 1, 长度(s) - 1)
    结束
    返回 s
结束

# 组件数(s)："." 分隔的段数（用于 ~ 的边界判断）
函数 组件数(字符串 s)
    返回 长度(分割(去前导v(s), "."))
结束

# ---------------- 解析 ----------------

# 解析版本(文本) -> 字典：{主, 次, 修订, 预发布, 构建, 原文, 有效}
# 允许 1~3 段整数（缺省补 0），允许 v 前缀与 -预发布/+构建。
函数 解析版本(字符串 文本)
    字符串 原 = 去前导v(去空白(文本))
    字符串 构建 = ""
    字符串 预发布 = ""
    整数 加 = 查找(原, "+")
    如果 加 >= 0 则
        构建 = 截取(原, 加 + 1, 长度(原) - 加 - 1)
        原 = 截取(原, 0, 加)
    结束
    整数 减 = 查找(原, "-")
    如果 减 >= 0 则
        预发布 = 截取(原, 减 + 1, 长度(原) - 减 - 1)
        原 = 截取(原, 0, 减)
    结束
    列表 段 = 分割(原, ".")
    整数 有效 = 1
    如果 长度(段) < 1 或 长度(段) > 3 则
        有效 = 0
    结束
    整数 主 = 0
    整数 次 = 0
    整数 修订 = 0
    如果 长度(段) >= 1 则
        如果 是数字串(段[0]) 则
            主 = 转整数(段[0])
        否则
            有效 = 0
        结束
    结束
    如果 长度(段) >= 2 则
        如果 是数字串(段[1]) 则
            次 = 转整数(段[1])
        否则
            有效 = 0
        结束
    结束
    如果 长度(段) >= 3 则
        如果 是数字串(段[2]) 则
            修订 = 转整数(段[2])
        否则
            有效 = 0
        结束
    结束
    返回 {"主": 主, "次": 次, "修订": 修订, "预发布": 预发布, "构建": 构建, "原文": 文本, "有效": 有效}
结束

# 是有效版本(文本) -> 布尔
函数 是有效版本(字符串 文本)
    返回 解析版本(文本)["有效"] == 1
结束

# 取主版本(文本) -> 整数
函数 取主版本(字符串 文本)
    返回 解析版本(文本)["主"]
结束

# 取次版本(文本) -> 整数
函数 取次版本(字符串 文本)
    返回 解析版本(文本)["次"]
结束

# 取修订(文本) -> 整数
函数 取修订(字符串 文本)
    返回 解析版本(文本)["修订"]
结束

# 是预发布(文本) -> 布尔
函数 是预发布(字符串 文本)
    返回 解析版本(文本)["预发布"] != ""
结束

# 规范化版本(文本) -> 字符串：补全三段并保留预发布/构建
函数 规范化版本(字符串 文本)
    字典 v = 解析版本(文本)
    字符串 结果 = 转字符串(v["主"]) + "." + 转字符串(v["次"]) + "." + 转字符串(v["修订"])
    如果 v["预发布"] != "" 则
        结果 = 结果 + "-" + v["预发布"]
    结束
    如果 v["构建"] != "" 则
        结果 = 结果 + "+" + v["构建"]
    结束
    返回 结果
结束

# ---------------- 比较 ----------------

# 比较预发布(a, b) -> 整数：空 > 非空；数字段按数值；数字 < 字母；段多者更大
函数 比较预发布(字符串 甲, 字符串 乙)
    如果 甲 == 乙 则
        返回 0
    结束
    如果 甲 == "" 则
        返回 1
    结束
    如果 乙 == "" 则
        返回 -1
    结束
    列表 甲段 = 分割(甲, ".")
    列表 乙段 = 分割(乙, ".")
    整数 n = 长度(甲段)
    如果 长度(乙段) < n 则
        n = 长度(乙段)
    结束
    对于 i 从 0 到 n - 1 循环
        字符串 x = 甲段[i]
        字符串 y = 乙段[i]
        如果 x == y 则
            继续
        结束
        整数 x数 = 0
        整数 y数 = 0
        如果 是数字串(x) 则 x数 = 1 结束
        如果 是数字串(y) 则 y数 = 1 结束
        如果 x数 == 1 且 y数 == 1 则
            如果 转整数(x) < 转整数(y) 则 返回 -1 结束
            返回 1
        结束
        如果 x数 == 1 且 y数 == 0 则
            返回 -1
        结束
        如果 x数 == 0 且 y数 == 1 则
            返回 1
        结束
        如果 x < y 则 返回 -1 结束
        返回 1
    结束
    如果 长度(甲段) < 长度(乙段) 则 返回 -1 结束
    如果 长度(甲段) > 长度(乙段) 则 返回 1 结束
    返回 0
结束

# 比较版本对象(字典 甲, 字典 乙) -> 整数
函数 比较版本对象(字典 甲, 字典 乙)
    如果 甲["主"] < 乙["主"] 则 返回 -1 结束
    如果 甲["主"] > 乙["主"] 则 返回 1 结束
    如果 甲["次"] < 乙["次"] 则 返回 -1 结束
    如果 甲["次"] > 乙["次"] 则 返回 1 结束
    如果 甲["修订"] < 乙["修订"] 则 返回 -1 结束
    如果 甲["修订"] > 乙["修订"] 则 返回 1 结束
    返回 比较预发布(甲["预发布"], 乙["预发布"])
结束

# 版本比较(甲, 乙) -> 整数：甲<乙 返回 -1，相等 0，甲>乙 返回 1
函数 版本比较(字符串 甲, 字符串 乙)
    返回 比较版本对象(解析版本(甲), 解析版本(乙))
结束

# 版本大于 / 版本小于 / 版本等于
函数 版本大于(字符串 甲, 字符串 乙)
    返回 版本比较(甲, 乙) > 0
结束
函数 版本小于(字符串 甲, 字符串 乙)
    返回 版本比较(甲, 乙) < 0
结束
函数 版本等于(字符串 甲, 字符串 乙)
    返回 版本比较(甲, 乙) == 0
结束

# 排序版本(版本列表) -> 列表：升序（包内插入排序，不依赖标准库排序）
函数 排序版本(列表 版本列表)
    列表 结果 = []
    对于 i 从 0 到 长度(版本列表) - 1 循环
        追加(结果, 版本列表[i])
    结束
    对于 i 从 1 到 长度(结果) - 1 循环
        让 当前 = 结果[i]
        整数 j = i - 1
        当 j >= 0 且 版本比较(结果[j], 当前) > 0 循环
            结果[j + 1] = 结果[j]
            j = j - 1
        结束
        结果[j + 1] = 当前
    结束
    返回 结果
结束

# 最新版本(版本列表) / 最旧版本(版本列表)
函数 最新版本(列表 版本列表)
    列表 排序后 = 排序版本(版本列表)
    返回 排序后[长度(排序后) - 1]
结束
函数 最旧版本(列表 版本列表)
    列表 排序后 = 排序版本(版本列表)
    返回 排序后[0]
结束

# ---------------- 范围匹配 ----------------

# 满足插入符(v, 基准)：^ 语义（Cargo）
函数 满足插入符(字典 v, 字符串 基准)
    字典 基 = 解析版本(基准)
    如果 比较版本对象(v, 基) < 0 则
        返回 假
    结束
    如果 基["主"] > 0 则
        返回 v["主"] == 基["主"]
    结束
    如果 基["次"] > 0 则
        返回 v["主"] == 0 且 v["次"] == 基["次"]
    结束
    返回 v["主"] == 0 且 v["次"] == 0 且 v["修订"] == 基["修订"]
结束

# 满足波浪号(v, 基准)：~ 语义（Cargo）
函数 满足波浪号(字典 v, 字符串 基准)
    字典 基 = 解析版本(基准)
    如果 比较版本对象(v, 基) < 0 则
        返回 假
    结束
    如果 组件数(基准) <= 1 则
        返回 v["主"] == 基["主"]
    结束
    返回 v["主"] == 基["主"] 且 v["次"] == 基["次"]
结束

# 满足通配(v, 模式)：1.x / 1.2.x / * / 1 / 1.2
函数 满足通配(字典 v, 字符串 模式)
    字符串 p = 去前导v(去空白(模式))
    如果 p == "*" 或 p == "x" 或 p == "X" 则
        返回 真
    结束
    列表 段 = 分割(p, ".")
    如果 长度(段) == 0 则
        返回 假
    结束
    如果 长度(段) >= 1 且 是数字串(段[0]) 则
        如果 v["主"] != 转整数(段[0]) 则
            返回 假
        结束
    结束
    如果 长度(段) == 1 则
        返回 真
    结束
    如果 段[1] == "x" 或 段[1] == "X" 或 段[1] == "*" 则
        返回 真
    结束
    如果 非 是数字串(段[1]) 则
        返回 假
    结束
    如果 v["次"] != 转整数(段[1]) 则
        返回 假
    结束
    如果 长度(段) == 2 则
        返回 真
    结束
    如果 段[2] == "x" 或 段[2] == "X" 或 段[2] == "*" 则
        返回 真
    结束
    如果 非 是数字串(段[2]) 则
        返回 假
    结束
    返回 v["修订"] == 转整数(段[2])
结束

# 满足单个条件(v, 条件)：一个比较符/插入符/波浪号/通配片段
函数 满足单个条件(字典 v, 字符串 条件)
    如果 条件 == "" 则
        返回 真
    结束
    如果 条件 == "*" 或 条件 == "x" 或 条件 == "X" 则
        返回 真
    结束
    如果 截取(条件, 0, 2) == ">=" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 2, 长度(条件) - 2))) >= 0
    结束
    如果 截取(条件, 0, 2) == "<=" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 2, 长度(条件) - 2))) <= 0
    结束
    如果 截取(条件, 0, 2) == "==" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 2, 长度(条件) - 2))) == 0
    结束
    如果 截取(条件, 0, 1) == ">" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 1, 长度(条件) - 1))) > 0
    结束
    如果 截取(条件, 0, 1) == "<" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 1, 长度(条件) - 1))) < 0
    结束
    如果 截取(条件, 0, 1) == "=" 则
        返回 比较版本对象(v, 解析版本(截取(条件, 1, 长度(条件) - 1))) == 0
    结束
    如果 截取(条件, 0, 1) == "^" 则
        返回 满足插入符(v, 截取(条件, 1, 长度(条件) - 1))
    结束
    如果 截取(条件, 0, 1) == "~" 则
        返回 满足波浪号(v, 截取(条件, 1, 长度(条件) - 1))
    结束
    返回 满足通配(v, 条件)
结束

# 满足范围(版本, 范围) -> 布尔：空格 AND，|| OR
函数 满足范围(字符串 版本, 字符串 范围)
    字典 v = 解析版本(版本)
    如果 v["有效"] != 1 则
        返回 假
    结束
    列表 并集 = 分割(去空白(范围), "||")
    对于 k 从 0 到 长度(并集) - 1 循环
        列表 条件们 = 分割(去空白(并集[k]), " ")
        整数 全真 = 1
        对于 i 从 0 到 长度(条件们) - 1 循环
            字符串 条件 = 去空白(条件们[i])
            如果 条件 != "" 且 非 满足单个条件(v, 条件) 则
                全真 = 0
            结束
        结束
        如果 全真 == 1 则
            返回 真
        结束
    结束
    返回 假
结束

# 满足版本(版本, 范围)：满足范围的别名（便于自然阅读）
函数 满足版本(字符串 版本, 字符串 范围)
    返回 满足范围(版本, 范围)
结束
