# ============================================================
# cocn-regex —— 正则匹配与常用校验（对标 Rust 的 regex）
# 复用标准库 正则匹配，并补充转义与常用格式校验。
# ============================================================
导入 "标准库"

# 是否匹配正则（对标 Regex::is_match）
函数 是否匹配(模式, 文本)
    返回 正则匹配(模式, 文本)
结束

# 转义正则元字符，使文本可被当作字面量安全匹配
函数 转义正则(文本)
    让 s = 替换(文本, "\\", "\\\\")
    s = 替换(s, "(", "\\(")
    s = 替换(s, ")", "\\)")
    s = 替换(s, "[", "\\[")
    s = 替换(s, "]", "\\]")
    s = 替换(s, ".", "\\.")
    返回 s
结束

# 邮箱校验
函数 是邮箱(文本)
    返回 正则匹配("[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[A-Za-z]+", 文本)
结束

# 中国大陆手机号校验
函数 是手机(文本)
    返回 正则匹配("^1[3-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$", 文本)
结束

# 中国大陆身份证（18 位，末位可为 X）校验
函数 是身份证(文本)
    如果 长度(文本) != 18 则 返回 假 结束
    返回 正则匹配("^[0-9]+[0-9Xx]$", 文本)
结束
