# cocn-regex 测试
导入 "标准库"
导入 "库"

测试用例("匹配 数字", 函数()
    断言相等(是否匹配("[0-9]+", "abc123"), 真, "匹配数字")
结束)

测试用例("不匹配 纯字母", 函数()
    断言相等(是否匹配("[0-9]+", "abc"), 假, "纯字母无数字")
结束)

测试用例("邮箱校验", 函数()
    断言相等(是邮箱("user@host.com"), 真, "合法邮箱")
    断言相等(是邮箱("not-an-email"), 假, "非法邮箱")
结束)

测试用例("手机号校验", 函数()
    断言相等(是手机("13812345678"), 真, "合法手机")
    断言相等(是手机("12345"), 假, "过短")
结束)

测试用例("身份证校验", 函数()
    断言相等(是身份证("11010519491231002X"), 真, "合法身份证")
    断言相等(是身份证("123"), 假, "过短")
结束)

运行所有测试()
