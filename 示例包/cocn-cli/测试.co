# cocn-cli 测试
导入 "标准库"
导入 "库"

测试用例("解析 混合参数", 函数()
    字典 r = 解析参数(["run", "--port", "8080", "-v", "file.txt"])
    断言相等(取选项(r, "port", ""), "8080", "port")
    断言相等(取选项(r, "v", 假), 真, "v 标志")
    断言相等(子命令(r["位置"]), "run", "子命令")
    断言相等(长度(r["位置"]), 2, "位置参数数")
结束)

测试用例("等号赋值", 函数()
    字典 r = 解析参数(["--name=小明"])
    断言相等(取选项(r, "name", ""), "小明", "name")
结束)

测试用例("布尔长选项不吞下一个选项", 函数()
    字典 r = 解析参数(["--verbose", "--name", "coCN", "run"])
    断言相等(取选项(r, "verbose", 假), 真, "verbose 是布尔")
    断言相等(取选项(r, "name", ""), "coCN", "name 取到值")
    断言相等(子命令(r["位置"]), "run", "位置参数不受影响")
结束)

测试用例("默认值", 函数()
    字典 r = 解析参数(["start"])
    断言相等(取选项(r, "port", "3000"), "3000", "缺省port")
    断言相等(子命令(r["位置"]), "start", "子命令")
结束)

运行所有测试()
