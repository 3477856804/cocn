# ============================================================
# cocn-cli —— 命令行参数解析（对标 Rust 的 clap，纯本地）
# 复用内置 读取命令行 / 标准库 字符串函数。
# ============================================================
导入 "标准库"

# 解析参数列表为 {选项, 位置}
# 语法：
#   --name=value   长选项，等号赋值
#   --name value   长选项，空格分隔的下一 token 作为值
#   -x             单短横布尔开关（不消费下一 token）
#
# 长选项的「布尔 vs 取值」歧义（clap 用声明式解决，这里用约定）：
#   下一个 token 以 "-" 开头时视为布尔开关，不消费它；
#   显式写 --flag=true / --flag=false 永远按字面值处理；
#   其余情况下一 token 作为值。
#   其余           位置参数
函数 解析参数(项)
    字典 选项 = {}
    列表 位置 = []
    整数 j = 0
    当 j < 长度(项) 循环
        字符串 a = 项[j]
        如果 开头是(a, "--") 则
            字符串 名 = 去前缀(a, "--")
            如果 包含(名, "=") 则
                整数 p = 查找(名, "=")
                选项[截取(名, 0, p)] = 截取(名, p + 1, 长度(名))
                j = j + 1
            否则
                # 空格分隔的下一 token 作为值；下一个 token 本身是选项时，
                # 本选项按布尔开关处理（否则 --verbose --name x 会吞掉 --name）。
                如果 j + 1 < 长度(项) 且 非 开头是(项[j + 1], "-") 则
                    选项[名] = 项[j + 1]
                    j = j + 2
                否则
                    选项[名] = 真
                    j = j + 1
                结束
            结束
        否则 如果 开头是(a, "-") 且 长度(a) > 1 则
            字符串 名 = 去前缀(a, "-")
            选项[名] = 真
            j = j + 1
        否则
            追加(位置, a)
            j = j + 1
        结束
    结束
    返回 {"选项": 选项, "位置": 位置}
结束

# 取选项值，缺省返回 缺省
函数 取选项(结果, 名, 缺省)
    如果 包含(结果["选项"], 名) 则 返回 结果["选项"][名] 结束
    返回 缺省
结束

# 取第一个位置参数（子命令）
函数 子命令(位置)
    如果 长度(位置) == 0 则 返回 "" 结束
    返回 位置[0]
结束
